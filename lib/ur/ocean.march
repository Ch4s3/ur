-- The ocean around the islands: where its chunks live and how deep it is.
-- Pure, so the tests can reach it; Ur.Scene draws what it describes.
mod Ur.Ocean do
  alias Ur.Sim as S

  doc "Parcels of open sea around the map on each side."
  fn ring() : Int do 13 end
  doc "Parcels in the map and its ring of sea, across and down."
  fn padded_width() : Int do S.width() + 2 * ring() end
  fn padded_depth() : Int do S.depth() + 2 * ring() end
  fn ring_cells() : Int do padded_width() * padded_depth() end

  doc "The first chunk slot the ocean owns; above every slot the city and its citizens use (Ur.Scene.citizen_chunk_slots, 216624)."
  fn ocean_base() : Int do 220000 end
  doc "One of the 16 coarse tiles that carry the sea out to the horizon."
  fn far_sea_slot(i : Int) : Int do ocean_base() + i end
  doc "Padded parcel [cell]'s seabed chunk: layer 0 is y -32..-1 (and the sea surface), layer 1 y -64..-33."
  fn seabed_slot(cell : Int, layer : Int) : Int do ocean_base() + 16 + cell * 2 + layer end
  doc "How many chunk slots Strata must open."
  fn slot_count() : Int do ocean_base() + 16 + ring_cells() * 2 end

  -- The coast distance field: on 4-voxel ground cells over the map and its
  -- ring, how far each is from the nearest land, as a 3-4 chamfer distance
  -- (3 a cell across, 4 a cell diagonally; times 4/3 is voxels).
  type Field = { dist : NativeIntArr }

  doc "Ground cells across and down the map and its ring (8 to a parcel)."
  fn cells_wide() : Int do padded_width() * 8 end
  fn cells_deep() : Int do padded_depth() * 8 end
  pfn far() : Int do 1000000 end

  -- A cell's ground at its centre: land when above sea level, inside the map.
  pfn land(c : Ur.Sim.City, cx : Int, cz : Int) : Bool do
    let x = (cx - ring() * 8) * 4 + 2
    let z = (cz - ring() * 8) * 4 + 2
    x >= 0 && z >= 0 && x < S.width() * 32 && z < S.depth() * 32 && Ur.Landscape.height(c, x, z) > 0
  end
  pfn seed(c : Ur.Sim.City, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= cells_wide() * cells_deep() do a else
      let cx = i % cells_wide()
      let cz = i / cells_wide()
      seed(c, NativeArray.set_int(a, i, if land(c, cx, cz) do 0 else far() end), i + 1)
    end
  end
  pfn at(a : NativeIntArr, cx : Int, cz : Int) : Int do
    if cx < 0 || cz < 0 || cx >= cells_wide() || cz >= cells_deep() do far() else NativeArray.get_int(a, cz * cells_wide() + cx) end
  end
  pfn least(a : Int, b : Int) : Int do if a < b do a else b end end
  pfn forward(a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= cells_wide() * cells_deep() do a else
      let cx = i % cells_wide()
      let cz = i / cells_wide()
      let d = least(least(NativeArray.get_int(a, i), at(a, cx - 1, cz) + 3), least(at(a, cx, cz - 1) + 3,
        least(at(a, cx - 1, cz - 1) + 4, at(a, cx + 1, cz - 1) + 4)))
      forward(NativeArray.set_int(a, i, d), i + 1)
    end
  end
  pfn backward(a : NativeIntArr, i : Int) : NativeIntArr do
    if i < 0 do a else
      let cx = i % cells_wide()
      let cz = i / cells_wide()
      let d = least(least(NativeArray.get_int(a, i), at(a, cx + 1, cz) + 3), least(at(a, cx, cz + 1) + 3,
        least(at(a, cx + 1, cz + 1) + 4, at(a, cx - 1, cz + 1) + 4)))
      backward(NativeArray.set_int(a, i, d), i - 1)
    end
  end

  doc "The coast distance field of city [c]."
  fn field(c : Ur.Sim.City) : Field do
    let n = cells_wide() * cells_deep()
    { dist: backward(forward(seed(c, NativeArray.make_int(n, 0), 0), 0), n - 1) }
  end

  -- The depth of a cell's water before the seabed's ripple: 0 on land,
  -- 2 voxels at the shore, deepening 3 voxels in 20 out to 63.
  pfn cell_depth(f : Field, cx : Int, cz : Int) : Int do
    let d = at(f.dist, cx, cz)
    if d == 0 do 0 else if d >= far() do 63 else S.clamp(2 + d * 4 / 3 * 3 / 20, 2, 63) end end
  end

  doc "The water's depth in voxels (0..63; 0 is land, 63 deep) at voxel (x, z), in the map's voxel coordinates; anywhere off the field is deep."
  fn depth(f : Field, x : Int, z : Int) : Int do
    let cx = int_div_euclid(x, 4) + ring() * 8
    let cz = int_div_euclid(z, 4) + ring() * 8
    let d = cell_depth(f, cx, cz)
    if d == 0 || d == 63 do d else
      let ripple = int_mod_euclid(int_div_euclid(x * 7 + z * 13, 4), 3) - 1
      S.clamp(d + ripple, 2, 63)
    end
  end

  doc "The seabed's height in voxels at (x, z): below sea level (0) by the water's depth."
  fn seabed(f : Field, x : Int, z : Int) : Int do 0 - depth(f, x, z) end

  pfn cells_differ(a : Field, b : Field, px : Int, pz : Int, k : Int) : Bool do
    if k >= 64 do false else
      let cx = px * 8 + k % 8
      let cz = pz * 8 + k / 8
      cell_depth(a, cx, cz) != cell_depth(b, cx, cz) || cells_differ(a, b, px, pz, k + 1)
    end
  end
  doc "Whether padded parcel [cell] (row-major over the map and its ring) has any cell whose water depth differs between [a] and [b]."
  fn parcel_changed(a : Field, b : Field, cell : Int) : Bool do
    cells_differ(a, b, cell % padded_width(), cell / padded_width(), 0)
  end
  doc "Padded parcel index of map parcel (px, pz); px, pz may lie in the ring (-13..)."
  fn padded_cell(px : Int, pz : Int) : Int do (pz + ring()) * padded_width() + px + ring() end
end
