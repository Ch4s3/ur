-- The ocean around the islands: where its chunks live and how deep it is.
-- Pure, so the tests can reach it; Ur.Scene draws what it describes.
mod Ur.Ocean do
  alias Ur.Sim as S

  doc "Parcels of open sea around the map on each side."
  fn ring() : Int do 13 end
  doc "Parcels in the map and its ring of sea, across and down."
  fn padded_width() : Int do S.width() + 2 * ring() end
  fn padded_depth() : Int do S.depth() + 2 * ring() end
  fn ring_cells() : Int do padded_width() * padded_depth() end

  doc "The first chunk slot the ocean owns; above every slot the city and its citizens use (Ur.Scene.citizen_chunk_slots, 216624)."
  fn ocean_base() : Int do 220000 end
  doc "One of the 16 coarse tiles that carry the sea out to the horizon."
  fn far_sea_slot(i : Int) : Int do ocean_base() + i end
  doc "Padded parcel [cell]'s seabed chunk: layer 0 is y -32..-1 (and the sea surface), layer 1 y -64..-33."
  fn seabed_slot(cell : Int, layer : Int) : Int do ocean_base() + 16 + cell * 2 + layer end
  doc "How many chunk slots Strata must open."
  fn slot_count() : Int do ocean_base() + 16 + ring_cells() * 2 end

  -- The sea floor on 4-voxel ground cells over the map and its ring: each
  -- cell's water depth in voxels (0 land, -2..-1 dry sand that is not land),
  -- a Strata.Seabed shelf from the coast, the map's natural reefs and sand
  -- bars, the sand storms moved (City.sand_changes), and the city's dredging
  -- and reefs (City.seabed) on top. [kind] says what each cell is made of
  -- (0 open floor, 1 reef, 2 sand bar, 3 built reef, 4 canal mouth); [shelf] is the bare shelf's depth.
  -- [reef_type] is what the map's reefs are, from its temperature (Ur.Sim setup 2): 0 rocky, 1 mixed, 2 coral.
  -- [corals] are the coral templates its reefs are dotted with (Strata.Corals; none without reef), in Ur.Scene's material ids.
  -- [canals] marks parcels where only the cut channel can have a sea-level surface.
  type Field = { floor : NativeIntArr, kind : NativeIntArr, shelf : NativeIntArr, reef_type : Int, corals : List(Strata.Template.Template), canals : NativeIntArr }

  doc "Ground cells across and down the map and its ring (8 to a parcel)."
  fn cells_wide() : Int do padded_width() * 8 end
  fn cells_deep() : Int do padded_depth() * 8 end

  -- A cell's ground at its centre: land when above sea level, inside the map.
  pfn land(c : Ur.Sim.City, cx : Int, cz : Int) : Bool do
    let x = (cx - ring() * 8) * 4 + 2
    let z = (cz - ring() * 8) * 4 + 2
    if x >= 0 && z >= 0 && x < S.width() * 32 && z < S.depth() * 32 do Ur.Landscape.height(c, x, z) > 0 else false end
  end
  pfn seed(c : Ur.Sim.City, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= cells_wide() * cells_deep() do a else
      let cx = i % cells_wide()
      let cz = i / cells_wide()
      seed(c, NativeArray.set_int(a, i, if land(c, cx, cz) do 1 else 0 end), i + 1)
    end
  end
  pfn at(a : NativeIntArr, cx : Int, cz : Int) : Int do
    if cx < 0 || cz < 0 || cx >= cells_wide() || cz >= cells_deep() do 63 else NativeArray.get_int(a, cz * cells_wide() + cx) end
  end
  pfn least(a : Int, b : Int) : Int do if a < b do a else b end end
  -- each map parcel's dredging or reef over its 8 x 8 cells, easing two cells into its neighbours
  pfn edits(c : Ur.Sim.City, f : Strata.Seabed.Seafloor, i : Int) : Strata.Seabed.Seafloor do
    if i >= S.count() do f else
      let (dredged, reef) = S.seabed_edit(c, i)
      let x0 = i % S.width() * 8 + ring() * 8
      let z0 = i / S.width() * 8 + ring() * 8
      let f = if dredged > 0 do Strata.Seabed.dig(f, x0, z0, x0 + 7, z0 + 7, dredged, 2)
        else if reef > 0 do Strata.Seabed.raise(f, x0, z0, x0 + 7, z0 + 7, reef, 2) else f end end
      edits(c, f, i + 1)
    end
  end

  -- the cell at the centre of map parcel (px, pz)
  pfn parcel_cell(px : Int, pz : Int) : (Int, Int) do (px * 8 + 4 + ring() * 8, pz * 8 + 4 + ring() * 8) end
  -- the middle of the Fishing shoals island (Ur.Sim.food_island 2), as a cell; None on a map without one
  pfn shoals_sum(c : Ur.Sim.City, i : Int, n : Int, sx : Int, sz : Int) : (Int, Int, Int) do
    if i >= S.count() do (n, sx, sz)
    else if S.food_island(c, i) == 2 do shoals_sum(c, i + 1, n + 1, sx + i % S.width(), sz + i / S.width())
    else shoals_sum(c, i + 1, n, sx, sz) end end
  end
  pfn shoals_centre(c : Ur.Sim.City) : Option((Int, Int)) do
    let (n, sx, sz) = shoals_sum(c, 0, 0, 0, 0)
    if n == 0 do None else Some(parcel_cell(sx / n, sz / n)) end
  end
  -- walking south from cell (cx, cz), the first water cell
  pfn south_shore(land : NativeIntArr, cx : Int, cz : Int) : Int do
    if cz >= cells_deep() - 1 || NativeArray.get_int(land, cz * cells_wide() + cx) == 0 do cz else south_shore(land, cx, cz + 1) end
  end
  -- The classic founding map's own features: a fringing reef round the Fishing shoals island and a sand bar off the main island's south shore.
  pfn classic_features(shelf : Strata.Seabed.Seafloor, land : NativeIntArr) : Strata.Seabed.Features do
    let (rx0, rz0) = parcel_cell(50, 18)
    let (rx1, rz1) = parcel_cell(59, 28)
    let ft = Strata.Seabed.reef_band(Strata.Seabed.features(shelf), land, rx0, rz0, rx1, rz1, 6, 18, 6)
    let (ax, az) = parcel_cell(15, 22)
    let (bx, bz) = parcel_cell(25, 22)
    Strata.Seabed.bar(ft, ax, south_shore(land, ax, az) + 12, bx, south_shore(land, bx, bz) + 12, 3, -1)
  end
  -- The map's natural reefs and sand bars: none for a city saved before them or for the old test map, the classic map's own, or the seed's.
  pfn natural(c : Ur.Sim.City, shelf : Strata.Seabed.Seafloor, land : NativeIntArr) : Strata.Seabed.Features do
    if c.sea_features == 0 || !c.founding_map do Strata.Seabed.features(shelf)
    else if c.world_seed < 0 do classic_features(shelf, land)
    else
      let forced = match shoals_centre(c) do
        Some(p) -> [p]
        None -> Nil
      end
      Strata.Seabed.generate(shelf, land, c.world_seed, { Strata.Seabed.default_recipe() with forced: forced })
    end end
  end
  -- the sand storms moved, laid over the floor with its edits: each entry cell * 512 + kind * 128 + (change + 64); a cell that
  -- would come to 0 (land) stays a voxel under water, and nothing rises above -2 or sinks past 63
  pfn sand(ft : Strata.Seabed.Features, changes : NativeIntArr, i : Int) : Strata.Seabed.Features do
    if i >= NativeArray.length_int(changes) do ft else
      let v = NativeArray.get_int(changes, i)
      let cell = v / 512
      if cell < 0 || cell >= cells_wide() * cells_deep() || NativeArray.get_int(ft.floor.depth, cell) == 0 do sand(ft, changes, i + 1) else
        let f = ft.floor
        let d = S.clamp(NativeArray.get_int(f.depth, cell) + v % 128 - 64, -2, 63)
        sand({ floor: { f with depth: NativeArray.set_int(f.depth, cell, if d == 0 do 1 else d end) }, kind: NativeArray.set_int(ft.kind, cell, v / 128 % 4) }, changes, i + 1)
      end
    end
  end
  -- the cells of each parcel the city built a reef on that stand above the bare shelf: kind 3, reef the storms cannot move
  pfn built_reefs(c : Ur.Sim.City, ft : Strata.Seabed.Features, shelf : NativeIntArr, i : Int) : Strata.Seabed.Features do
    if i >= S.count() do ft else
      let (_, reef) = S.seabed_edit(c, i)
      let ft = if reef <= 0 do ft else mark_go(ft, shelf, i % S.width() * 8 + ring() * 8, i / S.width() * 8 + ring() * 8, 0) end
      built_reefs(c, ft, shelf, i + 1)
    end
  end
  pfn mark_go(ft : Strata.Seabed.Features, shelf : NativeIntArr, x0 : Int, z0 : Int, k : Int) : Strata.Seabed.Features do
    if k >= 64 do ft else
      let j = (z0 + k / 8) * cells_wide() + x0 + k % 8
      let d = NativeArray.get_int(ft.floor.depth, j)
      let ft = if d > 0 && d < NativeArray.get_int(shelf, j) && NativeArray.get_int(ft.kind, j) != 1 do { ft with kind: NativeArray.set_int(ft.kind, j, 3) } else ft end
      mark_go(ft, shelf, x0, z0, k + 1)
    end
  end
  -- the map's features with the city's edits on them
  pfn edited(c : Ur.Sim.City, shelf : Strata.Seabed.Seafloor, land : NativeIntArr) : Strata.Seabed.Features do
    let ft0 = natural(c, shelf, land)
    built_reefs(c, { ft0 with floor: edits(c, ft0.floor, 0) }, shelf.depth, 0)
  end
  doc "The sea floor of city [c] with its reefs, bars and the city's dredging and reefs but no storms: what sand changes (City.sand_changes) are measured against."
  fn unsanded(c : Ur.Sim.City) : Strata.Seabed.Features do
    let n = cells_wide() * cells_deep()
    let land = seed(c, NativeArray.make_int(n, 0), 0)
    edited(c, Strata.Seabed.shelf(land, cells_wide(), cells_deep(), 4, 2, 3, 20, 63), land)
  end
  -- Keep the engineered channel open through natural banks, sandbars and storm deposits.
  pfn canal_beds(c : Ur.Sim.City, lot : Int, floor : NativeIntArr, kind : NativeIntArr) : (NativeIntArr, NativeIntArr) do
    if lot >= S.count() do (floor, kind) else
      let canal = S.canal_water(c, lot)
      let approach = S.canal_approach_mask(c, lot)
      if !canal && approach == 0 do canal_beds(c, lot + 1, floor, kind) else
        let x = (lot % S.width() + ring()) * 8
        let z = (lot / S.width() + ring()) * 8
        let bed = Math.max_int(0, S.canal_depth() - S.canal_level(c, lot))
        let (floor, kind) = List.fold_left(List.range(0, 64), (floor, kind), fn (state, cell) ->
          let u = cell % 8 * 4 + 2
          let v = cell / 8 * 4 + 2
          let idx = (z + cell / 8) * cells_wide() + x + cell % 8
          let (floor, kind) = state
          if canal do
            let depth = if S.canal_wet(c, lot, u, v) do bed else 0 end
            (NativeArray.set_int(floor, idx, depth), NativeArray.set_int(kind, idx, 0))
          else if S.canal_approach_cell(approach, u, v, 32) do
            let depth = Math.max_int(S.canal_depth(), NativeArray.get_int(floor, idx))
            let material = if S.canal_approach_cell(approach, u, v, 16) do 4 else 0 end
            (NativeArray.set_int(floor, idx, depth), NativeArray.set_int(kind, idx, material))
          else
            -- A submerged shoulder eases the trench into the shelf. Keep dry
            -- banks and existing reefs intact and leave the central draft alone.
            let x_shoulder = int_and(approach, 3) != 0 && (v == 6 || v == 26)
            let z_shoulder = int_and(approach, 12) != 0 && (u == 6 || u == 26)
            let depth = NativeArray.get_int(floor, idx)
            if (x_shoulder || z_shoulder) && depth > 0 && depth < S.canal_depth() - 2 &&
              NativeArray.get_int(kind, idx) == 0 do
              (NativeArray.set_int(floor, idx, S.canal_depth() - 2), kind)
            else state end
          end end)
        canal_beds(c, lot + 1, floor, kind)
      end
    end
  end
  doc "The sea floor of city [c]: a shelf 2 voxels deep at the shore deepening 3 voxels in 20 to 63, with the map's reefs and sand bars, the city's dredging and reefs, and the sand storms moved."
  fn field(c : Ur.Sim.City) : Field do
    let n = cells_wide() * cells_deep()
    let land = seed(c, NativeArray.make_int(n, 0), 0)
    let shelf = Strata.Seabed.shelf(land, cells_wide(), cells_deep(), 4, 2, 3, 20, 63)
    -- the city's edits, then the sand storms moved over them: a dredged channel silts, and dredging it again digs deeper
    let ft = sand(edited(c, shelf, land), c.sand_changes, 0)
    let rt = reef_type(c)
    let (floor, kind) = canal_beds(c, 0, ft.floor.depth, ft.kind)
    { floor: floor, kind: kind, shelf: shelf.depth, reef_type: rt,
      corals: if has_reef(kind, 0) do coral_set(rt) else Nil end, canals: c.canals }
  end

  pfn shoal_cells(f : Field, px : Int, pz : Int, k : Int, least : Int, reef : Int) : (Int, Int) do
    if k >= 64 do (least, reef) else
      let cx = px * 8 + k % 8 + ring() * 8
      let cz = pz * 8 + k / 8 + ring() * 8
      let i = cz * cells_wide() + cx
      let d = NativeArray.get_int(f.floor, i)
      if d != 0 && d < NativeArray.get_int(f.shelf, i) && d < least do shoal_cells(f, px, pz, k + 1, d, if NativeArray.get_int(f.kind, i) == 1 || NativeArray.get_int(f.kind, i) == 3 do 1 else 0 end)
      else shoal_cells(f, px, pz, k + 1, least, reef) end
    end
  end
  pfn shoals_go(f : Field, i : Int, depths : NativeIntArr, reefs : NativeIntArr) : (NativeIntArr, NativeIntArr) do
    if i >= S.count() do (depths, reefs) else
      let (d, r) = shoal_cells(f, i % S.width(), i / S.width(), 0, 63, 0)
      shoals_go(f, i + 1, NativeArray.set_int(depths, i, d), NativeArray.set_int(reefs, i, r))
    end
  end
  doc "Per map parcel, the shallowest cell (voxels) that a reef, a bar or the player's reef raised above the bare shelf, 63 where none did; and 1 where that cell is reef. A ferry's draft is measured against these (Ur.Sim.ferry_status)."
  fn shoals(f : Field) : (NativeIntArr, NativeIntArr) do shoals_go(f, 0, NativeArray.make_int(S.count(), 63), NativeArray.make_int(S.count(), 0)) end
  doc "City [c] with its shoals measured from field [f] (Ur.Sim.City.sea_shoals)."
  fn with_shoals(c : Ur.Sim.City, f : Field) : Ur.Sim.City do
    let (d, r) = shoals(f)
    { c with sea_shoals: d, sea_reefs: r }
  end
  pfn has_reef(kind : NativeIntArr, i : Int) : Bool do
    if i >= NativeArray.length_int(kind) do false else if NativeArray.get_int(kind, i) == 1 do true else has_reef(kind, i + 1) end end
  end
  fn coral_set(reef_type : Int) : List(Strata.Template.Template) do Ur.ReefArt.coral_set(reef_type) end
  doc "What city [c]'s reefs are, from its temperature setting: 0 rocky (0..1), 1 mixed (2), 2 coral (3..4)."
  fn reef_type(c : Ur.Sim.City) : Int do
    let t = if NativeArray.length_int(c.setup) > 2 do NativeArray.get_int(c.setup, 2) else 2 end
    if t >= 3 do 2 else if t <= 1 do 0 else 1 end end
  end
  doc "What the floor at voxel (x, z) is made of: 0 open floor, 1 reef, 2 sand bar, 3 built reef, 4 canal mouth; open floor off the field."
  fn kind(f : Field, x : Int, z : Int) : Int do
    let cx = int_div_euclid(x, 4) + ring() * 8
    let cz = int_div_euclid(z, 4) + ring() * 8
    if cx < 0 || cz < 0 || cx >= cells_wide() || cz >= cells_deep() do 0 else NativeArray.get_int(f.kind, cz * cells_wide() + cx) end
  end
  doc "The bare shelf's depth in voxels at voxel (x, z), before reefs, bars, storms and edits; deep off the field."
  fn shelf_depth(f : Field, x : Int, z : Int) : Int do at(f.shelf, int_div_euclid(x, 4) + ring() * 8, int_div_euclid(z, 4) + ring() * 8) end

  -- a cell's water depth in voxels; off the field the open sea is deep
  pfn cell_depth(f : Field, cx : Int, cz : Int) : Int do at(f.floor, cx, cz) end

  doc "The water's depth in voxels (-2..63; 0 is land, -2..-1 dry sand, 63 deep) at voxel (x, z), in the map's voxel coordinates; anywhere off the field is deep."
  fn depth(f : Field, x : Int, z : Int) : Int do
    let cx = int_div_euclid(x, 4) + ring() * 8
    let cz = int_div_euclid(z, 4) + ring() * 8
    cell_depth(f, cx, cz)
  end

  pfn least4(a : Int, b : Int, c : Int, d : Int) : Int do least(least(a, b), least(c, d)) end
  doc "The water's depth at a cell corner (x, z on the 4-voxel grid): the shallowest of the four cells that meet there (0 where any is land or dry sand), so a shoreline vertex is dry from whichever side it is seen."
  fn corner_depth(f : Field, x : Int, z : Int) : Int do
    -- dry sand is as dry as land to the sea surface
    S.clamp(least4(depth(f, x - 2, z - 2), depth(f, x + 2, z - 2), depth(f, x - 2, z + 2), depth(f, x + 2, z + 2)), 0, 63)
  end

  doc "The seabed's height in voxels at (x, z): below sea level (0) by the water's depth."
  fn seabed(f : Field, x : Int, z : Int) : Int do 0 - depth(f, x, z) end

  pfn cells_differ(a : Field, b : Field, px : Int, pz : Int, k : Int) : Bool do
    if k >= 64 do false else
      let cx = px * 8 + k % 8
      let cz = pz * 8 + k / 8
      let idx = cz * cells_wide() + cx
      if cell_depth(a, cx, cz) != cell_depth(b, cx, cz) || NativeArray.get_int(a.kind, idx) != NativeArray.get_int(b.kind, idx) do true
      else cells_differ(a, b, px, pz, k + 1) end
    end
  end
  fn canal_parcel(f : Field, cell : Int) : Bool do
    let x = cell % padded_width() - ring()
    let z = cell / padded_width() - ring()
    cell >= 0 && cell < ring_cells() && x >= 0 && x < S.width() && z >= 0 && z < S.depth() && S.get(f.canals, S.index(x, z)) > 0
  end
  pfn canal_sea_cell(f : Field, x : Int, z : Int) : Bool do
    canal_parcel(f, padded_cell(int_div_euclid(x, 32), int_div_euclid(z, 32))) && depth(f, x, z) > 0
  end
  pfn canal_mouth_edge(f : Field, ax : Int, az : Int, bx : Int, bz : Int) : Bool do
    (kind(f, ax, az) == 4 && canal_sea_cell(f, bx, bz)) ||
      (kind(f, bx, bz) == 4 && canal_sea_cell(f, ax, az))
  end
  doc "A surface vertex belongs to the sheltered side of the inlet where its neighbouring cells connect sea-level canal water to the dredged approach."
  fn canal_mouth_corner(f : Field, x : Int, z : Int) : Bool do
    (x % 32 == 0 && (canal_mouth_edge(f, x - 2, z - 2, x + 2, z - 2) ||
      canal_mouth_edge(f, x - 2, z + 2, x + 2, z + 2))) ||
    (z % 32 == 0 && (canal_mouth_edge(f, x - 2, z - 2, x - 2, z + 2) ||
      canal_mouth_edge(f, x + 2, z - 2, x + 2, z + 2)))
  end
  doc "Whether an inlet surface vertex touches the sheltered reach of the dredged approach."
  fn canal_shelter_corner(f : Field, x : Int, z : Int) : Bool do
    kind(f, x - 2, z - 2) == 4 || kind(f, x + 2, z - 2) == 4 ||
      kind(f, x - 2, z + 2) == 4 || kind(f, x + 2, z + 2) == 4
  end
  doc "Whether the water depth, seabed material or canal ownership of padded parcel [cell] differs between [a] and [b]."
  fn parcel_changed(a : Field, b : Field, cell : Int) : Bool do
    canal_parcel(a, cell) != canal_parcel(b, cell) || cells_differ(a, b, cell % padded_width(), cell / padded_width(), 0)
  end
  doc "Padded parcel index of map parcel (px, pz); px, pz may lie in the ring (-13..)."
  fn padded_cell(px : Int, pz : Int) : Int do (pz + ring()) * padded_width() + px + ring() end

  -- Where the shoreline can move: a parcel no higher than a grade cut (8)
  -- or beside water, in either city.
  pfn low_or_shore(c : Ur.Sim.City, i : Int, d : Int) : Bool do
    if d == 0 && S.get(c.heights, i) <= 8 do true
    else if d >= 4 do false
    else
      let n = S.neighbour(i, d)
      if S.valid(n) && S.get(c.heights, n) == 0 do true else low_or_shore(c, i, d + 1) end
    end end
  end
  pfn cells_wet_differ(a : Ur.Sim.City, b : Ur.Sim.City, i : Int, k : Int) : Bool do
    if k >= 64 do false else
      let cx = i % S.width() * 8 + k % 8 + ring() * 8
      let cz = i / S.width() * 8 + k / 8 + ring() * 8
      if land(a, cx, cz) != land(b, cx, cz) do true else cells_wet_differ(a, b, i, k + 1) end
    end
  end
  pfn touched_from(a : Ur.Sim.City, b : Ur.Sim.City, i : Int) : Bool do
    if i >= S.count() do false else
      let moved = if low_or_shore(a, i, 0) do cells_wet_differ(a, b, i, 0) else if low_or_shore(b, i, 0) do cells_wet_differ(a, b, i, 0) else false end end
      if moved || S.canal_water(a, i) != S.canal_water(b, i) ||
        S.canal_approach_mask(a, i) != S.canal_approach_mask(b, i) do true else touched_from(a, b, i + 1) end
    end
  end
  doc "Whether land and water coverage or canal ownership changed between [a] and [b], requiring an ocean rebuild."
  fn coast_touched(a : Ur.Sim.City, b : Ur.Sim.City) : Bool do touched_from(a, b, 0) end

  pfn walls_from(a : Ur.Sim.City, b : Ur.Sim.City, i : Int) : Bool do
    if i >= S.count() do false else if S.get(a.seawalls, i) != S.get(b.seawalls, i) do true else walls_from(a, b, i + 1) end end
  end
  pfn seabed_from(a : Ur.Sim.City, b : Ur.Sim.City, i : Int) : Bool do
    if i >= S.count() do false else if S.get(a.seabed, i) != S.get(b.seabed, i) do true else seabed_from(a, b, i + 1) end end
  end
  doc "Whether any parcel was dredged or given a reef, or a storm moved sand, between [a] and [b]: the floor, and so the water and its swell, change."
  fn seabed_touched(a : Ur.Sim.City, b : Ur.Sim.City) : Bool do a.sand_day != b.sand_day || seabed_from(a, b, 0) end
  doc "Whether the sea floor of city [b] may differ from [a]'s: another map, features version, coast, edits or storms (a load or new game swaps the whole city)."
  fn floor_differs(a : Ur.Sim.City, b : Ur.Sim.City) : Bool do
    a.sea_features != b.sea_features || a.world_seed != b.world_seed || a.founding_map != b.founding_map ||
      !same_ints(a.sand_changes, b.sand_changes, 0) || seabed_touched(a, b) || coast_touched(a, b)
  end
  pfn same_ints(a : NativeIntArr, b : NativeIntArr, i : Int) : Bool do
    if NativeArray.length_int(a) != NativeArray.length_int(b) do false
    else if i >= NativeArray.length_int(a) do true
    else if NativeArray.get_int(a, i) != NativeArray.get_int(b, i) do false
    else same_ints(a, b, i + 1) end end end
  end
  doc "Whether any seawall was built or removed between [a] and [b]: the swell must be refracted again round the new breakwaters, though the coast is the same."
  fn walls_touched(a : Ur.Sim.City, b : Ur.Sim.City) : Bool do walls_from(a, b, 0) end

  -- A rebuilt coast: the new field and the padded parcels whose water changed.
  type Rebuild = { field : Field, changed : List(Int) }
  pfn changed_from(a : Field, b : Field, cell : Int, acc : List(Int)) : List(Int) do
    if cell < 0 do acc else
      changed_from(a, b, cell - 1, if parcel_changed(a, b, cell) do Cons(cell, acc) else acc end)
    end
  end
  doc "The coast job: None when no ground turned between land and water, no seabed was edited and no seawall changed from [old] to [c] (field [f] was built for [old]), else the new field and the padded parcels whose water changed (the same field and none, when only seawalls changed: the swell is refracted again all the same). Pure, so it runs on a worker; drawing the changes stays on the main thread (Ur.Scene.ocean_apply)."
  fn rebuild(f : Field, old : Ur.Sim.City, c : Ur.Sim.City) : Option(Rebuild) do
    if coast_touched(old, c) || seabed_touched(old, c) do
      let g = field(c)
      Some({ field: g, changed: changed_from(f, g, ring_cells() - 1, Nil) })
    else if walls_touched(old, c) do Some({ field: f, changed: Nil })
    else None end end
  end
end
