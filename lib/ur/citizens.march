mod Ur.Citizens do
  alias Ur.Sim as S
  type TransitService = { routes : List(Ur.Food.Trip), active : List(Ur.Fleet.Run) }
  type Parking = { lot : Int, road : Int, kind : Int, bay : Int, edge : Int, steps : Int, site : Int }
  type Citizen = { id : Int, home : Int, work : Int, work_position : Int, work_board : Int, study : Int, qualification : Int, shop : Int, location : Int,
    park : Int, park_trip : Bool, shelter : Int, campus_day : Int, park_route : List(Int), work_route : List(Int), shop_route : List(Int), route : List(Int),
    target : Int, previous : Int, board : Int, alight : Int, bus_slot : Int, transit_phase : Int, by_car : Bool, car_phase : Int, parking : Int, arrival : Int, activity : Int, wait : Float, progress : Float, queued : Bool, rest_until : Int }
  type EvacuationTrip = { id : Int, home : Int, shelter : Int, activity : Int, location : Int,
    target : Int, route : List(Int), previous : Int, progress : Float, wait : Float }
  type WalkMap = { pace : NativeFloatArr, terrain : NativeIntArr }
  type Occupied = { walk : WalkMap, lanes : NativeIntArr, parking_keys : Map(Int, Int), junctions : NativeIntArr, crossings : NativeIntArr, signal_tick : Int }
  type CitizenCounts = { tracked : Int, walking : Int, waiting : Int, riding : Int, driving : Int, queued : Int, at_work : Int, studying : Int, shopping : Int, visiting_park : Int, home : Int,
    evacuating : Int, sheltered : Int, returning : Int, stranded : Int }

  fn evacuating(person : Citizen) : Bool do person.activity == 7 end
  fn sheltered(person : Citizen) : Bool do person.activity == 8 end
  fn returning_home(person : Citizen) : Bool do person.activity == 9 end
  fn waiting_for_shelter(person : Citizen) : Bool do person.activity == 10 end

  fn emergency_move(person : Citizen) : Bool do person.activity >= 7 end

  fn evacuation_trips(people : List(Citizen)) : List(EvacuationTrip) do
    List.map(List.filter(people, emergency_move), fn person ->
      { id: person.id, home: person.home, shelter: person.shelter, activity: person.activity,
        location: person.location, target: person.target, route: person.route, previous: person.previous,
        progress: person.progress, wait: person.wait })
  end

  pfn job(c : Ur.Sim.City, i : Int) : Bool do
    S.job_slots(c, i) > 0
  end
  fn connected(c : Ur.Sim.City, a : Int, b : Int) : Bool do
    S.valid(a) && S.valid(b) && S.motor_road(c, a) && S.motor_road(c, b) &&
      (S.grade_link(c, a, b) || (S.span_distance(a, b) == 1 && int_abs(S.get(c.heights, a) - S.get(c.heights, b)) <= 12))
  end
  pfn follow(c : Ur.Sim.City, links : NativeIntArr, i : Int, rest : List(Int), left : Int) : (Int, List(Int)) do
    if !S.valid(i) || left == 0 do (-1, Nil)
    else if S.get(links, i) == i do (i, List.reverse(Cons(i, rest)))
    else follow(c, links, S.get(links, i), Cons(i, rest), left - 1) end end
  end
  pfn destination(c : Ur.Sim.City, links : NativeIntArr, home : Int) : (Int, List(Int)) do
    if S.get(links, home) == home do (home, Nil)
    else if Ur.Food.walkable(c, home) && S.get(links, home) >= 0 do follow(c, links, home, Nil, S.count())
    else follow(c, links, Ur.Food.entrance(c, links, home, 0), Cons(home, Nil), S.count()) end end
  end
  pfn valid_route(c : Ur.Sim.City, route : List(Int), first : Bool) : Bool do
    match route do
      Cons(a, Cons(b, rest)) ->
        if !S.ground_closed(c, b) && (S.grade_link(c, a, b) || (S.span_distance(a, b) == 1 && int_abs(S.get(c.heights, a) - S.get(c.heights, b)) <= 12)) &&
          (first || Ur.Food.walkable(c, a) || S.valid(S.campus_root(c, a)) || S.get(c.parks, a) > 0) do valid_route(c, Cons(b, rest), false) else false end
      Cons(_, Nil) -> true
      Nil -> true
    end
  end
  fn home_parking(c : Ur.Sim.City, lot : Int) : Int do
    if S.get(c.zones, lot) == 1 && S.get(c.buildings, lot) == 1 && S.get(c.construction, lot) == 0 &&
      !S.building_offline(c, lot) && S.valid(S.fleet_frontage(c, lot, 0)) do
      if Strata.Seed.mix(lot, 41) % 3 == 0 do 2 else 1 end
    else 0 end
  end
  -- Vehicle assignments cross frame boundaries as scalar values.
  -- Mixed radix: kind, bay, curb edge, access steps, then the three parcels.
  fn parking_code(p : Parking) : Int do
    let parcels = p.lot + S.count() * (p.road + S.count() * p.site)
    1 + p.kind + 6 * p.bay + 240 * p.edge + 960 * p.steps + 2880 * parcels
  end
  fn parking_at(code : Int) : Option(Parking) do
    if code == 0 do None else
      let n = code - 1
      let parcels = n / 2880
      Some({ kind: n % 6, bay: n / 6 % 40, edge: n / 240 % 4, steps: n / 960 % 3,
        lot: parcels % S.count(), road: parcels / S.count() % S.count(), site: parcels / S.count() / S.count() })
    end
  end
  pfn parking_value(parking : Option(Parking)) : Int do
    match parking do
      Some(p) -> parking_code(p)
      None -> 0
    end
  end
  pfn parking_key(p : Parking) : Int do
    if p.kind >= 3 do S.count() * 9 + p.site * 40 + p.bay
    else if p.kind > 0 do p.lot * 9 + 8
    else p.road * 9 + p.edge * 2 + p.bay end end
  end
  pfn change_reservation(keys : Map(Int, Int), parking : Option(Parking), delta : Int) : Map(Int, Int) do
    match parking do
      None -> keys
      Some(p) ->
        let key = parking_key(p)
        let count = Map.get_or(keys, key, 0, Map.int_cmp) + delta
        if count <= 0 do Map.remove(keys, key, Map.int_cmp) else Map.insert(keys, key, count, Map.int_cmp) end
    end
  end
  pfn hold(keys : Map(Int, Int), parking : Option(Parking)) : Map(Int, Int) do
    change_reservation(keys, parking, 1)
  end
  pfn holds_key(keys : Map(Int, Int), key : Int) : Bool do
    Map.get_or(keys, key, 0, Map.int_cmp) > 0
  end
  pfn park_actor(keys : Map(Int, Int), person : Citizen, delta : Int) : Map(Int, Int) do
    let keys = if person.parking != 0 && person.car_phase < 2 do
      change_reservation(keys, parking_at(person.parking), delta)
    else keys end
    if person.arrival != 0 do change_reservation(keys, parking_at(person.arrival), delta) else keys end
  end
  pfn lane_get(occupied : Occupied, index : Int) : Int do NativeArray.get_int(occupied.lanes, index) end
  pfn lane_set(occupied : Occupied, index : Int, value : Int) : Occupied do
    { occupied with lanes: NativeArray.set_int(occupied.lanes, index, value) }
  end
  pfn garage_bay(base : Parking, bay : Int, capacity : Int, keys : Map(Int, Int)) : Option(Parking) do
    if bay == capacity do None else
      let next = { base with bay: bay }
      if holds_key(keys, parking_key(next)) do garage_bay(base, bay + 1, capacity, keys) else Some(next) end
    end
  end
  pfn parking_facility(c : Ur.Sim.City, lot : Int, road : Int, steps : Int, d : Int, keys : Map(Int, Int)) : Option(Parking) do
    if d == 4 do None else
      let site = S.neighbour(road, d)
      let kind = S.get(c.public_parking, site)
      if kind == 0 || S.fleet_frontage(c, site, 0) != road do
        parking_facility(c, lot, road, steps, d + 1, keys)
      else
        let base = { lot: lot, road: road, kind: kind + 2, bay: 0, edge: d, steps: steps, site: site }
        match garage_bay(base, 0, S.parking_spaces(kind), keys) do
          Some(p) -> Some(p)
          None -> parking_facility(c, lot, road, steps, d + 1, keys)
        end
      end
    end
  end
  pfn curb_for_direction(from : Int, to : Int) : Int do
    match S.direction(from, to) do
      0 -> 2
      1 -> 3
      2 -> 1
      _ -> 0
    end
  end
  pfn free_parking(c : Ur.Sim.City, lot : Int, road : Int, previous : Int, steps : Int, keys : Map(Int, Int), curb_side : Int) : Option(Parking) do
    if !S.valid(lot) || !S.motor_street(c, road) || S.span_distance(previous, road) != 1 do None else
      let kind = if steps == 0 && road == S.fleet_frontage(c, lot, 0) do home_parking(c, lot) else 0 end
      let private_bay = { lot: lot, road: road, kind: kind, bay: 0, edge: S.direction(road, previous), steps: steps, site: lot }
      let side = if steps == 0 do private_bay.edge else if private_bay.edge < 2 do 3 else 1 end end
      let edge = if curb_side >= 0 do curb_side else
        if S.motor_street(c, S.neighbour(road, side)) do S.opposite(side) else side end
      end
      let (corner, _) = S.road_turn(c, road)
      let curb_allowed = corner < 0 && !S.motor_street(c, S.neighbour(road, edge))
      let curb = { private_bay with kind: 0, edge: edge }
      let second = { curb with bay: 1 }
      if kind > 0 && !holds_key(keys, parking_key(private_bay)) do Some(private_bay)
      else if curb_allowed && S.waste_bin_edge(c, road) != edge && !holds_key(keys, parking_key(curb)) do Some(curb)
      else if curb_allowed && !holds_key(keys, parking_key(second)) do Some(second)
      else parking_facility(c, lot, road, steps, 0, keys) end end end
    end
  end
  pfn along_parking(c : Ur.Sim.City, lot : Int, path : List(Int), steps : Int, keys : Map(Int, Int), arriving : Bool) : Option(Parking) do
    match path do
      Cons(previous, Cons(road, rest)) ->
        let curb_side = match rest do
          Cons(peer, _) -> if arriving do curb_for_direction(peer, road) else curb_for_direction(road, peer) end
          Nil -> -1
        end
        match free_parking(c, lot, road, previous, steps, keys, curb_side) do
          Some(p) -> Some(p)
          None -> if steps >= 2 do None else along_parking(c, lot, Cons(road, rest), steps + 1, keys, arriving) end
        end
      _ -> None
    end
  end
  pfn valid_parking(c : Ur.Sim.City, p : Parking) : Bool do
    S.motor_street(c, p.road) && (if p.kind >= 3 do
      S.get(c.public_parking, p.site) == p.kind - 2 && p.road == S.fleet_frontage(c, p.site, 0)
    else (p.kind == 0 && (p.bay != 0 || S.waste_bin_edge(c, p.road) != p.edge)) || (p.kind > 0 && p.kind == home_parking(c, p.lot) && p.road == S.fleet_frontage(c, p.lot, 0)) end)
  end
  pfn owned_parking(c : Ur.Sim.City, old : Option(Citizen)) : Option(Parking) do
    match old do
      None -> None
      Some(person) ->
        -- Keep the destination bay once an interrupted trip has reached it.
        let parking = if person.car_phase >= 2 do person.arrival else person.parking end
        match parking_at(parking) do
          Some(p) -> if valid_parking(c, p) do Some(p) else None end
          None -> None
        end
    end
  end
  pfn acquire_parking(c : Ur.Sim.City, lot : Int, route : List(Int), keys : Map(Int, Int), wants_car : Bool) : Option(Parking) do
    if !wants_car do None else
      match along_parking(c, lot, route, 0, keys, false) do
        Some(p) -> Some(p)
        None -> free_parking(c, lot, S.fleet_frontage(c, lot, 0), lot, 0, keys, -1)
      end
    end
  end
  pfn valid_reserved_parking(c : Ur.Sim.City, code : Int) : Bool do
    match parking_at(code) do
      Some(p) -> valid_parking(c, p)
      None -> true
    end
  end
  pfn existing(c : Ur.Sim.City, old : Option(Citizen), work : Int, work_route : List(Int), study : Int, qualification : Int) : Option(Citizen) do
    match old do
      None -> None
      Some(person) ->
        if person.work == work && person.work_route == work_route && person.study == study && person.qualification == qualification &&
          (person.shop < 0 || S.public_trade(c, person.shop)) && valid_reserved_parking(c, person.parking) &&
          valid_reserved_parking(c, person.arrival) && valid_route(c, person.work_route, true) &&
          valid_route(c, person.shop_route, true) do Some(person)
        else None end
    end
  end
  pfn park_stroll(c : Ur.Sim.City, i : Int, previous : Int, d : Int, seed : Int, remaining : Int) : List(Int) do
    if d == 4 || remaining == 0 do Nil else
      let j = S.neighbour(i, (seed + d) % 4)
      if j != previous && S.get(c.parks, j) > 0 && !S.ground_closed(c, j) && S.pedestrian_edge(c, i, j) do
        Cons(j, park_stroll(c, j, i, 0, seed + 1, remaining - 1))
      else park_stroll(c, i, previous, d + 1, seed, remaining) end
    end
  end
  pfn park_path(c : Ur.Sim.City, field : Ur.Sim.ParkWalk, i : Int, seed : Int) : List(Int) do
    if !S.valid(i) do Nil else
      let j = S.get(field.next, i)
      if i == j do Cons(i, park_stroll(c, i, -1, 0, seed, 1 + seed % 2))
      else Cons(i, park_path(c, field, j, seed)) end
    end
  end
  pfn last_stop(route : List(Int), last : Int) : Int do
    match route do
      Cons(i, rest) -> last_stop(rest, i)
      Nil -> last
    end
  end
  pfn plan_park(c : Ur.Sim.City, field : Ur.Sim.ParkWalk, person : Citizen) : Citizen do
    let entry = S.park_entry(c, field, person.home)
    let route = if S.valid(entry) && S.walkable_park_score(c, field, person.home) > 0 do park_path(c, field, entry, person.id) else Nil end
    let park = last_stop(route, -1)
    let route = if S.valid(park) && entry != person.home do Cons(person.home, route) else route end
    -- Finish an active visit on the same path, or reset it if editing broke that path.
    if person.park_trip && (person.location < 0 || person.activity == 5) do
      if S.get(c.parks, person.park) > 0 && valid_route(c, person.park_route, true) do person
      else { person with park: park, park_route: route, park_trip: false, activity: 0, location: person.home, target: person.home, route: Nil, wait: 1.0 } end
    else { person with park: park, park_route: route } end
  end
  pfn qualified(c : Ur.Sim.City, lot : Int, skill : Int) : Bool do
    let needed = S.job_requirement(c, lot)
    S.qualified_for(skill, needed)
  end
  type Hire = { work : Int, route : List(Int), rank : Int, board : Int, left : Int }
  type EducationRoutes = { schools : List(NativeIntArr), population : Int, hires : Map(Int, List(Hire)) }
  pfn student_stage(c : Ur.Sim.City, stage : Int, draw : Int) : Int do
    if stage == 9 do -1 else
      let group = S.program_enrolled(c, stage)
      if draw < group do stage else student_stage(c, stage + 1, draw - group) end
    end
  end
  pfn route_at(c : Ur.Sim.City, fields : List(NativeIntArr), level : Int, lot : Int) : (Int, List(Int)) do
    match List.drop(fields, level) do
      Nil -> (-1, Nil)
      Cons(field, _) -> destination(c, field, lot)
    end
  end
  pfn education_routes(c : Ur.Sim.City, roads : NativeIntArr, stage : Int) : List(NativeIntArr) do
    if stage == 9 do Nil else
      let field = if S.program_enrolled(c, stage) > 0 do
        Ur.Food.campus_destinations(c, fn i -> S.active_program_at(c, i) == stage && S.building_access(c, roads, i) >= 0)
      else NativeArray.make_int(2640, -1) end
      Cons(field, education_routes(c, roads, stage + 1))
    end
  end
  pfn programs_changed(c : Ur.Sim.City, before : Ur.Sim.City, stage : Int) : Bool do
    if stage == 9 do false else
      S.program_enrolled(c, stage) != S.program_enrolled(before, stage) ||
        (if stage >= 4 do S.specialist_graduates(c, stage) != S.specialist_graduates(before, stage)
        else stage > 0 && S.graduates(c, stage) != S.graduates(before, stage) end) ||
        programs_changed(c, before, stage + 1)
    end
  end
  fn education_changed(c : Ur.Sim.City, before : Ur.Sim.City) : Bool do programs_changed(c, before, 0) end
  type JobRoutes = { fields : Map(Int, NativeIntArr), by_home : Map(Int, List(Hire)) }
  pfn job_routes(c : Ur.Sim.City, hires : List(Ur.Sim.JobMatch)) : Map(Int, List(Hire)) do
    let routes = List.fold_left(List.reverse(hires), { fields: Map.empty(), by_home: Map.empty() }, fn (planned, hire) ->
      let (field, fields) = match Map.get(planned.fields, hire.workplace, Map.int_cmp) do
        Some(field) -> (field, planned.fields)
        None ->
          let field = Ur.Food.destinations(c, fn lot -> lot == hire.workplace)
          (field, Map.insert(planned.fields, hire.workplace, field, Map.int_cmp))
      end
      let (work, route) = destination(c, field, hire.home)
      if !S.valid(work) || hire.workers <= 0 do { planned with fields: fields } else
        let job = { work: work, route: route, rank: hire.rank, board: hire.board, left: hire.workers }
        let previous = Map.get_or(planned.by_home, hire.home, Nil, Map.int_cmp)
        { fields: fields, by_home: Map.insert(planned.by_home, hire.home, Cons(job, previous), Map.int_cmp) }
      end)
    routes.by_home
  end
  type RosterBuild = { old : Map(Int, Citizen), positions : NativeIntArr, parking : Map(Int, Int), people : List(Citizen) }
  -- Keep older save IDs intact for the original residents of a parcel.
  pfn resident_id(lot : Int, floor : Int) : Int do
    if floor < 9 do lot * 9 + floor
    else if floor < 73 do S.count() * 9 + lot * 64 + floor
    else S.count() * 73 + 9 + (floor - 73) * S.count() + lot end end
  end
  pfn residents_on(people : Int, households : Int, seen : Int, homes : Int) : Int do
    (seen + homes) * people / households - seen * people / households
  end
  pfn roster(c : Ur.Sim.City, stores : NativeIntArr, bars : NativeIntArr, walk : Ur.Sim.ParkWalk, education : EducationRoutes,
    build : RosterBuild, homes : List(Int), households : Int, seen : Int, floor : Int, limit : Int, hires : List(Hire)) : List(Citizen) do
    match homes do
      Nil -> List.reverse(build.people)
      Cons(lot, rest) ->
        if floor >= limit do
          let seen = seen + S.resident_homes(c, lot)
          match rest do
            Nil -> List.reverse(build.people)
            Cons(next, _) ->
              let limit = residents_on(education.population, households, seen, S.resident_homes(c, next))
              roster(c, stores, bars, walk, education, build, rest, households, seen, 0, limit, Map.get_or(education.hires, next, Nil, Map.int_cmp))
          end
        else
          let id = resident_id(lot, floor)
          let roll = Strata.Seed.cell(227, 1, id, 0, 0)
          let planned_study = student_stage(c, 0, roll % education.population)
          let (school, school_route) = if planned_study < 0 do (-1, Nil) else route_at(c, education.schools, planned_study, lot) end
          let study = if S.valid(school) do planned_study else -1 end
          let (work, work_route, qualification, work_board, hires) = if study >= 0 do (school, school_route, 0, -1, hires) else
            match hires do
              Nil -> (-1, Nil, 0, -1, Nil)
              Cons(hire, tail) ->
                let next = if hire.left == 1 do tail else Cons({ hire with left: hire.left - 1 }, tail) end
                (hire.work, hire.route, hire.rank, hire.board, next)
            end
          end
          let position = if study < 0 && S.valid(work) do S.get(build.positions, work) + 1 else 0 end
          let positions = if position > 0 do NativeArray.set_int(build.positions, work, position) else build.positions end
          let old = Map.get(build.old, id, Map.int_cmp)
          let parking_keys = match old do
            Some(person) -> park_actor(build.parking, person, -1)
            None -> build.parking
          end
          let prior = existing(c, old, work, work_route, study, qualification)
          let wants_car = roll / 19 % 100 < (if S.get(c.buildings, lot) >= 3 do 32 else if S.get(c.buildings, lot) == 2 do 62 else 92 end end)
          let person = match prior do
            Some(person) ->
              let person = { person with work_position: position, work_board: work_board, rest_until: -1 }
              let person = if person.car_phase != 0 do person else
                let parking = match owned_parking(c, old) do
                  Some(p) -> Some(p)
                  None -> if person.location == person.home do acquire_parking(c, lot, work_route, parking_keys, wants_car) else None end
                end
                { person with parking: parking_value(parking) }
              end
              let (bar, bar_route) = if floor % 3 == 0 && person.location == person.home do destination(c, bars, lot) else (-1, Nil) end
              if S.valid(bar) do { person with shop: bar, shop_route: bar_route }
              else if person.shop >= 0 do person else
                let (shop, shop_route) = destination(c, stores, lot)
                { person with shop: shop, shop_route: shop_route }
              end end
            None ->
              let (bar, bar_route) = if floor % 3 == 0 do destination(c, bars, lot) else (-1, Nil) end
              let (shop, shop_route) = if S.valid(bar) do (bar, bar_route) else destination(c, stores, lot) end
              let parking = match owned_parking(c, old) do
                Some(p) -> Some(p)
                None -> acquire_parking(c, lot, work_route, parking_keys, wants_car)
              end
              { id: id, park: -1, park_trip: false, shelter: -1, campus_day: -1, park_route: Nil, home: lot, work: work, work_position: position, work_board: work_board, study: study, qualification: qualification, shop: shop, location: lot, work_route: work_route, shop_route: shop_route,
                  route: Nil, target: lot, previous: -1, board: -1, alight: -1, bus_slot: -1, transit_phase: 0, by_car: false, car_phase: 0, parking: parking_value(parking), arrival: 0, activity: 0, wait: if study >= 0 do int_to_float(id % 13) *. 0.02 else 0.2 +. int_to_float(id % 17) *. 0.24 end, progress: 0.0, queued: false, rest_until: -1 }
          end
          let person = plan_park(c, walk, person)
          let build = { build with positions: positions, parking: park_actor(parking_keys, person, 1), people: Cons(person, build.people) }
          roster(c, stores, bars, walk, education, build, homes, households, seen, floor + 1, limit, hires)
        end
    end
  end
  pfn emergency_trip(c : Ur.Sim.City, person : Citizen, prior : Citizen, target : Int, activity : Int, shelter : Int) : Citizen do
    if prior.target == target && prior.activity == activity && !List.is_empty(prior.route) && valid_route(c, prior.route, true) do
      { person with shelter: shelter, activity: activity, location: -1, route: prior.route, target: target,
        previous: prior.previous, progress: prior.progress, wait: prior.wait, parking: prior.parking,
        park_trip: false, by_car: false, car_phase: 0, arrival: 0, board: -1, alight: -1, bus_slot: -1, transit_phase: 0 }
    else
      let start = if S.valid(prior.location) do prior.location else current_plot(prior.route) end
      let start = if S.valid(start) do start else person.home end
      let route = if start == target do Nil else Ur.Evacuation.walk_route(c, start, target) end
      let walking = !List.is_empty(route)
      let activity = if walking do activity
        else if start == target do (if activity == 7 do 8 else 0 end)
        else 10 end end
      let shelter = if activity == 0 do -1 else shelter end
      { person with shelter: shelter, activity: activity, park_trip: false, target: target,
        location: if walking do -1 else start end, route: route, progress: 0.0, wait: 0.0, queued: false,
        previous: -1, parking: prior.parking, by_car: false, car_phase: 0, arrival: 0, board: -1, alight: -1, bus_slot: -1, transit_phase: 0 }
    end
  end
  pfn evacuate(c : Ur.Sim.City, orders : NativeIntArr, old : Map(Int, Citizen), person : Citizen) : Citizen do
    let displaced = S.displaced_homes(c, person.home) > 0
    let prior = Map.get(old, person.id, Map.int_cmp)
    if displaced do
      let shelter = S.get(orders, person.home) - 1
      emergency_trip(c, person, Option.unwrap_or(prior, person), shelter, 7, shelter)
    else
      match prior do
        Some(previous) ->
          if !emergency_move(previous) do person
          else if S.building_offline(c, person.home) do
            emergency_trip(c, person, previous, previous.shelter, 7, previous.shelter)
          else emergency_trip(c, person, previous, person.home, 9, previous.shelter) end end
        None -> person
      end
    end
  end
  fn changed(c : Ur.Sim.City, old : Ur.Sim.City, i : Int) : Bool do
    if i >= S.count() do false
    else if S.storefront(c, i) != S.storefront(old, i) || S.ground_at(c, i) != S.ground_at(old, i) || S.building_offline(c, i) != S.building_offline(old, i) || S.get(c.parks, i) != S.get(old.parks, i) || S.get(c.roads, i) != S.get(old.roads, i) || S.get(c.grades, i) != S.get(old.grades, i) || (S.get(c.transit, i) == 1) != (S.get(old.transit, i) == 1) || S.get(c.heights, i) != S.get(old.heights, i) ||
      S.get(c.buildings, i) != S.get(old.buildings, i) || S.job_requirement(c, i) != S.job_requirement(old, i) || S.get(c.plants, i) != S.get(old.plants, i) || S.get(c.waste_bins, i) != S.get(old.waste_bins, i) || S.get(c.public_parking, i) != S.get(old.public_parking, i) || S.occupied_homes(c, i) != S.occupied_homes(old, i) || S.business_closed(c, i) != S.business_closed(old, i) || S.get(c.zones, i) != S.get(old.zones, i) do true
    else if ((S.get(c.roads, i) > 0 || S.get(c.transit, i) == 1 || S.get(c.parks, i) > 0 || S.valid(S.campus_root(c, i))) &&
      S.ground_closed(c, i) != S.ground_closed(old, i)) do true
    else changed(c, old, i + 1) end end end
  end
  pfn home_order(c : Ur.Sim.City, previous : NativeIntArr, lot : Int, priority : List(Int), normal : List(Int)) : List(Int) do
    if lot == S.count() do List.append(List.reverse(priority), List.reverse(normal))
    else if S.resident_homes(c, lot) == 0 do home_order(c, previous, lot + 1, priority, normal)
    else if S.get(previous, lot) > 0 || S.displaced_homes(c, lot) > 0 do
      home_order(c, previous, lot + 1, Cons(lot, priority), normal)
    else home_order(c, previous, lot + 1, priority, Cons(lot, normal)) end end end
  end
  pfn citizens_by_id(people : List(Citizen)) : Map(Int, Citizen) do
    List.fold_left(people, Map.empty(), fn (index, person) -> Map.insert(index, person.id, person, Map.int_cmp))
  end
  pfn refresh_roster(c : Ur.Sim.City, old : Map(Int, Citizen), roads : NativeIntArr, people : Int, hires : List(Ur.Sim.JobMatch), previous : NativeIntArr) : List(Citizen) do
    let homes = home_order(c, previous, 0, Nil, Nil)
    match homes do
      Nil -> Nil
      Cons(lot, _) ->
        if people <= 0 do Nil else
          let households = List.fold_left(homes, 0, fn (total, home) -> total + S.resident_homes(c, home))
          let stores = Ur.Food.destinations(c, fn i -> S.public_trade(c, i))
          let bars = Ur.Food.destinations(c, fn i -> S.nightlife(c, i))
          let education = { schools: education_routes(c, roads, 0), population: people, hires: job_routes(c, hires) }
          let parking = Map.fold(old, Map.empty(), fn (keys, _, person) -> park_actor(keys, person, 1))
          let build = { old: old, positions: NativeArray.make_int(S.count(), 0), parking: parking, people: Nil }
          let limit = residents_on(people, households, 0, S.resident_homes(c, lot))
          roster(c, stores, bars, S.park_walk(c), education, build, homes, households, 0, 0, limit, Map.get_or(education.hires, lot, Nil, Map.int_cmp))
        end
    end
  end
  fn refresh_with(c : Ur.Sim.City, old : List(Citizen), roads : NativeIntArr, people : Int, hires : List(Ur.Sim.JobMatch)) : List(Citizen) do
    let previous = List.fold_left(old, NativeArray.make_int(S.count(), 0), fn (field, person) ->
      if emergency_move(person) do NativeArray.set_int(field, person.home, person.shelter + 2) else field end)
    let prior = citizens_by_id(old)
    let people = refresh_roster(c, prior, roads, people, hires, previous)
    if c.flood_active || S.severe_rain(c) || S.curse_god(c) == 3 || List.any(old, emergency_move) || List.any(people, fn person -> S.displaced_homes(c, person.home) > 0) do
      let orders = Ur.Evacuation.plan(c, roads, previous)
      List.map(people, fn person -> evacuate(c, orders, prior, person))
    else people end
  end
  fn restore_with(c : Ur.Sim.City, trips : List(EvacuationTrip), roads : NativeIntArr, people : Int, hires : List(Ur.Sim.JobMatch)) : List(Citizen) do
    if List.is_empty(trips) do refresh_with(c, Nil, roads, people, hires) else
      let previous = List.fold_left(trips, NativeArray.make_int(S.count(), 0), fn (field, trip) ->
        NativeArray.set_int(field, trip.home, trip.shelter + 2))
      let people = refresh_roster(c, Map.empty(), roads, people, hires, previous)
      let saved = List.fold_left(trips, Map.empty(), fn (index, trip) -> Map.insert(index, trip.id, trip, Map.int_cmp))
      let orders = Ur.Evacuation.plan(c, roads, previous)
      List.map(people, fn person ->
        match Map.get(saved, person.id, Map.int_cmp) do
          Some(trip) ->
            if trip.home == person.home do
              { person with shelter: trip.shelter, activity: trip.activity, location: trip.location,
                target: trip.target, route: trip.route, previous: trip.previous, progress: trip.progress, wait: trip.wait }
            else evacuate(c, orders, Map.empty(), person) end
          None -> evacuate(c, orders, Map.empty(), person)
        end)
    end
  end
  fn refresh(c : Ur.Sim.City, old : List(Citizen)) : List(Citizen) do
    let roads = S.access(c)
    let people = S.population(c)
    refresh_with(c, old, roads, people, (S.employment(c, roads, people)).matches)
  end

  pfn cell(a : Int, b : Int, progress : Float) : Int do
    (a * 4 + S.direction(a, b)) * 4 + S.clamp(float_to_int(progress *. 4.0), 0, 3)
  end
  fn parking_entry(p : Parking) : Float do
    if p.kind == 0 do 0.66 else 0.42 end
  end
  fn parking_exit(p : Parking) : Float do
    if p.kind == 0 do 0.46 else 0.38 end
  end
  pfn position(progress : Float) : Int do 1 + float_to_int(progress *. 1000.0) end
  fn driving(c : Ur.Sim.City, person : Citizen, a : Int, b : Int) : Bool do
    let storm_segment = S.motor_street(c, a) && S.motor_street(c, b) &&
      (S.storm_road_closed(c, a) || S.storm_road_closed(c, b))
    person.car_phase == 2 && (connected(c, a, b) || storm_segment) &&
      (match parking_at(person.arrival) do
          Some(p) -> p.road != a
          None -> false
        end)
  end
  -- Lane cells hold physical positions, including a reserved curb merge.
  pfn lane_room(occupied : Occupied, first : Int, at : Int, slot : Int) : Bool do
    if slot >= 4 do true else
      let value = lane_get(occupied, first + slot)
      (value == 0 || value + 260 <= at || value >= at + 260) &&
        lane_room(occupied, first, at, slot + 1)
    end
  end
  pfn departure_merge(c : Ur.Sim.City, person : Citizen, b : Int, next : Int) : Float do
    match parking_at(person.parking) do
      Some(p) -> if person.car_phase == 1 && b == p.road && connected(c, b, next) do parking_exit(p) else 0.0 end
      None -> 0.0
    end
  end
  -- Each parcel caches its crossing arms, closure, sidewalk width and curve.
  pfn cache_walk(c : Ur.Sim.City, temperature : Int, lot : Int, pace : NativeFloatArr, terrain : NativeIntArr) : WalkMap do
    if lot >= S.count() do { pace: pace, terrain: terrain } else
      let road = S.get(c.roads, lot)
      let motor = S.motor_street(c, lot)
      let arms = if motor do
        (if S.junction_arm(c, lot, 0) do 1 else 0 end) +
        (if S.junction_arm(c, lot, 1) do 2 else 0 end) +
        (if S.junction_arm(c, lot, 2) do 4 else 0 end) +
        (if S.junction_arm(c, lot, 3) do 8 else 0 end)
      else 0 end
      let flags = arms + (if S.ground_closed(c, lot) do 16 else 0 end)
      let width = if motor do S.road_half_width(road) + 1 else 4 end
      let (horizontal, vertical) = if road > 0 do S.road_turn(c, lot) else (-1, -1) end
      let base = lot * 3
      let terrain = NativeArray.set_int(terrain, base, flags)
      let terrain = NativeArray.set_int(terrain, base + 1, width)
      let terrain = NativeArray.set_int(terrain, base + 2, (horizontal + 1) * 5 + vertical + 1)
      cache_walk(c, temperature, lot + 1, NativeArray.set_float(pace, lot, S.walk_pace_at(c, lot, temperature)), terrain)
    end
  end
  fn walk_map(c : Ur.Sim.City) : WalkMap do
    cache_walk(c, S.temperature(c), 0, NativeArray.make_float(S.count(), 1.0), NativeArray.make_int(S.count() * 3, 0))
  end
  fn walk_arm(map : WalkMap, lot : Int, arm : Int) : Bool do
    arm >= 0 && arm < 4 && S.valid(lot) && int_and(NativeArray.get_int(map.terrain, lot * 3), int_shl(1, arm)) > 0
  end
  fn walk_junction(map : WalkMap, lot : Int) : Bool do
    S.valid(lot) && int_popcount(int_and(NativeArray.get_int(map.terrain, lot * 3), 15)) >= 3
  end
  fn walk_width(map : WalkMap, lot : Int) : Int do
    if S.valid(lot) do NativeArray.get_int(map.terrain, lot * 3 + 1) else 4 end
  end
  fn walk_turn(map : WalkMap, lot : Int) : (Int, Int) do
    let code = if S.valid(lot) do NativeArray.get_int(map.terrain, lot * 3 + 2) else 0 end
    (code / 5 - 1, code % 5 - 1)
  end
  fn walk_segment_pace(map : WalkMap, a : Int, b : Int) : Float do
    if !S.valid(a) || (S.valid(b) && int_and(NativeArray.get_int(map.terrain, b * 3), 16) > 0) do 0.0
    else NativeArray.get_float(map.pace, a) end
  end
  fn walk_corners(map : WalkMap, person : Citizen, a : Int, b : Int) : Option((Int, Int, Int, Int)) do
    let from = person.previous
    if person.transit_phase == 3 || person.car_phase == 2 || !S.valid(from) || !walk_junction(map, a) ||
       S.span_distance(from, a) != 1 || S.span_distance(a, b) != 1 ||
       !walk_arm(map, a, S.direction(a, from)) || !walk_arm(map, a, S.direction(a, b)) do None
    else
      let sign = if person.id % 2 == 0 do 1 else -1 end
      let approach = S.direction(a, from)
      let departure = S.direction(a, b)
      let (sx, sz) = corner_for(approach, -sign)
      let (ex, ez) = corner_for(departure, sign)
      Some((sx, sz, ex, ez))
    end
  end
  fn corner_for(arm : Int, side : Int) : (Int, Int) do
    match arm do
      0 -> (3, 16 - 13 * side)
      1 -> (29, 16 + 13 * side)
      2 -> (16 + 13 * side, 3)
      _ -> (16 - 13 * side, 29)
    end
  end
  fn crossing_arm(sx : Int, sz : Int, ex : Int, ez : Int, leg : Int) : Int do
    if leg == 0 do
      if sx == ex do -1 else if sz < 16 do 2 else 3 end end
    else
      if sz == ez do -1 else if ex < 16 do 0 else 1 end end
    end
  end
  fn crossing_step() : Float do 0.24 end
  pfn active_crossing(map : WalkMap, person : Citizen, a : Int, b : Int) : Int do
    let step = crossing_step()
    let t = person.progress
    if t <= 0.0 || t >= step *. 2.0 || t == step do -1 else
      match walk_corners(map, person, a, b) do
        Some((sx, sz, ex, ez)) ->
          let arm = crossing_arm(sx, sz, ex, ez, if t < step do 0 else 1 end)
          if walk_arm(map, a, arm) do arm else -1 end
        None -> -1
      end
    end
  end
  pfn mark_crossing(occupied : Occupied, person : Citizen, a : Int, b : Int) : Occupied do
    if S.get(occupied.junctions, a) == 0 do occupied else
      let arm = active_crossing(occupied.walk, person, a, b)
      if arm < 0 do occupied else
        let mask = int_or(S.get(occupied.crossings, a), int_shl(1, arm))
        { occupied with crossings: NativeArray.set_int(occupied.crossings, a, mask) }
      end
    end
  end
  pfn reserve(c : Ur.Sim.City, cars : List(Citizen), occupied : Occupied) : Occupied do
    match cars do
      Nil -> occupied
      Cons(person, rest) ->
        match person.route do
        Cons(a, Cons(b, tail)) ->
          let occupied = if driving(c, person, a, b) do
            lane_set(occupied, cell(a, b, person.progress), position(person.progress))
          else if person.car_phase == 1 && person.progress > 0.5 do
            match tail do
              Cons(next, _) ->
                let merge = departure_merge(c, person, b, next)
                if merge > 0.0 do lane_set(occupied, cell(b, next, merge), position(merge)) else occupied end
              Nil -> occupied
            end
          else occupied end end
          reserve(c, rest, mark_crossing(occupied, person, a, b))
        _ -> reserve(c, rest, occupied)
      end
    end
  end
  pfn arrive(person : Citizen) : Citizen do
    let parking = if person.by_car do person.arrival else person.parking end
    let returning = returning_home(person)
    let activity = if evacuating(person) do 8 else if returning do 0 else person.activity end end
    { person with activity: activity, shelter: if returning do -1 else person.shelter end,
      location: person.target, transit_phase: 0, route: Nil, progress: 0.0, queued: false,
      by_car: false, car_phase: 0, parking: parking, arrival: 0, wait: 0.16, rest_until: -1 }
  end
  pfn transit_stop_for(c : Ur.Sim.City, running : NativeIntArr, lot : Int, service : Int, d : Int) : Int do
    if d >= 4 do -1 else
      let stop = S.neighbour(lot, d)
      let mode = S.get(c.transit, stop)
      if Ur.Fleet.passenger_mode(mode) && (service == 0 || mode == service) && S.get(running, stop) == 2 &&
        int_abs(S.get(c.heights, lot) - S.get(c.heights, stop)) <= 12 do stop
      else transit_stop_for(c, running, lot, service, d + 1) end
    end
  end
  fn transit_stop(c : Ur.Sim.City, running : NativeIntArr, lot : Int, d : Int) : Int do
    transit_stop_for(c, running, lot, 0, d)
  end
  type TransitSearch = { parents : NativeIntArr, queue : NativeIntArr, tail : Int }
  pfn add_transit(c : Ur.Sim.City, search : TransitSearch, i : Int, mode : Int, d : Int) : TransitSearch do
    if d >= 4 do search else
      let j = S.neighbour(i, d)
      let search = if S.transit_link(c, i, j, mode) && S.get(search.parents, j) < 0 do
        { parents: NativeArray.set_int(search.parents, j, i),
          queue: NativeArray.set_int(search.queue, search.tail, j), tail: search.tail + 1 }
      else search end
      add_transit(c, search, i, mode, d + 1)
    end
  end
  pfn find_transit(c : Ur.Sim.City, search : TransitSearch, start : Int, mode : Int, head : Int) : NativeIntArr do
    if head >= search.tail || S.get(search.parents, start) >= 0 do search.parents else
      find_transit(c, add_transit(c, search, S.get(search.queue, head), mode, 0), start, mode, head + 1)
    end
  end
  pfn trace_transit(parents : NativeIntArr, i : Int, end_stop : Int, target : Int) : List(Int) do
    if i == end_stop do Cons(i, Cons(target, Nil))
    else Cons(i, trace_transit(parents, S.get(parents, i), end_stop, target)) end
  end
  pfn transit_trip_from(c : Ur.Sim.City, running : NativeIntArr, origin : Int, target : Int, ground_legs : Int, required : Int) : List(Int) do
    let board = if S.valid(required) do required else transit_stop(c, running, origin, 0) end
    let mode = S.get(c.transit, board)
    let alight = transit_stop_for(c, running, target, mode, 0)
    if !S.valid(board) || !S.valid(alight) || board == alight || mode != S.get(c.transit, alight) do Nil else
      let search = { parents: NativeArray.set_int(NativeArray.make_int(2640, -1), alight, alight),
        queue: NativeArray.set_int(NativeArray.make_int(2640, 0), 0, alight), tail: 1 }
      let links = find_transit(c, search, board, mode, 0)
      if S.get(links, board) < 0 do Nil else
        let path = trace_transit(links, board, alight, target)
        let ride_legs = List.length(path) - 2
        let transit_cost = 5 + (4 - S.frequency(c, board)) + ride_legs * (if mode == 2 do 2 else 1 end)
        let ground_cost = if ground_legs <= 3 do ground_legs * 3 else ground_legs * 3 + 4 end
        if S.valid(required) || transit_cost <= ground_cost do Cons(origin, path) else Nil end
      end
    end
  end
  fn transit_trip(c : Ur.Sim.City, running : NativeIntArr, origin : Int, target : Int, ground_legs : Int) : List(Int) do
    transit_trip_from(c, running, origin, target, ground_legs, -1)
  end
  pfn car_corridor(c : Ur.Sim.City, route : List(Int)) : Bool do
    match route do
      Cons(i, Cons(j, rest)) -> S.motor_road(c, i) && car_corridor(c, Cons(j, rest))
      _ -> true
    end
  end
  pfn uses_grade(c : Ur.Sim.City, route : List(Int)) : Bool do
    match route do
      Cons(a, Cons(b, rest)) -> S.grade_link(c, a, b) || uses_grade(c, Cons(b, rest))
      _ -> false
    end
  end
  pfn timed_closure(c : Ur.Sim.City, route : List(Int)) : Bool do
    match route do
      Nil -> false
      Cons(i, rest) -> S.car_free_now(c, i) || timed_closure(c, rest)
    end
  end
  pfn scheduled_activity(c : Ur.Sim.City, person : Citizen, hour : Int) : (Int, Int) do
    let start = if person.study >= 0 do 6 + person.id % 3 else 7 + person.id % 3 end
    let end_hour = if person.study >= 0 && person.study < 2 do 15 + person.id % 2 else 16 + person.id % 3 end
    let school = person.study >= 0 && S.active_program_at(c, person.work) == person.study
    let work = S.valid(person.work) && (school || (S.job_slots(c, person.work) > 0 && qualified(c, person.work, person.qualification)))
    let festival = S.festival_destination(c, person.home)
    let holiday = S.attends_festival(c, person.home, person.id) && !S.essential_work(c, person.work)
    let sick = S.fever_absence(c, person.home, person.id)
    let working = work && !holiday && !sick && (if S.public_trade(c, person.work) do S.business_open(c, person.work, hour)
      else if S.get(c.plants, person.work) == 16 do hour >= 4 && hour < 20
      else c.street_day < 5 && hour >= start && hour < end_hour end end)
    let shopping = S.business_open(c, person.shop, hour) && (if S.nightlife(c, person.shop) do hour >= 18 || hour < 2
      else hour >= 11 + person.id % 4 && hour < 21 end)
    if working do (1, person.work)
    else if sick do (0, person.home)
    else if holiday && hour >= 9 && hour < 19 do (5, festival)
    else if shopping do (3, person.shop)
    else if S.valid(person.park) && hour >= 10 && hour < 19 do (5, person.park)
    else (0, person.home) end end end end end
  end
  pfn route_for(c : Ur.Sim.City, person : Citizen, target : Int) : List(Int) do
    if S.temple_tier(c, target) > 0 && target != person.work do S.festival_walk_route(c, person.location, target)
    else if S.temple_tier(c, person.location) > 0 && person.location != person.work do
      List.reverse(S.festival_walk_route(c, target, person.location))
    else if person.location == person.home do
      if target == person.work do person.work_route else if target == person.shop do person.shop_route else person.park_route end end
    else if target == person.home do
      List.reverse(if person.location == person.work do person.work_route else if person.location == person.shop do person.shop_route else person.park_route end end)
    else
      if person.study >= 0 && target == person.work do
        let (_, route) = destination(c, Ur.Food.campus_destinations(c, fn lot -> lot == target), person.location)
        route
      else if person.study >= 0 && person.location == person.work do
        let (_, from_home) = destination(c, Ur.Food.campus_destinations(c, fn lot -> lot == person.work), target)
        List.reverse(from_home)
      else
        let (_, route) = destination(c, Ur.Food.destinations(c, fn lot -> lot == target), person.location)
        route
      end end
    end end end end
  end
  pfn parking_walk(route : List(Int), road : Int, steps : Int) : Int do
    match route do
      Nil -> 999
      Cons(lot, rest) -> if lot == road do steps else parking_walk(rest, road, steps + 1) end
    end
  end
  pfn parking_departure(c : Ur.Sim.City, code : Int, target : Int, route : List(Int)) : List(Int) do
    match parking_at(code) do
      Some(start) ->
        let approach = parking_walk(route, start.road, 0)
        if start.kind != 0 || approach > 3 do route else
          match List.drop(route, approach) do
            Cons(road, Cons(peer, _)) ->
              if start.edge == curb_for_direction(road, peer) do route else
                let heading = match start.edge do
                  0 -> 3
                  1 -> 2
                  2 -> 0
                  _ -> 1
                end
                let next = S.neighbour(road, heading)
                if !connected(c, road, next) do route else
                  let links = Ur.Food.driving_destinations_avoiding(c, target, road)
                  if S.get(links, next) < 0 do route else
                    let tail = List.reverse(Ur.Food.path_to(links, next, Nil))
                    if List.length(tail) > List.length(route) + 6 do route
                    else List.append(List.take(route, approach + 1), tail) end
                  end
                end
              end
            _ -> route
          end
        end
      None -> route
    end
  end
  pfn trip_parking(c : Ur.Sim.City, person : Citizen, target : Int, route : List(Int), occupied : Occupied, drive_after : Int) : Option(Parking) do
    match parking_at(person.parking) do
      Some(start) ->
        let approach = parking_walk(route, start.road, 0)
        let can_pull_out = if start.kind != 0 do true else
          match List.drop(route, approach) do
            Cons(road, Cons(peer, _)) ->
              let (corner, _) = S.road_turn(c, road)
              corner < 0 && start.edge == curb_for_direction(road, peer)
            _ -> false
          end
        end
        if start.lot != person.location || approach > 3 || !S.motor_road(c, start.road) || !can_pull_out do None else
          let reversed = List.reverse(route)
          match along_parking(c, target, reversed, 0, occupied.parking_keys, true) do
            Some(finish) ->
              let access = approach - 1 + finish.steps
              let fee = S.parking_fee(finish.kind - 2) / 2
              let legs = List.length(route) - 1
              if S.motor_road(c, finish.road) && legs > drive_after + access * 2 + fee && legs > approach + finish.steps + 1 do Some(finish) else None end
            None -> None
          end
        end
      None -> None
    end
  end
  pfn trip(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), person : Citizen, occupied : Occupied, activity : Int, target : Int, route : List(Int), park_trip : Bool) : (Citizen, Occupied) do
    let route = if !park_trip && List.length(route) > 4 && timed_closure(c, route) && S.valid(person.location) && S.valid(target) do
      let (_, detour) = destination(c, Ur.Food.driving_destinations(c, target), person.location)
      if List.is_empty(detour) do route else detour end
    else route end
    let ground_legs = List.length(route) - 1
    let required = if person.location == person.home && target == person.work do person.work_board else -1 end
    let transit = if park_trip || person.location == target || person.study >= 4 do Nil
      else transit_trip_from(c, running, person.location, target, ground_legs, required) end
    let board = match transit do
      Cons(_, Cons(stop, _)) -> stop
      _ -> -1
    end
    let alight = if List.is_empty(transit) do -1 else transit_stop_for(c, running, target, S.get(c.transit, board), 0) end
    let uses_transit = !List.is_empty(transit) && (match bus do
      Some(service) -> Ur.Fleet.serves(service.routes, S.get(c.transit, board), board, alight)
      None -> true
    end)
    let route = if uses_transit do transit else route end
    let drive_after = if person.study >= 0 do 10 else 3 end
    let (arrival, route) = if person.location != target && !park_trip && !uses_transit &&
      (ground_legs > drive_after || uses_grade(c, route)) && car_corridor(c, List.drop(route, 1)) do
      let driving_route = parking_departure(c, person.parking, target, route)
      match trip_parking(c, person, target, driving_route, occupied, if uses_grade(c, driving_route) do 1 else drive_after end) do
        Some(spot) -> (Some(spot), driving_route)
        None -> (None, route)
      end
    else (None, route) end
    let by_car = match arrival do
      Some(_) -> true
      None -> false
    end
    let occupied = { occupied with parking_keys: hold(occupied.parking_keys, arrival) }
    let next = { person with activity: activity, park_trip: park_trip, target: target, route: route, progress: 0.0, queued: false, by_car: by_car, car_phase: if by_car do 1 else 0 end, arrival: parking_value(arrival), previous: -1, board: board, alight: alight, bus_slot: -1, transit_phase: if uses_transit do 1 else 0 end, rest_until: -1 }
    match route do
      Cons(_, Cons(_, _)) -> ({ next with location: -1 }, occupied)
      _ -> (arrive(next), occupied)
    end
  end
  pfn next_quad(c : Ur.Sim.City, lot : Int, root : Int, skip : Int, d : Int) : Int do
    if d == 4 do -1 else
      let peer = S.neighbour(lot, d)
      if peer != skip && S.campus_root(c, peer) == root && S.campus_quad(c, peer) do peer
      else next_quad(c, lot, root, skip, d + 1) end
    end
  end
  pfn quad_lap(c : Ur.Sim.City, school : Int) : List(Int) do
    let root = S.campus_root(c, school)
    let quad = next_quad(c, school, root, -1, 0)
    if !S.valid(quad) do Nil else
      let next = next_quad(c, quad, root, school, 0)
      let back = Cons(quad, Cons(school, Nil))
      if S.valid(next) do Cons(school, Cons(quad, Cons(next, back)))
      else Cons(school, back) end
    end
  end
  pfn stay_home(c : Ur.Sim.City, person : Citizen) : Bool do
    person.location == person.home && S.valid(person.home) && !S.valid(person.work) &&
      !S.valid(person.shop) && !S.valid(person.park) && S.festival_destination(c, person.home) < 0 &&
      !S.public_trade(c, person.home)
  end
  pfn depart(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), person : Citizen, occupied : Occupied, clock_hour : Int) : (Citizen, Occupied) do
    let hour = clock_hour % 24
    if stay_home(c, person) do
      ({ person with wait: 0.0, activity: 0, rest_until: clock_hour - hour + 24 }, occupied)
    else
    let (activity, target) = scheduled_activity(c, person, hour)
    let between_classes = person.study >= 3 && target == person.work && person.location == target &&
      person.campus_day != c.calendar_day && hour >= 10 + person.id % 3 && hour < 16
    let lap = if between_classes do quad_lap(c, target) else Nil end
    if !List.is_empty(lap) do
      trip(c, running, bus, { person with campus_day: c.calendar_day }, occupied, 1, target, lap, false)
    else if target == person.location do
      let indoors = S.valid(target) && activity != 5
      ({ person with wait: if indoors do 0.0 else 0.04 end, activity: activity, rest_until: if indoors do clock_hour + 1 else -1 end }, occupied)
    else
      let route = route_for(c, person, target)
      if List.is_empty(route) do ({ person with wait: 0.10 }, occupied) else
        trip(c, running, bus, person, occupied, activity, target, route, target == person.park || person.location == person.park ||
          target == S.festival_destination(c, person.home) || (S.temple_tier(c, person.location) > 0 && person.location != person.work))
      end
    end end end
  end
  pfn current_plot(route : List(Int)) : Int do
    match route do
      Cons(i, _) -> i
      Nil -> -1
    end
  end
  pfn next_leg(c : Ur.Sim.City, person : Citizen, occupied : Occupied, b : Int, tail : List(Int)) : (Citizen, Occupied) do
    match tail do
      Nil -> (arrive({ person with previous: current_plot(person.route) }), occupied)
      Cons(next, _) ->
        let car_phase = match (person.car_phase, parking_at(person.parking), parking_at(person.arrival)) do
          (1, Some(p), _) -> if b == p.road do 2 else 1 end
          (2, _, Some(p)) -> if current_plot(person.route) == p.road do 3 else 2 end
          _ -> person.car_phase
        end
        let entry = departure_merge(c, person, b, next)
        let person = { person with car_phase: car_phase }
        let progress = if driving(c, person, b, next) do entry else 0.0 end
        let occupied = if driving(c, person, b, next) do lane_set(occupied, cell(b, next, progress), position(progress)) else occupied end
        let phase = if person.transit_phase == 1 && b == person.board do 2
          else if person.transit_phase == 3 && b == person.alight do 4 else person.transit_phase end end
        let wait = if phase == 2 do 3.0 /. int_to_float(S.frequency(c, b)) else 0.0 end
        ({ person with route: Cons(b, tail), previous: current_plot(person.route), progress: progress, queued: false, transit_phase: phase, wait: wait }, occupied)
    end
  end
  pfn next_clear(c : Ur.Sim.City, person : Citizen, occupied : Occupied, b : Int, tail : List(Int)) : Bool do
    match tail do
      Nil -> true
      Cons(next, _) ->
        let leaving = person.car_phase == 2 && (match parking_at(person.arrival) do
          Some(p) -> p.road == current_plot(person.route)
          None -> false
        end)
        leaving || !driving(c, person, b, next) ||
          lane_room(occupied, cell(b, next, 0.0), position(0.0), 0)
    end
  end
  pfn walk_through_junction(person : Citizen, occupied : Occupied, a : Int, b : Int, proposed : Float) : Float do
    if S.get(occupied.junctions, a) != 2 do proposed else
      match walk_corners(occupied.walk, person, a, b) do
        Some((sx, sz, ex, ez)) ->
          let first = crossing_arm(sx, sz, ex, ez, 0)
          let second = crossing_arm(sx, sz, ex, ez, 1)
          let step = crossing_step()
          if person.progress == 0.0 && walk_arm(occupied.walk, a, first) &&
             !S.crosswalk_open(a, first, occupied.signal_tick) do 0.0
          else if person.progress <= step && proposed > step && walk_arm(occupied.walk, a, second) &&
             !S.crosswalk_open(a, second, occupied.signal_tick) do step
          else proposed end end
        None -> proposed
      end
    end
  end
  pfn walk(c : Ur.Sim.City, person : Citizen, occupied : Occupied, dt : Float, b : Int, tail : List(Int)) : (Citizen, Occupied) do
    let speed = if person.study >= 0 && !person.park_trip do 3.6 else 0.32 end
    let a = current_plot(person.route)
    let pace = walk_segment_pace(occupied.walk, a, b)
    let proposed = walk_through_junction(person, occupied, a, b, person.progress +. dt *. speed *. pace)
    let occupied = mark_crossing(occupied, { person with progress: proposed }, a, b)
    let (progress, occupied) = match tail do
      Cons(next, _) ->
        let merge = departure_merge(c, person, b, next)
        if merge > 0.0 && person.progress <= 0.5 && proposed > 0.5 do
          if lane_room(occupied, cell(b, next, 0.0), position(merge), 0) do
            (proposed, lane_set(occupied, cell(b, next, merge), position(merge)))
          else (0.5, occupied) end
        else (proposed, occupied) end
      Nil -> (proposed, occupied)
    end
    if progress < 1.0 do ({ person with progress: progress }, occupied)
    else next_leg(c, person, occupied, b, tail) end
  end
  pfn junction_clear(c : Ur.Sim.City, occupied : Occupied, i : Int, approach : Int, d : Int) : Bool do
    if d >= 4 do true else
      let peer = S.neighbour(i, d)
      let exiting = connected(c, i, peer) && (lane_get(occupied, cell(i, peer, 0.0)) > 0 ||
        (lane_get(occupied, cell(i, peer, 0.25)) > 0 && lane_get(occupied, cell(i, peer, 0.25)) < position(0.44)))
      let entering = peer != approach && connected(c, peer, i) &&
        (lane_get(occupied, cell(peer, i, S.stop_line())) > position(S.stop_line()) ||
         lane_get(occupied, cell(peer, i, 0.5)) > 0 || lane_get(occupied, cell(peer, i, 0.99)) > 0)
      if exiting || entering do false else junction_clear(c, occupied, i, approach, d + 1) end
    end
  end
  pfn gap_limit(occupied : Occupied, slot : Int, last : Int, proposed : Float) : Float do
    if slot > last do proposed else
      let leader = lane_get(occupied, slot)
      if leader > 0 do
        let limit = int_to_float(leader - 1) /. 1000.0 -. 0.26
        if limit < proposed do limit else proposed end
      else gap_limit(occupied, slot + 1, last, proposed) end
    end
  end
  pfn drive(c : Ur.Sim.City, person : Citizen, occupied : Occupied, hour : Int, dt : Float, a : Int, b : Int, tail : List(Int)) : (Citizen, Occupied) do
    let direction = S.direction(a, b)
    let old = cell(a, b, person.progress)
    let speed = if S.get(c.roads, a) == 2 && S.get(c.roads, b) == 2 do 0.78 else 0.62 end
    let length = if S.grade_link(c, a, b) do int_to_float(S.span_distance(a, b)) else 1.0 end
    let pace = if S.storm_road_closed(c, b) do 0.0 else S.rain_road_pace(c) end
    let proposed = person.progress +. dt *. speed *. pace *. S.traffic_pace(c.street_day, hour) /. length
    let end_at = match parking_at(person.arrival) do
      Some(p) -> if b == p.road do parking_entry(p) else 1.0 end
      None -> 1.0
    end
    let limit = gap_limit(occupied, old + 1, cell(a, b, 1.0), proposed)
    let junction = if end_at > S.stop_line() && !S.grade_link(c, a, b) do S.get(occupied.junctions, b) else 0 end
    let clear = next_clear(c, person, occupied, b, tail)
    let stop = if junction > 0 do S.stop_line() else 0.72 end
    let stopped = if junction == 1 && person.progress == stop do person.wait +. dt else person.wait end
    let permission = if junction == 1 do person.wait >= 0.45
      else if junction == 2 do S.signal_green(b, direction, occupied.signal_tick) else true end end
    let exit_mask = match tail do
      Cons(next, _) -> int_shl(1, S.direction(b, next))
      Nil -> 0
    end
    let crossed_arms = int_or(int_shl(1, S.opposite(direction)), exit_mask)
    let blocked = junction > 0 && person.progress <= stop &&
      (!permission || int_and(crossed_arms, S.get(occupied.crossings, b)) > 0 || !junction_clear(c, occupied, b, a, 0))
    let limit = if limit > stop && (blocked || (end_at == 1.0 && !clear)) do stop else limit end
    let progress = if limit < person.progress do person.progress else limit end
    if progress >= end_at && clear do
      next_leg(c, person, lane_set(occupied, old, 0), b, tail)
    else
      let next = cell(a, b, progress)
      if next != old && lane_get(occupied, next) > 0 do ({ person with queued: true }, occupied)
      else ({ person with progress: progress, wait: stopped, queued: progress < proposed }, lane_set(lane_set(occupied, old, 0), next, position(progress))) end
    end
  end
  pfn alight_route(route : List(Int), lot : Int) : List(Int) do
    match route do
      Nil -> Nil
      Cons(i, rest) -> if i == lot do route else alight_route(rest, lot) end
    end
  end
  pfn board_passenger(c : Ur.Sim.City, person : Citizen, active : List(Ur.Fleet.Run), motion : NativeFloatArr, seats : NativeIntArr, dt : Float) : Citizen do
    let (slot, arrival) = Ur.Fleet.boarding(active, S.get(c.transit, person.board), person.board, person.alight, seats)
    if slot >= 0 do { person with bus_slot: slot, transit_phase: 3, wait: arrival, progress: NativeArray.get_float(motion, slot) }
    else if person.wait > -75.0 do { person with wait: person.wait -. dt }
    else
      let links = Ur.Food.destinations(c, fn lot -> lot == person.target)
      let path = Ur.Food.path_to(links, person.board, Nil)
      let route = if S.get(links, person.board) >= 0 do List.reverse(path) else Nil end
      { person with route: route, location: person.board, transit_phase: 0, wait: 0.0 }
    end end
  end
  pfn ride_passenger(person : Citizen, progress : Float) : Citizen do
    if progress < person.progress do
      { person with route: Nil, location: person.board, previous: -1, bus_slot: -1, transit_phase: 0, progress: 0.0, wait: 0.0 }
    else if progress >= person.wait do
      { person with route: alight_route(person.route, person.alight), previous: -1, bus_slot: -1, transit_phase: 4, progress: 0.0, wait: 0.0 }
    else if progress == person.progress do person else { person with progress: progress } end end end
  end
  pfn advance_trip(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), person : Citizen, occupied : Occupied, clock_hour : Int, dt : Float) : (Citizen, Occupied) do
    match person.route do
      Cons(a, Cons(b, tail)) ->
        if person.transit_phase == 2 && S.get(running, person.board) != 2 && Option.is_some(bus) do
          ({ person with route: Nil, location: person.board, transit_phase: 0, progress: 0.0, wait: 0.0 }, occupied)
        else if (person.transit_phase == 2 || person.transit_phase == 3) && S.get(c.transit, person.board) >= 3 && S.get(running, person.board) == 0 do
          if person.transit_phase == 2 do
            ({ person with route: Nil, location: person.board, transit_phase: 0, progress: 0.0, wait: 0.0 }, occupied)
          else (person, occupied) end
        else if person.transit_phase == 2 do
          if person.wait > 0.0 do ({ person with wait: person.wait -. dt }, occupied)
          else ({ person with transit_phase: 3 }, occupied) end
        else if person.transit_phase == 3 do
          let speed = if S.get(c.transit, person.board) == 3 do 0.85 else 0.65 end
          let progress = person.progress +. dt *. speed
          if progress >= 1.0 do next_leg(c, person, occupied, b, tail)
          else ({ person with progress: progress }, occupied) end
        else if driving(c, person, a, b) do drive(c, person, occupied, clock_hour % 24, dt, a, b, tail)
        else walk(c, person, occupied, dt, b, tail) end end end end end
      _ ->
        if person.wait > 0.0 do ({ person with wait: person.wait -. dt }, occupied)
        else if emergency_move(person) do (person, occupied)
        else depart(c, running, bus, person, occupied, clock_hour) end end
    end
  end
  fn sanitation_driver(people : List(Citizen), depot : Int, pickup : Int) : Int do
    let ready = List.filter(people, fn person -> person.work == depot && person.work_position >= 2 &&
      person.location == depot && person.activity == 1 && List.is_empty(person.route))
    match List.drop(ready, pickup % S.clamp(List.length(ready), 1, 3)) do
      Cons(person, _) -> person.id
      Nil -> -1
    end
  end
  fn sanitation_crew(people : List(Citizen), previous : Int, driver : Int) : List(Citizen) do
    if previous == driver && driver < 0 do people else
      List.map(people, fn person ->
        if person.id == driver do
          if person.activity == 6 do person else { person with activity: 6, rest_until: -1 } end
        else if person.activity == 6 do { person with activity: 1, rest_until: -1 } else person end end)
    end
  end
  pfn transit_waiter(c : Ur.Sim.City, running : NativeIntArr, person : Citizen) : Bool do
    person.transit_phase == 2 && S.get(running, person.board) == 2 && Ur.Fleet.passenger_mode(S.get(c.transit, person.board))
  end
  pfn queue_boarding(c : Ur.Sim.City, active : List(Ur.Fleet.Run), motion : NativeFloatArr, queue : List(Citizen), seats : NativeIntArr, dt : Float, out : List(Citizen)) : List(Citizen) do
    match queue do
      Nil -> out
      Cons(person, rest) ->
        let next = board_passenger(c, person, active, motion, seats, dt)
        let seats = if next.bus_slot >= 0 do
          NativeArray.set_int(seats, next.bus_slot, NativeArray.get_int(seats, next.bus_slot) + 1)
        else seats end
        queue_boarding(c, active, motion, rest, seats, dt, Cons(next, out))
    end
  end
  pfn transit_boarding(c : Ur.Sim.City, active : List(Ur.Fleet.Run), motion : NativeFloatArr, cars : List(Citizen), waiters : List(Citizen), dt : Float) : List(Citizen) do
    if List.is_empty(waiters) do Nil else
      let seats = List.fold_left(cars, NativeArray.make_int(180, 0), fn (seats, rider) ->
        let slot = rider.bus_slot
        if slot < 0 do seats else
          let progress = NativeArray.get_float(motion, slot)
          if progress < rider.progress || progress >= rider.wait do seats
          else NativeArray.set_int(seats, slot, NativeArray.get_int(seats, slot) + 1) end
        end)
      let queue = List.sort_by(List.reverse(waiters), fn (a, b) -> a.wait <= b.wait)
      queue_boarding(c, active, motion, queue, seats, dt, Nil)
    end
  end
  pfn resting(person : Citizen, clock_hour : Int) : Bool do
    (person.rest_until > clock_hour && (person.rest_until - 1) / 24 == clock_hour / 24) ||
      (emergency_move(person) && person.wait <= 0.0 && List.is_empty(person.route))
  end
  fn wake_indoor(people : List(Citizen)) : List(Citizen) do
    List.map(people, fn person -> if person.rest_until < 0 do person else { person with rest_until: -1 } end)
  end
  pfn advance_person(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), person : Citizen, occupied : Occupied,
    clock_hour : Int, dt : Float, motion : NativeFloatArr, boarding : List(Citizen)) : (Citizen, Occupied) do
    let (next, occupied) = if person.bus_slot >= 0 do
      (ride_passenger(person, NativeArray.get_float(motion, person.bus_slot)), occupied)
    else
      let update = if transit_waiter(c, running, person) do List.find(boarding, fn rider -> rider.id == person.id) else None end
      match update do
        Some(next) -> (next, occupied)
        None -> advance_trip(c, running, bus, person, occupied, clock_hour, dt)
      end
    end
    let at_business = S.valid(next.location) && S.public_trade(c, next.location)
    let next = if !emergency_move(next) && at_business && !S.business_open(c, next.location, clock_hour % 24) do
      { next with activity: 0, wait: 0.0 }
    else next end
    (next, occupied)
  end
  pfn count_person(c : Ur.Sim.City, person : Citizen, n : CitizenCounts, delta : Int) : CitizenCounts do
    let n = { n with tracked: n.tracked + delta }
    let n = if evacuating(person) do { n with evacuating: n.evacuating + delta }
      else if sheltered(person) do { n with sheltered: n.sheltered + delta }
      else if returning_home(person) do { n with returning: n.returning + delta }
      else if waiting_for_shelter(person) do { n with stranded: n.stranded + delta }
      else n end end end end
    if person.activity == 6 do { n with driving: n.driving + delta }
    else if person.transit_phase == 2 do { n with waiting: n.waiting + delta }
    else if person.transit_phase == 3 do { n with riding: n.riding + delta }
    else if person.location < 0 do
      match person.route do
        Cons(a, Cons(b, _)) -> if driving(c, person, a, b) do { n with driving: n.driving + delta, queued: n.queued + (if person.queued do delta else 0 end) }
          else { n with walking: n.walking + delta } end
        _ -> n
      end
      else if person.location == person.home do { n with home: n.home + delta }
      else if person.activity == 5 && S.get(c.parks, person.location) > 0 do { n with visiting_park: n.visiting_park + delta }
      else if person.activity == 3 && person.location == person.shop do { n with shopping: n.shopping + delta }
      else if person.activity == 1 && person.location == person.work do
        if person.study >= 0 do { n with studying: n.studying + delta } else { n with at_work: n.at_work + delta } end
      else n end end end end end end end end
  end
  pfn empty_counts() : CitizenCounts do
    { tracked: 0, walking: 0, waiting: 0, riding: 0, driving: 0, queued: 0, at_work: 0, studying: 0, shopping: 0, visiting_park: 0, home: 0,
      evacuating: 0, sheltered: 0, returning: 0, stranded: 0 }
  end
  fn tally(c : Ur.Sim.City, cars : List(Citizen)) : CitizenCounts do
    List.fold_left(cars, empty_counts(), fn (n, person) -> count_person(c, person, n, 1))
  end

  type Actor = { slot : Int, person : Citizen }
  type WalkEvent = { entry : Actor, started : Float, finish : Float, limit : Float, arm : Int }
  type WalkStage = { limit : Float, arm : Int, gate : Bool }
  type Roster = { walk_time : Float, walk_bucket : Int, walk_events : Map(Int, List(WalkEvent)), walk_crossings : Map(Int, Int),
    walk_count : Int, walk_exits : List(Int), active : List(Actor), sleeping : Map(Int, Actor), wakeups : Map(Int, List(Actor)), clock : Int,
    parked_actors : Map(Int, Actor), reservations : Map(Int, Int), indoor : CitizenCounts, crew : List(Citizen), parcels : Map(Int, List(Int)) }

  pfn hour_at(time : Float) : Int do
    float_to_int(Math.floor(time /. S.day_seconds())) * 24 + S.street_hour(time)
  end
  pfn wake_at(c : Ur.Sim.City, person : Citizen, hour : Int) : Int do
    if person.activity == 6 || (emergency_move(person) && person.wait <= 0.0 && List.is_empty(person.route)) do
      -2
    else if person.activity == 0 && person.wait <= 0.0 && List.is_empty(person.route) && stay_home(c, person) do
      -2
    else if resting(person, hour) do person.rest_until
    else -1 end end end
  end
  pfn sleep_actor(c : Ur.Sim.City, roster : Roster, entry : Actor, wake : Int) : Roster do
    let sleeping = Map.insert(roster.sleeping, entry.person.id, entry, Map.int_cmp)
    let wakeups = if wake == -2 do roster.wakeups else
      Map.insert(roster.wakeups, wake, Cons(entry, Map.get_or(roster.wakeups, wake, Nil, Map.int_cmp)), Map.int_cmp)
    end
    let parked = if entry.person.parking != 0 do Map.insert(roster.parked_actors, entry.slot, entry, Map.int_cmp) else roster.parked_actors end
    let crew = if entry.person.activity == 6 do Cons(entry.person, roster.crew) else roster.crew end
    { roster with sleeping: sleeping, wakeups: wakeups, parked_actors: parked, crew: crew,
      reservations: park_actor(roster.reservations, entry.person, 1), indoor: count_person(c, entry.person, roster.indoor, 1) }
  end
  pfn register_parcel(parcels : Map(Int, List(Int)), lot : Int, id : Int) : Map(Int, List(Int)) do
    if !S.valid(lot) do parcels else
      Map.insert(parcels, lot, Cons(id, Map.get_or(parcels, lot, Nil, Map.int_cmp)), Map.int_cmp)
    end
  end
  pfn index_people(c : Ur.Sim.City, people : List(Citizen), roster : Roster, slot : Int) : Roster do
    match people do
      Nil -> { roster with active: List.reverse(roster.active) }
      Cons(person, rest) ->
        let entry = { slot: slot, person: person }
        let parcels = register_parcel(roster.parcels, person.home, person.id)
        let parcels = if person.work == person.home do parcels else register_parcel(parcels, person.work, person.id) end
        let parcels = if person.shelter == person.home || person.shelter == person.work do parcels else register_parcel(parcels, person.shelter, person.id) end
        let roster = { roster with parcels: parcels }
        let wake = wake_at(c, person, roster.clock)
        let next = if wake == -1 do { roster with active: Cons(entry, roster.active) }
          else sleep_actor(c, roster, entry, wake) end
        index_people(c, rest, next, slot + 1)
    end
  end
  fn index(c : Ur.Sim.City, people : List(Citizen), time : Float) : Roster do
    index_people(c, people, { walk_time: 0.0, walk_bucket: 0, walk_events: Map.empty(), walk_crossings: Map.empty(),
      walk_count: 0, walk_exits: Nil, active: Nil, sleeping: Map.empty(), wakeups: Map.empty(), clock: hour_at(time),
      parked_actors: Map.empty(), reservations: Map.empty(), indoor: empty_counts(), crew: Nil, parcels: Map.empty() }, 0)
  end
  pfn slot_order(a : Actor, b : Actor) : Bool do a.slot <= b.slot end
  pfn merge_ordered(a : List(Actor), b : List(Actor), reversed : List(Actor)) : List(Actor) do
    match (a, b) do
      (Nil, _) -> List.reverse(List.fold_left(b, reversed, fn (out, entry) -> Cons(entry, out)))
      (_, Nil) -> List.reverse(List.fold_left(a, reversed, fn (out, entry) -> Cons(entry, out)))
      (Cons(left, rest_left), Cons(right, rest_right)) ->
        if left.slot < right.slot do merge_ordered(rest_left, b, Cons(left, reversed))
        else merge_ordered(a, rest_right, Cons(right, reversed)) end
    end
  end
  pfn merge_actors(a : List(Actor), b : List(Actor)) : List(Actor) do
    if List.is_empty(a) do b else if List.is_empty(b) do a else merge_ordered(a, b, Nil) end end
  end
  fn walker_at(event : WalkEvent, time : Float) : Citizen do
    let person = event.entry.person
    if event.limit == person.progress || time <= event.started do person else
      let t = if time >= event.finish do 1.0 else (time -. event.started) /. (event.finish -. event.started) end
      { person with progress: person.progress +. (event.limit -. person.progress) *. t }
    end
  end
  fn each_walk(roster : Roster, draw : Int -> Citizen -> Unit) : Unit do
    Map.fold(roster.walk_events, (), fn (_, _, events) ->
      List.each(events, fn event -> draw(event.entry.slot, walker_at(event, roster.walk_time))))
  end
  fn begin_walk_frame(roster : Roster) : Roster do { roster with walk_exits: Nil } end
  pfn walk_entries(roster : Roster) : List(Actor) do
    Map.fold(roster.walk_events, Nil, fn (entries, _, events) ->
      List.fold_left(events, entries, fn (out, event) ->
        Cons({ slot: event.entry.slot, person: walker_at(event, roster.walk_time) }, out)))
  end
  fn wake_walkers(roster : Roster) : Roster do
    let due = List.sort_by(walk_entries(roster), slot_order)
    { roster with active: merge_actors(roster.active, due), walk_events: Map.empty(), walk_crossings: Map.empty(),
      walk_count: 0, walk_exits: List.map(due, fn entry -> entry.slot) }
  end
  fn snapshot(roster : Roster) : List(Citizen) do
    let entries = List.append(walk_entries(roster), List.append(roster.active, Map.values(roster.sleeping)))
    List.map(List.sort_by(entries, slot_order), fn entry -> entry.person)
  end
  fn find(roster : Roster, id : Int) : Option(Citizen) do
    match Map.get(roster.sleeping, id, Map.int_cmp) do
      Some(entry) -> Some(entry.person)
      None ->
        match List.find(roster.active, fn entry -> entry.person.id == id) do
          Some(entry) -> Some(entry.person)
          None -> Map.fold(roster.walk_events, None, fn (found, _, events) ->
            if Option.is_some(found) do found else
              Option.map(List.find(events, fn event -> event.entry.person.id == id), fn event -> walker_at(event, roster.walk_time))
            end)
        end
    end
  end
  fn visible_people(roster : Roster) : List(Citizen) do
    List.map(List.append(walk_entries(roster), visible_actors(roster)), fn entry -> entry.person)
  end
  fn at_parcel(roster : Roster, lot : Int) : List(Citizen) do
    List.fold_left(Map.get_or(roster.parcels, lot, Nil, Map.int_cmp), Nil, fn (people, id) ->
      match find(roster, id) do
        Some(person) -> Cons(person, people)
        None -> people
      end)
  end
  fn visible_actors(roster : Roster) : List(Actor) do
    merge_actors(roster.active, List.sort_by(Map.values(roster.parked_actors), slot_order))
  end
  fn indexed_counts(c : Ur.Sim.City, roster : Roster) : CitizenCounts do
    let counts = List.fold_left(roster.active, roster.indoor, fn (counts, entry) -> count_person(c, entry.person, counts, 1))
    { counts with tracked: counts.tracked + roster.walk_count, walking: counts.walking + roster.walk_count }
  end
  fn has_evacuation(roster : Roster) : Bool do
    let n = roster.indoor
    n.evacuating + n.sheltered + n.returning + n.stranded > 0 ||
      List.any(roster.active, fn entry -> emergency_move(entry.person))
  end
  pfn wake_actor(c : Ur.Sim.City, roster : Roster, entry : Actor) : Roster do
    let parked = if entry.person.parking != 0 do Map.remove(roster.parked_actors, entry.slot, Map.int_cmp) else roster.parked_actors end
    let sleeping = Map.remove(roster.sleeping, entry.person.id, Map.int_cmp)
    { roster with sleeping: sleeping, parked_actors: parked, reservations: park_actor(roster.reservations, entry.person, -1),
      indoor: count_person(c, entry.person, roster.indoor, -1) }
  end
  pfn wake_through(c : Ur.Sim.City, roster : Roster, hour : Int, due : List(Actor)) : Roster do
    if roster.clock >= hour || Map.is_empty(roster.wakeups) do
      { roster with clock: hour, active: merge_actors(roster.active, List.sort_by(due, slot_order)) }
    else
      let next = roster.clock + 1
      match Map.get(roster.wakeups, next, Map.int_cmp) do
        None -> wake_through(c, { roster with clock: next }, hour, due)
        Some(batch) ->
          let roster = List.fold_left(batch, roster, fn (r, entry) -> wake_actor(c, r, entry))
          let roster = { roster with wakeups: Map.remove(roster.wakeups, next, Map.int_cmp), clock: next }
          wake_through(c, roster, hour, List.append(batch, due))
      end
    end
  end
  pfn active_parking(cars : List(Citizen), keys : Map(Int, Int)) : Map(Int, Int) do
    List.fold_left(cars, keys, fn (keys, person) -> park_actor(keys, person, 1))
  end
  pfn crossing_reservation(reservations : Map(Int, Int), arm : Int, delta : Int) : Map(Int, Int) do
    if arm < 0 do reservations else
      let count = Map.get_or(reservations, arm, 0, Map.int_cmp) + delta
      if count == 0 do Map.remove(reservations, arm, Map.int_cmp)
      else Map.insert(reservations, arm, count, Map.int_cmp) end
    end
  end
  pfn reserve_walks(roster : Roster) : NativeIntArr do
    Map.fold(roster.walk_crossings, NativeArray.make_int(S.count(), 0), fn (field, key, _) ->
      let lot = key / 4
      NativeArray.set_int(field, lot, int_or(S.get(field, lot), int_shl(1, key % 4))))
  end
  pfn queue_walk(roster : Roster, event : WalkEvent) : Roster do
    -- Quantize dispatch only. The interpolated pose uses the exact end time.
    let bucket = float_to_int(Math.ceil(event.finish *. 40.0))
    let events = Map.get_or(roster.walk_events, bucket, Nil, Map.int_cmp)
    { roster with walk_events: Map.insert(roster.walk_events, bucket, Cons(event, events), Map.int_cmp),
      walk_count: roster.walk_count + 1, walk_crossings: crossing_reservation(roster.walk_crossings, event.arm, 1) }
  end
  pfn sidewalk_stage(map : WalkMap, person : Citizen, a : Int, b : Int) : WalkStage do
    let progress = person.progress
    let step = crossing_step()
    if progress >= step *. 2.0 do { limit: 1.0, arm: -1, gate: false } else
      match walk_corners(map, person, a, b) do
        None -> { limit: 1.0, arm: -1, gate: false }
        Some((sx, sz, ex, ez)) ->
          let arm = crossing_arm(sx, sz, ex, ez, if progress < step do 0 else 1 end)
          { limit: if progress < step do step else step *. 2.0 end,
            arm: if walk_arm(map, a, arm) do arm else -1 end, gate: progress == 0.0 || progress == step }
      end
    end
  end
  pfn crosswalk_wakeup(a : Int, arm : Int, tick : Int) : Int do
    if S.crosswalk_open(a, arm, tick) do tick else crosswalk_wakeup(a, arm, tick + 1) end
  end
  pfn ordinary_walk(person : Citizen) : Bool do
    person.location < 0 && person.car_phase == 0 && person.parking == 0 && !person.park_trip &&
      person.study < 0 && !emergency_move(person) && person.transit_phase != 2 && person.transit_phase != 3 && person.bus_slot < 0
  end
  pfn plan_walk(entry : Actor, occupied : Occupied, tick_time : Float, now : Float, guard : Int -> Citizen -> Citizen -> Citizen) : Option(WalkEvent) do
    let person = entry.person
    if !ordinary_walk(person) do None else
      match person.route do
        Cons(a, Cons(b, _)) ->
          let pace = walk_segment_pace(occupied.walk, a, b)
          let (turn_a, _) = walk_turn(occupied.walk, a)
          let (turn_b, _) = walk_turn(occupied.walk, b)
          if pace <= 0.0 || turn_a >= 0 || turn_b >= 0 || S.span_distance(a, b) != 1 || person.progress >= 1.0 do None else
            let stage = sidewalk_stage(occupied.walk, person, a, b)
            if stage.gate && stage.arm >= 0 && S.get(occupied.junctions, a) == 2 &&
              !S.crosswalk_open(a, stage.arm, occupied.signal_tick) do
              let green = int_to_float(crosswalk_wakeup(a, stage.arm, occupied.signal_tick)) *. 0.5
              Some({ entry: entry, started: now, finish: now +. (green -. tick_time), limit: person.progress, arm: -1 })
            else
              let target = { person with progress: stage.limit }
              let checked = guard(entry.slot, person, target)
              if checked.progress != stage.limit do None else
                let arm = if stage.arm >= 0 && S.get(occupied.junctions, a) != 0 do a * 4 + stage.arm else -1 end
                Some({ entry: entry, started: now, finish: now +. (stage.limit -. person.progress) /. (0.32 *. pace),
                  limit: stage.limit, arm: arm })
              end
            end
          end
        _ -> None
      end
    end
  end
  pfn complete_walk(c : Ur.Sim.City, event : WalkEvent, occupied : Occupied, clock : Int) : Citizen do
    let person = { event.entry.person with progress: event.limit }
    if event.limit < 1.0 do person else
      match person.route do
        Cons(_, Cons(b, tail)) ->
          let (next, _) = next_leg(c, person, occupied, b, tail)
          if S.valid(next.location) && S.public_trade(c, next.location) && !S.business_open(c, next.location, clock % 24) do
            { next with activity: 0, wait: 0.0 }
          else next end
        _ -> person
      end
    end
  end
  pfn finish_walks(c : Ur.Sim.City, events : List(WalkEvent), roster : Roster, occupied : Occupied, tick_time : Float,
    guard : Int -> Citizen -> Citizen -> Citizen, waking : List(Actor)) : (Roster, List(Actor)) do
    match events do
      Nil -> (roster, waking)
      Cons(event, rest) ->
        let roster = { roster with walk_count: roster.walk_count - 1,
          walk_crossings: crossing_reservation(roster.walk_crossings, event.arm, -1) }
        let person = complete_walk(c, event, occupied, roster.clock)
        let entry = { slot: event.entry.slot, person: person }
        match plan_walk(entry, occupied, tick_time, roster.walk_time, guard) do
          Some(next) -> finish_walks(c, rest, queue_walk(roster, next), occupied, tick_time, guard, waking)
          None ->
            let roster = { roster with walk_exits: Cons(entry.slot, roster.walk_exits) }
            finish_walks(c, rest, roster, occupied, tick_time, guard, Cons(entry, waking))
        end
    end
  end
  pfn dispatch_walks(c : Ur.Sim.City, roster : Roster, occupied : Occupied, tick_time : Float, through : Int,
    guard : Int -> Citizen -> Citizen -> Citizen, waking : List(Actor)) : (Roster, List(Actor)) do
    if roster.walk_bucket >= through || Map.is_empty(roster.walk_events) do
      ({ roster with walk_bucket: through }, waking)
    else
      let bucket = roster.walk_bucket + 1
      let roster = { roster with walk_bucket: bucket }
      match Map.get(roster.walk_events, bucket, Map.int_cmp) do
        None -> dispatch_walks(c, roster, occupied, tick_time, through, guard, waking)
        Some(events) ->
          let roster = { roster with walk_events: Map.remove(roster.walk_events, bucket, Map.int_cmp) }
          let (roster, waking) = finish_walks(c, events, roster, occupied, tick_time, guard, waking)
          dispatch_walks(c, roster, occupied, tick_time, through, guard, waking)
      end
    end
  end
  pfn advance_actors(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), actors : List(Actor),
    roster : Roster, occupied : Occupied, dt : Float, tick_time : Float, motion : NativeFloatArr, boarding : List(Citizen),
    guard : Int -> Citizen -> Citizen -> Citizen, schedule : Bool) : Roster do
    match actors do
      Nil -> { roster with active: List.reverse(roster.active) }
      Cons(entry, rest) ->
        let (person, occupied) = advance_person(c, running, bus, entry.person, occupied, roster.clock, dt, motion, boarding)
        let person = guard(entry.slot, entry.person, person)
        let entry = { entry with person: person }
        let event = if schedule do plan_walk(entry, occupied, tick_time, roster.walk_time, guard) else None end
        let roster = match event do
          Some(event) -> queue_walk(roster, event)
          None ->
            let wake = wake_at(c, person, roster.clock)
            if wake == -1 do { roster with active: Cons(entry, roster.active) }
            else sleep_actor(c, roster, entry, wake) end
        end
        advance_actors(c, running, bus, rest, roster, occupied, dt, tick_time, motion, boarding, guard, schedule)
    end
  end
  pfn step_roster(c : Ur.Sim.City, walk : WalkMap, running : NativeIntArr, bus : Option(TransitService), roster : Roster, time : Float,
    dt : Float, junctions : NativeIntArr, traffic_time : Float, guard : Int -> Citizen -> Citizen -> Citizen, schedule : Bool) : Roster do
    let hour = hour_at(time)
    let roster = if hour > roster.clock do wake_through(c, roster, hour, Nil) else roster end
    let time = roster.walk_time +. dt
    let roster = { roster with walk_time: time }
    if List.is_empty(roster.active) && roster.walk_count == 0 do
      { roster with walk_bucket: float_to_int(Math.floor(time *. 40.0)) }
    else
      let occupancy = { walk: walk, lanes: NativeArray.make_int(S.count() * 16, 0), parking_keys: roster.reservations,
        junctions: junctions, crossings: reserve_walks(roster), signal_tick: S.signal_tick(traffic_time) }
      let (roster, waking) = dispatch_walks(c, roster, occupancy, traffic_time, float_to_int(Math.floor(time *. 40.0)), guard, Nil)
      let cars = List.map(roster.active, fn entry -> entry.person)
      let occupancy = { occupancy with parking_keys: active_parking(cars, roster.reservations), crossings: reserve_walks(roster) }
      let (motion, boarding) = match bus do
        Some(service) ->
          let motion = Ur.Fleet.passenger_progress(service.active)
          let waiters = List.fold_left(cars, Nil, fn (waiters, person) -> if transit_waiter(c, running, person) do Cons(person, waiters) else waiters end)
          (motion, transit_boarding(c, service.active, motion, cars, waiters, dt))
        None -> (Ur.Fleet.passenger_progress(Nil), Nil)
      end
      let next = advance_actors(c, running, bus, roster.active, { roster with active: Nil }, reserve(c, cars, occupancy),
        dt, traffic_time, motion, boarding, guard, schedule)
      { next with active: merge_actors(next.active, List.sort_by(waking, slot_order)) }
    end
  end
  fn step_guarded(c : Ur.Sim.City, walk : WalkMap, running : NativeIntArr, bus : Option(TransitService), roster : Roster, time : Float,
    dt : Float, junctions : NativeIntArr, traffic_time : Float, guard : Int -> Citizen -> Citizen -> Citizen) : Roster do
    step_roster(c, walk, running, bus, roster, time, dt, junctions, traffic_time, guard, true)
  end
  fn step_indexed(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), roster : Roster, time : Float,
    dt : Float, junctions : NativeIntArr, traffic_time : Float) : Roster do
    step_guarded(c, walk_map(c), running, bus, roster, time, dt, junctions, traffic_time, fn (_, _, person) -> person)
  end
  fn step_with_bus(c : Ur.Sim.City, running : NativeIntArr, bus : Option(TransitService), people : List(Citizen),
    time : Float, dt : Float, junctions : NativeIntArr, traffic_time : Float) : List(Citizen) do
    -- One-shot callers do not keep the event queue between updates.
    snapshot(step_roster(c, walk_map(c), running, bus, index(c, people, time), time, dt, junctions, traffic_time, fn (_, _, person) -> person, false))
  end
  fn step_with(c : Ur.Sim.City, running : NativeIntArr, cars : List(Citizen), time : Float, dt : Float) : List(Citizen) do
    let junctions = S.junction_controls(c, NativeArray.make_int(S.count() * 4, 0), 0, NativeArray.make_int(S.count(), 0))
    step_with_bus(c, running, None, cars, time, dt, junctions, time)
  end
  fn step(c : Ur.Sim.City, cars : List(Citizen), time : Float, dt : Float) : List(Citizen) do
    step_with(c, S.transit_service(c, S.supply(c, S.access(c))), cars, time, dt)
  end

end
