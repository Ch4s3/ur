mod Ur.UtilityView do
  alias Ur.Sim as S
  alias Ur.UtilitiesNetwork as Net

  type Inspection = { lot : Int, tap : Int, limit : Int, reason : String, members : NativeIntArr,
    parcels : NativeIntArr, demand : Int, delivered : Int, spare : Int }
  type Impact = { marks : NativeIntArr, gained : Int, lost : Int, critical : Int, critical_lots : List(Int), improved : Int, worsened : Int }
  type Sample = { stamp : Int, utilities : Ur.Sim.UtilityReport }
  type UtilityHistoryPoint = { stamp : Int, demand : Int, delivered : Int }

  pfn delivery(report : Ur.Sim.UtilityReport, layer : Int) : Ur.Sim.UtilityDelivery do
    match layer do
      2 -> report.electric
      31 -> report.sewer
      _ -> report.water
    end
  end

  fn parcel_delivery(report : Ur.Sim.UtilityReport, layer : Int, lot : Int) : (Int, Int) do
    let service = delivery(report, layer)
    let demand = S.get(service.demand, lot)
    let received = S.get(service.delivered, lot)
    if layer == 2 do
      (demand + S.get(report.facility_demand, lot), received + S.get(report.facility_delivered, lot))
    else (demand, received) end
  end

  -- 1 source, 2 recycler or treatment, 3 outfall.
  fn site_kind(c : Ur.Sim.City, layer : Int, lot : Int) : Int do
    if !S.utility_endpoint(c, layer, lot) do 0 else
      let kind = S.get(c.plants, lot)
      if kind == 10 do 2 else if layer == 31 do 3 else 1 end end
    end
  end

  pfn reserved(reservation : Ur.Sim.UtilityReservation, layer : Int) : Ur.Sim.UtilityDelivery do
    match layer do
      2 -> reservation.electric
      31 -> reservation.sewer
      _ -> reservation.water
    end
  end

  pfn project_service(c : Ur.Sim.City, reservation : Ur.Sim.UtilityReservation, layer : Int, lot : Int) : (Int, Int) do
    let demand = S.project_utility_demand(c, layer, lot)
    let (_, delivered) = Net.draw((reserved(reservation, layer)).flow, lot, demand)
    (demand, delivered)
  end

  fn project_note(c : Ur.Sim.City, before : Ur.Sim.UtilityReport, next : Ur.Sim.City, after : Ur.Sim.UtilityReport,
    layer : Int, lot : Int) : String do
    let (_, current) = project_service(c, S.project_reservations(c, before), layer, lot)
    let (demand, planned) = project_service(next, S.project_reservations(next, after), layer, lot)
    "Next floor capacity · " ++ int_to_string(current) ++ " → " ++ int_to_string(planned) ++ " of " ++ int_to_string(demand)
  end

  fn inspectable(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, lot : Int) : Bool do
    if !Ur.Layers.is_utility(layer) || !S.valid(lot) do false else
      let (wanted, _) = parcel_delivery(st.utilities, layer, lot)
      let report = delivery(st.utilities, layer)
      Net.capacity(report.flow, lot) > 0 || wanted > 0 || site_kind(c, layer, lot) > 0 ||
        S.get(c.buildings, lot) > 0 || S.get(c.plants, lot) > 0 || S.undeveloped_zone(c, lot)
    end
  end

  pfn mask_from(flow : Ur.UtilitiesNetwork.Network, tap : Int, lots : List(Int)) : (NativeIntArr, NativeIntArr) do
    let zero = NativeArray.make_int(flow.size, 0)
    let paths = Net.connected(Net.add_source({ flow with source: zero }, tap, 1))
    let members = List.fold_left(lots, zero, fn (mask, lot) ->
      if S.get(paths, lot) >= 0 do NativeArray.set_int(mask, lot, 1) else mask end)
    let parcels = List.fold_left(lots, zero, fn (mask, lot) ->
      if S.get(members, Net.tap(flow, lot, 0)) > 0 do NativeArray.set_int(mask, lot, 1) else mask end)
    (members, parcels)
  end

  pfn totals(report : Ur.Sim.UtilityReport, layer : Int, parcels : NativeIntArr, lots : List(Int)) : (Int, Int) do
    List.fold_left(lots, (0, 0), fn (sum, lot) ->
      if S.get(parcels, lot) == 0 do sum else
        let (wanted, got) = sum
        let (demand, served) = parcel_delivery(report, layer, lot)
        (wanted + demand, got + served)
      end)
  end

  pfn no_tap(layer : Int) : String do
    if layer == 2 do "No line in reach" else "No pipe in reach" end
  end

  pfn no_source(layer : Int) : String do
    match layer do
      2 -> "Line has no live source"
      31 -> "Pipe has no active outlet"
      _ -> "Pipe has no active water supply"
    end
  end

  pfn exhausted(layer : Int) : String do
    match layer do
      2 -> "Available generation is exhausted"
      31 -> "Available collection is exhausted"
      _ -> "Available water is exhausted"
    end
  end

  pfn at_capacity(layer : Int) : String do
    if layer == 2 do "Feeder at capacity" else "Main at capacity" end
  end

  fn inspect(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, lot : Int) : Inspection do
    let report = delivery(st.utilities, layer)
    let flow = if S.undeveloped_zone(c, lot) do (reserved(st.project_capacity, layer)).flow else report.flow end
    let tap = if Ur.Layers.is_utility(layer) do Net.tap(flow, lot, 0) else -1 end
    if !S.valid(tap) do
      let blank = NativeArray.make_int(S.count(), 0)
      let (wanted, served) = parcel_delivery(st.utilities, layer, lot)
      { lot: lot, tap: -1, limit: -1, reason: if S.valid(lot) do no_tap(layer) else "" end,
        members: blank, parcels: blank, demand: wanted, delivered: served, spare: 0 }
    else
      let lots = List.range(0, S.count())
      let (members, parcels) = mask_from(flow, tap, lots)
      let (demand, delivered) = totals(st.utilities, layer, parcels, lots)
      let spare = List.fold_left(lots, 0, fn (sum, segment) ->
        if S.get(members, segment) > 0 do sum + Net.remaining(flow, segment) else sum end)
      let project = S.undeveloped_zone(c, lot)
      let (local_demand, local_delivery) = if project do project_service(c, st.project_capacity, layer, lot)
        else parcel_delivery(st.utilities, layer, lot) end
      let short = local_delivery < local_demand
      let live = S.get(report.connections, tap) >= 0
      let limit = if short && live && spare > 0 do Net.binding_segment(flow, tap) else -1 end
      let reason = if !live do no_source(layer)
        else if limit >= 0 do at_capacity(layer)
        else if short do (if spare == 0 do exhausted(layer) else "Delivery below demand" end)
        else if local_demand > 0 do (if project do "Capacity for the next floor" else "Full service" end)
        else if Net.capacity(flow, lot) > 0 && Net.used(flow, lot) >= Net.capacity(flow, lot) do at_capacity(layer)
        else "Connected network" end end end end end
      { lot: lot, tap: tap, limit: limit, reason: reason, members: members, parcels: parcels,
        demand: demand, delivered: delivered, spare: spare }
    end
  end

  fn live_connection(report : Ur.Sim.UtilityReport, layer : Int, lot : Int) : Bool do
    let service = delivery(report, layer)
    let tap = Net.tap(service.flow, lot, 0)
    S.valid(tap) && S.get(service.connections, tap) >= 0
  end

  pfn unmetered_change(before : Ur.Sim.UtilityReport, after : Ur.Sim.UtilityReport, layer : Int, lot : Int, kind : Int) : Int do
    let offered_before = S.get((delivery(before, layer)).sites, lot)
    let offered_after = S.get((delivery(after, layer)).sites, lot)
    if offered_before != offered_after do
      if offered_before == 0 do 1
      else if offered_after == 0 do 2
      else if offered_after > offered_before do 3
      else 4 end end end
    else if offered_before > 0 || layer != 2 || kind == 0 do 0 else
      -- The Electricity overlay shows grid access for facilities even when
      -- they do not have an individual metered load.
      let old_connected = live_connection(before, layer, lot)
      let new_connected = live_connection(after, layer, lot)
      if old_connected == new_connected do 0 else if new_connected do 1 else 2 end end
    end end
  end

  pfn change_mark(before : Ur.Sim.UtilityReport, after : Ur.Sim.UtilityReport, layer : Int, lot : Int, kind : Int) : Int do
    let (old_demand, old_served) = parcel_delivery(before, layer, lot)
    let (new_demand, new_served) = parcel_delivery(after, layer, lot)
    if old_demand == 0 && new_demand == 0 do unmetered_change(before, after, layer, lot, kind)
    else
      let old_wanted = if old_demand == 0 do new_demand else old_demand end
      let new_wanted = if new_demand == 0 do old_demand else new_demand end
      let full_before = old_served >= old_wanted
      let full_after = new_served >= new_wanted
      if !full_before && full_after do 1
      else if full_before && !full_after do 2
      else if new_served * old_wanted > old_served * new_wanted do 3
      else if new_served * old_wanted < old_served * new_wanted do 4
      else 0 end end end end
    end
  end

  pfn critical_facility(kind : Int) : Bool do
    S.power_plant(kind) || (match kind do
      3 | 4 | 8 | 9 | 10 | 11 | 19 | 20 | 21 | 22 | 25 | 42 -> true
      _ -> false
    end)
  end

  fn impact(before : Ur.Sim.UtilityReport, after : Ur.Sim.UtilityReport, city : Ur.Sim.City, layer : Int) : Impact do
    let empty = { marks: NativeArray.make_int(S.count(), 0), gained: 0, lost: 0, critical: 0, critical_lots: Nil, improved: 0, worsened: 0 }
    List.fold_left(List.range(0, S.count()), empty, fn (out, lot) ->
      let kind = S.get(city.plants, lot)
      let mark = change_mark(before, after, layer, lot, kind)
      let essential = critical_facility(kind) || (lot == city.harbour && S.utility_endpoint(city, layer, lot))
      let critical = if (mark == 2 || mark == 4) && essential do 1 else 0 end
      if mark == 0 do out else
        let gained = out.gained + (if mark == 1 do 1 else 0 end)
        let lost = out.lost + (if mark == 2 do 1 else 0 end)
        let improved = out.improved + (if mark == 3 do 1 else 0 end)
        let worsened = out.worsened + (if mark == 4 do 1 else 0 end)
        let affected = out.critical + critical
        { marks: NativeArray.set_int(out.marks, lot, mark), gained: gained, lost: lost,
          improved: improved, worsened: worsened, critical: affected,
          critical_lots: if critical > 0 do Cons(lot, out.critical_lots) else out.critical_lots end }
      end)
  end

  type Repair = { tool : Int, start : Int, target : Int }

  pfn repair_serves(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, lot : Int, plan : Ur.Build.Preview) : Bool do
    if !plan.valid || !plan.changed do false else
      let forecast = S.utility_snapshot(plan.city)
      let report = st.utilities
      let (demand, before) = parcel_delivery(report, layer, lot)
      let (_, after) = parcel_delivery(forecast, layer, lot)
      if S.undeveloped_zone(c, lot) do
        let (_, before) = project_service(c, st.project_capacity, layer, lot)
        let (_, after) = project_service(c, S.project_reservations(plan.city, forecast), layer, lot)
        after > before
      else if demand > 0 do after > before
      else
        let original_site = S.get((delivery(report, layer)).sites, lot)
        let planned_site = S.get((delivery(forecast, layer)).sites, lot)
        planned_site > original_site ||
          (!live_connection(report, layer, lot) && live_connection(forecast, layer, lot) && (layer == 2 || S.get(c.plants, lot) == 0))
      end end
    end
  end

  fn repair(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, inspection : Inspection) : Option(Repair) do
    let report = st.utilities
    if !Ur.Layers.is_utility(layer) || !S.valid(inspection.lot) do None
    else if S.valid(inspection.limit) do
      let tool = if layer == 2 do 97 else 98 end
      let lot = inspection.limit
      let plan = Ur.Build.preview(c, tool, lot, lot)
      if repair_serves(c, st, layer, inspection.lot, plan) do Some({ tool: tool, start: lot, target: lot }) else None end
    else if live_connection(report, layer, inspection.lot) do None
    else
      let target = if S.valid(inspection.tap) do inspection.tap else inspection.lot end
      let flow = delivery(report, layer)
      let tx = target % S.width()
      let tz = target / S.width()
      let candidates = List.map(List.range(0, 289), fn offset ->
        let dx = offset % 17 - 8
        let dz = offset / 17 - 8
        let x = tx + dx
        let z = tz + dz
        (if x >= 0 && x < S.width() && z >= 0 && z < S.depth() do S.index(x, z) else -1 end, int_abs(dx) + int_abs(dz)))
      let (start, _) = List.fold_left(candidates, (-1, 9), fn (best, candidate) ->
        let (_, nearest) = best
        let (lot, distance) = candidate
        if distance < nearest && S.valid(lot) && S.get(flow.connections, lot) >= 0 &&
          Net.capacity(flow.flow, lot) > 0 do candidate else best end)
      let tool = if layer == 2 do 26 else 18 end
      if !S.valid(start) do None else
        let plan = Ur.Build.preview(c, tool, start, target)
        if repair_serves(c, st, layer, inspection.lot, plan) do Some({ tool: tool, start: start, target: target }) else None end
      end
    end end end
  end

  fn remember(history : List(Sample), stamp : Int, report : Ur.Sim.UtilityReport) : List(Sample) do
    Cons({ stamp: stamp, utilities: report }, List.take(List.filter(history, fn sample -> sample.stamp < stamp), 23))
  end

  fn trend(history : List(Sample), layer : Int, inspection : Inspection) : List(UtilityHistoryPoint) do
    if !S.valid(inspection.tap) do Nil else
      let lots = List.filter(List.range(0, S.count()), fn lot -> S.get(inspection.parcels, lot) > 0)
      List.fold_left(history, Nil, fn (points, sample) ->
        let (demand, delivered) = totals(sample.utilities, layer, inspection.parcels, lots)
        Cons({ stamp: sample.stamp, demand: demand, delivered: delivered }, points))
    end
  end
end
