mod Ur.Layers do
  alias Ur.Sim as S
  alias Ur.UtilitiesNetwork as N
  fn name(layer : Int) : String do
    match layer do
      1 -> "Water supply"
      31 -> "Sewage collection"
      2 -> "Electricity"
      3 -> "Transit & jobs"
      4 -> "Air, land & ocean pollution"
      5 -> "Groundwater"
      6 -> "Geothermal"
      7 -> "Oil potential"
      8 -> "Landing survey"
      9 -> "Road traffic"
      10 -> "Civic services"
      11 -> "Road crossings"
      35 -> "Tunnel cutaway [T]"
      19 -> "Reported incidents"
      20 -> "Fires"
      21 -> "Medical calls"
      22 -> "Fire recovery"
      23 -> "Ground-floor areas"
      24 -> "Quiet-hour areas"
      25 -> "Transit foot traffic"
      26 -> "Neighborhood noise"
      27 -> "Car-free schedule"
      28 -> "Council wards"
      29 -> "Wind"
      30 -> "Trash collection"
      32 -> "Heat"
      33 -> "Floodplain"
      34 -> "Religion"
      36 -> "Land value"
      37 -> "Household savings"
      38 -> "Rainfall"
      39 -> "Fish population"
      40 -> "Soil fertility"
      41 -> "Fishing policy"
      12 | 13 | 14 | 15 | 16 | 17 | 18 -> S.metric_name(layer - 12)
      _ -> "Off"
    end
  end
  -- Use the world material colors for utility swatches.
  fn utility_rgb(material : Int) : (Int, Int, Int) do
    match material do
      6 -> (183, 90, 66)
      10 -> (250, 196, 79)
      11 -> (161, 211, 122)
      12 -> (108, 183, 218)
      17 -> (151, 157, 151)
      20 -> (124, 220, 214)
      30 -> (252, 86, 68)
      31 -> (100, 156, 255)
      36 -> (255, 154, 32)
      _ -> (151, 157, 151)
    end
  end
  fn legend(layer : Int) : String do
    match layer do
      1 -> "Blue reach · Cyan spare · Amber busy · Red full or short · Gray dry"
      2 -> "Lines: cyan spare · Amber busy · Red full · Gray disconnected"
      31 -> "Cyan spare · Amber busy · Red full or short · Gray no outlet"
      3 -> "Cyan running / amber unfinished / green near jobs"
      4 -> "Faint amber: low pollution. Orange to red: higher concentrations."
      5 -> "Blue marks groundwater. Fainter color follows the aquifer edge."
      6 -> "Orange volcanic field"
      7 -> "Violet marks prospective oil deposits."
      10 -> "Green: all four. Cyan: school or clinic. Amber: fire or police only. Red: uncovered housing."
      12 | 13 | 14 | 15 | 16 | 17 | 18 -> "Red below 35 / amber 35–49 / green 50–69 / cyan 70+."
      20 -> "Latest month · Orange ignition / yellow spread."
      23 -> "Painted overrides · Green housing or offices / cyan allowed / amber required."
      24 -> "Painted overrides · Amber until 2 am / cyan until 10 pm / green no nightlife."
      25 -> "Transit foot traffic · Green low / amber medium / cyan high."
      30 -> "Green: contained / amber: piling up / red: overflowing / blue: disposal facility."
      34 -> "Green covered · Gray uncovered · Cyan open · Red needs staff · Amber closed"
      36 -> "Land value · Red under $600 / amber to $1,000 / green to $1,600 / cyan above"
      37 -> "Savings a household · Red under $100 / amber to $400 / green to $1,200 / cyan above"
      38 -> "Rain today · deeper blue is heavier · faint is still to come"
      39 -> "Pale blue: few fish · Deep teal: abundant · Red: below a third of capacity"
      40 -> "Red: poor soil · Amber: moderate · Green: fertile · Cyan: rich"
      41 -> "Open water unmarked · Amber: half catch · Green: protected"
      33 -> "Amber: storm risk · Blue: flooded now · Green: protection"
      32 -> "Blue: cooler than 25 °C · Clear: comfortable · Amber to red: hotter than 28 °C"
      29 -> "Arrows point downwind. Gray: light / blue: moderate / amber: strong."
      28 -> "Amber: sponsor ward   Red: target parcel   Cyan/green: represented"
      27 -> "Cyan: closed to cars   Amber: scheduled   Gray: eligible street"
      26 -> "Noise from industry, bars and turbines · Amber audible / red loud."
      22 -> "Orange: closed for repairs. Red: rebuilding after a fire."
      21 -> "Latest month · Cyan stabilized / amber complications / red no admission."
      19 -> "Latest month · Red unanswered / amber response / orange fire."
      35 -> "Tunnel decks and retaining walls · Press T to restore the surface"
      11 -> "Cyan overpass / amber underpass / blue tunnel."
      9 -> "Green free flow / amber busy / red congested"
      8 -> "Cyan: low shoreline suitable for landing, or sand a storm just moved · Amber: water too shallow for a ferry"
      _ -> "Choose a layer to inspect the map."
    end
  end
  -- Static prospecting layer for the starter map.
  fn oil(i : Int) : Bool do
    let x = i % S.width() - 30
    let z = i / S.width() - 18
    S.valid(i) && 2 * x * x + z * z <= 13
  end
  fn oil_at(c : Ur.Sim.City, i : Int) : Bool do
    if c.founding_map do S.valid(i) && i % S.width() >= 52 && i / S.width() >= 25 && i / S.width() <= 29
    else oil(i) end
  end
  pfn incident_material(calls : List(Ur.Sim.Incident), i : Int, filter : Int) : Int do
    match calls do
      Nil -> -1
      Cons(call, rest) ->
        if !S.incident_matches(call.kind, filter) do incident_material(rest, i, filter)
        else if call.lot == i do
          match call.medical do
            Some(t) -> if t.outcome == 1 do 20 else if t.outcome == 2 do 10 else 6 end end
            None -> if call.kind == 3 do 15 else if call.response < 0 do 6 else 10 end end
          end
        else if List.any(call.spread, fn lot -> lot == i) do 10
        else incident_material(rest, i, filter) end end end
    end
  end
  fn utility_layer(st : Ur.Sim.Stats, layer : Int) : Ur.Sim.UtilityDelivery do
    if layer == 2 do st.utilities.electric else if layer == 31 do st.utilities.sewer else st.utilities.water end end
  end
  fn is_utility(layer : Int) : Bool do layer == 1 || layer == 2 || layer == 31 end
  fn utility_tool(tool : Int) : Int do
    match tool do
      9 | 10 | 14 | 15 | 16 | 18 | 19 | 98 -> 1
      4 | 8 | 20 | 21 | 22 | 23 | 26 | 27 | 86 | 97 | 150 -> 2
      17 -> 31
      _ -> 0
    end
  end
  fn utility_route(tool : Int) : Bool do
    tool == 18 || tool == 19 || tool == 26 || tool == 27 || S.utility_upgrade(tool)
  end
  pfn connected(report : Ur.Sim.UtilityDelivery, tap : Int) : Bool do
    S.valid(tap) && S.get(report.connections, tap) >= 0
  end
  fn power_material(c : Ur.Sim.City, report : Ur.Sim.UtilityDelivery, lot : Int) : Int do
    let demand = S.get(report.demand, lot)
    if demand == 0 && S.get(c.buildings, lot) == 0 && S.get(c.plants, lot) == 0 do -1
    else if !connected(report, N.tap(report.flow, lot, 0)) do 30
    else if S.get(report.delivered, lot) < demand do 10
    else 20 end end end
  end
  fn power_status_material(c : Ur.Sim.City, st : Ur.Sim.Stats, lot : Int) : Int do
    let tex = power_material(c, st.utilities.electric, lot)
    if tex == 20 && S.get(st.utilities.facility_demand, lot) > S.get(st.utilities.facility_delivered, lot) do 10
    else tex end
  end
  fn utility_caption(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, lot : Int) : String do
    let report = utility_layer(st, layer)
    let capacity = N.capacity(report.flow, lot)
    let demand = S.get(report.demand, lot) + (if layer == 2 do S.get(st.utilities.facility_demand, lot) else 0 end)
    let tap = N.tap(report.flow, lot, 0)
    let live = connected(report, tap)
    let delivered = S.get(report.delivered, lot) + (if layer == 2 do S.get(st.utilities.facility_delivered, lot) else 0 end)
    let served = int_to_string(delivered) ++ "/" ++ int_to_string(demand)
    let segment = int_to_string(N.used(report.flow, lot)) ++ "/" ++ int_to_string(capacity) ++ " on segment"
    let power = if layer == 2 do power_status_material(c, st, lot) else -1 end
    let status = if power == 30 do
      if S.valid(tap) do "Off grid · Line has no live source" else "Off grid · No line within reach" end
    else if power == 10 do "On grid · Power shortfall"
    else if power == 20 do "On grid" else "" end end end
    if status != "" do
      status ++ (if demand > 0 do " · " ++ served ++ " power" else "" end) ++ (if capacity > 0 do " · " ++ segment else "" end)
    else if capacity > 0 do
      segment ++ (if live do "" else if layer == 31 do " · No outlet" else " · No live source" end end)
    else if demand > 0 do
      served ++ " served here" ++ (if layer == 1 && !live do (if S.valid(tap) do " · Pipe has no supply" else " · No pipe within reach" end) else "" end)
    else if layer == 1 && S.get(c.heights, lot) > 0 do
      if live do "Within reach of a supplied pipe" else if S.valid(tap) do "Nearby pipe has no supply" else "Out of pipe reach" end end
    else "" end end end end
  end
  -- Rainfall strength on each parcel (0..63) for the blended overlay: today's
  -- peak where it has already fallen, deeper for heavier rain, and a faint
  -- wash where the day's heaviest rain is still to come.
  fn rain_strength(c : Ur.Sim.City) : NativeIntArr do
    let (p0, _) = S.watch_rain(c, 0)
    let (p1, _) = S.watch_rain(c, 1)
    let (p2, _) = S.watch_rain(c, 2)
    List.fold_left(List.range(0, S.count()), NativeArray.make_int(S.count(), 0), fn (field, i) ->
      let peak_of = fn (w : Int) -> S.get(if w == 0 do p0 else if w == 1 do p1 else p2 end end, i)
      let past = List.fold_left(List.range(0, c.watch), 0, fn (m, w) -> if peak_of(w) > m do peak_of(w) else m end)
      let later = List.fold_left(List.range(c.watch, 3), 0, fn (m, w) -> if peak_of(w) > m do peak_of(w) else m end)
      let strength = if past >= later && past >= 2 do past * 15 else if later >= 2 do later * 5 else 0 end end
      NativeArray.set_int(field, i, strength))
  end
  fn heat_color(temperature : Int) : Int do
    if temperature < 250 do 12 else if temperature < 280 do 11 else if temperature < 330 do 10 else 6 end end end
  end
  fn material(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, i : Int) : Int do
    let land = S.get(c.heights, i) > 0
    match layer do
      38 -> -1
      39 -> Ur.Fish.layer_material(c, i)
      40 ->
        let fertility = S.soil_fertility(c, i)
        if !land do -1 else if fertility < 40 do 6 else if fertility < 65 do 10 else if fertility < 85 do 11 else 20 end end end end
      41 -> if !S.fishing_sea(c, i) do -1 else
        match S.get(c.fishing_policy, i) do
          1 -> 10
          2 -> 11
          _ -> -1
        end end
      34 ->
        if !land do -1
        else if S.temple_tier(c, i) > 0 do
          if S.temple_open(c, st, i) do 20 else if S.worship_staff_shortage(c, st, i) do 6 else 10 end end
        else if S.resident_homes(c, i) > 0 do (if S.worship_access(c, st, i) do 11 else 17 end)
        else -1 end end end
      32 -> if S.get(c.heights, i) == 0 do -1 else heat_color(S.local_temperature(c, i)) end
      36 ->
        let value = S.land_value(c, i)
        if !land do -1 else if value < 600 do 6 else if value < 1000 do 10 else if value < 1600 do 11 else 20 end end end end
      37 ->
        let saved = S.savings_per_home(c, i)
        if S.occupied_homes(c, i) == 0 do -1 else if saved < 100 do 6 else if saved < 400 do 10 else if saved < 1200 do 11 else 20 end end end end
      1 | 2 | 31 ->
        let report = utility_layer(st, layer)
        let tier = S.get(if layer == 2 do c.grid else c.pipes end, i)
        if tier == 0 do
          if layer == 2 do power_status_material(c, st, i)
          else if S.get(report.demand, i) > S.get(report.delivered, i) do 6
          else if layer == 1 && land && connected(report, N.tap(report.flow, i, 0)) do 12
          else -1 end end end
        else if N.capacity(report.flow, i) == 0 || !connected(report, i) do 17
        else
          let capacity = S.utility_capacity(if layer == 2 do 0 else if layer == 1 do 1 else 2 end end, tier)
          let used = N.used(report.flow, i)
          if used >= capacity do 6 else if used * 5 >= capacity * 4 do 10 else 20 end end
        end end
      3 ->
        let trip = S.commute(st.commutes, i)
        if S.get(c.ferries, i) > 0 || S.get(c.transit, i) == 1 || S.get(st.running_transit, i) > 0 do 20
        else if S.get(c.transit, i) >= 2 do 10
        else if land && S.get(c.zones, i) > 0 && trip < 999 do (if trip <= 14 do 11 else 10 end)
        else -1 end end end
      6 -> if land && S.geothermal(c, i) do 18 else -1 end
      9 -> if S.motor_road(c, i) do 0 else -1 end
      10 ->
        let mask = S.get(st.civic, i)
        let zone = S.get(c.zones, i)
        if mask % 16 == 15 do 11
        else if mask % 4 > 0 do 20
        else if mask % 16 > 0 do 10
        else if zone == 1 || zone == 3 do 6 else -1 end end end end
      30 ->
        let stock = S.get(c.waste_stock, i)
        let kind = S.get(c.plants, i)
        let overflow = S.waste_overflow(c, i)
        if kind == 16 || kind == 17 || (kind >= 34 && kind <= 36) do 12
        else if stock == 0 do -1 else if overflow >= 10 do 6 else if overflow > 0 do 10 else 11 end end end end
      29 ->
        if i % S.width() % 4 != 2 || i / S.width() % 4 != 2 do -1 else
          let speed = (S.local_wind(c, i, S.hour_now(c))).speed
          if speed >= 36 do 10 else if speed >= 23 do 12 else 17 end end
        end
      28 -> Ur.Council.terrain_color(c, i)
      27 -> if !S.schedule_eligible(c, i) do -1 else if S.car_free_now(c, i) do 20 else if S.get(c.car_free_days, i) > 0 do 10 else 17 end end end
      23 ->
        match S.get(c.ground_areas, i) do
          1 -> 11
          2 -> 20
          3 -> 10
          _ -> -1
        end
      24 ->
        match S.get(c.quiet_areas, i) do
          1 -> 10
          2 -> 20
          3 -> 11
          _ -> -1
        end
      25 ->
        let flow = S.get(c.footfall, i)
        if flow == 0 do -1 else if flow >= 20 do 20 else if flow >= 12 do 10 else 11 end end end
      26 ->
        let noise = S.street_noise(c, i)
        if noise == 0 do -1 else if noise >= 12 do 6 else 10 end end
      22 -> if S.fire_rebuilding(c, i) do 6 else if S.fire_offline(c, i) do 15 else -1 end end
      19 | 20 | 21 -> match c.crime_history do
        Nil -> -1
        Cons(month, _) -> incident_material(month.calls, i, if layer == 19 do 0 else layer - 17 end)
      end
      12 | 13 | 14 | 15 | 16 | 17 | 18 ->
        let score = S.measure(c, st, i, layer - 12)
        if !land do -1 else if score < 35 do 6 else if score < 50 do 10 else if score < 70 do 11 else 20 end end end end
      11 ->
        match S.grade_kind(c, S.grade_source(c, i)) do
          1 -> 20
          2 -> 10
          3 -> 12
          _ -> -1
        end
      -- water too shallow for a standard ferry (under 1.5 m over a reef or bar) shows amber
      8 -> if S.can_land(c, i) do 20 else if !land && c.sand_day > 0 && S.absolute_day(c) + 1 - c.sand_day <= 30 && S.get(c.sand_marks, i) == 1 do 20 else if !land && S.get(c.sea_shoals, i) < 6 do 10 else -1 end end end
      _ -> -1
    end
  end
end
