-- Fish in the sea: a stock in every water parcel that grows toward what its
-- habitat can hold, spreads slowly to emptier water, and is taken by the
-- fisheries working it. Fished harder than it regrows, it falls, and every
-- fishery sharing that water lands less (Ur.Sim.catch_yield reads the stock).
--
-- Units: a parcel of plain shelf holds 1,000,000 when full. Habitat, per sea
-- floor cell, in shares of that (35 being plain shelf): reef 100 coral, 85
-- mixed, 70 rocky; shelf 2..15 m 35, +15 at a shelf edge (the parcel's floor
-- drops 4 m or more across it); deep open sea 10; sand bars and sandy
-- shallows under 2 m no more than shelf; a dredged cell 10; +20 within 3
-- parcels of a river mouth. A parcel's capacity is the mean of its cells,
-- times the share pollution leaves.
--
-- Growth is logistic, r = 0.004 a day: a stock fished down to a third and
-- left alone is back to 80% in about 520 days. A fishery takes 0.03 stock
-- units for each unit of its day's catch, shared over its water by what each
-- parcel holds. Tuned on a run of four parcels: one fishery over plain shelf
-- holds it near 73%; two decline over a few years (63% after one, 29% after
-- four); three overfish it within two years; two over a coral reef hold it
-- near 68%. On the first day of each month a tenth of the difference in
-- fill between two neighbouring parcels flows to the emptier one.
mod Ur.Fish do
  alias Ur.Sim as S
  alias Ur.Ocean as O

  doc "Stock units in a full parcel of plain shelf."
  fn full_shelf() : Int do 1000000 end
  doc "Daily growth rate of a stock toward what it can hold."
  fn growth() : Float do 0.004 end
  doc "Stock units taken for each unit of a fishery's day's catch."
  fn take_per_catch() : Float do 0.03 end

  -- ── Habitat ──────────────────────────────────────────────────────────────
  pfn cell_share(f : Ur.Ocean.Field, x : Int, z : Int) : Int do
    let d = O.depth(f, x, z)
    let k = O.kind(f, x, z)
    if d <= 0 do 0
    else if k == 1 do (if f.reef_type == 2 do 100 else if f.reef_type == 1 do 85 else 70 end end)
    -- a reef the city built counts as a mixed reef, whatever the map's own
    else if k == 3 do 85
    else if d > O.shelf_depth(f, x, z) do 10
    else if d >= 60 do 10
    else 35 end end end end end
  end
  pfn parcel_cells(f : Ur.Ocean.Field, px : Int, pz : Int, k : Int, sum : Int, lo : Int, hi : Int, wet : Int) : (Int, Int, Int, Int) do
    if k >= 64 do (sum, lo, hi, wet) else
      let x = px * 32 + (k % 8) * 4 + 2
      let z = pz * 32 + (k / 8) * 4 + 2
      let d = O.depth(f, x, z)
      let share = cell_share(f, x, z)
      parcel_cells(f, px, pz, k + 1, sum + share, if d > 0 && d < lo do d else lo end, if d > hi do d else hi end, if d > 0 do wet + 1 else wet end)
    end
  end
  pfn near_mouth(mouths : List(Int), i : Int) : Bool do
    List.any(mouths, fn m -> int_abs(m % S.width() - i % S.width()) <= 3 && int_abs(m / S.width() - i / S.width()) <= 3)
  end
  pfn habitat_go(c : Ur.Sim.City, f : Ur.Ocean.Field, mouths : List(Int), a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= S.count() do a else
      let v = if S.get(c.heights, i) > 0 do 0 else
        let (sum, lo, hi, wet) = parcel_cells(f, i % S.width(), i / S.width(), 0, 0, 1000, 0, 0)
        if wet == 0 do 0 else
          let edge = if hi - lo >= 16 do 15 else 0 end
          let river = if near_mouth(mouths, i) do 20 else 0 end
          (sum / wet + edge + river) * full_shelf() / 35
        end
      end
      habitat_go(c, f, mouths, NativeArray.set_int(a, i, v), i + 1)
    end
  end
  doc "What each map parcel's water could hold before pollution, in stock units (1,000,000 for plain shelf), from sea floor [f]; 0 on land."
  fn habitat(c : Ur.Sim.City, f : Ur.Ocean.Field) : NativeIntArr do habitat_go(c, f, S.river_mouths(c), NativeArray.make_int(S.count(), 0), 0) end

  -- ── A day ────────────────────────────────────────────────────────────────
  doc "A stock of [n] after a day's growth toward [k]: logistic, never below 0 nor above k."
  fn grow(n : Int, k : Int) : Int do
    if k <= 0 || n <= 0 do 0 else
      let nf = int_to_float(n)
      let next = nf +. growth() *. nf *. (1.0 -. nf /. int_to_float(k))
      S.clamp(float_to_int(next), 0, k)
    end
  end
  pfn capacity_go(c : Ur.Sim.City, habitat : NativeIntArr, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= S.count() do a else
      let h = S.get(habitat, i)
      capacity_go(c, habitat, NativeArray.set_int(a, i, if h <= 0 do 0 else h / 100 * (100 - S.pollution_at(c, i)) end), i + 1)
    end
  end
  pfn all_zero(a : NativeIntArr, i : Int) : Bool do
    if i >= NativeArray.length_int(a) do true else if NativeArray.get_int(a, i) != 0 do false else all_zero(a, i + 1) end end
  end
  -- Take fish in proportion to each parcel’s stock and permitted fishing effort.
  pfn take_go(c : Ur.Sim.City, fish : NativeIntArr, run : List(Int), amount : Int, held : Int) : NativeIntArr do
    match run do
      Nil -> fish
      Cons(j, rest) ->
        let n = S.get(fish, j)
        let part = if held <= 0 do 0 else float_to_int(int_to_float(amount) *. int_to_float(n * S.fishing_effort(c, j)) /. int_to_float(held)) end
        take_go(c, NativeArray.set_int(fish, j, S.clamp(n - part, 0, n)), rest, amount, held)
    end
  end
  pfn harvest_go(c : Ur.Sim.City, routes : NativeIntArr, fish : NativeIntArr, i : Int) : NativeIntArr do
    if i >= S.count() do fish else
      let fish = if !S.fishery_working(c, routes, i) do fish else
        let run = S.fishing_water(c, i)
        let held = List.fold_left(run, 0, fn (a, j) -> a + S.get(fish, j) * S.fishing_effort(c, j))
        let caught = match S.production_at(c, i) do
          Some(site) -> site.produced * 8
          None -> S.catch_yield(c, i)
        end
        take_go(c, fish, run, float_to_int(int_to_float(caught) *. take_per_catch() *. int_to_float(full_shelf()) /. 1000.0), held)
      end
      harvest_go(c, routes, fish, i + 1)
    end
  end
  pfn grow_go(fish : NativeIntArr, cap : NativeIntArr, i : Int) : NativeIntArr do
    if i >= S.count() do fish else grow_go(NativeArray.set_int(fish, i, grow(S.get(fish, i), S.get(cap, i))), cap, i + 1) end
  end
  -- a tenth of the difference in fill between two water neighbours flows to the emptier, scaled by the smaller capacity
  pfn flow(fish : NativeIntArr, cap : NativeIntArr, i : Int, j : Int) : NativeIntArr do
    let ki = S.get(cap, i)
    let kj = S.get(cap, j)
    if !S.valid(j) || ki <= 0 || kj <= 0 do fish else
      let fi = int_to_float(S.get(fish, i)) /. int_to_float(ki)
      let fj = int_to_float(S.get(fish, j)) /. int_to_float(kj)
      let small = int_to_float(if ki < kj do ki else kj end)
      let moved = float_to_int(0.1 *. (fi -. fj) *. small)
      -- moved > 0 goes from i to j, < 0 from j to i; never more than the giver holds or the taker has room for
      let moved = if moved > 0 do S.clamp(moved, 0, S.clamp(kj - S.get(fish, j), 0, S.get(fish, i)))
        else 0 - S.clamp(0 - moved, 0, S.clamp(ki - S.get(fish, i), 0, S.get(fish, j))) end
      NativeArray.set_int(NativeArray.set_int(fish, i, S.get(fish, i) - moved), j, S.get(fish, j) + moved)
    end
  end
  pfn spread_go(fish : NativeIntArr, cap : NativeIntArr, i : Int) : NativeIntArr do
    if i >= S.count() do fish else
      -- each pair once: east and south
      spread_go(flow(flow(fish, cap, i, S.neighbour(i, 1)), cap, i, S.neighbour(i, 3)), cap, i + 1)
    end
  end
  doc "The fish after a month's spreading: a tenth of the difference in fill between each pair of water neighbours flows to the emptier one."
  fn spread(fish : NativeIntArr, cap : NativeIntArr) : NativeIntArr do spread_go(fish, cap, 0) end

  doc "City [c] after a day of fish: capacity from [habitat] and today's pollution; a stock never set starts full; today's working fisheries take their catch from their water; every stock grows; on the first day of a month fish spread. Nothing for a city saved before reefs and fish."
  fn day(c : Ur.Sim.City, habitat : NativeIntArr) : Ur.Sim.City do
    if c.sea_features == 0 && all_zero(c.private_docks, 0) && all_zero(c.fish_capacity, 0) do c else
      let cap = capacity_go(c, habitat, NativeArray.make_int(S.count(), 0), 0)
      let fish = if all_zero(c.fish, 0) do capacity_go(c, habitat, NativeArray.make_int(S.count(), 0), 0) else c.fish end
      let c = { c with fish: fish, fish_capacity: cap }
      let fish = harvest_go(c, S.access(c), fish, 0)
      let fish = grow_go(fish, cap, 0)
      if c.calendar_day == 1 do month({ c with fish: spread(fish, cap) }, habitat) else { c with fish: fish } end
    end
  end

  -- ── Warnings and the inspector ───────────────────────────────────────────
  doc "Whether parcel [i]'s water is reef: what it could hold is at least 1.9 times plain shelf."
  fn reef_water(habitat : NativeIntArr, i : Int) : Bool do S.get(habitat, i) >= full_shelf() * 19 / 10 end
  -- a reef area's parcels from [stack], marking them in [seen]: (seen, fish, capacity, parcels, sum x, sum z)
  pfn area_go(c : Ur.Sim.City, habitat : NativeIntArr, seen : NativeIntArr, stack : List(Int), n : Int, k : Int, p : Int, sx : Int, sz : Int) : (NativeIntArr, Int, Int, Int, Int, Int) do
    match stack do
      Nil -> (seen, n, k, p, sx, sz)
      Cons(i, rest) ->
        if !S.valid(i) || S.get(seen, i) != 0 || !reef_water(habitat, i) do area_go(c, habitat, seen, rest, n, k, p, sx, sz) else
          let more = Cons(S.neighbour(i, 0), Cons(S.neighbour(i, 1), Cons(S.neighbour(i, 2), Cons(S.neighbour(i, 3), rest))))
          area_go(c, habitat, NativeArray.set_int(seen, i, 1), more, n + S.get(c.fish, i), k + S.get(c.fish_capacity, i), p + 1, sx + i % S.width(), sz + i / S.width())
        end
    end
  end
  pfn side_of(x : Int, z : Int) : String do
    let dx = x - S.width() / 2
    let dz = z - S.depth() / 2
    if int_abs(dx) >= int_abs(dz) do (if dx >= 0 do "east" else "west" end) else (if dz >= 0 do "south" else "north" end) end
  end
  pfn alerts_go(c : Ur.Sim.City, habitat : NativeIntArr, seen : NativeIntArr, i : Int) : Ur.Sim.City do
    if i >= S.count() do c
    else if S.get(seen, i) != 0 || !reef_water(habitat, i) do alerts_go(c, habitat, seen, i + 1)
    else
      let (seen, n, k, p, sx, sz) = area_go(c, habitat, seen, Cons(i, Nil), 0, 0, 0, 0, 0)
      let fill = if k <= 0 do 100 else n / (k / 100) end
      let warned = S.get(c.fish_alerts, i) == 1
      let side = side_of(sx / p, sz / p)
      let c = if !warned && fill < 33 do
        { c with fish_alerts: NativeArray.set_int(c.fish_alerts, i, 1), message: "The reef fishery off the " ++ side ++ " is overfished: " ++ int_to_string(fill) ++ "% of its fish remain." }
      else if warned && fill > 67 do
        { c with fish_alerts: NativeArray.set_int(c.fish_alerts, i, 0), message: "The reef fishery off the " ++ side ++ " has recovered." }
      else c end end
      alerts_go(c, habitat, seen, i + 1)
    end end
  end
  -- the first day of a month: warn of overfished reefs (or their recovery), and keep the month's fish for the trend
  pfn month(c : Ur.Sim.City, habitat : NativeIntArr) : Ur.Sim.City do
    let c = alerts_go(c, habitat, NativeArray.make_int(S.count(), 0), 0)
    { c with fish_last: capacity_copy(c.fish, NativeArray.make_int(S.count(), 0), 0) }
  end
  pfn capacity_copy(from : NativeIntArr, into : NativeIntArr, i : Int) : NativeIntArr do
    if i >= S.count() do into else capacity_copy(from, NativeArray.set_int(into, i, S.get(from, i)), i + 1) end
  end
  doc "The parcel inspector's line for water parcel [i]: its fish against what it can hold, the month's trend, and the water. Empty on land or where fish are not counted."
  fn inspect(c : Ur.Sim.City, i : Int) : String do
    let k = S.get(c.fish_capacity, i)
    if S.get(c.heights, i) > 0 || k <= 0 do "" else
      let n = S.get(c.fish, i)
      let pct = n / (k / 100 + 1)
      let last = S.get(c.fish_last, i)
      let trend = if last <= 0 do "steady" else if n > last + k / 50 do "recovering" else if n < last - k / 50 do "falling" else "steady" end end end
      let water = if k >= full_shelf() * 19 / 10 do
        "Reef (" ++ (match O.reef_type(c) do
          2 -> "coral"
          1 -> "mixed"
          _ -> "rocky"
        end) ++ ")"
      else if k >= full_shelf() * 8 / 10 do "Shelf" else "Open sea" end end
      "Fish: " ++ int_to_string(pct) ++ "% of capacity, " ++ trend ++ " · " ++ water
    end
  end
  doc "The fish layer's colour for parcel [i]: -1 on land; red where under a third of what it can hold; else pale to deep teal by how many fish it holds."
  fn layer_material(c : Ur.Sim.City, i : Int) : Int do
    let k = S.get(c.fish_capacity, i)
    let n = S.get(c.fish, i)
    if S.get(c.heights, i) > 0 || k <= 0 do -1
    else if n * 3 < k do 6
    else if n < full_shelf() * 4 / 10 do 12
    else if n < full_shelf() * 12 / 10 do 3
    else 7 end end end end
  end

  doc "The fill (percent) of a run of [parcels] parcels each holding at most [k], [fisheries] fisheries working it, after [days] days from [start] percent: the stock model of `day` without a map, for tuning and tests."
  fn simulate_run(k : Int, parcels : Int, fisheries : Int, days : Int, start : Int) : Int do
    sim_go(k * parcels, k * parcels * start / 100, parcels, fisheries, days)
  end
  pfn sim_go(total : Int, n : Int, parcels : Int, fisheries : Int, days : Int) : Int do
    if days <= 0 do n * 100 / total else
      let density = n / (parcels * 10000)
      let take = float_to_int(int_to_float(fisheries * S.fish_catch_base(density)) *. take_per_catch() *. int_to_float(full_shelf()) /. 1000.0)
      sim_go(total, grow(S.clamp(n - take, 0, total), total), parcels, fisheries, days - 1)
    end
  end
end
