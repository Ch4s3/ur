-- What grows where on the islands: each map's traits (its trade wind, and
-- whether its shores carry mangroves and its mountains a pine stand), and for
-- a spot its zone (from height on the local massif), its side of the wind and
-- its shelter. Trees follow tropical island mountains (docs/superpowers/specs/
-- 2026-11-24-island-trees-design.md): palms and rainforest low down, ʻōhiʻa
-- and tree ferns up the slopes, cloud forest and elfin scrub near the tops,
-- wetter on the windward side. Pure: a function of the city and the spot.
mod Ur.Flora do
  alias Ur.Sim as S

  doc "The heading (radians the wind blows toward, 0 east, pi/2 south) of the map's trade wind: fixed by its seed, unlike the daily wind, which turns all the way round over the months. The founding map's is the daily wind's base, 0.42."
  fn prevailing(c : Ur.Sim.City) : Float do
    if c.world_seed < 0 do 0.42 else Strata.Seed.unit(Strata.Seed.mix(c.world_seed, 1303)) *. 6.2831853 end
  end
  doc "Whether the map's sheltered shores carry mangroves: about one map in three, and the founding map."
  fn mangrove_map(c : Ur.Sim.City) : Bool do
    c.world_seed < 0 || Strata.Seed.mix(c.world_seed, 1301) % 3 == 0
  end
  doc "Whether the map's lee slopes carry a pine stand, as on Hispaniola: about one map in three (drawn apart from mangroves); not the founding map."
  fn pine_map(c : Ur.Sim.City) : Bool do
    c.world_seed >= 0 && Strata.Seed.mix(c.world_seed, 1302) % 3 == 0
  end

  pfn land(c : Ur.Sim.City, x : Int, z : Int) : Int do
    if x < 0 || z < 0 || x >= S.width() || z >= S.depth() do 0 else S.get(c.heights, S.index(x, z)) end
  end
  -- depth-first over land within 8 parcels (Chebyshev) of (x0, z0); seen is a 17 x 17 mask round it
  pfn massif_go(c : Ur.Sim.City, x0 : Int, z0 : Int, seen : NativeIntArr, stack : List(Int), best : Int) : Int do
    match stack do
      Nil -> best
      Cons(i, rest) ->
        let x = i % S.width()
        let z = i / S.width()
        let h = land(c, x, z)
        let (seen, next) = List.fold_left([(1, 0), (-1, 0), (0, 1), (0, -1)], (seen, rest), fn (acc, d) ->
          let (seen, st) = acc
          let (dx, dz) = d
          let nx = x + dx
          let nz = z + dz
          let k = nx - x0 + 8 + (nz - z0 + 8) * 17
          -- (March evaluates both sides of ||: the mask is read only inside the window)
          if nx - x0 > 8 || x0 - nx > 8 || nz - z0 > 8 || z0 - nz > 8 do acc
          else if land(c, nx, nz) <= 0 || NativeArray.get_int(seen, k) > 0 do acc
          else (NativeArray.set_int(seen, k, 1), Cons(S.index(nx, nz), st)) end end)
        massif_go(c, x0, z0, seen, next, if h > best do h else best end)
    end
  end
  doc "The highest ground of the massif [lot] stands on: the land reachable from it over land parcels within 8 parcels; 0 for water. Small islands carry their forest zones low (the Massenerhebung effect), so zones follow this, not a fixed height."
  fn massif_peak(c : Ur.Sim.City, lot : Int) : Int do
    let x = lot % S.width()
    let z = lot / S.width()
    if land(c, x, z) <= 0 do 0 else
      massif_go(c, x, z, NativeArray.set_int(NativeArray.make_int(289, 0), 8 + 8 * 17, 1), [lot], 0)
    end
  end

  doc "The forest zone of ground [h] voxels high on a massif peaking at [peak]: 0 coast (below the sand line), 1 lowland, 2 mid-slope, 3 upper slope, 4 top. From h as a share of the peak (taken as at least 40, so a low island stays lowland), raised 8 points on a windward slope ([wet] 1, cloud forest reaching lower) and lowered 8 on a lee one (-1), and moved by [jitter] (-6..6) so zone edges blend."
  fn zone(h : Int, peak : Int, wet : Int, jitter : Int) : Int do
    if h <= 6 do 0 else
      let share = h * 100 / (if peak > 40 do peak else 40 end) + 8 * wet + jitter
      if share < 30 do 1 else if share < 60 do 2 else if share < 85 do 3 else 4 end end end
    end
  end

  doc "Which side of the map's trade wind [lot]'s ground faces: 1 windward (it slopes down toward where the wind comes from), -1 lee, 0 flat or across the wind. A slope is one rising at least 4 voxels across a parcel."
  fn wind_side(c : Ur.Sim.City, lot : Int) : Int do
    let x = lot % S.width()
    let z = lot / S.width()
    let gx = int_to_float(land(c, x + 1, z) - land(c, x - 1, z))
    let gz = int_to_float(land(c, x, z + 1) - land(c, x, z - 1))
    let g = Math.sqrt(gx *. gx +. gz *. gz)
    if g < 8.0 do 0 else
      let p = prevailing(c)
      -- downhill is -(gx, gz); against the wind is windward
      let d = (0.0 -. gx *. Math.cos(p) -. gz *. Math.sin(p)) /. g
      if d < -0.3 do 1 else if d > 0.3 do -1 else 0 end end
    end
  end

  pfn ray_open(c : Ur.Sim.City, x : Int, z : Int, a : Float, i : Int) : Bool do
    if i > 8 do true else
      let rx = x + float_to_int(Math.floor(int_to_float(i) *. Math.cos(a) +. 0.5))
      let rz = z + float_to_int(Math.floor(int_to_float(i) *. Math.sin(a) +. 0.5))
      if rx < 0 || rz < 0 || rx >= S.width() || rz >= S.depth() do true
      else if land(c, rx, rz) > 0 do false else ray_open(c, x, z, a, i + 1) end end
    end
  end
  doc "What a parcel's trees are chosen from, worked out once a parcel: (the massif's peak, its side of the wind, whether it is sheltered, whether it is on the coast)."
  fn site(c : Ur.Sim.City, lot : Int) : (Int, Int, Bool, Bool) do
    (massif_peak(c, lot), wind_side(c, lot), sheltered(c, lot), S.coastal(c, lot))
  end

  pfn roll(seed : Int, k : Int) : Int do int_mod_euclid(Strata.Seed.mix(seed, k), 100) end
  doc "The tree kind (Ur.Trees) for a spot [h] voxels high on a parcel of [site], by [seed]; -1 for none (water). Coast: palms, araucarias, rainforest trees. Lowland: rainforest, palms, bananas, some ʻōhiʻa. Mid-slope: ʻōhiʻa, with tree ferns windward and koa-like woods elsewhere. Upper: cloud-forest trees, ferns windward. Top: elfin trees and bushes. A pine map's lee mid and upper slopes are mostly pine."
  fn pick_at(site : (Int, Int, Bool, Bool), c : Ur.Sim.City, h : Int, seed : Int) : Int do
    let (peak, side, _, coastal) = site
    if h <= 0 do -1 else
      let z = if coastal && h <= 12 do 0 else zone(h, peak, side, seed / 41 % 13 - 6) end
      let n = roll(seed, 77)
      let pined = pine_map(c) && side == -1 && (z == 2 || z == 3) && roll(seed, 78) < 60
      if pined do 10
      else if z == 0 do (if n < 60 do 0 else if n < 85 do 1 else 3 end end)
      else if z == 1 do (if n < 45 do 3 else if n < 70 do 0 else if n < 90 do 4 else 5 end end end)
      else if z == 2 do (if n < 60 do 5 else if n < 90 do (if side == 1 do 6 else 11 end) else 3 end end)
      else if z == 3 do (if n < 60 do 7 else if n < 90 do (if side == 1 do 6 else 5 end) else 8 end end)
      else (if n < 55 do 8 else 9 end) end end end end end
    end
  end

  doc "Whether [lot] lies in sheltered water: of 16 rays from it, each 8 parcels long, at most 5 meet no land (past the map's edge is open sea)."
  fn sheltered(c : Ur.Sim.City, lot : Int) : Bool do
    let x = lot % S.width()
    let z = lot / S.width()
    List.length(List.filter(List.range(0, 16), fn k -> ray_open(c, x, z, int_to_float(k) *. 0.392699082, 1))) <= 5
  end
end
