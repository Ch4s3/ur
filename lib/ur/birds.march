mod Ur.Birds do
  needs IO.Console
  needs IO.Process
  needs IO.Foreign
  needs Window
  alias Ur.WildlifeMesh as Draw
  alias Ur.Landscape as L
  import Ur.SceneMesh.{box, vehicle_body}

  fn slots() : Int do 12 end
  pfn part(base : Int, kind : Int, piece : Int) : Int do base + kind * 3 + piece end
  pfn bird_voxel(kind : Int) : Float do
    match kind do 1 -> 0.079 | 2 -> 0.105 | 3 -> 0.090 | _ -> 0.105 end
  end
  pfn bird_meshes(base : Int, kind : Int) : Unit do
    -- Gull, tern, crow, parrot. Each has its own silhouette, colours and scale.
    let (body, head, wing, tip, tail, bill) = match kind do
      1 -> (43, 19, 17, 19, 43, 35)
      2 -> (19, 19, 4, 19, 19, 13)
      3 -> (11, 14, 7, 25, 21, 10)
      _ -> (43, 8, 8, 19, 19, 10)
    end
    let bird = box(vehicle_body(), 2, 1, 2, 3, 2, 5, body)
    let bird = box(bird, 2, 2, 6, 3, if kind == 3 do 3 else 2 end, 2, head)
    let bird = box(bird, 3, 2, 8, 1, if kind == 3 do 2 else 1 end, if kind == 1 do 3 else 2 end, bill)
    let bird = if kind == 1 do box(box(bird, 2, 2, 0, 1, 1, 3, tail), 4, 2, 0, 1, 1, 3, tail)
      else box(bird, 2, 2, 0, 3, 1, 2, tail) end
    let bird = box(box(bird, 2, 0, 4, 1, 1, 1, bill), 4, 0, 4, 1, 1, 1, bill)
    let size = bird_voxel(kind)
    Draw.upload(part(base, kind, 0), box(box(bird, 1, 2, 3, 1, 1, 3, wing), 5, 2, 3, 1, 1, 3, wing), size)
    let depth = if kind == 2 do 5 else if kind == 1 do 2 else 3 end end
    let left = box(box(vehicle_body(), 3, 0, 2, 6, 1, depth, wing), 1, 0, 1, 3, 1, 3, wing)
    let right = box(box(vehicle_body(), 0, 0, 2, 6, 1, depth, wing), 5, 0, 1, 3, 1, 3, wing)
    Draw.upload(part(base, kind, 1), box(left, 0, 0, 0, 2, 1, 2, tip), size)
    Draw.upload(part(base, kind, 2), box(right, 7, 0, 0, 2, 1, 2, tip), size)
  end
  fn setup(base : Int) : Unit do
    List.fold_left([0, 1, 2, 3], (), fn (_, kind) -> bird_meshes(base, kind))
  end
  pfn hide_parts(base : Int, keep : Int, kind : Int) : Unit do
    if kind >= 4 do () else
      if kind != keep do
        Draw.show(part(base, kind, 0), false)
        Draw.show(part(base, kind, 1), false)
        Draw.show(part(base, kind, 2), false)
        ()
      else () end
      hide_parts(base, keep, kind + 1)
    end
  end
  fn hide(base : Int, keep : Int) : Unit do hide_parts(base, keep, 0) end

  fn draw(base : Int, c : Ur.Sim.City, site : Ur.Wildlife.WildlifeSite, kind : Int, age : Float) : Unit do
    let p = Ur.Wildlife.bird_pose(site, age)
    let floor = int_to_float(L.height(c, float_to_int(p.x *. 4.0), float_to_int(p.z *. 4.0))) *. 0.25 +. 3.0
    let y = p.y +. p.flight *. Math.max_float(0.0, floor -. p.y)
    let scale = bird_voxel(kind) /. 0.105
    Draw.pose(part(base, kind, 0), p.x, y, p.z, site.heading, p.pitch, 0.0, 0.3675 *. scale, 0.0, 0.525 *. scale)
    if p.flight <= 0.05 do
      Draw.show(part(base, kind, 1), false)
      Draw.show(part(base, kind, 2), false)
      ()
    else
      let speed = match kind do 1 -> 33.0 | 2 -> 17.0 | 3 -> 29.0 | _ -> 23.0 end
      let beat = 0.15 +. Math.sin(age *. speed) *. 0.74 *. p.flight
      let dx = Math.cos(site.heading) *. 0.19 *. scale
      let dz = Math.sin(site.heading) *. 0.19 *. scale
      let wing_y = y +. 0.24 *. scale
      Draw.pose(part(base, kind, 1), p.x -. dx, wing_y, p.z +. dz, site.heading, p.pitch, 0.0 -. beat, 0.945 *. scale, 0.0525 *. scale, 0.42 *. scale)
      Draw.pose(part(base, kind, 2), p.x +. dx, wing_y, p.z -. dz, site.heading, p.pitch, beat, 0.0, 0.0525 *. scale, 0.42 *. scale)
      ()
    end
  end
end
