-- Off-grid centre lines are clipped into the same parcel meshes as terrain.
-- Each parcel samples its neighbours too, so pavement can cross a grid corner
-- without the outline taking a visible step.
mod Ur.RoadSurface do
  alias Ur.Sim as S
  alias Ur.RoadShape as Shape
  alias Ur.Architecture as A

  type Segment = { x : Float, z : Float, dx : Float, dz : Float, length_squared : Float,
    kind : Int, width : Float, mark : Bool, left : Float, right : Float, top : Float, bottom : Float }

  pfn minimum(a : Float, b : Float) : Float do if a < b do a else b end end
  pfn maximum(a : Float, b : Float) : Float do if a > b do a else b end end

  pfn edge_offset(c : Ur.Sim.City, lot : Int, side : Int) : Int do
    let code = S.get(c.road_shapes, lot)
    if code == 0 || S.get(c.roads, lot) == 0 do -1 else
      let shape = Shape.decode(code)
      let p = if Shape.on_arm(shape.a, side) do shape.a else shape.b end
      if !Shape.on_arm(p, side) do -1 else if side < 2 do p.z else p.x end end
    end
  end

  fn edge(c : Ur.Sim.City, lot : Int, side : Int) : (Int, Int) do
    let own = edge_offset(c, lot, side)
    let other = if own >= 0 do own else edge_offset(c, S.neighbour(lot, side), S.opposite(side)) end
    let offset = if other >= 0 do other else 16 end
    match side do
      0 -> (0, offset)
      1 -> (32, offset)
      2 -> (offset, 0)
      _ -> (offset, 32)
    end
  end

  pfn segment(a : (Float, Float), b : (Float, Float), kind : Int, width : Float, mark : Bool) : Segment do
    let (x, z) = a
    let (bx, bz) = b
    let dx = bx -. x
    let dz = bz -. z
    let margin = width +. 2.0
    { x: x, z: z, dx: dx, dz: dz, length_squared: dx *. dx +. dz *. dz,
      kind: kind, width: width, mark: mark, left: minimum(x, bx) -. margin, right: maximum(x, bx) +. margin,
      top: minimum(z, bz) -. margin, bottom: maximum(z, bz) +. margin }
  end

  pfn sample(shape : Ur.RoadShape.StreetCurve, t : Float, dx : Int, dz : Int) : (Float, Float) do
    let (x, z) = Shape.sample(shape, t)
    (x +. int_to_float(dx), z +. int_to_float(dz))
  end

  pfn chain(shape : Ur.RoadShape.StreetCurve, dx : Int, dz : Int, kind : Int, width : Float, n : Int,
    at : (Float, Float), out : List(Segment)) : List(Segment) do
    if n > 6 do out else
      let next = sample(shape, int_to_float(n) /. 6.0, dx, dz)
      chain(shape, dx, dz, kind, width, n + 1, next, Cons(segment(at, next, kind, width, true), out))
    end
  end

  pfn joins(c : Ur.Sim.City, source : Int, dx : Int, dz : Int, centre : (Float, Float), kind : Int,
    width : Float, side : Int, out : List(Segment)) : List(Segment) do
    if side == 4 do out else
      let join = S.street_link(c, source, side) && edge_offset(c, source, side) < 0
      let out = if !join do out else
        let (x, z) = edge(c, source, side)
        Cons(segment(centre, (int_to_float(x + dx), int_to_float(z + dz)), kind, width, false), out)
      end
      joins(c, source, dx, dz, centre, kind, width, side + 1, out)
    end
  end

  pfn inside_parcel(p : Ur.RoadShape.StreetPoint) : Bool do
    p.x > 0 && p.x < 32 && p.z > 0 && p.z < 32
  end

  pfn source_segments(c : Ur.Sim.City, source : Int, dx : Int, dz : Int, legacy : Bool, out : List(Segment)) : List(Segment) do
    let kind = S.get(c.roads, source)
    let code = S.get(c.road_shapes, source)
    let width = int_to_float(S.road_half_width(kind))
    if kind == 0 || (code == 0 && !legacy) do out
    else if code == 0 do
      joins(c, source, dx, dz, (int_to_float(16 + dx), int_to_float(16 + dz)), kind, width, 0, out)
    else
      let shape = Shape.decode(code)
      let first = sample(shape, 0.0, dx, dz)
      let last = sample(shape, 1.0, dx, dz)
      let out = chain(shape, dx, dz, kind, width, 1, first, out)
      let no_street = !List.any([0, 1, 2, 3], fn side -> S.street_link(c, source, side))
      let bulb = (kind == 1 || kind == 2) && (no_street || S.street_end_arm(c, source) >= 0)
      let out = if bulb && inside_parcel(shape.a) do Cons(segment(first, first, kind, 14.0, false), out) else out end
      let out = if bulb && inside_parcel(shape.b) do Cons(segment(last, last, kind, 14.0, false), out) else out end
      joins(c, source, dx, dz, sample(shape, 0.5, dx, dz), kind, width, 0, out)
    end end
  end

  pfn legacy_join(c : Ur.Sim.City, i : Int) : Bool do
    List.any([0, 1, 2, 3], fn side ->
      let offset = edge_offset(c, S.neighbour(i, side), S.opposite(side))
      S.street_link(c, i, side) && offset >= 0 && offset != 16)
  end

  fn uses_curve(c : Ur.Sim.City, i : Int) : Bool do
    S.get(c.roads, i) > 0 && S.get(c.heights, i) > 0 && !S.valid(S.grade_peer(c, i)) &&
      i != c.harbour && (S.get(c.road_shapes, i) > 0 || legacy_join(c, i))
  end

  pfn blocks_spill(c : Ur.Sim.City, i : Int) : Bool do
    S.get(c.heights, i) <= 0 || S.get(c.roads, i) > 0 || i == c.harbour || S.valid(S.grade_peer(c, i)) ||
      S.get(c.buildings, i) > 0 || S.get(c.construction, i) > 0 || S.public_work_stage(c, i) > 0 ||
      S.get(c.plants, i) > 0 || S.get(c.ferries, i) > 0 || S.get(c.parks, i) > 0 ||
      S.get(c.seawalls, i) > 0 || S.get(c.transit, i) > 0 || S.get(c.public_parking, i) > 0 ||
      S.get(c.canals, i) > 0 || S.fire_rebuilding(c, i) || S.valid(S.campus_root(c, i))
  end

  pfn around(c : Ur.Sim.City, i : Int, draw_own : Bool) : List(Segment) do
    let x = i % S.width()
    let z = i / S.width()
    let height = S.get(c.heights, i)
    List.fold_left(List.range(0, 9), Nil, fn (segments, at) ->
      let dx = at % 3 - 1
      let dz = at / 3 - 1
      let nx = x + dx
      let nz = z + dz
      if nx < 0 || nx >= S.width() || nz < 0 || nz >= S.depth() do segments else
        let lot = S.index(nx, nz)
        if lot == i && !draw_own || lot != i &&
          (S.get(c.road_shapes, lot) == 0 || int_abs(S.get(c.heights, lot) - height) > 6) do segments
        else source_segments(c, lot, dx * 32, dz * 32, draw_own && lot == i, segments) end
      end)
  end

  pfn stripe(s : Segment, square : Float, at : Float, wx : Int, wz : Int) : Int do
    let along_x = Math.abs(s.dx) >= Math.abs(s.dz)
    let along = if along_x do int_to_float(wx) +. s.x +. at *. s.dx else int_to_float(wz) +. s.z +. at *. s.dz end
    if !s.mark do if s.kind == 3 do 16 else 4 end
    else if s.kind == 3 do if square < 1.21 do 17 else 16 end
    else if s.kind == 2 && square < 1.21 do 10
    else if square < 0.41 && int_mod_euclid(float_to_int(Math.floor(along)), 15) < 7 do 8
    else 4 end end end end
  end

  pfn ink(segments : List(Segment), x : Float, z : Float, wx : Int, wz : Int, best : Float, material : Int) : Int do
    match segments do
      Nil -> material
      Cons(s, rest) ->
        if x < s.left || x > s.right || z < s.top || z > s.bottom do ink(rest, x, z, wx, wz, best, material) else
          let ax = x -. s.x
          let az = z -. s.z
          let at = if s.length_squared < 0.001 do 0.0 else maximum(0.0, minimum(1.0, (ax *. s.dx +. az *. s.dz) /. s.length_squared)) end
          let dx = ax -. at *. s.dx
          let dz = az -. at *. s.dz
          let square = dx *. dx +. dz *. dz
          let curb = s.width +. 2.0
          if square >= curb *. curb do ink(rest, x, z, wx, wz, best, material) else
            let road = square < s.width *. s.width
            -- When shoulders overlap, asphalt and its markings win over curbs.
            let rank = square /. (s.width *. s.width) +. (if road do 0.0 else 1.0 end)
            if rank >= best do ink(rest, x, z, wx, wz, best, material) else
              let material = if road do stripe(s, square, at, wx, wz) else 24 end
              ink(rest, x, z, wx, wz, rank, material)
            end end
        end
    end
  end

  pfn row(segments : List(Segment), floor : NativeIntArr, wx : Int, wz : Int, x : Int, z : Int,
    start : Int, material : Int, deck : Int,
    out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let next = if x == 32 do -1 else ink(segments, int_to_float(x) +. 0.5, int_to_float(z) +. 0.5, wx, wz, 9.0, -1) end
    let height = if x == 32 do deck else NativeArray.get_int(floor, z / 4 * 8 + x / 4) end
    let changed = next != material || height != deck
    let out = if changed && material >= 0 do
      Cons(A.piece(start, deck, z, x - start, if material == 24 do 2 else 1 end, 1, material), out)
    else out end
    if x == 32 do out else row(segments, floor, wx, wz, x + 1, z, if changed do x else start end, next, height, out) end
  end

  pfn terrain_floor(c : Ur.Sim.City, wx : Int, wz : Int, cell : Int, floor : NativeIntArr) : NativeIntArr do
    if cell >= 64 do floor else
      let terrain = S.unbuilt_ground_height(c, wx + cell % 8 * 4 + 2, wz + cell / 8 * 4 + 2)
      terrain_floor(c, wx, wz, cell + 1, NativeArray.set_int(floor, cell, terrain))
    end
  end

  fn pieces(c : Ur.Sim.City, i : Int, include_street : Bool) : List(Ur.Architecture.Piece) do
    if !include_street && blocks_spill(c, i) do Nil else
      let segments = around(c, i, include_street)
      if List.is_empty(segments) do Nil else
        let wx = i % S.width() * 32
        let wz = i / S.width() * 32
        let deck = S.get(c.heights, i)
        let floor = NativeArray.make_int(64, deck)
        let floor = if include_street do floor else terrain_floor(c, wx, wz, 0, floor) end
        List.fold_left(List.range(0, 32), Nil, fn (out, z) ->
          let y = int_to_float(z) +. 0.5
          let across = List.filter(segments, fn s -> s.bottom >= y && s.top <= y && s.left < 32.0 && s.right > 0.0)
          if List.is_empty(across) do out else
            row(across, floor, wx, wz, 0, z, 0, -1, NativeArray.get_int(floor, z / 4 * 8), out)
          end)
      end
    end
  end
end
