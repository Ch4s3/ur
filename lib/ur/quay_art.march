-- South-facing by default. Orient both halves independently at the shore.
mod Ur.QuayArt do
  alias Ur.Architecture as A

  pfn tie_height(deck : Int) : Int do Math.max_int(0, Math.min_int(deck - 1, 6)) end

  pfn waterfront_wall(deck : Int, seed : Int) : List(Ur.Architecture.Piece) do
    let ring = tie_height(deck)
    let footing = Math.min_int(ring, 2)
    let base = [A.piece(0, 0, 28, 32, deck, 3, A.brick(1)),
      A.piece(10, ring, 31, 3, 1, 1, 19), A.piece(19, ring, 31, 3, 1, 1, 19)]
    let base = if footing > 0 do Cons(A.piece(0, 0, 31, 32, footing, 1, 2), base) else base end
    let x = if seed % 2 == 0 do 5 else 24 end
    let rungs = List.map(List.range(0, (deck + 1) / 3), fn step ->
      A.piece(x + 1, step * 3 + 1, 31, 1, 1, 1, 7))
    List.append(rungs, Cons(A.piece(x, footing, 31, 1, deck + 3 - footing, 1, 19),
      Cons(A.piece(x + 2, footing, 31, 1, deck + 3 - footing, 1, 19), base)))
  end

  pfn promenade_paving(deck : Int, seed : Int, waterfront : Bool) : List(Ur.Architecture.Piece) do
    let trim = List.map(List.range(0, 8), fn tile ->
      A.piece(tile * 4, deck, 6, 4, 2, 2, if (tile + seed) % 2 == 0 do 18 else 5 end))
    let edge = if waterfront do [A.piece(0, deck, 29, 32, 2, 1, 17), A.piece(0, deck, 30, 32, 2, 2, 8)]
      else [A.piece(0, deck, 29, 32, 2, 3, 24)] end
    List.append(trim, List.append([
      A.piece(0, deck, 0, 32, 2, 6, 24), A.piece(0, deck, 8, 32, 2, 15, 16),
      A.piece(0, deck, 23, 32, 2, 1, 23), A.piece(0, deck, 24, 32, 2, 5, 24)
    ], edge))
  end

  pfn terrace_furniture(ground : Int, seed : Int, lighting : Int, waterfront : Bool) : List(Ur.Architecture.Piece) do
    let x = if seed % 2 == 0 do 7 else 23 end
    let seat = if x == 7 do 19 else 3 end
    let colour = if seed % 3 == 0 do 6 else 7 end
    let lamp = if lighting / 4 % 2 == 1 do 28 else 8 end
    let bollards = if !waterfront do Nil else List.flat_map([3, 11, 20, 28], fn post -> [
      A.piece(post, ground, 30, 1, 2, 1, 19), A.piece(post, ground + 2, 30, 1, 1, 1, 17)
    ]) end
    let trees = Ur.Trees.shape(if seed % 4 == 0 do 4 else Ur.Trees.palm() end, x, 26, ground + 2, seed)
    List.append(trees, List.append(bollards, [
      A.piece(x - 3, ground, 24, 8, 1, 5, A.brick(0)),
      A.piece(x - 3, ground + 1, 24, 8, 1, 1, 5), A.piece(x - 3, ground + 1, 28, 8, 1, 1, 5),
      A.piece(x - 3, ground + 1, 25, 1, 1, 3, 5), A.piece(x + 4, ground + 1, 25, 1, 1, 3, 5),
      A.piece(x - 2, ground + 1, 25, 6, 1, 3, 13),
      A.piece(seat + 1, ground, 26, 1, 2, 2, 19), A.piece(seat + 6, ground, 26, 1, 2, 2, 19),
      A.piece(seat, ground + 2, 26, 8, 1, 2, colour), A.piece(seat, ground + 1, 25, 8, 3, 1, colour),
      A.piece(27, ground, 4, 1, 8, 1, 19), A.piece(26, ground + 8, 3, 3, 1, 3, 19),
      A.piece(27, ground + 7, 5, 1, 1, 1, lamp)
    ]))
  end

  fn promenade(deck : Int, lot : Int, lighting : Int, side : Int, waterfront : Bool) : List(Ur.Architecture.Piece) do
    let seed = int_mod_euclid(Strata.Seed.mix(lot, 23), 1009)
    let wall = if waterfront do waterfront_wall(deck, seed) else Nil end
    A.orient(List.append(wall, List.append(promenade_paving(deck, seed, waterfront),
      terrace_furniture(deck + 2, seed, lighting, waterfront))), side)
  end

  pfn small_hull(x : Int, length : Int, paint : Int) : List(Ur.Architecture.Piece) do
    [A.piece(x + 1, 0, 23, length - 3, 1, 4, 19),
      A.piece(x, 1, 22, length - 3, 2, 6, paint), A.piece(x + length - 3, 1, 23, 2, 2, 4, paint),
      A.piece(x + length - 1, 1, 24, 1, 2, 2, paint),
      A.piece(x, 3, 22, length - 3, 1, 6, 8), A.piece(x + length - 3, 3, 23, 2, 1, 4, 8),
      A.piece(x + length - 1, 3, 24, 1, 1, 2, 8)]
  end

  pfn boat_fitout(x : Int, kind : Int, paint : Int) : List(Ur.Architecture.Piece) do
    match kind do
      0 -> [A.piece(x + 3, 4, 23, 6, 1, 4, 8), A.piece(x + 3, 5, 23, 6, 2, 4, 9),
        A.piece(x + 2, 7, 23, 8, 1, 4, 8), A.piece(x + 4, 8, 24, 2, 2, 1, 19)]
      1 -> [A.piece(x + 2, 4, 23, 2, 1, 4, 1), A.piece(x + 7, 4, 23, 2, 1, 4, 1),
        A.piece(x + 5, 4, 24, 1, 8, 1, 13), A.piece(x + 5, 6, 24, 5, 1, 1, 5),
        A.piece(x + 6, 7, 24, 3, 1, 1, 8), A.piece(x + 5, 12, 24, 3, 1, 1, paint)]
      _ -> [A.piece(x + 2, 4, 23, 2, 3, 1, 19), A.piece(x + 2, 4, 26, 2, 3, 1, 19),
        A.piece(x + 7, 4, 23, 1, 3, 1, 19), A.piece(x + 7, 4, 26, 1, 3, 1, 19),
        A.piece(x + 1, 7, 23, 8, 1, 4, paint), A.piece(x + 2, 8, 24, 6, 1, 2, 8)]
    end
  end

  fn moored_boat(deck : Int, lot : Int, side : Int) : List(Ur.Architecture.Piece) do
    let seed = int_mod_euclid(Strata.Seed.mix(lot, 47), 1009)
    let kind = seed % 3
    let x = if seed % 2 == 0 do 5 else 9 end
    let length = if kind == 1 do 15 else 18 end
    let paint = match seed % 4 do 0 -> 6 | 1 -> 7 | 2 -> 12 | _ -> 15 end
    let cleat = if x == 5 do 11 else 20 end
    let ring = tie_height(deck)
    let rope = List.map(List.range(0, 4), fn step ->
      let from = (4 * (4 - step) + ring * step) / 4
      let to = (4 * (3 - step) + ring * (step + 1)) / 4
      A.piece(cleat, Math.min_int(from, to), 28 + step, 1, int_abs(from - to) + 1, 1, 13))
    let fittings = [A.piece(cleat, 4, 27, 1, 1, 1, 19),
      A.piece(x + 2, 2, 28, 1, 2, 1, 19), A.piece(x + 5, 2, 28, 1, 2, 1, 19)]
    A.orient(List.append(small_hull(x, length, paint),
      List.append(boat_fitout(x, kind, paint), List.append(fittings, rope))), side)
  end
end
