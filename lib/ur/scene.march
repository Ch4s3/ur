-- Terrain and structures share aligned Strata chunks and their shadow volume.
mod Ur.Scene do
  needs IO.Console
  needs IO.Process
  needs IO.Foreign
  needs Window
  alias Strata.Ffi.Vk as Vk
  alias Strata.Quad as Q
  alias Ur.Sim as S
  alias Ur.Landscape as L
  alias Ur.UtilitiesNetwork as Net
  import Ur.SceneMesh.{empty, face, box, vehicle_body}
  pfn canal_material() : Int do 44 end
  pfn material_count() : Int do Ur.VolcanoRender.ash_material() + Ur.VolcanoRender.ash_materials() end
  pfn colour(i : Int) : (Int, Int, Int) do
    match i do
      0 -> (108, 157, 92)
      1 -> (144, 117, 84)
      2 -> (118, 129, 128)
      3 -> (54, 144, 164)
      4 -> (61, 75, 82)
      5 -> (239, 207, 151)
      6 -> (183, 90, 66)
      7 -> (53, 128, 133)
      8 -> (228, 228, 207)
      9 -> (75, 130, 157)
      10 -> (250, 196, 79)
      11 -> (161, 211, 122)
      12 -> (108, 183, 218)
      13 -> (76, 66, 57)
      14 -> (57, 116, 69)
      15 -> (241, 184, 103)
      16 -> (222, 197, 146)
      17 -> (151, 157, 151)
      18 -> (218, 158, 117)
      19 -> (49, 66, 79)
      20 -> (124, 220, 214)
      21 -> (86, 148, 77)
      22 -> (131, 166, 99)
      23 -> (149, 151, 140)
      24 -> (183, 181, 166)
      25 -> (93, 142, 91)
      26 -> (255, 205, 130)
      27 -> (255, 218, 164)
      28 -> (255, 225, 157)
      29 -> (255, 239, 214)
      30 -> (252, 86, 68)
      31 -> (100, 156, 255)
      32 -> (69, 62, 66)
      33 -> (94, 88, 95)
      34 -> (128, 125, 137)
      35 -> (248, 106, 27)
      36 -> (255, 154, 32)
      37 -> (92, 112, 96)
      44 -> (44, 101, 103)
      49 -> (27, 25, 24)
      50 -> (177, 50, 17)
      51 -> (236, 243, 239)
      52 -> (223, 235, 233)
      53 -> (209, 225, 225)
      54 -> (132, 121, 110)
      55 -> (138, 86, 64)
      56 -> (93, 91, 84)
      _ -> Ur.ReefArt.colour(i)
    end
  end
  pfn pixels(a : NativeU8Arr, tex : Int, j : Int, r : Int, g : Int, b : Int) : NativeU8Arr do
    if j >= 256 do a else
      let x = j % 16
      let y = j / 16
      let grain = ((x * 43 + y * 71 + x * y * 23) % 13) - 6
      let pattern = if tex == 6 do (if y == 0 || (x + (y / 8) * 4) % 8 == 0 do -15 else 3 end)
        else if tex == 17 || tex == 2 do (if y == 0 || x == 0 do -11 else 0 end)
        else if tex == 19 do (if x == 0 || y == 0 do 20 else 0 end)
        else if tex == 3 do (if (x + y / 2) % 15 == 0 do 3 else 0 end)
        else 0 end end end end
      let delta = grain + pattern
      let a = NativeArray.set_u8(a, j * 4, S.clamp(r + delta, 0, 255))
      let a = NativeArray.set_u8(a, j * 4 + 1, S.clamp(g + delta, 0, 255))
      pixels(NativeArray.set_u8(a, j * 4 + 2, S.clamp(b + delta, 0, 255)), tex, j + 1, r, g, b)
    end
  end
  pfn palette(i : Int, r : Strata.Blocks.Registry) : Strata.Blocks.Registry do
    if i >= material_count() do r else
      let (red, green, blue) = colour(i)
      let steam = i - Ur.VolcanoRender.steam_material()
      let alpha = if i == canal_material() do 214 else if i >= 32 && i <= 34 do 122 - (i - 32) * 31
        else if steam >= 0 && steam < 3 do 142 - steam * 53 else 255 end end end
      let a = if i >= Ur.VolcanoRender.ash_material() do Ur.VolcanoRender.ash_texture(i - Ur.VolcanoRender.ash_material())
        else pixels(NativeArray.make_u8(1024, alpha), i, 0, red, green, blue) end
      if !Vk.texture_set(i, a) do Ur.AppError.stop("Material texture upload failed") else () end
      let roughness = if i == canal_material() do 28 else if i == 3 do 65 else if i == 9 || i == 19 do 116 else 245 end end end
      let d = Strata.Blocks.with_material(Strata.Blocks.with_faces(Strata.Blocks.def(), i, i, i), roughness, 0)
      let d = match i do
        20 -> Strata.Blocks.with_emission(d, 118, 235, 215, 45)
        26 -> Strata.Blocks.with_emission(d, 255, 178, 93, 145)
        27 -> Strata.Blocks.with_emission(d, 255, 200, 127, 180)
        28 -> Strata.Blocks.with_emission(d, 255, 213, 149, 230)
        29 -> Strata.Blocks.with_emission(d, 255, 228, 190, 215)
        30 -> Strata.Blocks.with_emission(d, 255, 36, 19, 235)
        31 -> Strata.Blocks.with_emission(d, 38, 103, 255, 235)
        35 -> Strata.Blocks.with_emission(d, 255, 63, 8, 160)
        36 -> Strata.Blocks.with_emission(d, 255, 139, 17, 190)
        50 -> Strata.Blocks.with_emission(d, 216, 42, 8, 100)
        _ -> d
      end
      match Strata.Blocks.register(r, d) do
        Ok((next, _)) -> palette(i + 1, next)
        Err(_) -> r
      end
    end
  end
  -- Render slots, laid out from the lot count N = S.count() (at the original 60 x 44 map these
  -- are the numbers the game always used):
  --   0 .. 4N           low per-lot terrain and structure layers, also used for cutaways
  --   sea_slot          the sea's chunks (sea_cols x sea_rows, at most 31)
  --   (4N + 32 .. 39 spare: once the 7 clouds)
  --   rotor_slot        N: a lot's ferry vessel or wind-turbine rotor
  --   overlay_slot      N: a lot's map-layer overlay
  --   food_slot         60 food vehicles
  --   fleet_slot        180 fleet runs
  --   incident_slot     16 incidents, a marker and a vehicle each, then their window smoke (+32)
  --   preview_slot      72 build-preview tiles and road markers
  --   sanitation_slot, marker_slot
  --   walker_template_base   the walker templates, then two slots per citizen (walker, car)
  pfn sea_slot(i : Int) : Int do 4 * S.count() + 1 + i end
  pfn rotor_slot(i : Int) : Int do 4 * S.count() + 40 + i end
  pfn overlay_slot(i : Int) : Int do 5 * S.count() + 40 + i end
  pfn food_slot(i : Int) : Int do 6 * S.count() + 40 + i end
  pfn fleet_slot(i : Int) : Int do 6 * S.count() + 100 + i end
  pfn preview_slot(i : Int) : Int do 6 * S.count() + 472 + i end
  pfn sanitation_slot() : Int do 6 * S.count() + 600 end
  pfn marker_slot() : Int do 6 * S.count() + 603 end
  -- The sea: level-5 chunks 32 lots across, from lot -32 past the far edge.
  pfn sea_cols() : Int do (S.width() + 63) / 32 + 1 end
  pfn sea_rows_n() : Int do (S.depth() + 63) / 32 + 1 end
  -- The far sea, translucent ocean out to the horizon: the sea_cols x sea_rows tiles (a voxel is a lot),
  -- open where the map and its ring carry their own water (Ur.Ocean).
  pfn near_water(px : Int, pz : Int) : Bool do
    px >= 0 - Ur.Ocean.ring() && px < S.width() + Ur.Ocean.ring() && pz >= 0 - Ur.Ocean.ring() && pz < S.depth() + Ur.Ocean.ring()
  end
  pfn far_row(m : Ur.SceneMesh.Mesh, ox : Int, oz : Int, v : Int, u : Int, start : Int) : Ur.SceneMesh.Mesh do
    let open = u < 32 && !near_water(ox + u, oz + v)
    if open && start < 0 do far_row(m, ox, oz, v, u + 1, u)
    else if open do far_row(m, ox, oz, v, u + 1, start)
    else
      let n = m.quads * 2
      let m = if start < 0 do m else
        { words: NativeArray.set_i32(NativeArray.set_i32(m.words, n, Q.pack0(start, 0, v, u - start, 1, 0)), n + 1, Q.ocean1(63, 63, 63, 63)), quads: m.quads + 1 }
      end
      if u >= 32 do m else far_row(m, ox, oz, v, u + 1, -1) end
    end end
  end
  pfn far_sea(ox : Int, oz : Int, v : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if v >= 32 do m else far_sea(ox, oz, v + 1, far_row(m, ox, oz, v, 0, -1)) end
  end
  pfn sea(i : Int) : Unit do
    if i >= sea_cols() * sea_rows_n() do () else
      let m = far_sea((i % sea_cols() - 1) * 32, (i / sea_cols() - 1) * 32, 0, empty())
      if Vk.chunk_begin(sea_slot(i), (i % sea_cols() - 1) * 1024, -32, (i / sea_cols() - 1) * 1024, 5) && (m.quads == 0 || Vk.chunk_part(2, m.words, m.quads)) && Vk.chunk_commit() do sea(i + 1)
      else Ur.AppError.stop("Sea mesh upload failed") end
    end
  end
  pfn tunnel_lot(c : Ur.Sim.City, i : Int) : Bool do
    let a = S.grade_source(c, i)
    let b = S.grade_peer(c, a)
    S.grade_kind(c, a) == 3 && a != b && S.grade_link(c, a, b) && S.grade_link(c, b, a)
  end
  fn tunnel_view(layer : Int, yaw : Float) : Int do
    if layer != 35 do 0 else
      1 + (if Math.sin(yaw) >= 0.0 do 1 else 0 end) + (if Math.cos(yaw) >= 0.0 do 2 else 0 end)
    end
  end
  pfn section_shoulder(c : Ur.Sim.City, x : Int, z : Int, side : Int, step : Int, land : Int) : Bool do
    if step > 3 || land <= step * 18 - 12 do false else
      let wx = x - (if side % 2 == 0 do step else 0 - step end)
      let nz = z - (if side >= 3 do step else 0 - step end)
      let x_peer = if wx >= 0 && wx < S.width() do S.index(wx, z) else -1 end
      let z_peer = if nz >= 0 && nz < S.depth() do S.index(x, nz) else -1 end
      let near = List.any([x_peer, z_peer], fn i ->
        if !tunnel_lot(c, i) || S.get(c.heights, i) < 24 do false else
          let a = S.grade_source(c, i)
          let b = S.grade_peer(c, a)
          i != a && i != b && ((i == z_peer) == (a / S.width() == b / S.width()))
        end)
      near || section_shoulder(c, x, z, side, step + 1, land)
    end
  end
  pfn section_cut(c : Ur.Sim.City, x : Int, z : Int, side : Int) : Bool do
    if side == 0 || x < 0 || x >= S.width() || z < 0 || z >= S.depth() do false else
      let i = S.index(x, z)
      tunnel_lot(c, i) || section_shoulder(c, x, z, side, 1, S.get(c.heights, i))
    end
  end
  pfn sea_rows(c : Ur.Sim.City, ox : Int, oz : Int, row : Int, col : Int, start : Int, m : Ur.SceneMesh.Mesh, side : Int) : Ur.SceneMesh.Mesh do
    if row >= 32 do m else
      let gap = col == 32 || section_cut(c, ox + col, oz + row, side)
      let m = if gap && col > start do face(m, start, 0, row, col - start, 1, 0, 3) else m end
      if col == 32 do sea_rows(c, ox, oz, row + 1, 0, 0, m, side)
      else sea_rows(c, ox, oz, row, col + 1, if gap do col + 1 else start end, m, side) end
    end
  end
  -- The sea chunks that overlap the map, whose water the tunnel cutaway opens.
  pfn inner_sea(i : Int, out : List(Int)) : List(Int) do
    if i >= sea_cols() * sea_rows_n() do List.reverse(out) else
      let x = (i % sea_cols() - 1) * 32
      let z = (i / sea_cols() - 1) * 32
      inner_sea(i + 1, if x >= 0 && x < S.width() && z >= 0 && z < S.depth() do Cons(i, out) else out end)
    end
  end
  pfn section_sea(c : Ur.Sim.City, side : Int) : Unit do
    List.each(inner_sea(0, Nil), fn i ->
      let x = (i % sea_cols() - 1) * 32
      let z = (i / sea_cols() - 1) * 32
      let m = if side > 0 do sea_rows(c, x, z, 0, 0, 0, { words: NativeArray.make_i32(1024, 0), quads: 0 }, side)
        else face({ words: NativeArray.make_i32(2, 0), quads: 0 }, 0, 0, 0, 32, 32, 0, 3) end
      if m.quads == 0 do Vk.chunk_free(sea_slot(i))
      else if Vk.chunk_begin(sea_slot(i), x * 32, -32, z * 32, 5) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do ()
      else Ur.AppError.stop("Tunnel cutaway water upload failed") end end)
  end
  -- Mountains that clouds part around. A peak is a parcel at least 12 m high
  -- that no parcel within 40 m tops; peaks closer than 80 m are one mountain.
  -- Each carries how wide the mountain is at ground heights from 4 m up,
  -- every 2 m: the radius of a disc as large as the ground above that
  -- height within 200 m of the peak.
  type Peak = { peak_x : Float, peak_z : Float, top : Float, radii : NativeF32Arr }
  pfn ground_m(c : Ur.Sim.City, x : Int, z : Int) : Float do
    if x < 0 || z < 0 || x >= S.width() || z >= S.depth() do 0.0 else int_to_float(S.get(c.heights, S.index(x, z))) *. 0.25 end
  end
  pfn tallest_near(c : Ur.Sim.City, x : Int, z : Int, k : Int, best : Float) : Float do
    if k >= 121 do best else
      let dx = k % 11 - 5
      let dz = k / 11 - 5
      let h = if dx * dx + dz * dz <= 25 && (dx != 0 || dz != 0) do ground_m(c, x + dx, z + dz) else 0.0 end
      tallest_near(c, x, z, k + 1, if h > best do h else best end)
    end
  end
  -- parcels within 200 m of (x, z) at least [h] m high
  pfn above(c : Ur.Sim.City, x : Int, z : Int, h : Float, k : Int, n : Int) : Int do
    if k >= 51 * 51 do n else
      let dx = k % 51 - 25
      let dz = k / 51 - 25
      let inside = dx * dx + dz * dz <= 625 && ground_m(c, x + dx, z + dz) >= h
      above(c, x, z, h, k + 1, if inside do n + 1 else n end)
    end
  end
  pfn peak_radii(c : Ur.Sim.City, x : Int, z : Int, band : Int, out : NativeF32Arr) : NativeF32Arr do
    if band >= 14 do out else
      let n = above(c, x, z, 4.0 +. int_to_float(band) *. 2.0, 0, 0)
      peak_radii(c, x, z, band + 1, NativeArray.set_f32(out, band, math_sqrt(int_to_float(n) *. 64.0 /. 3.14159)))
    end
  end
  pfn find_peaks(c : Ur.Sim.City, i : Int, acc : List(Peak)) : List(Peak) do
    if i >= S.count() do acc else
      let x = i % S.width()
      let z = i / S.width()
      let h = ground_m(c, x, z)
      let px = int_to_float(x * 8 + 4)
      let pz = int_to_float(z * 8 + 4)
      let near = List.any(acc, fn p -> (p.peak_x -. px) *. (p.peak_x -. px) +. (p.peak_z -. pz) *. (p.peak_z -. pz) < 6400.0)
      if h < 12.0 || near || tallest_near(c, x, z, 0, 0.0) > h do find_peaks(c, i + 1, acc)
      else find_peaks(c, i + 1, Cons({ peak_x: px, peak_z: pz, top: h, radii: peak_radii(c, x, z, 0, NativeArray.make_f32(14, 0.0)) }, acc)) end
    end
  end
  fn mountains(c : Ur.Sim.City) : List(Peak) do find_peaks(c, 0, Nil) end
  -- A mountain blocks the air above it too, about 2.2 times its own height:
  -- how wide its blocking is at height y (m), the width of the ground above
  -- y / 2.2, and 0 when y is above even that.
  pfn width_at(p : Peak, y : Float) : Float do
    let h = y /. 2.2
    if h >= p.top do 0.0 else
      let band = (h -. 4.0) /. 2.0
      if band <= 0.0 do NativeArray.get_f32(p.radii, 0) else
        let k = float_to_int(band)
        if k >= 13 do NativeArray.get_f32(p.radii, 13) else
          let f = band -. int_to_float(k)
          NativeArray.get_f32(p.radii, k) *. (1.0 -. f) +. NativeArray.get_f32(p.radii, k + 1) *. f
        end
      end
    end
  end
  -- Where wind carrying a cloud past the peaks takes it. Air meeting a
  -- mountain parts round it: a path that would cross the mountain's middle
  -- [b] metres to one side is pushed out to sqrt(b^2 + R^2 g), R the
  -- mountain's width at the cloud's height plus most of the cloud's own half
  -- width, g falling from 1 beside the mountain to nothing far up or down
  -- wind. Paths keep their order, so clouds squeeze past the flanks and
  -- close up again in the lee, and none crosses the mountain.
  pfn around(peaks : List(Peak), x : Float, z : Float, y : Float, half : Float, wx : Float, wz : Float) : (Float, Float) do
    match peaks do
      Nil -> (x, z)
      Cons(p, rest) ->
        let width = width_at(p, y)
        if width <= 0.0 do around(rest, x, z, y, half, wx, wz) else
          let r = width +. 0.7 *. half
          let rx = x -. p.peak_x
          let rz = z -. p.peak_z
          let a = rx *. wx +. rz *. wz
          let b = rz *. wx -. rx *. wz
          let reach = a /. (1.6 *. r)
          let g = 1.0 /. (1.0 +. reach *. reach *. reach *. reach)
          let side = if b < 0.0 do -1.0 else 1.0 end
          let b2 = side *. math_sqrt(b *. b +. r *. r *. g)
          around(rest, p.peak_x +. a *. wx -. b2 *. wz, p.peak_z +. a *. wz +. b2 *. wx, y, half, wx, wz)
        end
    end
  end
  -- Clouds, after the real genera. Thirty-two bodies, each one cloud of a
  -- given type built once from a seed, at that type's height:
  --   0 cumulus humilis    fair-weather heaps, flat bases, wider than tall      low, 36-42 m
  --   1 cumulus mediocris  heaped two or three tiers                           low, 36-42 m
  --   2 cumulus congestus  tall cauliflower towers before showers              low, 34-40 m
  --   3 cumulonimbus       storm towers with a broad flat anvil, dark beneath  low, 32-36 m
  --   4 stratocumulus      broken layer of grey rolls with gaps                low, 44-52 m
  --   5 nimbostratus       thick dark rain layer, ragged scud beneath          low, 30-36 m
  -- Low clouds part round the mountains on their way (see `around`).
  --   6 altocumulus        mackerel sky: rows of small puffs                   middle, 98-108 m
  --   7 altostratus        thin grey veil                                     middle, 106-114 m
  --   8 cirrus             high wisps and streaks                             high, 128-140 m
  -- How many of each type the sky holds follows the drawn weather and, for
  -- the heaped clouds, the hour: cumulus build after mid-morning and melt
  -- in the evening. A cloud forming or clearing grows or shrinks in place.
  fn cloud_bodies() : Int do 32 end
  -- Above the ocean's slots: clouds, high terrain, rooftop electricity markers, upper gradient
  -- bands, and the ground and roof bands of the utility inspection.
  pfn power_marker_base() : Int do Ur.Ocean.slot_count() + cloud_bodies() + S.count() * 2 end
  pfn skin_high_slot(i : Int) : Int do power_marker_base() + S.count() + i end
  pfn utility_ground_slot(i : Int) : Int do power_marker_base() + S.count() * 2 + i end
  pfn utility_roof_slot(i : Int) : Int do power_marker_base() + S.count() * 3 + i end
  pfn utility_group_columns() : Int do (S.width() + 3) / 4 end
  pfn utility_group_count() : Int do utility_group_columns() * ((S.depth() + 3) / 4) end
  pfn utility_group_slot(group : Int) : Int do power_marker_base() + S.count() * 4 + group end
  pfn utility_waypoint_slot(i : Int) : Int do utility_group_slot(utility_group_count()) + i end
  pfn utility_waypoint_limit() : Int do 64 end
  pfn raised_slot(i : Int) : Int do utility_waypoint_slot(utility_waypoint_limit() + 1) + i end
  -- Strata's shadow handles have a smaller range than its mesh slots.
  pfn raised_shadow(i : Int) : Int do i * 4 + 3 end
  fn wildlife_base() : Int do raised_slot(S.count()) end
  pfn flood_gate_slot(i : Int) : Int do wildlife_base() + Ur.WildlifeRender.slots() + i end
  -- Each canal-to-sea edge takes two moving leaves.
  pfn arch_slot(i : Int) : Int do flood_gate_slot(4 * S.count()) + i end
  pfn crane_slot(i : Int, part : Int) : Int do arch_slot(S.count()) + i * 4 + part end
  pfn water_bus_slot(i : Int) : Int do crane_slot(S.count(), 0) + i end
  pfn volcano_base() : Int do water_bus_slot(S.count()) end
  fn chunk_slots() : Int do volcano_base() + Ur.VolcanoRender.slots() end
  fn volcano(c : Ur.Sim.City, lake : Option(Ur.CalderaLake.LavaLake), path : List(Ur.Volcano.LavaRun), time : Float, terrain_changed : Bool) : Unit do
    Ur.VolcanoRender.draw(volcano_base(), c, lake, path, time, terrain_changed)
  end
  -- a parcel's fifth and sixth layers of terrain (32 to 48 m), for the tallest mountains
  pfn high_slot(i : Int, layer : Int) : Int do Ur.Ocean.slot_count() + cloud_bodies() + i * 2 + layer - 4 end
  pfn cloud_slot(i : Int) : Int do Ur.Ocean.slot_count() + i end
  -- the type of body i, and which of its type it is (0 the first to form)
  pfn cloud_type(i : Int) : Int do
    if i < 7 do 0 else if i < 10 do 1 else if i < 12 do 2 else if i < 14 do 3 else if i < 20 do 4
    else if i < 25 do 5 else if i < 28 do 6 else if i < 29 do 7 else 8 end end end end end end end end
  end
  pfn type_first(t : Int) : Int do
    match t do
      0 -> 0
      1 -> 7
      2 -> 10
      3 -> 12
      4 -> 14
      5 -> 20
      6 -> 25
      7 -> 28
      _ -> 29
    end
  end
  pfn unit(v : Float) : Float do if v < 0.0 do 0.0 else if v > 1.0 do 1.0 else v end end end
  pfn smooth(a : Float, b : Float, v : Float) : Float do
    let t = unit((v -. a) /. (b -. a))
    t *. t *. (3.0 -. 2.0 *. t)
  end
  -- how much of the day's warmth is lifting cumulus: little before 9, most from noon to 5, gone by 9 at night
  pfn convection(hour : Float) : Float do 0.15 +. 0.85 *. smooth(8.0, 12.5, hour) *. (1.0 -. smooth(17.0, 21.0, hour)) end
  -- how many clouds of type t the sky holds, as a fraction (2.4: two whole and one forming)
  pfn type_amount(t : Int, sky : Strata.Weather.Sky, hour : Float) : Float do
    let o = sky.overcast
    let r = sky.rain
    let st = sky.storm
    let heat = convection(hour)
    let dry = 1.0 -. unit(2.0 *. r)
    match t do
      0 -> 6.5 *. heat *. dry *. (1.0 -. 0.45 *. o)
      1 -> 3.0 *. heat *. dry *. o
      2 -> 2.0 *. unit(r *. 1.5 -. 0.3) *. (0.6 +. 0.4 *. heat)
      3 -> 2.4 *. st
      4 -> 6.0 *. unit((o -. 0.3) /. 0.5) *. (1.0 -. 0.4 *. st)
      5 -> 5.0 *. unit((r -. 0.2) /. 0.5)
      6 -> 12.0 *. o *. (1.0 -. o) *. (1.0 -. r)
      7 -> unit((o -. 0.5) /. 0.3) *. (1.0 -. st)
      _ -> 3.0 *. (1.0 -. 0.8 *. o) *. (1.0 -. r)
    end
  end
  -- how far body i has formed, 0..1
  pfn presence(i : Int, sky : Strata.Weather.Sky, hour : Float) : Float do
    let t = cloud_type(i)
    unit(type_amount(t, sky, hour) -. int_to_float(i - type_first(t)))
  end
  -- a puff: centre and radii, in voxels of its body's 32-cubed grid
  type Puff = { px : Int, py : Int, pz : Int, rx : Int, ry : Int, rz : Int }
  pfn cloud_roll(body : Int, k : Int) : Int do Strata.Seed.cell(919, body, k, 0, 0) % 10000 end
  pfn roll_in(body : Int, k : Int, low : Int, high : Int) : Int do low + cloud_roll(body, k) % (high - low + 1) end
  pfn puff(px : Int, py : Int, pz : Int, rx : Int, ry : Int, rz : Int) : Puff do { px: px, py: py, pz: pz, rx: rx, ry: ry, rz: rz } end
  -- One tier: [n] round puffs scattered [sx] and [sz] voxels either side of
  -- the middle at about height [y], radii [low] to [high], squashed to [flat]
  -- quarters of their height. Heaped clouds are tiers on a flat base, the
  -- upper ones fewer and nearer the middle.
  pfn tier(b : Int, salt : Int, n : Int, sx : Int, sz : Int, y : Int, low : Int, high : Int, flat : Int, k : Int, acc : List(Puff)) : List(Puff) do
    if k >= n do acc else
      let r = roll_in(b, salt + k * 5, low, high)
      let ry = if r * flat / 4 < 1 do 1 else r * flat / 4 end
      let p = puff(16 + roll_in(b, salt + k * 5 + 1, 0 - sx, sx), y + roll_in(b, salt + k * 5 + 2, 0, 1), 16 + roll_in(b, salt + k * 5 + 3, 0 - sz, sz), r, ry, r)
      tier(b, salt, n, sx, sz, y, low, high, flat, k + 1, List.append(acc, Cons(p, Nil)))
    end
  end
  pfn tiers(b : Int, salt : Int, n : Int, sx : Int, sz : Int, y : Int, low : Int, high : Int, flat : Int) : List(Puff) do
    tier(b, salt, n, sx, sz, y, low, high, flat, 0, Nil)
  end
  -- altocumulus: small puffs in rows a few voxels apart, the rows a little wavy
  pfn mackerel(b : Int, k : Int, acc : List(Puff)) : List(Puff) do
    if k >= 30 do acc else
      let row = k / 6
      let x = 3 + (k % 6) * 5 + roll_in(b, 100 + k, -1, 1) + row % 2 * 2
      let z = 4 + row * 6 + roll_in(b, 140 + k, -1, 1)
      let keep = cloud_roll(b, 180 + k) % 10 < 8
      mackerel(b, k + 1, if keep do List.append(acc, Cons(puff(x, 2, z, roll_in(b, 220 + k, 2, 3), 1, 2), Nil)) else acc end)
    end
  end
  -- cirrus: long thin streaks across the wind, each with a hooked end
  pfn streaks(b : Int, k : Int, n : Int, acc : List(Puff)) : List(Puff) do
    if k >= n do acc else
      let z = 4 + k * 24 / n + roll_in(b, 100 + k, -1, 1)
      let x = 16 + roll_in(b, 120 + k, -4, 4)
      let len = roll_in(b, 140 + k, 9, 14)
      let streak = puff(x, 2 + k % 2, z, len, 1, 1)
      let hook = puff(x + len - 1, 3 + k % 2, z + 1, 2, 1, 2)
      streaks(b, k + 1, n, List.append(acc, Cons(streak, Cons(hook, Nil))))
    end
  end
  -- the base tier comes first: its puffs cast the shadows
  pfn cloud_puffs(b : Int) : List(Puff) do
    match cloud_type(b) do
      0 -> List.append(tiers(b, 100, roll_in(b, 10, 3, 5), 7, 5, 3, 3, 5, 3), tiers(b, 200, roll_in(b, 11, 1, 2), 3, 2, 5, 2, 3, 4))
      1 -> List.append(tiers(b, 100, roll_in(b, 10, 5, 7), 9, 7, 4, 4, 5, 4),
             List.append(tiers(b, 200, roll_in(b, 11, 3, 4), 5, 4, 8, 4, 5, 4), tiers(b, 300, roll_in(b, 12, 1, 2), 3, 2, 11, 3, 4, 4)))
      2 -> List.append(tiers(b, 100, 6, 8, 7, 5, 5, 5, 4),
             List.append(tiers(b, 200, 5, 7, 6, 9, 4, 5, 4),
               List.append(tiers(b, 300, 4, 5, 5, 14, 4, 5, 4),
                 List.append(tiers(b, 400, 3, 4, 3, 19, 4, 5, 4), tiers(b, 500, 2, 2, 2, 23, 3, 4, 4)))))
      3 -> List.append(tiers(b, 100, 8, 10, 9, 5, 5, 6, 4),
             List.append(tiers(b, 600, 10, 14, 11, 27, 4, 6, 1),
               List.append(tiers(b, 200, 6, 6, 5, 10, 5, 6, 4),
                 List.append(tiers(b, 300, 5, 5, 4, 15, 4, 5, 4), tiers(b, 400, 4, 4, 3, 21, 4, 5, 4)))))
      4 -> List.append(tiers(b, 100, 18, 14, 13, 3, 3, 5, 2), tiers(b, 200, 7, 12, 11, 5, 3, 4, 2))
      5 -> List.append(tiers(b, 100, 22, 14, 14, 5, 5, 7, 2), tiers(b, 200, 6, 13, 13, 2, 1, 2, 4))
      6 -> mackerel(b, 0, Nil)
      7 -> tiers(b, 100, 11, 12, 12, 2, 4, 7, 1)
      _ -> streaks(b, 0, roll_in(b, 10, 3, 5), Nil)
    end
  end
  -- how a type's faces are drawn: thin (0..15, how much light gets through) and dark (0..15)
  pfn type_thin(t : Int) : Int do if t == 6 do 4 else if t == 7 do 9 else if t == 8 do 14 else 0 end end end end
  pfn type_dark(t : Int) : Int do if t == 3 do 7 else if t == 4 do 3 else if t == 5 do 9 else if t == 7 do 2 else 0 end end end end end
  pfn in_puff(x : Int, y : Int, z : Int, p : Puff) : Bool do
    let dx = int_to_float(x - p.px) /. int_to_float(p.rx)
    let dy = int_to_float(y - p.py) /. int_to_float(p.ry)
    let dz = int_to_float(z - p.pz) /. int_to_float(p.rz)
    dx *. dx +. dy *. dy +. dz *. dz <= 1.0
  end
  -- mark puff p's voxels in the 32-cubed grid, nothing below the first layer
  pfn fill_puff(g : NativeU8Arr, p : Puff, k : Int) : NativeU8Arr do
    let w = 2 * p.rx + 1
    let h = 2 * p.ry + 1
    if k >= w * h * (2 * p.rz + 1) do g else
      let x = p.px - p.rx + k % w
      let y = p.py - p.ry + k / w % h
      let z = p.pz - p.rz + k / (w * h)
      let inside = x >= 0 && x < 32 && y >= 1 && y < 32 && z >= 0 && z < 32 && in_puff(x, y, z, p)
      fill_puff(if inside do NativeArray.set_u8(g, x + 32 * y + 1024 * z, 1) else g end, p, k + 1)
    end
  end
  pfn cloud_grid(puffs : List(Puff)) : NativeU8Arr do
    List.fold_left(puffs, NativeArray.make_u8(32768, 0), fn (g, p) -> fill_puff(g, p, 0))
  end
  pfn cloud_solid(g : NativeU8Arr, x : Int, y : Int, z : Int) : Bool do
    x >= 0 && x < 32 && y >= 0 && y < 32 && z >= 0 && z < 32 && NativeArray.get_u8(g, x + 32 * y + 1024 * z) != 0
  end
  -- A face carries how high up its cloud it is (0..255 of [top], the shade
  -- byte), how far out from the middle (the texture's low byte), and its
  -- type's thinness and darkness (the texture's high byte): Strata darkens
  -- the base, thins the outskirts and veils, and greys rain clouds.
  pfn cloud_face(m : Ur.SceneMesh.Mesh, x : Int, y : Int, z : Int, direction : Int, top : Int, look : Int) : Ur.SceneMesh.Mesh do
    let n = m.quads * 2
    let height = S.clamp(y * 255 / (if top < 1 do 1 else top end), 0, 255)
    let out = S.clamp(float_to_int(math_sqrt(int_to_float((x - 16) * (x - 16) + (z - 16) * (z - 16))) *. 16.0), 0, 255)
    let words = NativeArray.set_i32(m.words, n, Q.pack0(x, y, z, 1, 1, direction))
    { words: NativeArray.set_i32(words, n + 1, Q.pack1(out + 256 * look, height, 250)), quads: m.quads + 1 }
  end
  pfn cloud_mesh(g : NativeU8Arr, top : Int, look : Int, i : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if i == 32768 do m else
      let x = i % 32
      let y = i / 32 % 32
      let z = i / 1024
      if !cloud_solid(g, x, y, z) do cloud_mesh(g, top, look, i + 1, m) else
        let m = if cloud_solid(g, x, y + 1, z) do m else cloud_face(m, x, y, z, 0, top, look) end
        let m = if cloud_solid(g, x, y - 1, z) do m else cloud_face(m, x, y, z, 1, top, look) end
        let m = if cloud_solid(g, x + 1, y, z) do m else cloud_face(m, x, y, z, 2, top, look) end
        let m = if cloud_solid(g, x - 1, y, z) do m else cloud_face(m, x, y, z, 3, top, look) end
        let m = if cloud_solid(g, x, y, z + 1) do m else cloud_face(m, x, y, z, 4, top, look) end
        let m = if cloud_solid(g, x, y, z - 1) do m else cloud_face(m, x, y, z, 5, top, look) end
        cloud_mesh(g, top, look, i + 1, m)
      end
    end
  end
  pfn setup_clouds(i : Int) : Unit do
    if i == cloud_bodies() do () else
      let puffs = cloud_puffs(i)
      let t = cloud_type(i)
      let top = List.fold_left(puffs, 1, fn (h, p) -> if p.py + p.ry > h do p.py + p.ry else h end)
      let m = cloud_mesh(cloud_grid(puffs), if top > 31 do 31 else top end, type_thin(t) + 16 * type_dark(t), 0, { words: NativeArray.make_i32(65536, 0), quads: 0 })
      let slot = cloud_slot(i)
      if Vk.body_begin(slot) && Vk.chunk_part(2, m.words, m.quads) && Vk.chunk_commit() do
        Vk.chunk_show(slot, false)
        setup_clouds(i + 1)
      else Ur.AppError.stop("Cloud mesh upload failed") end
    end
  end
  -- a body's voxel size, by type: so a humilis is 30-40 m across, a nimbostratus layer 90 m
  pfn cloud_voxel(i : Int) : Float do
    let tenth = int_to_float(cloud_roll(i, 4) % 9) *. 0.1
    match cloud_type(i) do
      0 -> 1.0 +. tenth *. 0.3
      1 -> 1.3 +. tenth *. 0.3
      2 -> 1.6 +. tenth *. 0.3
      3 -> 2.0 +. tenth *. 0.3
      4 -> 2.1 +. tenth *. 0.5
      5 -> 2.8 +. tenth *. 0.6
      6 -> 1.6 +. tenth *. 0.4
      7 -> 3.0 +. tenth *. 0.2
      _ -> 1.8 +. tenth *. 0.2
    end
  end
  -- the height of a body's base: heaped clouds share about one condensation level
  pfn cloud_height(i : Int) : Float do
    int_to_float(match cloud_type(i) do
      0 | 1 -> roll_in(i, 7, 36, 42)
      2 -> roll_in(i, 7, 34, 40)
      3 -> roll_in(i, 7, 32, 36)
      4 -> roll_in(i, 7, 44, 52)
      5 -> roll_in(i, 7, 30, 36)
      6 -> roll_in(i, 7, 98, 108)
      7 -> roll_in(i, 7, 106, 114)
      _ -> roll_in(i, 7, 128, 140)
    end)
  end
  -- which way a body faces: layered and streaked clouds lie across the wind, the rest any way
  pfn cloud_heading(i : Int) : Float do
    let t = cloud_type(i)
    if t == 6 || t == 8 do 1.2 +. int_to_float(cloud_roll(i, 8) % 40) /. 100.0 else int_to_float(cloud_roll(i, 8)) /. 10000.0 *. 6.283 end
  end
  -- where the middle of body i's footprint is, over a 640 x 520 m field, drifting
  -- with the wind faster the higher it floats, wrapping round
  pfn cloud_middle(i : Int, offset : (Float, Float)) : (Float, Float) do
    let (drift_x, drift_z) = offset
    let pace = 0.6 +. cloud_height(i) /. 120.0
    -- heaped and high clouds gather in four loose groups; the layers spread over the whole sky
    let t = cloud_type(i)
    let layer = t == 4 || t == 5 || t == 7
    let group = i % 4
    let gx = if layer do 0.0 else int_to_float(Strata.Seed.cell(919, 100 + group, 1, 0, 0) % 640) end
    let gz = if layer do 0.0 else int_to_float(Strata.Seed.cell(919, 100 + group, 2, 0, 0) % 520) end
    let a = int_to_float(cloud_roll(i, 5)) /. 10000.0 *. 6.283
    let reach = int_to_float(roll_in(i, 6, 10, 150))
    let travel = (if layer do int_to_float(cloud_roll(i, 5) % 640) else gx +. Math.cos(a) *. reach *. 1.4 end) +. drift_x *. pace
    let across = (if layer do int_to_float(cloud_roll(i, 6) % 520) else gz +. Math.sin(a) *. reach *. 0.6 end) +. drift_z *. pace
    (travel -. 640.0 *. Math.floor(travel /. 640.0) -. 80.0, across -. 520.0 *. Math.floor(across /. 520.0) -. 80.0)
  end
  -- the first three puffs of a low cloud as shadow blobs, turned with the body
  pfn cloud_blobs(puffs : List(Puff), x : Float, y : Float, z : Float, voxel : Float, heading : Float, out : NativeF32Arr, n : Int, left : Int) : (NativeF32Arr, Int) do
    match puffs do
      Nil -> (out, n)
      Cons(p, rest) ->
        if n >= 64 || left <= 0 do (out, n) else
          let o = n * 4
          let lx = (int_to_float(p.px) +. 0.5) *. voxel
          let lz = (int_to_float(p.pz) +. 0.5) *. voxel
          let a = NativeArray.set_f32(out, o, x +. lx *. Math.cos(heading) +. lz *. Math.sin(heading))
          let b = NativeArray.set_f32(a, o + 1, y +. (int_to_float(p.py) +. 0.5) *. voxel)
          let c = NativeArray.set_f32(b, o + 2, z -. lx *. Math.sin(heading) +. lz *. Math.cos(heading))
          let d = NativeArray.set_f32(c, o + 3, int_to_float(if p.rx > p.rz do p.rx else p.rz end) *. 1.8 *. voxel)
          cloud_blobs(rest, x, y, z, voxel, heading, d, n + 1, left - 1)
        end
    end
  end
  -- where body i sits when the day's rain cells carry it: a cumulonimbus on
  -- each storm cell, nimbostratus across the heavier bands; None when it
  -- drifts as usual. Answers its centre and the voxel size that spans the cell.
  pfn cell_spot(i : Int, storms : List(Ur.Rain.Cell), bands : List(Ur.Rain.Cell), hour : Float) : Option((Float, Float, Float)) do
    let t = cloud_type(i)
    let j = i - type_first(t)
    if t == 3 && j < List.length(storms) do
      let cell = unwrap(List.nth_opt(storms, j))
      let (x, z) = Ur.Rain.centre(cell, hour)
      Some((x, z, S.fclamp(cell.radius *. 1.7 /. 32.0, 1.6, 2.4)))
    else if t == 5 && !List.is_empty(bands) do
      let k = List.length(bands)
      let cell = unwrap(List.nth_opt(bands, j % k))
      let (x, z) = Ur.Rain.centre(cell, hour)
      let side = int_to_float(j / k % 3 - 1) *. cell.radius *. 0.55
      let speed = math_sqrt(cell.vx *. cell.vx +. cell.vz *. cell.vz)
      let (px, pz) = if speed > 0.01 do (0.0 -. cell.vz /. speed, cell.vx /. speed) else (1.0, 0.0) end
      Some((x +. px *. side, z +. pz *. side, S.fclamp(cell.radius *. 0.9 /. 32.0, 2.6, 3.4)))
    else None end end
  end
  -- how much the air under (x, z) helps a heaped cloud form at [hour]: barely
  -- over sinking air or the cool sea, fully where the land lifts strongly; 1
  -- when there is no air today (a forced or uniform sky)
  pfn lift_help(air : Ur.Air.Air, x : Float, z : Float, hour : Float) : Float do
    if air.day < 0 || x < 0.0 || z < 0.0 || x >= 480.0 || z >= 352.0 do 1.0 else
      let area = float_to_int(z /. 32.0) * Ur.Air.areas_x() + float_to_int(x /. 32.0)
      let v = int_to_float(Ur.Air.lift_at(air, Ur.Air.snapshot_of(float_to_int(hour)), area))
      0.4 +. 1.2 *. unit(v /. 60.0)
    end
  end
  pfn place_clouds(sky : Strata.Weather.Sky, hour : Float, offset : (Float, Float), peaks : List(Peak), storms : List(Ur.Rain.Cell), bands : List(Ur.Rain.Cell), air : Ur.Air.Air, i : Int, out : NativeF32Arr, n : Int) : (NativeF32Arr, Int) do
    if i == cloud_bodies() do (out, n) else
      let slot = cloud_slot(i)
      let spot = cell_spot(i, storms, bands, hour)
      let (hx, hz) = cloud_middle(i, offset)
      let heaped = cloud_type(i) <= 2
      let formed = if Option.is_some(spot) do 1.0 else (if heaped do unit(presence(i, sky, hour) *. lift_help(air, hx, hz, hour)) else presence(i, sky, hour) end) end
      let show = formed > 0.04
      Vk.chunk_show(slot, show)
      if show do
        -- a forming cloud grows from a third of its size about its own middle
        let heading = cloud_heading(i)
        let y = cloud_height(i)
        let (voxel, mx, mz) = match spot do
          Some((sx, sz, size)) -> (size, sx, sz)
          None ->
            let voxel = cloud_voxel(i) *. (0.35 +. 0.65 *. formed)
            let (drift_x, drift_z) = cloud_middle(i, offset)
            let speed = math_sqrt(sky.wind_x *. sky.wind_x +. sky.wind_z *. sky.wind_z)
            let (mx, mz) = if speed < 0.1 do (drift_x, drift_z)
              else around(peaks, drift_x, drift_z, y +. 4.0 *. voxel, 12.0 *. voxel, sky.wind_x /. speed, sky.wind_z /. speed) end
            (voxel, mx, mz)
        end
        let half = 16.0 *. voxel
        let x = mx -. half *. (Math.cos(heading) +. Math.sin(heading))
        let z = mz -. half *. (Math.cos(heading) -. Math.sin(heading))
        Vk.slot_voxel(slot, voxel)
        Vk.slot_pose(slot, x, y, z, 0.0, Math.sin(heading *. 0.5), 0.0, Math.cos(heading *. 0.5))
        let (blobs, count) = if cloud_type(i) <= 5 do cloud_blobs(cloud_puffs(i), x, y, z, voxel, heading, out, n, 3) else (out, n) end
        place_clouds(sky, hour, offset, peaks, storms, bands, air, i + 1, blobs, count)
      else place_clouds(sky, hour, offset, peaks, storms, bands, air, i + 1, out, n) end
    end
  end
  -- Show and place the clouds for the weather drawn now and the time of day
  -- ([phase], the day's clock), parted round [peaks], and cast the low ones' shadows.
  -- ([local]: the city rains in cells, not a forced or uniform weather) and
  -- hand Strata the rain cells active now, so rain and wet streets follow them.
  fn clouds(w : Strata.Weather.Weather, phase : Float, offset : (Float, Float), peaks : List(Peak), c : Ur.Sim.City, local : Bool, ash : List(Ur.VolcanoSmoke.AshBlob), yaw : Float) : Unit do
    Ur.VolcanoRender.draw_ash(volcano_base(), ash, yaw, Math.atan2(148.0, 194.0))
    let hour = (phase -. Math.floor(phase /. S.day_seconds()) *. S.day_seconds()) *. 24.0 /. S.day_seconds()
    let active = if local do List.filter(S.day_cells(c), fn cell -> hour >= cell.start && hour <= cell.stop) else Nil end
    let storms = List.filter(active, fn cell -> cell.level >= 4)
    let bands = List.filter(active, fn cell -> cell.level == 3)
    let air = if local do c.air else Ur.Air.empty() end
    -- Reserve the first slots for ash so a low cloud bank cannot displace its shadows.
    let (blobs, count) = List.fold_left(ash, (NativeArray.make_f32(64 * 4, 0.0), 0), fn (state, puff) ->
      let (blobs, count) = state
      if count >= 64 do state else
        let at = count * 4
        let blobs = NativeArray.set_f32(blobs, at, puff.x)
        let blobs = NativeArray.set_f32(blobs, at + 1, puff.y)
        let blobs = NativeArray.set_f32(blobs, at + 2, puff.z)
        (NativeArray.set_f32(blobs, at + 3, puff.radius), count + 1)
      end)
    let (blobs, n) = place_clouds(Strata.Weather.now(w), hour, offset, peaks, storms, bands, air, 0, blobs, count)
    let cloud_darkness = Strata.Weather.shadow_darkness(w)
    let darkness = if count > 0 do Math.max_float(cloud_darkness, Ur.VolcanoSmoke.darkness()) else cloud_darkness end
    Vk.set_cloud_shadows(blobs, n, darkness)
    let (cells, count, baseline) = rain_cells_for(c, hour, active, local)
    Vk.set_rain_cells(cells, count, baseline)
  end
  doc "The rain cells active at [hour], packed as Strata.Ffi.Vk.set_rain_cells takes them (rain = level / 4; the ground stays wet up to three hours back along a cell's path), their count, and the rain falling everywhere; for a city not raining locally, none and -1, so Strata's single rain holds."
  fn rain_cells_for(c : Ur.Sim.City, hour : Float, active : List(Ur.Rain.Cell), local : Bool) : (NativeF32Arr, Int, Float) do
    if !local do (NativeArray.make_f32(8, 0.0), 0, -1.0) else
      let packed = List.fold_left(List.take(active, 8), (NativeArray.make_f32(64, 0.0), 0), fn (acc, cell) ->
        match acc do (a, k) ->
          let (x, z) = Ur.Rain.centre(cell, hour)
          let back = S.fclamp(hour -. cell.start, 0.0, 3.0)
          let o = k * 8
          let a = NativeArray.set_f32(NativeArray.set_f32(NativeArray.set_f32(a, o, x), o + 1, z), o + 2, cell.radius)
          let a = NativeArray.set_f32(NativeArray.set_f32(NativeArray.set_f32(a, o + 3, int_to_float(cell.level) /. 4.0), o + 4, 0.0 -. cell.vx *. back), o + 5, 0.0 -. cell.vz *. back)
          (a, k + 1)
        end)
      let (a, k) = packed
      (a, k, int_to_float(Ur.Rain.baseline(S.current_weather(c))) /. 4.0)
    end
  end
  fn setup() : Unit do
    if !Vk.set_light_box(29, 2) || !Vk.textures_create(16, material_count()) do Ur.AppError.stop("Could not allocate Strata materials and lighting") else () end
    let r = palette(0, Strata.Blocks.empty())
    if !Vk.textures_commit() || !Strata.Render.upload_blocks(r) do Ur.AppError.stop("Could not upload Strata materials") else () end
    sea(0)
    Ur.Lighting.apply(Ur.Lighting.defaults())
    Vk.set_sun(-0.64, 0.83, 0.42, 1.18, 1.08, 0.94)
    Vk.set_fog(270.0, 650.0)
    setup_clouds(0)
    Ur.VolcanoRender.setup_ash(volcano_base())
  end
  -- What the sky does in each kind of simulated weather (Ur.Sim.weather_name),
  -- with rain slanted by the regional wind (km/h to m/s). Storms gust harder.
  fn sky_for(c : Ur.Sim.City, kind : Int) : Strata.Weather.Sky do
    let wind = S.regional_wind(c)
    let gust = if kind >= 4 do 1.6 else if kind == 3 do 1.25 else 1.0 end end
    let speed = int_to_float(wind.speed) /. 3.6 *. gust
    let (overcast, rain, storm) = match kind do
      4 -> (1.0, 1.0, 0.85)
      3 -> (0.95, 0.72, 0.4)
      2 -> (0.82, 0.38, 0.0)
      1 -> (0.58, 0.0, 0.0)
      _ -> (0.06, 0.0, 0.0)
    end
    -- raining locally, the rain everywhere is the day's baseline; the storm cells add the rest where they are
    let rain = if S.uniform_rain(c) || kind != S.current_weather(c) do rain else
      (match Ur.Rain.baseline(kind) do
        3 -> 0.72
        2 -> 0.38
        _ -> 0.0
      end) end
    { overcast: overcast, rain: rain, storm: storm, wind_x: Math.cos(wind.heading) *. speed, wind_z: Math.sin(wind.heading) *. speed }
  end
  -- Drawn weather for a city: cloud gathers over a quarter of a game day,
  -- rain over an eighth, and soaked streets dry over most of a day (24 real
  -- seconds a day at 1x).
  fn new_weather(c : Ur.Sim.City, kind : Int) : Strata.Weather.Weather do
    Strata.Weather.paced(Strata.Weather.settled(if c.climate_seed == 0 do 705 else c.climate_seed end, sky_for(c, kind)), 6.0, 3.0, 40.0)
  end
  fn daylight(phase : Float, w : Strata.Weather.Weather) : Unit do
    let angle = phase /. S.day_seconds() *. 6.283185307 - 1.570796327
    let elevation = Math.sin(angle)
    let light = (elevation +. 0.04) *. 2.5
    let brightness = if light < 0.0 do 0.0 else if light > 1.0 do 1.0 else light end end
    let warmth = 1.0 -. elevation
    let (sun_x, sun_y, sun_z) = Ur.VolcanoSmoke.sun_direction(phase, S.day_seconds())
    let sun = brightness *. Strata.Weather.light(w)
    let (near, far) = Strata.Weather.fog(w, 270.0, 650.0)
    Vk.set_fog(near, far)
    Vk.set_sun(sun_x, sun_y, sun_z,
      1.18 *. sun, (1.08 -. 0.24 *. warmth) *. sun, (0.94 -. 0.43 *. warmth) *. sun)
    Strata.Weather.apply(w)
  end
  pfn heights(c : Ur.Sim.City, x : Int, z : Int, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 100 do a else
      heights(c, x, z, NativeArray.set_int(a, i, L.height(c, x + (i % 10 - 1) * 4, z + (i / 10 - 1) * 4)), i + 1)
    end
  end
  pfn wall(m : Ur.SceneMesh.Mesh, x : Int, z : Int, bottom : Int, top : Int, layer : Int, dir : Int, tex : Int) : Ur.SceneMesh.Mesh do
    let low = S.clamp(bottom - layer, 0, 32)
    let high = S.clamp(top - layer, 0, 32)
    if low >= high do m else face(m, x, low, z, 4, high - low, dir, tex) end
  end
  pfn terrain_wall(m : Ur.SceneMesh.Mesh, x : Int, z : Int, bottom : Int, top : Int, layer : Int,
    dir : Int, side : Int, deposit : Int) : Ur.SceneMesh.Mesh do
    if deposit == 0 do wall(m, x, z, bottom, top, layer, dir, side) else
      let seam = top - deposit
      let rock = wall(m, x, z, bottom, seam, layer, dir, side)
      wall(rock, x, z, Math.max_int(bottom, seam), top, layer, dir, Ur.VolcanoRender.crust_material())
    end
  end
  pfn surface(c : Ur.Sim.City, m : Ur.SceneMesh.Mesh, hs : NativeIntArr, wx : Int, wz : Int, volcanic : Bool, y : Int, i : Int) : Ur.SceneMesh.Mesh do
    if i >= 64 do m else
      let x = i % 8 * 4
      let z = i / 8 * 4
      let j = 11 + i % 8 + i / 8 * 10
      let h = NativeArray.get_int(hs, j)
      let depth = S.basalt_depth(c, wx + x, wz + z)
      let deposit = if depth > 0 && h == S.unbuilt_ground_height(c, wx + x + 2, wz + z + 2) do depth else 0 end
      let island = S.subsea_owned(c, S.index(wx / 32, wz / 32))
      let grain = int_mod_euclid((wx + x) / 8 * 13 + (wz + z) / 8 * 17 + h / 3, 11)
      let basalt = if grain < 2 do L.volcanic_rock_material() else if grain < 6 do 4 else Ur.VolcanoRender.crust_material() end end
      let west = NativeArray.get_int(hs, j - 1)
      let east = NativeArray.get_int(hs, j + 1)
      let north = NativeArray.get_int(hs, j - 10)
      let south = NativeArray.get_int(hs, j + 10)
      let cover = if volcanic do L.volcanic_cover(wx + x + 2, wz + z + 2, h, L.slope(h, west, east, north, south))
        else L.top_material(wx + x, wz + z, h) end
      let side = if island do basalt else if cover >= L.volcanic_ash_material() do cover
        else if volcanic && h >= 42 do 1 else L.side_material(h) end end end
      let top = if island do basalt else if deposit > 0 do Ur.VolcanoRender.crust_material() else cover end end
      let a = if h > y && h <= y + 32 do face(m, x, h - y - 1, z, 4, 4, 0, top) else m end
      let a = terrain_wall(a, x + 3, z, east, h, y, 2, side, deposit)
      let a = terrain_wall(a, x, z, west, h, y, 3, side, deposit)
      let a = terrain_wall(a, x, z + 3, south, h, y, 4, side, deposit)
      let a = terrain_wall(a, x, z, north, h, y, 5, side, deposit)
      surface(c, a, hs, wx, wz, volcanic, y, i + 1)
    end
  end
  pfn paint(a : NativeU8Arr, p : Ur.Architecture.Piece, y : Int, high : Int, x : Int, z : Int) : NativeU8Arr do
    if y >= high do a else
      let index = x + z * 32 + y * 1024
      let next = NativeArray.set_u8(a, index, p.material + 1)
      if x + 1 < p.x + p.w do paint(next, p, y, high, x + 1, z)
      else if z + 1 < p.z + p.d do paint(next, p, y, high, p.x, z + 1)
      else paint(next, p, y + 1, high, p.x, p.z) end end
    end
  end
  pfn terrain_light(a : NativeU8Arr, hs : NativeIntArr, y : Int, i : Int) : NativeU8Arr do
    if i >= 64 do a else
      let x = i % 8 * 4
      let z = i / 8 * 4
      let h = NativeArray.get_int(hs, 11 + i % 8 + i / 8 * 10)
      let high = S.clamp(h - y, 0, 32)
      let p = Ur.Architecture.piece(x, 0, z, 4, high, 4, L.side_material(h))
      terrain_light(paint(a, p, 0, high, x, z), hs, y, i + 1)
    end
  end
  -- [every]: each lit window and shopfront is a lamp (building light shadows on); else the first of each in the chunk stands for all.
  pfn pieces(m : Ur.SceneMesh.Mesh, a : NativeU8Arr, parts : List(Ur.Architecture.Piece), y : Int, window : Bool, shop : Bool, every : Bool) : (Ur.SceneMesh.Mesh, NativeU8Arr) do
    match parts do
      Nil -> (m, a)
      Cons(p, rest) ->
        let low = S.clamp(p.y - y, 0, 32)
        let high = S.clamp(p.y + p.h - y, 0, 32)
        if low >= high do pieces(m, a, rest, y, window, shop, every)
        else
          let emissive = p.material == 20 || p.material >= 26
          let volume_piece = if emissive do { p with material: 8 } else p end
          let a = paint(a, volume_piece, low, high, p.x, p.z)
          let m = box(m, p.x, low, p.z, p.w, high - low, p.d, p.material)
          let use_window = p.material == 26 && (every || !window)
          let use_shop = p.material == 27 && (every || !shop)
          -- Write the lamp after painting the rest of the building so overlapping trim cannot erase it.
          if use_window || use_shop || p.material == 28 do
            let (m, a) = pieces(m, a, rest, y, window || use_window, shop || use_shop, every)
            let index = p.x + p.w / 2 + (p.z + p.d / 2) * 32 + (low + (high - low) / 2) * 1024
            (m, NativeArray.set_u8(a, index, p.material + 1))
          else pieces(m, a, rest, y, window, shop, every) end
        end
    end
  end
  pfn occupied(parts : List(Ur.Architecture.Piece), y : Int) : Bool do
    match parts do
      Nil -> false
      Cons(p, rest) -> (p.y < y + 32 && p.y + p.h > y) || occupied(rest, y)
    end
  end
  pfn high_ground(a : NativeIntArr, i : Int, peak : Int) : Int do
    if i >= 64 do peak else
      let v = NativeArray.get_int(a, 11 + i % 8 + i / 8 * 10)
      high_ground(a, i + 1, if v > peak do v else peak end)
    end
  end
  type FloodProbe = { cells : NativeIntArr, low : Int, high : Int }
  pfn empty_flood() : FloodProbe do { cells: NativeArray.make_int(9, 0), low: 128, high: 0 } end
  pfn flood_probe(c : Ur.Sim.City, lot : Int, sample : (Int) -> Int, n : Int, probe : FloodProbe) : FloodProbe do
    if n >= 9 do probe else
      let x = lot % S.width() + n % 3 - 1
      let z = lot / S.width() + n / 3 - 1
      let peer = if x >= 0 && x < S.width() && z >= 0 && z < S.depth() do S.index(x, z) else -1 end
      let depth = if S.valid(peer) do sample(peer) else 0 end
      let h = S.get(c.heights, peer)
      let next = if depth <= 0 || h <= 0 do probe else
        let top = h + depth
        { cells: NativeArray.set_int(probe.cells, n, top * 32 + depth),
          low: if top < probe.low do top else probe.low end, high: if top > probe.high do top else probe.high end }
      end
      flood_probe(c, lot, sample, n + 1, next)
    end
  end
  pfn signed_depth(cell : Int) : Int do if cell == 0 do -4 else cell % 32 end end
  -- Blend between parcel centres, then clip the water against the rendered
  -- terrain. Dry neighbours pull the edge inward without creating square banks.
  pfn flood_at(probe : FloodProbe, x : Int, z : Int, ground : Int) : (Int, Int) do
    if probe.high <= ground || ground <= 0 do (0, 0) else
      let i = (x + 16) / 32 + (z + 16) / 32 * 3
      let u = (x + 16) % 32
      let v = (z + 16) % 32
      let a = NativeArray.get_int(probe.cells, i)
      let b = NativeArray.get_int(probe.cells, i + 1)
      let d = NativeArray.get_int(probe.cells, i + 3)
      let e = NativeArray.get_int(probe.cells, i + 4)
      let wa = (32 - u) * (32 - v)
      let wb = u * (32 - v)
      let wd = (32 - u) * v
      let we = u * v
      let wet = wa * signed_depth(a) + wb * signed_depth(b) + wd * signed_depth(d) + we * signed_depth(e)
      if wet <= 0 do (0, 0) else
        let weights = (if a > 0 do wa else 0 end) + (if b > 0 do wb else 0 end) +
          (if d > 0 do wd else 0 end) + (if e > 0 do we else 0 end)
        let level = (wa * (a / 32) + wb * (b / 32) + wd * (d / 32) + we * (e / 32)) / weights
        if level > ground do (level, S.clamp(wet / 1024, 1, 16)) else (0, 0) end
      end
    end
  end
  pfn canal_surface(mesh : Ur.SceneMesh.Mesh, x : Int, y : Int, z : Int) : Ur.SceneMesh.Mesh do
    let tex = canal_material()
    let at = mesh.quads * 2
    let words = NativeArray.set_i32(mesh.words, at, Q.with_drop(Q.pack0(x, y, z, 4, 4, 0), 6))
    { words: NativeArray.set_i32(words, at + 1, Q.pack1(tex, 255, tex + 1)), quads: mesh.quads + 1 }
  end
  pfn parcel_water(c : Ur.Sim.City, lot : Int, hs : NativeIntArr, probe : FloodProbe, channel : Bool, y : Int, i : Int, mesh : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if i >= 64 do mesh else
      let x = i % 8 * 4
      let z = i / 8 * 4
      let h = NativeArray.get_int(hs, 11 + i % 8 + i / 8 * 10)
      let wet = channel && S.canal_wet(c, lot, x + 2, z + 2)
      let canal_level = if wet do S.canal_level(c, lot) else -1 end
      let ground = if wet do Math.max_int(1, canal_level - S.canal_depth()) else h end
      let (flood_level, depth) = flood_at(probe, x + 2, z + 2, ground)
      let flooded = depth > 0 && flood_level >= canal_level
      let level = if flooded do flood_level else canal_level end
      let mesh = if level <= 0 || level < y || level >= y + 32 do mesh
      else if channel do canal_surface(mesh, x, level - y, z) else
        let concentration = S.clamp(depth * 4 + 15, 0, 63)
        let packed = concentration * (1 + 64 + 4096 + 262144)
        let w0 = Q.with_drop(Q.pack0(x, level - y, z, 4, 4, 0), 6)
        let n = mesh.quads * 2
        let words = NativeArray.set_i32(mesh.words, n, w0)
        { words: NativeArray.set_i32(words, n + 1, Q.pack1(packed % 65536, packed / 65536, 252)), quads: mesh.quads + 1 }
      end end
      parcel_water(c, lot, hs, probe, channel, y, i + 1, mesh)
    end
  end
  pfn upload(slot : Int, x : Int, y : Int, z : Int, m : Ur.SceneMesh.Mesh, water : Ur.SceneMesh.Mesh, light : NativeU8Arr) : Unit do
    if Vk.chunk_begin(slot, x, y, z, 0) && Vk.chunk_part(0, m.words, m.quads) &&
      (water.quads == 0 || Vk.chunk_part(2, water.words, water.quads)) && Vk.chunk_light(light, NativeArray.length_u8(light)) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Strata refused a world mesh upload") end
  end
  pfn layers(c : Ur.Sim.City, i : Int, x : Int, z : Int, hs : NativeIntArr, peak : Int, parts : List(Ur.Architecture.Piece), probe : FloodProbe, layer : Int) : Unit do
    if layer >= 6 do () else
      let y = layer * 32
      let slot = if layer < 4 do i * 4 + layer else high_slot(i, layer) end
      let flood = probe.high >= y && probe.low < y + 32
      let level = S.canal_level(c, i)
      let channel = S.canal_water(c, i) && level > 0 && level >= y && level < y + 32
      if peak > y || occupied(parts, y) || flood || channel do
        let m = surface(c, empty(), hs, x, z, S.volcanic_highland(c, i % S.width(), i / S.width()), y, 0)
        let a = terrain_light(NativeArray.make_u8(32768, 0), hs, y, 0)
        let (mesh, light) = pieces(m, a, parts, y, false, false, Vk.lamp_shadow(27))
        let water = if flood || channel do
          let water = { words: NativeArray.make_i32(128, 0), quads: 0 }
          parcel_water(c, i, hs, probe, S.canal_water(c, i), y, 0, water)
        else { mesh with quads: 0 } end
        upload(slot, x, y, z, mesh, water, light)
      else Vk.chunk_free(slot) end
      layers(c, i, x, z, hs, peak, parts, probe, layer + 1)
    end
  end
  -- The seabed: below sea level (voxel 0) under every water cell of the map
  -- and its ring, from Ur.Ocean's coast distance field. Two layers a padded
  -- parcel, y -32..-1 and -64..-33.
  pfn seabed_heights(f : Ur.Ocean.Field, x : Int, z : Int, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 100 do a else
      seabed_heights(f, x, z, NativeArray.set_int(a, i, Ur.Ocean.seabed(f, x + (i % 10 - 1) * 4 + 2, z + (i / 10 - 1) * 4 + 2)), i + 1)
    end
  end
  pfn seabed_material(h : Int) : Int do if h >= -10 do 16 else if h >= -30 do 1 else 4 end end end
  pfn seabed_kinds(f : Ur.Ocean.Field, x : Int, z : Int, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= 100 do a else
      seabed_kinds(f, x, z, NativeArray.set_int(a, i, Ur.Ocean.kind(f, x + (i % 10 - 1) * 4 + 2, z + (i / 10 - 1) * 4 + 2)), i + 1)
    end
  end
  -- A cell's floor: reef rock, pale sand, fresh basalt, or the substrate at that depth.
  pfn bed_material(f : Ur.Ocean.Field, h : Int, kind : Int, u : Int, v : Int) : Int do
    if kind == 1 || kind == 3 do 37 else if kind == 2 do 5
    else if kind == 5 do Ur.VolcanoRender.crust_material() else seabed_material(h) end end end
  end

  pfn floor_limit() : Int do -20 end
  pfn sea_h(hs : NativeIntArr, u : Int, v : Int) : Int do NativeArray.get_int(hs, 11 + u + v * 10) end
  -- A face run along x from cell u0 to u1 (exclusive) of row v.
  pfn sea_wall(m : Ur.SceneMesh.Mesh, u0 : Int, u1 : Int, v : Int, bottom : Int, top : Int, y : Int, dir : Int, material : Int) : Ur.SceneMesh.Mesh do
    let low = S.clamp(bottom - y, 0, 32)
    let high = S.clamp(top - y, 0, 32)
    if low >= high do m else face(m, u0 * 4, low, v * 4 + (if dir == 4 do 3 else 0 end), (u1 - u0) * 4, high - low, dir, material) end
  end
  -- What a cell offers to a run of tops (its height, or 1 when it draws none)
  -- and to a run of walls facing +z or -z (its height and its neighbour's).
  pfn top_key(hs : NativeIntArr, u : Int, v : Int, y : Int) : Int do
    let h = sea_h(hs, u, v)
    if h < 0 && h > floor_limit() && h > y && h <= y + 32 do h else 1 end
  end
  pfn wall_key(hs : NativeIntArr, u : Int, v : Int, dv : Int) : Int do
    let h = sea_h(hs, u, v)
    if h <= floor_limit() do 1000000 else h * 1000 + sea_h(hs, u, v + dv) end
  end
  pfn cell_material(f : Ur.Ocean.Field, hs : NativeIntArr, ks : NativeIntArr, u : Int, v : Int) : Int do
    bed_material(f, sea_h(hs, u, v), NativeArray.get_int(ks, 11 + u + v * 10), u, v)
  end
  pfn top_runs(m : Ur.SceneMesh.Mesh, f : Ur.Ocean.Field, hs : NativeIntArr, ks : NativeIntArr, y : Int, v : Int, u : Int, start : Int) : Ur.SceneMesh.Mesh do
    let key = if start < 8 do top_key(hs, start, v, y) else 1 end
    let mat = if start < 8 do cell_material(f, hs, ks, start, v) else 0 end
    if u < 8 && top_key(hs, u, v, y) == key && cell_material(f, hs, ks, u, v) == mat do top_runs(m, f, hs, ks, y, v, u + 1, start) else
      let m = if start < 8 && key != 1 do face(m, start * 4, key - y - 1, v * 4, (u - start) * 4, 4, 0, mat) else m end
      if u >= 8 do m else top_runs(m, f, hs, ks, y, v, u + 1, u) end
    end
  end
  pfn side_material(hs : NativeIntArr, ks : NativeIntArr, u : Int, v : Int) : Int do
    if NativeArray.get_int(ks, 11 + u + v * 10) == 5 do Ur.VolcanoRender.crust_material()
    else seabed_material(sea_h(hs, u, v)) end
  end
  pfn z_runs(m : Ur.SceneMesh.Mesh, hs : NativeIntArr, ks : NativeIntArr, y : Int, v : Int, dv : Int, dir : Int, u : Int, start : Int) : Ur.SceneMesh.Mesh do
    let key = if start < 8 do wall_key(hs, start, v, dv) else 1000000 end
    let mat = if start < 8 do side_material(hs, ks, start, v) else 0 end
    if u < 8 && wall_key(hs, u, v, dv) == key && side_material(hs, ks, u, v) == mat do z_runs(m, hs, ks, y, v, dv, dir, u + 1, start) else
      let m = if start < 8 && key != 1000000 do sea_wall(m, start, u, v, sea_h(hs, start, v + dv), sea_h(hs, start, v), y, dir, mat) else m end
      if u >= 8 do m else z_runs(m, hs, ks, y, v, dv, dir, u + 1, u) end
    end
  end
  pfn x_walls(m : Ur.SceneMesh.Mesh, hs : NativeIntArr, ks : NativeIntArr, y : Int, i : Int) : Ur.SceneMesh.Mesh do
    if i >= 64 do m else
      let x = i % 8 * 4
      let z = i / 8 * 4
      let j = 11 + i % 8 + i / 8 * 10
      let h = NativeArray.get_int(hs, j)
      let mat = side_material(hs, ks, i % 8, i / 8)
      let m = if h <= floor_limit() do m else
        wall(wall(m, x + 3, z, NativeArray.get_int(hs, j + 1), h, y, 2, mat), x, z, NativeArray.get_int(hs, j - 1), h, y, 3, mat)
      end
      x_walls(m, hs, ks, y, i + 1)
    end
  end
  pfn seabed_rows(m : Ur.SceneMesh.Mesh, f : Ur.Ocean.Field, hs : NativeIntArr, ks : NativeIntArr, y : Int, v : Int) : Ur.SceneMesh.Mesh do
    if v >= 8 do m else
      let m = top_runs(m, f, hs, ks, y, v, 0, 0)
      let m = z_runs(m, hs, ks, y, v, 1, 4, 0, 0)
      seabed_rows(z_runs(m, hs, ks, y, v, -1, 5, 0, 0), f, hs, ks, y, v + 1)
    end
  end
  -- The seabed in layer [y]: tops and +-z walls merged along each row, +-x walls a cell at a time.
  -- Nothing deeper than 5 m is drawn: the water there is nine-tenths opaque.
  pfn seabed(m : Ur.SceneMesh.Mesh, f : Ur.Ocean.Field, hs : NativeIntArr, ks : NativeIntArr, y : Int) : Ur.SceneMesh.Mesh do
    x_walls(seabed_rows(m, f, hs, ks, y, 0), hs, ks, y, 0)
  end
  -- Dry sand: a sand bar's crest a voxel or two above the sea, in the chunk over the seabed (y 0..31). Each dry cell is
  -- a column of pale sand from sea level to its height, walled where its neighbour is lower.
  pfn dry_h(hs : NativeIntArr, j : Int) : Int do S.clamp(NativeArray.get_int(hs, j), 0, 2) end
  pfn dry_sand(m : Ur.SceneMesh.Mesh, hs : NativeIntArr, i : Int) : Ur.SceneMesh.Mesh do
    if i >= 64 do m else
      let x = i % 8 * 4
      let z = i / 8 * 4
      let j = 11 + i % 8 + i / 8 * 10
      let h = dry_h(hs, j)
      let m = if h <= 0 do m else
        let m = face(m, x, h - 1, z, 4, 4, 0, 5)
        let m = wall(m, x + 3, z, dry_h(hs, j + 1), h, 0, 2, 5)
        let m = wall(m, x, z, dry_h(hs, j - 1), h, 0, 3, 5)
        let low_s = dry_h(hs, j + 10)
        let low_n = dry_h(hs, j - 10)
        let m = if low_s < h do face(m, x, low_s, z + 3, 4, h - low_s, 4, 5) else m end
        if low_n < h do face(m, x, low_n, z, 4, h - low_n, 5, 5) else m end
      end
      dry_sand(m, hs, i + 1)
    end
  end
  pfn any_water(hs : NativeIntArr, i : Int) : Bool do
    if i >= 64 do false else if NativeArray.get_int(hs, 11 + i % 8 + i / 8 * 10) < 0 do true else any_water(hs, i + 1) end end
  end
  pfn try_upload_ocean(slot : Int, x : Int, y : Int, z : Int, m : Ur.SceneMesh.Mesh, surface : Ur.SceneMesh.Mesh, light : NativeU8Arr) : Bool do
    if m.quads == 0 && surface.quads == 0 do
      Vk.chunk_free(slot)
      true
    else Vk.chunk_begin(slot, x, y, z, 0) && (m.quads == 0 || Vk.chunk_part(0, m.words, m.quads)) &&
      (surface.quads == 0 || Vk.chunk_part(2, surface.words, surface.quads)) &&
      -- a chunk of sea surface alone has no floor to shade or block light: it takes no light-volume page
      (m.quads == 0 || Vk.chunk_light(light, NativeArray.length_u8(light))) && Vk.chunk_commit() end
  end
  pfn upload_ocean(slot : Int, x : Int, y : Int, z : Int, m : Ur.SceneMesh.Mesh, surface : Ur.SceneMesh.Mesh, light : NativeU8Arr) : Unit do
    if try_upload_ocean(slot, x, y, z, m, surface, light) do () else Ur.AppError.stop("Strata refused a seabed mesh upload") end
  end
  -- The sea's surface over a padded parcel: ocean quads (Strata.Quad.ocean1)
  -- at sea level, the top of layer y -32. Each 8-voxel patch with water
  -- carries the depth at its corners; a parcel deep all over is one quad.
  pfn ocean_surface_quad(m : Ur.SceneMesh.Mesh, x : Int, z : Int, size : Int, water : Int, shelter : Int) : Ur.SceneMesh.Mesh do
    let n = m.quads * 2
    let w0 = Q.with_ocean_shelter(Q.pack0(x, 31, z, size, size, 0), shelter)
    let words = NativeArray.set_i32(m.words, n, w0)
    { words: NativeArray.set_i32(words, n + 1, water), quads: m.quads + 1 }
  end
  pfn inlet_corner(f : Ur.Ocean.Field, x : Int, z : Int, bit : Int) : Int do
    if Ur.Ocean.canal_shelter_corner(f, x, z) do bit else 0 end
  end
  pfn ocean_patch(m : Ur.SceneMesh.Mesh, f : Ur.Ocean.Field, x : Int, z : Int, u : Int, v : Int, canal : Bool) : Ur.SceneMesh.Mesh do
    let a = x + u
    let b = z + v
    let shelter = if canal do 15 else inlet_corner(f, a, b, 1) + inlet_corner(f, a + 8, b, 2) +
      inlet_corner(f, a, b + 8, 4) + inlet_corner(f, a + 8, b + 8, 8) end
    let water = Q.ocean1(Ur.Ocean.corner_depth(f, a, b), Ur.Ocean.corner_depth(f, a + 8, b),
      Ur.Ocean.corner_depth(f, a, b + 8), Ur.Ocean.corner_depth(f, a + 8, b + 8))
    ocean_surface_quad(m, u, v, 8, water, shelter)
  end
  pfn all_deep(f : Ur.Ocean.Field, x : Int, z : Int, i : Int) : Bool do
    if i >= 25 do true else
      let u = x + i % 5 * 8
      let v = z + i / 5 * 8
      Ur.Ocean.depth(f, u, v) == 63 && !Ur.Ocean.canal_shelter_corner(f, u, v) && all_deep(f, x, z, i + 1)
    end
  end
  pfn patches(m : Ur.SceneMesh.Mesh, f : Ur.Ocean.Field, x : Int, z : Int, i : Int, canal : Bool) : Ur.SceneMesh.Mesh do
    if i >= 16 do m else
      let u = i % 4 * 8
      let v = i / 4 * 8
      let wet = Ur.Ocean.depth(f, x + u + 2, z + v + 2) > 0 || Ur.Ocean.depth(f, x + u + 6, z + v + 2) > 0 ||
        Ur.Ocean.depth(f, x + u + 2, z + v + 6) > 0 || Ur.Ocean.depth(f, x + u + 6, z + v + 6) > 0
      let m = if wet do ocean_patch(m, f, x, z, u, v, canal) else m end
      patches(m, f, x, z, i + 1, canal)
    end
  end
  -- Use identical patch sizes and depth samples on both sides of a sea-level inlet.
  pfn sea_surface(f : Ur.Ocean.Field, x : Int, z : Int, canal : Bool) : Ur.SceneMesh.Mesh do
    if !canal && all_deep(f, x, z, 0) do ocean_surface_quad(empty(), 0, 0, 32, Q.ocean1(63, 63, 63, 63), 0)
    else patches(empty(), f, x, z, 0, canal) end
  end
  fn seabed_parcel(f : Ur.Ocean.Field, cell : Int) : Unit do
    let px = cell % Ur.Ocean.padded_width() - Ur.Ocean.ring()
    let pz = cell / Ur.Ocean.padded_width() - Ur.Ocean.ring()
    let x = px * 32
    let z = pz * 32
    let hs = seabed_heights(f, x, z, NativeArray.make_int(100, 0), 0)
    if !any_water(hs, 0) do
      Vk.chunk_free(Ur.Ocean.seabed_slot(cell, 0))
      Vk.chunk_free(Ur.Ocean.seabed_slot(cell, 1))
    else
      let ks = seabed_kinds(f, x, z, NativeArray.make_int(100, 0), 0)
      let bed = seabed(empty(), f, hs, ks, -32)
      let top = Ur.ReefRender.add(bed, f, x, z)
      let surface = sea_surface(f, x, z, Ur.Ocean.canal_parcel(f, cell))
      let light = terrain_light(NativeArray.make_u8(32768, 0), hs, -32, 0)
      -- corals are many small faces: where Strata has no room left for them, the reef is drawn bare rather than the game stopping
      if top.quads != bed.quads && !try_upload_ocean(Ur.Ocean.seabed_slot(cell, 0), x, -32, z, top, surface, light) do
        upload_ocean(Ur.Ocean.seabed_slot(cell, 0), x, -32, z, bed, surface, light)
      else if top.quads == bed.quads do upload_ocean(Ur.Ocean.seabed_slot(cell, 0), x, -32, z, bed, surface, light) else () end end
      -- below a layer of water the sea is too dark to see a floor, so the second slot holds the dry sand above it instead
      let sand = dry_sand(empty(), hs, 0)
      if sand.quads == 0 do Vk.chunk_free(Ur.Ocean.seabed_slot(cell, 1))
      else upload_ocean(Ur.Ocean.seabed_slot(cell, 1), x, 0, z, sand, { sand with quads: 0 }, terrain_light(NativeArray.make_u8(32768, 0), hs, 0, 0)) end
    end
  end
  pfn ocean_from(f : Ur.Ocean.Field, cell : Int) : Unit do
    if cell >= Ur.Ocean.ring_cells() do () else
      seabed_parcel(f, cell)
      ocean_from(f, cell + 1)
    end
  end
  doc "Draw the whole seabed and sea surface from field [f]."
  fn ocean_all(f : Ur.Ocean.Field) : Unit do ocean_from(f, 0) end
  pfn ocean_changed(a : Ur.Ocean.Field, b : Ur.Ocean.Field, cell : Int) : Unit do
    if cell >= Ur.Ocean.ring_cells() do () else
      if Ur.Ocean.parcel_changed(a, b, cell) do seabed_parcel(b, cell) else () end
      ocean_changed(a, b, cell + 1)
    end
  end
  doc "Keep the ocean in step with the coast, from the field [f] it was last drawn from: everything on a forced rebuild; after a structural change that turned any ground between land and water, the padded parcels whose water changed. Returns the field now drawn, and whether it was rebuilt."
  fn ocean(f : Ur.Ocean.Field, old : Ur.Sim.City, c : Ur.Sim.City, force : Bool, structural : Bool) : (Ur.Ocean.Field, Bool) do
    if force do
      let g = Ur.Ocean.field(c)
      ocean_all(g)
      (g, true)
    else if structural && Ur.Ocean.coast_touched(old, c) do
      let g = Ur.Ocean.field(c)
      ocean_changed(f, g, 0)
      (g, true)
    else (f, false) end end
  end
  pfn apply_cells(f : Ur.Ocean.Field, cells : List(Int)) : Unit do
    match cells do
      Nil -> ()
      Cons(cell, rest) ->
        seabed_parcel(f, cell)
        apply_cells(f, rest)
    end
  end
  doc "Draw a coast the ocean job rebuilt on a worker (Ur.Ocean.rebuild): only the padded parcels whose water changed. Main thread: it uploads chunks."
  fn ocean_apply(r : Ur.Ocean.Rebuild) : Unit do apply_cells(r.field, r.changed) end
  doc "Hand the sea state and the water's clock (seconds the city has run, at any speed) to Strata: the ocean's swells, foam and breakers follow them."
  fn sea_state(s : Ur.Sea.State, water_time : Float) : Unit do
    Vk.set_sea(s.wind_x, s.wind_z, s.height, s.whitecaps)
    -- the water's waves, foam and ripples run on this clock, which stands still while the city is paused
    Vk.set_time(water_time)
  end
  doc "Hand Strata the swell refracted round the coast (Ur.Sea.swell)."
  fn sea_field(f : Strata.Waves.Swell) : Unit do
    if Strata.Render.set_sea_field(f) do () else Ur.AppError.stop("Strata refused the sea's swell field") end
  end
  doc "Hand Strata the wave exposure of the map and its ring (Ur.Sea.exposure), one value a padded parcel of 8 m."
  fn sea_map(exposure : NativeF32Arr) : Unit do
    let corner = int_to_float(0 - Ur.Ocean.ring()) *. 8.0
    if Vk.set_sea_map(exposure, Ur.Ocean.padded_width(), Ur.Ocean.padded_depth(), corner, corner, 8.0) do ()
    else Ur.AppError.stop("Strata refused the sea map") end
  end
  -- One posed slab per parcel. The slot above the terrain is free on these low crossings.
  pfn deck_shadow(a : NativeU8Arr, length : Int, width : Int, i : Int) : NativeU8Arr do
    if i >= length * width * 4 do a else
      let y = i / length % 4
      let z = i / (length * 4)
      let solid = y < 2 || z == 0 || z == width - 1
      deck_shadow(if solid do NativeArray.set_u8(a, i, 5) else a end, length, width, i + 1)
    end
  end
  type RaisedDeck = { cells : Int, width : Int, scale : Float, x : Float, y : Float, z : Float,
    east : Bool, pitch : Float, span : Int, middle : Int }
  fn deck_point(d : RaisedDeck, along : Float, above : Float) : (Float, Float, Float) do
    let run = along *. Math.cos(d.pitch) -. above *. Math.sin(d.pitch)
    let rise = along *. Math.sin(d.pitch) +. above *. Math.cos(d.pitch)
    (d.x +. (if d.east do run else 0.0 end), d.y +. rise, d.z +. (if d.east do 0.0 else run end))
  end
  pfn hinge_deck(deck : RaisedDeck, side : Int, opening : Float) : RaisedDeck do
    if side == 0 || opening <= 0.0 do deck else
      let hinge = if side > 0 do 0.0 else int_to_float(deck.cells) *. deck.scale end
      let deck_top = 2.0 *. deck.scale
      let (x, y, z) = deck_point(deck, hinge, deck_top)
      let pitch = deck.pitch +. (int_to_float(side) *. S.drawbridge_angle() -. deck.pitch) *. opening
      let (dx, dy, dz) = deck_point({ deck with x: 0.0, y: 0.0, z: 0.0, pitch: pitch }, hinge, deck_top)
      { deck with x: x -. dx, y: y -. dy, z: z -. dz, pitch: pitch }
    end
  end
  fn bridge_deck(c : Ur.Sim.City, i : Int, opening : Float) : Option(RaisedDeck) do
    let a = S.grade_source(c, i)
    let b = S.grade_peer(c, a)
    if !S.grade_link(c, a, b) || S.grade_kind(c, a) != 1 do None else
      let first = Math.min_int(a, b)
      let last = Math.max_int(a, b)
      let east = first / S.width() == last / S.width()
      let span = S.span_distance(first, last) * 32
      let middle = S.span_distance(first, i) * 32
      let lo = S.clamp(middle - 16, 0, span)
      let hi = S.clamp(middle + 16, 0, span)
      if hi <= lo do None else
        let run = int_to_float(hi - lo)
        let begin = S.grade_surface(c, first, last, int_to_float(lo) /. int_to_float(span))
        let rise = S.grade_surface(c, first, last, int_to_float(hi) /. int_to_float(span)) -. begin
        let pitch = Math.atan2(rise, run)
        let length = Math.sqrt(run *. run +. rise *. rise)
        let cells = S.clamp(float_to_int(length +. 0.5), 1, 32)
        let scale = length /. int_to_float(cells)
        let width = S.clamp(float_to_int(18.0 /. scale +. 0.5), 9, 32)
        let offset = int_to_float(lo - middle + 16)
        let along = offset +. 2.0 *. scale *. Math.sin(pitch)
        let across = 16.0 -. int_to_float(width) *. scale *. 0.5
        let x = int_to_float(i % S.width() * 32) +. (if east do along else 32.0 -. across end)
        let z = int_to_float(i / S.width() * 32) +. (if east do across else along end)
        let y = begin +. 1.0 -. 2.0 *. scale *. Math.cos(pitch)
        let deck = { cells: cells, width: width, scale: scale, x: x, y: y, z: z,
          east: east, pitch: pitch, span: span, middle: middle }
        Some(hinge_deck(deck, S.drawbridge_leaf_side(c, i), opening))
      end
    end
  end
  pfn deck_rotation(deck : RaisedDeck) : (Float, Float, Float, Float) do
    let yaw = if deck.east do 0.0 else 0.0 -. 0.7853981634 end
    let sy = Math.sin(yaw)
    let cy = Math.cos(yaw)
    let sp = Math.sin(deck.pitch *. 0.5)
    let cp = Math.cos(deck.pitch *. 0.5)
    (sy *. sp, sy *. cp, cy *. sp, cy *. cp)
  end
  pfn pose_deck(slot : Int, deck : RaisedDeck) : Unit do
    let (qx, qy, qz, qw) = deck_rotation(deck)
    Vk.slot_pose(slot, deck.x *. 0.25, deck.y *. 0.25, deck.z *. 0.25, qx, qy, qz, qw)
  end
  pfn pose_raised_deck(i : Int, deck : RaisedDeck) : Unit do
    let (qx, qy, qz, qw) = deck_rotation(deck)
    pose_deck(raised_slot(i), deck)
    Vk.body_place(raised_shadow(i), deck.x *. 0.25, deck.y *. 0.25, deck.z *. 0.25, qx, qy, qz, qw)
  end
  pfn suspension_cables(m : Ur.SceneMesh.Mesh, deck : RaisedDeck, at : Int) : Ur.SceneMesh.Mesh do
    if at >= deck.cells do m else
      let w = S.clamp(deck.cells - at, 1, 8)
      let station = deck.middle - 16 + at + w / 2
      let quarter = deck.span / 4
      let high = if station < quarter do 4 + S.clamp(station, 0, quarter) * 22 / quarter
        else if station > deck.span - quarter do 4 + S.clamp(deck.span - station, 0, quarter) * 22 / quarter
        else
          let offset = int_abs(station - deck.span / 2)
          8 + 18 * offset * offset / (quarter * quarter)
        end end
      let m = box(box(m, at, high, 0, w, 2, 1, 19), at, high, deck.width - 1, w, 2, 1, 19)
      let m = if high > 4 do box(box(m, at, 4, 0, 1, high - 4, 1, 23), at, 4, deck.width - 1, 1, high - 4, 1, 23) else m end
      suspension_cables(m, deck, at + 8)
    end
  end
  pfn deck_mesh(deck : RaisedDeck, suspension : Bool) : Ur.SceneMesh.Mesh do
      let cells = deck.cells
      let width = deck.width
      let mesh = { words: NativeArray.make_i32(if suspension do 512 else 128 end, 0), quads: 0 }
      let centre = width / 2
      let mesh = box(mesh, 0, 0, 0, cells, 1, width, 4)
      let mesh = box(mesh, 0, 1, 0, cells, 1, centre, 4)
      let mesh = box(mesh, 0, 1, centre, cells, 1, 1, 16)
      let mesh = box(mesh, 0, 1, centre + 1, cells, 1, width - centre - 1, 4)
      let mesh = box(mesh, 0, 2, 0, cells, 2, 1, 17)
      let mesh = box(mesh, 0, 2, width - 1, cells, 2, 1, 17)
      if suspension do suspension_cables(mesh, deck, 0) else mesh end
  end
  pfn arch_deck(i : Int, x : Int, z : Int, deck : Ur.BridgeMesh.Arch) : Unit do
    -- Model IDs 0 and 1 are the whale. The renderer copies this scratch model on commit.
    let model = 2
    let mesh = deck.geometry
    let instance = NativeArray.set_i32(NativeArray.make_i32(2, 0), 0, Q.pack_instance0(0, 0, 0, model))
    if Vk.model_set(model, Strata.Model.floats(mesh), Strata.Model.count(mesh)) &&
      Vk.chunk_begin(arch_slot(i), x, deck.floor, z, 0) && Vk.chunk_part(3, instance, 1) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Arch deck upload failed") end
  end
  pfn overpass(c : Ur.Sim.City, i : Int) : Unit do
    match bridge_deck(c, i, S.bridge_opening(c, i)) do
      None -> ()
      Some(deck) ->
      let cells = deck.cells
      let width = deck.width
      let slot = raised_slot(i)
      let handle = raised_shadow(i)
      let mesh = deck_mesh(deck, S.bridge_style(c, S.grade_source(c, i)) == 2)
      let shadow = deck_shadow(NativeArray.make_u8(cells * width * 4, 0), cells, width, 0)
      if Vk.body_begin(slot) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() &&
        Vk.body_shape(handle, shadow, cells, 4, width) do
        Vk.slot_voxel(slot, deck.scale *. 0.25)
        Vk.body_voxel(handle, deck.scale *. 0.25)
        pose_raised_deck(i, deck)
      else Ur.AppError.stop("Overpass deck upload failed") end
    end
  end
  fn movable_bridges(previous : Ur.Sim.City, c : Ur.Sim.City) : Unit do
    if Map.is_empty(previous.lift_decks) && Map.is_empty(c.lift_decks) do () else
      let portals = List.append(Map.keys(c.lift_decks),
        List.filter(Map.keys(previous.lift_decks), fn portal -> Option.is_none(Map.get(c.lift_decks, portal, Map.int_cmp))))
      List.each(portals, fn portal ->
        if S.lift_amount(previous, portal) == S.lift_amount(c, portal) do () else
          let peer = S.grade_peer(c, portal)
          if S.lift_portal(c, portal, peer) < 0 do () else
            let distance = S.span_distance(portal, peer)
            let step = S.grade_step(portal, peer)
            let first = portal + step * ((distance - 1) / 2)
            List.each([first, first + step], fn lot ->
              match bridge_deck(c, lot, S.bridge_opening(c, lot)) do
                None -> ()
                Some(deck) -> pose_raised_deck(lot, deck)
              end)
          end
        end)
    end
  end
  type Signals = { before : NativeIntArr, after : NativeIntArr, before_tick : Int, after_tick : Int }
  pfn sign_parts(c : Ur.Sim.City, lot : Int, control : Int, tick : Int, arm : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if arm >= 4 || control == 0 do parts
    else if !S.junction_arm(c, lot, arm) do sign_parts(c, lot, control, tick, arm + 1, parts)
    else
      let (x, z) = Ur.Citizens.corner_for(arm, -1)
      let y = S.get(c.heights, lot) + 1
      let post = Ur.Architecture.piece(x, y, z, 1, if control == 2 do 13 else 8 end, 1, 4)
      let across = arm < 2
      let (w, d) = if across do (1, 3) else (3, 1) end
      let (x, z) = if across do (x, z - 1) else (x - 1, z) end
      let face_x = x + (if arm == 0 do -1 else if arm == 1 do 1 else 0 end end)
      let face_z = z + (if arm == 2 do -1 else if arm == 3 do 1 else 0 end end)
      let parts = if control == 1 do
        let rim = Ur.Architecture.piece(x, y + 6, z, w, 4, d, 8)
        let red = Ur.Architecture.piece(face_x, y + 7, face_z, w, 2, d, 6)
        Cons(red, Cons(rim, Cons(post, parts)))
      else
        let housing = Ur.Architecture.piece(x, y + 9, z, w, 6, d, 19)
        let green = S.signal_green(lot, arm, tick)
        let red = Ur.Architecture.piece(face_x, y + 13, face_z, w, 1, d, if green do 4 else 30 end)
        let go = Ur.Architecture.piece(face_x, y + 10, face_z, w, 1, d, if green do 20 else 4 end)
        Cons(go, Cons(red, Cons(housing, Cons(post, parts))))
      end
      sign_parts(c, lot, control, tick, arm + 1, parts)
    end end
  end
  pfn section_heights(c : Ur.Sim.City, x : Int, z : Int, h : NativeIntArr, i : Int, side : Int) : NativeIntArr do
    if i == 100 do h else
      let gx = x + (i % 10 - 1) * 4
      let gz = z + (i / 10 - 1) * 4
      let depth = if section_cut(c, int_div_euclid(gx, 32), int_div_euclid(gz, 32), side) do 0 else NativeArray.get_int(h, i) end
      section_heights(c, x, z, NativeArray.set_int(h, i, depth), i + 1, side)
    end
  end
  pfn section_ground(c : Ur.Sim.City, lot : Int, side : Int) : Bool do
    let x = lot % S.width()
    let z = lot / S.width()
    List.any([-1, 0, 1], fn dz -> List.any([-1, 0, 1], fn dx -> section_cut(c, x + dx, z + dz, side)))
  end
  pfn cross_strip(m : Ur.SceneMesh.Mesh, east : Bool, along : Int, across : Int, y : Int, w : Int, tex : Int) : Ur.SceneMesh.Mesh do
    if east do face(m, along, y, across, 4, w, 0, tex)
    else face(m, across, y, along, w, 4, 0, tex) end
  end
  pfn cross_wall(m : Ur.SceneMesh.Mesh, east : Bool, along : Int, across : Int, y : Int, h : Int, front : Bool, tex : Int) : Ur.SceneMesh.Mesh do
    if east do face(m, along, y, across, 4, h, if front do 4 else 5 end, tex)
    else face(m, across, y, along, 4, h, if front do 2 else 3 end, tex) end
  end
  pfn section_deck(c : Ur.Sim.City, lot : Int, first : Int, last : Int, strip : Int) : Int do
    let span = S.span_distance(first, last) * 32
    let offset = S.span_distance(first, lot) * 32 + strip * 4 - 14
    let t = int_to_float(S.clamp(offset, 0, span)) /. int_to_float(span)
    float_to_int(Math.floor(S.grade_surface(c, first, last, t)))
  end
  pfn section_band(decks : List(Int), east : Bool, portal : Bool, mountain : Bool, origin : Int, slot : Int, x : Int, z : Int) : Unit do
    let (_, m) = List.fold_left(decks, (0, { words: NativeArray.make_i32(256, 0), quads: 0 }), fn (state, depth) ->
      let (strip, m) = state
      if depth < origin || depth >= origin + 24 do (strip + 1, m) else
        let at = strip * 4
        let y = depth - origin
        let rib = !portal && (strip == 2 || strip == 6)
        let m = if mountain do cross_strip(cross_strip(m, east, at, 0, y, 6, 23), east, at, 26, y, 6, 23)
          else cross_strip(m, east, at, 0, y, 32, 23) end
        let pavement = if mountain do y else y + 1 end
        let edge = if mountain do 6 else 5 end
        let m = if strip % 3 == 0 do cross_strip(m, east, at, edge, pavement, 32 - edge * 2, 4)
          else
            let m = cross_strip(m, east, at, edge, pavement, 15 - edge, 4)
            let m = cross_strip(m, east, at, 15, pavement, 1, 8)
            cross_strip(m, east, at, 16, pavement, 16 - edge, 4)
          end
        let m = cross_strip(cross_strip(m, east, at, 5, pavement + 1, 1, 10), east, at, 26, pavement + 1, 1, 10)
        let m = cross_wall(cross_wall(m, east, at, 5, pavement + 1, 7, true, if rib do 24 else 19 end),
          east, at, 26, pavement + 1, 7, false, if rib do 24 else 19 end)
        let m = if rib do cross_strip(cross_strip(m, east, at, 6, y + 6, 2, 15), east, at, 24, y + 6, 2, 15) else m end
        (strip + 1, m)
      end)
    if m.quads == 0 do () else
      if Vk.chunk_begin(slot, x, origin, z, 0) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do ()
      else Ur.AppError.stop("Tunnel cutaway upload failed") end
    end
  end
  pfn section_tunnel(c : Ur.Sim.City, lot : Int, slot : Int, x : Int, z : Int) : Unit do
    let a = S.grade_source(c, lot)
    let b = S.grade_peer(c, a)
    let (first, last) = if a < b do (a, b) else (b, a) end
    let east = first / S.width() == last / S.width()
    let portal = lot == a || lot == b
    let mountain = S.mountain_tunnel(c, a, b)
    if portal && mountain do
      let deck = S.get(c.heights, lot)
      let m = List.fold_left(L.portal_street(c, lot, deck), empty(), fn (m, p) ->
        box(m, p.x, p.y - deck, p.z, p.w, p.h, p.d, p.material))
      if Vk.chunk_begin(slot, x, deck, z, 0) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do ()
      else Ur.AppError.stop("Tunnel cutaway approach upload failed") end
    else
      let decks = List.map(List.range(0, 8), fn strip -> section_deck(c, lot, first, last, strip))
      let origin = List.fold_left(decks, 120, fn (low, y) -> if y < low do y else low end)
      section_band(decks, east, portal, mountain, origin, slot, x, z)
      if List.any(decks, fn y -> y >= origin + 24) do section_band(decks, east, portal, mountain, origin + 24, slot + 1, x, z) else () end
    end
  end
  pfn parcel(c : Ur.Sim.City, i : Int, lighting : Int, control : Int, tick : Int, section : Int, clearings : List(Ur.Landscape.Clearing)) : Unit do
    let x = i % S.width() * 32
    let z = i / S.width() * 32
    let hs = heights(c, x, z, NativeArray.make_int(100, 0), 0)
    let cut = section_cut(c, i % S.width(), i / S.width(), section)
    let hs = if section > 0 do section_heights(c, x, z, hs, 0, section) else hs end
    let source = S.grade_source(c, i)
    let raised = S.grade_kind(c, source) == 1 && S.grade_link(c, source, S.grade_peer(c, source))
    let probe = if S.get(c.heights, i) > 0 && (c.flood_active || S.rain_here(c, i) == 4) do
      flood_probe(c, i, fn lot -> S.surface_flood(c, lot), 0, empty_flood())
    else empty_flood() end
    if cut do
      List.each([0, 1, 2, 3], fn layer -> Vk.chunk_free(i * 4 + layer))
      List.each([4, 5], fn layer -> Vk.chunk_free(high_slot(i, layer)))
      if tunnel_lot(c, i) do section_tunnel(c, i, i * 4, x, z)
      else
        let rock = face({ words: NativeArray.make_i32(2, 0), quads: 0 }, 0, 0, 0, 32, 32, 0, 13)
        if Vk.chunk_begin(i * 4, x, -34, z, 0) && Vk.chunk_part(0, rock.words, rock.quads) && Vk.chunk_commit() do ()
        else Ur.AppError.stop("Tunnel cutaway rock upload failed") end
      end
    else layers(c, i, x, z, hs, high_ground(hs, 0, 0), sign_parts(c, i, control, tick, 0, L.structures_cleared(c, i, lighting, clearings)), probe, 0) end
    match Ur.BridgeMesh.arch(c, i) do
      Some(deck) ->
        arch_deck(i, x, z, deck)
        Vk.body_drop(raised_shadow(i))
        Vk.chunk_free(raised_slot(i))
      None ->
        Vk.chunk_free(arch_slot(i))
        if raised do overpass(c, i) else
          Vk.body_drop(raised_shadow(i))
          Vk.chunk_free(raised_slot(i))
        end
    end
  end
  pfn changed(a : Ur.Sim.City, b : Ur.Sim.City, i : Int) : Bool do
    S.valid(i) && (S.get(a.road_shapes, i) != S.get(b.road_shapes, i) ||
      S.get(a.water_bus, i) != S.get(b.water_bus, i) || S.get(a.canals, i) != S.get(b.canals, i) || S.get(a.canal_docks, i) != S.get(b.canal_docks, i) ||
      (a.harbour_basin != b.harbour_basin && (i == a.harbour_basin || i == b.harbour_basin || i == a.harbour || i == b.harbour)) ||
      S.public_work_stage(a, i) != S.public_work_stage(b, i) || S.get(a.seawalls, i) != S.get(b.seawalls, i) || S.flood_repair_days(a, i) != S.flood_repair_days(b, i) || S.get(a.sidewalk_items, i) != S.get(b.sidewalk_items, i) || S.get(a.waste_bins, i) != S.get(b.waste_bins, i) || (a.harbour != b.harbour && (i == a.harbour || i == b.harbour)) || S.get(a.heights, i) != S.get(b.heights, i) || S.campus_root(a, i) != S.campus_root(b, i) || S.get(a.roads, i) != S.get(b.roads, i) || S.get(a.grade_cover, i) != S.get(b.grade_cover, i) || S.get(a.fire_recovery, i) != S.get(b.fire_recovery, i) || S.get(a.park_tiers, i) != S.get(b.park_tiers, i) || S.get(a.streetscape, i) != S.get(b.streetscape, i) || S.get(a.parks, i) != S.get(b.parks, i) || S.get(a.tolls, i) != S.get(b.tolls, i) || S.get(a.public_parking, i) != S.get(b.public_parking, i) ||
      S.get(a.transit, i) != S.get(b.transit, i) || S.get(a.stops, i) != S.get(b.stops, i) || S.get(a.ferries, i) != S.get(b.ferries, i) ||
      (Option.is_some(S.industry_at(b, i)) && S.production_running(a, i) != S.production_running(b, i)) ||
      S.get(a.business_sector, i) != S.get(b.business_sector, i) ||
      S.car_free_now(a, i) != S.car_free_now(b, i) || S.storefront(a, i) != S.storefront(b, i) || S.ground_at(a, i) != S.ground_at(b, i) || S.business_closed(a, i) != S.business_closed(b, i) || S.get(a.zones, i) != S.get(b.zones, i) || S.get(a.buildings, i) != S.get(b.buildings, i) || S.get(a.construction, i) != S.get(b.construction, i) || S.get(a.plants, i) != S.get(b.plants, i))
  end
  pfn corner_changed(a : Ur.Sim.City, b : Ur.Sim.City, i : Int, horizontal : Int, vertical : Int) : Bool do
    let j = S.neighbour(i, horizontal)
    if !S.valid(j) do false else
      let k = S.neighbour(j, vertical)
      S.valid(k) && S.get(a.heights, k) != S.get(b.heights, k)
    end
  end
  type Section = { before : Int, after : Int }
  type VolcanoLand = { before : Map(Int, List(Ur.Landscape.Clearing)), after : Map(Int, List(Ur.Landscape.Clearing)), terrain : Option(NativeIntArr) }
  type Lighting = { hour : Int, electric : Ur.Sim.UtilityDelivery }
  pfn lighting_on(c : Ur.Sim.City, i : Int, state : Lighting) : Int do
    let demand = S.get(state.electric.demand, i)
    let powered = if demand > 0 do S.get(state.electric.delivered, i) > 0
      else S.distance(state.electric.connections, i) >= 0 end
    L.lights_with_power(c, i, state.hour, powered)
  end
  pfn change_flags(old : Ur.Sim.City, c : Ur.Sim.City, i : Int, flags : NativeIntArr) : NativeIntArr do
    if i >= S.count() do flags else
      let set = changed(old, c, i) || S.get(old.grades, i) != S.get(c.grades, i)
      change_flags(old, c, i + 1, if set do NativeArray.set_int(flags, i, 1) else flags end)
    end
  end
  pfn flood_flags(old : Ur.Sim.City, c : Ur.Sim.City, i : Int, flags : NativeIntArr) : NativeIntArr do
    if i >= S.count() do flags else
      let set = S.surface_flood(old, i) != S.surface_flood(c, i)
      flood_flags(old, c, i + 1, if set do NativeArray.set_int(flags, i, 1) else flags end)
    end
  end
  -- Whether any lot within [r] lots of [lot] (a square, clipped to the map) is flagged.
  pfn flagged_near(flags : NativeIntArr, lot : Int, r : Int) : Bool do
    let x = lot % S.width()
    let z = lot / S.width()
    let x0 = if x - r < 0 do 0 else x - r end
    let x1 = if x + r >= S.width() do S.width() - 1 else x + r end
    let z0 = if z - r < 0 do 0 else z - r end
    let z1 = if z + r >= S.depth() do S.depth() - 1 else z + r end
    flagged_rows(flags, x0, x1, z0, z1)
  end
  pfn flagged_rows(flags : NativeIntArr, x0 : Int, x1 : Int, z : Int, z1 : Int) : Bool do
    z <= z1 && (flagged_row(flags, x0, x1, z) || flagged_rows(flags, x0, x1, z + 1, z1))
  end
  pfn flagged_row(flags : NativeIntArr, x : Int, x1 : Int, z : Int) : Bool do
    x <= x1 && (NativeArray.get_int(flags, S.index(x, z)) != 0 || flagged_row(flags, x + 1, x1, z))
  end
  pfn nearby_shape_changed(old : Ur.Sim.City, c : Ur.Sim.City, i : Int) : Bool do
    let x = i % S.width()
    let z = i / S.width()
    List.any([-1, 0, 1], fn dz -> List.any([-1, 0, 1], fn dx ->
      let tx = x + dx
      let tz = z + dz
      tx >= 0 && tx < S.width() && tz >= 0 && tz < S.depth() &&
        S.get(old.road_shapes, S.index(tx, tz)) != S.get(c.road_shapes, S.index(tx, tz))))
  end
  pfn arch_changed(old : Ur.Sim.City, c : Ur.Sim.City, i : Int) : Bool do
    let before = S.grade_source(old, i)
    let after = S.grade_source(c, i)
    let old_peer = S.grade_peer(old, before)
    let new_peer = S.grade_peer(c, after)
    let was_arch = S.canal_arch(old, before, old_peer)
    let is_arch = S.canal_arch(c, after, new_peer)
    was_arch != is_arch || (is_arch && (before != after || old_peer != new_peer ||
      S.get(old.heights, before) != S.get(c.heights, after) || S.get(old.heights, old_peer) != S.get(c.heights, new_peer) ||
      S.get(old.roads, before) != S.get(c.roads, after) || S.get(old.roads, old_peer) != S.get(c.roads, new_peer)))
  end
  pfn same_clearings(a : List(Ur.Landscape.Clearing), b : List(Ur.Landscape.Clearing)) : Bool do
    match (a, b) do
      (Nil, Nil) -> true
      (Cons(x, xs), Cons(y, ys)) ->
        x.x == y.x && x.z == y.z && x.w == y.w && x.d == y.d && same_clearings(xs, ys)
      _ -> false
    end
  end
  pfn basalt_flags(old : Ur.Sim.City, c : Ur.Sim.City, structural : Bool) : Option(NativeIntArr) do
    let cone_changed = old.subsea_vent != c.subsea_vent || S.subsea_peak(old) != S.subsea_peak(c)
    if !structural || (!cone_changed && Map.is_empty(old.basalt) && Map.is_empty(c.basalt)) do None else
      let cells = List.append(Map.keys(old.basalt), Map.keys(c.basalt))
      let flags = List.fold_left(cells, NativeArray.make_int(S.count(), 0), fn (flags, key) ->
        let a = Map.get_or(old.basalt, key, 0, Map.int_cmp)
        let b = Map.get_or(c.basalt, key, 0, Map.int_cmp)
        if a != b || (cone_changed && (S.subsea_owned(old, key / 64) || S.subsea_owned(c, key / 64))) do
          NativeArray.set_int(flags, key / 64, 1)
        else flags end)
      let submerged = List.append(Map.keys(old.subsea_depths), Map.keys(c.subsea_depths))
      let flags = if cone_changed do List.fold_left(submerged, flags, fn (flags, lot) ->
        NativeArray.set_int(flags, lot, 1)) else flags end
      Some(flags)
    end
  end
  pfn sync_parcels(old : Ur.Sim.City, c : Ur.Sim.City, i : Int, force : Bool, structural : Bool, water_changed : Bool, before : Lighting, after : Lighting, signals : Signals, section : Section,
    flags : NativeIntArr, floods : NativeIntArr, volcano : VolcanoLand) : Unit do
    if i >= S.count() do () else
      let now = lighting_on(c, i, after)
      let lighting_changed = now != lighting_on(old, i, before)
      let control = S.get(signals.after, i)
      let signal_changed = control != S.get(signals.before, i) ||
        (control == 2 && (S.signal_green(i, 0, signals.before_tick) != S.signal_green(i, 0, signals.after_tick) ||
                         S.signal_green(i, 2, signals.before_tick) != S.signal_green(i, 2, signals.after_tick)))
      let cut_changed = (section.before != section.after || structural) &&
        ((section.before > 0 && section_ground(old, i, section.before)) ||
         (section.after > 0 && section_ground(c, i, section.after)))
      -- flood_neighborhood_changed's 3x3 from the flood flags; the structural test only where a
      -- flagged lot lies within 2 (road_profile reads lots that far), and as before there.
      let clearings = Map.get_or(volcano.after, i, Nil, Map.int_cmp)
      let clearing_changed = !same_clearings(clearings, Map.get_or(volcano.before, i, Nil, Map.int_cmp))
      let basalt_changed = match volcano.terrain do
        Some(terrain) -> flagged_near(terrain, i, 1)
        None -> false
      end
      if force || cut_changed || clearing_changed || basalt_changed || lighting_changed || signal_changed || (water_changed && S.get(c.heights, i) > 0 && flagged_near(floods, i, 1)) ||
        (structural && arch_changed(old, c, i)) || (structural && flagged_near(flags, i, 2) && (changed(old, c, i) || nearby_shape_changed(old, c, i) || changed(old, c, S.neighbour(i, 0)) ||
        changed(old, c, S.neighbour(i, 1)) || changed(old, c, S.neighbour(i, 2)) ||
        changed(old, c, S.neighbour(i, 3)) || L.road_profile(old, i) != L.road_profile(c, i) || corner_changed(old, c, i, 0, 2) ||
        corner_changed(old, c, i, 0, 3) || corner_changed(old, c, i, 1, 2) || corner_changed(old, c, i, 1, 3))) do parcel(c, i, now, control, signals.after_tick, section.after, clearings) else () end
      sync_parcels(old, c, i + 1, force, structural, water_changed, before, after, signals, section, flags, floods, volcano)
    end
  end
  fn sync(old : Ur.Sim.City, c : Ur.Sim.City, i : Int, force : Bool, structural : Bool, old_hour : Int, hour : Int,
    signals : Signals, old_power : Ur.Sim.UtilityDelivery, new_power : Ur.Sim.UtilityDelivery, section : Section,
    before_volcano : List(Ur.Volcano.LavaRun), after_volcano : List(Ur.Volcano.LavaRun)) : Unit do
    let was_raining = S.severe_now(old)
    let raining = S.severe_now(c)
    -- a watch moves standing water, and a storm crossing the island moves its live flooding hour by hour
    let water_changed = was_raining != raining || old.watch != c.watch || (!S.uniform_rain(c) && old_hour != hour && (raining || was_raining)) ||
      (structural && (was_raining || raining || old.flood_active || c.flood_active))
    if section.before != section.after || (section.after > 0 && structural) do section_sea(c, section.after) else () end
    let flags = if structural do change_flags(old, c, 0, NativeArray.make_int(S.count(), 0)) else NativeArray.make_int(1, 0) end
    let floods = if water_changed do flood_flags(old, c, 0, NativeArray.make_int(S.count(), 0)) else NativeArray.make_int(1, 0) end
    let volcano = { before: Ur.Volcano.clearings(old, before_volcano), after: Ur.Volcano.clearings(c, after_volcano),
      terrain: basalt_flags(old, c, structural) }
    sync_parcels(old, c, i, force, structural, water_changed, { hour: old_hour, electric: old_power }, { hour: hour, electric: new_power }, signals, section, flags, floods, volcano)
  end
  pfn preview_tiles(c : Ur.Sim.City, tiles : List(Int), stride : Int, index : Int, used : Int, mesh : Ur.SceneMesh.Mesh) : Int do
    match tiles do
      Nil -> used
      Cons(i, rest) ->
        if index % stride != 0 do preview_tiles(c, rest, stride, index + 1, used, mesh) else
          let slot = preview_slot(used)
          let y = layer_floor(c, i % S.width() * 32, i / S.width() * 32) + 2
          if Vk.chunk_begin(slot, i % S.width() * 32, y, i / S.width() * 32, 0) &&
            Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do preview_tiles(c, rest, stride, index + 1, used + 1, mesh)
          else used end
        end
    end
  end
  fn clear_preview(i : Int, old_count : Int) : Unit do
    if i >= old_count do () else
      Vk.chunk_free(preview_slot(i))
      clear_preview(i + 1, old_count)
    end
  end
  fn preview(c : Ur.Sim.City, tiles : List(Int), old_count : Int, valid : Bool, utility : Bool) : Int do
    let material = if !valid do (if utility do 30 else 6 end) else if utility do 29 else 20 end end
    let edge = if utility do 2 else 1 end
    let m = box(empty(), 0, 0, 0, 32, 1, edge, material)
    let m = box(m, 0, 0, 32 - edge, 32, 1, edge, material)
    let m = box(m, 0, 0, edge, edge, 1, 32 - edge * 2, material)
    let m = box(m, 32 - edge, 0, edge, edge, 1, 32 - edge * 2, material)
    let count = List.length(tiles)
    let stride = if count > 72 do (count + 71) / 72 else 1 end
    let used = preview_tiles(c, tiles, stride, 0, 0, m)
    clear_preview(used, old_count)
    used
  end
  pfn road_outline(material : Int, margin : Int) : Ur.SceneMesh.Mesh do
    let far = 31 - margin
    let width = 32 - margin * 2
    let m = box({ words: NativeArray.make_i32(48, 0), quads: 0 }, margin, 1, margin, width, 1, 1, material)
    let m = box(m, margin, 1, far, width, 1, 1, material)
    let m = box(m, margin, 1, margin + 1, 1, 1, width - 2, material)
    box(m, far, 1, margin + 1, 1, 1, width - 2, material)
  end
  pfn road_marker_at(i : Int, y : Int, slot : Int, mesh : Ur.SceneMesh.Mesh) : Int do
    if !S.valid(i) || slot >= 72 do slot else
      let x = i % S.width() * 32
      let z = i / S.width() * 32
      if Vk.chunk_begin(preview_slot(slot), x, y, z, 0) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do slot + 1 else slot end
    end
  end
  pfn road_marker(c : Ur.Sim.City, i : Int, slot : Int, mesh : Ur.SceneMesh.Mesh) : Int do
    if !S.valid(i) do slot else
      road_marker_at(i, layer_floor(c, i % S.width() * 32, i / S.width() * 32) + 3, slot, mesh)
    end
  end
  pfn road_pin(c : Ur.Sim.City, p : Ur.Build.Point, slot : Int) : Int do
    match p.site do
      None -> road_marker(c, p.lot, slot, road_outline(10, 8))
      Some(at) ->
        let x = S.clamp(at.x % 32, 2, 29)
        let z = S.clamp(at.z % 32, 2, 29)
        let m = { words: NativeArray.make_i32(6, 0), quads: 0 }
        let m = face(m, x - 2, 2, z, 5, 1, 0, 10)
        let m = face(m, x, 2, z - 2, 1, 2, 0, 10)
        road_marker(c, p.lot, slot, face(m, x, 2, z + 1, 1, 2, 0, 10))
    end
  end
  pfn road_markers(c : Ur.Sim.City, tiles : List(Int), next : Int, stride : Int, offset : Int, mesh : Ur.SceneMesh.Mesh) : Int do
    match tiles do
      Nil -> next
      Cons(i, rest) ->
        if next >= 72 do next else
          let next = if offset % stride == 0 do road_marker(c, i, next, mesh) else next end
          road_markers(c, rest, next, stride, offset + 1, mesh)
        end
    end
  end
  pfn road_stroke(c : Ur.Sim.City, mask : NativeIntArr, i : Int, material : Int) : Ur.SceneMesh.Mesh do
    let mesh = face({ words: NativeArray.make_i32(10, 0), quads: 0 }, 12, 0, 12, 8, 8, 0, material)
    List.fold_left([0, 1, 2, 3], mesh, fn (m, arm) ->
      let j = S.neighbour(i, arm)
      if S.get(mask, j) == 0 && !S.street_link(c, i, arm) do m else
        match arm do
          0 -> face(m, 0, 0, 12, 12, 8, 0, material)
          1 -> face(m, 20, 0, 12, 12, 8, 0, material)
          2 -> face(m, 12, 0, 0, 8, 12, 0, material)
          _ -> face(m, 12, 0, 20, 8, 12, 0, material)
        end
      end)
  end
  pfn proposed_street(c : Ur.Sim.City, i : Int, material : Int) : Ur.SceneMesh.Mesh do
    let parts = L.portal_street(c, i, S.get(c.heights, i))
    let m = { words: NativeArray.make_i32(List.length(parts) * 2, 0), quads: 0 }
    List.fold_left(parts, m, fn (m, piece) ->
      if piece.h > 2 do m else face(m, piece.x, 0, piece.z, piece.w, piece.d, 0, material) end)
  end
  pfn road_strokes(c : Ur.Sim.City, p : Ur.Build.Preview, tiles : List(Int), mask : NativeIntArr, next : Int, stride : Int, offset : Int, material : Int) : Int do
    match tiles do
      Nil -> next
      Cons(i, rest) ->
        if next >= 72 do next else
          let next = if offset % stride != 0 do next else
            let mesh = if p.valid && S.get(p.city.roads, i) > 0 do proposed_street(p.city, i, material)
              else road_stroke(c, mask, i, material) end
            road_marker(c, i, next, mesh)
          end
          road_strokes(c, p, rest, mask, next, stride, offset + 1, material)
        end
    end
  end
  pfn bridge_markers(c : Ur.Sim.City, a : Int, b : Int, tiles : List(Int), slot : Int) : Int do
    let first = if a < b do a else b end
    let last = if a < b do b else a end
    let span = int_to_float(S.span_distance(first, last) * 32)
    let east = first / S.width() == last / S.width()
    List.fold_left(tiles, slot, fn (used, i) ->
      let middle = S.span_distance(first, i) * 32
      let lo = float_to_int(S.grade_surface(c, first, last, int_to_float(middle - 16) /. span))
      let hi = float_to_int(S.grade_surface(c, first, last, int_to_float(middle + 16) /. span))
      let floor = (if lo < hi do lo else hi end) + 2
      let mesh = List.fold_left(List.range(0, 8), { words: NativeArray.make_i32(16, 0), quads: 0 }, fn (mesh, strip) ->
        let t = int_to_float(middle - 14 + strip * 4) /. span
        let y = S.clamp(float_to_int(S.grade_surface(c, first, last, t)) + 2 - floor, 0, 31)
        if east do face(mesh, strip * 4, y, 7, 4, 18, 0, 20)
        else face(mesh, 7, y, strip * 4, 18, 4, 0, 20) end)
      road_marker_at(i, floor, used, mesh))
  end
  fn road_preview(c : Ur.Sim.City, p : Ur.Build.Preview, d : Ur.Build.Draft, tool : Int, old_count : Int) : Int do
    let pins = if !S.grade_tool(tool) && d.mode == Ur.Build.freeform_mode() do
      let first = Ur.Build.start_point(d)
      let last = Ur.Build.end_point(d)
      if first == last do [first] else [first, last] end
    else List.map(d.points, fn point -> point.lot) end
    let issues = List.filter([p.blocked, p.edge], fn i -> S.valid(i))
    let focused = List.append(pins, issues)
    let approach = S.grade_tool(tool)
    let tiles = List.filter(p.tiles, fn i -> i != p.blocked && i != p.edge &&
      (!approach || Ur.Build.point_index(d.points, i, 0) < 0))
    let first = Ur.Build.start_point(d)
    let last = if d.target >= 0 do d.target else Ur.Build.end_point(d) end
    let straight = S.valid(first) && S.valid(last) && (first / S.width() == last / S.width() || first % S.width() == last % S.width())
    let material = if tool == 52 do 31 else if p.valid do 20 else 30 end end
    let mesh = if approach && straight do
      if first / S.width() == last / S.width() do box(empty(), 0, 0, 14, 32, 1, 4, material)
      else box(empty(), 14, 0, 0, 4, 1, 32, material) end
    else road_outline(material, 2) end
    let points = List.filter(focused, fn i -> i != p.blocked && i != p.edge)
    let used = road_markers(c, issues, 0, 1, 0, road_outline(30, 5))
    let used = if !approach && Ur.Build.shaped_mode(d.mode) && d.mode != Ur.Build.freeform_mode() do
      List.fold_left(d.points, used, fn (slot, pin) -> if pin.lot == p.blocked || pin.lot == p.edge do slot else road_pin(c, pin, slot) end)
    else road_markers(c, points, used, 1, 0, road_outline(10, 8)) end
    let used = if S.valid(d.snapped) && (d.target >= 0 || d.drag >= 0) do
      road_marker(c, d.snapped, used, road_outline(18, 11))
    else used end
    let attachments = List.length(p.attachments)
    let used = if attachments > 0 do road_markers(c, p.attachments, used, (attachments + 11) / 12, 0, road_outline(15, 6)) else used end
    let count = List.length(tiles)
    let frontage = List.length(p.frontage)
    let alternate = Ur.Build.alternative(d)
    let alternate_count = List.length(alternate)
    let used = if alternate_count == 0 do used else road_markers(c, alternate, used, (alternate_count + 11) / 12, 0, road_outline(18, 10)) end
    let limit = S.clamp(72 - used - (if frontage > 0 do 12 else 0 end), 1, 72)
    let stride = S.clamp((count + limit - 1) / limit, 1, S.count())
    let used = if S.bridge_tool(tool) && p.valid && p.changed && straight do
      bridge_markers(p.city, first, last, List.filter(tiles, fn i -> i != first && i != last), used)
    else if approach do road_markers(c, tiles, used, stride, 0, mesh) else
      let mask = List.fold_left(p.tiles, NativeArray.make_int(S.count(), 0), fn (mask, i) -> NativeArray.set_int(mask, i, 1))
      road_strokes(c, p, tiles, mask, used, stride, 0, material)
    end end
    let available = S.clamp(72 - used, 1, 72)
    let used = road_markers(c, p.frontage, used, (frontage + available - 1) / available + (if frontage == 0 do 1 else 0 end), 0,
      box({ words: NativeArray.make_i32(12, 0), quads: 0 }, 12, 0, 12, 8, 1, 8, 11))
    clear_preview(used, old_count)
    used
  end
  pfn paired_trim(m : Ur.SceneMesh.Mesh, x : Int, y : Int, w : Int, h : Int, breadth : Int, tex : Int) : Ur.SceneMesh.Mesh do
    box(box(m, x, y, 0, w, h, 1, tex), x, y, breadth - 1, w, h, 1, tex)
  end
  pfn running_gear(m : Ur.SceneMesh.Mesh, length : Int, breadth : Int, wheel : Int) : Ur.SceneMesh.Mesh do
    let m = box(m, 0, 1, 1, length, 1, breadth - 2, 4)
    let m = paired_trim(m, 1, 0, wheel, 2, breadth, 4)
    paired_trim(m, length - wheel - 1, 0, wheel, 2, breadth, 4)
  end
  pfn tram_windows(m : Ur.SceneMesh.Mesh, x : Int, length : Int) : Ur.SceneMesh.Mesh do
    if x + 3 >= length do m else
      tram_windows(paired_trim(m, x, 4, 2, 2, 5, 9), x + 3, length)
    end
  end
  pfn hull_box(m : Ur.SceneMesh.Mesh, east : Bool, x : Int, y : Int, z : Int, w : Int, h : Int, d : Int, tex : Int) : Ur.SceneMesh.Mesh do
    if east do box(m, x, y, z, w, h, d, tex) else box(m, z, y, x, d, h, w, tex) end
  end
  pfn vessel_mesh(fishing : Bool, east : Bool) : Ur.SceneMesh.Mesh do
    let length = if fishing do 15 else 19 end
    let breadth = if fishing do 6 else 8 end
    let body = if fishing do { words: NativeArray.make_i32(576, 0), quads: 0 } else vehicle_body() end
    let m = hull_box(body, east, 1, 0, 1, length - 3, 1, breadth - 2, 19)
    let m = hull_box(m, east, 0, 1, 0, length - 3, 2, breadth, 7)
    let m = hull_box(m, east, length - 3, 1, 1, 2, 2, breadth - 2, 7)
    let m = hull_box(m, east, length - 1, 1, 2, 1, 2, breadth - 4, 7)
    let m = hull_box(m, east, 0, 3, 0, length - 3, 1, breadth, 8)
    let m = hull_box(m, east, length - 3, 3, 1, 2, 1, breadth - 2, 8)
    let m = hull_box(m, east, 1, 4, 0, 5, 1, 1, 17)
    let m = hull_box(m, east, 1, 4, breadth - 1, 5, 1, 1, 17)
    let cabin = if fishing do 5 else 6 end
    let span = if fishing do 5 else 9 end
    let m = hull_box(m, east, cabin, 4, 1, span, 1, breadth - 2, 8)
    let m = hull_box(m, east, cabin + 1, 5, 1, span - 2, 2, breadth - 2, 9)
    let m = hull_box(m, east, cabin + span - 1, 5, 2, 1, 2, breadth - 4, 12)
    let m = hull_box(m, east, cabin, 7, 1, span, 1, breadth - 2, 8)
    let m = hull_box(m, east, cabin + 1, 8, 2, 2, 1, 2, 19)
    if fishing do
      let m = hull_box(m, east, 2, 4, 2, 3, 1, 2, 10)
      let m = hull_box(m, east, 7, 8, 3, 1, 3, 1, 17)
      hull_box(m, east, 7, 10, 1, 1, 1, 2, 17)
    else
      let m = hull_box(m, east, 9, 5, 0, 1, 2, 1, 8)
      let m = hull_box(m, east, 9, 5, breadth - 1, 1, 2, 1, 8)
      hull_box(m, east, 2, 4, 2, 3, 1, breadth - 4, 13)
    end
  end
  pfn fishing_net(m : Ur.SceneMesh.Mesh, spread : Int) : Ur.SceneMesh.Mesh do
    if spread == 0 do m else
      let m = box(m, 2, 4, 4, 1, 2, 6, 17)
      let m = box(m, 2, 2, 9, 1, 2, spread, 8)
      let m = box(m, 0, 1, 9 + spread, 2 * spread + 1, 1, 1, 8)
      List.fold_left(List.range(0, spread + 1), m, fn (mesh, row) ->
        let mesh = box(box(mesh, row, 0, 9 + row, 1, 1, 1, 17), 2 * spread - row, 0, 9 + row, 1, 1, 1, 17)
        if row % 2 == 0 do box(mesh, row, 0, 9 + row, 2 * (spread - row) + 1, 1, 1, 17) else mesh end)
    end
  end
  pfn vehicle_mesh(mode : Int) : Ur.SceneMesh.Mesh do
    let tram = mode == 3
    let length = if tram do 16 else 10 end
    let colour = if tram do 6 else if mode == 2 do 10 else 7 end end
    let m = running_gear(vehicle_body(), length, 5, 2)
    let m = box(m, 0, 2, 0, length, 1, 5, colour)
    let m = box(m, 0, 3, 0, length, 1, 5, 8)
    let m = box(m, 1, 4, 1, length - 2, 2, 3, 19)
    let m = tram_windows(m, 1, length)
    let m = box(m, length - 1, 4, 1, 1, 2, 3, 9)
    let m = box(m, 0, 4, 1, 1, 2, 3, 9)
    let m = box(m, 0, 6, 0, length, 1, 5, 8)
    let m = box(m, 3, 7, 1, length - 6, 1, 3, 17)
    if tram do box(m, 7, 8, 2, 3, 1, 1, 19)
    else paired_trim(m, 7, 4, 2, 2, 5, 19) end
  end
  -- [blocks]: whether walkers yield to it. Only a vehicle in traffic does; a parked car is street furniture.
  pfn pose_vehicle(slot : Int, mesh : Ur.SceneMesh.Mesh, x : Float, y : Float, z : Float, dx : Float, dz : Float, length : Float, width : Float, lights : Bool, blocks : Bool) : Unit do
    let yaw = Math.atan2(0.0 -. dz, dx)
    let cosine = Math.cos(yaw)
    let sine = Math.sin(yaw)
    let low_x = x -. ((length *. cosine +. width *. sine) *. 0.5)
    let low_z = z -. ((width *. cosine -. length *. sine) *. 0.5)
    let front = length *. 0.5 +. 0.5
    let mesh = if lights && Vk.headlight(x +. front *. cosine, y +. 1.5, z -. front *. sine, cosine, 0.0 -. sine, 30) do
      let end_x = float_to_int(length)
      box(box(mesh, end_x, 1, 0, 1, 1, 1, 29), end_x, 1, float_to_int(width) - 1, 1, 1, 1, 29)
    else mesh end
    if Vk.body_begin(slot) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do
      Vk.slot_pose(slot, low_x *. 0.25, y *. 0.25, low_z *. 0.25, 0.0, Math.sin(yaw *. 0.5), 0.0, Math.cos(yaw *. 0.5))
      if blocks do Vk.footprint(slot, x, y, z, cosine, 0.0 -. sine, length, width) else () end
    else Ur.AppError.stop("Vehicle pose upload failed") end
  end
  pfn posed_vehicle(slot : Int, mesh : Ur.SceneMesh.Mesh, x : Float, y : Float, z : Float, dx : Float, dz : Float, length : Float, width : Float) : Unit do
    pose_vehicle(slot, mesh, x, y, z, dx, dz, length, width, true, true)
  end
  fn begin_vehicle_lights(hour : Int) : Unit do
    Vk.footprints_begin()
    Vk.moving_lights_begin(hour >= 18 || hour < 6)
  end
  -- Each half-leg follows the geometry of its own parcel. Adjacent poses
  -- share the road centre at the edge, including when one side is a curve.
  fn street_pose(c : Ur.Sim.City, a : Int, b : Int, t : Float, lane : Float) : (Float, Float, Float, Float) do
    let first = t < 0.5
    let portal = if first do a else b end
    let peer = if first do b else a end
    let curve = S.road_turn(c, portal)
    let (horizontal, _) = curve
    if horizontal >= 0 && S.grade_link(c, a, b) do
      let distance = (if first do t else 1.0 -. t end) *. int_to_float(S.span_distance(a, b))
      if distance < 0.5 do
        let edge = S.neighbour(portal, S.direction(portal, peer))
        if first do street_pose_turn(c, portal, edge, distance, lane, curve)
        else street_pose_turn(c, edge, portal, 1.0 -. distance, lane, curve) end
      else street_pose_turn(c, a, b, t, lane, (-1, -1)) end
    else street_pose_turn(c, a, b, t, lane, curve) end
  end
  pfn unit_direction(x : Float, z : Float, fx : Float, fz : Float) : (Float, Float) do
    let size = Math.sqrt(x *. x +. z *. z)
    if size < 0.001 do (fx, fz) else (x /. size, z /. size) end
  end
  pfn shaped_exit(s : Ur.RoadShape.StreetCurve, arm : Int) : Int do
    if Ur.RoadShape.on_arm(s.a, arm) do 0
    else if Ur.RoadShape.on_arm(s.b, arm) do 1 else -1 end end
  end
  pfn degenerate_shape(code : Int) : Bool do
    if code == 0 do false else
      let s = Ur.RoadShape.decode(code)
      s.a.x == s.b.x && s.a.z == s.b.z && s.a.x == s.control.x && s.a.z == s.control.z
    end
  end
  pfn outward_heading(code : Int, arm : Int) : (Float, Float) do
    let x = if arm == 0 do -1.0 else if arm == 1 do 1.0 else 0.0 end end
    let z = if arm == 2 do -1.0 else if arm == 3 do 1.0 else 0.0 end end
    if code == 0 do (x, z) else
      let s = Ur.RoadShape.decode(code)
      let end_at = shaped_exit(s, arm)
      if end_at < 0 do (x, z) else
        let (dx, dz) = Ur.RoadShape.tangent(s, int_to_float(end_at))
        let side = if end_at == 0 do -1.0 else 1.0 end
        unit_direction(dx *. side, dz *. side, x, z)
      end
    end
  end
  pfn shaped_half(c : Ur.Sim.City, lot : Int, peer : Int, at : Float, facing : Float, lane : Float) : (Float, Float, Float, Float) do
    let arm = S.direction(lot, peer)
    let (ex, ez) = L.street_edge(c, lot, arm)
    let code = S.get(c.road_shapes, lot)
    let (ox, oz) = outward_heading(code, arm)
    let other = S.get(c.road_shapes, peer)
    let (px, pz) = outward_heading(other, S.opposite(arm))
    let (jx, jz) = if degenerate_shape(code) do (0.0 -. px, 0.0 -. pz)
      else if degenerate_shape(other) do (ox, oz)
      else unit_direction(ox -. px, oz -. pz, ox, oz) end end
    let (x, z, dx, dz) = if code == 0 do
      let vx = int_to_float(ex - 16)
      let vz = int_to_float(ez - 16)
      (16.0 +. vx *. at, 16.0 +. vz *. at, vx, vz)
    else
      let s = Ur.RoadShape.decode(code)
      let end_at = shaped_exit(s, arm)
      if end_at < 0 do
        let (mx, mz) = Ur.RoadShape.sample(s, 0.5)
        let vx = int_to_float(ex) -. mx
        let vz = int_to_float(ez) -. mz
        (mx +. vx *. at, mz +. vz *. at, vx, vz)
      else
        let sign = if end_at == 0 do -1.0 else 1.0 end
        let t = 0.5 +. at *. sign *. 0.5
        let (x, z) = Ur.RoadShape.sample(s, t)
        let (dx, dz) = Ur.RoadShape.tangent(s, t)
        (x, z, dx *. sign, dz *. sign)
      end
    end
    let (ux, uz) = unit_direction(dx, dz, jx, jz)
    let blend = at *. at *. at
    let (vx, vz) = unit_direction(ux +. (jx -. ux) *. blend, uz +. (jz -. uz) *. blend, jx, jz)
    let dx = vx *. facing
    let dz = vz *. facing
    (int_to_float(lot % S.width() * 32) +. x -. dz *. lane,
     int_to_float(lot / S.width() * 32) +. z +. dx *. lane, dx, dz)
  end
  pfn street_pose_turn(c : Ur.Sim.City, a : Int, b : Int, t : Float, lane : Float, curve : (Int, Int)) : (Float, Float, Float, Float) do
    let first = t < 0.5
    let plot = if first do a else b end
    let other = if first do b else a end
    let (horizontal, vertical) = curve
    let outward = S.direction(plot, other)
    if S.span_distance(a, b) == 1 && (S.get(c.road_shapes, a) > 0 || S.get(c.road_shapes, b) > 0) do
      shaped_half(c, plot, other, if first do t *. 2.0 else (1.0 -. t) *. 2.0 end, if first do 1.0 else -1.0 end, lane)
    else if !S.grade_link(c, a, b) && horizontal >= 0 && (outward == horizontal || outward == vertical) do
      let sample = if first do t *. 2.0 else (1.0 -. t) *. 2.0 end
      let sign = if outward == horizontal do 1.0 else -1.0 end
      let theta = 0.7853981634 *. (1.0 +. sign *. sample)
      let sx = if horizontal == 0 do 1.0 else -1.0 end
      let sz = if vertical == 2 do 1.0 else -1.0 end
      let turn = if first do sign else 0.0 -. sign end
      let dx = 0.0 -. sx *. Math.sin(theta) *. turn
      let dz = sz *. Math.cos(theta) *. turn
      let x = int_to_float(plot % S.width() * 32 + (if horizontal == 0 do 0 else 32 end)) +. 16.0 *. sx *. Math.cos(theta)
      let z = int_to_float(plot / S.width() * 32 + (if vertical == 2 do 0 else 32 end)) +. 16.0 *. sz *. Math.sin(theta)
      (x -. dz *. lane, z +. dx *. lane, dx, dz)
    else
      let dx = int_to_float(b % S.width() - a % S.width())
      let dz = int_to_float(b / S.width() - a / S.width())
      let x = int_to_float(a % S.width() * 32 + 16) +. dx *. t *. 32.0
      let z = int_to_float(a / S.width() * 32 + 16) +. dz *. t *. 32.0
      let n = if S.grade_link(c, a, b) do int_to_float(S.span_distance(a, b)) else 1.0 end
      (x -. dz /. n *. lane, z +. dx /. n *. lane, dx /. n, dz /. n)
    end end
  end
  pfn vessel_progress(c : Ur.Sim.City, i : Int, phase : Float, fallback : Float) : Float do
    if !S.freight_port(c, i) do fallback else match c.freight do
      None -> fallback
      Some(route) ->
        let progress = match route.voyage do
          None -> 0.0
          Some(ship) ->
            let day = if route.suspended || ship.left == 0 do 0.0 else phase /. S.day_seconds() end
            (int_to_float(2 - ship.left) +. day) *. 0.5
        end
        if i == route.island do progress else 1.0 -. progress end
    end end
  end
  pfn lift_vessel(c : Ur.Sim.City, source : Int) : (Float, Bool) do
    match Map.get(c.lift_vessels, source, Map.int_cmp) do
      Some(phase) -> S.vessel_position(phase)
      None -> (0.0, true)
    end
  end
  -- Where ferry [i]'s boat is: its mesh's low corner in voxels and whether it runs along x, or None when [i] is not the lower end of a crossing.
  pfn ferry_spot(c : Ur.Sim.City, i : Int, time : Float, clock : Float) : Option((Int, Int, Bool)) do
    let peer = S.get(c.ferries, i) - 1
    if !S.valid(peer) || peer <= i || S.get(c.canal_docks, i) > 0 do None else
      let passage = S.crossing_navigation(c, i, peer, S.ferry_air_draft(c, i))
      if passage == -2 do None else
      let phase = time *. 0.25 +. int_to_float(i % 11) *. 0.17
      let fraction = phase -. Math.floor(phase)
      let sweep = if fraction < 0.5 do fraction *. 2.0 else (1.0 -. fraction) *. 2.0 end
      let (position, _) = lift_vessel(c, i)
      let t = if passage >= 0 do position else vessel_progress(c, i, clock, sweep) end
      let x0 = i % S.width()
      let z0 = i / S.width()
      let x1 = peer % S.width()
      let z1 = peer / S.width()
      let x = x0 * 32 + 9 + float_to_int(int_to_float((x1 - x0) * 32) *. t)
      let z = z0 * 32 + 9 + float_to_int(int_to_float((z1 - z0) * 32) *. t)
      Some((x, z, int_abs(x1 - x0) >= int_abs(z1 - z0)))
    end end
  end
  type FloodGate = { slot : Int, lot : Int, side : Int, bottom : Int, height : Int,
    closed : Bool, from : Float, since : Float, moving : Bool }

  fn flood_gate_hinge(side : Int, leaf : Int, opening : Float) : (Float, Float, Float) do
    let x = if leaf == 0 do 8.0 else 24.0 end
    let pi = 3.141592653589793
    let swing = opening *. pi *. 0.5
    let yaw = if leaf == 0 do swing else pi -. swing end
    match side do
      0 -> (0.0, x, yaw -. pi *. 0.5)
      1 -> (32.0, 32.0 -. x, yaw +. pi *. 0.5)
      2 -> (32.0 -. x, 0.0, yaw +. pi)
      _ -> (x, 32.0, yaw)
    end
  end

  pfn gate_target(closed : Bool) : Float do if closed do 0.0 else 1.0 end end
  pfn gate_time() : Float do 0.45 end
  fn flood_gate_opening(gate : FloodGate, time : Float) : Float do
    if !gate.moving do gate_target(gate.closed) else
      let t = Math.max_float(0.0, Math.min_float(1.0, (time -. gate.since) /. gate_time()))
      let ease = t *. t *. (3.0 -. 2.0 *. t)
      gate.from +. (gate_target(gate.closed) -. gate.from) *. ease
    end
  end

  pfn pose_flood_gate(gate : FloodGate, time : Float) : Unit do
    let opening = flood_gate_opening(gate, time)
    List.each([0, 1], fn leaf ->
      let (u, v, yaw) = flood_gate_hinge(gate.side, leaf, opening)
      let x = int_to_float(gate.lot % S.width() * 32) +. u -. Math.sin(yaw) *. 0.5
      let z = int_to_float(gate.lot / S.width() * 32) +. v -. Math.cos(yaw) *. 0.5
      let angle = yaw *. 0.5
      Vk.slot_pose(flood_gate_slot(gate.slot + leaf), x *. 0.25, int_to_float(gate.bottom) *. 0.25, z *. 0.25,
        0.0, Math.sin(angle), 0.0, Math.cos(angle)))
  end

  pfn upload_flood_gate(gate : FloodGate) : Unit do
    let mesh = box(empty(), 0, 0, 0, 8, gate.height - 1, 1, 19)
    let mesh = box(mesh, 0, gate.height - 1, 0, 8, 1, 1, 10)
    List.each([0, 1], fn leaf ->
      let slot = flood_gate_slot(gate.slot + leaf)
      if Vk.body_begin(slot) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
      else Ur.AppError.stop("Flood gate leaf upload failed") end)
  end

  pfn gate_sites(c : Ur.Sim.City, lot : Int, sites : List((Int, Int))) : List((Int, Int)) do
    if lot < 0 do sites else
      let sites = if S.automatic_canal_gate(c, lot) do
        List.fold_left([3, 2, 1, 0], sites, fn (out, side) ->
          if S.canal_outlet(c, lot, side) do Cons((lot, side), out) else out end)
        else sites end
      gate_sites(c, lot - 1, sites)
    end
  end

  pfn gate_key(lot : Int, side : Int) : Int do lot * 4 + side end
  pfn refresh_gates(c : Ur.Sim.City, sites : List((Int, Int)), previous : Map(Int, FloodGate), time : Float, slot : Int) : List(FloodGate) do
    match sites do
      Nil -> Nil
      Cons((lot, side), rest) ->
        let closed = S.canal_gate_closed(c, lot)
        let water = S.canal_level(c, lot)
        let bottom = water - S.canal_depth()
        let height = Math.max_int(water + 17, S.canal_bank_height(c, lot) + 3) - bottom
        let old = Map.get(previous, gate_key(lot, side), Map.int_cmp)
        let gate = match old do
          Some(gate) ->
            let gate = if gate.closed == closed do gate
              else { gate with from: flood_gate_opening(gate, time), since: time, moving: true, closed: closed } end
            { gate with slot: slot, bottom: bottom, height: height }
          None -> { lot: lot, side: side, slot: slot, bottom: bottom, height: height,
            closed: closed, from: gate_target(closed), since: time, moving: false }
        end
        let needs_mesh = match old do
          Some(gate) -> gate.slot != slot || gate.height != height
          None -> true
        end
        if needs_mesh do upload_flood_gate(gate) else () end
        pose_flood_gate(gate, time)
        Cons(gate, refresh_gates(c, rest, previous, time, slot + 2))
    end
  end

  fn clear_flood_gates(gates : List(FloodGate)) : Unit do
    List.each(gates, fn gate ->
      Vk.chunk_free(flood_gate_slot(gate.slot))
      Vk.chunk_free(flood_gate_slot(gate.slot + 1)))
  end

  fn flood_gates(c : Ur.Sim.City, previous : List(FloodGate), time : Float, refresh : Bool) : List(FloodGate) do
    let gates = if refresh do
      let previous_by_site = List.fold_left(previous, Map.empty(), fn (out, gate) ->
        Map.insert(out, gate_key(gate.lot, gate.side), gate, Map.int_cmp))
      let next = refresh_gates(c, gate_sites(c, S.count() - 1, Nil), previous_by_site, time, 0)
      clear_flood_gates(List.drop(previous, List.length(next)))
      next
    else previous end
    List.map(gates, fn gate ->
      if gate.moving do
        pose_flood_gate(gate, time)
        { gate with moving: time -. gate.since < gate_time() }
      else gate end)
  end

  -- A ferry is a body, posed every frame on the swell (float_ferries); a refresh uploads its mesh and sets it level.
  pfn canal_boat_mesh(taxi : Bool) : Ur.SceneMesh.Mesh do
    if taxi do vessel_mesh(true, true) else
      let m = box(vehicle_body(), 1, 0, 1, 17, 1, 6, 19)
      let m = box(m, 0, 1, 0, 19, 2, 8, 13)
      let m = box(m, 0, 3, 0, 19, 1, 8, 8)
      let m = box(m, 2, 4, 1, 5, 3, 6, 9)
      -- The center bay is clear for the crane's suspended load.
      box(m, 14, 4, 1, 4, 3, 6, 10)
    end
  end
  pfn canal_boat_segment(path : List(Int), progress : Float, dock : Int) : (Int, Int, Float) do
    match path do
      Cons(a, Cons(b, rest)) ->
        if progress >= 1.0 && !List.is_empty(rest) do
          canal_boat_segment(Cons(b, rest), progress -. 1.0, dock)
        else (a, b, progress) end
      Cons(a, Nil) -> (a, a, 0.0)
      Nil -> (dock, dock, 0.0)
    end
  end
  pfn canal_boat_point(c : Ur.Sim.City, lot : Int, peer : Int) : (Float, Float, Float) do
    let x = lot % S.width()
    let z = lot / S.width()
    let offset = if lot == c.harbour do 26 else 0 end
    let dx = peer % S.width() - x
    let dz = peer / S.width() - z
    let level = if S.canal_water(c, lot) do S.canal_level(c, lot) else 0 end
    (int_to_float(x * 32 + 16 + dx * offset), int_to_float(z * 32 + 16 + dz * offset), int_to_float(level))
  end
  pfn upload_boat_body(slot : Int, mesh : Ur.SceneMesh.Mesh) : Unit do
    if Vk.body_begin(slot) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Waterfront body upload failed") end
  end
  pfn refresh_crane(c : Ur.Sim.City, quay : Int) : Unit do
    if S.get(c.canal_docks, quay) != 2 || S.canal_crane_bank(c, quay) < 0 do
      List.each([0, 1, 2, 3], fn part -> Vk.chunk_free(crane_slot(quay, part)))
    else
      let trolley = box(vehicle_body(), 0, 1, 0, 8, 2, 4, 19)
      let trolley = box(trolley, 2, 0, 1, 4, 2, 2, 10)
      upload_boat_body(crane_slot(quay, 0), trolley)
      let mesh = Strata.Model.box(Strata.Model.empty(), -0.012, 0.0, -0.012, 0.012, 1.0, 0.012, 19)
      -- The renderer copies the scratch model when committing the instance.
      let model = 2
      let cable = NativeArray.set_i32(NativeArray.make_i32(2, 0), 0, Q.pack_instance0(0, 0, 0, model))
      if Vk.model_set(model, Strata.Model.floats(mesh), Strata.Model.count(mesh)) && Vk.body_begin(crane_slot(quay, 1)) &&
        Vk.chunk_part(3, cable, 1) && Vk.chunk_commit() do ()
      else Ur.AppError.stop("Canal crane cable upload failed") end
      upload_boat_body(crane_slot(quay, 2), box(box(vehicle_body(), 0, 0, 0, 4, 1, 4, 19), 1, 1, 1, 2, 1, 2, 10))
      upload_boat_body(crane_slot(quay, 3), box(vehicle_body(), 0, 0, 0, 4, 3, 4, 6))
    end
  end
  pfn crane_transfer(c : Ur.Sim.City, quay : Int, peer : Int, dwell : Float) : Unit do
    let bank = S.canal_crane_bank(c, quay)
    if bank < 0 || S.get(c.canal_docks, quay) != 2 do () else
      let transfer = if dwell >= 0.0 do S.canal_crane_transfer(c, quay, peer) else 0 end
      let rail = int_to_float(L.crane_rail_height(c, quay))
      let apron = int_to_float(S.canal_bank_height(c, quay) + 2)
      let vessel = int_to_float(S.canal_level(c, quay) + 5)
      let pose = Ur.CanalCrane.hoist(transfer, dwell, rail, apron, vessel)
      let hook = pose.bottom +. 3.0
      let (dx, dz, half_yaw) = match bank do
        0 -> (-1.0, 0.0, -0.7853981634)
        1 -> (1.0, 0.0, 0.7853981634)
        2 -> (0.0, -1.0, 1.5707963268)
        _ -> (0.0, 1.0, 0.0)
      end
      let x = int_to_float(quay % S.width() * 32 + 16) +. dx *. (pose.reach -. 16.0) -. dz *. 2.0
      let z = int_to_float(quay / S.width() * 32 + 16) +. dz *. (pose.reach -. 16.0) +. dx *. 2.0
      let place = fn (part, along, across, y) ->
        Vk.slot_pose(crane_slot(quay, part), (x +. dx *. along +. dz *. across) *. 0.25, y *. 0.25,
          (z +. dz *. along -. dx *. across) *. 0.25, 0.0, Math.sin(half_yaw), 0.0, Math.cos(half_yaw))
      place(0, -2.0, -4.0, rail +. 1.0)
      place(1, 0.0, 0.0, hook +. 2.0)
      Vk.slot_voxel(crane_slot(quay, 1), (rail +. 1.0 -. hook -. 2.0) *. 0.25)
      place(2, -2.0, -2.0, hook)
      place(3, -2.0, -2.0, pose.bottom)
      Vk.chunk_show(crane_slot(quay, 3), pose.carrying)
    end
  end
  pfn canal_voyage(time : Float, spans : Float, stop : Float) : (Float, Bool, Float) do
    let travel = Math.max_float(1.5, spans *. 1.5)
    let leg = travel +. stop
    let cycle = time -. Math.floor(time /. (leg *. 2.0)) *. leg *. 2.0
    let outbound = cycle < leg
    let elapsed = if outbound do cycle else cycle -. leg end
    let progress = Math.max_float(0.0, (elapsed -. stop) /. travel)
    let dwell = if elapsed < stop do elapsed /. stop else -1.0 end
    (if outbound do progress else 1.0 -. progress end, outbound, dwell)
  end
  pfn canal_vessel(c : Ur.Sim.City, i : Int, time : Float, refresh : Bool) : Unit do
    let slot = rotor_slot(i)
    let peer = S.get(c.ferries, i) - 1
    if !S.valid(peer) || peer <= i do
      if refresh do Vk.chunk_free(slot) else () end
    else
      let taxi = S.get(c.canal_docks, i) == 1
      if refresh do
        let mesh = canal_boat_mesh(taxi)
        if Vk.body_begin(slot) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
        else Ur.AppError.stop("Canal boat upload failed") end
      else () end
      let path = S.canal_service_path(c, i, peer)
      let spans = int_to_float(List.length(path) - 1)
      let lift = List.any(path, fn lot -> S.movable_leaf(c, lot))
      let stop = if !taxi && (S.canal_crane_bank(c, i) >= 0 || S.canal_crane_bank(c, peer) >= 0) do 3.5 else 0.0 end
      let (position, outward, dwell) = if lift do
        match Map.get(c.lift_vessels, i, Map.int_cmp) do
          Some(voyage) ->
            let (position, outward) = S.vessel_position(voyage)
            let dwell = if voyage.moored > 0.0 do (3.0 -. voyage.moored) /. 3.0 else -1.0 end
            (position, outward, dwell)
          None -> (0.0, true, -1.0)
        end
      else canal_voyage(time, spans, stop) end
      if !taxi do
        let dwell = if spans > 0.0 do dwell else -1.0 end
        crane_transfer(c, i, peer, if outward do dwell else -1.0 end)
        crane_transfer(c, peer, i, if outward do -1.0 else dwell end)
      else () end
      let progress = spans *. position
      let berth = if i == c.harbour do peer else i end
      let (a, b, u) = canal_boat_segment(path, progress, berth)
      let dx = int_to_float(b % S.width() - a % S.width())
      let dz = int_to_float(b / S.width() - a / S.width())
      let (ax, az, low) = canal_boat_point(c, a, b)
      let (bx, bz, high) = canal_boat_point(c, b, a)
      let x = ax +. (bx -. ax) *. u
      let z = az +. (bz -. az) *. u
      let level = low +. (high -. low) *. u
      let direction = if outward do 1.0 else -1.0 end
      let (dx, dz) = if a == b do (if S.canal_arm(c, a, 0) || S.canal_arm(c, a, 1) do (1.0, 0.0) else (0.0, 1.0) end)
        else (dx *. direction, dz *. direction) end
      let half_length = if taxi do 7.5 else 9.5 end
      let half_width = if taxi do 3.0 else 4.0 end
      let yaw = Math.atan2(0.0 -. dz, dx) *. 0.5
      Vk.slot_pose(slot, (x -. dx *. half_length +. dz *. half_width) *. 0.25, (level +. 1.0) *. 0.25,
        (z -. dz *. half_length -. dx *. half_width) *. 0.25, 0.0, Math.sin(yaw), 0.0, Math.cos(yaw))
    end
  end
  pfn water_bus_mesh() : Ur.SceneMesh.Mesh do
    let mesh = box(vehicle_body(), 1, 0, 1, 16, 1, 6, 19)
    let mesh = box(mesh, 0, 1, 0, 18, 2, 8, 7)
    let mesh = box(mesh, 0, 3, 0, 18, 1, 8, 17)
    let mesh = box(mesh, 2, 4, 1, 13, 3, 6, 9)
    let mesh = List.fold_left([4, 7, 10, 13], mesh, fn (mesh, x) -> box(mesh, x, 4, 1, 1, 3, 6, 17))
    let mesh = box(mesh, 1, 7, 0, 15, 1, 8, 17)
    let mesh = box(mesh, 3, 8, 3, 10, 1, 2, 7)
    box(mesh, 15, 4, 1, 2, 1, 6, 10)
  end
  fn water_buses(c : Ur.Sim.City, routes : List(Ur.Lift.Vessel), old_routes : List(Ur.Lift.Vessel), refresh : Bool) : Unit do
    if refresh do List.each(old_routes, fn boat ->
      if !List.is_empty(boat.calls) && !List.any(routes, fn active -> active.source == boat.source) do
        Vk.chunk_free(water_bus_slot(boat.source - S.water_bus_source(0)))
      else () end) else () end
    List.each(routes, fn boat ->
      if List.is_empty(boat.calls) do () else
        let yard = boat.source - S.water_bus_source(0)
        let slot = water_bus_slot(yard)
        if refresh do upload_boat_body(slot, water_bus_mesh()) else () end
        let (position, outward) = match Map.get(c.lift_vessels, boat.source, Map.int_cmp) do
          Some(motion) -> S.vessel_position(motion)
          None -> (0.0, true)
        end
        let (a, b, u) = canal_boat_segment(boat.path, position *. int_to_float(List.length(boat.path) - 1), yard)
        let (ax, az, low) = canal_boat_point(c, a, a)
        let (bx, bz, high) = canal_boat_point(c, b, b)
        let direction = if outward do 1.0 else -1.0 end
        let dx = (bx -. ax) *. direction /. 32.0
        let dz = (bz -. az) *. direction /. 32.0
        let x = ax +. (bx -. ax) *. u
        let z = az +. (bz -. az) *. u
        let level = low +. (high -. low) *. u
        let yaw = Math.atan2(0.0 -. dz, dx) *. 0.5
        Vk.slot_pose(slot, (x -. dx *. 9.0 +. dz *. 4.0) *. 0.25, (level +. 1.0) *. 0.25,
          (z -. dz *. 9.0 -. dx *. 4.0) *. 0.25, 0.0, Math.sin(yaw), 0.0, Math.cos(yaw))
      end)
  end
  pfn ferry_slot(c : Ur.Sim.City, i : Int, time : Float, clock : Float, refresh : Bool) : Unit do
    if refresh do
      refresh_crane(c, i)
      crane_transfer(c, i, -1, -1.0)
    else () end
    if S.get(c.canal_docks, i) > 0 do
      if refresh do canal_vessel(c, i, time, true) else () end
    else
    let slot = rotor_slot(i)
    match ferry_spot(c, i, time, clock) do
      None -> if refresh do Vk.chunk_free(slot) else () end
      Some((x, z, east)) ->
        if refresh do
          let mesh = vessel_mesh(false, east)
          if Vk.body_begin(slot) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do () else Ur.AppError.stop("Ferry upload failed") end
        else () end
        Vk.slot_pose(slot, int_to_float(x) *. 0.25, 0.25, int_to_float(z) *. 0.25, 0.0, 0.0, 0.0, 1.0)
    end
    end
  end
  doc "Pose each ferry on the sea (Strata.Waves' query of the waves the ocean shader draws): it rises and falls with the water under its middle and pitches and rolls with the sea's slope along and across its hull, from the heights at its bow, stern and sides, so it rides a long swell and shrugs off ripples shorter than itself. On a calm day it barely moves; in a storm it heaves and tips, never past 20 degrees. [waves] is this frame's sea state (Strata.Waves.sea_state), [field] the swell refracted round the coast that Strata draws, [exposure] the sea map handed to it (Ur.Sea.exposure), [water_time] the water's clock; [time] and [clock] place the boats as `vehicles` does."
  fn float_ferries(c : Ur.Sim.City, waves : Strata.Waves.SeaWaves, field : Option(Strata.Waves.Swell), exposure : NativeF32Arr, water_time : Float, time : Float, clock : Float, i : Int) : Unit do
    if i >= S.count() do () else
      if S.get(c.canal_docks, i) > 0 do canal_vessel(c, i, time, false)
      else if S.get(c.ferries, i) > 0 && !S.wind_turbine(S.get(c.plants, i)) do
        match ferry_spot(c, i, time, clock) do
          None -> ()
          Some((x, z, east)) ->
            -- the hull's middle at the waterline, its half length and half breadth, in metres
            let half_l = 19.0 *. 0.125
            let half_b = 8.0 *. 0.125
            let (lx, lz) = if east do (half_l, half_b) else (half_b, half_l) end
            let cx = int_to_float(x) *. 0.25 +. lx
            let cz = int_to_float(z) *. 0.25 +. lz
            let e = Ur.Sea.exposure_at(exposure, cx, cz)
            let sea = fn (px : Float, pz : Float) -> Strata.Waves.height(waves, field, e, px, pz, water_time)
            let mid = sea(cx, cz)
            let (ax, az) = if east do (1.0, 0.0) else (0.0, 1.0) end
            let bow = sea(cx +. ax *. half_l, cz +. az *. half_l)
            let stern = sea(cx -. ax *. half_l, cz -. az *. half_l)
            let port = sea(cx +. az *. half_b, cz +. ax *. half_b)
            let star = sea(cx -. az *. half_b, cz -. ax *. half_b)
            let along = (bow -. stern) /. (2.0 *. half_l)
            let across = (port -. star) /. (2.0 *. half_b)
            let (gx, gz) = if east do (along, across) else (across, along) end
            -- no steeper than 20 degrees
            let steep = Math.sqrt(gx *. gx +. gz *. gz)
            let limit = 0.364
            let (gx, gz) = if steep > limit do (gx *. limit /. steep, gz *. limit /. steep) else (gx, gz) end
            let heave = (2.0 *. mid +. bow +. stern +. port +. star) /. 6.0
            -- the turn that takes up (0, 1, 0) to the sea's normal (-gx, 1, -gz): half way, as a quaternion (u x n, 1 + u . n)
            let nl = Math.sqrt(gx *. gx +. 1.0 +. gz *. gz)
            let nx = 0.0 -. gx /. nl
            let ny = 1.0 /. nl
            let nz = 0.0 -. gz /. nl
            let ql = Math.sqrt(nz *. nz +. nx *. nx +. (1.0 +. ny) *. (1.0 +. ny))
            let qx = nz /. ql
            let qz = 0.0 -. nx /. ql
            let qw = (1.0 +. ny) /. ql
            -- the low corner, so the hull's middle stays at (cx, heave, cz)
            let (ox, oy, oz) = Ur.SceneMesh.turn(qx, 0.0, qz, qw, lx, 0.0, lz)
            Vk.slot_pose(rotor_slot(i), cx -. ox, 0.25 +. heave -. oy, cz -. oz, qx, 0.0, qz, qw)
        end
      else () end end
      float_ferries(c, waves, field, exposure, water_time, time, clock, i + 1)
    end
  end
  pfn rotor_mesh(step : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if step == 10 do m else
      let material = if step >= 8 do 6 else 8 end
      let m = box(m, 15, 17 + step, 15, 2, 1, 2, material)
      let m = box(m, 15 - step, 15 - (step + 1) / 2, 15, 1, 2, 2, material)
      let m = box(m, 17 + step, 15 - (step + 1) / 2, 15, 1, 2, 2, material)
      rotor_mesh(step + 1, m)
    end
  end
  pfn rotor(c : Ur.Sim.City, i : Int, slot : Int, angle : Float, wind : Ur.Sim.Wind, refresh : Bool) : Unit do
    if refresh do
      let m = rotor_mesh(1, box({ words: NativeArray.make_i32(336, 0), quads: 0 }, 14, 14, 14, 4, 4, 4, 7))
      if Vk.body_begin(slot) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do () else Ur.AppError.stop("Turbine rotor upload failed") end
    else () end
    let yaw = 1.570796327 -. wind.heading
    let sy = Math.sin(yaw *. 0.5)
    let cy = Math.cos(yaw *. 0.5)
    let sr = Math.sin(angle *. 0.5)
    let cr = Math.cos(angle *. 0.5)
    let cx = 4.0 *. (Math.cos(angle) -. Math.sin(angle))
    let cy_local = 4.0 *. (Math.cos(angle) +. Math.sin(angle))
    let offset_x = Math.cos(yaw) *. cx +. Math.sin(yaw) *. 4.0
    let offset_z = Math.cos(yaw) *. 4.0 -. Math.sin(yaw) *. cx
    let x = int_to_float(i % S.width() * 8 + 4)
    let z = int_to_float(i / S.width() * 8 + 4)
    let height = S.get(c.heights, i) + (if S.get(c.plants, i) == 33 do 42 else 34 end)
    Vk.slot_pose(slot, x -. offset_x, int_to_float(height) *. 0.25 -. cy_local, z -. offset_z, sy *. sr, sy *. cr, cy *. sr, cy *. cr)
  end
  fn vehicles(c : Ur.Sim.City, old : Ur.Sim.City, phases : NativeF32Arr, time : Float, clock : Float, dt : Float, refresh : Bool, i : Int) : NativeF32Arr do
    if i >= S.count() do phases else
      let turbine = S.wind_turbine(S.get(c.plants, i))
      let was_turbine = S.wind_turbine(S.get(old.plants, i))
      let phases = if turbine do
        let wind = S.wind_at(c, i)
        let turn = NativeArray.get_f32(phases, i) +. int_to_float(wind.speed) *. 0.09 *. dt
        let angle = turn -. Math.floor(turn /. 6.283185307) *. 6.283185307
        rotor(c, i, rotor_slot(i), angle, wind, refresh)
        NativeArray.set_f32(phases, i, angle)
      else
        if S.get(c.ferries, i) > 0 || (refresh && (was_turbine || S.get(old.ferries, i) > 0)) do
          let crane_changed = S.get(c.canal_docks, i) == 2 && S.canal_crane_bank(c, i) != S.canal_crane_bank(old, i)
          ferry_slot(c, i, time, clock, refresh || crane_changed)
        else () end
        phases
      end
      vehicles(c, old, phases, time, clock, dt, refresh, i + 1)
    end
  end
  pfn trash_truck_mesh() : Ur.SceneMesh.Mesh do
    let mesh = running_gear(vehicle_body(), 11, 6, 2)
    let mesh = box(box(mesh, 7, 2, 1, 4, 3, 4, 8), 8, 5, 0, 3, 2, 6, 9)
    let mesh = paired_trim(mesh, 7, 2, 3, 3, 6, 8)
    let mesh = box(box(mesh, 7, 7, 0, 4, 1, 6, 8), 7, 8, 2, 1, 1, 2, 10)
    let mesh = box(box(mesh, 0, 2, 0, 7, 5, 6, 21), 1, 7, 1, 5, 1, 4, 7)
    let mesh = box(box(mesh, 1, 4, 0, 6, 1, 1, 10), 1, 4, 5, 6, 1, 1, 10)
    let mesh = box(box(mesh, 0, 2, 1, 1, 3, 4, 19), 0, 5, 1, 1, 1, 4, 17)
    let mesh = box(box(mesh, 2, 5, 0, 1, 2, 1, 17), 2, 5, 5, 1, 2, 1, 17)
    let mesh = box(box(mesh, 0, 1, 0, 1, 1, 1, 30), 0, 1, 5, 1, 1, 1, 30)
    let mesh = box(mesh, 10, 3, 1, 1, 1, 4, 19)
    paired_trim(mesh, 10, 2, 1, 1, 6, 8)
  end
  pfn delivery_mesh(mode : Int) : Ur.SceneMesh.Mesh do
    if mode == 7 do
      let m = running_gear(vehicle_body(), 8, 6, 2)
      let m = box(m, 0, 2, 0, 8, 1, 6, 10)
      let m = box(m, 1, 3, 1, 3, 2, 4, 19)
      let m = box(m, 0, 5, 0, 5, 1, 6, 8)
      let m = box(m, 5, 3, 1, 3, 2, 4, 7)
      box(m, 6, 5, 1, 1, 2, 1, 19)
    else
      let accent = if mode == 9 do 10 else 7 end
      let m = running_gear(vehicle_body(), 11, 6, 2)
      let m = box(m, 1, 2, 0, 10, 1, 6, accent)
      let m = box(m, 0, 2, 1, 1, 1, 4, accent)
      let m = box(m, 0, 3, 0, 7, 1, 6, 8)
      let m = box(m, 0, 4, 1, 7, 3, 4, 8)
      let m = paired_trim(m, 1, 4, 5, 1, 6, accent)
      let m = paired_trim(m, 1, 5, 4, 1, 6, if mode == 9 do 9 else 8 end)
      let m = box(m, 0, 7, 0, 7, 1, 6, 17)
      let m = box(m, 7, 3, 0, 4, 2, 6, 8)
      let m = box(m, 8, 5, 0, 3, 2, 6, 9)
      let m = box(m, 7, 7, 0, 4, 1, 6, 8)
      let m = box(m, 10, 3, 1, 1, 1, 4, 19)
      paired_trim(m, 0, 2, 1, 1, 6, 6)
    end
  end
  pfn street_tile(c : Ur.Sim.City, i : Int) : Bool do
    S.get(c.roads, i) > 0 || S.get(c.ferries, i) > 0
  end
  pfn covered_lane(c : Ur.Sim.City, portal : Int, x : Float, z : Float, section : Bool) : Bool do
    let i = S.index(float_to_int(x) / 32, float_to_int(z) / 32)
    let kind = S.grade_kind(c, portal)
    if kind == 3 do
      let far = S.grade_peer(c, portal)
      let east = portal / S.width() == far / S.width()
      let at = if east do x else z end
      let a = int_to_float((if east do portal % S.width() else portal / S.width() end) * 32 + 16)
      let b = int_to_float((if east do far % S.width() else far / S.width() end) * 32 + 16)
      let near = Math.abs(at -. a)
      let far_end = Math.abs(at -. b)
      !section && (if S.mountain_tunnel(c, portal, far) do near > 16.0 && far_end > 16.0 else
        let reach = int_to_float(S.tunnel_mouth_run())
        (near > reach || near > int_to_float(S.tunnel_lip(c, portal, far))) &&
          (far_end > reach || far_end > int_to_float(S.tunnel_lip(c, far, portal))) end)
    else kind == 2 && (S.get(c.roads, i) > 0 || S.get(c.buildings, i) > 0 || S.get(c.plants, i) > 0 || S.get(c.construction, i) > 0) end
  end
  pfn draw_patrol_vehicle(c : Ur.Sim.City, call : Ur.Sim.Incident, progress : Float, slot : Int, section : Bool) : Unit do
    let legs = List.length(call.road) - 1
    let step = progress *. int_to_float(legs)
    let leg = float_to_int(step)
    let (a, b) = match call.road do
      Cons(street, Nil) -> (street, street)
      _ -> Ur.Food.leg(call.road, leg)
    end
    let t = step -. int_to_float(leg)
    if !S.responder_road(c, call.kind, a) || !S.responder_road(c, call.kind, b) || !(a == b || S.grade_link(c, a, b) || S.span_distance(a, b) == 1) do Vk.chunk_free(slot) else
      let (x, z, dx, dz) = if a == b do
        (int_to_float(a % S.width() * 32 + 16), int_to_float(a / S.width() * 32 + 16), 1.0, 0.0)
      else street_pose(c, a, b, t, 3.0) end
      let grade = S.grade_link(c, a, b)
      let y = if grade do S.grade_surface(c, a, b, t) +. 2.0
        else int_to_float(S.get(c.heights, a) + 2) +. int_to_float(S.get(c.heights, b) - S.get(c.heights, a)) *. t end
      if grade && covered_lane(c, a, x, z, section) do Vk.chunk_free(slot) else
        let phase = int_mod_euclid(float_to_int(Vk.time() *. 10.0), 4)
        let blink = if phase % 2 != 0 do 19 else if call.kind != 3 && call.kind != 4 && phase == 2 do 31 else 30 end end
        let height = if call.kind == 3 || call.kind == 4 do 6.5 else 5.5 end
        let offset = if call.kind == 3 do 3.5 else if call.kind == 4 do 1.5 else 0.0 end end
        if blink >= 30 do Vk.beacon(x +. dx *. offset, y +. height, z +. dz *. offset, blink + 1) else () end
        if call.kind == 3 do
          let mesh = running_gear(vehicle_body(), 14, 6, 2)
          let mesh = box(mesh, 0, 2, 0, 14, 1, 6, 6)
          let mesh = box(mesh, 1, 3, 1, 7, 2, 4, 6)
          let mesh = paired_trim(mesh, 2, 3, 5, 2, 6, 17)
          let mesh = box(mesh, 1, 5, 1, 7, 1, 4, 6)
          let mesh = box(mesh, 8, 3, 0, 6, 2, 6, 9)
          let mesh = box(mesh, 8, 5, 0, 6, 1, 6, 8)
          let mesh = box(mesh, 1, 6, 1, 7, 1, 1, 17)
          let mesh = box(mesh, 1, 6, 4, 7, 1, 1, 17)
          posed_vehicle(slot, box(mesh, 10, 6, 0, 1, 1, 6, blink), x, y, z, dx, dz, 14.0, 6.0)
        else if call.kind == 4 do
          let mesh = running_gear(vehicle_body(), 12, 5, 2)
          let mesh = box(mesh, 0, 2, 0, 12, 1, 5, 8)
          let mesh = box(mesh, 0, 3, 1, 7, 2, 3, 8)
          let mesh = paired_trim(mesh, 0, 3, 7, 1, 5, 6)
          let mesh = paired_trim(mesh, 2, 4, 3, 1, 5, 9)
          let mesh = box(mesh, 7, 3, 0, 4, 2, 5, 9)
          let mesh = box(mesh, 0, 5, 0, 11, 1, 5, 8)
          let mesh = box(mesh, 1, 6, 2, 5, 1, 1, 6)
          let mesh = box(mesh, 3, 6, 1, 1, 1, 1, 6)
          let mesh = box(mesh, 3, 6, 3, 1, 1, 1, 6)
          posed_vehicle(slot, box(mesh, 7, 6, 0, 1, 1, 5, blink), x, y, z, dx, dz, 12.0, 5.0)
        else
          let mesh = running_gear(vehicle_body(), 9, 4, 2)
          let mesh = box(mesh, 0, 2, 0, 9, 1, 4, 8)
          let mesh = box(mesh, 2, 3, 0, 2, 1, 4, 9)
          let mesh = box(mesh, 4, 3, 0, 1, 1, 4, 19)
          let mesh = box(mesh, 5, 3, 0, 2, 1, 4, 9)
          let mesh = box(mesh, 3, 4, 0, 3, 1, 4, 8)
          posed_vehicle(slot, box(mesh, 4, 5, 0, 1, 1, 4, blink), x, y, z, dx, dz, 9.0, 4.0)
        end end
      end
    end
  end
  pfn patrol_vehicle(c : Ur.Sim.City, call : Ur.Sim.Incident, progress : Float, slot : Int, section : Bool,
    roads : Ur.Lift.ServiceRoads) : Ur.Lift.ServiceRoads do
    let legs = int_to_float(Math.max_int(1, List.length(call.road) - 1))
    let (at, roads) = Ur.Lift.service_drive(c, roads, slot, call.road, progress *. legs)
    draw_patrol_vehicle(c, call, at /. legs, slot, section)
    roads
  end
  -- Incidents follow the fleet's 180 slots (see the render-slot layout at sea_slot).
  pfn incident_slot(index : Int) : Int do 6 * S.count() + 280 + index * 2 end
  pfn window_slot(slot : Int, side : Int) : Int do slot + 32 + side end
  pfn clear_window_smoke(slot : Int) : Unit do
    Vk.chunk_free(window_slot(slot, 0))
    Vk.chunk_free(window_slot(slot, 1))
  end
  pfn flame_tongue(mesh : Ur.SceneMesh.Mesh, x : Int, z : Int, phase : Float, strength : Int) : Ur.SceneMesh.Mesh do
    let rise = strength + float_to_int((1.0 +. Math.sin(phase)) *. 2.4)
    let lean = float_to_int(Math.sin(phase +. 1.3) *. 2.0)
    let mesh = box(mesh, x - 2, 0, z - 2, 5, 2, 5, 30)
    let mesh = box(mesh, x - 2, 1, z - 1, 4, 3, 4, 35)
    let mesh = box(mesh, x - 1, 2, z - 1, 3, rise, 3, 36)
    let mesh = box(mesh, x + lean, rise, z - 1, 2, 3, 2, 26)
    let mesh = box(mesh, x + lean, rise + 3, z, 1, 2, 1, 36)
    box(mesh, x - 2, 2, z - 2, 1, 2, 2, 28)
  end
  pfn embers(mesh : Ur.SceneMesh.Mesh, motion : Float, seed : Float, ember : Int) : Ur.SceneMesh.Mesh do
    if ember == 6 do mesh else
      let phase = motion *. (1.3 +. int_to_float(ember) *. 0.23) +. seed +. int_to_float(ember) *. 0.38
      let t = phase -. Math.floor(phase)
      let x = 9 + ember * 2 + float_to_int(t *. Math.sin(phase *. 2.0) *. 5.0)
      let y = 6 + float_to_int(t *. 19.0)
      let z = 13 + ember % 3 * 3 + float_to_int(t *. 4.0)
      embers(box(mesh, x, y, z, 1, 1, 1, if ember % 3 == 0 do 28 else 36 end), motion, seed, ember + 1)
    end
  end
  pfn drifting_smoke(mesh : Ur.SceneMesh.Mesh, wind : Ur.Sim.Wind, motion : Float, seed : Float, puff : Int) : Ur.SceneMesh.Mesh do
    if puff == 4 do mesh else
      let phase = motion *. 1.8 +. int_to_float(puff) *. 0.25 +. seed
      let t = phase -. Math.floor(phase)
      let drift = t *. int_to_float(S.clamp(wind.speed / 2, 2, 12))
      let size = 5 + float_to_int(t *. 6.0)
      let x = 15 - size / 2 + float_to_int(Math.cos(wind.heading) *. drift)
      let z = 15 - size / 2 + float_to_int(Math.sin(wind.heading) *. drift)
      let x = S.clamp(x, 0, 32 - size)
      let z = S.clamp(z, 0, 32 - size)
      let y = 7 + float_to_int(t *. 18.0)
      let tex = 32 + float_to_int(t *. 3.0)
      let mesh = box(mesh, x + 1, y, z + 1, size - 2, 1, size - 2, tex)
      let mesh = box(mesh, x, y + 1, z, size, 3, size, tex)
      let mesh = box(mesh, x + 1, y + 4, z + 1, size - 2, 1, size - 2, tex)
      drifting_smoke(mesh, wind, motion, seed, puff + 1)
    end
  end
  pfn vent_window(parts : List(Ur.Architecture.Piece), east : Bool) : Option(Ur.Architecture.Piece) do
    List.fold_left(parts, None, fn (selected, piece) ->
      let glass = piece.material == 9 || piece.material == 15
      let outward = if east do piece.w == 1 && piece.x > 17 && piece.d >= 3
        else piece.d == 1 && piece.z > 17 && piece.w >= 3 end
      if !glass || !outward || piece.h < 3 || piece.h > 5 do selected else
        match selected do
          None -> Some(piece)
          Some(best) -> if piece.y > best.y do Some(piece) else selected end
        end
      end)
  end
  pfn window_puffs(mesh : Ur.SceneMesh.Mesh, east : Bool, wind : Ur.Sim.Wind, motion : Float, puff : Int) : Ur.SceneMesh.Mesh do
    if puff == 5 do mesh else
      let phase = motion *. 1.4 +. int_to_float(puff) *. 0.20
      let t = phase -. Math.floor(phase)
      let outward = 1 + float_to_int(t *. 8.0)
      let drift = t *. t *. int_to_float(S.clamp(wind.speed / 3, 2, 10))
      let size = 3 + float_to_int(t *. 5.0)
      let x = 12 + (if east do outward else 0 end) + float_to_int(Math.cos(wind.heading) *. drift)
      let z = 12 + (if east do 0 else outward end) + float_to_int(Math.sin(wind.heading) *. drift)
      let x = S.clamp(x - size / 2, 0, 32 - size)
      let z = S.clamp(z - size / 2, 0, 32 - size)
      let y = 2 + float_to_int(t *. t *. 18.0)
      let tex = 32 + float_to_int(t *. 3.0)
      let mesh = box(mesh, x, y, z, size, 2 + size / 3, size, tex)
      let mesh = box(mesh, x + 1, y + 2 + size / 3, z + 1, size - 2, 1, size - 2, tex)
      window_puffs(mesh, east, wind, motion, puff + 1)
    end
  end
  pfn draw_window_smoke(parts : List(Ur.Architecture.Piece), east : Bool, wind : Ur.Sim.Wind, motion : Float,
    x : Float, z : Float, slot : Int) : Unit do
    match vent_window(parts, east) do
      None -> Vk.chunk_free(slot)
      Some(pane) ->
        let px = x +. int_to_float(pane.x + (if east do pane.w else pane.w / 2 end) - 12)
        let pz = z +. int_to_float(pane.z + (if east do pane.d / 2 else pane.d end) - 12)
        let y = int_to_float(pane.y)
        let m = { words: NativeArray.make_i32(72, 0), quads: 0 }
        let width = if east do 1 else S.clamp(pane.w, 3, 5) end
        let depth = if east do S.clamp(pane.d, 3, 5) else 1 end
        let m = box(m, 12 - width / 2, 0, 12 - depth / 2, width, pane.h, depth, 19)
        let m = box(m, 12, 0, 12, 1, 2 + float_to_int(1.0 +. Math.sin(motion *. 13.0)), 1, 35)
        let smoke = window_puffs({ words: NativeArray.make_i32(128, 0), quads: 0 }, east, wind, motion, 0)
        if Vk.body_begin(slot) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_part(2, smoke.words, smoke.quads) && Vk.chunk_commit() do
          Vk.slot_pose(slot, px *. 0.25, y *. 0.25, pz *. 0.25, 0.0, 0.0, 0.0, 1.0)
        else Ur.AppError.stop("Window smoke upload failed") end
    end
  end
  pfn fire_fx(c : Ur.Sim.City, lot : Int, wind : Ur.Sim.Wind, motion : Float, slot : Int) : Unit do
    let x = int_to_float(lot % S.width() * 32)
    let z = int_to_float(lot / S.width() * 32)
    let parts = L.structures(c, lot, 0)
    let roof = List.fold_left(parts, S.get(c.heights, lot), fn (top, piece) ->
      if piece.x <= 15 && piece.x + piece.w > 15 && piece.z <= 16 && piece.z + piece.d > 16 && piece.y + piece.h > top do
        piece.y + piece.h
      else top end)
    let y = int_to_float(roof - 1)
    let seed = int_to_float(lot % 13) *. 0.13
    let phase = motion *. 11.0 +. seed
    let m = { words: NativeArray.make_i32(384, 0), quads: 0 }
    let m = flame_tongue(m, 15, 15, phase, 6)
    let m = flame_tongue(m, 10, 18, phase +. 2.5, 3)
    let m = flame_tongue(m, 20, 16, phase +. 4.8, 4)
    let m = flame_tongue(m, 16, 20, phase +. 1.7, 2)
    let m = embers(m, motion, seed, 0)
    let smoke = drifting_smoke({ words: NativeArray.make_i32(160, 0), quads: 0 }, wind, motion, seed, 0)
    if Vk.body_begin(slot) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_part(2, smoke.words, smoke.quads) && Vk.chunk_commit() do
      Vk.slot_pose(slot, x *. 0.25, y *. 0.25, z *. 0.25, 0.0, 0.0, 0.0, 1.0)
      Vk.beacon(x +. 15.0, y +. 4.0, z +. 16.0, 27)
      draw_window_smoke(parts, true, wind, motion +. seed, x, z, window_slot(slot, 0))
      draw_window_smoke(parts, false, wind, motion +. seed +. 0.29, x, z, window_slot(slot, 1))
    else Ur.AppError.stop("Fire effect upload failed") end
  end
  pfn incident_marker(c : Ur.Sim.City, call : Ur.Sim.Incident, slot : Int) : Unit do
    let x = call.lot % S.width() * 32 + 13
    let z = call.lot / S.width() * 32 + 13
    let y = S.get(c.heights, call.lot) + S.get(c.buildings, call.lot) * 11 + 9
    let material = if call.response < 0 do 6 else 10 end
    let mesh = { words: NativeArray.make_i32(64, 0), quads: 0 }
    let mesh = if call.kind == 4 do
      let mesh = box(mesh, 2, 0, 2, 2, 7, 2, 6)
      box(mesh, 0, 2, 2, 6, 2, 2, 6)
    else
      let mesh = box(mesh, 2, 0, 2, 2, 2, 2, material)
      box(mesh, 1, 3, 1, 4, 5, 4, material)
    end
    if Vk.chunk_begin(slot, x, y, z, 0) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Incident marker upload failed") end
  end
  pfn draw_spread(c : Ur.Sim.City, lots : List(Int), wind : Ur.Sim.Wind, motion : Float, used : Int) : Int do
    if used == 16 do used else
      match lots do
        Nil -> used
        Cons(lot, rest) ->
          let slot = incident_slot(used)
          fire_fx(c, lot, wind, motion, slot)
          Vk.chunk_free(slot + 1)
          draw_spread(c, rest, wind, motion, used + 1)
      end
    end
  end
  pfn load_patient(c : Ur.Sim.City, call : Ur.Sim.Incident, curb : Int, fraction : Float, slot : Int) : Unit do
    let dx = curb % S.width() - call.lot % S.width()
    let dz = curb / S.width() - call.lot / S.width()
    let reach = 13 + float_to_int(fraction *. 18.0)
    let x = call.lot % S.width() * 32 + 14 + dx * reach
    let z = call.lot / S.width() * 32 + 14 + dz * reach
    let floor = S.get(c.heights, call.lot)
    let y = floor + 1 + float_to_int(fraction *. int_to_float(S.get(c.heights, curb) - floor))
    let mesh = { words: NativeArray.make_i32(64, 0), quads: 0 }
    let mesh = box(mesh, 0, 0, 0, 6, 1, 3, 19)
    let mesh = box(mesh, 0, 1, 0, 6, 1, 3, 8)
    let mesh = box(mesh, 1, 2, 1, 4, 1, 2, 12)
    let mesh = box(mesh, 4, 3, 1, 1, 1, 1, 15)
    if Vk.chunk_begin(slot, x, y, z, 0) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Patient pickup upload failed") end
  end
  pfn last_street(route : List(Int), last : Int) : Int do
    match route do
      Nil -> last
      Cons(i, rest) -> last_street(rest, i)
    end
  end
  pfn medical_vehicle(c : Ur.Sim.City, call : Ur.Sim.Incident, transfer : Ur.Sim.MedicalTransfer, progress : Float, marker : Int, section : Bool, roads : Ur.Lift.ServiceRoads) : Ur.Lift.ServiceRoads do
    let inbound = 0.55 +. int_to_float(call.travel) /. 32.0
    let after_arrival = (progress -. 1.0) *. inbound
    if progress < 1.0 do
      incident_marker(c, call, marker)
      if progress >= 0.0 && !List.is_empty(call.road) do patrol_vehicle(c, call, progress, marker + 1, section, roads)
      else
        Vk.chunk_free(marker + 1)
        roads
      end
    else
      match transfer.route do
        Nil ->
          incident_marker(c, call, marker)
          Vk.chunk_free(marker + 1)
          roads
        Cons(curb, _) ->
          if after_arrival < 0.26 do
            load_patient(c, call, curb, after_arrival /. 0.26, marker)
            patrol_vehicle(c, { call with road: Cons(curb, Nil) }, 0.0, marker + 1, section, roads)
          else
            Vk.chunk_free(marker)
            let progress = (after_arrival -. 0.26) /. (0.5 +. int_to_float(transfer.transport) /. 32.0)
            if progress < 1.0 do patrol_vehicle(c, { call with road: transfer.route }, progress, marker + 1, section, roads)
            else
              let unloading = (progress -. 1.0) *. (0.5 +. int_to_float(transfer.transport) /. 32.0) /. 0.24
              let receiving = last_street(transfer.route, -1)
              if unloading < 1.0 && S.valid(receiving) do
                load_patient(c, { call with lot: transfer.facility }, receiving, 1.0 -. unloading, marker)
                patrol_vehicle(c, { call with road: Cons(receiving, Nil) }, 0.0, marker + 1, section, roads)
              else
                Vk.chunk_free(marker + 1)
                roads
              end
            end
          end
      end
    end
  end
  pfn draw_calls(c : Ur.Sim.City, calls : List(Ur.Sim.Incident), month : Int, age : Float, wind : Ur.Sim.Wind, motion : Float, used : Int, section : Bool, roads : Ur.Lift.ServiceRoads) : (Int, Ur.Lift.ServiceRoads) do
    if used == 16 do (used, roads) else
      match calls do
        Nil -> (used, roads)
        Cons(call, rest) ->
          let since_report = age -. int_to_float(call.reported) /. 120.0
          if since_report < 0.0 || since_report >= (if call.kind == 4 do 5.4 else 2.2 end) do draw_calls(c, rest, month, age, wind, motion, used, section, roads) else
            let marker = incident_slot(used)
            let wait = int_to_float(call.response - call.travel) /. 75.0
            let progress = (since_report -. wait) /. (0.55 +. int_to_float(call.travel) /. 32.0)
            let burning = if call.kind != 3 do false else
              let duration = if call.response < 0 do 2.2 else wait +. 0.55 +. int_to_float(call.travel) /. 32.0 end
              let rain = S.fire_burn_percent(S.weather_on(c, month, S.incident_day(call.reported)))
              since_report < duration *. int_to_float(rain) /. 100.0
            end
            if burning do () else clear_window_smoke(marker) end
            let roads = match call.medical do
              Some(transfer) -> medical_vehicle(c, call, transfer, progress, marker, section, roads)
              None ->
                if burning do fire_fx(c, call.lot, wind, motion, marker) else incident_marker(c, call, marker) end
                if call.response >= 0 && !List.is_empty(call.road) && progress >= 0.0 && progress < 1.0 do
                  patrol_vehicle(c, call, progress, marker + 1, section, roads)
                else
                  Vk.chunk_free(marker + 1)
                  roads
                end
            end
            let spread = if burning && since_report > 0.3 do List.take(call.spread, 1 + float_to_int((since_report -. 0.3) *. 5.0)) else Nil end
            draw_calls(c, rest, month, age, wind, motion, draw_spread(c, spread, wind, motion, used + 1), section, roads)
          end
      end
    end
  end
  pfn recent_calls(c : Ur.Sim.City, history : List(Ur.Sim.CrimeMonth), elapsed : Float, wind : Ur.Sim.Wind, motion : Float,
    used : Int, section : Bool, roads : Ur.Lift.ServiceRoads) : (Int, Ur.Lift.ServiceRoads) do
    match history do
      Nil -> (used, roads)
      Cons(month, rest) ->
        let age = int_to_float((c.month - month.month) * S.days_per_month()) *. S.day_seconds() +. elapsed
        if age >= int_to_float(S.days_per_month()) *. S.day_seconds() +. 6.4 || used == 16 do (used, roads) else
          let (used, roads) = draw_calls(c, month.calls, month.month, age, wind, motion, used, section, roads)
          recent_calls(c, rest, elapsed, wind, motion, used, section, roads)
        end
    end
  end
  pfn clear_incidents(used : Int) : Unit do
    if used == 16 do () else
      Vk.chunk_free(incident_slot(used))
      Vk.chunk_free(incident_slot(used) + 1)
      clear_window_smoke(incident_slot(used))
      clear_incidents(used + 1)
    end
  end
  fn incidents(c : Ur.Sim.City, elapsed : Float, wind : Ur.Sim.Wind, motion : Float, section : Bool,
    roads : Ur.Lift.ServiceRoads) : Ur.Lift.ServiceRoads do
    let (used, roads) = recent_calls(c, c.crime_history, elapsed, wind, motion, 0, section, roads)
    clear_incidents(used)
    roads
  end
  pfn delivery_pose(c : Ur.Sim.City, trip : Ur.Food.Trip, i : Int, j : Int, index : Int, t : Float, forward : Bool, slot : Int, section : Bool) : Unit do
    let curb = !street_tile(c, i) || !street_tile(c, j)
    let facing = if forward do 1.0 else -1.0 end
    let mesh = delivery_mesh(trip.mode)
    let length = 11.0
    let width = 6.0
    if !curb do
      let (previous, _) = if index > 0 do Ur.Food.leg(trip.stops, index - 1) else (-1, -1) end
      let (_, next) = if index + 1 < trip.legs do Ur.Food.leg(trip.stops, index + 1) else (-1, -1) end
      let merge = if !street_tile(c, previous) && t < 0.5 do t *. 2.0
        else if !street_tile(c, next) && t > 0.5 do (1.0 -. t) *. 2.0 else 1.0 end end
      let (x, z, dx, dz) = street_pose(c, i, j, t, 4.0 *. facing *. merge)
      let grade = S.grade_link(c, i, j)
      let y = if grade do S.grade_surface(c, i, j, t) +. 2.0
        else int_to_float(S.get(c.heights, i) + 2) +. int_to_float(S.get(c.heights, j) - S.get(c.heights, i)) *. t end
      if grade && covered_lane(c, i, x, z, section) do Vk.chunk_free(slot)
      else posed_vehicle(slot, mesh, x, y, z, dx *. facing, dz *. facing, length, width) end
    else
      let leaving = !street_tile(c, i)
      let road = if leaving do j else i end
      let lot = if leaving do i else j end
      let (prev, _) = if index > 0 do Ur.Food.leg(trip.stops, index - 1) else (-1, -1) end
      let (_, next) = if index + 1 < trip.legs do Ur.Food.leg(trip.stops, index + 1) else (-1, -1) end
      let along = if leaving do next else prev end
      let curb_x = int_to_float(lot % S.width() - road % S.width())
      let curb_z = int_to_float(lot / S.width() - road / S.width())
      let sign = if S.valid(along) && ((along % S.width() - road % S.width()) * (lot / S.width() - road / S.width()) -
        (along / S.width() - road / S.width()) * (lot % S.width() - road % S.width())) < 0 do -1.0 else 1.0 end
      let u = if leaving do 1.0 -. t else t end
      let kind = S.get(c.plants, lot)
      let parking = if kind == 16 || kind == 23 || kind == 24 do 19.0 else 8.0 end
      let shift = u *. u *. (3.0 -. 2.0 *. u) *. parking
      let advance = u *. 7.0
      let x = int_to_float(road % S.width() * 32 + 16) +. curb_x *. shift +. curb_z *. sign *. advance
      let z = int_to_float(road / S.width() * 32 + 16) +. curb_z *. shift -. curb_x *. sign *. advance
      let bend = 48.0 *. u *. (1.0 -. u)
      let heading = if leaving do 0.0 -. facing else facing end
      posed_vehicle(slot, mesh, x, int_to_float(S.get(c.heights, road) + 2), z,
        (curb_x *. bend +. curb_z *. sign *. 7.0) *. heading,
        (curb_z *. bend -. curb_x *. sign *. 7.0) *. heading, length, width)
    end
  end
  -- Nine voxels toward the street from the depot centre leaves room to turn under the canopy.
  pfn bus_depot_mouth() : Float do 9.0 end
  pfn bus_point(c : Ur.Sim.City, lot : Int, peer : Int) : (Float, Float, Float) do
    let x = int_to_float(lot % S.width() * 32 + 16)
    let z = int_to_float(lot / S.width() * 32 + 16)
    if street_tile(c, lot) do (x, int_to_float(S.get(c.heights, lot) + 2), z) else
      let dx = int_to_float(peer % S.width() - lot % S.width())
      let dz = int_to_float(peer / S.width() - lot / S.width())
      let kind = S.get(c.plants, lot)
      let mouth = if kind == 16 do 4.0 else if kind == 23 do bus_depot_mouth() else 12.0 end end
      let y = S.get(c.heights, if kind == 16 || kind == 23 do lot else peer end) + 2
      (x +. dx *. mouth, int_to_float(y), z +. dz *. mouth)
    end
  end
  -- Round each intersection using the incoming and outgoing legs of this route.
  pfn bus_xy(c : Ur.Sim.City, trip : Ur.Food.Trip, i : Int, j : Int, index : Int, t : Float) : (Float, Float) do
    let portal = if t < 0.5 do i else j end
    if street_tile(c, i) && street_tile(c, j) && (S.mountain_tunnel(c, portal, S.grade_peer(c, portal)) ||
      S.get(c.road_shapes, i) > 0 || S.get(c.road_shapes, j) > 0) do
      let (x, z, _, _) = street_pose(c, i, j, t, 0.0)
      (x, z)
    else
    let (ax, _, az) = bus_point(c, i, j)
    let (bx, _, bz) = bus_point(c, j, i)
    let junction = if t < 0.2 do index else if t > 0.8 do index + 1 else -1 end end
    let (prev, corner) = Ur.Food.leg(trip.stops, junction - 1)
    let (_, next) = Ur.Food.leg(trip.stops, junction)
    if junction > 0 && junction < trip.legs && S.valid(prev) && S.valid(next) &&
      !S.grade_link(c, prev, corner) && !S.grade_link(c, corner, next) do
      let (px, _, pz) = bus_point(c, prev, corner)
      let (cx, _, cz) = bus_point(c, corner, prev)
      let (nx, _, nz) = bus_point(c, next, corner)
      let u = (if junction == index do t +. 0.2 else t -. 0.8 end) /. 0.4
      let v = 1.0 -. u
      (cx +. 0.2 *. (v *. v *. (px -. cx) +. u *. u *. (nx -. cx)),
       cz +. 0.2 *. (v *. v *. (pz -. cz) +. u *. u *. (nz -. cz)))
    else (ax +. (bx -. ax) *. t, az +. (bz -. az) *. t) end
    end
  end
  pfn turnaround_lane() : Float do 6.0 end
  fn turnaround_pose(from : Int, lot : Int, angle : Float) : (Float, Float, Float, Float) do
    let x = int_to_float(lot % S.width() * 32 + 16)
    let z = int_to_float(lot / S.width() * 32 + 16)
    let dx = int_to_float(lot % S.width() - from % S.width())
    let dz = int_to_float(lot / S.width() - from / S.width())
    let advance = turnaround_lane() *. Math.sin(angle)
    let side = turnaround_lane() *. Math.cos(angle)
    (x +. dx *. advance -. dz *. side, z +. dz *. advance +. dx *. side,
     dx *. Math.cos(angle) +. dz *. Math.sin(angle), dz *. Math.cos(angle) -. dx *. Math.sin(angle))
  end
  pfn bus_lane_point(c : Ur.Sim.City, trip : Ur.Food.Trip, i : Int, j : Int, index : Int, t : Float, forward : Bool, bulb : Bool) : (Float, Float) do
    let (x, z) = bus_xy(c, trip, i, j, index, t)
    let low = if t < 0.01 do 0.0 else t -. 0.01 end
    let high = if t > 0.99 do 1.0 else t +. 0.01 end
    let (ax, az) = bus_xy(c, trip, i, j, index, low)
    let (bx, bz) = bus_xy(c, trip, i, j, index, high)
    let dx = bx -. ax
    let dz = bz -. az
    let magnitude = math_sqrt(dx *. dx +. dz *. dz)
    let sign = if forward do 1.0 else -1.0 end
    let taper = if trip.mode == 9 && index == 0 do
        if t < 0.55 do 0.0 else (t -. 0.55) /. 0.45 end
      else if trip.mode == 9 && index == trip.legs - 1 do
        if t > 0.45 do 0.0 else (0.45 -. t) /. 0.45 end
      else if index == 0 && t < 0.35 do t /. 0.35
      else if !bulb && index == trip.legs - 1 && t > 0.65 do (1.0 -. t) /. 0.35 else 1.0 end end end end
    let spread = if bulb && t > 0.5 do
      let u = (t -. 0.5) *. 2.0
      (turnaround_lane() -. 3.0) *. u *. u *. (3.0 -. 2.0 *. u)
    else 0.0 end
    let offset = if magnitude > 0.0001 do (taper *. 3.0 +. spread) *. sign /. magnitude else 0.0 end
    (x -. dz *. offset, z +. dx *. offset)
  end
  pfn bus_pose(c : Ur.Sim.City, trip : Ur.Food.Trip, i : Int, j : Int, index : Int, t : Float, forward : Bool, rotation : Float, slot : Int, section : Bool) : Unit do
    let bulb = trip.mode == 2 && index == trip.legs - 1 && S.span_distance(i, j) == 1 &&
      S.motor_street(c, j) && S.street_end_arm(c, j) == S.direction(j, i)
    let (x, z) = bus_lane_point(c, trip, i, j, index, t, forward, bulb)
    let low = if t < 0.01 do 0.0 else t -. 0.01 end
    let high = if t > 0.99 do 1.0 else t +. 0.01 end
    let (ax, az) = bus_lane_point(c, trip, i, j, index, low, forward, bulb)
    let (bx, bz) = bus_lane_point(c, trip, i, j, index, high, forward, bulb)
    let dx = bx -. ax
    let dz = bz -. az
    let (_, ay, _) = bus_point(c, i, j)
    let (_, end_y, _) = bus_point(c, j, i)
    let grade = S.grade_link(c, i, j)
    let height_t = if trip.mode == 2 && S.get(c.plants, i) == 23 do
      -- Keep the bus level through the bay. Blend to the street beyond the parcel edge.
      let edge = (16.0 -. bus_depot_mouth()) /. (32.0 -. bus_depot_mouth())
      if t <= edge do 0.0 else (t -. edge) /. (1.0 -. edge) end
    else t end
    let y = if grade do S.grade_surface(c, i, j, t) +. 2.0 else ay +. (end_y -. ay) *. height_t end
    if bulb && t >= 1.0 do
      let (x, z, dx, dz) = turnaround_pose(i, j, rotation)
      posed_vehicle(slot, vehicle_mesh(2), x, y, z, dx, dz, 10.0, 5.0)
    else if grade && covered_lane(c, i, x, z, section) do Vk.chunk_free(slot)
    else
      let front_x = dx *. Math.cos(rotation) -. dz *. Math.sin(rotation)
      let front_z = dz *. Math.cos(rotation) +. dx *. Math.sin(rotation)
      if trip.mode == 9 do posed_vehicle(slot, delivery_mesh(9), x, y, z, front_x, front_z, 11.0, 6.0)
      else posed_vehicle(slot, vehicle_mesh(2), x, y, z, front_x, front_z, 10.0, 5.0) end
    end end
  end
  pfn trip_pose(c : Ur.Sim.City, trip : Ur.Food.Trip, step : Float, forward : Bool, rotation : Float, slot : Int, section : Bool) : Unit do
    let index = S.clamp(float_to_int(step), 0, trip.legs - 1)
    let t = step -. int_to_float(index)
    let (i, j) = Ur.Food.leg(trip.stops, index)
    let ix = i % S.width()
    let iz = i / S.width()
    let dx = j % S.width() - ix
    let dz = j / S.width() - iz
    let farm = trip.mode == 7
    let ferry = trip.mode == 6 && S.get(c.ferries, i) == j + 1
    let boat = trip.mode == 8 || ferry
    let east = !farm && dx != 0
    let progress = t *. 32.0
    let x = ix * 32 + (if farm do 0 else if east do (if boat do 8 else 10 end) else 13 end end) + float_to_int(int_to_float(dx) *. progress)
    let z = iz * 32 + (if farm do 2 + float_to_int(t *. 19.0) else if east do 13 else if boat do 8 else 10 end end end) + float_to_int(int_to_float(dz) *. progress)
    let h = S.get(c.heights, i)
    let y = if boat do 1 else h + 2 + float_to_int(int_to_float(S.get(c.heights, j) - h) *. t) end
    if trip.mode == 4 || (ferry && S.get(c.canal_docks, i) > 0) do Vk.chunk_free(slot)
    else if trip.mode == 3 do
      let direction = if forward do 1.0 else -1.0 end
      posed_vehicle(slot, vehicle_mesh(3),
        int_to_float(ix * 32 + 16) +. int_to_float(dx * 32) *. t, int_to_float(y + 1),
        int_to_float(iz * 32 + 16) +. int_to_float(dz * 32) *. t,
        int_to_float(dx) *. direction, int_to_float(dz) *. direction, 16.0, 5.0)
    else if trip.mode == 2 || (trip.mode == 9 && (index == 0 || index == trip.legs - 1 || (index == 1 && t < 0.2) || (index == trip.legs - 2 && t > 0.8))) do bus_pose(c, trip, i, j, index, t, forward, rotation, slot, section)
    else if (trip.mode == 6 || trip.mode == 9) && !ferry do delivery_pose(c, trip, i, j, index, t, forward, slot, section) else
      if farm do
        let facing = if forward do 1.0 else -1.0 end
        posed_vehicle(slot, delivery_mesh(7), int_to_float(x + 3), int_to_float(y), int_to_float(z + 4),
          0.0, facing, 8.0, 6.0)
      else if trip.mode == 8 do
        let along = if index == 0 do 24.0 +. t *. 8.0 else t *. 32.0 end
        let x = int_to_float(ix * 32 + 16) +. int_to_float(dx) *. along
        let z = int_to_float(iz * 32 + 16) +. int_to_float(dz) *. along
        let facing = if forward || rotation > 0.0 do 1.0 else -1.0 end
        let mesh = fishing_net(vessel_mesh(true, true), float_to_int(rotation *. 7.0))
        pose_vehicle(slot, mesh, x, 1.0, z, int_to_float(dx) *. facing, int_to_float(dz) *. facing, 15.0, 6.0, false, false)
      else
        let m = vessel_mesh(true, east)
        if Vk.chunk_begin(slot, x, y, z, 0) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do ()
        else Ur.AppError.stop("Food vehicle upload failed") end
      end end
    end end end end
  end
  type SanitationMoment = { run : Ur.Sim.WasteRun, step : Float, stage : Int, load : Int, start : Bool }
  type SanitationShift = { pickup : Int, driver : Int, completed : List(Int) }
  fn empty_sanitation() : SanitationShift do { pickup: -1, driver: -1, completed: Nil } end
  pfn sanitation_weight(run : Ur.Sim.WasteRun) : Int do List.length(run.route) + 2 end
  pfn sanitation_stop(route : List(Int), lot : Int, i : Int) : Int do
    match route do
      Nil -> i
      Cons(a, rest) -> if a == lot do i else sanitation_stop(rest, lot, i + 1) end
    end
  end
  pfn sanitation_window(c : Ur.Sim.City, runs : List(Ur.Sim.WasteRun), shift : Float) : Option(SanitationMoment) do
    match runs do
      Nil -> None
      Cons(run, rest) ->
        let window = int_to_float(sanitation_weight(run))
        if shift >= window do sanitation_window(c, rest, shift -. window)
        else if shift >= window -. 0.35 || !S.waste_route_open(c, run) do None
        else
          let legs = List.length(run.route) - 1
          let curb = S.waste_storage_road(c, run.pickup)
          let pickup_wait = if S.get(c.waste_bins, curb) == 2 do 0.65 else 1.7 end
          let unload_wait = 1.35
          let travel = shift /. (window -. 0.35) *. (int_to_float(legs) +. pickup_wait +. unload_wait)
          let pickup = int_to_float(run.pickup_leg)
          let disposal = int_to_float(sanitation_stop(run.route, run.site, 0))
          let quantity = int_to_float(run.units)
          let (step, stage, load) = if travel < pickup do (travel, 0, 0)
            else if travel < pickup +. pickup_wait do
              (pickup, 1, float_to_int(quantity *. (travel -. pickup) /. pickup_wait))
            else if travel < disposal +. pickup_wait do (travel -. pickup_wait, 2, run.units)
            else if travel < disposal +. pickup_wait +. unload_wait do
              (disposal, 3, float_to_int(quantity *. (disposal +. pickup_wait +. unload_wait -. travel) /. unload_wait))
            else (travel -. pickup_wait -. unload_wait, 4, 0) end end end end
          Some({ run: run, step: step, stage: stage, load: load, start: shift < 0.09 *. window })
        end end
    end
  end
  fn sanitation_moment(c : Ur.Sim.City, phase : Float) : Option(SanitationMoment) do
    let hour = phase /. S.day_seconds() *. 24.0
    if hour < 10.0 || hour >= 20.0 do None else
      let length = List.fold_left(c.waste_runs, 0, fn (total, run) -> total + sanitation_weight(run))
      -- the crew's pace in the rain where its round starts
      let start = match c.waste_runs do
        Cons(run, _) -> run.pickup
        Nil -> -1
      end
      sanitation_window(c, c.waste_runs, (hour -. 10.0) /. 10.0 *. int_to_float(length) *. S.rain_road_pace(c, start))
    end
  end
  pfn sanitation_shift_with(c : Ur.Sim.City, old_phase : Float, prior : SanitationShift, moment : Option(SanitationMoment),
    drivers : Int -> List(Ur.Citizens.Citizen), prior_crew : List(Ur.Citizens.Citizen)) : SanitationShift do
    let pickup = match moment do
      Some(m) -> m.run.pickup
      None -> -1
    end
    let still_assigned = match moment do
      Some(m) -> List.any(prior_crew, fn person -> person.id == prior.driver && person.work == m.run.depot && person.work_position >= 2)
      None -> false
    end
    if prior.pickup == pickup && still_assigned do prior else
      let completed = if prior.driver >= 0 do
        match sanitation_moment(c, old_phase) do
          Some(old) -> if old.run.pickup == prior.pickup && old.stage == 4 && prior.pickup != pickup do Cons(prior.pickup, prior.completed) else prior.completed end
          None -> prior.completed
        end
      else prior.completed end
      let driver = match moment do
        Some(m) ->
          if m.start && !List.any(completed, fn site -> site == m.run.pickup) do
            Ur.Citizens.sanitation_driver(drivers(m.run.depot), m.run.depot, m.run.pickup)
          else -1 end
        None -> -1
      end
      { pickup: pickup, driver: driver, completed: completed }
    end
  end
  fn sanitation_shift(c : Ur.Sim.City, old_phase : Float, prior : SanitationShift, moment : Option(SanitationMoment), people : List(Ur.Citizens.Citizen)) : SanitationShift do
    sanitation_shift_with(c, old_phase, prior, moment, fn _ -> people, people)
  end
  fn sanitation_shift_indexed(c : Ur.Sim.City, old_phase : Float, prior : SanitationShift, moment : Option(SanitationMoment), roster : Ur.Citizens.Roster) : SanitationShift do
    sanitation_shift_with(c, old_phase, prior, moment, fn depot -> Ur.Citizens.at_parcel(roster, depot), roster.crew)
  end
  type TruckPose = { x : Float, y : Float, z : Float, dx : Float, dz : Float, visible : Bool }
  pfn sanitation_vehicle(c : Ur.Sim.City, m : SanitationMoment, section : Bool) : TruckPose do
    let trip = { mode: 9, source: m.run.depot, stops: m.run.route, legs: List.length(m.run.route) - 1 }
    let leg = S.clamp(float_to_int(m.step), 0, trip.legs - 1)
    let t = m.step -. int_to_float(leg)
    let (a, b) = Ur.Food.leg(trip.stops, leg)
    let (x, z) = bus_lane_point(c, trip, a, b, leg, t, true, false)
    let low = if t < 0.01 do 0.0 else t -. 0.01 end
    let high = if t > 0.99 do 1.0 else t +. 0.01 end
    let (ax, az) = bus_lane_point(c, trip, a, b, leg, low, true, false)
    let (bx, bz) = bus_lane_point(c, trip, a, b, leg, high, true, false)
    let (_, ay, _) = bus_point(c, a, b)
    let (_, end_y, _) = bus_point(c, b, a)
    let grade = S.grade_link(c, a, b)
    let y = if grade do S.grade_surface(c, a, b, t) +. 2.0 else ay +. (end_y -. ay) *. t end
    { x: x, y: y, z: z, dx: bx -. ax, dz: bz -. az, visible: !grade || !covered_lane(c, a, x, z, section) }
  end
  fn sanitation_traffic(c : Ur.Sim.City, moment : Option(SanitationMoment), driver : Int,
    roads : Ur.Lift.ServiceRoads) : (Option(SanitationMoment), Ur.Lift.ServiceRoads) do
    match moment do
      Some(m) ->
        if driver < 0 do (moment, roads) else
          let (at, roads) = Ur.Lift.service_drive(c, roads, sanitation_slot(), m.run.route, m.step)
          (Some({ m with step: at }), roads)
        end
      None -> (None, roads)
    end
  end
  fn sanitation_position(moment : Option(SanitationMoment), roads : Ur.Lift.ServiceRoads) : Option(SanitationMoment) do
    Option.map(moment, fn m -> { m with step: Ur.Lift.service_position(roads, sanitation_slot(), m.step) })
  end
  fn sanitation_truck(c : Ur.Sim.City, moment : Option(SanitationMoment), driver : Int, night : Bool, section : Bool) : Unit do
    let slot = sanitation_slot()
    match moment do
      Some(m) ->
        if driver < 0 do Vk.chunk_free(slot) else
          let p = sanitation_vehicle(c, m, section)
          if p.visible do pose_vehicle(slot, trash_truck_mesh(), p.x, p.y, p.z, p.dx, p.dz, 11.0, 6.0, night, true)
          else Vk.chunk_free(slot) end
        end
      None -> Vk.chunk_free(slot)
    end
  end
  type Projection = { w : Float, h : Float, cx : Float, cz : Float, zoom : Float, yaw : Float }
  fn world_point(view : Projection, x : Float, y : Float, z : Float) : (Float, Float) do
    let x = x *. 0.25 -. view.cx
    let y = y *. 0.25 -. 3.0
    let z = z *. 0.25 -. view.cz
    let sy = Math.sin(view.yaw)
    let cy = Math.cos(view.yaw)
    let scale = view.w /. (2.0 *. view.zoom)
    (view.w *. 0.5 +. (x *. cy -. z *. sy) *. scale,
     view.h *. 0.5 -. (y *. 0.795 -. (x *. sy +. z *. cy) *. 0.607) *. scale)
  end
  pfn road_snap_at(c : Ur.Sim.City, view : Projection, lot : Int, mx : Float, my : Float, best : Int, distance : Float) : (Int, Float) do
    if !S.valid(lot) || S.get(c.heights, lot) == 0 do (best, distance) else
      let code = S.get(c.road_shapes, lot)
      let (lx, lz) = if code == 0 do (16.0, 16.0) else Ur.RoadShape.sample(Ur.RoadShape.decode(code), 0.5) end
      let (x, y) = world_point(view, int_to_float(lot % S.width() * 32) +. lx,
        int_to_float(S.get(c.heights, lot)), int_to_float(lot / S.width() * 32) +. lz)
      let square = (mx -. x) *. (mx -. x) +. (my -. y) *. (my -. y)
      if square < distance || (square == distance && (best < 0 || lot < best)) do (lot, square) else (best, distance) end
    end
  end
  pfn nearby_streets(c : Ur.Sim.City, base : Int, radius : Int) : List(Int) do
    let x = base % S.width()
    let z = base / S.width()
    List.flat_map(List.range(0, radius * 2 + 1), fn dx ->
      List.filter_map(List.range(0, radius * 2 + 1), fn dz ->
        let x = x + dx - radius
        let z = z + dz - radius
        let i = S.index(x, z)
        if x < 0 || x >= S.width() || z < 0 || z >= S.depth() || S.get(c.roads, i) == 0 do None else Some(i) end))
  end
  fn road_snap(c : Ur.Sim.City, view : Projection, base : Int, from : Int, mx : Float, my : Float, straight : Bool) : Int do
    if !S.valid(base) do -1 else
    let radius = 1
    let scale = view.w *. 1.45 /. view.zoom
    let pixels = if scale > 18.0 do 18.0 else if scale < 5.0 do 5.0 else scale end end
    let threshold = pixels *. pixels
    let streets = nearby_streets(c, base, radius)
    let (best, _) = List.fold_left(streets, (-1, threshold), fn (result, lot) ->
      let (best, distance) = result
      if straight && Ur.Build.straight_target(from, lot) != lot do result
      else road_snap_at(c, view, lot, mx, my, best, distance) end)
    if S.valid(best) || straight || !S.valid(from) do best else
      let a = S.index(base % S.width(), from / S.width())
      let b = S.index(from % S.width(), base / S.width())
      let (best, distance) = if S.span_distance(a, base) <= radius do road_snap_at(c, view, a, mx, my, -1, threshold) else (-1, threshold) end
      let (best, _) = if S.span_distance(b, base) <= radius do road_snap_at(c, view, b, mx, my, best, distance) else (best, distance) end
      best
    end end
  end
  pfn closest_sidewalk(c : Ur.Sim.City, view : Projection, lot : Int, mx : Float, my : Float, spot : Int, best : Int, distance : Float) : Int do
    if spot == 4 do best else
      let (x, z) = S.sidewalk_point(c, lot, spot)
      if x < 0 do best else
        let (px, py) = world_point(view, int_to_float(lot % S.width() * 32 + x), int_to_float(S.get(c.heights, lot) + 2), int_to_float(lot / S.width() * 32 + z))
        let dx = px -. mx
        let dy = py -. my
        let delta = dx *. dx +. dy *. dy
        if delta < distance do closest_sidewalk(c, view, lot, mx, my, spot + 1, spot, delta)
        else closest_sidewalk(c, view, lot, mx, my, spot + 1, best, distance) end
      end
    end
  end
  fn sidewalk_pick(c : Ur.Sim.City, view : Projection, lot : Int, mx : Float, my : Float) : Int do
    if !S.valid(lot) do -1 else
      let radius = view.w /. (2.0 *. view.zoom)
      let radius = if radius < 7.0 do 7.0 else radius end
      closest_sidewalk(c, view, lot, mx, my, 0, -1, radius *. radius)
    end
  end
  pfn sidewalk_marker_faces(c : Ur.Sim.City, lot : Int, selected : Int, valid : Bool, spot : Int, mesh : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if spot == 4 do mesh else
      let (x, z) = S.sidewalk_point(c, lot, spot)
      let mesh = if x < 0 do mesh else
        let size = if spot == selected do 3 else 1 end
        let colour = if spot == selected do (if valid do 20 else 30 end) else 17 end
        face(mesh, x - size / 2, 0, z - size / 2, size, size, 0, colour)
      end
      sidewalk_marker_faces(c, lot, selected, valid, spot + 1, mesh)
    end
  end
  fn sidewalk_marker(c : Ur.Sim.City, lot : Int, spot : Int, valid : Bool) : Unit do
    let slot = marker_slot()
    let (x, _) = S.sidewalk_point(c, lot, 0)
    if x < 0 do Vk.chunk_free(slot) else
      let mesh = sidewalk_marker_faces(c, lot, spot, valid, 0, { words: NativeArray.make_i32(8, 0), quads: 0 })
      if Vk.chunk_begin(slot, lot % S.width() * 32, S.get(c.heights, lot) + 2, lot / S.width() * 32, 0) &&
        Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
      else Ur.AppError.stop("Sidewalk preview upload failed") end
    end
  end
  fn sanitation_point(c : Ur.Sim.City, view : Projection, moment : Option(SanitationMoment), driver : Int, section : Bool) : (Float, Float) do
    match moment do
      Some(m) ->
        let p = sanitation_vehicle(c, m, section)
        if driver >= 0 && p.visible do world_point(view, p.x, p.y +. 3.0, p.z) else (-1000.0, -1000.0) end
      None -> (-1000.0, -1000.0)
    end
  end
  pfn food_vehicle(c : Ur.Sim.City, trip : Ur.Food.Trip, time : Float, slot : Int, section : Bool) : Unit do
    if trip.mode == 8 && trip.legs == 0 do
      trip_pose(c, { trip with legs: 1 }, 0.0, false, 0.0, slot, section)
    else
      let legs = if trip.mode == 8 do Ur.Lift.fishing_legs(c, List.drop(trip.stops, 1), 0) else trip.legs end
      let trip = { trip with legs: legs }
      if trip.legs == 0 do Vk.chunk_free(slot) else
        let span = int_to_float(trip.legs)
        let speed = if trip.mode == 8 do 0.42 else 0.38 end
        let phase = (time *. speed +. int_to_float(trip.source % 13) *. 0.21) /. (span *. 2.0)
        let fraction = phase -. Math.floor(phase)
        let (step, forward, net) = match Map.get(c.lift_vessels, S.count() + trip.source, Map.int_cmp) do
          Some(phase) ->
            let (position, outward) = S.vessel_position(phase)
            let net = if trip.mode == 8 && !outward && position >= 1.0 && phase.moored > 0.0 do
              Math.sin(phase.moored /. 3.0 *. 3.14159265)
            else 0.0 end
            (position *. span, outward, net)
          None ->
            let forward = fraction < 0.5
            ((if forward do fraction else 1.0 -. fraction end) *. span *. 2.0, forward, 0.0)
        end
        trip_pose(c, trip, step, forward, net, slot, section)
      end
    end
  end
  pfn clear_fleet(active : List(Ur.Fleet.Run), old : List(Ur.Fleet.Run)) : Unit do
    match old do
      Nil -> ()
      Cons(run, rest) ->
        if List.any(active, fn next -> next.slot == run.slot) do () else Vk.chunk_free(fleet_slot(run.slot)) end
        clear_fleet(active, rest)
    end
  end
  pfn draw_fleet(c : Ur.Sim.City, active : List(Ur.Fleet.Run), section : Bool) : Unit do
    match active do
      Nil -> ()
      Cons(run, rest) ->
        let forward = Ur.Fleet.forward(run.trip, run.progress)
        let rotation = if run.trip.mode == 2 do Ur.Fleet.bus_rotation(run) else 0.0 end
        trip_pose(c, run.trip, Ur.Fleet.position(run.trip, run.progress), forward, rotation, fleet_slot(run.slot), section)
        draw_fleet(c, rest, section)
    end
  end
  fn fleet(c : Ur.Sim.City, active : List(Ur.Fleet.Run), old : List(Ur.Fleet.Run), section : Bool) : Unit do
    clear_fleet(active, old)
    draw_fleet(c, active, section)
  end
  fn food_vehicles(c : Ur.Sim.City, trips : List(Ur.Food.Trip), old : List(Ur.Food.Trip), time : Float, index : Int, section : Bool) : Unit do
    let slot = food_slot(index)
    let tail = match old do
      Cons(_, rest) -> rest
      Nil -> Nil
    end
    match trips do
      Cons(trip, rest) ->
        food_vehicle(c, trip, time, slot, section)
        food_vehicles(c, rest, tail, time, index + 1, section)
      Nil -> match old do
        Nil -> ()
        Cons(_, rest) ->
          Vk.chunk_free(slot)
          food_vehicles(c, Nil, rest, time, index + 1, section)
      end
    end
  end
  pfn walking_point(c : Ur.Sim.City, i : Int, peer : Int, side : Int) : (Int, Int, Int) do
    let x = i % S.width()
    let z = i / S.width()
    let dx = peer % S.width() - x
    let dz = peer / S.width() - z
    let height = S.get(c.heights, i)
    let deck = if height == 0 do 2 else height end
    if S.canal_water(c, i) do (x * 32 + side, z * 32 + side, deck + 2)
    else if S.get(c.road_shapes, i) > 0 do
      let shape = Ur.RoadShape.decode(S.get(c.road_shapes, i))
      let (lx, lz) = Ur.RoadShape.sample(shape, 0.5)
      let (tx, tz) = Ur.RoadShape.tangent(shape, 0.5)
      let (tx, tz) = unit_direction(tx, tz, 1.0, 0.0)
      let towards_peer = int_to_float(dz) *. tx -. int_to_float(dx) *. tz
      let width = int_to_float(S.road_half_width(S.get(c.roads, i)) + 1)
      let width = if towards_peer < 0.0 do 0.0 -. width else width end
      (x * 32 + float_to_int(lx -. tz *. width), z * 32 + float_to_int(lz +. tx *. width), deck + 2)
    else if S.get(c.parks, i) > 0 || S.get(c.parks, peer) > 0 do (x * 32 + 16, z * 32 + 16, deck + 2)
    else if S.get(c.roads, i) > 0 do (x * 32 + side, z * 32 + side, deck + 2)
    else if S.get(c.transit, i) == 1 do (x * 32 + 16, z * 32 + 16, deck + 2)
    else (x * 32 + 16 + dx * 13, z * 32 + 16 + dz * 13, deck + 2) end end end end end
  end
  -- The height walking_point gives lot [i].
  pfn walking_height(c : Ur.Sim.City, i : Int) : Int do
    let height = S.get(c.heights, i)
    (if height == 0 do 2 else height end) + 2
  end
  pfn school_point(c : Ur.Sim.City, lot : Int, peer : Int, side : Int, door : Bool) : (Int, Int, Int) do
    let x = lot % S.width() * 32
    let z = lot / S.width() * 32
    let height = S.get(c.heights, lot) + 2
    let rank = S.program_at(c, lot)
    let front = if rank >= 4 do L.faculty_frontage(c, lot, S.campus_root(c, lot), 0) else L.frontage(c, lot, 0) end
    let edge = if S.valid(peer) do S.direction(lot, peer) else front end
    let inset = if rank == 0 do 9 else if rank >= 3 do 4 else 6 end end
    let door_x = if rank == 2 do 10 else 16 end
    if S.campus_quad(c, lot) do (x + (if side == 3 do 15 else 17 end), z + (if side == 3 do 15 else 17 end), height)
    else if door && rank >= 0 && edge == front do
      match front do
        0 -> (x + inset, z + door_x, height)
        1 -> (x + 31 - inset, z + 31 - door_x, height)
        2 -> (x + 31 - door_x, z + inset, height)
        _ -> (x + door_x, z + 31 - inset, height)
      end
    else if rank >= 0 || S.valid(S.campus_root(c, lot)) do
      match edge do
        0 -> (x + 2, z + 16, height)
        1 -> (x + 30, z + 16, height)
        2 -> (x + 16, z + 2, height)
        _ -> (x + 16, z + 30, height)
      end
    else walking_point(c, lot, peer, side) end end end
  end
  pfn walk_lerp(ax : Int, az : Int, bx : Int, bz : Int, t : Float) : (Int, Int) do
    (ax + float_to_int(int_to_float(bx - ax) *. t), az + float_to_int(int_to_float(bz - az) *. t))
  end
  pfn school_walk(c : Ur.Sim.City, person : Ur.Citizens.Citizen, a : Int, b : Int, side : Int, t : Float) : (Int, Int, Int) do
    let prev = person.previous
    let transfer = S.valid(prev) && (S.program_at(c, a) >= 0 || S.valid(S.campus_root(c, a))) &&
      !S.campus_quad(c, a) && S.direction(a, prev) != S.direction(a, b)
    let (ax, az, ay) = school_point(c, a, b, side, !S.valid(prev))
    let (bx, bz, end_y) = school_point(c, b, a, side, b == person.target)
    if !transfer do
      let (x, z) = walk_lerp(ax, az, bx, bz, t)
      (x, z, ay + float_to_int(int_to_float(end_y - ay) *. t))
    else
      let (px, pz, _) = school_point(c, a, prev, side, false)
      let side_x = S.direction(a, prev) < 2
      let other_x = S.direction(a, b) < 2
      let edge_x = a % S.width() * 32 + side
      let edge_z = a / S.width() * 32 + side
      let (cx, cz) = if side_x != other_x do (if side_x do px else ax end, if side_x do az else pz end)
        else if side_x do (px, edge_z) else (edge_x, pz) end end
      let (dx, dz) = if side_x != other_x do (cx, cz)
        else if side_x do (ax, edge_z) else (edge_x, az) end end
      let (x, z) = if t < 0.20 do walk_lerp(px, pz, cx, cz, t /. 0.20)
        else if t < 0.40 do walk_lerp(cx, cz, dx, dz, (t -. 0.20) /. 0.20)
        else if t < 0.60 do walk_lerp(dx, dz, ax, az, (t -. 0.40) /. 0.20)
        else walk_lerp(ax, az, bx, bz, (t -. 0.60) /. 0.40) end end end
      let y = ay + float_to_int(int_to_float(end_y - ay) *. (if t < 0.60 do 0.0 else (t -. 0.60) /. 0.40 end))
      (x, z, y)
    end
  end
  pfn walking_to_car(c : Ur.Sim.City, person : Ur.Citizens.Citizen, progress : Float, a : Int, b : Int, side : Int) : Option((Int, Int, Int)) do
    if person.car_phase != 1 && person.car_phase != 2 do None else
      let leaving = person.car_phase == 1 && progress < 0.5
      let parking = if leaving do person.parking else person.arrival end
      match Ur.Citizens.parking_at(parking) do
        Some(p) ->
          let arrived = person.car_phase == 2 && progress >= 0.5 && p.road == a
          if !(arrived || (leaving && p.road == b)) do None else
            let (x, z, y) = if leaving do walking_point(c, a, b, side) else walking_point(c, b, a, side) end
            let pose = parked_pose(c, p)
            let t = if leaving do progress *. 2.0 else (1.0 -. progress) *. 2.0 end
            Some((x + float_to_int((pose.x -. int_to_float(x)) *. t),
              z + float_to_int((pose.z -. int_to_float(z)) *. t), y + float_to_int((pose.y -. int_to_float(y)) *. t)))
          end
        None -> None
      end
    end
  end
  pfn sidewalk_pose(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, a : Int, b : Int, t : Float, lane : Float) : (Float, Float, Float, Float) do
    street_pose_turn(c, a, b, t, lane, Ur.Citizens.walk_turn(map, if t < 0.5 do a else b end))
  end
  pfn walker_position(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, person : Ur.Citizens.Citizen, a : Int, b : Int) : (Int, Int, Int) do
    walker_position_at(c, map, person, person.progress, a, b)
  end
  -- The walker's position as if its progress were [t].
  pfn walker_position_at(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, person : Ur.Citizens.Citizen, t : Float, a : Int, b : Int) : (Int, Int, Int) do
    let side = if person.id % 2 == 0 do 3 else 29 end
    let ay = walking_height(c, a)
    let height_b = walking_height(c, b)
    let (x, z) = if S.get(c.roads, a) > 0 && S.get(c.roads, b) > 0 do
      let width_a = Ur.Citizens.walk_width(map, a)
      let width_b = Ur.Citizens.walk_width(map, b)
      let offset = int_to_float(width_a) +. int_to_float(width_b - width_a) *. t
      let sign = if person.id % 2 == 0 do 1.0 else -1.0 end
      let next_is_park = match person.route do
        Cons(_, Cons(_, Cons(next, _))) -> S.get(c.parks, next) > 0
        _ -> false
      end
      let blend = if person.park_trip && S.get(c.parks, person.previous) > 0 && t < 0.5 do t *. 2.0
        else if person.park_trip && next_is_park && t > 0.5 do (1.0 -. t) *. 2.0 else 1.0 end end
      let entry_arm = S.direction(b, a)
      let enters = person.car_phase != 2 && Ur.Citizens.walk_junction(map, b) && Ur.Citizens.walk_arm(map, b, entry_arm)
      let (bx, bz) = Ur.Citizens.corner_for(entry_arm, if sign > 0.0 do -1 else 1 end)
      let (bx, bz) = (b % S.width() * 32 + bx, b / S.width() * 32 + bz)
      let lane = offset *. sign *. blend
      match Ur.Citizens.walk_corners(map, person, a, b) do
        None ->
          if !enters do
            let (x, z, _, _) = sidewalk_pose(c, map, a, b, t, lane)
            (float_to_int(x), float_to_int(z))
          else
            let (px, pz, _, _) = sidewalk_pose(c, map, a, b, t *. 0.60, lane)
            let (qx, qz, _, _) = sidewalk_pose(c, map, a, b, 0.60, lane)
            (float_to_int(px +. (int_to_float(bx) -. qx) *. t), float_to_int(pz +. (int_to_float(bz) -. qz) *. t))
          end
        Some((sx, sz, ex, ez)) ->
          let step = Ur.Citizens.crossing_step()
          let x0 = a % S.width() * 32
          let z0 = a / S.width() * 32
          if t < step do walk_lerp(x0 + sx, z0 + sz, x0 + ex, z0 + sz, t /. step)
          else if t < step *. 2.0 do walk_lerp(x0 + ex, z0 + sz, x0 + ex, z0 + ez, (t -. step) /. step)
          else
            let tail = (t -. step *. 2.0) /. (1.0 -. step *. 2.0)
            let (px, pz, _, _) = sidewalk_pose(c, map, a, b, (if enters do 0.40 +. tail *. 0.20 else 0.40 +. tail *. 0.60 end), lane)
            let (ax, az, _, _) = sidewalk_pose(c, map, a, b, 0.40, lane)
            let (qx, qz, _, _) = sidewalk_pose(c, map, a, b, 0.60, lane)
            let (end_dx, end_dz) = if enters do (int_to_float(bx) -. qx, int_to_float(bz) -. qz) else (0.0, 0.0) end
            (float_to_int(px +. (int_to_float(x0 + ex) -. ax) *. (1.0 -. tail) +. end_dx *. tail),
             float_to_int(pz +. (int_to_float(z0 + ez) -. az) *. (1.0 -. tail) +. end_dz *. tail))
          end end
      end
    else
      let (ax, az, _) = walking_point(c, a, b, side)
      let (bx, bz, _) = walking_point(c, b, a, side)
      (ax + float_to_int(int_to_float(bx - ax) *. t), az + float_to_int(int_to_float(bz - az) *. t))
    end
    let y = ay + float_to_int(int_to_float(height_b - ay) *. t)
    let campus = person.study >= 0 && a != b && (S.program_at(c, a) >= 0 || S.program_at(c, b) >= 0 ||
      S.valid(S.campus_root(c, a)) || S.valid(S.campus_root(c, b)))
    let (x, z, y) = if campus do school_walk(c, person, a, b, side, t)
      else if a == b && person.study >= 0 && person.activity == 1 do school_point(c, a, person.previous, side, true)
      else (x, z, y) end end
    match walking_to_car(c, person, t, a, b, side) do
      Some(at) -> at
      None -> (x, z, y)
    end
  end
  pfn walker_template_base() : Int do 6 * S.count() + 640 end
  pfn walker_templates() : Int do 3 * 4 * 3 * 2 * 2 end
  pfn walker_mesh(kind : Int, coat_index : Int, skin_index : Int, hair : Int, gait : Int) : Ur.SceneMesh.Mesh do
    let coat = match coat_index do
      0 -> 6
      1 -> 7
      2 -> 8
      _ -> 10
    end
    let skin = match skin_index do
      0 -> 5
      1 -> 18
      _ -> 1
    end
    let m = { words: NativeArray.make_i32(144, 0), quads: 0 }
    let m = box(m, 0, 0, gait, 1, 1, 1, 4)
    let m = box(m, 1, 0, 1 - gait, 1, 1, 1, 4)
    let m = box(m, 0, 1, gait, 1, 1, 1, 19)
    let m = box(m, 1, 1, 1 - gait, 1, 1, 1, 19)
    let m = box(m, 0, 2, 0, 2, 2, 2, coat)
    let m = box(m, 0, 4, 0, 2, 1, 2, skin)
    let m = box(m, 0, 5, 0, 2, 1, 2, if hair == 0 do 7 else 13 end)
    if kind == 2 do
      box(box(m, 0, 2, 2, 2, 2, 1, 7), 1, 3, 3, 1, 1, 1, 5)
    else if kind == 1 do
      box(box(m, 0, 2, 2, 2, 2, 1, 19), 1, 3, 3, 1, 1, 1, 10)
    else m end end
  end
  fn setup_citizens(i : Int) : Unit do
    if i >= walker_templates() do () else
      let m = walker_mesh(i / 48, i / 12 % 4, i / 4 % 3, i / 2 % 2, i % 2)
      let slot = walker_template_base() + i
      if Vk.chunk_begin(slot, 0, 0, 0, 0) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do
        Vk.chunk_show(slot, false)
        setup_citizens(i + 1)
      else Ur.AppError.stop("Walker template upload failed") end
    end
  end
  pfn citizen_walker(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, person : Ur.Citizens.Citizen, progress : Float, a : Int, b : Int, slot : Int) : Unit do
    let (x, z, y) = walker_position_at(c, map, person, progress, a, b)
    let kind = if Ur.Citizens.emergency_move(person) do 2 else if person.study >= 0 do 1 else 0 end end
    let coat = if kind == 2 do 3 else person.id % 4 end
    let skin = person.id / 5 % 3
    let hair = if person.id % 3 == 0 do 0 else 1 end
    let gait = float_to_int(progress *. 12.0) % 2
    let prototype = walker_template_base() + kind * 48 + coat * 12 + skin * 4 + hair * 2 + gait
    if Vk.chunk_instance(slot, prototype, x - 1, y, z - 1) do ()
    else Ur.AppError.stop("Walker instance upload failed") end
  end
  type CarPose = { x : Float, y : Float, z : Float, dx : Float, dz : Float }
  pfn parked_pose(c : Ur.Sim.City, p : Ur.Citizens.Parking) : CarPose do
    let dx = if p.edge == 0 do -1.0 else if p.edge == 1 do 1.0 else 0.0 end end
    let dz = if p.edge == 2 do -1.0 else if p.edge == 3 do 1.0 else 0.0 end end
    let lot = if p.kind == 0 do p.road else p.site end
    let x = int_to_float(lot % S.width() * 32)
    let z = int_to_float(lot / S.width() * 32)
    let y = int_to_float(S.get(c.heights, lot) + 1)
    if p.kind == 0 do
      let curb = int_to_float(S.road_half_width(S.get(c.roads, lot)) - 2)
      let code = S.get(c.road_shapes, lot)
      if code > 0 do
        let shape = Ur.RoadShape.decode(code)
        let t = if p.bay == 0 do 0.28 else 0.72 end
        let (lx, lz) = Ur.RoadShape.sample(shape, t)
        let (tx, tz) = Ur.RoadShape.tangent(shape, t)
        let (tx, tz) = unit_direction(tx, tz, dz, 0.0 -. dx)
        let side = if dz *. tx -. dx *. tz < 0.0 do -1.0 else 1.0 end
        { x: x +. lx -. tz *. side *. curb, y: y,
          z: z +. lz +. tx *. side *. curb, dx: tx *. side, dz: tz *. side }
      else
        let shift = if p.bay == 0 do -6.0 else 6.0 end
        { x: x +. 16.0 +. dx *. curb +. dz *. shift, y: y,
          z: z +. 16.0 +. dz *. curb -. dx *. shift, dx: dz, dz: 0.0 -. dx }
      end
    else
      let (local_x, local_z) = match p.kind do
        3 -> (5.5 +. int_to_float(p.bay % 4 * 7), if p.bay < 4 do 7.0 else 23.0 end)
        4 -> (16.0, 25.0)
        5 -> (5.0, 26.0)
        _ -> (29.0, 29.0)
      end
      let (u, v) = match S.opposite(p.edge) do
        0 -> (32.0 -. local_z, local_x)
        1 -> (local_z, 32.0 -. local_x)
        2 -> (32.0 -. local_x, 32.0 -. local_z)
        _ -> (local_x, local_z)
      end
      { x: x +. u, y: y, z: z +. v, dx: 0.0 -. dx, dz: 0.0 -. dz }
    end
  end
  pfn lane_pose(c : Ur.Sim.City, id : Int, a : Int, b : Int, t : Float) : CarPose do
    let lane_a = if S.get(c.roads, a) == 2 && id % 2 == 0 do 10.0 else 5.0 end
    let lane_b = if S.get(c.roads, b) == 2 && id % 2 == 0 do 10.0 else 5.0 end
    let grade = S.grade_link(c, a, b)
    let lane = if grade && S.mountain_tunnel(c, a, b) do
      let distance = int_to_float(S.span_distance(a, b)) *. (if t < 0.5 do t else 1.0 -. t end)
      let edge_lane = if t < 0.5 do lane_a else lane_b end
      if distance >= 0.5 do 5.0 else edge_lane +. (5.0 -. edge_lane) *. distance *. 2.0 end
    else if grade do 3.0 else lane_a +. (lane_b -. lane_a) *. t end end
    let (x, z, dx, dz) = street_pose(c, a, b, t, lane)
    let deck_a = S.get(c.heights, a)
    let deck_b = S.get(c.heights, b)
    let deck_a = if deck_a == 0 do 2 else deck_a end
    let deck_b = if deck_b == 0 do 2 else deck_b end
    let y = if grade do S.grade_surface(c, a, b, t) +. (if S.mountain_tunnel(c, a, b) do 1.0 else 2.0 end)
      else int_to_float(deck_a + 1) +. int_to_float(deck_b - deck_a) *. t end
    { x: x, y: y, z: z, dx: dx, dz: dz }
  end
  pfn parking_curve(a : CarPose, b : CarPose, t : Float, gear : Float) : CarPose do
    let u = 1.0 -. t
    let gap_x = b.x -. a.x
    let gap_z = b.z -. a.z
    let distance = math_sqrt(gap_x *. gap_x +. gap_z *. gap_z)
    let handle = if distance < 16.0 do distance *. 0.4 else 6.4 end
    let blend = t *. t *. (3.0 -. 2.0 *. t)
    let lead = 3.0 *. u *. u *. t *. handle *. gear
    let trail = 3.0 *. u *. t *. t *. handle *. gear
    -- Differentiate the same curve used for position. The nose points
    -- against the tangent while backing up.
    let advance = 6.0 *. u *. t
    let first = 3.0 *. u *. (1.0 -. 3.0 *. t) *. handle *. gear
    let last = 3.0 *. t *. (3.0 *. t -. 2.0) *. handle *. gear
    let dx = gap_x *. advance +. a.dx *. first +. b.dx *. last
    let dz = gap_z *. advance +. a.dz *. first +. b.dz *. last
    let speed = math_sqrt(dx *. dx +. dz *. dz)
    { x: a.x +. gap_x *. blend +. a.dx *. lead -. b.dx *. trail,
      y: a.y +. (b.y -. a.y) *. blend,
      z: a.z +. gap_z *. blend +. a.dz *. lead -. b.dz *. trail,
      dx: if speed > 0.0001 do dx *. gear /. speed else a.dx end,
      dz: if speed > 0.0001 do dz *. gear /. speed else a.dz end }
  end
  pfn along_lane(pose : CarPose, distance : Float) : CarPose do
    { pose with x: pose.x +. pose.dx *. distance, z: pose.z +. pose.dz *. distance }
  end
  pfn park_car(c : Ur.Sim.City, p : Ur.Citizens.Parking, lane : CarPose, t : Float) : CarPose do
    let bay = parked_pose(c, p)
    if p.kind != 0 do parking_curve(lane, bay, t, 1.0) else
      -- Pull ahead in the traffic lane, then back toward the curb.
      let ahead = (bay.x -. lane.x) *. lane.dx +. (bay.z -. lane.z) *. lane.dz +. 8.0
      let ready = along_lane(lane, ahead)
      let split = ahead /. (ahead +. 10.0)
      if t < split do along_lane(lane, ahead *. t /. split)
      else parking_curve(ready, bay, (t -. split) /. (1.0 -. split), -1.0) end
    end
  end
  pfn unpark_car(c : Ur.Sim.City, p : Ur.Citizens.Parking, lane : CarPose, t : Float) : CarPose do
    let bay = parked_pose(c, p)
    if p.kind == 0 do parking_curve(bay, lane, t, 1.0) else
      -- Back out through the driveway or garage mouth before pulling forward.
      let ready = along_lane(lane, -5.0)
      if t < 0.72 do parking_curve(bay, ready, t /. 0.72, -1.0)
      else along_lane(ready, 5.0 *. (t -. 0.72) /. 0.28) end
    end
  end
  pfn draw_car(id : Int, pose : CarPose, slot : Int, moving : Bool, night : Bool) : Unit do
    let colour = match id % 4 do
      0 -> 6
      1 -> 7
      2 -> 8
      _ -> 10
    end
    let m = running_gear(vehicle_body(), 7, 3, 1)
    let m = box(m, 0, 2, 0, 7, 1, 3, colour)
    let m = box(m, 1, 3, 0, 2, 1, 3, 9)
    let m = box(m, 3, 3, 0, 1, 1, 3, 19)
    let m = box(m, 4, 3, 0, 1, 1, 3, 9)
    let m = box(m, 2, 4, 0, 2, 1, 3, colour)
    let m = box(m, 6, 1, 1, 1, 1, 1, 17)
    let m = paired_trim(m, 0, 1, 1, 1, 3, if moving && night do 30 else 6 end)
    pose_vehicle(slot, m, pose.x, pose.y, pose.z, pose.dx, pose.dz, 7.0, 3.0, moving, moving)
  end
  pfn parked_car(c : Ur.Sim.City, id : Int, parking : Int, slot : Int, reuse : Bool) : Unit do
    match Ur.Citizens.parking_at(parking) do
      Some(p) ->
        if p.kind < 4 && S.motor_street(c, p.road) && (p.kind != 0 || S.street_end_arm(c, p.road) < 0) do
          let pose = parked_pose(c, p)
          if reuse do () else draw_car(id, pose, slot, false, false) end
        else if reuse do () else Vk.chunk_free(slot) end end
      None -> if reuse do () else Vk.chunk_free(slot) end
    end
  end
  pfn citizen_car(c : Ur.Sim.City, person : Ur.Citizens.Citizen, slot : Int, night : Bool, section : Bool) : Bool do
    let id = person.id
    match (person.route, Ur.Citizens.parking_at(person.parking), Ur.Citizens.parking_at(person.arrival)) do
      (Cons(a, Cons(b, rest)), Some(start), Some(finish)) ->
        if Ur.Citizens.driving(c, person, a, b) do
          let pose = lane_pose(c, id, a, b, person.progress)
          if S.grade_link(c, a, b) && covered_lane(c, a, pose.x, pose.z, section) do Vk.chunk_free(slot)
          else draw_car(id, pose, slot, true, night) end
          true
        else if person.car_phase == 1 && b == start.road && person.progress >= 0.5 do
          let next = match rest do
            Cons(road, _) -> road
            Nil -> b
          end
          let pose = unpark_car(c, start, lane_pose(c, id, b, next, Ur.Citizens.parking_exit(start)), (person.progress -. 0.5) *. 2.0)
          draw_car(id, pose, slot, true, night)
          true
        else if person.car_phase == 2 && a == finish.road do
          if person.progress < 0.5 do
            let pose = park_car(c, finish, lane_pose(c, id, person.previous, a, Ur.Citizens.parking_entry(finish)), person.progress *. 2.0)
            draw_car(id, pose, slot, true, night)
            true
          else
            parked_car(c, id, person.arrival, slot, false)
            false
          end
        else
          parked_car(c, id, if person.car_phase == 3 do person.arrival else person.parking end, slot, false)
          false
        end end end
      _ ->
        parked_car(c, id, person.parking, slot, false)
        false
    end
  end
  pfn walking_segment(c : Ur.Sim.City, person : Ur.Citizens.Citizen, a : Int, b : Int) : Bool do
    if person.transit_phase == 3 || (person.progress > 0.0 && S.canal_taxi_leg(c, a, b)) || Ur.Citizens.driving(c, person, a, b) do false else
      match (person.car_phase, Ur.Citizens.parking_at(person.parking), Ur.Citizens.parking_at(person.arrival)) do
        (1, Some(p), _) -> b != p.road || person.progress < 0.5
        (2, _, Some(p)) -> a != p.road || person.progress >= 0.5
        _ -> true
      end
    end
  end
  -- Every lot a vehicle footprint (this frame's or the last, the two sets footprint_blocked tests)
  -- reaches into: its bounds, widened by a few voxels for rounding. Read on the main thread once
  -- a frame, before the citizens move, and handed to the walk guard as data.
  fn vehicle_lots() : NativeIntArr do
    mark_footprints(mark_footprints(NativeArray.make_int(S.count(), 0), 0, 0), 1, 0)
  end
  pfn lot_column(at : Float, limit : Int) : Int do
    let column = at /. 32.0
    if column <= 0.0 do 0 else if column >= int_to_float(limit - 1) do limit - 1 else float_to_int(column) end end
  end
  pfn mark_rows(lots : NativeIntArr, x0 : Int, x1 : Int, z : Int, z1 : Int) : NativeIntArr do
    if z > z1 do lots else mark_rows(mark_row(lots, x0, x1, z), x0, x1, z + 1, z1) end
  end
  pfn mark_row(lots : NativeIntArr, x : Int, x1 : Int, z : Int) : NativeIntArr do
    if x > x1 do lots else mark_row(NativeArray.set_int(lots, S.index(x, z), 1), x + 1, x1, z) end
  end
  pfn mark_footprints(lots : NativeIntArr, set : Int, i : Int) : NativeIntArr do
    if i >= Vk.footprint_count(set) do lots else
      let rows = S.count() / S.width()
      let x0 = lot_column(Vk.footprint_bound(set, i, 0) -. 4.0, S.width())
      let x1 = lot_column(Vk.footprint_bound(set, i, 1) +. 4.0, S.width())
      let z0 = lot_column(Vk.footprint_bound(set, i, 2) -. 4.0, rows)
      let z1 = lot_column(Vk.footprint_bound(set, i, 3) +. 4.0, rows)
      mark_footprints(mark_rows(lots, x0, x1, z0, z1), set, i + 1)
    end
  end
  pfn lots_clear(lots : NativeIntArr, x : Int, x1 : Int, z : Int, z0 : Int, z1 : Int) : Bool do
    if x > x1 do true
    else if z > z1 do lots_clear(lots, x + 1, x1, z0, z0, z1)
    else S.get(lots, S.index(x, z)) == 0 && lots_clear(lots, x, x1, z + 1, z0, z1) end end
  end
  -- Whether no vehicle can block the walker's step from [before] (on its leg [a] to [b]) to
  -- [after], judged without posing it. Each end of the step is posed inside its leg's lots (a walk
  -- to or from a parked car is not, so that is always checked), so the step stays inside the box
  -- of those lots; when no lot in the box is in [vehicle_lots], no footprint reaches the box and
  -- footprint_blocked would answer false.
  pfn clear_of_vehicles(vehicle_lots : NativeIntArr, before : Ur.Citizens.Citizen, after : Ur.Citizens.Citizen, a : Int, b : Int) : Bool do
    let parked = before.car_phase == 1 || before.car_phase == 2 || after.car_phase == 1 || after.car_phase == 2
    let (n, m) = match after.route do
      Cons(n, Cons(m, _)) -> (n, m)
      _ -> (a, b)
    end
    let w = S.width()
    let x0 = Math.min_int(Math.min_int(a % w, b % w), Math.min_int(n % w, m % w))
    let x1 = Math.max_int(Math.max_int(a % w, b % w), Math.max_int(n % w, m % w))
    let z0 = Math.min_int(Math.min_int(a / w, b / w), Math.min_int(n / w, m / w))
    let z1 = Math.max_int(Math.max_int(a / w, b / w), Math.max_int(n / w, m / w))
    !parked && S.valid(a) && S.valid(b) && S.valid(n) && S.valid(m) && x1 - x0 <= 2 && z1 - z0 <= 2 &&
      lots_clear(vehicle_lots, x0, x1, z0, z0, z1)
  end
  -- A pose (x, z, y) packed in one Int, or -1 when a coordinate is outside 0..4095.
  pfn pack_pose(x : Int, z : Int, y : Int) : Int do
    if x < 0 || z < 0 || y < 0 || x >= 4096 || z >= 4096 || y >= 4096 do -1 else (x * 4096 + z) * 4096 + y end
  end
  -- Lets the walker go from [before] to [after] unless the step crosses a vehicle, and hands back
  -- the poses it took of the step's ends for walk_motion to reuse.
  pfn pedestrian_crossing(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, vehicle_lots : NativeIntArr, before : Ur.Citizens.Citizen, after : Ur.Citizens.Citizen, ignore : Int) : Ur.Citizens.WalkCheck do
    match before.route do
      Cons(a, Cons(b, _)) ->
        if !walking_segment(c, before, a, b) || clear_of_vehicles(vehicle_lots, before, after, a, b) do Ur.Citizens.unguarded(after) else
          let (x0, z0, y0) = walker_position(c, map, before, a, b)
          let end_point = match after.route do
            Cons(n, Cons(m, _)) ->
              if walking_segment(c, after, n, m) do Some(walker_position(c, map, after, n, m)) else None end
            _ -> if after.location == b do Some(walker_position_at(c, map, before, 1.0, a, b)) else None end
          end
          match end_point do
            Some((x1, z1, y1)) ->
              let blocked = (x0 != x1 || z0 != z1) && Strata.Ffi.Footprints.blocked(int_to_float(x0), int_to_float(y0), int_to_float(z0),
                int_to_float(x1), int_to_float(y1), int_to_float(z1), ignore)
              { person: if blocked do before else after end, from: pack_pose(x0, z0, y0), to: pack_pose(x1, z1, y1) }
            None -> { person: after, from: pack_pose(x0, z0, y0), to: -1 }
          end
        end
      _ -> Ur.Citizens.unguarded(after)
    end
  end
  -- Citizens that can be drawn: two slots each (walker, car), up to 48 residents a lot of map
  -- (the metro's towers house about 43 at 9 to 11 floors, 76 at 18 to 20).
  fn max_drawn_citizens() : Int do S.count() * 48 end
  fn citizen_chunk_slots() : Int do walker_template_base() + walker_templates() + 2 * max_drawn_citizens() end
  pfn citizen_walker_slot(slot : Int) : Int do walker_template_base() + walker_templates() + slot * 2 end
  pfn citizen_car_slot(slot : Int) : Int do citizen_walker_slot(slot) + 1 end
  -- Runs inside the citizen step, which is on a worker task: it reads the footprints frozen
  -- before the step started (Vk.footprints_freeze), never the renderer's live ones, and the
  -- vehicle_lots mask built from them on the main thread just before.
  fn yield_to_vehicle(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, vehicle_lots : NativeIntArr, slot : Int, before : Ur.Citizens.Citizen, after : Ur.Citizens.Citizen) : Ur.Citizens.WalkCheck do
    pedestrian_crossing(c, map, vehicle_lots, before, after, citizen_car_slot(slot))
  end
  pfn visible_at_stop(c : Ur.Sim.City, person : Ur.Citizens.Citizen) : Bool do
    (person.study >= 0 && person.activity == 1 && person.location == person.work && person.wait > 0.05) ||
      (Ur.Citizens.sheltered(person) && person.wait > 0.05) ||
      (person.activity == 5 && S.get(c.parks, person.location) > 0)
  end
  pfn walker_projection(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, view : Projection, person : Ur.Citizens.Citizen, a : Int, b : Int) : (Float, Float) do
    let (x, z, y) = walker_position(c, map, person, a, b)
    world_point(view, int_to_float(x), int_to_float(y + 3), int_to_float(z))
  end
  pfn citizen_position(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, view : Projection, person : Ur.Citizens.Citizen) : Option((Float, Float)) do
    match person.route do
      Cons(a, Cons(b, _)) ->
        if walking_segment(c, person, a, b) do Some(walker_projection(c, map, view, person, a, b)) else None end
      _ ->
        if visible_at_stop(c, person) do
          Some(walker_projection(c, map, view, { person with progress: 0.0 }, person.location, person.location))
        else None end
    end
  end
  pfn citizen_hit(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, view : Projection, people : List(Ur.Citizens.Citizen), mx : Float, my : Float, best : Int, square : Float) : Int do
    match people do
      Nil -> best
      Cons(person, rest) ->
        match citizen_position(c, map, view, person) do
          Some((x, y)) ->
            let dx = x -. mx
            let dy = y -. my
            let distance = dx *. dx +. dy *. dy
            if distance < square do citizen_hit(c, map, view, rest, mx, my, person.id, distance)
            else citizen_hit(c, map, view, rest, mx, my, best, square) end
          None -> citizen_hit(c, map, view, rest, mx, my, best, square)
        end
    end
  end
  fn citizen_pick(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, view : Projection, people : List(Ur.Citizens.Citizen), mx : Float, my : Float) : Int do
    citizen_hit(c, map, view, people, mx, my, -1, 144.0)
  end
  -- [progress] stands in for the citizen's own.
  pfn citizen_vehicle(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, person : Ur.Citizens.Citizen, progress : Float, slot : Int, in_car : Bool) : Unit do
    match person.route do
      Cons(a, Cons(b, _)) ->
        if in_car || person.transit_phase == 3 || (progress > 0.0 && S.canal_taxi_leg(c, a, b)) do Vk.chunk_free(slot)
        else citizen_walker(c, map, person, progress, a, b, slot) end
      _ ->
        if visible_at_stop(c, person) do
          citizen_walker(c, map, person, 0.0, person.location, person.location, slot)
        else Vk.chunk_free(slot) end
    end
  end
  pfn draw_citizen(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, entry : Ur.Citizens.Actor, previous : Option(Ur.Citizens.Actor), night : Bool, reuse_parked : Bool, section : Bool) : Unit do
    let person = entry.person
    let slot = entry.slot
    if citizen_car_slot(slot) >= citizen_chunk_slots() do () else
    let unchanged = reuse_parked && person.car_phase == 0 && (match previous do
      Some(prior) ->
        let old = prior.person
        old.id == person.id && old.car_phase == 0 && old.parking == person.parking
      None -> false
    end)
    let in_car = if unchanged do
      parked_car(c, person.id, person.parking, citizen_car_slot(slot), true)
      false
    else citizen_car(c, person, citizen_car_slot(slot), night, section) end
    citizen_vehicle(c, map, person, person.progress, citizen_walker_slot(slot), in_car)
    end
  end
  pfn clear_citizen(slot : Int) : Unit do
    Vk.chunk_free(citizen_walker_slot(slot))
    Vk.chunk_free(citizen_car_slot(slot))
  end
  fn citizen_vehicles(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, citizens : List(Ur.Citizens.Actor), previous : List(Ur.Citizens.Actor), night : Bool, reuse_parked : Bool, section : Bool) : Unit do
    match (citizens, previous) do
      (Nil, Nil) -> ()
      (Nil, Cons(old, rest)) ->
        clear_citizen(old.slot)
        citizen_vehicles(c, map, Nil, rest, night, reuse_parked, section)
      (Cons(entry, rest), Nil) ->
        draw_citizen(c, map, entry, None, night, reuse_parked, section)
        citizen_vehicles(c, map, rest, Nil, night, reuse_parked, section)
      (Cons(entry, rest), Cons(old, tail)) ->
        if entry.slot == old.slot do
          draw_citizen(c, map, entry, Some(old), night, reuse_parked, section)
          citizen_vehicles(c, map, rest, tail, night, reuse_parked, section)
        else if entry.slot < old.slot do
          draw_citizen(c, map, entry, None, night, reuse_parked, section)
          citizen_vehicles(c, map, rest, previous, night, reuse_parked, section)
        else
          clear_citizen(old.slot)
          citizen_vehicles(c, map, citizens, tail, night, reuse_parked, section)
        end end
    end
  end
  fn clear_scheduled_walks(roster : Ur.Citizens.Roster) : Unit do
    Ur.Citizens.each_walk(roster, fn (slot, _) -> Vk.chunk_free(citizen_walker_slot(slot)))
  end
  fn clear_walk_exits(roster : Ur.Citizens.Roster) : Unit do
    List.each(roster.walk_exits, fn slot -> Vk.chunk_free(citizen_walker_slot(slot)))
  end
  -- Walkers move on the GPU: each walk is handed to Strata once, as keys along its leg, and the
  -- shader places the walker from the walk clock. A key is a walker_position_at sample at an
  -- eighth of the way through the walk; between the two ends, midpoints are added only where the
  -- path strays more than a voxel from a straight line, so a straight walk takes two keys.
  type MotionKey = { k : Int, x : Int, y : Int, z : Int }
  pfn motion_key(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, person : Ur.Citizens.Citizen, p0 : Float, p1 : Float, a : Int, b : Int, k : Int) : MotionKey do
    let (x, z, y) = walker_position_at(c, map, person, p0 +. (p1 -. p0) *. int_to_float(k) /. 8.0, a, b)
    { k: k, x: x - 1, y: y, z: z - 1 }
  end
  -- The key motion_key gives for a pose pack_pose packed.
  pfn packed_key(pose : Int, k : Int) : MotionKey do
    { k: k, x: pose / 16777216 - 1, y: pose % 4096, z: pose / 4096 % 4096 - 1 }
  end
  pfn motion_off(a : Int, b : Int, at : Int, f : Float) : Float do
    Math.abs(int_to_float(at) -. (int_to_float(a) +. int_to_float(b - a) *. f))
  end
  -- The keys strictly between [lo] and [hi], in order, ahead of [after].
  pfn motion_between(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, person : Ur.Citizens.Citizen, p0 : Float, p1 : Float, a : Int, b : Int,
    lo : MotionKey, hi : MotionKey, after : List(MotionKey)) : List(MotionKey) do
    if hi.k - lo.k < 2 do after else
      let mid = motion_key(c, map, person, p0, p1, a, b, (lo.k + hi.k) / 2)
      let f = int_to_float(mid.k - lo.k) /. int_to_float(hi.k - lo.k)
      let off = Math.max_float(motion_off(lo.x, hi.x, mid.x, f), Math.max_float(motion_off(lo.y, hi.y, mid.y, f), motion_off(lo.z, hi.z, mid.z, f)))
      if off <= 1.0 do after
      else motion_between(c, map, person, p0, p1, a, b, lo, mid, Cons(mid, motion_between(c, map, person, p0, p1, a, b, mid, hi, after))) end
    end
  end
  pfn motion_words(keys : List(MotionKey), words : NativeI32Arr, i : Int) : NativeI32Arr do
    match keys do
      Nil -> words
      Cons(key, rest) ->
        let words = NativeArray.set_i32(NativeArray.set_i32(words, i * 4, key.x), i * 4 + 1, key.y)
        motion_words(rest, NativeArray.set_i32(NativeArray.set_i32(words, i * 4 + 2, key.z), i * 4 + 3, key.k), i + 1)
    end
  end
  pfn walker_prototype(person : Ur.Citizens.Citizen) : Int do
    let kind = if Ur.Citizens.emergency_move(person) do 2 else if person.study >= 0 do 1 else 0 end end
    let coat = if kind == 2 do 3 else person.id % 4 end
    walker_template_base() + kind * 48 + coat * 12 + person.id / 5 % 3 * 4 + (if person.id % 3 == 0 do 0 else 1 end) * 2
  end
  -- A coarse walk (several lots, see Citizens.coarse_walk) hands Strata keys sampled along its
  -- route at eighths of its time: both ends, and a midpoint only where the route strays more
  -- than a voxel from a straight line between its neighbours (as motion_between does for a
  -- walk within one lot), so a straight walk takes three samples, not nine. Its gait runs over
  -- the lots it covers.
  pfn coarse_key(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, event : Ur.Citizens.WalkEvent, k : Int) : MotionKey do
    let at = Ur.Citizens.walk_pose(event, int_to_float(k) /. 8.0)
    match at.route do
      Cons(a, Cons(b, _)) ->
        let (x, z, y) = walker_position_at(c, map, at, at.progress, a, b)
        { k: k, x: x - 1, y: y, z: z - 1 }
      _ -> packed_key(0, k)
    end
  end
  pfn coarse_between(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, event : Ur.Citizens.WalkEvent,
    lo : MotionKey, hi : MotionKey, after : List(MotionKey)) : List(MotionKey) do
    if hi.k - lo.k < 2 do after else
      let mid = coarse_key(c, map, event, (lo.k + hi.k) / 2)
      let f = int_to_float(mid.k - lo.k) /. int_to_float(hi.k - lo.k)
      let off = Math.max_float(motion_off(lo.x, hi.x, mid.x, f), Math.max_float(motion_off(lo.y, hi.y, mid.y, f), motion_off(lo.z, hi.z, mid.z, f)))
      if off <= 1.0 do after
      else coarse_between(c, map, event, lo, mid, Cons(mid, coarse_between(c, map, event, mid, hi, after))) end
    end
  end
  pfn coarse_motion(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, event : Ur.Citizens.WalkEvent, chunk : Int) : Unit do
    let person = event.entry.person
    let first = coarse_key(c, map, event, 0)
    let last = coarse_key(c, map, event, 8)
    let keys = Cons(first, coarse_between(c, map, event, first, last, Cons(last, Nil)))
    let n = List.length(keys)
    let units = 1.0 -. person.progress +. int_to_float(event.legs)
    if Vk.chunk_motion(chunk, walker_prototype(person), event.started, event.finish, person.progress, person.progress +. units,
      motion_words(keys, NativeArray.make_i32(n * 4, 0), 0), n, true) do () else
      match person.route do
        Cons(a, Cons(b, _)) ->
          citizen_walker(c, map, person, person.progress, a, b, chunk)
          Vk.chunk_show(chunk, true)
        _ -> ()
      end
    end
  end
  pfn walk_motion(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, event : Ur.Citizens.WalkEvent) : Unit do
    let person = event.entry.person
    let chunk = citizen_walker_slot(event.entry.slot)
    if chunk >= citizen_chunk_slots() do () else if event.legs > 0 do coarse_motion(c, map, event, chunk) else
      match person.route do
        Cons(a, Cons(b, _)) ->
          if person.transit_phase == 3 do Vk.chunk_free(chunk) else
            let p0 = person.progress
            let p1 = event.limit
            -- The guard posed the walk's ends while planning it, unless no vehicle was near.
            let first = if event.from >= 0 do packed_key(event.from, 0) else motion_key(c, map, person, p0, p1, a, b, 0) end
            let keys = if p1 == p0 do Cons(first, Nil) else
              let last = if event.to >= 0 do packed_key(event.to, 8) else motion_key(c, map, person, p0, p1, a, b, 8) end
              Cons(first, motion_between(c, map, person, p0, p1, a, b, first, last, Cons(last, Nil)))
            end
            let n = List.length(keys)
            if !Vk.chunk_motion(chunk, walker_prototype(person), event.started, event.finish, p0, p1, motion_words(keys, NativeArray.make_i32(n * 4, 0), 0), n, true) do
              citizen_walker(c, map, person, p0, a, b, chunk)
              Vk.chunk_show(chunk, true)
            else () end
          end
        _ -> citizen_vehicle(c, map, person, person.progress, chunk, false)
      end
    end end
  end
  -- Replay this frame's walks and departures in order: a walk queued hands its motion to Strata,
  -- a walker that stopped walking frees its slot (the stop or the car draws it from here on).
  -- Called before citizen_vehicles, in place of clear_walk_exits.
  fn walk_motions(c : Ur.Sim.City, map : Ur.Citizens.WalkMap, roster : Ur.Citizens.Roster) : Unit do
    Vk.motion_clock(roster.walk_time)
    List.each(Ur.Citizens.walk_log(roster), fn note ->
      match note do
        WalkQueued(event) -> walk_motion(c, map, event)
        WalkLeft(slot) -> Vk.chunk_free(citizen_walker_slot(slot))
      end)
  end
  pfn layer_floor(c : Ur.Sim.City, x : Int, z : Int) : Int do
    high_ground(heights(c, x, z, NativeArray.make_int(100, 0), 0), 0, 0) + 3
  end
  pfn layer_outline(tex : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    let m = face(m, 0, 0, 0, 32, 3, 0, tex)
    let m = face(m, 0, 0, 29, 32, 3, 0, tex)
    let m = face(m, 0, 0, 3, 3, 26, 0, tex)
    face(m, 29, 0, 3, 3, 26, 0, tex)
  end
  pfn water_reach(tex : Int) : Ur.SceneMesh.Mesh do
    let m = { words: NativeArray.make_i32(16, 0), quads: 0 }
    List.fold_left([2, 24], m, fn (a, x) ->
      List.fold_left([2, 24], a, fn (b, z) ->
        let b = face(b, x, 0, if z == 2 do 2 else 28 end, 6, 2, 0, tex)
        face(b, if x == 2 do 2 else 28 end, 0, if z == 2 do 4 else 24 end, 2, 4, 0, tex)))
  end
  pfn power_badge(tex : Int) : Ur.SceneMesh.Mesh do
    let m = box({ words: NativeArray.make_i32(32, 0), quads: 0 }, 9, 0, 9, 14, 3, 14, tex)
    if tex == 30 do
      List.fold_left([0, 2, 4, 6, 8], m, fn (a, offset) ->
        let a = face(a, 11 + offset, 3, 11 + offset, 2, 2, 0, 19)
        if offset == 4 do a else face(a, 19 - offset, 3, 11 + offset, 2, 2, 0, 19) end)
    else
      let m = face(m, 11, 3, 15, 10, 2, 0, 19)
      if tex == 10 do m else face(m, 15, 3, 11, 2, 10, 0, 19) end
    end
  end
  pfn utility_roof(c : Ur.Sim.City, lot : Int) : Int do
    List.fold_left(L.structures(c, lot, 0), S.get(c.heights, lot), fn (height, piece) ->
      Math.max_int(height, piece.y + piece.h))
  end
  pfn utility_digit_ink(digit : Int) : Int do
    match digit do
      0 -> 31599
      1 -> 29874
      2 -> 31183
      3 -> 29647
      4 -> 5101
      5 -> 29671
      6 -> 31719
      7 -> 4687
      8 -> 31727
      _ -> 29679
    end
  end
  pfn utility_digit(m : Ur.SceneMesh.Mesh, x : Int, ink : Int, i : Int) : Ur.SceneMesh.Mesh do
    if i == 15 do m else
      let bit = (i / 3) * 3 + 2 - i % 3
      let m = if int_and(ink, int_shl(1, bit)) == 0 do m
        else face(m, x + (i % 3) * 2, 3, 11 + (i / 3) * 2, 2, 2, 0, 19) end
      utility_digit(m, x, ink, i + 1)
    end
  end
  pfn utility_number_badge(value : Int, tex : Int) : Ur.SceneMesh.Mesh do
    let m = box({ words: NativeArray.make_i32(80, 0), quads: 0 }, 6, 0, 10, 20, 3, 12, tex)
    if value < 10 do utility_digit(m, 13, utility_digit_ink(value), 0)
    else
      let m = utility_digit(m, 9, utility_digit_ink(value / 10), 0)
      utility_digit(m, 17, utility_digit_ink(value % 10), 0)
    end
  end
  type UtilityCluster = { lot : Int, count : Int, priority : Int }
  pfn utility_group_corner(group : Int) : (Int, Int) do
    ((group % utility_group_columns()) * 4, (group / utility_group_columns()) * 4)
  end
  pfn utility_group(corner : (Int, Int), score : Int -> Int) : UtilityCluster do
    let (west, north) = corner
    List.fold_left(List.range(0, 16), { lot: -1, count: 0, priority: 0 }, fn (a, i) ->
      let x = west + i % 4
      let z = north + i / 4
      if x >= S.width() || z >= S.depth() do a else
        let lot = S.index(x, z)
        let priority = score(lot)
        if priority > a.priority do { lot: lot, count: 1, priority: priority }
        else if priority > 0 && priority == a.priority do { a with count: a.count + 1 }
        else a end end
      end)
  end
  pfn utility_service_priority(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, lot : Int) : Int do
    if Ur.UtilityView.site_kind(c, layer, lot) > 0 do 0 else
      if layer == 2 do
        match Ur.Layers.power_status_material(c, st, lot) do 30 -> 3 | 10 -> 2 | 20 -> 1 | _ -> 0 end
      else
        let (demand, delivered) = Ur.UtilityView.parcel_delivery(st.utilities, layer, lot)
        if demand <= 0 do 0 else if !Ur.UtilityView.live_connection(st.utilities, layer, lot) do 3
        else if delivered < demand do 2 else 1 end end end
      end
    end
  end
  pfn utility_status_markers(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, far : Bool, i : Int) : Unit do
    if i >= S.count() do () else
      let slot = power_marker_base() + i
      let x = i % S.width()
      let z = i / S.width()
      if far && Ur.Layers.is_utility(layer) && x % 4 == 0 && z % 4 == 0 do
        let group = utility_group((x, z), fn lot -> utility_service_priority(c, st, layer, lot))
        if group.count > 0 do
          let tex = if group.priority == 3 do 30 else if group.priority == 2 do 10 else 20 end end
          utility_chunk(slot, group.lot, utility_roof(c, group.lot) + 4, utility_number_badge(group.count, tex))
        else Vk.chunk_free(slot) end
      else
        let tex = if !far && layer == 2 && Ur.UtilityView.site_kind(c, 2, i) == 0 do Ur.Layers.power_status_material(c, st, i) else -1 end
        if tex >= 0 do utility_chunk(slot, i, utility_roof(c, i) + 4, power_badge(tex)) else Vk.chunk_free(slot) end
      end
      utility_status_markers(c, st, layer, far, i + 1)
    end
  end
  -- Each arrow points from the lot centre to the edge with positive outward flow.
  pfn utility_arm_ink(m : Ur.SceneMesh.Mesh, arm : Int, start : Int, width : Int, across : Int, span : Int, tex : Int) : Ur.SceneMesh.Mesh do
    match arm do
      0 -> face(m, 16 - start - width, 1, 16 + across, width, span, 0, tex)
      1 -> face(m, 16 + start, 1, 16 + across, width, span, 0, tex)
      2 -> face(m, 16 + across, 1, 16 - start - width, span, width, 0, tex)
      _ -> face(m, 16 + across, 1, 16 + start, span, width, 0, tex)
    end
  end
  pfn utility_arrow(m : Ur.SceneMesh.Mesh, arm : Int, tex : Int) : Ur.SceneMesh.Mesh do
    let m = utility_arm_ink(m, arm, 3, 6, -1, 2, tex)
    let m = utility_arm_ink(m, arm, 8, 2, -4, 8, tex)
    let m = utility_arm_ink(m, arm, 10, 2, -3, 6, tex)
    let m = utility_arm_ink(m, arm, 12, 1, -2, 4, tex)
    utility_arm_ink(m, arm, 13, 1, -1, 2, tex)
  end
  pfn utility_direction_marks(flow : Ur.UtilitiesNetwork.Network, lot : Int, sewer : Bool, arm : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if arm == 4 do m else
      let units = Net.arm_flow(flow, lot, arm)
      let outgoing = if sewer do units < 0 else units > 0 end
      let m = if outgoing do utility_arrow(m, arm, 19) else m end
      utility_direction_marks(flow, lot, sewer, arm + 1, m)
    end
  end
  pfn utility_link_marks(m : Ur.SceneMesh.Mesh, lot : Int, target : Int, arm : Int) : Ur.SceneMesh.Mesh do
    if !S.valid(target) || target == lot || arm == 4 do m
    else if S.neighbour(lot, arm) == target do
      let m = utility_arm_ink(m, arm, 6, 2, -1, 2, 31)
      let m = utility_arm_ink(m, arm, 10, 2, -1, 2, 31)
      utility_arm_ink(m, arm, 14, 2, -1, 2, 31)
    else utility_link_marks(m, lot, target, arm + 1) end end
  end
  pfn utility_ground_mesh(flow : Ur.UtilitiesNetwork.Network, layer : Int, inspection : Ur.UtilityView.Inspection,
    lot : Int, member : Bool, far : Bool) : Ur.SceneMesh.Mesh do
    let m = { words: NativeArray.make_i32(64, 0), quads: 0 }
    let tex = if lot == inspection.limit do 35
      else if lot == inspection.tap || lot == inspection.lot do 31 else 29 end end
    let m = if member && tex == 29 do
      let m = face(m, 8, 0, 2, 16, 1, 0, tex)
      let m = face(m, 8, 0, 29, 16, 1, 0, tex)
      let m = face(m, 2, 0, 8, 1, 16, 0, tex)
      face(m, 29, 0, 8, 1, 16, 0, tex)
    else layer_outline(tex, m) end
    let m = if member && !far do utility_direction_marks(flow, lot, layer == 31, 0, m) else m end
    let connected = if lot == inspection.tap do inspection.lot else if lot == inspection.lot do inspection.tap else -1 end end
    utility_link_marks(m, lot, connected, 0)
  end
  pfn utility_source_badge(m : Ur.SceneMesh.Mesh, x : Int, kind : Int, online : Bool) : Ur.SceneMesh.Mesh do
    let tex = if !online do 17 else if kind == 2 do 36 else if kind == 3 do 31 else 20 end end end
    let m = box(m, x, 0, 10, 12, 3, 12, tex)
    match kind do
      2 -> face(face(m, x + 2, 3, 13, 8, 2, 0, 19), x + 2, 3, 17, 8, 2, 0, 19)
      3 ->
        let m = face(m, x + 2, 3, 15, 4, 2, 0, 19)
        let m = face(m, x + 6, 3, 12, 2, 8, 0, 19)
        let m = face(m, x + 8, 3, 13, 1, 6, 0, 19)
        face(m, x + 9, 3, 15, 1, 2, 0, 19)
      _ ->
        let m = face(m, x + 5, 3, 12, 2, 8, 0, 19)
        let m = face(m, x + 3, 3, 14, 2, 4, 0, 19)
        face(m, x + 7, 3, 14, 2, 4, 0, 19)
    end
  end
  pfn utility_impact_badge(m : Ur.SceneMesh.Mesh, x : Int, impact : Int) : Ur.SceneMesh.Mesh do
    let tex = match impact do
      1 -> 11
      2 -> 30
      3 -> 20
      _ -> 10
    end
    let positive = impact == 1 || impact == 3
    let base = if positive do 12 else 17 end
    let m = box(m, x, 0, 10, 12, 3, 12, tex)
    let m = face(m, x + 5, 3, 12, 2, 8, 0, 19)
    let m = face(m, x + 3, 3, if positive do base + 1 else base - 1 end, 6, 2, 0, 19)
    face(m, x + 2, 3, if positive do base + 3 else base - 3 end, 8, 2, 0, 19)
  end
  pfn utility_chunk(slot : Int, lot : Int, y : Int, m : Ur.SceneMesh.Mesh) : Unit do
    if Vk.chunk_begin(slot, lot % S.width() * 32, y, lot / S.width() * 32, 0) &&
      Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Utility inspection mesh upload failed") end
  end
  pfn utility_waypoint_marks(c : Ur.Sim.City, points : List(Int), i : Int) : Unit do
    if i >= utility_waypoint_limit() do () else
      let slot = utility_waypoint_slot(i)
      match points do
        Nil ->
          Vk.chunk_free(slot)
          utility_waypoint_marks(c, Nil, i + 1)
        Cons(lot, rest) ->
          if S.valid(lot) do utility_chunk(slot, lot, utility_roof(c, lot) + 19, utility_number_badge(i + 1, 36))
          else Vk.chunk_free(slot) end
          utility_waypoint_marks(c, rest, i + 1)
      end
    end
  end
  fn utility_waypoints(c : Ur.Sim.City, points : List(Int), target : Int) : Unit do
    utility_waypoint_marks(c, points, 0)
    let n = List.length(points)
    let slot = utility_waypoint_slot(utility_waypoint_limit())
    if n < utility_waypoint_limit() && S.valid(target) && !List.any(points, fn point -> point == target) do
      utility_chunk(slot, target, utility_roof(c, target) + 19, utility_number_badge(n + 1, 31))
    else Vk.chunk_free(slot) end
  end
  pfn utility_impact_priority(mark : Int) : Int do
    match mark do
      2 -> 4
      4 -> 3
      1 -> 2
      3 -> 1
      _ -> 0
    end
  end
  pfn utility_forecast_groups(c : Ur.Sim.City, impact : Option(Ur.UtilityView.Impact), i : Int) : Unit do
    if i >= utility_group_count() do () else
      let slot = utility_group_slot(i)
      match impact do
        None -> Vk.chunk_free(slot)
        Some(edit) ->
          let group = utility_group(utility_group_corner(i), fn lot -> utility_impact_priority(S.get(edit.marks, lot)))
          if group.count > 0 do
            let tex = match group.priority do 4 -> 30 | 3 -> 10 | 2 -> 11 | _ -> 20 end
            utility_chunk(slot, group.lot, utility_roof(c, group.lot) + 20, utility_number_badge(group.count, tex))
          else Vk.chunk_free(slot) end
      end
      utility_forecast_groups(c, impact, i + 1)
    end
  end
  pfn utility_details_at(c : Ur.Sim.City, report : Ur.Sim.UtilityDelivery, layer : Int, inspection : Ur.UtilityView.Inspection,
    impact : Option(Ur.UtilityView.Impact), live : Bool, far : Bool, lot : Int) : Unit do
    if lot >= S.count() do () else
      let member = live && S.get(inspection.members, lot) > 0
      let selected = live && (lot == inspection.lot || lot == inspection.tap || lot == inspection.limit)
      let floor_slot = utility_ground_slot(lot)
      if selected || member do
        let floor = layer_floor(c, lot % S.width() * 32, lot / S.width() * 32) + 5
        utility_chunk(floor_slot, lot, floor, utility_ground_mesh(report.flow, layer, inspection, lot, member, far))
      else Vk.chunk_free(floor_slot) end
      let kind = if live do Ur.UtilityView.site_kind(c, layer, lot) else 0 end
      let change = if live && !far do match impact do Some(edit) -> S.get(edit.marks, lot) | None -> 0 end else 0 end
      let roof_slot = utility_roof_slot(lot)
      if kind > 0 || change > 0 do
        let m = { words: NativeArray.make_i32(48, 0), quads: 0 }
        let m = if kind > 0 do utility_source_badge(m, if change > 0 do 3 else 10 end, kind, S.get(report.sites, lot) > 0) else m end
        let m = if change > 0 do utility_impact_badge(m, if kind > 0 do 17 else 10 end, change) else m end
        utility_chunk(roof_slot, lot, utility_roof(c, lot) + 12, m)
      else Vk.chunk_free(roof_slot) end
      utility_details_at(c, report, layer, inspection, impact, live, far, lot + 1)
    end
  end
  fn utility_details(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, inspection : Ur.UtilityView.Inspection,
    impact : Option(Ur.UtilityView.Impact), far : Bool) : Unit do
    let live = Ur.Layers.is_utility(layer)
    utility_details_at(c, Ur.Layers.utility_layer(st, layer), layer, inspection, impact, live, far, 0)
    utility_forecast_groups(c, if live && far do impact else None end, 0)
  end
  type BadgePointer = { view : Projection, mx : Float, my : Float, scale : Float, sine : Float, cosine : Float }
  pfn utility_badge_target(pointer : BadgePointer, lot : Int, height : Int, half_x : Float, half_z : Float,
    best : Int, nearest : Float) : (Int, Float) do
    let x = int_to_float(lot % S.width() * 32 + 16)
    let z = int_to_float(lot / S.width() * 32 + 16)
    let height = int_to_float(height)
    let (sx, sy) = world_point(pointer.view, x, height, z)
    let right = (pointer.mx -. sx) /. pointer.scale
    let along = (pointer.my -. sy) /. (pointer.scale *. 0.607)
    let local_x = right *. pointer.cosine +. along *. pointer.sine
    let local_z = along *. pointer.cosine -. right *. pointer.sine
    let padding = Math.min_float(4.0, 1.5 /. pointer.scale)
    let depth = height *. 0.607 +. (x *. pointer.sine +. z *. pointer.cosine) *. 0.795
    if Math.abs(local_x) <= half_x +. padding && Math.abs(local_z) <= half_z +. padding && depth > nearest do
      (lot, depth)
    else (best, nearest) end
  end
  pfn utility_badge_at(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, pointer : BadgePointer,
    far : Bool, lot : Int, best : Int, nearest : Float) : (Int, Float) do
    if lot >= S.count() do (best, nearest) else
      let x = int_to_float(lot % S.width() * 32 + 16)
      let z = int_to_float(lot / S.width() * 32 + 16)
      let (sx, _) = world_point(pointer.view, x, 0.0, z)
      let (chosen, depth) = if Math.abs(sx -. pointer.mx) > pointer.scale *. 11.0 +. 2.0 do (best, nearest) else
        let site = Ur.UtilityView.site_kind(c, layer, lot) > 0
        if !site && (far || layer != 2 || Ur.Layers.power_status_material(c, st, lot) < 0) do (best, nearest) else
          let height = utility_roof(c, lot) + (if site do 16 else 8 end)
          let half = if site do 6.0 else 7.0 end
          utility_badge_target(pointer, lot, height, half, half, best, nearest)
        end
      end
      utility_badge_at(c, st, layer, pointer, far, lot + 1, chosen, depth)
    end
  end
  pfn utility_group_hit(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, pointer : BadgePointer,
    i : Int, best : Int, nearest : Float) : Int do
    if i >= utility_group_count() do best else
      let group = utility_group(utility_group_corner(i), fn lot -> utility_service_priority(c, st, layer, lot))
      let (chosen, depth) = if group.count == 0 do (best, nearest)
        else utility_badge_target(pointer, group.lot, utility_roof(c, group.lot) + 8, 10.0, 6.0, best, nearest) end
      utility_group_hit(c, st, layer, pointer, i + 1, chosen, depth)
    end
  end
  fn utility_badge_pick(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, view : Projection, mx : Float, my : Float, far : Bool) : Int do
    if !Ur.Layers.is_utility(layer) || view.w <= 0.0 || view.zoom <= 0.0 do -1 else
      let pointer = { view: view, mx: mx, my: my, scale: view.w /. (8.0 *. view.zoom), sine: Math.sin(view.yaw), cosine: Math.cos(view.yaw) }
      let (chosen, depth) = utility_badge_at(c, st, layer, pointer, far, 0, -1, 0.0 -. 1000000.0)
      if far do utility_group_hit(c, st, layer, pointer, 0, chosen, depth) else chosen end
    end
  end
  -- Project the utility network above the terrain so it is visible through the city view.
  pfn utility_arms(c : Ur.Sim.City, network : NativeIntArr, i : Int, floor : Int, d : Int, pipe : Bool, tex : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if d >= 4 do m else
      let peer = S.neighbour(i, d)
      let m = if !S.valid(peer) || S.get(network, peer) == 0 do m else
        let horizontal = d < 2
        let bx = if d == 0 do 0 else if d == 1 do 16 else 14 end end
        let bz = if d == 2 do 0 else if d == 3 do 16 else 14 end end
        let a = if horizontal do box(m, bx, 1, bz, 16, 2, 4, tex)
          else box(m, bx, 1, bz, 4, 2, 16, tex) end
        let a = if !pipe do a
          else if horizontal do box(a, bx, 0, 15, 16, 4, 2, tex)
          else box(a, 15, 0, bz, 2, 4, 16, tex) end end
        let px = peer % S.width() * 32
        let pz = peer / S.width() * 32
        let rise = S.clamp(layer_floor(c, px, pz) - floor, 0, 28)
        let joint_x = if d == 0 do 0 else if d == 1 do 30 else 14 end end
        let joint_z = if d == 2 do 0 else if d == 3 do 30 else 14 end end
        if rise == 0 do a
        else box(a, joint_x, 1, joint_z, if horizontal do 2 else 4 end, rise + 2, if horizontal do 4 else 2 end, tex) end
      end
      utility_arms(c, network, i, floor, d + 1, pipe, tex, m)
    end
  end
  pfn utility_mesh(c : Ur.Sim.City, i : Int, floor : Int, layer : Int, tex : Int) : Ur.SceneMesh.Mesh do
    let pipe = layer != 2
    let base = { words: NativeArray.make_i32(160, 0), quads: 0 }
    let tiles = if pipe do c.pipes else c.grid end
    let size = if S.get(tiles, i) == 2 do 10 else 6 end
    let edge = 16 - size / 2
    let hub = box(base, edge, 0, edge, size, if pipe do 5 else 3 end, size, tex)
    utility_arms(c, tiles, i, floor, 0, pipe, tex, hub)
  end
  pfn lane_heat(demand : Int) : Int do S.clamp(demand, 0, 36) * 63 / 36 end
  pfn lane_quad(m : Ur.SceneMesh.Mesh, x : Int, z : Int, w : Int, depth : Int, axis : Int, first : Int, last : Int, ends : Int) : Ur.SceneMesh.Mesh do
    let n = m.quads * 2
    let words = NativeArray.set_i32(m.words, n, Q.with_drop(Q.pack0(x, 0, z, w, depth, 0), 6))
    let tag = 61440 + lane_heat(first) * 64 + lane_heat(last)
    { words: NativeArray.set_i32(words, n + 1, Q.pack1(tag, ends, (if axis == 0 do w else depth end) * 2 + axis)), quads: m.quads + 1 }
  end
  pfn lane_connected(c : Ur.Sim.City, i : Int, peer : Int) : Bool do
    S.motor_road(c, peer) && int_abs(S.get(c.heights, i) - S.get(c.heights, peer)) <= 12
  end
  pfn lane_arms(c : Ur.Sim.City, traffic : NativeIntArr, i : Int, d : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if d >= 4 do m else
      let peer = S.neighbour(i, d)
      if !lane_connected(c, i, peer) do
        lane_arms(c, traffic, i, d + 1, m)
      else
        let back = S.opposite(d)
        let out = S.lane_demand(traffic, i, d)
        let incoming = S.lane_demand(traffic, peer, back)
        let prev = S.neighbour(i, back)
        let center_out = if lane_connected(c, i, prev) do (out + S.lane_demand(traffic, prev, d)) / 2 else out end
        let center_in = if lane_connected(c, i, prev) do (incoming + S.lane_demand(traffic, i, back)) / 2 else incoming end
        let low = d % 2 == 0
        let offset = if low do 0 else 16 end
        let right = if d == 0 || d == 3 do 5 else 16 end
        let left = 21 - right
        let (first, last) = if low do (out, center_out) else (center_out, out) end
        let (other_first, other_last) = if low do (incoming, center_in) else (center_in, incoming) end
        let m = if d < 2 do
          lane_quad(lane_quad(m, offset, right, 16, 10, 0, first, last, 0), offset, left, 16, 10, 0, other_first, other_last, 0)
        else
          let right_peer = S.neighbour(i, if right < 16 do 0 else 1 end)
          let left_peer = S.neighbour(i, if left < 16 do 0 else 1 end)
          let right_length = if lane_connected(c, i, right_peer) do (if low do 5 else 6 end) else 16 end
          let left_length = if lane_connected(c, i, left_peer) do (if low do 5 else 6 end) else 16 end
          let fade = if low do 2 else 1 end
          let a = lane_quad(m, right, if low do 0 else 32 - right_length end, 10, right_length, 1, first, last, if right_length < 16 do fade else 0 end)
          lane_quad(a, left, if low do 0 else 32 - left_length end, 10, left_length, 1, other_first, other_last, if left_length < 16 do fade else 0 end)
        end
        lane_arms(c, traffic, i, d + 1, m)
      end
    end
  end
  pfn curve_lane(kind : Int, x : Int, z : Int) : Int do
    let px = x * 2 + 1
    let pz = z * 2 + 1
    let radius = px * px + pz * pz
    let width = S.road_half_width(kind) * 2
    if radius < (32 - width) * (32 - width) || radius >= (32 + width) * (32 + width) do 0
    else if radius < 1024 do 1 else 2 end end
  end
  pfn curve_heat_row(kind : Int, horizontal : Int, vertical : Int, inner : Int, outer : Int, x : Int, z : Int, start : Int, lane : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    let next = if x >= 32 do 0 else curve_lane(kind, x, z) end
    let m = if next == lane || lane == 0 || x == start do m else
      let px = if horizontal == 0 do start else 32 - x end
      let pz = if vertical == 2 do z else 31 - z end
      let flow = if lane == 1 do inner else outer end
      lane_quad(m, px, pz, x - start, 1, 0, flow, flow, 0)
    end
    if x >= 32 do m else curve_heat_row(kind, horizontal, vertical, inner, outer, x + 1, z, if next == lane do start else x end, next, m) end
  end
  pfn curve_heat_rows(kind : Int, horizontal : Int, vertical : Int, inner : Int, outer : Int, z : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if z >= 32 do m else curve_heat_rows(kind, horizontal, vertical, inner, outer, z + 1,
      curve_heat_row(kind, horizontal, vertical, inner, outer, 0, z, 0, 0, m)) end
  end
  pfn traffic_mesh(c : Ur.Sim.City, traffic : NativeIntArr, i : Int) : Ur.SceneMesh.Mesh do
    let (horizontal, vertical) = S.road_turn(c, i)
    -- A curved parcel has up to two runs per row, with two words per run.
    let mesh = { words: NativeArray.make_i32(if horizontal < 0 do 16 else 128 end, 0), quads: 0 }
    if horizontal < 0 do lane_arms(c, traffic, i, 0, mesh) else
      let here = S.neighbour(i, horizontal)
      let there = S.neighbour(i, vertical)
      let across = (S.lane_demand(traffic, here, S.opposite(horizontal)) + S.lane_demand(traffic, i, vertical)) / 2
      let back = (S.lane_demand(traffic, there, S.opposite(vertical)) + S.lane_demand(traffic, i, horizontal)) / 2
      let outside = (horizontal == 0) == (vertical == 2)
      curve_heat_rows(S.get(c.roads, i), horizontal, vertical, if outside do back else across end,
        if outside do across else back end, 0, mesh)
    end
  end
  pfn street_policy_mesh(c : Ur.Sim.City, i : Int, tex : Int, d : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if d >= 4 do m else
      let extent = if tex == 17 do 2 else 5 end
      let m = if !S.street_link(c, i, d) do m else
        if d < 2 do face(m, if d == 0 do 0 else 16 end, 0, 16 - extent, 16, extent * 2, 0, tex)
        else face(m, 16 - extent, 0, if d == 2 do 0 else 16 end, extent * 2, 16, 0, tex) end end
      street_policy_mesh(c, i, tex, d + 1, m)
    end
  end
  pfn ward_outline(c : Ur.Sim.City, i : Int, tex : Int, d : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if d == 4 do m else
      let peer = S.neighbour(i, d)
      let border = !S.valid(peer) || S.get(c.heights, peer) == 0 || Ur.Council.ward_at(c, peer) != Ur.Council.ward_at(c, i)
      let m = if !border do m else
        if d < 2 do face(m, if d == 0 do 0 else 29 end, 0, 0, 3, 32, 0, tex)
        else face(m, 0, 0, if d == 2 do 0 else 29 end, 32, 3, 0, tex) end end
      ward_outline(c, i, tex, d + 1, m)
    end
  end
  pfn crossing_layer(c : Ur.Sim.City, lot : Int, tex : Int) : Ur.SceneMesh.Mesh do
    let a = S.grade_source(c, lot)
    let b = S.grade_peer(c, a)
    let shaft = lot == a || lot == b
    let m = { words: NativeArray.make_i32(4, 0), quads: 0 }
    let m = if a / S.width() == b / S.width() do face(m, 0, 0, 14, 32, 4, 0, tex)
      else face(m, 14, 0, 0, 4, 32, 0, tex) end
    if shaft do face(m, 11, 1, 11, 10, 10, 0, 10) else m end
  end
  pfn wind_arrow(c : Ur.Sim.City, lot : Int, slot : Int, tex : Int) : Unit do
    let wind = S.local_wind(c, lot, S.hour_now(c))
    let reach = S.clamp(wind.speed / 2, 6, 23)
    let m = { words: NativeArray.make_i32(72, 0), quads: 0 }
    let m = box(m, 14, 0, 3, 3, 1, reach, tex)
    let m = box(m, 10, 0, 3 + reach, 11, 1, 2, tex)
    let m = box(m, 12, 0, 5 + reach, 7, 1, 2, tex)
    let m = box(m, 14, 0, 7 + reach, 3, 1, 1, tex)
    let yaw = 1.570796327 -. wind.heading
    let x = lot % S.width() * 32
    let z = lot / S.width() * 32
    let y = layer_floor(c, x, z) + 2
    if Vk.body_begin(slot) && Vk.chunk_part(0, m.words, m.quads) && Vk.chunk_commit() do
      Vk.slot_pose(slot, int_to_float(x) *. 0.25 +. 4.0 -. 4.0 *. (Math.cos(yaw) +. Math.sin(yaw)),
        int_to_float(y) *. 0.25, int_to_float(z) *. 0.25 +. 4.0 -. 4.0 *. (Math.cos(yaw) -. Math.sin(yaw)),
        0.0, Math.sin(yaw *. 0.5), 0.0, Math.cos(yaw *. 0.5))
    else Ur.AppError.stop("Wind arrow upload failed") end
  end
  -- Gradient overlays lie on the terrain as a skin: each 4-voxel column gets
  -- a top just over two voxels above its ground (clear of road decks), and where a neighbour rises, a
  -- wall one voxel in front of that cliff with a one-voxel lip at its top, so
  -- the skin climbs every step without gaps. Every quad carries the field at
  -- the corners of its column's 8-voxel cell; the shader blends them by
  -- world position, so the colour runs on smoothly across quads.
  pfn skin_quad(m : Ur.SceneMesh.Mesh, x : Int, y : Int, z : Int, w : Int, h : Int, dir : Int, w1 : Int) : Ur.SceneMesh.Mesh do
    -- a wall's second extent is its height: the part inside this band of the chunk is drawn
    let low = if dir >= 2 && y < 0 do 0 else y end
    let extent = if dir >= 2 do (if y + h > 32 do 32 else y + h end) - low else h end
    if low < 0 || low > 31 || extent < 1 do m else
      let j = m.quads * 2
      -- a wall cut off below the band keeps its full top, so no drop there
      let drop = if dir >= 2 && y + h > 32 do 0 else 6 end
      let w0 = Q.with_drop(Q.pack0(x, low, z, w, extent, dir), drop)
      { words: NativeArray.set_i32(NativeArray.set_i32(m.words, j, w0), j + 1, w1), quads: m.quads + 1 }
    end
  end
  -- the wall and lip toward a higher neighbour on side [d] (0 -x, 1 +x, 2 -z, 3 +z)
  pfn skin_step(m : Ur.SceneMesh.Mesh, u : Int, v : Int, h : Int, high : Int, floor : Int, d : Int, w1 : Int) : Ur.SceneMesh.Mesh do
    if high <= h do m else
      let y = h - floor
      let top = high - floor
      let rise = high + 1 - h
      match d do
        0 -> skin_quad(skin_quad(m, u, y, v, 4, rise, 2, w1), u, top, v, 1, 4, 0, w1)
        1 -> skin_quad(skin_quad(m, u + 3, y, v, 4, rise, 3, w1), u + 3, top, v, 1, 4, 0, w1)
        2 -> skin_quad(skin_quad(m, u, y, v, 4, rise, 4, w1), u, top, v, 4, 1, 0, w1)
        _ -> skin_quad(skin_quad(m, u, y, v + 3, 4, rise, 5, w1), u, top, v + 3, 4, 1, 0, w1)
      end
    end
  end
  pfn gradient_quads(c : Ur.Sim.City, samples : NativeF32Arr, x : Int, z : Int, floor : Int, tag : Int, dry : Bool, n : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if n == 64 do m else
      let u = n % 8 * 4
      let v = n / 8 * 4
      let sx = (x + u) / 8
      let sz = (z + v) / 8
      let a = Ur.OverlayField.sample(samples, sx, sz)
      let b = Ur.OverlayField.sample(samples, sx + 1, sz)
      let d = Ur.OverlayField.sample(samples, sx, sz + 1)
      let e = Ur.OverlayField.sample(samples, sx + 1, sz + 1)
      let ground = L.height(c, x + u, z + v)
      let h = ground + 2
      let m = if a + b + d + e == 0 || (dry && ground == 0) do m else
        let packed = a + 64 * b + 4096 * d + 262144 * e
        -- The data overlay tag sits above four six-bit corner samples.
        let w1 = Q.pack1(packed % 65536, packed / 65536, tag)
        let west = L.height(c, x + u - 4, z + v) + 2
        let east = L.height(c, x + u + 4, z + v) + 2
        let north = L.height(c, x + u, z + v - 4) + 2
        let south = L.height(c, x + u, z + v + 4) + 2
        -- the top stops short of each wall, so no strip of it shows through one
        let left = if west > h do 1 else 0 end
        let right = if east > h do 1 else 0 end
        let near = if north > h do 1 else 0 end
        let far = if south > h do 1 else 0 end
        let m = skin_quad(m, u + left, h - floor, v + near, 4 - left - right, 4 - near - far, 0, w1)
        let m = skin_step(m, u, v, h, west, floor, 0, w1)
        let m = skin_step(m, u, v, h, east, floor, 1, w1)
        let m = skin_step(m, u, v, h, north, floor, 2, w1)
        skin_step(m, u, v, h, south, floor, 3, w1)
      end
      gradient_quads(c, samples, x, z, floor, tag, dry, n + 1, m)
    end
  end
  -- the lowest ground on a parcel: the skin's chunk starts there
  pfn skin_floor(c : Ur.Sim.City, x : Int, z : Int, n : Int, low : Int) : Int do
    if n == 64 do low else
      let h = L.height(c, x + n % 8 * 4, z + n / 8 * 4)
      skin_floor(c, x, z, n + 1, if h < low do h else low end)
    end
  end
  type SkinField = { samples : NativeF32Arr, tag : Int, dry : Bool }
  pfn skin_band(c : Ur.Sim.City, fields : List(SkinField), x : Int, z : Int, floor : Int, m : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    match fields do
      Nil -> m
      Cons(f, rest) -> skin_band(c, rest, x, z, floor, gradient_quads(c, f.samples, x, z, floor, f.tag, f.dry, 0, m))
    end
  end
  pfn skin_upload(slot : Int, x : Int, floor : Int, z : Int, mesh : Ur.SceneMesh.Mesh) : Unit do
    if mesh.quads == 0 do Vk.chunk_free(slot)
    else if Vk.chunk_begin(slot, x, floor, z, 0) && Vk.chunk_part(2, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
    else Ur.AppError.stop("Gradient overlay upload failed") end end
  end
  pfn skin_tiles(c : Ur.Sim.City, fields : List(SkinField), i : Int) : Unit do
    if i == S.count() do () else
      let x = i % S.width() * 32
      let z = i / S.width() * 32
      let floor = skin_floor(c, x, z, 0, 9999)
      let size = List.length(fields) * 64 * 9 * 2
      skin_upload(overlay_slot(i), x, floor, z, skin_band(c, fields, x, z, floor, { words: NativeArray.make_i32(size, 0), quads: 0 }))
      skin_upload(skin_high_slot(i), x, floor + 32, z, skin_band(c, fields, x, z, floor + 32, { words: NativeArray.make_i32(size, 0), quads: 0 }))
      skin_tiles(c, fields, i + 1)
    end
  end
  pfn gradient_tiles(c : Ur.Sim.City, samples : NativeF32Arr, tag : Int, i : Int) : Unit do
    skin_tiles(c, [{ samples: samples, tag: tag, dry: tag == 252 }], i)
  end
  pfn clear_skin_high(i : Int) : Unit do
    if i == S.count() do () else
      Vk.chunk_free(skin_high_slot(i))
      clear_skin_high(i + 1)
    end
  end
  pfn layer_tiles(c : Ur.Sim.City, st : Ur.Sim.Stats, layer : Int, i : Int) : Unit do
    if i >= S.count() do () else
      let tex = if layer == 2 && S.get(c.grid, i) == 0 do -1 else Ur.Layers.material(c, st, layer, i) end
      let slot = overlay_slot(i)
      if tex < 0 do Vk.chunk_free(slot) else if layer == 29 do wind_arrow(c, i, slot, tex) else
        let x = i % S.width() * 32
        let z = i / S.width() * 32
        let deck = S.get(c.heights, i)
        let worship_marker = layer == 34 && S.temple_tier(c, i) > 0
        let floor = if worship_marker do
          List.fold_left(L.structures(c, i, 0), deck, fn (height, piece) ->
            if piece.y + piece.h > height do piece.y + piece.h else height end) + 3
        else if layer == 9 do (if deck == 0 do 2 else deck end) + 1 else layer_floor(c, x, z) end end
        let mesh = if worship_marker do box({ words: NativeArray.make_i32(12, 0), quads: 0 }, 10, 0, 10, 12, 3, 12, tex)
          else if layer == 9 do traffic_mesh(c, st.traffic, i)
          else if Ur.Layers.is_utility(layer) && (if layer == 2 do S.get(c.grid, i) > 0 else S.get(c.pipes, i) > 0 end) do utility_mesh(c, i, floor, layer, tex)
          else if layer == 1 && tex == 12 do water_reach(tex)
          else if layer == 11 do crossing_layer(c, i, tex)
          else if layer == 27 do
            let m = { words: NativeArray.make_i32(12, 0), quads: 0 }
            street_policy_mesh(c, i, tex, 0, face(m, 12, 0, 12, 8, 8, 0, tex))
          else if layer == 28 && tex != 6 do ward_outline(c, i, tex, 0, { words: NativeArray.make_i32(8, 0), quads: 0 })
          else layer_outline(tex, { words: NativeArray.make_i32(8, 0), quads: 0 }) end end end end end end end
        if mesh.quads == 0 do Vk.chunk_free(slot) else if Vk.chunk_begin(slot, x, floor, z, 0) && Vk.chunk_part(if layer == 9 do 2 else 0 end, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
        else Ur.AppError.stop("Map layer upload failed") end end
      end end
      layer_tiles(c, st, layer, i + 1)
    end
  end
  -- Heat and Rainfall use the shader's blended gradient overlay, as the
  -- pollution and freshwater layers do: each 8-voxel patch carries the field
  -- at its four corners and the GPU blends colour and opacity between them,
  -- so the layer fades smoothly between parcels and out to nothing at its edge.
  -- Heat: cool parcels shade blue and hot ones amber to red; comfortable ground stays clear.
  fn heat_fields(c : Ur.Sim.City) : (NativeF32Arr, NativeF32Arr) do
    let temps = List.fold_left(List.range(0, S.count()), NativeArray.make_int(S.count(), 0), fn (t, i) ->
      NativeArray.set_int(t, i, S.local_temperature(c, i)))
    let cool = List.fold_left(List.range(0, S.count()), NativeArray.make_int(S.count(), 0), fn (f, i) ->
      NativeArray.set_int(f, i, S.clamp((255 - NativeArray.get_int(temps, i)) * 63 / 100, 0, 63)))
    let hot = List.fold_left(List.range(0, S.count()), NativeArray.make_int(S.count(), 0), fn (f, i) ->
      NativeArray.set_int(f, i, S.clamp((NativeArray.get_int(temps, i) - 275) * 63 / 80, 0, 63)))
    (Ur.OverlayField.from_parcels(cool), Ur.OverlayField.from_parcels(hot))
  end
  type FloodFields = { live : NativeIntArr, potential : NativeIntArr }
  pfn flood_fields(c : Ur.Sim.City, lot : Int, fields : FloodFields) : FloodFields do
    if lot >= S.count() do fields else
      let risk = S.floodplain_depth(c, lot)
      let retained = S.get(c.surface_water, lot)
      let active = if S.rain_here(c, lot) == 4 && risk > retained do risk else retained end
      let potential = if risk > 0 do NativeArray.set_int(fields.potential, lot, risk) else fields.potential end
      let live = if active > 0 do NativeArray.set_int(fields.live, lot, active) else fields.live end
      flood_fields(c, lot + 1, { live: live, potential: potential })
    end
  end
  pfn flood_map_mesh(c : Ur.Sim.City, x : Int, z : Int, floor : Int, active : FloodProbe, risk : FloodProbe, n : Int, mesh : Ur.SceneMesh.Mesh) : Ur.SceneMesh.Mesh do
    if n >= 64 do mesh else
      let u = n % 8 * 4
      let v = n / 8 * 4
      let h = L.height(c, x + u + 2, z + v + 2)
      let (_, wet) = flood_at(active, u + 2, v + 2, h)
      let (_, danger) = flood_at(risk, u + 2, v + 2, h)
      let color = if wet > 0 do (if wet >= 6 do 31 else 12 end)
        else if danger > 0 do (if danger >= 6 do 15 else 18 end) else -1 end end
      let next = if color < 0 do mesh else face(mesh, u, S.clamp(h + 2 - floor, 0, 31), v, 4, 4, 0, color) end
      flood_map_mesh(c, x, z, floor, active, risk, n + 1, next)
    end
  end
  pfn flood_map(c : Ur.Sim.City, fields : FloodFields, lot : Int) : Unit do
    if lot >= S.count() do () else
      let wall = S.get(c.seawalls, lot) > 0
      let protected = wall || S.get(c.storm_drains, lot) > 0 || S.get(c.pump_orders, lot) > 0
      let slot = overlay_slot(lot)
      if !wall && S.get(c.heights, lot) == 0 do Vk.chunk_free(slot) else
        let x = lot % S.width() * 32
        let z = lot / S.width() * 32
        let floor = if wall do 18 else layer_floor(c, x, z) end
        let live = flood_probe(c, lot, fn i -> S.get(fields.live, i), 0, empty_flood())
        let risk = flood_probe(c, lot, fn i -> S.get(fields.potential, i), 0, empty_flood())
        let mesh = if !wall && (live.high > 0 || risk.high > 0) do
          flood_map_mesh(c, x, z, floor, live, risk, 0, { words: NativeArray.make_i32(128, 0), quads: 0 })
        else { words: NativeArray.make_i32(8, 0), quads: 0 } end
        let mesh = if mesh.quads == 0 && protected do layer_outline(11, mesh) else mesh end
        if mesh.quads == 0 do Vk.chunk_free(slot) else
          if Vk.chunk_begin(slot, x, floor, z, 0) && Vk.chunk_part(0, mesh.words, mesh.quads) && Vk.chunk_commit() do ()
          else Ur.AppError.stop("Floodplain map upload failed") end
        end
      end
      flood_map(c, fields, lot + 1)
    end
  end
  fn map_layer(c : Ur.Sim.City, st : Ur.Sim.Stats, previous : Int, layer : Int, far : Bool) : Unit do
    if Ur.Layers.is_utility(layer) || Ur.Layers.is_utility(previous) do utility_status_markers(c, st, layer, far, 0) else () end
    let tag = match layer do
      4 -> 253
      5 -> 252
      7 -> 251
      _ -> 0
    end
    if layer == 33 do
      let zero = NativeArray.make_int(S.count(), 0)
      clear_skin_high(0)
      flood_map(c, flood_fields(c, 0, { live: zero, potential: zero }), 0)
    else if tag > 0 do gradient_tiles(c, Ur.OverlayField.field(c, layer), tag, 0)
    else if layer == 32 do
      let (cool, hot) = heat_fields(c)
      skin_tiles(c, [{ samples: cool, tag: 252, dry: true }, { samples: hot, tag: 253, dry: true }], 0)
    else if layer == 38 do gradient_tiles(c, Ur.OverlayField.from_parcels(Ur.Layers.rain_strength(c)), 252, 0)
    else
      clear_skin_high(0)
      layer_tiles(c, st, layer, 0)
    end end end end
  end
  fn camera(cx : Float, cz : Float, zoom : Float, aspect : Float, yaw : Float) : Unit do
    let x = cx +. Math.sin(yaw) *. 194.0
    let z = cz +. Math.cos(yaw) *. 194.0
    let view = Strata.Math.Mat4.look_at(Strata.Math.Vec3.new(x, 151.0, z), Strata.Math.Vec3.new(cx, 3.0, cz), Strata.Math.Vec3.new(0.0, 1.0, 0.0))
    let proj = Strata.Math.Mat4.orthographic(0.0 -. zoom, zoom, 0.0 -. zoom /. aspect, zoom /. aspect, 0.1, 800.0)
    Vk.set_camera(Strata.Math.Mat4.mul_into_f32(proj, view, NativeArray.make_f32(16, 0.0)))
    Vk.set_eye(x, 151.0, z, 0.25)
  end
  fn tile_anchor(c : Ur.Sim.City, lot : Int, w : Float, h : Float, cx : Float, cz : Float, zoom : Float, yaw : Float) : (Float, Float) do
    if !S.valid(lot) || h <= 0.0 do (-1000.0, -1000.0) else
      let x = int_to_float(lot % S.width() * 8 + 4) -. cx
      let z = int_to_float(lot / S.width() * 8 + 4) -. cz
      let y = int_to_float(S.get(c.heights, lot)) *. 0.25 -. 3.0
      let sy = Math.sin(yaw)
      let cy = Math.cos(yaw)
      let right = x *. cy -. z *. sy
      let up = y *. 0.795 -. (x *. sy +. z *. cy) *. 0.607
      let scale = w /. (2.0 *. zoom)
      let half_tile = 4.0 *. (Math.abs(cy) +. Math.abs(sy))
      (w *. 0.5 +. (right +. half_tile) *. scale, h *. 0.5 -. (up +. half_tile *. 0.607) *. scale)
    end
  end
  pfn march_ray(c : Ur.Sim.City, x : Float, y : Float, z : Float, dx : Float, dz : Float, section : Int) : (Int, Ur.RoadShape.StreetPoint) do
    if y < (if section > 0 do -9.0 else -0.5 end) do (-1, { x: 0, z: 0 }) else
      let vx = float_to_int(Math.floor(x *. 4.0))
      let vz = float_to_int(Math.floor(z *. 4.0))
      let px = int_div_euclid(vx, 32)
      let pz = int_div_euclid(vz, 32)
      let inside = px >= 0 && px < S.width() && pz >= 0 && pz < S.depth()
      let i = S.index(px, pz)
      let cut = inside && section_cut(c, px, pz, section)
      let bore = cut && tunnel_lot(c, i)
      let h = if bore do
        let a = S.grade_source(c, i)
        let b = S.grade_peer(c, a)
        let (first, last) = if a < b do (a, b) else (b, a) end
        let along = if first / S.width() == last / S.width() do vx else vz end
        section_deck(c, i, first, last, int_mod_euclid(along, 32) / 4) + 2
      else if cut do -33 else if inside do L.height(c, vx, vz) else 0 end end end
      let level = if inside do S.get(c.buildings, i) else 0 end
      let kind = if inside do S.get(c.plants, i) else 0 end
      let stage = if inside do
        let construction = S.get(c.construction, i)
        if construction > 0 do construction else S.public_work_stage(c, i) end
      else 0 end
      let parking_garage = inside && S.get(c.public_parking, i) == 2
      let station = kind > 0 || parking_garage
      let lx = int_mod_euclid(vx, 32)
      let lz = int_mod_euclid(vz, 32)
      let road = inside && !cut && S.get(c.roads, i) > 0
      let top = h + (if station do (if parking_garage do 16 else if kind <= 2 || S.wind_turbine(kind) do 38 else if kind == 5 do 4 else if kind == 14 || kind >= 18 do 19 else 13 end end end end) else if stage > 0 do 1 + level * 11 + Ur.Architecture.worksite_rise(stage) else if level > 0 do 18 + level * 11 else 0 end end end)
      let structure = !cut && (station || level > 0 || stage > 0) && lx >= 3 && lx < 29 && lz >= 3 && lz < 30 && y *. 4.0 <= int_to_float(top)
      if inside && (y *. 4.0 <= int_to_float(h) || structure || (road && y *. 4.0 <= int_to_float(h + 3))) do (i, { x: vx, z: vz })
      else march_ray(c, x -. dx, y -. 0.125, z -. dz, dx, dz, section) end
    end
  end
  fn pick_at(c : Ur.Sim.City, wx : Float, base : Float) : Int do
    let start = if c.volcanic do 48.0 else 40.0 end
    let (lot, _) = march_ray(c, wx, start, base +. start, 0.0, 0.125, 0)
    lot
  end
  fn pick_site(c : Ur.Sim.City, mx : Float, my : Float, w : Float, h : Float, cx : Float, cz : Float, zoom : Float, yaw : Float, section : Int) : (Int, Ur.RoadShape.StreetPoint) do
    if w <= 0.0 || h <= 0.0 || mx < 0.0 || my < 0.0 || mx >= w || my >= h do (-1, { x: 0, z: 0 }) else
      let sx = (mx /. w *. 2.0 -. 1.0) *. zoom
      let sy = (1.0 -. my /. h *. 2.0) *. zoom *. h /. w
      let sin_yaw = Math.sin(yaw)
      let cos_yaw = Math.cos(yaw)
      let pitch = 148.0 /. math_sqrt(148.0 *. 148.0 +. 194.0 *. 194.0)
      let up = 194.0 /. math_sqrt(148.0 *. 148.0 +. 194.0 *. 194.0)
      let start = if c.volcanic do 48.0 else 40.0 end
      let travel = (start -. 3.0 -. sy *. up) *. 194.0 /. 148.0 -. sy *. pitch
      march_ray(c, cx +. sx *. cos_yaw +. sin_yaw *. travel, start, cz -. sx *. sin_yaw +. cos_yaw *. travel,
        sin_yaw *. 194.0 /. 148.0 *. 0.125, cos_yaw *. 194.0 /. 148.0 *. 0.125, section)
    end
  end
  fn pick(c : Ur.Sim.City, mx : Float, my : Float, w : Float, h : Float, cx : Float, cz : Float, zoom : Float, yaw : Float, section : Int) : Int do
    let (lot, _) = pick_site(c, mx, my, w, h, cx, cz, zoom, yaw, section)
    lot
  end

end
