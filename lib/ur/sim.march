      12 -> "Wind turbine"
      33 -> "Offshore wind turbine"
      34 -> "Waste export dock"
      35 -> "Ocean waste dump"
      36 -> "Waste incinerator"
      13 -> "Solar array"
      14 -> "Nuclear station"
      15 -> "Biogas plant"
      16 -> "Trash collection depot"
