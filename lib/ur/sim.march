-- Parcel simulation: money and quantities use integers for deterministic ticks.
mod Ur.Sim do
  alias Ur.Demography as D
  alias Ur.UtilitiesNetwork as Net
  type Shipment = { source : Int, stops : List(Int), legs : Int, units : Int }
  type Expansion = { island : Int, invested : Int, recovered : Int, exports : Int, net : Int }
  type FinanceMonth = { month : Int, revenue : Int, expenditures : Int, budget : Budget, construction : Int, property_receipts : Int }
  type ParkWalk = { steps : NativeIntArr, next : NativeIntArr }
  type MedicalTransfer = { facility : Int, bed : Int, transport : Int, wait : Int, stay : Int, outcome : Int, route : List(Int) }
  type Incident = { lot : Int, kind : Int, reported : Int, station : Int, response : Int, travel : Int, road : List(Int), spread : List(Int), medical : Option(MedicalTransfer) }
  type CrimeMonth = { month : Int, calls : List(Incident) }
  type CrimeReport = { incidents : Int, responses : Int, minutes : Int, harm : Int }
  type WasteRun = { depot : Int, pickup : Int, site : Int, kind : Int, units : Int, route : List(Int), pickup_leg : Int }
  type DivineEffect = { god : Int, until_day : Int, site : Int }
  type Religion = {
    patron : Int, chosen : Int, unlocked : Int, festival_policy : Int, offering_policy : Int,
    offering_year : Int, offering_spend : Int, petition_day : Int, rolls : Int,
    dedication_target : Int, dedication_end : Int,
    favor : DivineEffect, curse : DivineEffect, curse_stamp : Int, epicenter : Int, wrath_god : Int,
    festival_stamp : Int, festival_hosts : Int, festival_attendees : Int, festival_site : Int,
    festival_feedback : NativeIntArr, festival_absence : NativeIntArr, festival_attending : NativeIntArr
  }
  type FestivalSummary = { hosts : Int, attendees : Int, food : Int, trash : Int, sites : List(Int) }
  type FestivalHost = { lot : Int, tier : Int, walk : ParkWalk, reachable : Int }
  type FestivalAttendance = { sites : NativeIntArr, households : NativeIntArr, people : Int }
  type FestivalPlan = { sites : List(FestivalHost), attendance : FestivalAttendance, summary : FestivalSummary }
  type City = {
    census : NativeIntArr, population_history : List(NativeIntArr), immigration : Int,
    council : NativeIntArr, religion : Religion,
    climate_seed : Int,
    rain_uniform : Bool, watch : Int, rain_now : NativeIntArr,
    storm_drains : NativeIntArr, seawalls : NativeIntArr,
    pump_orders : NativeIntArr, surface_water : NativeIntArr, flood_damage : NativeIntArr, flood_active : Bool,
    rain_tanks : NativeIntArr, subway_water : NativeIntArr, soil_moisture : Int, pumping_cost : Int, battery : Int, hour : Int,
    calendar_day : Int, clock_ms : Int, street_day : Int, car_free_days : NativeIntArr,
    ground_rule : Int, quiet_rule : Int, ground_areas : NativeIntArr, quiet_areas : NativeIntArr, storefronts : NativeIntArr, footfall : NativeIntArr,
    fire_recovery : NativeIntArr,
    crime_history : List(CrimeMonth), livability_history : List(NativeIntArr),
    grades : NativeIntArr, grade_cover : NativeIntArr, parks : NativeIntArr, park_tiers : NativeIntArr, streetscape : NativeIntArr, sidewalk_items : NativeIntArr,
    campus : NativeIntArr, education : NativeIntArr, specializations : NativeIntArr, business_sector : NativeIntArr,
    empty_homes : NativeIntArr, home_arrivals : NativeIntArr, neighborhood_rents : NativeIntArr,
    market_history : List(NativeIntArr), rent_pressure : NativeIntArr, business_age : NativeIntArr,
    property_status : NativeIntArr, property_arrears : NativeIntArr, property_sales : Int,
    finance_history : List(FinanceMonth), construction_spend : Int,
    expansion : Expansion, island_spend : NativeIntArr, island_exports : Int, island_crops : Int, island_catch : Int,
    freight : Option(Ur.FreightNetwork.Route), shop_stock : NativeIntArr, shop_sales : NativeIntArr, shop_delivered : NativeIntArr, shop_imports : Int, shipments : List(Shipment),
    harbour : Int, founding_map : Bool, heights : NativeIntArr, roads : NativeIntArr, tolls : NativeIntArr, public_parking : NativeIntArr, transit : NativeIntArr, stops : NativeIntArr, ferries : NativeIntArr, ferry_start : Int, service : NativeIntArr, bus_headways : NativeIntArr, bus_fare : Int, zones : NativeIntArr,
    density : NativeIntArr, nuisance : NativeIntArr, buildings : NativeIntArr, housing_losses : NativeIntArr, business_losses : NativeIntArr, construction : NativeIntArr, plants : NativeIntArr, paused_facilities : NativeIntArr,
    pipes : NativeIntArr, grid : NativeIntArr, pollution : NativeIntArr, land_pollution : NativeIntArr, air_pollution : NativeIntArr, trash : Int,
    waste_live : Bool, waste_bins : NativeIntArr, waste_stock : NativeIntArr, waste_sites : NativeIntArr,
    waste_last : NativeIntArr, waste_log : NativeIntArr, waste_runs : List(WasteRun),
    cash : Int, month : Int, tax : Int, business_rate : Int, import_rate : Int, export_rate : Int, energy : Int, income : Int, message : String
  }
  type Waste = { generated : Int, collected : Int, digested : Int, buried : Int, exported : Int, dumped : Int, burned : Int, pending : Int }
  type Power = { gas : Int, geothermal : Int, wind : Int, solar : Int, nuclear : Int, biogas : Int, cost : Int }
  type Services = { rain : Int, recycled : Int, imported_water : Int, wastewater : Int, discharged : Int, untreated : Int, fish_revenue : Int, treatment_power : Int, operating_farms : Int, island_farms : Int, geothermal : Int, wells : Int, desal : Int, farms : Int, fish : Int, imports : Int, farm_exports : Int, water_used : Int, food_used : Int }
  fn ground_name(rule : Int) : String do
    if rule == 1 do "Housing or offices" else if rule == 3 do "Require storefronts" else "Allow storefronts" end end
  end
  fn quiet_name(rule : Int) : String do
    if rule == 2 do "Ends at 10 pm" else if rule == 3 do "No nightlife" else "Ends at 2 am" end end
  end
  fn ground_at(c : City, i : Int) : Int do
    let rule = get(c.ground_areas, i)
    if rule == 0 do c.ground_rule else rule end
  end
  fn quiet_at(c : City, i : Int) : Int do
    let rule = get(c.quiet_areas, i)
    if rule == 0 do c.quiet_rule else rule end
  end
  fn area_policy_tool(tool : Int) : Bool do tool >= 63 && tool <= 70 end
  fn storefront(c : City, i : Int) : Int do
    let business = get(c.storefronts, i)
    if ground_at(c, i) == 1 do 0
    else if business == 2 && quiet_at(c, i) == 3 do 1 else business end end
  end
  fn commercial_ground(c : City, i : Int) : Bool do
    storefront(c, i) > 0 || (get(c.zones, i) == 3 && ground_at(c, i) != 1)
  end
  type BuildingUse = Apartments | Workplace | Grocery | Restaurant | GroceryHomes | RestaurantHomes | Bar | BarHomes | EmptyShop | Vacant
  fn building_use(c : City, i : Int) : BuildingUse do
    let zone = get(c.zones, i)
    let business = storefront(c, i)
    let homes = zone != 2 && get(c.buildings, i) > 1
    if get(c.buildings, i) == 0 do Vacant
    else if ground_at(c, i) == 1 do
      if zone == 2 do Workplace else if zone > 0 do Apartments else Vacant end end
    else if business == 1 do (if homes do GroceryHomes else Grocery end)
    else if business == 2 do (if homes do BarHomes else Bar end)
    else if business == 3 do EmptyShop
    else
      match zone do
        1 -> Apartments
        2 -> match (i % width() + i / width()) % 3 do
          0 -> Grocery
          1 -> Restaurant
          _ -> Workplace
        end
        3 -> if i % 2 == 0 do GroceryHomes else RestaurantHomes end
        _ -> Vacant
      end
    end end end end end
  end
  fn nightlife(c : City, i : Int) : Bool do
    get(c.buildings, i) > 0 && storefront(c, i) == 2 && !building_offline(c, i) && !business_closed(c, i)
  end
  fn public_trade(c : City, i : Int) : Bool do retail(c, i) > 0 || nightlife(c, i) end
  fn retail(c : City, i : Int) : Int do
    if building_offline(c, i) || business_closed(c, i) do 0 else retail_kind(c, i) end
  end
  fn retail_kind(c : City, i : Int) : Int do
    match building_use(c, i) do
      Grocery | GroceryHomes -> 1
      Restaurant | RestaurantHomes -> 2
      _ -> 0
    end
  end
  fn building_name(c : City, i : Int) : String do
    match building_use(c, i) do
      Apartments -> "Apartments"
      Workplace -> "Workplace"
      Grocery -> "Grocery store"
      Restaurant -> "Restaurant"
      GroceryHomes -> if get(c.buildings, i) == 1 do "Grocery store" else "Grocery + apartments" end
      RestaurantHomes -> if get(c.buildings, i) == 1 do "Restaurant" else "Restaurant + apartments" end
      Bar -> "Bar"
      BarHomes -> "Bar + apartments"
      EmptyShop -> "Vacant storefront"
      Vacant -> if get(c.plants, i) > 0 do facility_name(get(c.plants, i)) else "" end
    end
  end
  type Accounts = { earnings : Int, rent : Int, tax : Int, costs : Int }
  fn margin(a : Accounts) : Int do a.earnings - a.rent - a.tax - a.costs end
  type Labor = { workforce : Int, employed : Int, unemployed : Int, vacancies : Int, wages : Int, local_income : Option(NativeIntArr), fares : Option(NativeIntArr) }
  pfn labor_with_fares(labor : Labor, fares : NativeIntArr) : Labor do { labor with fares: Some(fares) } end
  type Budget = { revenue : Int, property_tax : Int, income_tax : Int, business_tax : Int, trade_income : Int, tariffs : Int, toll_income : Int, parking_income : Int, bus_fares : Int, bus_operations : Int, freight_operations : Int, infrastructure : Int, operations : Int, energy_income : Int, power_cost : Int, food_cost : Int, water_cost : Int, sanitation_cost : Int }
  type Stats = { startup_step : Int, staffed_jobs : NativeIntArr, job_matches : List(JobMatch), buses : BusNetwork, school_seats : NativeIntArr, skill_jobs : NativeIntArr, market : NativeIntArr, rent_tiers : NativeIntArr, park_walk : ParkWalk, worship : NativeIntArr, understaffed_shrines : Int, festival : FestivalSummary, civic : NativeIntArr, riders : NativeIntArr, running_transit : NativeIntArr, labor : Labor, traffic : NativeIntArr, junctions : NativeIntArr, budget : Budget, growth_pressure : String, commutes : NativeIntArr, generation : Power, waste : Waste, services : Services, utilities : UtilityReport, project_capacity : UtilityReservation, people : Int, work : Int, used : Int, power : Int, routes : NativeIntArr }
  type Development = Unzoned | Full | Market | NeedsSchoolOrClinic | NeedsCivicServices | Restricted | NoRoad | Flooded | Dirty | NoPower | NoPowerLine | PowerBottleneck | NoFood | NoWater | NoWaterLine | WaterBottleneck | NoSewer | SewerBottleneck | HighTax | HighEnergy | Remote | PoorJobAccess | NoJobs | NoWorkers | Unaffordable | Unprofitable | Ready
  fn stats(c : City) : Stats do
    let routes = access(c)
    let people = population(c)
    let work = jobs(c)
    let gen = generation(c, routes)
    let networks = utility_report(c, routes, gen, people)
    let utilities = services_with(c, routes, people, gen, networks)
    let forecast = if c.founding_map && valid(c.harbour) do deliver_food(c, routes, utilities) else c end
    let utilities = if c.founding_map && valid(c.harbour) do services_with(forecast, routes, people, gen, networks) else utilities end
    let reservations = reserve_utilities(c, routes, networks)
    let collection = waste(c, routes)
    let used = array_total(networks.electric.demand, 0, 0) + utilities.treatment_power
    let power = power_total(gen) + networks.battery_out
    let (reserved_people, reserved_power) = construction_demand(c, routes, 0, people, used)
    let pressure = if reserved_power + 4 > power do "Growth needs more power"
      else if water_total(utilities) < reserved_people + 16 do "Growth needs more water"
      else if !food_room(c, routes, reserved_people, networks, gen) do "Growth needs more food"
      else "Capacity for another housing lot" end end end
    let running = transit_service(c, power)
    let transport = transport_report_with(c, routes, running, people, work)
    let operating = operating_city(c, transport.buses)
    let traffic = transport.traffic
    let riders = transport.riders
    let hiring = transport.hiring
    let labor = labor_with_fares(hiring.labor, transport.buses.fares)
    let profit_tax = business_receipts(forecast, routes, hiring, people, work)
    let commutes = economic_commutes(operating, traffic, running, transport.buses)
    { startup_step: startup_step(c, routes, utilities, power, used, people, work), staffed_jobs: hiring.filled, job_matches: hiring.matches, buses: transport.buses, school_seats: school_seats(c, routes, 0, NativeArray.make_int(4, 0)), skill_jobs: skill_jobs(c, routes, 0, NativeArray.make_int(9, 0)), market: market_sample(c, routes, commutes, labor, people, work, 0, 0), rent_tiers: rent_tier_counts(c, routes, 0, NativeArray.make_int(10, 0)), park_walk: park_walk(c), worship: worship_field(c, routes, hiring.filled, 0, NativeArray.make_int(2640, 0)),
      understaffed_shrines: count_understaffed_shrines(c, routes, hiring.filled, 0, 0),
      festival: (plan_festivals(c, routes, hiring.filled)).summary, civic: civic_access_with(c, routes), riders: riders, running_transit: running, labor: labor, traffic: traffic, junctions: junction_controls(c, traffic, 0, NativeArray.make_int(count(), 0)), commutes: commutes, generation: gen, waste: collection, people: people, work: work,
      used: used, power: power, routes: routes, services: utilities, utilities: networks, project_capacity: reservations, growth_pressure: pressure,
      budget: budget(forecast, traffic, people, labor, profit_tax, networks.electric.total, power, utilities, collection, gen.cost, transport.buses.lines) }
  end
  pfn is_ready(s : Development) : Bool do
    match s do
      Ready -> true
      _ -> false
    end
  end
  pfn status_text(s : Development) : String do
    match s do
      Unzoned -> "Unzoned land"
      Market -> "More demand or better access needed for taller buildings"
      NeedsSchoolOrClinic -> "Add a school or clinic for a second floor"
      NeedsCivicServices -> "A third floor needs all four civic services"
      Restricted -> "Current use exceeds the parcel nuisance limit"
      Full -> "At permitted density"
      NoRoad -> "No road connection to the harbour"
      Flooded -> "Surface flooding · Construction waits for water to recede"
      Dirty -> "High local pollution blocks housing growth"
      NoPower -> "No spare generation for this parcel"
      NoPowerLine -> "This zone needs a connected power line"
      PowerBottleneck -> "Power bottleneck · Upgrade or bypass the feeder"
      NoWaterLine -> "This zone needs a connected water pipe"
      WaterBottleneck -> "Water bottleneck · Upgrade or bypass the pipe"
      NoSewer -> "No sewage collection capacity · Connect an operating outlet"
      SewerBottleneck -> "Sewage bottleneck · Upgrade or bypass the pipe"
      NoFood -> "Food supply cannot support more homes"
      NoWater -> "Add freshwater capacity before building homes"
      HighTax -> "Taxes make development unprofitable"
      HighEnergy -> "Energy is too expensive"
      Remote -> "Transport costs are too high"
      PoorJobAccess -> "Too few jobs within a 36-minute commute"
      NoJobs -> "Waiting for more jobs"
      Unaffordable -> "Households cannot afford the rent and commute"
      Unprofitable -> "Expected sales do not cover business costs"
      NoWorkers -> "Waiting for workers and customers"
      Ready -> "Ready for private development"
    end
  end
  fn width() : Int do 60 end
  fn depth() : Int do 44 end
  fn count() : Int do 2640 end
  fn index(x : Int, z : Int) : Int do z * width() + x end
  fn valid(i : Int) : Bool do i >= 0 && i < count() end
  fn clamp(v : Int, lo : Int, hi : Int) : Int do if v < lo do lo else if v > hi do hi else v end end end
  fn get(a : NativeIntArr, i : Int) : Int do if valid(i) do NativeArray.get_int(a, i) else 0 end end
  fn neighbour(i : Int, d : Int) : Int do
    if d == 0 do (if i % width() > 0 do i - 1 else -1 end)
    else if d == 1 do (if i % width() < width() - 1 do i + 1 else -1 end)
    else if d == 2 do (if i >= width() do i - width() else -1 end)
    else if i < count() - width() do i + width() else -1 end end end end
  end
  fn terrain(x : Int, z : Int) : Int do
    let a = 100 - (x - 12) * (x - 12) - (z - 14) * (z - 14)
    let b = 30 - (x - 28) * (x - 28) - (z - 13) * (z - 13)
    -- a mountain about 42 m high, on the same footprint as the old 22 m hill
    let hill = clamp((70 - (x - 10) * (x - 10) * 3 - (z - 9) * (z - 9) * 2) * 23 / 10, 0, 161)
    if a > 0 do 4 + a / 10 + hill else if b > 0 do 4 + b / 3 else 0 end end
  end
  pfn farm_contour(x : Int, z : Int) : Int do
    66 - (x - 46) * (x - 46) - 2 * (z - 32) * (z - 32)
  end
  pfn shoal_contour(x : Int, z : Int) : Int do
    21 - (x - 55) * (x - 55) - (z - 23) * (z - 23)
  end
  pfn main_profile(x : Float, z : Float) : (Int, Int, Int) do
    let dx = x -. 20.0
    let dz = z -. 22.0
    let main = float_to_int(900.0 -. 3.0 *. dx *. dx -. 4.0 *. dz *. dz)
    let hx = x -. 15.0
    let hz = z -. 13.0
    -- the island's mountain, about 43 m at its peak, steep enough to stay clear of the coast
    let hill = clamp(float_to_int(160.0 -. 4.0 *. hx *. hx -. 5.0 *. hz *. hz), 0, 160)
    if main > 0 do (4 + main / 100 + hill, main, 130) else (0, 0, 0) end
  end
  pfn outer_profile(x : Int, z : Int) : (Int, Int, Int) do
    let volcano = 49 - (x - 45) * (x - 45) - (z - 13) * (z - 13)
    let farms = farm_contour(x, z)
    let shoals = shoal_contour(x, z)
    if volcano > 0 do (4 + volcano * volcano / 28, volcano, 12)
    else if farms > 0 do (5 + farms / 13, farms, 14)
    else if shoals > 0 do (4 + shoals / 5, shoals, 8)
    else (0, 0, 0) end end end
  end
  fn archipelago(x : Int, z : Int) : Int do
    let (main, _, _) = main_profile(int_to_float(x), int_to_float(z))
    let (outer, _, _) = outer_profile(x, z)
    if main > 0 do main else outer end
  end
  pfn archipelago_fill(a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= count() do a
    else archipelago_fill(NativeArray.set_int(a, i, archipelago(i % width(), i / width())), i + 1) end
  end
  type IslandShape = { breadth : Float, length : Float, bend : Float, inlet : Float, river : Bool, drift : Float }
  pfn island_shape(seed : Int) : IslandShape do
    { breadth: 0.83 +. 0.24 *. Strata.Seed.unit(Strata.Seed.mix(seed, 3)),
      length: 0.86 +. 0.29 *. Strata.Seed.unit(Strata.Seed.mix(seed, 4)),
      bend: (Strata.Seed.unit(Strata.Seed.mix(seed, 5)) -. 0.5) *. 5.0,
      inlet: Strata.Seed.unit(Strata.Seed.mix(seed, 6)) *. 6.2831853,
      river: seed % 3 == 0, drift: (Strata.Seed.unit(Strata.Seed.mix(seed, 7)) -. 0.5) *. 0.64 }
  end
  pfn river_column(shape : IslandShape, z : Int) : Int do
    let run = int_to_float(z - 18)
    let wave = Math.sin(run *. 0.22 +. shape.inlet) -. Math.sin(shape.inlet)
    float_to_int(20.5 -. 5.0 *. shape.breadth +. run *. shape.drift +. wave *. 2.8)
  end
  pfn varied_islands(shape : IslandShape, shore : NativeF32Arr, relief : NativeF32Arr, heights : NativeIntArr, i : Int) : NativeIntArr do
    if i == count() do heights else
      let x = i % width()
      let z = i / width()
      let along = int_to_float(z - 22)
      let bend = shape.bend *. Math.sin(along *. 0.15)
      let (base, margin, band) = if x < 38 do
        main_profile(20.0 +. (int_to_float(x - 20) -. bend) /. shape.breadth, 22.0 +. along /. shape.length)
      else outer_profile(x, z) end
      let bite = (NativeArray.get_f32(shore, i) +. 0.3) *. int_to_float(band)
      let height = if base == 0 || int_to_float(margin) <= bite do 0 else
        let delta = clamp(float_to_int(NativeArray.get_f32(relief, i) *. 7.0), -4, 4)
        clamp(base + delta, 4, if base <= 18 do 18 else 176 end)
      end
      let height = if shape.river && x < 38 && z >= 18 do
        let bank = int_abs(x - river_column(shape, z))
        let previous = if z == 18 do bank else int_abs(x - river_column(shape, z - 1)) end
        if bank == 0 || previous == 0 do 0 else if bank == 1 || previous == 1 do clamp(height, 0, 9) else height end end
      else height end
      varied_islands(shape, shore, relief, NativeArray.set_int(heights, i, height), i + 1)
    end
  end
  fn unclaimed_seeded(seed : Int) : City do
    let recipe = Strata.Noise.settings(0, 3, 2.0, 0.5, 1, 0.0)
    let shore = NativeArray.make_f32(count(), 0.0)
    let relief = NativeArray.make_f32(count(), 0.0)
    let shore_count = Strata.Noise.field2(recipe, Strata.Seed.mix(seed, 1), 0.018, 4.0, 4.0, 8.0, width(), depth(), shore)
    let relief_count = Strata.Noise.field2(recipe, Strata.Seed.mix(seed, 2), 0.009, 4.0, 4.0, 8.0, width(), depth(), relief)
    let city = if shore_count != count() || relief_count != count() do unclaimed()
    else unclaimed_with_heights(varied_islands(island_shape(seed), shore, relief, NativeArray.make_int(count(), 0), 0)) end
    { city with climate_seed: Strata.Seed.mix(seed, 705) % 2147483646 + 1 }
  end
  pfn new_expansion() : Expansion do
    { island: 0, invested: 0, recovered: 0, exports: 0, net: 0 }
  end
  -- The two destination islands with a regional food specialty.
  fn food_island(c : City, i : Int) : Int do
    if !c.founding_map || !valid(i) || get(c.heights, i) == 0 do 0 else
      let x = i % width()
      let z = i / width()
      if farm_contour(x, z) > 0 do 1
      else if shoal_contour(x, z) > 0 do 2 else 0 end end
    end
  end
  pfn remote_food_island(c : City, i : Int) : Int do
    let island = food_island(c, i)
    if island == food_island(c, c.harbour) do 0 else island end
  end
  fn unclaimed() : City do
    unclaimed_with_heights(archipelago_fill(NativeArray.make_int(count(), 0), 0))
  end
  pfn unclaimed_with_heights(heights : NativeIntArr) : City do
    let zero = NativeArray.make_int(2640, 0)
    { census: D.empty(), population_history: Nil, immigration: 1, council: NativeArray.make_int(2640, 0), religion: new_religion(), climate_seed: 0, rain_uniform: false, watch: 1, rain_now: NativeArray.make_int(2640, 0), storm_drains: zero, seawalls: zero, pump_orders: zero, surface_water: zero, flood_damage: zero, flood_active: false, rain_tanks: zero, subway_water: zero, soil_moisture: 70, pumping_cost: 0, battery: 0, hour: 9, grades: NativeArray.make_int(2640, 0), grade_cover: NativeArray.make_int(2640, 0), parks: NativeArray.make_int(2640, 0), park_tiers: NativeArray.make_int(2640, 0), streetscape: NativeArray.make_int(2640, 0), sidewalk_items: NativeArray.make_int(2640, 0), campus: NativeArray.make_int(2640, 0), education: new_education(), specializations: new_specializations(), business_sector: NativeArray.make_int(2640, 0), empty_homes: NativeArray.make_int(2640, 0), home_arrivals: NativeArray.make_int(2640, 0), neighborhood_rents: NativeArray.make_int(80, 0), market_history: Nil, rent_pressure: neutral_rent_pressure(), business_age: NativeArray.make_int(2640, 0), property_status: NativeArray.make_int(2640, 0), property_arrears: NativeArray.make_int(2640, 0), property_sales: 0, finance_history: Nil, crime_history: Nil, fire_recovery: NativeArray.make_int(2640, 0), calendar_day: 0, clock_ms: 675, street_day: 0, car_free_days: NativeArray.make_int(2640, 0), ground_rule: 2, quiet_rule: 1, ground_areas: NativeArray.make_int(2640, 0), quiet_areas: NativeArray.make_int(2640, 0), storefronts: NativeArray.make_int(2640, 0), footfall: NativeArray.make_int(2640, 0), livability_history: Nil, construction_spend: 0, expansion: new_expansion(), island_spend: NativeArray.make_int(3, 0), island_exports: 0, island_crops: 0, island_catch: 0, freight: None, shop_stock: zero, shop_sales: zero, shop_delivered: zero, shop_imports: 0, shipments: Nil, harbour: -1, founding_map: true, heights: heights, roads: zero, tolls: zero, public_parking: zero,
      transit: zero, stops: zero, ferries: zero, ferry_start: -1, service: NativeArray.make_int(2640, 1), bus_headways: NativeArray.make_int(2640, 0), bus_fare: 1,
      zones: zero, density: NativeArray.make_int(2640, 3), nuisance: NativeArray.make_int(2640, 3),
      buildings: zero, housing_losses: zero, business_losses: zero, construction: zero, plants: zero, paused_facilities: zero, pipes: zero, grid: zero, pollution: zero, land_pollution: zero, air_pollution: zero,
      trash: 0, waste_live: true, waste_bins: zero, waste_stock: zero, waste_sites: zero, waste_last: zero, waste_log: zero, waste_runs: Nil, cash: 18000, month: 0, tax: 10, business_rate: 10, import_rate: 0, export_rate: 0, energy: 4, income: 0,
      message: "Survey the islands. Click a low shoreline parcel to establish your harbour." }
  end
  fn can_land(c : City, i : Int) : Bool do
    c.harbour < 0 && valid(i) && get(c.heights, i) <= 18 && coastal(c, i)
  end
  fn land(c : City, i : Int) : City do
    if can_land(c, i) do
      { c with harbour: i, roads: NativeArray.set_int(c.roads, i, 1),
        pipes: NativeArray.set_int(c.pipes, i, 1), grid: NativeArray.set_int(c.grid, i, 1),
        message: "Harbour established. Extend a local street inland." }
    else c end
  end
  pfn terrain_fill(a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= count() do a else terrain_fill(NativeArray.set_int(a, i, terrain(i % width(), i / width())), i + 1) end
  end
  pfn seed(c : City, z : Int) : City do
    if z > 21 do c
    else
      let road = index(9, z)
      let home = index(10, z)
      let shop = index(8, z)
      seed({ c with grid: NativeArray.set_int(c.grid, road, 1), pipes: NativeArray.set_int(c.pipes, road, 1), roads: NativeArray.set_int(c.roads, road, 1),
        zones: NativeArray.set_int(NativeArray.set_int(c.zones, home, 1), shop, 2),
        buildings: NativeArray.set_int(NativeArray.set_int(c.buildings, home, if z >= 20 do 1 else 0 end), shop, if z == 20 do 2 else 0 end)
      }, z + 1)
    end
  end
  fn new() : City do
    let zero = NativeArray.make_int(2640, 0)
    seed({ census: D.empty(), population_history: Nil, immigration: 1, council: NativeArray.make_int(2640, 0), religion: new_religion(), climate_seed: 0, rain_uniform: false, watch: 0, rain_now: NativeArray.make_int(2640, 0), storm_drains: zero, seawalls: zero, pump_orders: zero, surface_water: zero, flood_damage: zero, flood_active: false, rain_tanks: zero, subway_water: zero, soil_moisture: 70, pumping_cost: 0, battery: 0, hour: 9, grades: NativeArray.make_int(2640, 0), grade_cover: NativeArray.make_int(2640, 0), parks: NativeArray.make_int(2640, 0), park_tiers: NativeArray.make_int(2640, 0), streetscape: NativeArray.make_int(2640, 0), sidewalk_items: NativeArray.make_int(2640, 0), campus: NativeArray.make_int(2640, 0), education: new_education(), specializations: new_specializations(), business_sector: NativeArray.make_int(2640, 0), empty_homes: NativeArray.make_int(2640, 0), home_arrivals: NativeArray.make_int(2640, 0), neighborhood_rents: NativeArray.make_int(80, 0), market_history: Nil, rent_pressure: neutral_rent_pressure(), business_age: NativeArray.make_int(2640, 0), property_status: NativeArray.make_int(2640, 0), property_arrears: NativeArray.make_int(2640, 0), property_sales: 0, finance_history: Nil, crime_history: Nil, fire_recovery: NativeArray.make_int(2640, 0), calendar_day: 0, clock_ms: 0, street_day: 0, car_free_days: NativeArray.make_int(2640, 0), ground_rule: 2, quiet_rule: 1, ground_areas: NativeArray.make_int(2640, 0), quiet_areas: NativeArray.make_int(2640, 0), storefronts: NativeArray.make_int(2640, 0), footfall: NativeArray.make_int(2640, 0), livability_history: Nil, construction_spend: 0, expansion: new_expansion(), island_spend: NativeArray.make_int(3, 0), island_exports: 0, island_crops: 0, island_catch: 0, freight: None, shop_stock: NativeArray.make_int(2640, 0), shop_sales: NativeArray.set_int(NativeArray.make_int(2640, 0), index(8, 20), 8), shop_delivered: NativeArray.make_int(2640, 0), shop_imports: 0, shipments: Nil, harbour: index(9, 21), founding_map: false, heights: terrain_fill(NativeArray.make_int(2640, 0), 0), roads: NativeArray.make_int(2640, 0), tolls: NativeArray.make_int(2640, 0), public_parking: NativeArray.make_int(2640, 0), transit: NativeArray.make_int(2640, 0), stops: NativeArray.make_int(2640, 0), ferries: NativeArray.make_int(2640, 0), ferry_start: -1, service: NativeArray.make_int(2640, 1), bus_headways: NativeArray.make_int(2640, 0), bus_fare: 1,
      zones: NativeArray.make_int(2640, 0), density: NativeArray.make_int(2640, 3), nuisance: NativeArray.make_int(2640, 3), buildings: NativeArray.make_int(2640, 0), housing_losses: NativeArray.make_int(2640, 0), business_losses: NativeArray.make_int(2640, 0), construction: NativeArray.make_int(2640, 0),
      plants: NativeArray.set_int(NativeArray.set_int(NativeArray.make_int(2640, 0), index(8, 21), 1), index(9, 22), 3),
      paused_facilities: NativeArray.make_int(2640, 0), pipes: NativeArray.set_int(NativeArray.make_int(2640, 0), index(9, 21), 1), grid: NativeArray.make_int(2640, 0), pollution: NativeArray.make_int(2640, 0), land_pollution: NativeArray.make_int(2640, 0), air_pollution: NativeArray.make_int(2640, 0), trash: 0, waste_live: false, waste_bins: NativeArray.make_int(count(), 0), waste_stock: NativeArray.make_int(count(), 0), waste_sites: NativeArray.make_int(count(), 0), waste_last: NativeArray.make_int(count(), 0), waste_log: NativeArray.make_int(count(), 0), waste_runs: Nil,
      cash: 18000, month: 0, tax: 10, business_rate: 10, import_rate: 0, export_rate: 0, energy: 4, income: 0,
      message: "Connect land. Zone it. Let people build. Reach 500 residents with a positive budget." }, 16)
  end
  -- Each reachable road enters the queue once. O(parcels), no all-pairs routing.
  fn day_seconds() : Float do 1.8 end
  fn days_per_month() : Int do 30 end
  fn new_religion() : Religion do
    let empty = { god: 0, until_day: 0, site: -1 }
    let zero = NativeArray.make_int(2640, 0)
    { patron: 0, chosen: 0, unlocked: 0, festival_policy: 0, offering_policy: 0,
      offering_year: 0, offering_spend: 0, petition_day: 0, rolls: 0,
      dedication_target: 0, dedication_end: 0, favor: empty, curse: empty, curse_stamp: 0,
      epicenter: -1, wrath_god: 0, festival_stamp: 0, festival_hosts: 0, festival_attendees: 0,
      festival_site: -1, festival_feedback: zero, festival_absence: zero, festival_attending: zero }
  end
  fn god_name(god : Int) : String do
    match god do
      1 -> "Idra"
      2 -> "Saren"
      3 -> "Tarek"
      4 -> "Namar"
      5 -> "Ishara"
      _ -> "No patron"
    end
  end
  fn god_domain(god : Int) : String do
    match god do
      1 -> "Rivers and rain"
      2 -> "Sun and harvest"
      3 -> "Stone and building"
      4 -> "Sea, fishing, and trade"
      5 -> "Health, households, and healing"
      _ -> ""
    end
  end
  fn favor_name(god : Int) : String do
    match god do
      1 -> "Filled rain collectors and stronger crops for 30 days"
      2 -> "Bountiful farm yields for 30 days"
      3 -> "Faster construction and repairs for 30 days"
      4 -> "Larger catches and ferry cargo holds for 30 days"
      5 -> "Faster treatment and fewer sick days for 30 days"
      _ -> ""
    end
  end
  fn curse_name(god : Int) : String do
    match god do
      1 -> "Unending Rain"
      2 -> "Scorching Sun"
      3 -> "Earthquake"
      4 -> "King Tide"
      5 -> "The Fever"
      _ -> ""
    end
  end
  fn curse_duration(god : Int) : Int do
    match god do
      1 -> 30
      2 -> 21
      3 -> 10
      4 -> 3
      5 -> 14
      _ -> 0
    end
  end
  fn patron(c : City) : Int do c.religion.patron end
  fn chosen_patron(c : City) : Int do if patron(c) > 0 do patron(c) else c.religion.chosen end end
  fn dedicate(c : City, god : Int) : City do
    if patron(c) > 0 || god < 1 || god > 5 do c else
      { c with religion: { c.religion with chosen: god }, message: "Build a shrine to dedicate the city to " ++ god_name(god) ++ "." }
    end
  end
  fn festival_policy(c : City) : Int do c.religion.festival_policy end
  fn set_festival_policy(c : City, policy : Int) : City do
    if policy < 0 || policy > 2 || policy == festival_policy(c) do c else
      { c with religion: { c.religion with festival_policy: policy }, message: "Festival policy updated." }
    end
  end
  fn offering_policy(c : City) : Int do c.religion.offering_policy end
  fn set_offering_policy(c : City, policy : Int) : City do
    if policy < 0 || policy > 2 || policy == offering_policy(c) do c else
      { c with religion: { c.religion with offering_policy: policy }, message: "Offering policy updated." }
    end
  end
  fn absolute_day(c : City) : Int do c.month * days_per_month() + c.calendar_day end
  fn rededication_duration() : Int do 30 end
  fn rededication_days(c : City) : Int do clamp(c.religion.dedication_end - absolute_day(c), 0, rededication_duration()) end
  fn favor_days(c : City) : Int do clamp(c.religion.favor.until_day - absolute_day(c), 0, 30) end
  fn curse_days(c : City) : Int do clamp(c.religion.curse.until_day - absolute_day(c), 0, 30) end
  fn favor_god(c : City) : Int do if favor_days(c) > 0 do c.religion.favor.god else 0 end end
  fn curse_god(c : City) : Int do if curse_days(c) > 0 do c.religion.curse.god else 0 end end
  fn favor_site(c : City) : Int do c.religion.favor.site end
  fn curse_site(c : City) : Int do c.religion.curse.site end
  fn curse_epicenter(c : City) : Int do c.religion.epicenter end
  fn curse_stamp(c : City) : Int do c.religion.curse_stamp end
  fn petition_wait(c : City) : Int do clamp(c.religion.petition_day - absolute_day(c), 0, 90) end
  fn offering_budget() : Int do 4200 end
  fn offering_spend(c : City) : Int do
    if c.religion.offering_year == c.month / 12 do c.religion.offering_spend else 0 end
  end
  fn offering_fee(tier : Int) : Int do
    match tier do
      1 -> 240
      2 -> 620
      3 -> 1450
      _ -> 0
    end
  end
  fn favor_chance(tier : Int) : Int do
    match tier do
      1 -> 30
      2 -> 50
      3 -> 70
      _ -> 0
    end
  end
  fn curse_chance(tier : Int) : Int do
    match tier do
      1 -> 10
      2 -> 8
      3 -> 5
      _ -> 0
    end
  end
  fn shrine_curse_penalty(st : Stats) : Int do clamp(3 * st.understaffed_shrines, 0, 15) end
  fn offering_curse_chance(st : Stats, tier : Int) : Int do curse_chance(tier) + shrine_curse_penalty(st) end
  fn wrath_chance() : Int do 25 end
  fn temple_tier(c : City, lot : Int) : Int do
    let kind = get(c.plants, lot)
    if kind >= 37 && kind <= 40 do kind - 36 else 0 end
  end
  fn worship_staff(tier : Int) : Int do
    match tier do
      1 | 2 -> 1
      3 -> 2
      4 -> 4
      _ -> 0
    end
  end
  fn next_festival(c : City) : Int do
    let day = absolute_day(c)
    let next = day / 90 * 90 + 15
    if day <= next do next else next + 90 end
  end
  fn last_festival(c : City) : Int do c.religion.festival_stamp end
  fn last_festival_hosts(c : City) : Int do c.religion.festival_hosts end
  fn last_festival_attendees(c : City) : Int do c.religion.festival_attendees end
  fn last_festival_site(c : City) : Int do c.religion.festival_site end
  fn festival_feedback(c : City, lot : Int) : Int do
    let value = get(c.religion.festival_feedback, lot)
    if value == 0 do 0 else value / 101 - 100 end
  end
  fn festival_happiness_duration() : Int do 7 end
  fn festival_result_happiness(c : City, lot : Int) : Int do
    let quality = get(c.religion.festival_feedback, lot) % 101
    quality * 9 * festival_household_share(c, lot) / 10000
  end
  fn festival_happiness(c : City, lot : Int) : Int do
    let day = last_festival(c) - 1
    if day >= 0 && absolute_day(c) >= day && absolute_day(c) < day + festival_happiness_duration() do
      festival_result_happiness(c, lot)
    else 0 end
  end
  fn temple_open(c : City, st : Stats, lot : Int) : Bool do
    temple_operating(c, st.routes, st.staffed_jobs, lot)
  end
  pfn temple_operating(c : City, routes : NativeIntArr, hires : NativeIntArr, lot : Int) : Bool do
    temple_ready(c, routes, lot) && get(hires, lot) >= worship_staff(temple_tier(c, lot))
  end
  pfn temple_ready(c : City, routes : NativeIntArr, lot : Int) : Bool do
    temple_tier(c, lot) > 0 && patron(c) > 0 && c.religion.dedication_target == 0 && !building_offline(c, lot) &&
      !ground_closed(c, lot) && building_access(c, routes, lot) >= 0
  end
  fn worship_staff_shortage(c : City, st : Stats, lot : Int) : Bool do
    temple_ready(c, st.routes, lot) && get(st.staffed_jobs, lot) < worship_staff(temple_tier(c, lot))
  end
  pfn count_understaffed_shrines(c : City, routes : NativeIntArr, hires : NativeIntArr, lot : Int, total : Int) : Int do
    if lot == count() || patron(c) == 0 || c.religion.dedication_target > 0 do total else
      let vacant = temple_tier(c, lot) == 1 && get(hires, lot) == 0 && temple_ready(c, routes, lot)
      count_understaffed_shrines(c, routes, hires, lot + 1, total + (if vacant do 1 else 0 end))
    end
  end
  pfn rededication_sites(c : City, lot : Int, fee : Int) : Int do
    if lot >= count() do fee else
      let tier = temple_tier(c, lot)
      rededication_sites(c, lot + 1, fee + tier * tier * 90)
    end
  end
  fn rededication_fee(c : City) : Int do rededication_sites(c, 0, 900) end
  fn offering_block(c : City, st : Stats, lot : Int, tier : Int) : String do
    if tier < 1 || tier > 3 do "Choose an offering."
    else if c.religion.dedication_target > 0 do "Reconsecration is in progress."
    else if temple_tier(c, lot) < 3 || !temple_open(c, st, lot) do "Use an operating Large or Grand Temple."
    else if get(c.council, 804) > 0 do "The council has placed a recovery hold on offerings."
    else if offering_policy(c) == 2 || (offering_policy(c) == 1 && tier > 1) do "The council offering policy bars this offering."
    else if offering_spend(c) + offering_fee(tier) > offering_budget() do "The annual offering budget is exhausted."
    else if petition_wait(c) > 0 do "The city must wait before petitioning again."
    else if favor_days(c) > 0 || curse_days(c) > 0 do "A divine effect is already active."
    else if c.cash < offering_fee(tier) do "The treasury cannot cover this offering."
    else "" end end end end end end end end end
  end
  pfn divine_roll(c : City, god : Int, salt : Int) : Int do
    Strata.Seed.cell(c.climate_seed, salt, absolute_day(c), c.religion.rolls, god) % 100
  end
  pfn begin_favor(c : City, god : Int, site : Int) : City do
    let favor = { god: god, until_day: absolute_day(c) + 30, site: site }
    let cisterns = if god == 1 do collect_rain(c, weather_sites(c, 0, Nil), rain_tank_capacity()) else c end
    { cisterns with religion: { c.religion with favor: favor }, message: god_name(god) ++ " granted favor for 30 days." }
  end
  pfn quake_epicenter(c : City, offset : Int, tried : Int) : Int do
    if tried == count() do c.harbour else
      let lot = (offset + tried) % count()
      if get(c.buildings, lot) > 0 && !building_offline(c, lot) do lot else quake_epicenter(c, offset, tried + 1) end
    end
  end
  pfn begin_curse(c : City, god : Int, site : Int) : City do
    let curse = { god: god, until_day: absolute_day(c) + curse_duration(god), site: site }
    let center = if god == 3 do quake_epicenter(c, (absolute_day(c) * 31 + c.religion.rolls * 173) % count(), 0) else -1 end
    { c with religion: { c.religion with curse: curse, curse_stamp: c.religion.rolls, epicenter: center },
      message: god_name(god) ++ " sent " ++ curse_name(god) ++ "." }
  end
  fn make_offering(c : City, st : Stats, lot : Int, tier : Int) : City do
    let reason = offering_block(c, st, lot, tier)
    if reason != "" do { c with message: reason } else
      let fee = offering_fee(tier)
      let roll = divine_roll(c, patron(c), lot)
      let paid = { c with cash: c.cash - fee,
        religion: { c.religion with offering_year: c.month / 12, offering_spend: offering_spend(c) + fee,
          rolls: c.religion.rolls + 1, petition_day: absolute_day(c) + 45 } }
      if roll < favor_chance(tier) do begin_favor(paid, patron(c), lot)
      else if roll >= 100 - offering_curse_chance(st, tier) do begin_curse(paid, patron(c), lot)
      else { paid with message: god_name(patron(c)) ++ " gave no answer." } end end
    end
  end
  fn rededicate(c : City, target : Int) : City do
    let fee = rededication_fee(c)
    if patron(c) == 0 || target < 1 || target > 5 || target == patron(c) || c.religion.dedication_target > 0 || c.cash < fee do c else
      let paid = { c with cash: c.cash - fee, religion: { c.religion with dedication_target: target,
        dedication_end: absolute_day(c) + rededication_duration(), rolls: c.religion.rolls + 1 },
        message: "Reconsecration to " ++ god_name(target) ++ " has begun." }
      if divine_roll(c, patron(c), 97) >= wrath_chance() do paid
      else if curse_days(c) == 0 do begin_curse(paid, patron(c), -1)
      else { paid with religion: { paid.religion with wrath_god: patron(c) }, message: "The outgoing patron will send a curse after the current curse ends." }
      end end
    end
  end
  fn climate_rain(c : City) : Int do
    if c.climate_seed == 0 do 0 else c.climate_seed / 9 % 21 - 10 end
  end
  fn climate_heat(c : City) : Int do
    if c.climate_seed == 0 do 0 else c.climate_seed % 9 - 4 end
  end
  pfn weather_pattern(seed : Int, wetness : Int, month : Int, day : Int) : Int do
    let spell = (month * days_per_month() + day) / 3
    let roll = Strata.Seed.cell(if seed == 0 do 705 else seed end, 13, spell, 0, 0) % 100
    if spell == 0 do 1
    else if roll < clamp(3 + wetness / 3, 1, 6) do 4
    else if roll < 10 + wetness / 2 do 3
    else if roll < 30 + wetness do 2
    else if roll < 66 + wetness do 1 else 0 end end end end end
  end
  fn weather(month : Int, day : Int) : Int do weather_pattern(0, 0, month, day) end
  pfn curse_on(c : City, month : Int, day : Int) : Int do
    let target = month * days_per_month() + day
    let effect = c.religion.curse
    if target >= effect.until_day - curse_duration(effect.god) && target < effect.until_day do effect.god else 0 end
  end
  fn weather_on(c : City, month : Int, day : Int) : Int do
    let curse = curse_on(c, month, day)
    if curse == 1 do 4 else if curse == 2 do 0 else weather_pattern(c.climate_seed, climate_rain(c), month, day) end end
  end
  fn current_weather(c : City) : Int do weather_on(c, c.month, c.calendar_day) end
  -- Local rain (docs/superpowers/specs/2026-11-23-local-rain-design.md).
  -- A uniform city, or one under Idra's Unending Rain, rains today's regional
  -- weather on every parcel, as before local rain; others rain in Ur.Rain's
  -- storm cells.
  fn uniform_rain(c : City) : Bool do c.rain_uniform || curse_god(c) == 1 end
  fn fclamp(v : Float, low : Float, high : Float) : Float do if v < low do low else if v > high do high else v end end end
  fn day_cells(c : City) : List(Ur.Rain.Cell) do
    let wind = regional_wind(c)
    Ur.Rain.cells(if c.climate_seed == 0 do 705 else c.climate_seed end, c.month, c.calendar_day, current_weather(c), wind.speed, wind.heading)
  end
  pfn lot_centre(lot : Int) : (Float, Float) do (int_to_float(lot % width() * 8 + 4), int_to_float(lot / width() * 8 + 4)) end
  pfn cell_level(c : City, cells : List(Ur.Rain.Cell), base : Int, lot : Int, hour : Float) : Int do
    if get(c.heights, lot) <= 0 do 0 else
      let (x, z) = lot_centre(lot)
      Ur.Rain.level_at(cells, base, x, z, hour)
    end
  end
  -- the rain level on [lot] at game [hour] (0..24, fractions allowed)
  fn rain_level(c : City, lot : Int, hour : Float) : Int do
    if uniform_rain(c) do (if get(c.heights, lot) > 0 do current_weather(c) else 0 end)
    else cell_level(c, day_cells(c), Ur.Rain.baseline(current_weather(c)), lot, hour) end
  end
  pfn fill_rain(c : City, cells : List(Ur.Rain.Cell), base : Int, hour : Float, a : NativeIntArr, lot : Int) : NativeIntArr do
    if lot >= count() do a else
      let level = if uniform_rain(c) do (if get(c.heights, lot) > 0 do base else 0 end) else cell_level(c, cells, base, lot, hour) end
      fill_rain(c, cells, base, hour, NativeArray.set_int(a, lot, level), lot + 1)
    end
  end
  doc "Fill each parcel's rain at game hour [hour] (0..23), as rain_here reads it."
  fn set_rain_hour(c : City, hour : Int) : City do
    let cells = if uniform_rain(c) do Nil else day_cells(c) end
    let base = if uniform_rain(c) do current_weather(c) else Ur.Rain.baseline(current_weather(c)) end
    { c with hour: hour, rain_now: fill_rain(c, cells, base, int_to_float(hour) +. 0.5, NativeArray.make_int(count(), 0), 0) }
  end
  doc "The rain falling on [lot] this hour: 0 none, 2 rain, 3 heavy, 4 severe (a uniform city's cloudy day reads 1)."
  -- A uniform city reads today's regional weather directly, so it behaves
  -- exactly as before local rain whatever its stored hour says.
  fn rain_here(c : City, lot : Int) : Int do
    if !valid(lot) do 0 else if uniform_rain(c) do (if get(c.heights, lot) > 0 do current_weather(c) else 0 end) else get(c.rain_now, lot) end end
  end
  pfn any_severe(c : City, lot : Int) : Bool do if lot >= count() do false else if get(c.rain_now, lot) == 4 do true else any_severe(c, lot + 1) end end end
  doc "Whether severe rain is falling on any parcel this hour."
  fn severe_now(c : City) : Bool do if uniform_rain(c) do severe_rain(c) else any_severe(c, 0) end end
  fn watch_of(hour : Int) : Int do clamp(hour / 8, 0, 2) end
  doc "End every watch the clock at [hour] has passed that [c] has not ended yet: never one twice, and a city whose watch fell behind its clock catches up."
  fn catch_up_watches(c : City, hour : Int) : City do
    if c.watch < watch_of(hour) do catch_up_watches(end_watch(c, c.watch), hour) else c end
  end
  doc "Whether standing water or flood damage differs between [a] and [b] anywhere."
  fn flood_differs(a : City, b : City) : Bool do flood_differs_at(a, b, 0) end
  pfn flood_differs_at(a : City, b : City, lot : Int) : Bool do
    if lot >= count() do false
    else if get(a.surface_water, lot) != get(b.surface_water, lot) || get(a.flood_damage, lot) != get(b.flood_damage, lot) do true
    else flood_differs_at(a, b, lot + 1) end end
  end
  doc "The watches a frame's clock passing from [before] to [after] hours ends: 0 at 08:00, 1 at 16:00. Midnight's watch is left to the day's roll."
  fn watches_crossed(before : Float, after : Float) : List(Int) do
    List.filter([0, 1], fn w -> before < int_to_float(8 * (w + 1)) && after >= int_to_float(8 * (w + 1)))
  end
  -- a day starts in the night watch, with the new day's rain
  pfn fresh_day(c : City) : City do set_rain_hour({ c with watch: 0 }, 0) end
  doc "A loaded city's rain, rebuilt from its date and stamped clock."
  fn restore_rain(c : City) : City do set_rain_hour(c, street_hour(int_to_float(c.clock_ms) /. 1000.0)) end
  fn weather_name(kind : Int) : String do
    match kind do
      4 -> "Severe rain"
      3 -> "Heavy rain"
      2 -> "Rain"
      1 -> "Cloudy"
      _ -> "Clear"
    end
  end
  fn temperature_on(c : City, month : Int, day : Int) : Int do
    let season = 21 + 2 * (6 - int_abs(month % 12 - 6))
    let variation = Strata.Seed.cell(509, month, day / 2, 0, 0) % 7 - 3
    let cooling = clamp(weather_on(c, month, day) - 1, 0, 3) * 2
    season + variation - cooling + climate_heat(c) + (if curse_on(c, month, day) == 2 do 13 else 0 end)
  end
  fn temperature(c : City) : Int do temperature_on(c, c.month, c.calendar_day) end
  -- Temperatures at a parcel are in tenths of a degree Celsius.
  pfn tree_cover(c : City, lot : Int, spot : Int, total : Int) : Int do
    if spot == 4 do total else
      let item = sidewalk_item(c, lot, spot)
      tree_cover(c, lot, spot + 1, total + (if item >= 1 && item <= 3 do 1 else 0 end))
    end
  end

  pfn green_cooling(c : City, lot : Int, offset : Int, trees : Int, parks : Int) : (Int, Int) do
    if offset == 25 do (clamp(trees, 0, 21), clamp(parks, 0, 24)) else
      let dx = offset % 5 - 2
      let dz = offset / 5 - 2
      let x = lot % width() + dx
      let z = lot / width() + dz
      let distance = int_abs(dx) + int_abs(dz)
      if distance > 2 || x < 0 || x >= width() || z < 0 || z >= depth() do
        green_cooling(c, lot, offset + 1, trees, parks)
      else
        let near = index(x, z)
        let kind = get(c.streetscape, near)
        let planted = if kind >= 1 && kind <= 3 do 2 else 0 end
        let placed = if get(c.sidewalk_items, near) > 0 do tree_cover(c, near, 0, 0) else 0 end
        let park = if get(c.parks, near) > 0 do (4 + get(c.park_tiers, near)) * (3 - distance) else 0 end
        green_cooling(c, lot, offset + 1, trees + (planted + placed) * (3 - distance), parks + park)
      end
    end
  end

  pfn parcel_cooling(c : City, lot : Int, regional : Int) : Int do
    if !valid(lot) || regional < 25 do 0 else
      let (trees, parks) = green_cooling(c, lot, 0, 0, 0)
      clamp(trees + parks, 0, 30)
    end
  end
  fn local_temperature(c : City, lot : Int) : Int do
    let regional = temperature(c)
    regional * 10 - parcel_cooling(c, lot, regional)
  end
  fn walk_pace_at(c : City, lot : Int, regional : Int) : Float do
    -- Shade reduces perceived heat as well as the local air temperature.
    let heat = regional * 10 - 2 * parcel_cooling(c, lot, regional)
    1.0 -. int_to_float(clamp(heat - 280, 0, 90)) *. 0.004
  end
  fn walk_pace(c : City, lot : Int) : Float do walk_pace_at(c, lot, temperature(c)) end
  fn rain_road_pace(c : City, lot : Int) : Float do
    match rain_here(c, lot) do
      4 -> 0.43
      3 -> 0.62
      2 -> 0.81
      _ -> 1.0
    end
  end
  fn severe_rain(c : City) : Bool do current_weather(c) == 4 end

  -- Look for open water within six parcels. Higher ground and seawalls
  -- interrupt an approach. An unprotected approach can still admit water.
  pfn offshore_barrier(c : City, x : Int, z : Int, dx : Int, dz : Int, remaining : Int) : Bool do
    if remaining <= 0 || x < 0 || x >= width() || z < 0 || z >= depth() do false else
      let lot = index(x, z)
      get(c.seawalls, lot) > 0 || (get(c.heights, lot) == 0 &&
        offshore_barrier(c, x + dx, z + dz, dx, dz, remaining - 1))
    end
  end
  pfn coast_approach(c : City, x : Int, z : Int, dx : Int, dz : Int, distance : Int, crest : Int) : Int do
    if distance > 6 || x < 0 || x >= width() || z < 0 || z >= depth() do 0 else
      let lot = index(x, z)
      let h = get(c.heights, lot)
      let loss = (distance - 1) * (if dx != 0 && dz != 0 do 3 else 2 end)
      if crest + loss >= 16 || get(c.seawalls, lot) > 0 do 0
      else if h == 0 do (if offshore_barrier(c, x + dx, z + dz, dx, dz, 3) do 0 else 16 - loss end)
      else if h >= 16 do 0
      else coast_approach(c, x + dx, z + dz, dx, dz, distance + 1, if h > crest do h else crest end) end end end
    end
  end
  pfn shore_level(c : City, x : Int, z : Int, arm : Int, best : Int) : Int do
    if arm >= 9 || best == 16 do best else if arm == 4 do shore_level(c, x, z, arm + 1, best) else
      let dx = arm % 3 - 1
      let dz = arm / 3 - 1
      let level = coast_approach(c, x + dx, z + dz, dx, dz, 1, 0)
      shore_level(c, x, z, arm + 1, if level > best do level else best end)
    end end
  end
  pfn basin_depth(c : City, i : Int, height : Int, arm : Int, rim : Int, high : Int) : Int do
    if arm >= 4 do if high >= 3 do clamp(rim - height, 0, 12) else 0 end else
      let h = get(c.heights, neighbour(i, arm))
      let rim = if h < rim do h else rim end
      basin_depth(c, i, height, arm + 1, rim, high + (if h > height do 1 else 0 end))
    end
  end
  fn soil_absorption(c : City, lot : Int) : Int do
    if get(c.heights, lot) <= 0 || get(c.roads, lot) > 0 || get(c.buildings, lot) > 0 ||
      get(c.construction, lot) > 0 || get(c.plants, lot) > 0 || surface_parking(c, lot) || get(c.transit, lot) > 0 do 0
    else if get(c.parks, lot) > 0 do 3 + get(c.park_tiers, lot) + (100 - c.soil_moisture) / 30
    else 2 + (100 - c.soil_moisture) / 40 end end
  end
  pfn nearby_absorption(c : City, lot : Int, arm : Int, total : Int) : Int do
    if arm >= 4 do total / 4 else
      nearby_absorption(c, lot, arm + 1, total + soil_absorption(c, neighbour(lot, arm)))
    end
  end
  fn floodplain_depth(c : City, lot : Int) : Int do
    let h = get(c.heights, lot)
    if h <= 0 do 0 else
      let coastal = if h < 16 do clamp(shore_level(c, lot % width(), lot / width(), 0, 0) - h, 0, 16) else 0 end
      let basin = basin_depth(c, lot, h, 0, h + 6, 0)
      let local = if basin > 0 do clamp(basin - soil_absorption(c, lot) - nearby_absorption(c, lot, 0, 0), 0, 12) else 0 end
      let exposed = if coastal > local do coastal else local end
      clamp(exposed - (if get(c.storm_drains, lot) > 0 && get(c.roads, lot) > 0 do 10 else 0 end), 0, 16)
    end
  end
  pfn tide_depth(c : City, lot : Int) : Int do
    let height = get(c.heights, lot)
    if curse_god(c) != 4 || height <= 0 || height >= 16 do 0 else
      let coast = shore_level(c, lot % width(), lot / width(), 0, 0)
      if coast > 0 do clamp(coast + 2 - height, 0, 16) else 0 end
    end
  end
  fn surface_flood(c : City, lot : Int) : Int do
    let stored = get(c.surface_water, lot)
    let storm = if rain_here(c, lot) == 4 do floodplain_depth(c, lot) else 0 end
    let tide = tide_depth(c, lot)
    clamp(stored, clamp(storm, tide, 16), 16)
  end
  pfn quake_near(c : City, lot : Int, radius : Int) : Bool do
    let center = curse_epicenter(c)
    curse_god(c) == 3 && valid(center) && valid(lot) && span_distance(lot, center) <= radius
  end
  fn curse_impact(c : City, lot : Int) : Bool do
    if !valid(lot) || homes_at(c, lot) == 0 do false else
      match c.religion.curse.god do
        1 | 4 -> get(c.surface_water, lot) >= 2 || flood_repair_days(c, lot) > 0 ||
          (curse_god(c) > 0 && surface_flood(c, lot) >= 2)
        2 -> curse_god(c) == 2 && local_temperature(c, lot) > 360
        3 -> quake_near(c, lot, 3)
        5 -> curse_god(c) == 5 && !clinic_nearby(c, lot, 0)
        _ -> false
      end
    end
  end
  fn flood_repair_days(c : City, lot : Int) : Int do get(c.flood_damage, lot) end
  fn ground_closed(c : City, lot : Int) : Bool do surface_flood(c, lot) >= 2 || (get(c.roads, lot) > 0 && quake_near(c, lot, 2)) end
  fn building_inundated(c : City, lot : Int) : Bool do
    (get(c.buildings, lot) > 0 || get(c.plants, lot) > 0) && surface_flood(c, lot) >= 4
  end
  fn storm_road_closed(c : City, lot : Int) : Bool do
    motor_street(c, lot) && ground_closed(c, lot)
  end
  doc "Whether the sun is up at game hour [hour]: solar arrays produce between 06:00 and 20:00."
  fn daylight(hour : Int) : Bool do hour >= 6 && hour < 20 end
  doc "Whether the sun is up over [c] now (its hour is kept current by the clock)."
  fn sun_up(c : City) : Bool do daylight(c.hour) end
  pfn solar_output(c : City) : Int do
    if !sun_up(c) do 0 else solar_by_day(c) end
  end
  pfn solar_by_day(c : City) : Int do
    let clear = if c.month % 12 < 5 do 48 else 80 end
    let percentage = match current_weather(c) do
      4 -> 18
      3 -> 35
      2 -> 60
      _ -> 100
    end
    clear * percentage / 100
  end
  pfn cooling_load(c : City, lot : Int, regional : Int) : Int do
    if regional < 30 do 0 else
      let heat = regional * 10 - parcel_cooling(c, lot, regional)
      if heat >= 340 do 2 else if heat >= 300 do 1 else 0 end end
    end
  end
  type Wind = { speed : Int, heading : Float }
  fn regional_wind(c : City) : Wind do
    let day = int_to_float(c.month * days_per_month() + c.calendar_day)
    let swing = Math.sin(day *. 0.16)
    { speed: 26 + float_to_int(8.0 *. swing), heading: 0.42 +. day *. 0.019 +. 0.95 *. Math.sin(day *. 0.065) }
  end
  fn wind_at(c : City, lot : Int) : Wind do
    let wind = regional_wind(c)
    let height = get(c.heights, lot)
    let x = int_to_float(lot % width())
    let z = int_to_float(lot / width())
    let terrain = Math.sin(x *. 0.36 +. z *. 0.21)
    if height == 0 do { wind with speed: 43 + (wind.speed - 26) / 3 }
    else { speed: clamp(wind.speed - 7 + height / 7 + float_to_int(terrain *. 5.0), 8, 38),
      heading: wind.heading +. terrain *. 0.27 }
    end
  end
  fn wind_direction(heading : Float) : String do
    let sector = int_mod_euclid(float_to_int(Math.floor(heading /. 0.785398163 +. 0.5)), 8)
    match sector do
      0 -> "E"
      1 -> "SE"
      2 -> "S"
      3 -> "SW"
      4 -> "W"
      5 -> "NW"
      6 -> "N"
      _ -> "NE"
    end
  end
  fn wind_caption(c : City, lot : Int) : String do
    let wind = if valid(lot) do wind_at(c, lot) else regional_wind(c) end
    int_to_string(wind.speed) ++ " km/h toward " ++ wind_direction(wind.heading)
  end
  fn wind_turbine(kind : Int) : Bool do kind == 12 || kind == 33 end
  fn street_hour(time : Float) : Int do
    let phase = time -. Math.floor(time /. day_seconds()) *. day_seconds()
    clamp(float_to_int(phase *. 24.0 /. day_seconds()), 0, 23)
  end
  fn bar_open(c : City, i : Int, hour : Int) : Bool do
    nightlife(c, i) && (if quiet_at(c, i) == 2 do hour >= 17 && hour < 22 else hour >= 17 || hour < 2 end)
  end
  fn overnight_business(c : City, i : Int) : Bool do
    retail(c, i) == 1 && (i % width() + i / width()) % 5 == 0
  end
  fn business_open(c : City, i : Int, hour : Int) : Bool do
    if nightlife(c, i) do bar_open(c, i, hour)
    else match retail(c, i) do
      1 -> overnight_business(c, i) || (hour >= 7 && hour < 21)
      2 -> hour >= 11 && hour < 23
      _ -> false
    end end
  end
  fn traffic_pace(weekday : Int, hour : Int) : Float do
    if weekday < 5 && ((hour >= 7 && hour < 10) || (hour >= 16 && hour < 19)) do 0.80
    else if hour < 6 || hour >= 23 do 1.12 else 1.0 end end
  end
  fn day_name(day : Int) : String do
    match day do
      1 -> "Tue"
      2 -> "Wed"
      3 -> "Thu"
      4 -> "Fri"
      5 -> "Sat"
      6 -> "Sun"
      _ -> "Mon"
    end
  end
  fn street_schedule_name(schedule : Int) : String do
    match schedule do
      1 -> "Weekends"
      2 -> "Weekdays"
      3 -> "Saturday"
      4 -> "Sunday"
      _ -> "Every day open"
    end
  end
  fn car_free_now(c : City, i : Int) : Bool do
    match get(c.car_free_days, i) do
      1 -> c.street_day >= 5
      2 -> c.street_day < 5
      3 -> c.street_day == 5
      4 -> c.street_day == 6
      _ -> false
    end
  end
  fn motor_street(c : City, i : Int) : Bool do
    let kind = get(c.roads, i)
    kind == 1 || kind == 2
  end
  fn motor_road(c : City, i : Int) : Bool do
    motor_street(c, i) && !car_free_now(c, i) && !storm_road_closed(c, i)
  end
  fn schedule_eligible(c : City, i : Int) : Bool do
    valid(i) && motor_street(c, i) && i != c.harbour && !valid(grade_peer(c, i)) && get(c.ferries, i) == 0
  end
  fn fleet_frontage(c : City, i : Int, d : Int) : Int do
    if d == 4 do -1 else
      let j = neighbour(i, d)
      if motor_street(c, j) && int_abs(get(c.heights, i) - get(c.heights, j)) <= 12 do j
      else fleet_frontage(c, i, d + 1) end
    end
  end
  fn parking_spaces(kind : Int) : Int do
    match kind do
      1 -> 8
      2 -> 24
      3 -> 40
      _ -> 0
    end
  end
  fn parking_name(kind : Int) : String do
    match kind do
      1 -> "Surface parking lot"
      2 -> "Parking garage"
      3 -> "Underground garage"
      _ -> "Parking"
    end
  end
  fn parking_fee(kind : Int) : Int do if kind <= 0 do 0 else kind + 1 end end
  pfn parking_upkeep(kind : Int) : Int do
    match kind do
      1 -> 6
      2 -> 20
      3 -> 34
      _ -> 0
    end
  end
  fn surface_parking(c : City, i : Int) : Bool do
    let kind = get(c.public_parking, i)
    kind == 1 || kind == 2
  end
  fn timed_street_tool(tool : Int) : Bool do tool >= 71 && tool <= 75 end
  fn road_tool(tool : Int) : Bool do tool == 1 || tool == 48 || tool == 49 end
  fn road_name(kind : Int) : String do
    match kind do
      2 -> "Avenue"
      3 -> "Pedestrian street"
      _ -> "Local street"
    end
  end
  fn road_half_width(kind : Int) : Int do
    if kind == 2 do 14 else if kind == 3 do 12 else 10 end end
  end
  fn road_capacity(c : City, i : Int) : Int do
    match get(c.roads, i) do
      2 -> 24
      1 -> 12
      _ -> 0
    end
  end
  fn road_upkeep(kind : Int) : Int do
    match kind do
      1 -> 3
      2 -> 6
      3 -> 2
      _ -> 0
    end
  end
  fn street_link(c : City, i : Int, d : Int) : Bool do
    let j = neighbour(i, d)
    get(c.roads, j) > 0 && int_abs(get(c.heights, i) - get(c.heights, j)) <= 12
  end
  fn junction_arm(c : City, i : Int, d : Int) : Bool do
    let peer = neighbour(i, d)
    motor_street(c, i) && motor_street(c, peer) && get(c.heights, i) > 0 &&
      get(c.heights, peer) > 0 && street_link(c, i, d) && !grade_link(c, i, peer)
  end
  pfn junction_scale(c : City, i : Int, d : Int, arms : Int, avenue : Bool, density : Int) : (Int, Bool, Int) do
    if d == 4 do (arms, avenue, density) else
      let peer = neighbour(i, d)
      let arm = junction_arm(c, i, d)
      let housing = get(c.buildings, peer)
      let corner = neighbour(i, if d < 2 do 0 else 1 end)
      let diagonal = neighbour(corner, if d % 2 == 0 do 2 else 3 end)
      junction_scale(c, i, d + 1, arms + (if arm do 1 else 0 end),
        avenue || (arm && get(c.roads, peer) == 2), density + housing + get(c.buildings, diagonal))
    end
  end
  fn surface_junction(c : City, i : Int) : Bool do
    if !motor_street(c, i) do false else
      let (arms, _, _) = junction_scale(c, i, 0, 0, false, 0)
      arms >= 3
    end
  end
  -- 0: uncontrolled, 1: all-way stop, 2: traffic signal.
  fn junction_control(c : City, traffic : NativeIntArr, i : Int) : Int do
    if !motor_street(c, i) do 0 else
      let (arms, avenue, density) = junction_scale(c, i, 0, 0, get(c.roads, i) == 2, 0)
      if arms < 3 do 0
      else if avenue || road_load(traffic, i) >= 10 || density >= 12 do 2
      else 1 end end
    end
  end
  fn junction_controls(c : City, traffic : NativeIntArr, i : Int, out : NativeIntArr) : NativeIntArr do
    if i >= count() do out else
      let control = junction_control(c, traffic, i)
      junction_controls(c, traffic, i + 1, if control == 0 do out else NativeArray.set_int(out, i, control) end)
    end
  end
  fn stop_line() : Float do 0.46 end
  fn signal_tick(time : Float) : Int do float_to_int(time *. 2.0) end
  pfn signal_phase(i : Int, tick : Int) : Int do (tick + (i % 3) * 2) % 16 end
  fn signal_green(i : Int, direction : Int, tick : Int) : Bool do
    let phase = signal_phase(i, tick)
    if direction < 2 do phase < 7 else phase >= 8 && phase < 15 end
  end
  fn crosswalk_open(i : Int, arm : Int, tick : Int) : Bool do
    let phase = signal_phase(i, tick)
    -- Close entry before the next green so a walker can finish crossing.
    if arm < 2 do phase >= 7 && phase < 14 else phase == 15 || phase < 6 end
  end
  fn road_turn(c : City, i : Int) : (Int, Int) do
    if !valid(i) || get(c.heights, i) == 0 || get(c.roads, i) == 0 || get(c.transit, i) == 3 || c.harbour == i || get(c.grades, i) > 0 do (-1, -1) else
      let west = street_link(c, i, 0)
      let east = street_link(c, i, 1)
      let north = street_link(c, i, 2)
      let south = street_link(c, i, 3)
      if west == east || north == south do (-1, -1)
      else (if west do 0 else 1 end, if north do 2 else 3 end) end
    end
  end
  fn grade_tool(tool : Int) : Bool do tool >= 50 && tool <= 52 end
  fn grade_peer(c : City, i : Int) : Int do get(c.grades, i) % (count() + 1) - 1 end
  fn grade_kind(c : City, i : Int) : Int do get(c.grades, i) / (count() + 1) end
  fn grade_link(c : City, a : Int, b : Int) : Bool do valid(b) && grade_peer(c, a) == b end
  fn grade_source(c : City, i : Int) : Int do get(c.grade_cover, i) - 1 end
  fn span_distance(a : Int, b : Int) : Int do
    int_abs(a % width() - b % width()) + int_abs(a / width() - b / width())
  end
  fn grade_step(a : Int, b : Int) : Int do
    if a / width() == b / width() do (if a < b do 1 else -1 end)
    else if a < b do width() else 0 - width() end end
  end
  pfn write_grade_cover(a : NativeIntArr, i : Int, target : Int, step : Int, value : Int) : NativeIntArr do
    let a = NativeArray.set_int(a, i, value)
    if i == target do a else write_grade_cover(a, i + step, target, step, value) end
  end
  pfn grade_room(c : City, i : Int, target : Int, step : Int, kind : Int, ceiling : Int) : Bool do
    let free = !valid(grade_source(c, i)) && !surface_parking(c, i) && (kind == 1 || get(c.public_parking, i) != 3) && (kind != 2 || get(c.heights, i) >= 8) &&
      (kind != 1 || (!building_offline(c, i) && get(c.buildings, i) == 0 && get(c.plants, i) == 0 && get(c.construction, i) == 0 && get(c.zones, i) == 0 && get(c.parks, i) == 0 && get(c.streetscape, i) == 0 && get(c.heights, i) <= ceiling))
    free && (i == target || grade_room(c, i + step, target, step, kind, ceiling))
  end
  fn build_grade(c : City, a : Int, b : Int, tool : Int) : City do
    let kind = tool - 49
    let length = span_distance(a, b)
    let price = cost(c, a, tool) * (length + 1)
    if !grade_tool(tool) || !valid(a) || !valid(b) || length < 2 || (a % width() != b % width() && a / width() != b / width()) do
      { c with message: "Drag a straight route of at least three parcels." }
    else if kind < 3 && (length > 10 || int_abs(get(c.heights, a) - get(c.heights, b)) > 12) do
      { c with message: "Use nearby portals at similar elevations, or build a road tunnel." }
    else if !motor_street(c, a) || !motor_street(c, b) || get(c.heights, a) == 0 || get(c.heights, b) == 0 ||
      a == c.harbour || b == c.harbour || get(c.ferries, a) > 0 || get(c.ferries, b) > 0 do
      { c with message: "Both portals need a local street or avenue on land, away from terminals." }
    else if !grade_room(c, a, b, grade_step(a, b), kind, (get(c.heights, a) + get(c.heights, b) - int_abs(get(c.heights, a) - get(c.heights, b))) / 2 + 12) do
      { c with message: "This route is obstructed. Try a clear crossing or a deeper tunnel." }
    else if c.cash < price do { c with message: "Not enough funds for that crossing." }
    else
      let tag = kind * (count() + 1)
      let grades = NativeArray.set_int(NativeArray.set_int(c.grades, a, tag + b + 1), b, tag + a + 1)
      { c with grades: grades, grade_cover: write_grade_cover(c.grade_cover, a, b, grade_step(a, b), a + 1),
        cash: c.cash - price, construction_spend: c.construction_spend + price, message: tool_name(tool) ++ " opened." }
    end end end end end
  end
  pfn remove_grade(c : City, i : Int) : City do
    let a = grade_source(c, i)
    let b = grade_peer(c, a)
    if !grade_link(c, a, b) || !grade_link(c, b, a) || a == b || (a % width() != b % width() && a / width() != b / width()) do { c with message: "Choose a grade-separated road to remove." } else
      { c with grades: NativeArray.set_int(NativeArray.set_int(c.grades, a, 0), b, 0),
        grade_cover: write_grade_cover(c.grade_cover, a, b, grade_step(a, b), 0), message: "Crossing removed." }
    end
  end
  pfn overpass_lift(span : Float, run : Float, at : Float) : Float do
    let distance = if at < span *. 0.5 do at else span -. at end
    let progress = distance /. run
    if progress >= 1.0 do 24.0 else
      24.0 *. progress *. progress *. (3.0 -. 2.0 *. progress)
    end
  end
  fn grade_surface(c : City, a : Int, b : Int, t : Float) : Float do
    let start = int_to_float(get(c.heights, a))
    let finish = int_to_float(get(c.heights, b))
    let parcels = span_distance(a, b)
    let span = int_to_float(parcels)
    let kind = grade_kind(c, a)
    let lift = if kind == 1 && parcels >= 3 do
      let run = if parcels >= 5 do 2.5 else 1.5 end
      let position = t *. span
      -- Sample at the same parcel boundaries used by the deck renderer.
      let boundary = Math.floor(position +. 0.5) -. 0.5
      let lo = if boundary < 0.0 do 0.0 else boundary end
      let hi = if boundary +. 1.0 > span do span else boundary +. 1.0 end
      let low = overpass_lift(span, run, lo)
      let high = overpass_lift(span, run, hi)
      low +. (high -. low) *. (position -. lo) /. (hi -. lo)
    else
      let run = if kind == 1 do 0.5 else 1.0 end
      let progress = span *. (if t < 0.5 do t else 1.0 -. t end) /. run
      let ramp = if progress > 1.0 do 1.0 else progress end
      let height = if kind == 1 do 24.0 else if kind == 2 do 0.0 -. 8.0 else 0.0 end end
      height *. ramp
    end
    start +. (finish -. start) *. t +. lift
  end
  pfn visit(c : City, network : Int, dist : NativeIntArr, queue : NativeIntArr, tail : Int, i : Int, d : Int) : (NativeIntArr, NativeIntArr, Int) do
    if d >= 4 do (dist, queue, tail)
    else
      let j = neighbour(i, d)
      let next = if valid(j) && (if network == 1 do get(c.pipes, j) > 0 else if network == 2 do get(c.grid, j) > 0 else ((if network == 3 do motor_road(c, j) else get(c.roads, j) > 0 end) || (c.founding_map && get(c.ferries, j) > 0)) && int_abs(get(c.heights, i) - get(c.heights, j)) <= 12 end end) && get(dist, j) < 0 do
        (NativeArray.set_int(dist, j, get(dist, i) + 1), NativeArray.set_int(queue, tail, j), tail + 1)
      else (dist, queue, tail) end
      match next do (ds, qs, n) -> visit(c, network, ds, qs, n, i, d + 1) end
    end
  end
  pfn flood(c : City, network : Int, dist : NativeIntArr, queue : NativeIntArr, head : Int, tail : Int) : NativeIntArr do
    if head >= tail do dist
    else
      let i = NativeArray.get_int(queue, head)
      let j = get(c.ferries, i) - 1
      let link = (network == 0 || network == 3) && c.founding_map && valid(j) && get(dist, j) < 0
      let next = if link do (NativeArray.set_int(dist, j, get(dist, i) + 1), NativeArray.set_int(queue, tail, j), tail + 1)
        else (dist, queue, tail) end
      let (dist, queue, tail) = next
      let peer = grade_peer(c, i)
      let (dist, queue, tail) = if (network == 0 || network == 3) && valid(peer) && get(dist, peer) < 0 do
        (NativeArray.set_int(dist, peer, get(dist, i) + 1), NativeArray.set_int(queue, tail, peer), tail + 1)
      else (dist, queue, tail) end
      match visit(c, network, dist, queue, tail, i, 0) do
      (ds, qs, n) -> flood(c, network, ds, qs, head + 1, n)
      end
    end
  end
  pfn park_visit(a : NativeIntArr, q : NativeIntArr, tail : Int, i : Int, d : Int) : (NativeIntArr, NativeIntArr, Int) do
    if d == 4 do (a, q, tail) else
      let j = neighbour(i, d)
      if valid(j) && get(a, j) > 0 do
        park_visit(NativeArray.set_int(a, j, -1), NativeArray.set_int(q, tail, j), tail + 1, i, d + 1)
      else park_visit(a, q, tail, i, d + 1) end
    end
  end
  pfn park_flood(a : NativeIntArr, q : NativeIntArr, head : Int, tail : Int) : (NativeIntArr, NativeIntArr, Int) do
    if head == tail do (a, q, tail) else
      let (a, q, tail) = park_visit(a, q, tail, get(q, head), 0)
      park_flood(a, q, head + 1, tail)
    end
  end
  pfn park_label(a : NativeIntArr, q : NativeIntArr, i : Int, size : Int) : NativeIntArr do
    if i == size do a else park_label(NativeArray.set_int(a, get(q, i), 0 - size), q, i + 1, size) end
  end
  pfn park_components(a : NativeIntArr, q : NativeIntArr, i : Int) : NativeIntArr do
    if i == count() do a
    else if get(a, i) <= 0 do park_components(a, q, i + 1)
    else
      let (a, q, size) = park_flood(NativeArray.set_int(a, i, -1), NativeArray.set_int(q, 0, i), 0, 1)
      park_components(park_label(a, q, 0, size), q, i + 1)
    end end
  end
  pfn park_sizes(a : NativeIntArr, i : Int) : NativeIntArr do
    if i == count() do a else
      let n = get(a, i)
      park_sizes(if n < 0 do NativeArray.set_int(a, i, 0 - n) else a end, i + 1)
    end
  end
  fn resize_parks(c : City) : City do
    { c with parks: park_sizes(park_components(c.parks, NativeArray.make_int(2640, 0), 0), 0) }
  end
  fn park_name(tier : Int) : String do
    if tier == 2 do "Landmark park" else if tier == 1 do "Garden park" else "Neighborhood park" end end
  end
  pfn lowest_park_tier(tiers : NativeIntArr, q : NativeIntArr, n : Int, low : Int) : Int do
    if n == 0 || low == 0 do low else
      let tier = get(tiers, get(q, n - 1))
      lowest_park_tier(tiers, q, n - 1, if tier < low do tier else low end)
    end
  end
  pfn update_park_tier(tiers : NativeIntArr, q : NativeIntArr, n : Int, tier : Int, tiles : Int) : (NativeIntArr, Int) do
    if n == 0 do (tiers, tiles) else
      let i = get(q, n - 1)
      if get(tiers, i) >= tier do update_park_tier(tiers, q, n - 1, tier, tiles)
      else update_park_tier(NativeArray.set_int(tiers, i, tier), q, n - 1, tier, tiles + 1) end
    end
  end
  pfn upgrade_park(c : City, i : Int) : City do
    if get(c.parks, i) == 0 do { c with message: "Choose an existing park to upgrade." } else
      let (_, q, size) = park_flood(NativeArray.set_int(c.parks, i, -1), NativeArray.set_int(NativeArray.make_int(2640, 0), 0, i), 0, 1)
      let tier = lowest_park_tier(c.park_tiers, q, size, 2) + 1
      if tier > 2 do { c with message: "This park is already a landmark." } else
        let (next, tiles) = update_park_tier(c.park_tiers, q, size, tier, 0)
        let price = tiles * (if tier == 1 do 65 else 110 end)
        if c.cash < price do { c with message: "Park upgrade needs $" ++ int_to_string(price) ++ "." }
        else { c with park_tiers: next, cash: c.cash - price, message: park_name(tier) ++ " upgraded." } end
      end
    end
  end
  fn street_planting_tool(tool : Int) : Bool do tool >= 56 && tool <= 61 end
  fn sidewalk_tool(tool : Int) : Bool do street_planting_tool(tool) || tool == 91 end
  pfn sidewalk_stride(spot : Int) : Int do int_shl(1, spot * 3) end
  fn sidewalk_item(c : City, lot : Int, spot : Int) : Int do
    if spot >= 0 && spot < 4 do get(c.sidewalk_items, lot) / sidewalk_stride(spot) % 8 else 0 end
  end
  fn sidewalk_point(c : City, lot : Int, spot : Int) : (Int, Int) do
    let road = get(c.roads, lot)
    let across = street_link(c, lot, 0) || street_link(c, lot, 1)
    let along = street_link(c, lot, 2) || street_link(c, lot, 3)
    let (corner, _) = road_turn(c, lot)
    if spot < 0 || spot >= 4 || road == 0 || get(c.heights, lot) == 0 || lot == c.harbour ||
      get(c.ferries, lot) > 0 || grade_kind(c, grade_source(c, lot)) == 1 || valid(grade_peer(c, lot)) ||
      corner >= 0 || (across && along) do (-1, -1)
    else
      let length = if spot % 2 == 0 do 9 else 23 end
      let offset = clamp(road_half_width(road) + 1, 0, 14)
      let side = if spot < 2 do 16 - offset else 16 + offset end
      if along || !across do (side, length) else (length, side) end
    end
  end
  fn sidewalk_cans(c : City, lot : Int) : Int do
    let packed = get(c.sidewalk_items, lot)
    if packed == 0 do 0 else
      let (x, _) = sidewalk_point(c, lot, 0)
      if x < 0 do 0 else
        (if packed % 8 == 6 do 1 else 0 end) + (if packed / 8 % 8 == 6 do 1 else 0 end) +
          (if packed / 64 % 8 == 6 do 1 else 0 end) + (if packed / 512 % 8 == 6 do 1 else 0 end)
      end
    end
  end
  pfn individual_greenery(c : City, lot : Int, spot : Int, total : Int) : Int do
    if spot == 4 do total else
      let kind = sidewalk_item(c, lot, spot)
      individual_greenery(c, lot, spot + 1, total + (if kind <= 5 do streetscape_value(kind) else 0 end))
    end
  end
  pfn streetscape_value(kind : Int) : Int do
    if kind == 3 || kind == 5 do 3 else if kind > 0 do 2 else 0 end end
  end
  pfn street_greenery(c : City, i : Int, offset : Int, total : Int) : Int do
    if offset == 25 || total >= 10 do clamp(total, 0, 10) else
      let dx = offset % 5 - 2
      let dz = offset / 5 - 2
      let x = i % width() + dx
      let z = i / width() + dz
      let d = int_abs(dx) + int_abs(dz)
      let value = if x >= 0 && x < width() && z >= 0 && z < depth() && d <= 2 do
        let lot = index(x, z)
        let placed = if get(c.sidewalk_items, lot) == 0 do 0 else
          let (side, _) = sidewalk_point(c, lot, 0)
          if side < 0 do 0 else individual_greenery(c, lot, 0, 0) end
        end
        streetscape_value(get(c.streetscape, lot)) + placed
      else 0 end
      street_greenery(c, i, offset + 1, total + clamp(value - d, 0, 3))
    end
  end
  fn pedestrian_tile(c : City, i : Int) : Bool do
    valid(i) && get(c.heights, i) > 0 && (get(c.roads, i) > 0 || get(c.transit, i) == 1) && !ground_closed(c, i)
  end
  fn pedestrian_edge(c : City, i : Int, j : Int) : Bool do
    valid(i) && valid(j) && span_distance(i, j) == 1 && int_abs(get(c.heights, i) - get(c.heights, j)) <= 12
  end
  pfn park_sources(c : City, i : Int, field : ParkWalk, q : NativeIntArr, tail : Int) : (ParkWalk, NativeIntArr, Int) do
    if i == count() do (field, q, tail)
    else if get(c.parks, i) > 0 && !ground_closed(c, i) do
      let field = { steps: NativeArray.set_int(field.steps, i, 0), next: NativeArray.set_int(field.next, i, i) }
      park_sources(c, i + 1, field, NativeArray.set_int(q, tail, i), tail + 1)
    else park_sources(c, i + 1, field, q, tail) end end
  end
  pfn park_walk_edges(c : City, i : Int, d : Int, field : ParkWalk, q : NativeIntArr, tail : Int) : (ParkWalk, NativeIntArr, Int) do
    if d == 4 do (field, q, tail) else
      let j = neighbour(i, d)
      if pedestrian_tile(c, j) && pedestrian_edge(c, i, j) && get(field.steps, j) < 0 do
        let field = { steps: NativeArray.set_int(field.steps, j, get(field.steps, i) + 1), next: NativeArray.set_int(field.next, j, i) }
        park_walk_edges(c, i, d + 1, field, NativeArray.set_int(q, tail, j), tail + 1)
      else park_walk_edges(c, i, d + 1, field, q, tail) end
    end
  end
  pfn park_walk_flood(c : City, field : ParkWalk, q : NativeIntArr, head : Int, tail : Int) : ParkWalk do
    if head == tail do field else
      let (field, q, tail) = park_walk_edges(c, get(q, head), 0, field, q, tail)
      park_walk_flood(c, field, q, head + 1, tail)
    end
  end
  fn park_walk(c : City) : ParkWalk do
    let empty = NativeArray.make_int(2640, -1)
    let (field, q, tail) = park_sources(c, 0, { steps: empty, next: empty }, NativeArray.make_int(2640, 0), 0)
    park_walk_flood(c, field, q, 0, tail)
  end
  pfn park_frontage(c : City, field : ParkWalk, i : Int, d : Int, best : Int, steps : Int) : Int do
    if d == 4 do best else
      let j = neighbour(i, d)
      let cost = if pedestrian_tile(c, j) && pedestrian_edge(c, i, j) do get(field.steps, j) else -1 end
      if cost >= 0 && cost < steps do park_frontage(c, field, i, d + 1, j, cost)
      else park_frontage(c, field, i, d + 1, best, steps) end
    end
  end
  fn park_entry(c : City, field : ParkWalk, i : Int) : Int do
    if valid(i) && get(field.steps, i) >= 0 do i else park_frontage(c, field, i, 0, -1, 2640) end
  end
  pfn park_end(field : ParkWalk, i : Int) : Int do
    let next = get(field.next, i)
    if next == i || !valid(next) do i else park_end(field, next) end
  end
  fn walkable_park_score(c : City, field : ParkWalk, i : Int) : Int do
    let entry = park_entry(c, field, i)
    if !valid(entry) do 0 else
      let steps = get(field.steps, entry) + (if entry == i do 0 else 1 end)
      let park = park_end(field, entry)
      let quality = clamp(get(c.parks, park), 1, 15) + 6 * get(c.park_tiers, park)
      clamp(77 + quality - 3 * steps, 0, 100)
    end
  end
  pfn temple_range(tier : Int) : Int do 4 + tier * 3 end
  pfn temple_capacity(tier : Int) : Int do 32 * tier * tier end
  pfn temple_walk(c : City, lot : Int) : ParkWalk do
    let empty = NativeArray.make_int(2640, -1)
    let field = { steps: NativeArray.set_int(empty, lot, 0), next: NativeArray.set_int(empty, lot, lot) }
    park_walk_flood(c, field, NativeArray.set_int(NativeArray.make_int(2640, 0), 0, lot), 0, 1)
  end
  pfn walking_route(field : ParkWalk, lot : Int) : List(Int) do
    let next = get(field.next, lot)
    if next == lot || !valid(next) do Cons(lot, Nil) else Cons(lot, walking_route(field, next)) end
  end
  fn festival_walk_route(c : City, from : Int, host : Int) : List(Int) do
    if !valid(from) || temple_tier(c, host) == 0 do Nil else
      let field = temple_walk(c, host)
      let entry = park_entry(c, field, from)
      if !valid(entry) do Nil
      else if entry == from do walking_route(field, entry)
      else Cons(from, walking_route(field, entry)) end end
    end
  end
  pfn walking_steps(c : City, field : ParkWalk, lot : Int) : Int do
    let entry = park_entry(c, field, lot)
    if !valid(entry) do 2640 else get(field.steps, entry) + (if entry == lot do 0 else 1 end) end
  end
  pfn temple_bonuses(c : City, field : ParkWalk, i : Int, tier : Int, bonus : NativeIntArr) : NativeIntArr do
    if i == count() do bonus else
      let value = 3 + 3 * tier
      let bonus = if get(bonus, i) < value && occupied_homes(c, i) > 0 &&
        walking_steps(c, field, i) <= temple_range(tier) do NativeArray.set_int(bonus, i, value) else bonus end
      temple_bonuses(c, field, i + 1, tier, bonus)
    end
  end
  pfn worship_field(c : City, routes : NativeIntArr, hires : NativeIntArr, lot : Int, bonus : NativeIntArr) : NativeIntArr do
    if patron(c) == 0 || c.religion.dedication_target > 0 || lot == count() do bonus else
      let tier = temple_tier(c, lot)
      let bonus = if tier > 0 && temple_operating(c, routes, hires, lot) do
        temple_bonuses(c, temple_walk(c, lot), 0, tier, bonus)
      else bonus end
      worship_field(c, routes, hires, lot + 1, bonus)
    end
  end
  fn worship_access(st_city : City, st : Stats, lot : Int) : Bool do patron(st_city) > 0 && get(st.worship, lot) > 0 end
  pfn blank_festival() : FestivalSummary do { hosts: 0, attendees: 0, food: 0, trash: 0, sites: Nil } end
  fn festival_preview(c : City, st : Stats) : FestivalSummary do
    if festival_policy(c) == 2 do blank_festival() else st.festival end
  end
  pfn festival_attendance(c : City, host : FestivalHost, i : Int, tally : FestivalAttendance, book : Bool) : FestivalAttendance do
    let remaining = temple_capacity(host.tier) - tally.people
    if i == count() || remaining == 0 do tally else
      let households = clamp(occupied_homes(c, i), 0, remaining / 4)
      let attends = households > 0 && get(tally.sites, i) == 0 && walking_steps(c, host.walk, i) <= temple_range(host.tier)
      let next = if !attends do tally else
        let counted = { tally with people: tally.people + households * 4 }
        if book do { counted with sites: NativeArray.set_int(tally.sites, i, host.lot + 1),
          households: NativeArray.set_int(tally.households, i, households) }
        else counted end
      end
      festival_attendance(c, host, i + 1, next, book)
    end
  end
  pfn festival_candidates(c : City, routes : NativeIntArr, hires : NativeIntArr, lot : Int, hosts : List(FestivalHost)) : List(FestivalHost) do
    if lot == count() do List.reverse(hosts) else
      let hosts = if temple_operating(c, routes, hires, lot) do
        Cons({ lot: lot, walk: temple_walk(c, lot), tier: temple_tier(c, lot), reachable: 0 }, hosts)
      else hosts end
      festival_candidates(c, routes, hires, lot + 1, hosts)
    end
  end
  pfn best_festival(c : City, hosts : List(FestivalHost), attendance : FestivalAttendance, best : Option(FestivalHost)) : Option(FestivalHost) do
    match hosts do
      Nil -> best
      Cons(host, rest) ->
        let reachable = (festival_attendance(c, host, 0, { attendance with people: 0 }, false)).people
        let previous = match best do
          Some(h) -> h.reachable
          None -> 0
        end
        let best = if reachable > previous do Some({ host with reachable: reachable }) else best end
        best_festival(c, rest, attendance, best)
    end
  end
  pfn festival_food(people : Int) : Int do (people + 11) / 12 end
  pfn festival_trash(people : Int) : Int do (people + 7) / 8 end
  pfn choose_festivals(c : City, hosts : List(FestivalHost), left : Int, plan : FestivalPlan) : FestivalPlan do
    if left == 0 do plan else match best_festival(c, hosts, plan.attendance, None) do
      None -> plan
      Some(host) ->
        let attendance = festival_attendance(c, host, 0, { plan.attendance with people: 0 }, true)
        let people = attendance.people
        let summary = plan.summary
        let next = { sites: Cons(host, plan.sites), attendance: attendance, summary: { hosts: summary.hosts + 1,
          attendees: summary.attendees + people, food: summary.food + festival_food(people),
          trash: summary.trash + festival_trash(people), sites: Cons(host.lot, summary.sites) } }
        choose_festivals(c, List.filter(hosts, fn h -> h.lot != host.lot), left - 1, next)
    end end
  end
  pfn plan_festivals(c : City, routes : NativeIntArr, hires : NativeIntArr) : FestivalPlan do
    let zero = NativeArray.make_int(2640, 0)
    let blank = { sites: Nil, attendance: { sites: zero, households: zero, people: 0 }, summary: blank_festival() }
    if patron(c) == 0 || festival_policy(c) == 2 || c.religion.dedication_target > 0 do blank else
      let sites = festival_candidates(c, routes, hires, 0, Nil)
      let limit = if festival_policy(c) == 0 do 1 else 5 end
      choose_festivals(c, sites, limit, blank)
    end
  end
  fn festival_destination(c : City, home : Int) : Int do
    if last_festival(c) == absolute_day(c) + 1 do get(c.religion.festival_absence, home) - 1 else -1 end
  end
  pfn festival_household_share(c : City, lot : Int) : Int do
    let households = occupied_homes(c, lot)
    if households == 0 do 0 else clamp(get(c.religion.festival_attending, lot) * 100 / households, 0, 100) end
  end
  fn attends_festival(c : City, home : Int, resident : Int) : Bool do
    valid(festival_destination(c, home)) && Strata.Seed.cell(317, 1, resident, home, 0) % 100 < festival_household_share(c, home)
  end
  fn essential_work(c : City, lot : Int) : Bool do
    let kind = get(c.plants, lot)
    kind == 16 || kind == 19 || kind == 20 || kind == 21 || kind == 22 || kind == 25 || temple_tier(c, lot) > 0 ||
      power_plant(kind)
  end
  fn fever_absence(c : City, home : Int, worker : Int) : Bool do
    let illness = if curse_god(c) == 5 do (if clinic_nearby(c, home, 0) do 13 else 34 end) else 0 end
    let normal = if favor_god(c) == 5 || patron(c) == 0 do 0 else 2 end
    illness + normal > 0 && (worker * 73 + absolute_day(c) * 37) % 100 < illness + normal
  end
  pfn clinic_nearby(c : City, home : Int, lot : Int) : Bool do
    if lot == 49 do false else
      let x = home % width() + lot % 7 - 3
      let z = home / width() + lot / 7 - 3
      let site = index(x, z)
      (x >= 0 && x < width() && z >= 0 && z < depth() && (get(c.plants, site) == 19 || get(c.plants, site) == 22) &&
        !building_offline(c, site) && !facility_paused(c, site) && int_abs(x - home % width()) + int_abs(z - home / width()) <= 3) ||
        clinic_nearby(c, home, lot + 1)
    end
  end
  pfn parking_nuisance(c : City, i : Int, d : Int, total : Int) : Int do
    if d == 5 do total else
      let site = if d == 4 do i else neighbour(i, d) end
      let kind = get(c.public_parking, site)
      parking_nuisance(c, i, d + 1, total + (if kind == 1 do 9 else if kind == 2 do 2 else 0 end end))
    end
  end
  fn environment_score(c : City, i : Int) : Int do
    clamp(70 + 3 * street_greenery(c, i, 0, 0) - land_pollution_at(c, i) - street_noise(c, i) - parking_nuisance(c, i, 0, 0), 0, 100)
  end
  fn metric_name(metric : Int) : String do
    match metric do
      1 -> "Park walkability"
      2 -> "Commute"
      3 -> "Civic services"
      4 -> "Safety"
      5 -> "Job access"
      6 -> "Environment"
      _ -> "Livability"
    end
  end
  pfn nearby_jobs(c : City, routes : NativeIntArr, i : Int, offset : Int, total : Int) : Int do
    if offset == 81 || total >= 100 do clamp(total, 0, 100) else
      let dx = offset % 9 - 4
      let dz = offset / 9 - 4
      let x = i % width() + dx
      let z = i / width() + dz
      let d = int_abs(dx) + int_abs(dz)
      let jobs = if d <= 4 && x >= 0 && x < width() && z >= 0 && z < depth() do
        let lot = index(x, z)
        if distance(routes, lot) >= 0 do job_slots(c, lot) / (1 + d / 2) else 0 end
      else 0 end
      nearby_jobs(c, routes, i, offset + 1, total + jobs)
    end
  end
  pfn metric_value(c : City, routes : NativeIntArr, commutes : NativeIntArr, civic : NativeIntArr, walk : ParkWalk, i : Int, metric : Int) : Int do
    let mask = get(civic, i)
    match metric do
      1 -> walkable_park_score(c, walk, i)
      2 ->
        let lost_curb = waste_bin_edge(c, waste_storage_road(c, i)) >= 0
        let parking_stress = if lost_curb && homes_at(c, i) > 0 do
          if get(c.buildings, i) >= 3 do 2 else 5 end
        else 0 end
        clamp(106 - 2 * commute(commutes, i) - parking_stress, 0, 100)
      3 -> 25 * (mask % 2 + mask / 2 % 2 + mask / 4 % 2 + mask / 8 % 2)
      4 -> safety_score(c.crime_history, i)
      5 -> if commute(commutes, i) >= 999 do 0 else nearby_jobs(c, routes, i, 0, 0) end
      _ -> environment_score(c, i)
    end
  end
  pfn metric_sum(c : City, routes : NativeIntArr, commutes : NativeIntArr, civic : NativeIntArr, walk : ParkWalk, i : Int, metric : Int, sum : Int) : Int do
    if metric == 7 do sum else
      metric_sum(c, routes, commutes, civic, walk, i, metric + 1, sum + metric_value(c, routes, commutes, civic, walk, i, metric))
    end
  end
  fn base_happiness(c : City, st : Stats, i : Int) : Int do
    if !valid(i) || get(c.heights, i) == 0 do 0 else metric_sum(c, st.routes, st.commutes, st.civic, st.park_walk, i, 1, 0) / 6 end
  end
  fn religious_happiness(c : City, st : Stats, i : Int) : Int do
    clamp(get(st.worship, i) + festival_happiness(c, i), 0, 100 - base_happiness(c, st, i))
  end
  fn measure(c : City, st : Stats, i : Int, metric : Int) : Int do
    if !valid(i) || get(c.heights, i) == 0 do 0
    else if metric == 0 do clamp(base_happiness(c, st, i) + get(st.worship, i) + festival_happiness(c, i), 0, 100)
    else metric_value(c, st.routes, st.commutes, st.civic, st.park_walk, i, metric) end end
  end
  pfn add_measures(c : City, routes : NativeIntArr, commutes : NativeIntArr, civic : NativeIntArr, walk : ParkWalk, i : Int, metric : Int, residents : Int, sums : NativeIntArr) : NativeIntArr do
    if metric == 7 do sums else
      let value = metric_value(c, routes, commutes, civic, walk, i, metric)
      add_measures(c, routes, commutes, civic, walk, i, metric + 1, residents, NativeArray.set_int(sums, metric, get(sums, metric) + value * residents))
    end
  end
  pfn survey(c : City, routes : NativeIntArr, commutes : NativeIntArr, civic : NativeIntArr, walk : ParkWalk, i : Int, residents : Int, sums : NativeIntArr) : (Int, NativeIntArr) do
    if i == count() do (residents, sums) else
      let people = occupied_homes(c, i)
      let sums = if people > 0 do add_measures(c, routes, commutes, civic, walk, i, 1, people, sums) else sums end
      survey(c, routes, commutes, civic, walk, i + 1, residents + people, sums)
    end
  end
  pfn average_measures(sums : NativeIntArr, residents : Int, metric : Int, sample : NativeIntArr, total : Int) : NativeIntArr do
    if metric == 7 do NativeArray.set_int(sample, 0, total / 6) else
      let value = get(sums, metric) / residents
      average_measures(sums, residents, metric + 1, NativeArray.set_int(sample, metric, value), total + value)
    end
  end
  fn access(c : City) : NativeIntArr do
    let root = c.harbour
    let dist = NativeArray.make_int(2640, -1)
    if !valid(root) || get(c.roads, root) == 0 do dist
    else flood(c, 0, NativeArray.set_int(dist, root, 0), NativeArray.set_int(NativeArray.make_int(2640, 0), 0, root), 0, 1) end
  end
  pfn island_wells(c : City, dist : NativeIntArr, queue : NativeIntArr, i : Int, tail : Int) : (NativeIntArr, NativeIntArr, Int) do
    if i >= count() do (dist, queue, tail) else
      if get(c.plants, i) == 3 && get(c.pipes, i) > 0 && remote_food_island(c, i) == 1 do
        island_wells(c, NativeArray.set_int(dist, i, 0), NativeArray.set_int(queue, tail, i), i + 1, tail + 1)
      else island_wells(c, dist, queue, i + 1, tail) end
    end
  end
  fn pipe_access(c : City) : NativeIntArr do
    let root = c.harbour
    let dist = NativeArray.make_int(2640, -1)
    if !valid(root) || get(c.pipes, root) == 0 do dist
    else
      let dist = NativeArray.set_int(dist, root, 0)
      let queue = NativeArray.set_int(NativeArray.make_int(2640, 0), 0, root)
      flood(c, 1, dist, queue, 0, 1)
    end
  end
  fn farm_water(c : City) : NativeIntArr do
    let (dist, queue, tail) = island_wells(c, NativeArray.make_int(2640, -1), NativeArray.make_int(2640, 0), 0, 0)
    flood(c, 1, dist, queue, 0, tail)
  end
  fn grid_access(c : City) : NativeIntArr do
    let root = c.harbour
    let dist = NativeArray.make_int(2640, -1)
    if !valid(root) || get(c.grid, root) == 0 do dist
    else flood(c, 2, NativeArray.set_int(dist, root, 0), NativeArray.set_int(NativeArray.make_int(2640, 0), 0, root), 0, 1) end
  end
  pfn near_go(a : NativeIntArr, i : Int, d : Int, best : Int) : Int do
    if d >= 4 do best else
      let j = neighbour(i, d)
      let v = if valid(j) do get(a, j) else -1 end
      near_go(a, i, d + 1, if v >= 0 && (best < 0 || v < best) do v else best end)
    end
  end
  fn distance(a : NativeIntArr, i : Int) : Int do near_go(a, i, 0, if valid(i) do get(a, i) else -1 end) end
  pfn frontage_distance(c : City, routes : NativeIntArr, lot : Int, d : Int, best : Int) : Int do
    if d == 4 do best else
      let peer = neighbour(lot, d)
      let steps = if valid(peer) && int_abs(get(c.heights, lot) - get(c.heights, peer)) <= 12 do get(routes, peer) else -1 end
      frontage_distance(c, routes, lot, d + 1, if steps >= 0 && (best < 0 || steps < best) do steps else best end)
    end
  end
  fn building_access(c : City, routes : NativeIntArr, i : Int) : Int do
    let root = campus_root(c, i)
    let lot = if valid(root) do root else i end
    if valid(lot) do frontage_distance(c, routes, lot, 0, get(routes, lot)) else -1 end
  end
  fn fire_offline(c : City, i : Int) : Bool do get(c.fire_recovery, i) > 0 end
  fn building_offline(c : City, i : Int) : Bool do
    fire_offline(c, i) || flood_repair_days(c, i) > 0 || building_inundated(c, i) ||
      ((get(c.buildings, i) > 0 || get(c.plants, i) > 0) && quake_near(c, i, 3))
  end
  fn fire_rebuilding(c : City, i : Int) : Bool do get(c.fire_recovery, i) >= 4 end
  fn fire_months_left(c : City, i : Int) : Int do
    let recovery = get(c.fire_recovery, i)
    if recovery >= 4 do recovery % 4 + 1 else recovery end
  end
  fn housing_vacant(c : City, i : Int) : Bool do get(c.housing_losses, i) >= 4 || get(c.property_status, i) > 0 end
  fn business_closed(c : City, i : Int) : Bool do get(c.business_losses, i) >= 4 || get(c.property_status, i) > 0 end
  pfn home_floors(c : City, i : Int, floors : Int) : Int do
    let zone = get(c.zones, i)
    if zone == 1 || zone == 3 do floors - (if floors > 0 && commercial_ground(c, i) do 1 else 0 end) else 0 end
  end
  pfn dwelling_count(c : City, i : Int, floors : Int) : Int do
    home_floors(c, i, floors) * (if get(c.zones, i) == 3 do 3 else 4 end)
  end
  fn homes_at(c : City, i : Int) : Int do
    dwelling_count(c, i, get(c.buildings, i))
  end
  pfn tenanted_homes(c : City, i : Int) : Int do
    let built = get(c.buildings, i)
    -- A fire ruin stores its original floor count in the reconstruction record.
    let floors = if built == 0 do get(c.fire_recovery, i) / 4 else built end
    let homes = dwelling_count(c, i, floors)
    if homes == 0 || housing_vacant(c, i) do 0 else clamp(homes - get(c.empty_homes, i), 0, homes) end
  end
  fn occupied_homes(c : City, i : Int) : Int do
    if building_offline(c, i) do 0 else tenanted_homes(c, i) end
  end
  fn displaced_homes(c : City, i : Int) : Int do
    let homes = tenanted_homes(c, i)
    if homes > 0 && building_offline(c, i) do homes else 0 end
  end
  fn resident_homes(c : City, i : Int) : Int do
    tenanted_homes(c, i)
  end
  fn residential_floors(c : City, i : Int) : Int do
    if occupied_homes(c, i) > 0 do home_floors(c, i, get(c.buildings, i)) else 0 end
  end
  fn shop_space(c : City, i : Int) : Bool do
    get(c.buildings, i) > 0 && (retail_kind(c, i) > 0 || commercial_ground(c, i))
  end
  fn shop_occupied(c : City, i : Int) : Bool do
    shop_space(c, i) && storefront(c, i) != 3 && !building_offline(c, i) && !business_closed(c, i)
  end
  pfn job_capacity(c : City, i : Int) : Int do
    let floors = get(c.buildings, i)
    let zone = get(c.zones, i)
    if zone == 2 do (if storefront(c, i) == 3 do clamp(floors - 1, 0, floors) * 12 else floors * 12 end)
    else if commercial_ground(c, i) && storefront(c, i) != 3 && floors > 0 do 6 else 0 end end
  end
  fn job_slots(c : City, i : Int) : Int do
    if building_offline(c, i) || business_closed(c, i) do 0
    else if get(c.plants, i) == 16 do 4
    else
      let staff = worship_staff(temple_tier(c, i))
      if staff > 0 do staff else job_capacity(c, i) end
    end end
  end
  fn workforce(c : City, people : Int) : Int do D.workforce(c.census, people) end
  fn wage_rate(labor : Labor) : Int do
    if labor.workforce == 0 do 18 else 18 + clamp((labor.employed * 100 / labor.workforce - 85) / 5, -3, 4) end
  end
  type JobMatch = { home : Int, workplace : Int, rank : Int, workers : Int, minutes : Int, board : Int }
  fn assignments_changed(before : List(JobMatch), after : List(JobMatch)) : Bool do
    match (before, after) do
      (Nil, Nil) -> false
      (Cons(a, rest), Cons(b, next)) ->
        a.home != b.home || a.workplace != b.workplace || a.rank != b.rank || a.workers != b.workers || a.board != b.board ||
          assignments_changed(rest, next)
      _ -> true
    end
  end
  type Employment = { labor : Labor, filled : NativeIntArr, matches : List(JobMatch) }
  type Worksite = { lot : Int, rank : Int, travel : NativeIntArr, riding : NativeIntArr, without_bus : NativeIntArr }
  type CommuteNetwork = { traffic : NativeIntArr, running : NativeIntArr, buses : BusNetwork }
  type Matching = { filled : NativeIntArr, matches : List(JobMatch), employed : Int, premium : Int, seats_used : NativeIntArr }
  fn commute_limit() : Int do 36 end
  fn qualified_for(skill : Int, rank : Int) : Bool do
    rank == 0 || rank == skill || (rank == 1 && skill > 1) || (rank == 3 && skill >= 4)
  end
  pfn worker_credentials(c : City, workers : Int) : NativeIntArr do
    let university = clamp(graduates(c, 3), 0, workers)
    let trade = clamp(graduates(c, 2), 0, workers - university)
    let secondary = clamp(graduates(c, 1), 0, workers - university - trade)
    let skills = specialist_supply(c, university, 4, NativeArray.make_int(9, 0))
    let skills = NativeArray.set_int(skills, 3, university - specialization_total(skills))
    let skills = NativeArray.set_int(NativeArray.set_int(skills, 2, trade), 1, secondary)
    NativeArray.set_int(skills, 0, workers - university - trade - secondary)
  end
  pfn jobsites(c : City, roads : NativeIntArr, network : CommuteNetwork, i : Int, out : List(Worksite)) : List(Worksite) do
    if i >= count() do List.reverse(out) else
      let out = if job_slots(c, i) > 0 && building_access(c, roads, i) >= 0 do
        let (street, riding) = workplace_travel(c, network.traffic, network.running, i)
        let (other, _) = if List.is_empty(network.buses.lines) do (street, riding)
          else workplace_travel(c, network.traffic, network.buses.other_modes, i) end
        Cons({ lot: i, rank: job_requirement(c, i), travel: street, riding: riding, without_bus: other }, out)
      else out end
      jobsites(c, roads, network, i + 1, out)
    end
  end
  type JobOffer = { lot : Int, minutes : Int, board : Int, room : Int, score : Int }
  pfn best_job(c : City, network : CommuteNetwork, sites : List(Worksite), matched : Matching, home : Int, skill : Int, best : JobOffer) : JobOffer do
    match sites do
      Nil -> best
      Cons(site, rest) ->
        let openings = job_slots(c, site.lot) - get(matched.filled, site.lot)
        let best = if openings <= 0 || !qualified_for(skill, site.rank) do best else
          let trip = commute(site.travel, home)
          let ordinary = commute(site.without_bus, home)
          let (bus_trip, board) = if trip < ordinary && trip <= commute_limit() do
            boarding_cost(c, network.traffic, network.running, site.riding, home, 0, 999, -1)
          else (999, -1) end
          let route = get(network.buses.line_at, board) - 1
          let seats = if valid(route) do bus_seats() * frequency(c, board) - get(matched.seats_used, route) else 0 end
          let takes_bus = seats > 0 && affordable_bus(c, site.rank) && bus_trip <= commute_limit() && bus_trip + c.bus_fare < ordinary
          let minutes = if takes_bus do bus_trip else ordinary end
          let municipal_priority = if get(c.plants, site.lot) == 16 || site.rank == 8 do 12 else 0 end
          let score = minutes + (if takes_bus do c.bus_fare else 0 end) - credential_premium(site.rank) * 2 - municipal_priority
          if minutes > commute_limit() || score >= best.score do best else
            { lot: site.lot, minutes: minutes, board: if takes_bus do board else -1 end,
              room: if takes_bus do clamp(seats, 0, openings) else openings end, score: score }
          end
        end
        best_job(c, network, rest, matched, home, skill, best)
    end
  end
  pfn place_workers(c : City, network : CommuteNetwork, sites : List(Worksite), home : Int, skill : Int, workers : Int, matched : Matching) : Matching do
    if workers == 0 do matched else
      let choice = best_job(c, network, sites, matched, home, skill, { lot: -1, minutes: 999, board: -1, room: 0, score: 999 })
      let lot = choice.lot
      if !valid(lot) do matched else
        let filled = get(matched.filled, lot)
        let take = clamp(workers, 0, choice.room)
        let line = get(network.buses.line_at, choice.board) - 1
        let used = if valid(line) do NativeArray.set_int(matched.seats_used, line, get(matched.seats_used, line) + take) else matched.seats_used end
        place_workers(c, network, sites, home, skill, workers - take, {
          filled: NativeArray.set_int(matched.filled, lot, filled + take), seats_used: used,
          matches: Cons({ home: home, workplace: lot, rank: skill, workers: take, minutes: choice.minutes, board: choice.board }, matched.matches),
          employed: matched.employed + take, premium: matched.premium + take * credential_premium(job_requirement(c, lot)) })
      end
    end
  end
  pfn match_skill(c : City, network : CommuteNetwork, sites : List(Worksite), skill : Int, workers : Int, housing : Int, seen : Int, i : Int, matched : Matching) : Matching do
    if workers == 0 || seen == housing || i >= count() do matched else
      let after = seen + occupied_homes(c, i)
      let local_workers = after * workers / housing - seen * workers / housing
      let matched = if local_workers > 0 do place_workers(c, network, sites, i, skill, local_workers, matched) else matched end
      match_skill(c, network, sites, skill, workers, housing, after, i + 1, matched)
    end
  end
  pfn match_skills(c : City, network : CommuteNetwork, sites : List(Worksite), credentials : NativeIntArr, housing : Int, skill : Int, matched : Matching) : Matching do
    if skill < 0 do matched else
      let matched = match_skill(c, network, sites, skill, get(credentials, skill), housing, 0, 0, matched)
      match_skills(c, network, sites, credentials, housing, skill - 1, matched)
    end
  end
  pfn allocate_pay(c : City, matches : List(JobMatch), base : Int, pay : NativeIntArr) : NativeIntArr do
    match matches do
      Nil -> pay
      Cons(hire, rest) ->
        let wages = hire.workers * (base + credential_premium(job_requirement(c, hire.workplace)))
        allocate_pay(c, rest, base, NativeArray.set_int(pay, hire.home, get(pay, hire.home) + wages))
    end
  end
  pfn employment_with(c : City, routes : NativeIntArr, network : CommuteNetwork, people : Int, work : Int) : Employment do
    let workers = workforce(c, people)
    let zero = NativeArray.make_int(2640, 0)
    let blank = { filled: zero, matches: Nil, employed: 0, premium: 0, seats_used: zero }
    let matched = if workers == 0 || work == 0 || !valid(c.harbour) do blank else
      let sites = jobsites(c, routes, network, 0, Nil)
      let housing = sum(c, 0, 0, 0) / 4
      match_skills(c, network, sites, worker_credentials(c, workers), housing, 8, blank)
    end
    let labor = { workforce: workers, employed: matched.employed, unemployed: workers - matched.employed, vacancies: work - matched.employed, wages: 0, local_income: None, fares: None }
    let base = wage_rate(labor)
    { labor: { labor with wages: matched.employed * base + matched.premium, local_income: Some(allocate_pay(c, matched.matches, base, NativeArray.make_int(2640, 0))) },
      filled: matched.filled, matches: List.reverse(matched.matches) }
  end
  fn employment(c : City, routes : NativeIntArr, people : Int) : Employment do
    let running = transit_service(c, supply(c, routes))
    (transport_report_with(c, routes, running, people, jobs(c))).hiring
  end
  fn workplace_hiring(c : City, routes : NativeIntArr, people : Int) : NativeIntArr do
    (employment(c, routes, people)).filled
  end
  fn job_vacancy_reason(c : City, st : Stats, lot : Int) : String do
    let need = job_requirement(c, lot)
    if building_offline(c, lot) do "Closed for repairs"
    else if business_closed(c, lot) do "Business is closed"
    else if building_access(c, st.routes, lot) < 0 do "No connected route to the workplace"
    else if get(st.staffed_jobs, lot) >= job_slots(c, lot) do "All positions filled"
    else if need == 0 do "Too few available workers within commuting range"
    else if need == 1 do "Too few available secondary graduates"
    else if need == 2 do "Too few available trade graduates"
    else if need == 3 do "Too few available university graduates"
    else "Too few graduates in " ++ specialization_name(need)
    end end end end end end end end
  end
  -- Monthly cohort rings hold students until they finish a complete course.
  -- Header: secondary waiting, three workforce qualifications, four enrolments,
  -- trade and university tuition, fractional admissions, and the highest school built.
  fn new_education() : NativeIntArr do
    NativeArray.set_int(NativeArray.set_int(NativeArray.make_int(228, 0), 8, 4), 9, 9)
  end
  -- Each faculty has a graduate count, a fractional attrition carry, and 12 monthly cohorts.
  fn new_specializations() : NativeIntArr do NativeArray.make_int(71, 0) end
  fn specialization_name(rank : Int) : String do
    match rank do
      4 -> "Medicine"
      5 -> "Sciences"
      6 -> "Business"
      7 -> "Law"
      _ -> "Seminary"
    end
  end
  pfn specialization_start(rank : Int) : Int do if rank == 8 do 57 else (rank - 4) * 14 end end
  fn specialist_graduates(c : City, rank : Int) : Int do get(c.specializations, specialization_start(rank)) end
  pfn specialist_students(data : NativeIntArr, slot : Int, last : Int, students : Int) : Int do
    if slot == last do students else specialist_students(data, slot + 1, last, students + get(data, slot)) end
  end
  fn specialist_enrolled(c : City, rank : Int) : Int do
    let first = specialization_start(rank)
    specialist_students(c.specializations, first + 2, first + 14, 0)
  end
  pfn specialization_total(values : NativeIntArr) : Int do get(values, 4) + get(values, 5) + get(values, 6) + get(values, 7) + get(values, 8) end
  pfn specialist_supply(c : City, remaining : Int, rank : Int, supply : NativeIntArr) : NativeIntArr do
    if rank == 9 do supply else
      let graduates = clamp(specialist_graduates(c, rank), 0, remaining)
      specialist_supply(c, remaining - graduates, rank + 1, NativeArray.set_int(supply, rank, graduates))
    end
  end
  fn faculty_rank(kind : Int) : Int do if kind == 41 do 8 else if kind >= 29 && kind <= 32 do kind - 25 else -1 end end end
  fn can_pause_facility(c : City, lot : Int) : Bool do
    let kind = get(c.plants, lot)
    kind == 11 || kind == 35 || kind == 36 || faculty_rank(kind) >= 4
  end
  fn facility_paused(c : City, lot : Int) : Bool do
    get(c.paused_facilities, lot) > 0
  end
  fn toggle_facility(c : City, lot : Int) : City do
    if !can_pause_facility(c, lot) do c else
      let paused = facility_paused(c, lot)
      { c with paused_facilities: NativeArray.set_int(c.paused_facilities, lot, if paused do 0 else 1 end),
        message: facility_name(get(c.plants, lot)) ++ (if paused do " resumed." else " paused." end) }
    end
  end
  fn active_program_at(c : City, lot : Int) : Int do
    if facility_paused(c, lot) || building_offline(c, lot) do -1 else program_at(c, lot) end
  end
  fn program_at(c : City, lot : Int) : Int do
    let kind = get(c.plants, lot)
    if faculty_rank(kind) >= 4 do faculty_rank(kind) else school_stage(kind) end
  end
  fn program_enrolled(c : City, rank : Int) : Int do
    if rank >= 4 do specialist_enrolled(c, rank) else enrolled(c, rank) end
  end
  fn school_stage(kind : Int) : Int do
    if kind == 18 do 0 else if kind >= 26 && kind <= 28 do kind - 25 else -1 end end
  end
  pfn has_school_level(c : City, required : Int, i : Int) : Bool do
    if i >= count() do false
    else school_stage(get(c.plants, i)) + 1 >= required || has_school_level(c, required, i + 1) end
  end
  fn school_requirement(c : City, tool : Int) : String do
    if tool < 79 || tool > 81 do "" else
      let required = if tool == 79 do 1 else 2 end
      if get(c.education, 13) >= required || has_school_level(c, required, 0) do ""
      else if required == 1 do "Build elementary first" else "Build secondary first" end end
    end
  end
  pfn has_facility(c : City, kind : Int, i : Int) : Bool do
    if i == count() do false else
      let matches = get(c.plants, i) == kind && (kind != 30 || get(c.plants, campus_root(c, i)) == 28)
      matches || has_facility(c, kind, i + 1)
    end
  end
  fn construction_requirement(c : City, tool : Int) : String do
    match tool do
      103 -> if chosen_patron(c) == 0 do "Choose a patron in Details / Religion" else "" end
      104 -> if c.religion.unlocked < 1 do "Build a Shrine first" else "" end
      105 -> if c.religion.unlocked < 2 do "Build a Temple first" else "" end
      106 -> if has_facility(c, 40, 0) do "The city already has a Grand Temple"
        else if c.religion.unlocked < 3 do "Build a Large Temple first" else "" end end
      107 -> if has_facility(c, 28, 0) do "" else "Build a university first" end
      16 | 86 -> if has_facility(c, 27, 0) do "" else "Build a trade school first" end
      22 -> if has_facility(c, 30, 0) do "" else "Add a Faculty of Sciences to a university first" end
      78 -> if has_facility(c, 20, 0) do "" else "Build a basic fire station first" end
      62 ->
        let clinic = has_facility(c, 19, 0)
        let university = has_facility(c, 28, 0)
        if clinic && university do "" else if clinic do "Build a university first"
        else if university do "Build a clinic first" else "Build a clinic and a university first" end end end
      _ -> school_requirement(c, tool)
    end
  end
  fn school_capacity(kind : Int) : Int do
    match kind do
      18 -> 72
      26 -> 96
      27 -> 64
      28 -> 112
      _ -> 0
    end
  end
  fn education_name(stage : Int) : String do
    match stage do
      0 -> "Elementary"
      1 -> "Secondary"
      2 -> "Trade school"
      _ -> "University"
    end
  end
  fn enrolled(c : City, stage : Int) : Int do get(c.education, 4 + stage) end
  fn graduates(c : City, stage : Int) : Int do get(c.education, stage) end
  fn school_tuition(c : City, stage : Int) : Int do if stage < 2 do 0 else get(c.education, 6 + stage) end end
  fn change_tuition(c : City, stage : Int, change : Int) : City do
    if stage < 2 || stage > 3 do c else
      let fee = clamp(school_tuition(c, stage) + change, 0, 30)
      { c with education: NativeArray.set_int(c.education, 6 + stage, fee),
        message: education_name(stage) ++ " tuition set to $" ++ int_to_string(fee) ++ " per month." }
    end
  end
  fn job_requirement(c : City, i : Int) : Int do
    match temple_tier(c, i) do
      1 -> 1
      2 | 3 -> 3
      4 -> 8
      _ -> if get(c.zones, i) == 2 do get(c.business_sector, i) else 0 end
    end
  end
  fn sector_name(requirement : Int) : String do
    match requirement do
      1 -> "Business services"
      2 -> "Skilled workshops"
      3 -> "Research and engineering"
      4 -> "Medical practices"
      5 -> "Science laboratories"
      6 -> "Business consultancies"
      7 -> "Law firms"
      8 -> "Clergy"
      _ -> "General employment"
    end
  end
  pfn credential_premium(requirement : Int) : Int do
    match requirement do
      1 -> 2
      2 -> 5
      3 -> 8
      4 | 5 | 6 | 7 | 8 -> 12
      _ -> 0
    end
  end
  pfn skill_jobs(c : City, routes : NativeIntArr, i : Int, totals : NativeIntArr) : NativeIntArr do
    if i >= count() do totals else
      let slots = job_slots(c, i)
      let requirement = job_requirement(c, i)
      let totals = if slots > 0 && building_access(c, routes, i) >= 0 do
        NativeArray.set_int(totals, requirement, get(totals, requirement) + slots)
      else totals end
      skill_jobs(c, routes, i + 1, totals)
    end
  end
  pfn school_seats(c : City, routes : NativeIntArr, i : Int, seats : NativeIntArr) : NativeIntArr do
    if i >= count() do seats else
      let kind = get(c.plants, i)
      let stage = school_stage(kind)
      let seats = if stage >= 0 && !building_offline(c, i) && building_access(c, routes, i) >= 0 do
        NativeArray.set_int(seats, stage, get(seats, stage) + school_capacity(kind))
      else seats end
      school_seats(c, routes, i + 1, seats)
    end
  end
  pfn intake_population(c : City, early : NativeIntArr, i : Int, total : Int) : Int do
    if i >= count() do total else
      intake_population(c, early, i + 1, total + (if has_civic(get(early, i), 1) do 4 * occupied_homes(c, i) else 0 end))
    end
  end
  pfn course_slot(stage : Int, month : Int) : Int do
    match stage do
      0 -> 24 + month % 60
      1 -> 84 + month % 72
      2 -> 156 + month % 24
      _ -> 180 + month % 48
    end
  end
  pfn step_course(data : NativeIntArr, stage : Int, month : Int, starts : Int) : NativeIntArr do
    let slot = course_slot(stage, month)
    let enrolled = get(data, stage + 4) - get(data, slot) + starts
    NativeArray.set_int(NativeArray.set_int(data, slot, starts), stage + 4, enrolled)
  end
  pfn available_seats(c : City, seats : NativeIntArr, stage : Int, month : Int) : Int do
    clamp(get(seats, stage) - enrolled(c, stage) + get(c.education, course_slot(stage, month)), 0, 100000)
  end
  pfn study_appeal(c : City, labor : Labor, positions : NativeIntArr, stage : Int) : Int do
    let openings = clamp(get(positions, stage) - graduates(c, stage), 0, 100000)
    let potential = clamp(labor.vacancies / (if stage == 2 do 8 else 12 end), 0, 25)
    let tuition = school_tuition(c, stage)
    let budget = wage_rate(labor) * (100 - c.tax) / 100 - c.energy / 2
    if tuition > budget do 0 else clamp(30 + 4 * credential_premium(stage) + 2 * openings + potential - 4 * tuition, 0, 90) end
  end
  pfn faculty_seats(c : City, routes : NativeIntArr, lot : Int, seats : NativeIntArr) : NativeIntArr do
    if lot == count() do seats else
      let rank = active_program_at(c, lot)
      let root = campus_root(c, lot)
      let seats = if rank >= 4 && valid(root) && building_access(c, routes, root) >= 0 do
        NativeArray.set_int(seats, rank, get(seats, rank) + 24)
      else seats end
      faculty_seats(c, routes, lot + 1, seats)
    end
  end
  pfn choose_faculty(c : City, spaces : NativeIntArr, positions : NativeIntArr, rank : Int, best : Int, score : Int) : Int do
    if rank == 9 do best else
      let demand = get(positions, rank) - specialist_graduates(c, rank)
      let appeal = clamp(demand, 0, 30) + (rank + c.month) % 4
      if get(spaces, rank) > 0 && appeal > score do choose_faculty(c, spaces, positions, rank + 1, rank, appeal)
      else choose_faculty(c, spaces, positions, rank + 1, best, score) end
    end
  end
  pfn admit_specialists(c : City, spaces : NativeIntArr, positions : NativeIntArr, remaining : Int, data : NativeIntArr) : NativeIntArr do
    if remaining <= 0 do data else
      let rank = choose_faculty(c, spaces, positions, 4, -1, -1)
      if rank < 0 do data else
        let slot = specialization_start(rank) + 2 + c.month % 12
        let data = NativeArray.set_int(data, slot, get(data, slot) + 1)
        admit_specialists(c, NativeArray.set_int(spaces, rank, get(spaces, rank) - 1), positions, remaining - 1, data)
      end
    end
  end
  pfn paused_faculty(c : City, rank : Int, lot : Int) : Bool do
    if lot >= count() do false else
      (facility_paused(c, lot) && faculty_rank(get(c.plants, lot)) == rank) || paused_faculty(c, rank, lot + 1)
    end
  end
  -- Shift the graduation schedule one month while every available campus is paused.
  pfn defer_cohorts(data : NativeIntArr, first : Int, slot : Int, last : Int) : NativeIntArr do
    if slot == first do NativeArray.set_int(data, first, last)
    else defer_cohorts(NativeArray.set_int(data, slot, get(data, slot - 1)), first, slot - 1, last) end
  end
  pfn finish_specialists(c : City, seats : NativeIntArr, rank : Int, spaces : NativeIntArr, data : NativeIntArr) : (NativeIntArr, NativeIntArr) do
    if rank == 9 do (spaces, data) else
      let first = specialization_start(rank)
      let slot = first + 2 + c.month % 12
      if get(seats, rank) == 0 && specialist_enrolled(c, rank) > 0 && paused_faculty(c, rank, 0) do
        let data = defer_cohorts(data, first + 2, first + 13, get(data, first + 13))
        finish_specialists(c, seats, rank + 1, spaces, data)
      else
        let completed = if get(seats, rank) > 0 do get(data, slot) else 0 end
        let space = clamp(get(seats, rank) - specialist_enrolled(c, rank) + get(data, slot), 0, 100000)
        let data = NativeArray.set_int(NativeArray.set_int(data, first, get(data, first) + completed), slot, 0)
        finish_specialists(c, seats, rank + 1, NativeArray.set_int(spaces, rank, space), data)
      end
    end
  end
  pfn advance_specializations(c : City, routes : NativeIntArr, university_done : Int) : NativeIntArr do
    let seats = faculty_seats(c, routes, 0, NativeArray.make_int(9, 0))
    let (spaces, data) = finish_specialists(c, seats, 4, NativeArray.make_int(9, 0), c.specializations)
    if specialization_total(spaces) == 0 do data else
      let candidates = university_done + get(data, 56)
      let data = NativeArray.set_int(data, 56, candidates % 2)
      if candidates < 2 do data else
        admit_specialists(c, spaces, skill_jobs(c, routes, 0, NativeArray.make_int(9, 0)), candidates / 2, data)
      end
    end
  end
  fn advance_education(c : City, routes : NativeIntArr, labor : Labor, people : Int) : City do
    let seats = school_seats(c, routes, 0, NativeArray.make_int(4, 0))
    if people == 0 do c else
      let data = c.education
      let month = c.month
      let early = if get(seats, 0) > 0 do civic_service(c, routes, 18, 7, 1, NativeArray.make_int(2640, 0)) else NativeArray.make_int(2640, 0) end
      let connected = if get(seats, 0) > 0 do intake_population(c, early, 0, 0) else 0 end
      let intake = match c.population_history do
        Cons(sample, _) -> get(data, 10) + get(sample, 5) * clamp(connected * 240 / people, 0, 240)
        Nil -> get(data, 10) + connected
      end
      let element = clamp(intake / 240, 0, available_seats(c, seats, 0, month))
      let primary = get(data, 0) + get(data, course_slot(0, month))
      let secondary = clamp(primary, 0, available_seats(c, seats, 1, month))
      let finished = get(data, course_slot(1, month))
      let positions = if finished > 0 do skill_jobs(c, routes, 0, NativeArray.make_int(9, 0)) else NativeArray.make_int(4, 0) end
      let trade_appeal = if get(seats, 2) > 0 do study_appeal(c, labor, positions, 2) else 0 end
      let university_appeal = if get(seats, 3) > 0 do study_appeal(c, labor, positions, 3) else 0 end
      let weights = 35 + trade_appeal + university_appeal
      -- Fractional choices carry forward so small graduating classes can take either branch.
      let trade_interest = get(data, 11) + finished * (100 * trade_appeal / weights)
      let university_interest = get(data, 12) + finished * (100 * university_appeal / weights)
      let trade = clamp(trade_interest / 100, 0, clamp(finished, 0, available_seats(c, seats, 2, month)))
      let university = clamp(university_interest / 100, 0, clamp(finished - trade, 0, available_seats(c, seats, 3, month)))
      let trade_done = get(data, course_slot(2, month))
      let university_done = get(data, course_slot(3, month))
      let data = step_course(step_course(data, 0, month, element), 1, month, secondary)
      let data = step_course(step_course(data, 2, month, trade), 3, month, university)
      let data = NativeArray.set_int(data, 0, clamp(primary - secondary, 0, people / 3))
      let data = NativeArray.set_int(data, 1, clamp(graduates(c, 1) + finished - trade - university, 0, workforce(c, people)))
      let data = NativeArray.set_int(data, 2, clamp(graduates(c, 2) + trade_done, 0, workforce(c, people)))
      let data = NativeArray.set_int(data, 3, clamp(graduates(c, 3) + university_done, 0, workforce(c, people)))
      let data = NativeArray.set_int(data, 10, intake % 240)
      let data = NativeArray.set_int(data, 11, trade_interest % 100)
      { c with education: NativeArray.set_int(data, 12, university_interest % 100), specializations: advance_specializations(c, routes, university_done) }
    end
  end
  pfn open_specialists(c : City, routes : NativeIntArr, people : Int, i : Int, sectors : NativeIntArr) : NativeIntArr do
    if i >= count() do sectors else
      let eligible = get(c.zones, i) == 2 && get(c.buildings, i) > 0 && retail_kind(c, i) == 0 &&
        storefront(c, i) == 0 && get(c.property_status, i) == 0
      let workers = clamp(workforce(c, people), 1, 1000000)
      let roll = i % 9
      let degree = graduates(c, 3)
      let trade = graduates(c, 2)
      let secondary = graduates(c, 1) + degree + trade
      let specialist = 4 + (i % 13 + i / width()) % 4
      let sector = if !eligible do 0
        else if get(sectors, i) > 0 && !business_closed(c, i) do get(sectors, i)
        else if building_access(c, routes, i) < 0 || building_offline(c, i) || (get(c.business_age, i) > 2 && !business_closed(c, i)) do 0
        else if roll < 3 && specialist_graduates(c, specialist) >= 2 do specialist
        else if roll < 3 && degree >= 6 && degree * 100 >= 8 * workers do 3
        else if roll < 6 && trade >= 6 && trade * 100 >= 8 * workers do 2
        else if roll < 8 && secondary >= 8 && secondary * 100 >= 14 * workers do 1
        else 0 end end end end end end end
      let next = if get(sectors, i) == sector do sectors else NativeArray.set_int(sectors, i, sector) end
      open_specialists(c, routes, people, i + 1, next)
    end
  end
  pfn facility_upkeep(kind : Int) : Int do
    match kind do
      42 -> 14
      18 -> 6
      26 -> 10
      27 -> 15
      28 -> 23
      29 | 30 | 31 | 32 | 41 -> 14
      37 -> 4
      38 -> 11
      39 -> 24
      40 -> 48
      33 -> 18
      19 -> 8
      20 -> 7
      21 -> 6
      22 -> 21
      25 -> 11
      _ -> 8
    end
  end
  fn parcel_facility_upkeep(c : City, lot : Int) : Int do
    let kind = get(c.plants, lot)
    if kind == 0 do 0 else
      let upkeep = facility_upkeep(kind)
      if facility_paused(c, lot) do upkeep / 4 else upkeep end
    end
  end
  pfn sum(c : City, i : Int, kind : Int, total : Int) : Int do
    if i >= count() do total else
      let b = get(c.buildings, i)
      let v = if kind == 0 do resident_homes(c, i) * 4
        else if kind == 1 do job_slots(c, i)
        else if kind == 2 do (if building_offline(c, i) do 0 else b * 4 end)
        else parking_upkeep(get(c.public_parking, i)) + road_upkeep(get(c.roads, i)) + flood_upkeep(c, i) + (if get(c.parks, i) > 0 do 1 + get(c.park_tiers, i) else 0 end) + 4 * (if get(c.grade_cover, i) > 0 do 1 else 0 end) + utility_upkeep(get(c.pipes, i)) + utility_upkeep(get(c.grid, i)) + parcel_facility_upkeep(c, i) end end end
      sum(c, i + 1, kind, total + v)
    end
  end
  fn population(c : City) : Int do
    let capacity = sum(c, 0, 0, 0)
    if !D.initialized(c.census) do capacity else clamp(D.total(c.census), 0, capacity * 5 / 4) end
  end
  fn immigration_name(level : Int) : String do
    if level == 0 do "Restrict" else if level == 2 do "Encourage" else "Balanced" end end
  end
  fn advance_population(c : City, census : NativeIntArr, labor : Labor, routes : NativeIntArr) : City do
    let homes = sum(c, 0, 0, 0) / 4
    let positions = skill_jobs(c, routes, 0, NativeArray.make_int(9, 0))
    let connected_jobs = get(positions, 0) + get(positions, 1) + get(positions, 2) + get(positions, 3) + specialization_total(positions)
    let unemployment = if labor.workforce == 0 do 0 else labor.unemployed * 12 / labor.workforce end
    let cost_pressure = clamp(c.tax - 17, 0, 8) + clamp(c.energy - 7, 0, 5) * 2
    let change = D.advance(census, homes, connected_jobs, unemployment + cost_pressure, c.immigration)
    let sample = NativeArray.set_int(NativeArray.make_int(6, 0), 0, c.month)
    let sample = NativeArray.set_int(NativeArray.set_int(sample, 1, change.births), 2, change.deaths)
    let sample = NativeArray.set_int(NativeArray.set_int(sample, 3, change.arrived), 4, change.left)
    let sample = NativeArray.set_int(sample, 5, change.pupils)
    let old_workers = workforce({ c with census: census }, D.total(census))
    let new_workers = workforce({ c with census: change.census }, D.total(change.census))
    let education = lose_qualifications(c.education, old_workers, new_workers, change.workers_lost, 3)
    let specializations = lose_specialists(c.specializations, old_workers, change.workers_lost, 4)
    { c with census: change.census, education: education, specializations: specializations, population_history: Cons(sample, List.take(c.population_history, 23)) }
  end
  pfn lose_specialists(data : NativeIntArr, workers : Int, exits : Int, rank : Int) : NativeIntArr do
    if rank == 9 || exits == 0 do data else
      let first = specialization_start(rank)
      let graduates = get(data, first)
      let loss = get(data, first + 1) + graduates * exits * 1000 / clamp(workers, 1, 1000000)
      let data = NativeArray.set_int(NativeArray.set_int(data, first, clamp(graduates - loss / 1000, 0, graduates)), first + 1, loss % 1000)
      lose_specialists(data, workers, exits, rank + 1)
    end
  end
  pfn lose_qualifications(data : NativeIntArr, old_workers : Int, remaining : Int, exits : Int, level : Int) : NativeIntArr do
    if level < 1 do data else
      let qualified = get(data, level)
      let denominator = clamp(old_workers, 1, 1000000)
      let loss = get(data, 17 + level) + qualified * exits * 1000 / denominator
      let survivors = clamp(qualified - loss / 1000, 0, remaining)
      let next = NativeArray.set_int(NativeArray.set_int(data, 17 + level, loss % 1000), level, survivors)
      lose_qualifications(next, old_workers, remaining - survivors, exits, level - 1)
    end
  end
  fn jobs(c : City) : Int do sum(c, 0, 1, 0) end
  fn load(c : City) : Int do sum(c, 0, 2, 0) end
  -- The western island has an aquifer. The eastern island has a volcanic
  -- field and depends on desalination or water delivered over the link.
  fn freshwater(c : City, i : Int) : Bool do
    if c.founding_map do valid(i) && get(c.heights, i) > 0 &&
      ((i % width() >= 12 && i % width() <= 23 && i / width() >= 23 && i / width() <= 30) ||
       (i % width() >= 42 && i % width() <= 51 && i / width() >= 30))
    else valid(i) && i % width() >= 6 && i % width() <= 13 && i / width() >= 16 && i / width() <= 22 end
  end
  fn geothermal(c : City, i : Int) : Bool do
    if c.founding_map do valid(i) && get(c.heights, i) >= 6 && get(c.heights, i) <= 28 &&
      i % width() >= 39 && i % width() <= 51 && i / width() <= 19
    else valid(i) && i % width() >= 26 && i % width() <= 30 && i / width() >= 11 && i / width() <= 16 end
  end
  pfn coast_go(c : City, i : Int, d : Int) : Bool do
    if d >= 4 do false else
      let j = neighbour(i, d)
      (valid(j) && get(c.heights, j) == 0) || coast_go(c, i, d + 1)
    end
  end
  fn coastal(c : City, i : Int) : Bool do valid(i) && get(c.heights, i) > 0 && coast_go(c, i, 0) end
  fn fertile(c : City, i : Int) : Bool do get(c.heights, i) >= 5 && get(c.heights, i) <= 18 end
  pfn utility_can_be_off_road(kind : Int) : Bool do
    kind == 3 || kind == 8 || kind == 11 || kind == 12 || kind == 13 || kind == 33 || kind == 42
  end
  pfn facility_road_ready(c : City, roads : NativeIntArr, kind : Int, lot : Int) : Bool do
    utility_can_be_off_road(kind) || building_access(c, roads, lot) >= 0
  end
  pfn connected_count(c : City, a : NativeIntArr, kind : Int, i : Int, total : Int) : Int do
    if i >= count() do total
    else connected_count(c, a, kind, i + 1, total + (if get(c.plants, i) == kind && !building_offline(c, i) && building_access(c, a, i) >= 0 do 1 else 0 end)) end
  end
  fn power_plant(kind : Int) : Bool do
    kind == 1 || kind == 2 || (kind >= 12 && kind <= 15) || kind == 33 || kind == 42
  end
  fn generator_online(c : City, lot : Int) : Bool do
    surface_flood(c, lot) < 2 && !building_offline(c, lot) && !facility_paused(c, lot)
  end
  pfn utility_count(c : City, roads : NativeIntArr, pipes : NativeIntArr, kind : Int, i : Int, total : Int) : Int do
    if i >= count() do total else
      let active = get(c.plants, i) == kind && !building_offline(c, i) && (!power_plant(kind) || generator_online(c, i)) && (kind != 1 || managed_plant_ready(c, i)) && !facility_paused(c, i) && facility_road_ready(c, roads, kind, i) && distance(pipes, i) >= 0 &&
        ((kind != 3 && kind != 5) || remote_food_island(c, i) != 1)
      utility_count(c, roads, pipes, kind, i + 1, total + (if active do 1 else 0 end))
    end
  end
  pfn storefront_waste(c : City, i : Int) : Int do
    if get(c.buildings, i) == 0 || building_offline(c, i) || business_closed(c, i) do 0
    else if nightlife(c, i) do (if quiet_at(c, i) == 1 do 4 else 2 end)
    else if storefront(c, i) == 1 do 2 else 0 end end end
  end
  pfn extra_waste(c : City, i : Int, total : Int) : Int do
    if i == count() do total else extra_waste(c, i + 1, total + storefront_waste(c, i)) end
  end
  pfn reachable_trash(c : City, roads : NativeIntArr, i : Int, total : Int) : Int do
    if i >= count() do total else
      let amount = if building_access(c, roads, i) >= 0 do get(c.buildings, i) * 4 + storefront_waste(c, i) else 0 end
      reachable_trash(c, roads, i + 1, total + amount)
    end
  end
  pfn waste_on_grid(c : City, roads : NativeIntArr, grid : NativeIntArr) : Waste do
    if c.waste_live do
      { generated: get(c.waste_log, 0), collected: get(c.waste_log, 1), digested: get(c.waste_log, 2),
        buried: get(c.waste_log, 3), exported: get(c.waste_log, 4), dumped: get(c.waste_log, 5),
        burned: get(c.waste_log, 6), pending: c.trash }
    else
    let generated = load(c) + extra_waste(c, 0, 0)
    let pickup = 48 + 192 * connected_count(c, roads, 16, 0, 0)
    let reachable = reachable_trash(c, roads, 0, 0)
    let offered = clamp(reachable + c.trash, 0, pickup)
    let digested = clamp(offered, 0, 96 * utility_count(c, roads, grid, 15, 0, 0))
    let buried = clamp(offered - digested, 0, 48 + 256 * connected_count(c, roads, 17, 0, 0))
    let collected = digested + buried
    { generated: generated, collected: collected, digested: digested, buried: buried, exported: 0, dumped: 0, burned: 0, pending: c.trash + generated - collected }
    end
  end
  fn waste(c : City, roads : NativeIntArr) : Waste do waste_on_grid(c, roads, grid_access(c)) end
  pfn wind_generation(c : City, grid : NativeIntArr, i : Int, total : Int) : Int do
    if i == count() do total else
      let kind = get(c.plants, i)
      let power = if wind_turbine(kind) && generator_online(c, i) && distance(grid, i) >= 0 do
        let speed = (wind_at(c, i)).speed
        if kind == 33 do speed * 3 else 16 + speed * 2 end
      else 0 end
      wind_generation(c, grid, i + 1, total + power)
    end
  end
  pfn harbour_power(c : City, grid : NativeIntArr) : Int do
    if c.founding_map && valid(c.harbour) && get(grid, c.harbour) >= 0 && surface_flood(c, c.harbour) < 2 do 24 else 0 end
  end
  fn generation(c : City, roads : NativeIntArr) : Power do
    let grid = grid_access(c)
    let trash = waste_on_grid(c, roads, grid)
    let booked_gas = match c.freight do
      Some(route) -> if route.fuel > 0 && get(c.plants, route.plant) == 1 && generator_online(c, route.plant) &&
        distance(grid, route.plant) >= 0 && building_access(c, roads, route.plant) >= 0 do 1 else 0 end
      None -> 0
    end
    let gas_units = clamp(c.cash / 16, 0, utility_count(c, roads, grid, 1, 0, 0) - booked_gas)
    let nuclear_units = clamp((c.cash - gas_units * 16) / 40, 0, utility_count(c, roads, grid, 14, 0, 0))
    let solar_rate = solar_output(c)
    { gas: (gas_units + booked_gas) * 100 + harbour_power(c, grid), geothermal: 180 * utility_count(c, roads, grid, 2, 0, 0),
      wind: wind_generation(c, grid, 0, 0), solar: solar_rate * utility_count(c, roads, grid, 13, 0, 0),
      nuclear: nuclear_units * 360, biogas: if !c.waste_live do trash.digested
        else if utility_count(c, roads, grid, 15, 0, 0) > 0 do clamp(get(c.waste_log, 7) + get(c.waste_log, 8) + get(c.waste_log, 9), 0, 96) else 0 end end,
      cost: gas_units * 16 + nuclear_units * 40 }
  end
  fn power_total(p : Power) : Int do p.gas + p.geothermal + p.wind + p.solar + p.nuclear + p.biogas end
  fn supply(c : City, a : NativeIntArr) : Int do power_total(generation(c, a)) end
  fn land_pollution_at(c : City, i : Int) : Int do clamp(land_near(c, i, 0, get(c.land_pollution, i)) + get(c.air_pollution, i), 0, 100) end
  pfn land_near(c : City, i : Int, d : Int, total : Int) : Int do
    if d >= 4 do clamp(total, 0, 100)
    else land_near(c, i, d + 1, total + get(c.land_pollution, neighbour(i, d)) / 2) end
  end
  pfn update_land(c : City, roads : NativeIntArr, backlog : Int, a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= count() do a else
      let kind = get(c.plants, i)
      let active = building_access(c, roads, i) >= 0
      let industry = if get(c.zones, i) == 2 do get(c.buildings, i) else 0 end
      let litter = if c.waste_live do clamp(waste_overflow(c, i) / 3, 0, 25)
        else if get(c.buildings, i) > 0 && backlog > 0 do clamp(backlog / 32 + 1, 1, 10) else 0 end end
      let emissions = (if kind == 17 && active && (!c.waste_live || get(c.waste_sites, i) > 0) do 7 else 0 end) +
        (if active do
          let parking = get(c.public_parking, i)
          if parking == 1 do 9 else if parking == 2 do 2 else 0 end end
        else 0 end)
      let level = clamp(get(c.land_pollution, i) - 4 + industry + litter + emissions, 0, 100)
      update_land(c, roads, backlog, NativeArray.set_int(a, i, level), i + 1)
    end
  end
  pfn air_sources(c : City, roads : NativeIntArr, grid : NativeIntArr, traffic : NativeIntArr, i : Int, out : NativeIntArr) : NativeIntArr do
    if i == count() do out else
      let gas = get(c.plants, i) == 1 && generator_online(c, i) && c.cash >= 16 && distance(grid, i) >= 0 && building_access(c, roads, i) >= 0
      let exhaust = if motor_street(c, i) do clamp((road_load(traffic, i) - 14) / 3, 0, 20) else 0 end
      let level = clamp(get(c.air_pollution, i) - 5, 0, 100) + exhaust + (if gas do 32 else 0 end)
      air_sources(c, roads, grid, traffic, i + 1, NativeArray.set_int(out, i, level))
    end
  end
  pfn drift_air(field : NativeIntArr, west_east : Int, north_south : Int, x_share : Int, z_share : Int, i : Int, out : NativeIntArr) : NativeIntArr do
    if i == count() do out else
      let local = get(field, i) * (100 - x_share - z_share)
      let incoming = get(field, neighbour(i, west_east)) * x_share + get(field, neighbour(i, north_south)) * z_share
      drift_air(field, west_east, north_south, x_share, z_share, i + 1, NativeArray.set_int(out, i, clamp((local + incoming) / 100, 0, 100)))
    end
  end
  pfn update_air(c : City, roads : NativeIntArr, traffic : NativeIntArr) : NativeIntArr do
    let wind = regional_wind(c)
    let x = Math.cos(wind.heading)
    let z = Math.sin(wind.heading)
    let share = int_to_float(wind.speed) *. 1.5
    let field = air_sources(c, roads, grid_access(c), traffic, 0, NativeArray.make_int(count(), 0))
    drift_air(field, if x >= 0.0 do 0 else 1 end, if z >= 0.0 do 2 else 3 end,
      float_to_int(Math.abs(x) *. share), float_to_int(Math.abs(z) *. share), 0, NativeArray.make_int(count(), 0))
  end
  fn drift_pollution(c : City, traffic : NativeIntArr) : City do
    if !valid(c.harbour) do c else { c with air_pollution: update_air(c, access(c), traffic) } end
  end
  pfn coastal_plume(c : City, i : Int, j : Int, total : Int) : Int do
    if j >= count() do total else
      let distance = int_abs(i % width() - j % width()) + int_abs(i / width() - j / width())
      let nearby = if distance <= 8 do (get(c.pollution, j) + (if get(c.land_pollution, j) > 0 && coastal(c, j) do get(c.land_pollution, j) / 3 else 0 end)) * (9 - distance) / 9 else 0 end
      coastal_plume(c, i, j + 1, total + nearby)
    end
  end
  fn pollution_at(c : City, i : Int) : Int do clamp(coastal_plume(c, i, 0, 0), 0, 100) end
  pfn crop_yield(c : City, i : Int) : Int do
    let potential = if food_island(c, i) == 1 do 144 else 96 end
    let deity = favor_god(c)
    let blessing = if deity == 1 do 120 else if deity == 2 do 135 else 100 end end
    potential * clamp(c.soil_moisture * 2, 0, 100) * blessing / 10000
  end
  pfn catch_yield(c : City, i : Int) : Int do
    let blessing = if favor_god(c) == 4 do 135 else 100 end
    (if food_island(c, i) == 2 do 224 else 128 end) * (100 - pollution_at(c, i)) * blessing / 10000
  end
  pfn catch_total(c : City, roads : NativeIntArr, i : Int, total : Int) : Int do
    if i >= count() do total else
      let fish = if get(c.plants, i) == 6 && !building_offline(c, i) && !freight_producer(c, i) && building_access(c, roads, i) >= 0 && remote_food_island(c, i) == 0 do catch_yield(c, i) else 0 end
      catch_total(c, roads, i + 1, total + fish)
    end
  end
  fn water_total(r : Services) : Int do r.wells + r.rain + r.desal + r.recycled + r.imported_water end
  pfn island_utility_count(c : City, roads : NativeIntArr, pipes : NativeIntArr, kind : Int, i : Int, total : Int) : Int do
    if i >= count() do total else
      let active = get(c.plants, i) == kind && !building_offline(c, i) && remote_food_island(c, i) == 1 && facility_road_ready(c, roads, kind, i) && distance(pipes, i) >= 0
      island_utility_count(c, roads, pipes, kind, i + 1, total + (if active do 1 else 0 end))
    end
  end
  type UtilityDelivery = { flow : Ur.UtilitiesNetwork.Network, connections : NativeIntArr, demand : NativeIntArr, delivered : NativeIntArr, total : Int }
  type UtilityReport = { electric : UtilityDelivery, water : UtilityDelivery, sewer : UtilityDelivery,
    wells : Int, rain : Int, desal : Int, recycled : Int, imported : Int, treated : Int, discharged : Int, outlets : NativeIntArr,
    farms : Int, facility_power : Int, fresh_start : NativeIntArr, fresh_left : NativeIntArr, battery_out : Int, battery_capacity : Int, battery_stored : Int, operating : NativeIntArr }
  type UtilityLoads = { electric : NativeIntArr, water : NativeIntArr, sewer : NativeIntArr }
  type WaterSupply = { flow : Ur.UtilitiesNetwork.Network, wells : Int, rain : Int, desal : Int, recycled : Int }
  type SewerSupply = { flow : Ur.UtilitiesNetwork.Network, connections : NativeIntArr, delivered : NativeIntArr,
    recycled_at : NativeIntArr, outlets : NativeIntArr, treated : Int, discharged : Int }
  fn utility_upkeep(tier : Int) : Int do if tier == 2 do 6 else tier * 2 end end
  fn utility_upgrade(tool : Int) : Bool do tool == 97 || tool == 98 end
  fn utility_capacity(kind : Int, tier : Int) : Int do
    if tier == 0 do 0
    else if kind == 0 do (if tier == 2 do 384 else 128 end)
    else if kind == 1 do (if tier == 2 do 1536 else 640 end)
    else if tier == 2 do 1152 else 480 end end end end
  end
  pfn capacities(tiles : NativeIntArr, mode : Int, lot : Int, out : NativeIntArr) : NativeIntArr do
    if lot == count() do out else
      let tier = get(tiles, lot)
      let out = if tier == 0 do out else NativeArray.set_int(out, lot, utility_capacity(mode, tier)) end
      capacities(tiles, mode, lot + 1, out)
    end
  end
  pfn network(tiles : NativeIntArr, mode : Int) : Ur.UtilitiesNetwork.Network do
    Net.new(width(), count(), capacities(tiles, mode, 0, NativeArray.make_int(2640, 0)))
  end
  pfn utility_loads(c : City, people : Int, housing : Int, lot : Int, seen : Int, cooling : Int, loads : UtilityLoads) : UtilityLoads do
    if lot == count() do loads else
      let homes = occupied_homes(c, lot) * 4
      let next = seen + homes
      let water = if homes > 0 do next * people / housing - seen * people / housing else 0 end
      let sewer = if homes > 0 do (next * people / housing) * 3 / 4 - (seen * people / housing) * 3 / 4 else 0 end
      let floors = if building_offline(c, lot) do 0 else get(c.buildings, lot) end
      let loads = if floors == 0 do loads else { electric: NativeArray.set_int(loads.electric, lot, floors * (4 + cooling_load(c, lot, cooling))),
        water: NativeArray.set_int(loads.water, lot, water), sewer: NativeArray.set_int(loads.sewer, lot, sewer) } end
      utility_loads(c, people, housing, lot + 1, next, cooling, loads)
    end
  end
  pfn distribute_from(flow : Ur.UtilitiesNetwork.Network, demand : NativeIntArr, delivered : NativeIntArr, lot : Int, first_pass : Bool, total : Int, supply : Int) : (Ur.UtilitiesNetwork.Network, NativeIntArr, Int) do
    if lot == count() || supply == 0 do (flow, delivered, total) else
      let expected = get(demand, lot)
      let previous = get(delivered, lot)
      let want = if first_pass do (expected + 1) / 2 else expected - previous end
      if want <= 0 do distribute_from(flow, demand, delivered, lot + 1, first_pass, total, supply) else
        let (flow, given) = Net.draw(flow, lot, want)
        distribute_from(flow, demand, NativeArray.set_int(delivered, lot, previous + given), lot + 1, first_pass, total + given, supply - given)
      end
    end
  end
  pfn distribute(flow : Ur.UtilitiesNetwork.Network, demand : NativeIntArr, delivered : NativeIntArr, first_pass : Bool, total : Int) : (Ur.UtilitiesNetwork.Network, NativeIntArr, Int) do
    distribute_from(flow, demand, delivered, 0, first_pass, total, array_total(flow.source, 0, 0))
  end
  pfn allocate_utility(flow : Ur.UtilitiesNetwork.Network, demand : NativeIntArr, delivered : NativeIntArr, total : Int) : (Ur.UtilitiesNetwork.Network, NativeIntArr, Int) do
    let (flow, delivered, total) = distribute(flow, demand, delivered, true, total)
    distribute(flow, demand, delivered, false, total)
  end
  pfn utility_site(c : City, roads : NativeIntArr, reach : NativeIntArr, kind : Int, lot : Int) : Bool do
    !facility_paused(c, lot) && !building_offline(c, lot) && distance(reach, lot) >= 0 && facility_road_ready(c, roads, kind, lot)
  end
  doc "What generator [lot] of [kind] supplies now, drawing on what is left of the gas, nuclear and biogas pools."
  pfn source_units(c : City, roads : NativeIntArr, grid : NativeIntArr, lot : Int, kind : Int, gas : Int, nuclear : Int, biogas : Int) : Int do
    let generator = power_plant(kind) && generator_online(c, lot)
    if !generator || !managed_plant_ready(c, lot) || !utility_site(c, roads, grid, kind, lot) do 0 else
      match kind do
        1 -> clamp(gas, 0, 100)
        2 -> 180
        12 -> 16 + (wind_at(c, lot)).speed * 2
        13 -> solar_output(c)
        14 -> clamp(nuclear, 0, 360)
        15 -> biogas
        33 -> (wind_at(c, lot)).speed * 3
        _ -> 0
      end
    end
  end
  pfn electrical_sources(c : City, roads : NativeIntArr, grid : NativeIntArr, lot : Int, gas : Int, nuclear : Int, biogas : Int,
    out : Ur.UtilitiesNetwork.Network) : Ur.UtilitiesNetwork.Network do
    if lot == count() do out else
      let kind = get(c.plants, lot)
      let units = source_units(c, roads, grid, lot, kind, gas, nuclear, biogas)
      let out = if units > 0 do Net.add_source(out, Net.tap(out, lot, 0), units) else out end
      electrical_sources(c, roads, grid, lot + 1, gas - (if kind == 1 do units else 0 end),
        nuclear - (if kind == 14 do units else 0 end), biogas - (if kind == 15 do units else 0 end), out)
    end
  end
  doc "What generator [target] supplies now: the same sequential share-out the grid is built from."
  pfn plant_output_to(c : City, roads : NativeIntArr, grid : NativeIntArr, lot : Int, target : Int, gas : Int, nuclear : Int, biogas : Int) : Int do
    let kind = get(c.plants, lot)
    let units = source_units(c, roads, grid, lot, kind, gas, nuclear, biogas)
    if lot >= target do units else
      plant_output_to(c, roads, grid, lot + 1, target, gas - (if kind == 1 do units else 0 end),
        nuclear - (if kind == 14 do units else 0 end), biogas - (if kind == 15 do units else 0 end))
    end
  end
  -- Grid batteries (kind 42) bank spare generation and give it back when demand outruns supply.
  fn battery_energy() : Int do 960 end
  fn battery_rate() : Int do 80 end
  pfn battery_online(c : City, roads : NativeIntArr, grid : NativeIntArr, lot : Int) : Bool do
    get(c.plants, lot) == 42 && generator_online(c, lot) && utility_site(c, roads, grid, 42, lot)
  end
  pfn battery_units(c : City, roads : NativeIntArr, grid : NativeIntArr, lot : Int, total : Int) : Int do
    if lot >= count() do total else battery_units(c, roads, grid, lot + 1, total + (if battery_online(c, roads, grid, lot) do 1 else 0 end)) end
  end
  doc "How many grid batteries are connected and running."
  fn battery_count(c : City, roads : NativeIntArr) : Int do battery_units(c, roads, grid_access(c), 0, 0) end
  doc "Total energy the city's grid batteries can hold."
  fn battery_capacity(c : City, roads : NativeIntArr) : Int do battery_count(c, roads) * battery_energy() end
  doc "Most power the city's grid batteries can charge or discharge at once."
  fn battery_power(c : City, roads : NativeIntArr) : Int do battery_count(c, roads) * battery_rate() end
  pfn battery_sources(c : City, roads : NativeIntArr, grid : NativeIntArr, lot : Int, deficit : Int, stored : Int,
    out : Ur.UtilitiesNetwork.Network, total : Int) : (Ur.UtilitiesNetwork.Network, Int) do
    if lot >= count() || deficit <= 0 || stored <= 0 do (out, total) else
      let units = if battery_online(c, roads, grid, lot) do clamp(deficit, 0, clamp(stored, 0, battery_rate())) else 0 end
      let out = if units > 0 do Net.add_source(out, Net.tap(out, lot, 0), units) else out end
      battery_sources(c, roads, grid, lot + 1, deficit - units, stored - units, out, total + units)
    end
  end
  doc "What the connected facilities that run on grid power draw: wells, desalination, water recycling and import terminals."
  pfn facility_load(c : City, roads : NativeIntArr, pipes : NativeIntArr) : Int do
    utility_count(c, roads, pipes, 3, 0, 0) * 4 + utility_count(c, roads, pipes, 4, 0, 0) * 12 +
      utility_count(c, roads, pipes, 10, 0, 0) * 8 + utility_count(c, roads, pipes, 9, 0, 0) * 6
  end
  pfn facility_draw(c : City, roads : NativeIntArr, pipes : NativeIntArr, lot : Int, flow : Ur.UtilitiesNetwork.Network, operating : NativeIntArr, total : Int) : (Ur.UtilitiesNetwork.Network, NativeIntArr, Int) do
    if lot == count() do (flow, operating, total) else
      let kind = get(c.plants, lot)
      let demand = match kind do
        3 -> 4
        4 -> 12
        9 -> 6
        10 -> 8
        _ -> 0
      end
      if demand == 0 || !utility_site(c, roads, pipes, kind, lot) || (kind == 3 && remote_food_island(c, lot) == 1) do
        facility_draw(c, roads, pipes, lot + 1, flow, operating, total)
      else
        let (test, given) = Net.draw(flow, lot, demand)
        if given == demand do facility_draw(c, roads, pipes, lot + 1, test, NativeArray.set_int(operating, lot, 1), total + given)
        else facility_draw(c, roads, pipes, lot + 1, flow, operating, total) end
      end
    end
  end
  pfn sewer_plants(c : City, roads : NativeIntArr, pipes : NativeIntArr, active : NativeIntArr, mode : Int, lot : Int,
    flow : Ur.UtilitiesNetwork.Network, installed : Bool) : (Ur.UtilitiesNetwork.Network, Bool) do
    if lot == count() do (flow, installed) else
      let kind = get(c.plants, lot)
      let limit = if mode == 10 && kind == 10 && get(active, lot) > 0 do 160
        else if mode == 11 && kind == 11 && utility_site(c, roads, pipes, kind, lot) do 192 else 0 end end
      let flow = if limit > 0 do Net.add_source(flow, Net.tap(flow, lot, 0), limit) else flow end
      sewer_plants(c, roads, pipes, active, mode, lot + 1, flow, installed || kind == 10 || kind == 11)
    end
  end
  pfn merge_supply(a : NativeIntArr, b : NativeIntArr, lot : Int, out : NativeIntArr) : NativeIntArr do
    if lot == count() do out else
      let value = get(b, lot)
      merge_supply(a, b, lot + 1, if value > 0 do NativeArray.set_int(out, lot, get(a, lot) + value) else out end)
    end
  end
  pfn sewer_outlets(c : City, roads : NativeIntArr, pipes : NativeIntArr, flow : Ur.UtilitiesNetwork.Network, initial : NativeIntArr,
    lot : Int, taken : NativeIntArr, out : NativeIntArr, total : Int) : (NativeIntArr, Int) do
    if lot == count() do (out, total) else
      if get(c.plants, lot) != 11 || !utility_site(c, roads, pipes, 11, lot) do
        sewer_outlets(c, roads, pipes, flow, initial, lot + 1, taken, out, total)
      else
        let tap = Net.tap(flow, lot, 0)
        let before = get(taken, tap)
        let units = clamp(get(initial, tap) - Net.remaining(flow, tap) - before, 0, 192)
        sewer_outlets(c, roads, pipes, flow, initial, lot + 1, NativeArray.set_int(taken, tap, before + units),
          NativeArray.set_int(out, lot, units), total + units)
      end
    end
  end
  pfn sewage_flow(c : City, roads : NativeIntArr, pipes : NativeIntArr, demand : NativeIntArr, active : NativeIntArr, zero : NativeIntArr) : SewerSupply do
    let (plants, installed) = sewer_plants(c, roads, pipes, active, 10, 0, network(c.pipes, 2), false)
    let (treated, served, recovered) = allocate_utility(plants, demand, zero, 0)
    let spent = subtract_supply(plants.source, treated.source, 0, zero)
    let baseline = { treated with source: zero }
    let (outlets, _) = sewer_plants(c, roads, pipes, active, 11, 0, baseline, installed)
    -- The harbour handles starter sewage until municipal treatment is installed.
    let outlets = if !installed do Net.add_source(outlets, c.harbour, if c.founding_map do 48 else 12000 end) else outlets end
    let connections = Net.connected({ outlets with source: merge_supply(plants.source, outlets.source, 0, plants.source) })
    -- Treat all reachable sewage before sending the balance to the coast.
    let (drained, served, _) = distribute(outlets, demand, served, false, recovered)
    let (discharge, volume) = sewer_outlets(c, roads, pipes, drained, outlets.source, 0, zero, zero, 0)
    let drained = { drained with source: merge_supply(drained.source, treated.source, 0, drained.source) }
    { flow: drained, connections: connections, delivered: served, recycled_at: spent, outlets: discharge, treated: recovered, discharged: volume }
  end
  pfn subtract_supply(a : NativeIntArr, b : NativeIntArr, lot : Int, out : NativeIntArr) : NativeIntArr do
    if lot == count() do out else
      let used = get(a, lot) - get(b, lot)
      subtract_supply(a, b, lot + 1, if used > 0 do NativeArray.set_int(out, lot, used) else out end)
    end
  end
  fn collector_supply(c : City, lot : Int) : Int do clamp(get(c.rain_tanks, lot), 0, 96) end
  pfn water_sources(c : City, roads : NativeIntArr, pipes : NativeIntArr, active : NativeIntArr, treated : NativeIntArr, lot : Int,
    out : WaterSupply) : WaterSupply do
    if lot == count() do out else
      let kind = get(c.plants, lot)
      let available = (kind == 3 || kind == 4 || kind == 8) && utility_site(c, roads, pipes, kind, lot)
      let wells = if kind == 3 && available && get(active, lot) > 0 do 192 else 0 end
      let rain = if kind == 8 && available do collector_supply(c, lot) else 0 end
      let desal = if kind == 4 && available && get(active, lot) > 0 do 192 else 0 end
      let recycled = get(treated, lot) * 3 / 4
      let supply = wells + rain + desal
      let flow = if supply > 0 do Net.add_source(out.flow, Net.tap(out.flow, lot, 0), supply) else out.flow end
      let flow = if recycled > 0 do Net.add_source(flow, lot, recycled) else flow end
      water_sources(c, roads, pipes, active, treated, lot + 1, { flow: flow,
        wells: out.wells + wells, rain: out.rain + rain, desal: out.desal + desal, recycled: out.recycled + recycled })
    end
  end
  pfn water_imports(c : City, roads : NativeIntArr, pipes : NativeIntArr, active : NativeIntArr, lot : Int, cash : Int, flow : Ur.UtilitiesNetwork.Network) : Ur.UtilitiesNetwork.Network do
    if lot == count() || cash == 0 do flow else
      let units = if get(c.plants, lot) == 9 && utility_site(c, roads, pipes, 9, lot) && get(active, lot) > 0 do clamp(cash, 0, 160) else 0 end
      let flow = if units > 0 do Net.add_source(flow, Net.tap(flow, lot, 0), units) else flow end
      water_imports(c, roads, pipes, active, lot + 1, cash - units, flow)
    end
  end
  pfn irrigate(c : City, roads : NativeIntArr, pipes : NativeIntArr, lot : Int, flow : Ur.UtilitiesNetwork.Network, supplied : NativeIntArr, farms : Int) : (Ur.UtilitiesNetwork.Network, NativeIntArr, Int) do
    if lot == count() do (flow, supplied, farms) else
      if get(c.plants, lot) != 5 || get(supplied, lot) > 0 || !utility_site(c, roads, pipes, 5, lot) || remote_food_island(c, lot) != 0 do irrigate(c, roads, pipes, lot + 1, flow, supplied, farms)
      else
        let (test, given) = Net.draw(flow, lot, 24)
        if given == 24 do irrigate(c, roads, pipes, lot + 1, test, NativeArray.set_int(supplied, lot, 1), farms + 1)
        else irrigate(c, roads, pipes, lot + 1, flow, supplied, farms) end
      end
    end
  end
  pfn array_total(values : NativeIntArr, lot : Int, total : Int) : Int do
    if lot == count() do total else array_total(values, lot + 1, total + get(values, lot)) end
  end
  fn utility_report(c : City, roads : NativeIntArr, gen : Power, people : Int) : UtilityReport do
    let zero = NativeArray.make_int(2640, 0)
    let loads = utility_loads(c, people, sum(c, 0, 0, 0), 0, 0, temperature(c), { electric: zero, water: zero, sewer: zero })
    let grid = grid_access(c)
    let pipes = pipe_access(c)
    let bootstrap = harbour_power(c, grid)
    let electric = Net.add_source(network(c.grid, 0), c.harbour, bootstrap)
    let generated = electrical_sources(c, roads, grid, 0, gen.gas - bootstrap, gen.nuclear, gen.biogas, electric)
    let demanded = array_total(loads.electric, 0, 0) + facility_load(c, roads, pipes)
    let (source, battery_out) = battery_sources(c, roads, grid, 0, demanded - array_total(generated.source, 0, 0), c.battery, generated, 0)
    let grid_paths = Net.connected(source)
    let (electric, active, plant_power) = facility_draw(c, roads, pipes, 0, source, zero, 0)
    let (electric, powered, power_total) = allocate_utility(electric, loads.electric, zero, 0)
    let sanitation = sewage_flow(c, roads, pipes, loads.sewer, active, zero)
    let starter_water = if c.founding_map && valid(c.harbour) && get(pipes, c.harbour) >= 0 do 64 else 0 end
    let water = water_sources(c, roads, pipes, active, sanitation.recycled_at, 0,
      { flow: Net.add_source(network(c.pipes, 1), c.harbour, starter_water), wells: 0, rain: starter_water, desal: 0, recycled: 0 })
    let (local, wet, served) = allocate_utility(water.flow, loads.water, zero, 0)
    let imports = water_imports(c, roads, pipes, active, 0, clamp(c.cash - gen.cost, 0, 12000), { local with source: zero })
    let water_paths = Net.connected({ imports with source: merge_supply(water.flow.source, imports.source, 0, water.flow.source) })
    let (supplied, wet, delivered) = distribute(imports, loads.water, wet, false, served)
    let (local, farm_sites, farms) = irrigate(c, roads, pipes, 0, { supplied with source: local.source }, zero, 0)
    let (imported, _, farms_after) = irrigate(c, roads, pipes, 0, { local with source: supplied.source }, farm_sites, farms)
    let flow = { imported with source: merge_supply(local.source, imported.source, 0, local.source) }
    { electric: { flow: electric, connections: grid_paths, demand: loads.electric, delivered: powered, total: power_total },
      water: { flow: flow, connections: water_paths, demand: loads.water, delivered: wet, total: delivered },
      sewer: { flow: sanitation.flow, connections: sanitation.connections, demand: loads.sewer, delivered: sanitation.delivered,
        total: array_total(sanitation.delivered, 0, 0) },
      wells: water.wells, rain: water.rain, desal: water.desal, recycled: water.recycled,
      imported: delivered - served + (farms_after - farms) * 24, treated: sanitation.treated, discharged: sanitation.discharged,
      outlets: sanitation.outlets, farms: farms_after, facility_power: plant_power, fresh_start: water.flow.source, fresh_left: local.source, battery_out: battery_out, battery_capacity: battery_capacity(c, roads), battery_stored: c.battery, operating: active }
  end
  pfn services_with(c : City, a : NativeIntArr, people : Int, power : Power, utilities : UtilityReport) : Services do
    let food_people = people - managed_residents(c, people)
    let imported_water = utilities.imported
    let operating_farms = utilities.farms
    let island_farms = if c.founding_map && c.expansion.island > 0 do
      let irrigation = farm_water(c)
      let available = 8 * island_utility_count(c, a, irrigation, 3, 0, 0)
      clamp(island_utility_count(c, a, irrigation, 5, 0, 0), 0, available)
    else 0 end
    let local_farms = crop_yield(c, c.harbour) * operating_farms
    let local_fish = catch_total(c, a, 0, 0)
    let farms = local_farms + c.island_crops
    let fish = local_fish + c.island_catch
    let trade = 160 + 192 * connected_count(c, a, 7, 0, 0)
    let available_cash = clamp(c.cash - power.cost - imported_water, 0, trade)
    let trading = valid(c.harbour) && get(a, c.harbour) >= 0
    let import_capacity = trade * 100 / (100 + c.import_rate)
    let imports = if trading do clamp(food_people - farms - fish, 0, clamp(available_cash * 400 / (100 + c.import_rate), 0, import_capacity)) else 0 end
    let farm_exports = if trading do clamp(local_farms + local_fish - food_people, 0, clamp(local_farms, 0, (trade - imports) * 100 / (100 + c.export_rate))) else 0 end
    let sewage = people * 3 / 4
    { geothermal: power.geothermal, wells: utilities.wells, rain: utilities.rain, desal: utilities.desal,
      recycled: utilities.recycled, imported_water: imported_water, farms: farms, fish: fish, imports: imports, farm_exports: farm_exports,
      wastewater: sewage, discharged: utilities.discharged, untreated: clamp(sewage - utilities.sewer.total, 0, sewage),
      fish_revenue: local_fish / 4, operating_farms: operating_farms, island_farms: island_farms,
      treatment_power: utilities.facility_power, water_used: people + operating_farms * 24, food_used: food_people }
  end
  fn services(c : City, roads : NativeIntArr, people : Int) : Services do
    let gen = generation(c, roads)
    services_with(c, roads, people, gen, utility_report(c, roads, gen, population(c)))
  end
  pfn startup_zones(c : City, roads : NativeIntArr, grid : NativeIntArr, pipes : NativeIntArr, i : Int, homes : Bool, jobs : Bool) : Bool do
    if homes && jobs do true else if i == count() do false else
      let zone = get(c.zones, i)
      let served = zone > 0 && building_access(c, roads, i) >= 0 && distance(grid, i) >= 0 && distance(pipes, i) >= 0
      startup_zones(c, roads, grid, pipes, i + 1, homes || (served && (zone == 1 || zone == 3)),
        jobs || (served && (zone == 2 || zone == 3)))
    end end
  end
  pfn startup_step(c : City, roads : NativeIntArr, water : Services, power : Int, used : Int, people : Int, work : Int) : Int do
    if !c.founding_map do 0
    else if !valid(c.harbour) do 1
    else
      let street = frontage_distance(c, roads, c.harbour, 0, -1)
      if street < 0 do 2
      else if power <= 24 do 3
      else
        let pipes = pipe_access(c)
        let added_water = water.wells + water.desal + water.recycled > 0 ||
          utility_count(c, roads, pipes, 8, 0, 0) > 0 || utility_count(c, roads, pipes, 9, 0, 0) > 0
        if !added_water do 4
        else
          let sewer = utility_count(c, roads, pipes, 11, 0, 0) > 0 ||
            (power - used + water.treatment_power >= 8 && utility_count(c, roads, pipes, 10, 0, 0) > 0)
          if !sewer do 5
          else if !startup_zones(c, roads, grid_access(c), pipes, 0, false, false) do 6
          else if people == 0 || work == 0 do 7
          else 0 end end end
        end
      end end
    end end
  end
  pfn update_pollution(c : City, outlets : NativeIntArr, field : NativeIntArr, i : Int) : NativeIntArr do
    if i >= count() do field else
      let release = get(outlets, i)
      let level = clamp(get(c.pollution, i) - 3 + (release + 3) / 4, 0, 100)
      update_pollution(c, outlets, NativeArray.set_int(field, i, level), i + 1)
    end
  end
  pfn backed_up_sewage(report : UtilityDelivery, land : NativeIntArr, lot : Int) : NativeIntArr do
    if lot == count() do land else
      let unserved = get(report.demand, lot) - get(report.delivered, lot)
      let land = if unserved > 0 do NativeArray.set_int(land, lot, clamp(get(land, lot) + (unserved + 3) / 4, 0, 100))
        else land end
      backed_up_sewage(report, land, lot + 1)
    end
  end
