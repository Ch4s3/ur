      _ -> "Facility"
    end
  end
  fn facility_kind(tool : Int) : Int do
    if tool == 116 do 44
    else if tool == 114 do 43
    else if tool == 108 do 42
    else if tool >= 103 && tool <= 107 do tool - 66
    else if tool >= 93 && tool <= 95 do tool - 59
    else if tool >= 79 && tool <= 86 do tool - 53
    else if tool == 76 || tool == 77 do tool - 53
    else if tool == 62 do 22
    else if tool >= 44 && tool <= 47 do tool - 26
    else if tool >= 20 && tool <= 25 do tool - 8
    else if tool == 4 do 1
    else if tool >= 8 && tool <= 17 do tool - 6 else 0 end end end end end end end end end end end end
  end
  pfn open_sea_edges(c : City, lot : Int, d : Int) : Bool do
    if d == 4 do true else
      let peer = neighbour(lot, d)
      valid(peer) && get(c.heights, peer) == 0 && open_sea_edges(c, lot, d + 1)
    end
  end
  pfn unsuitable(c : City, i : Int, kind : Int) : String do
    if kind == 33 && (get(c.heights, i) > 0 || !open_sea_edges(c, i, 0) || get(c.transit, i) > 0 || get(c.grade_cover, i) > 0) do
      "Place offshore wind in open water, clear of crossings and transit."
    else if kind == 36 && population(c) < 500 && get(c.milestones, 55) == 0 do
      "Incineration requires 500 residents."
    else if kind >= 34 && kind <= 36 && !valid(fleet_frontage(c, i, 0)) do "Connect the waste facility to a local street or avenue."
    else if (kind == 23 || kind == 24) && !valid(fleet_frontage(c, i, 0)) do "Build beside a local street or avenue."
    else if kind == 2 && !geothermal(c, i) do "Geothermal stations need a volcanic field."
    else if kind == 3 && !freshwater(c, i) do "No local freshwater aquifer. Try desalination."
    else if (kind == 4 || kind == 6 || kind == 9 || kind == 11 || kind == 34 || kind == 35) && !coastal(c, i) do "This facility needs a shoreline parcel."
    else if kind == 5 && !fertile(c, i) do "Farms need low, cultivable ground."
    else "" end end end end end end end end
  end
  fn policy(c : City, tax_delta : Int, energy_delta : Int) : City do
    { c with tax: clamp(c.tax + tax_delta, 0, 25), energy: clamp(c.energy + energy_delta, 1, 12) }
  end
  fn adjust_policy(c : City, row : Int, delta : Int) : City do
    match row do
      0 -> policy(c, delta, 0)
      1 -> { c with business_rate: clamp(c.business_rate + delta, 0, 25) }
      2 -> { c with import_rate: clamp(c.import_rate + delta * 5, 0, 50) }
      10 -> { c with economy: { c.economy with property_rate: clamp(c.economy.property_rate + delta, 0, 40) } }
      3 -> { c with export_rate: clamp(c.export_rate + delta * 5, 0, 50) }
      5 -> { c with ground_rule: clamp(c.ground_rule + delta, 1, 3) }
      7 | 8 | 9 -> { c with immigration: row - 7 }
      6 -> { c with quiet_rule: clamp(c.quiet_rule + delta, 1, 3) }
      _ -> policy(c, 0, delta)
    end
  end
