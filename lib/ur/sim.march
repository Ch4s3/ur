-- Parcel simulation: money and quantities use integers for deterministic ticks.
mod Ur.Sim do
  alias Ur.Demography as D
  alias Ur.UtilitiesNetwork as Net
  type Shipment = { source : Int, stops : List(Int), legs : Int, units : Int }
  type Expansion = { island : Int, invested : Int, recovered : Int, exports : Int, net : Int }
  type FinanceMonth = { month : Int, revenue : Int, expenditures : Int, budget : Budget, construction : Int, property_receipts : Int, debt_service : Int }
  type ParkWalk = { steps : NativeIntArr, next : NativeIntArr }
  type MedicalTransfer = { facility : Int, bed : Int, transport : Int, wait : Int, stay : Int, outcome : Int, route : List(Int) }
  type Incident = { lot : Int, kind : Int, reported : Int, station : Int, response : Int, travel : Int, road : List(Int), spread : List(Int), medical : Option(MedicalTransfer) }
  type CrimeMonth = { month : Int, calls : List(Incident) }
  type CrimeReport = { incidents : Int, responses : Int, minutes : Int, harm : Int }
  type WasteRun = { depot : Int, pickup : Int, site : Int, kind : Int, units : Int, route : List(Int), pickup_leg : Int }
  type DivineEffect = { god : Int, until_day : Int, site : Int }
  type Religion = {
    patron : Int, chosen : Int, unlocked : Int, festival_policy : Int, offering_policy : Int,
    offering_year : Int, offering_spend : Int, petition_day : Int, rolls : Int,
    dedication_target : Int, dedication_end : Int,
    favor : DivineEffect, curse : DivineEffect, curse_stamp : Int, epicenter : Int, wrath_god : Int,
    festival_stamp : Int, festival_hosts : Int, festival_attendees : Int, festival_site : Int,
    festival_feedback : NativeIntArr, festival_absence : NativeIntArr, festival_attending : NativeIntArr
  }
  type FestivalSummary = { hosts : Int, attendees : Int, food : Int, trash : Int, sites : List(Int) }
  type FestivalHost = { lot : Int, tier : Int, walk : ParkWalk, reachable : Int }
  type FestivalAttendance = { sites : NativeIntArr, households : NativeIntArr, people : Int }
  type FestivalPlan = { sites : List(FestivalHost), attendance : FestivalAttendance, summary : FestivalSummary }
  type ShelterDemand = { from_home : NativeIntArr, at_shelter : NativeIntArr, commute_from : NativeIntArr }
  type Households = { addresses : Map(Int, List(Int)), next : Int }
  type City = {
    households : Households, utility_service : NativeIntArr, milestones : NativeIntArr, facility_staff : NativeIntArr, facility_expansion : NativeIntArr,
    shelter_demand : Option(ShelterDemand),
    census : NativeIntArr, population_history : List(NativeIntArr), immigration : Int,
    council : NativeIntArr, religion : Religion,
    climate_seed : Int, world_seed : Int, setup : NativeIntArr, founders : Int,
    rain_uniform : Bool, watch : Int, rain_now : NativeIntArr,
    storm_drains : NativeIntArr, seawalls : NativeIntArr,
    -- seabed edits a parcel (Ur.Ocean): 0 none, 1..63 dredged to that many voxels deep, 64 + d a reef whose top is d voxels down
    seabed : NativeIntArr,
    -- today's sea: the significant wave height in centimetres at each water parcel, measured each day (Ur.Sea.daily_seas); 0 on land
    sea_heights : NativeIntArr,
    -- per ferry terminal: bit 1 a larger ferry, bit 2 a protected harbour; bits 4-8 the route's status at the last day roll (0 running, 1 slowed, 2 suspended)
    ferry_works : NativeIntArr,
    -- the Sea storms level today's sea is counted at: the setting as it stood at the last day roll, so a change takes effect from the next day
    sea_counted : Int,
    pump_orders : NativeIntArr, surface_water : NativeIntArr, flood_damage : NativeIntArr, flood_active : Bool,
    rain_tanks : NativeIntArr, subway_water : NativeIntArr, soil_moisture : Int, pumping_cost : Int,
    calendar_day : Int, clock_ms : Int, street_day : Int, car_free_days : NativeIntArr,
    ground_rule : Int, quiet_rule : Int, ground_areas : NativeIntArr, quiet_areas : NativeIntArr, storefronts : NativeIntArr, footfall : NativeIntArr,
    fire_recovery : NativeIntArr,
    crime_history : List(CrimeMonth), livability_history : List(NativeIntArr),
    grades : NativeIntArr, grade_cover : NativeIntArr, parks : NativeIntArr, park_tiers : NativeIntArr, streetscape : NativeIntArr, sidewalk_items : NativeIntArr,
    campus : NativeIntArr, education : NativeIntArr, specializations : NativeIntArr, business_sector : NativeIntArr,
    empty_homes : NativeIntArr, home_arrivals : NativeIntArr, neighborhood_rents : NativeIntArr,
    housing_search : NativeIntArr, newcomer_grace : NativeIntArr,
    market_history : List(NativeIntArr), rent_pressure : NativeIntArr, business_age : NativeIntArr,
    property_status : NativeIntArr, property_arrears : NativeIntArr, property_sales : Int,
    finance_history : List(FinanceMonth), construction_spend : Int, economy : Economy,
    expansion : Expansion, island_spend : NativeIntArr, island_exports : Int, island_crops : Int, island_catch : Int,
    freight : Option(Ur.FreightNetwork.Route), shop_stock : NativeIntArr, shop_sales : NativeIntArr, shop_delivered : NativeIntArr, shop_imports : Int, shipments : List(Shipment),
    harbour : Int, founding_map : Bool, heights : NativeIntArr, roads : NativeIntArr, tolls : NativeIntArr, public_parking : NativeIntArr, transit : NativeIntArr, stops : NativeIntArr, ferries : NativeIntArr, ferry_start : Int, service : NativeIntArr, bus_headways : NativeIntArr, bus_fare : Int, zones : NativeIntArr,
    density : NativeIntArr, nuisance : NativeIntArr, buildings : NativeIntArr, housing_losses : NativeIntArr, business_losses : NativeIntArr, construction : NativeIntArr, plants : NativeIntArr, paused_facilities : NativeIntArr,
    pipes : NativeIntArr, grid : NativeIntArr, pollution : NativeIntArr, land_pollution : NativeIntArr, air_pollution : NativeIntArr, trash : Int,
    waste_live : Bool, waste_bins : NativeIntArr, waste_stock : NativeIntArr, waste_sites : NativeIntArr,
    waste_last : NativeIntArr, waste_log : NativeIntArr, waste_runs : List(WasteRun),
    cash : Int, month : Int, tax : Int, business_rate : Int, import_rate : Int, export_rate : Int, energy : Int, income : Int, message : String
  }
  -- Borrowing: kind 0 loan, 1 bond, 2 emergency overdraft. `rate` is tenths of a
  -- percent a year, `months` the instalments left, `resident` the part of a bond
  -- residents hold.
  type Debt = { id : Int, kind : Int, principal : Int, rate : Int, months : Int, resident : Int }
  -- A listed company. Prices are in cents and `history` is newest first.
  type Stock = { id : Int, lot : Int, sector : Int, shares : Int, price : Int, earnings : Int, dividend : Int, history : List(Int), listed : Int, delisted : Int }
  -- The index is scaled by 100; sentiment and volatility are tenths of a percent.
  type MarketState = { index : Int, sentiment : Int, volatility : Int, history : List(Int), base : Int, next_id : Int }
  type Economy = {
    land_value : NativeIntArr, property_rate : Int,
    savings : NativeIntArr, wealth_history : List(Int),
    funding : NativeIntArr,
    debts : List(Debt), next_debt : Int, arrears : Int, missed : List(Int), administrator : Int, insolvent : Bool,
    debt_history : List(NativeIntArr), bond_size : Int, resident_arrears : Int,
    stocks : List(Stock), listed_lots : NativeIntArr, market : MarketState, listing_incentive : Bool, listed_tax_break : Int, profit_streak : NativeIntArr
  }
  fn default_property_rate() : Int do 10 end
  fn new_market() : MarketState do { index: 10000, sentiment: 0, volatility: 40, history: Nil, base: 0, next_id: 1 } end
  fn new_economy() : Economy do
    { land_value: NativeArray.make_int(count(), 0), property_rate: default_property_rate(),
      savings: NativeArray.make_int(count(), 0), wealth_history: Nil,
      funding: NativeArray.make_int(6, 100),
      debts: Nil, next_debt: 1, arrears: 0, missed: Nil, administrator: -1, insolvent: false,
      debt_history: Nil, bond_size: 50000, resident_arrears: 0,
      stocks: Nil, listed_lots: NativeArray.make_int(count(), 0), market: new_market(), listing_incentive: false, listed_tax_break: 0, profit_streak: NativeArray.make_int(count(), 0) }
  end
  type Waste = { generated : Int, collected : Int, digested : Int, buried : Int, exported : Int, dumped : Int, burned : Int, pending : Int }
  type Power = { gas : Int, geothermal : Int, wind : Int, solar : Int, nuclear : Int, biogas : Int, cost : Int }
  type Services = { rain : Int, recycled : Int, imported_water : Int, wastewater : Int, discharged : Int, untreated : Int, fish_revenue : Int, treatment_power : Int, operating_farms : Int, island_farms : Int, geothermal : Int, wells : Int, desal : Int, farms : Int, fish : Int, imports : Int, farm_exports : Int, water_used : Int, food_used : Int }
  fn ground_name(rule : Int) : String do
    if rule == 1 do "Housing or offices" else if rule == 3 do "Require storefronts" else "Allow storefronts" end end
  end
  fn quiet_name(rule : Int) : String do
    if rule == 2 do "Ends at 10 pm" else if rule == 3 do "No nightlife" else "Ends at 2 am" end end
  end
  fn ground_at(c : City, i : Int) : Int do
    let rule = get(c.ground_areas, i)
    if rule == 0 do c.ground_rule else rule end
  end
  fn quiet_at(c : City, i : Int) : Int do
    let rule = get(c.quiet_areas, i)
    if rule == 0 do c.quiet_rule else rule end
  end
  fn area_policy_tool(tool : Int) : Bool do tool >= 63 && tool <= 70 end
  -- A mixed-use parcel whose ground floor is a light-industrial workshop.
  fn live_work(c : City, i : Int) : Bool do
    get(c.zones, i) == 3 && get(c.business_sector, i) == 1 && ground_at(c, i) != 1
  end
  fn storefront(c : City, i : Int) : Int do
    let business = get(c.storefronts, i)
    if ground_at(c, i) == 1 || live_work(c, i) do 0
    else if business == 2 && quiet_at(c, i) == 3 do 1 else business end end
  end
  fn commercial_ground(c : City, i : Int) : Bool do
    storefront(c, i) > 0 || (get(c.zones, i) == 3 && ground_at(c, i) != 1)
  end
  type BuildingUse = Apartments | Workplace | Grocery | Restaurant | GroceryHomes | RestaurantHomes | Bar | BarHomes | EmptyShop | WorkshopHomes | Vacant
  fn building_use(c : City, i : Int) : BuildingUse do
    let zone = get(c.zones, i)
    let business = storefront(c, i)
    let homes = (zone == 1 || zone == 3) && get(c.buildings, i) > 1
    if get(c.buildings, i) == 0 do Vacant
    else if ground_at(c, i) == 1 do
      if zone == 2 || zone == 4 do Workplace else if zone > 0 do Apartments else Vacant end end
    else if live_work(c, i) do WorkshopHomes
    else if business == 1 do (if homes do GroceryHomes else Grocery end)
    else if business == 2 do (if homes do BarHomes else Bar end)
    else if business == 3 do EmptyShop
    else
      match zone do
        1 -> Apartments
        2 -> match (i % width() + i / width()) % 3 do
          0 -> Grocery
          1 -> Restaurant
          _ -> Workplace
        end
        3 -> if i % 2 == 0 do GroceryHomes else RestaurantHomes end
        4 -> Workplace
        _ -> Vacant
      end
    end end end end end end
  end
  fn nightlife(c : City, i : Int) : Bool do
    get(c.buildings, i) > 0 && storefront(c, i) == 2 && !building_offline(c, i) && !business_closed(c, i)
  end
  fn public_trade(c : City, i : Int) : Bool do retail(c, i) > 0 || nightlife(c, i) end
  fn retail(c : City, i : Int) : Int do
    if building_offline(c, i) || business_closed(c, i) do 0 else retail_kind(c, i) end
  end
  fn retail_kind(c : City, i : Int) : Int do
    match building_use(c, i) do
      Grocery | GroceryHomes -> 1
      Restaurant | RestaurantHomes -> 2
      _ -> 0
    end
  end
  fn building_name(c : City, i : Int) : String do
    match building_use(c, i) do
      Apartments -> "Apartments"
      Workplace -> if get(c.zones, i) == 4 do
        match get(c.business_sector, i) do
          1 -> "Food processor"
          2 -> "Manufacturer"
          _ -> "Workshop"
        end
      else "Workplace" end
      Grocery -> "Grocery store"
      Restaurant -> "Restaurant"
      GroceryHomes -> if get(c.buildings, i) == 1 do "Grocery store" else "Grocery + apartments" end
      RestaurantHomes -> if get(c.buildings, i) == 1 do "Restaurant" else "Restaurant + apartments" end
      Bar -> "Bar"
      BarHomes -> "Bar + apartments"
      EmptyShop -> "Vacant storefront"
      WorkshopHomes -> if get(c.buildings, i) == 1 do "Workshop" else "Workshop + apartments" end
      Vacant -> if get(c.plants, i) > 0 do facility_name(get(c.plants, i)) else "" end
    end
  end
  type Accounts = { earnings : Int, rent : Int, tax : Int, costs : Int }
  fn margin(a : Accounts) : Int do a.earnings - a.rent - a.tax - a.costs end
  type Labor = { workforce : Int, employed : Int, unemployed : Int, vacancies : Int, wages : Int, local_income : Option(NativeIntArr), fares : Option(NativeIntArr) }
  pfn labor_with_fares(labor : Labor, fares : NativeIntArr) : Labor do { labor with fares: Some(fares) } end
  type Budget = { revenue : Int, property_tax : Int, income_tax : Int, business_tax : Int, trade_income : Int, tariffs : Int, toll_income : Int, parking_income : Int, bus_fares : Int, bus_operations : Int, freight_operations : Int, infrastructure : Int, operations : Int, energy_income : Int, power_cost : Int, food_cost : Int, water_cost : Int, sanitation_cost : Int }
  type Stats = { startup_step : Int, founders : Int, staffed_jobs : NativeIntArr, job_matches : List(JobMatch), buses : BusNetwork, school_seats : NativeIntArr, skill_jobs : NativeIntArr, market : NativeIntArr, rent_tiers : NativeIntArr, park_walk : ParkWalk, worship : NativeIntArr, understaffed_shrines : Int, festival : FestivalSummary, civic : NativeIntArr, riders : NativeIntArr, running_transit : NativeIntArr, labor : Labor, traffic : NativeIntArr, junctions : NativeIntArr, budget : Budget, growth_pressure : String, commutes : NativeIntArr, generation : Power, waste : Waste, services : Services, utilities : UtilityReport, project_capacity : UtilityReservation, people : Int, work : Int, used : Int, power : Int, routes : NativeIntArr }
  type Development = Unzoned | Full | Market | NeedsSchoolOrClinic | NeedsCivicServices | Restricted | NoRoad | Flooded | Dirty | NoPower | NoPowerLine | PowerBottleneck | NoFood | NoWater | NoWaterLine | WaterBottleneck | NoSewer | SewerBottleneck | HighTax | HighEnergy | Remote | PoorJobAccess | NoJobs | NoWorkers | Unaffordable | Unprofitable | Ready
  fn stats(c : City) : Stats do
    let routes = access(c)
    let people = population(c)
    let work = jobs(c)
    let gen = generation(c, routes)
    let networks = utility_report(c, routes, gen, people)
    let utilities = services_with(c, routes, people, gen, networks)
    let forecast = if c.founding_map && valid(c.harbour) do deliver_food(c, routes, utilities) else c end
    let utilities = if c.founding_map && valid(c.harbour) do services_with(forecast, routes, people, gen, networks) else utilities end
    let reservations = reserve_utilities(c, routes, networks)
    let collection = waste(c, routes)
    let used = array_total(networks.electric.demand, 0, 0) + utilities.treatment_power
    let power = power_total(gen)
    let (reserved_people, reserved_power) = construction_demand(c, routes, 0, people, used)
    let pressure = if reserved_power + 4 > power do "Growth needs more power"
      else if water_total(utilities) < reserved_people + 16 do "Growth needs more water"
      else if !food_room(c, routes, reserved_people, networks, gen) do "Growth needs more food"
      else "Capacity for another housing lot" end end end
    let running = transit_service(c, power)
    let transport = transport_report_with(c, routes, running, people, work)
    let operating = operating_city(c, transport.buses)
    let traffic = transport.traffic
    let riders = transport.riders
    let hiring = transport.hiring
    let labor = labor_with_fares(hiring.labor, transport.buses.fares)
    let profit_tax = business_receipts(forecast, routes, hiring, people, work)
    let commutes = economic_commutes(operating, traffic, running, transport.buses)
    { startup_step: startup_step(c, routes, utilities, power, used, people, work), founders: c.founders, staffed_jobs: hiring.filled, job_matches: hiring.matches, buses: transport.buses, school_seats: school_seats(c, routes, 0, NativeArray.make_int(4, 0)), skill_jobs: skill_jobs(c, routes, 0, NativeArray.make_int(9, 0)), market: market_sample(c, routes, commutes, labor, people, work, 0, 0), rent_tiers: rent_tier_counts(c, routes, 0, NativeArray.make_int(10, 0)), park_walk: park_walk(c), worship: worship_field(c, routes, hiring.filled, 0, NativeArray.make_int(count(), 0)),
      understaffed_shrines: count_understaffed_shrines(c, routes, hiring.filled, 0, 0),
      festival: (plan_festivals(c, routes, hiring.filled)).summary, civic: civic_access_with(c, routes), riders: riders, running_transit: running, labor: labor, traffic: traffic, junctions: junction_controls(c, traffic, 0, NativeArray.make_int(count(), 0)), commutes: commutes, generation: gen, waste: collection, people: people, work: work,
      used: used, power: power, routes: routes, services: utilities, utilities: networks, project_capacity: reservations, growth_pressure: pressure,
      budget: budget(forecast, traffic, people, labor, profit_tax, networks.electric.total, power, utilities, collection, gen.cost, transport.buses.lines) }
  end
  pfn is_ready(s : Development) : Bool do
    match s do
      Ready -> true
      _ -> false
    end
  end
  pfn status_text(s : Development) : String do
    match s do
      Unzoned -> "Unzoned land"
      Market -> "More demand or better access needed for taller buildings"
      NeedsSchoolOrClinic -> "Add a school or clinic for a second floor"
      NeedsCivicServices -> "A third floor needs all four civic services"
      Restricted -> "Current use exceeds the parcel nuisance limit"
      Full -> "At permitted density"
      NoRoad -> "No road connection to the harbour"
      Flooded -> "Surface flooding · Construction waits for water to recede"
      Dirty -> "High local pollution blocks housing growth"
      NoPower -> "No spare generation for this parcel"
      NoPowerLine -> "This zone needs a connected power line"
      PowerBottleneck -> "Power bottleneck · Upgrade or bypass the feeder"
      NoWaterLine -> "This zone needs a connected water pipe"
      WaterBottleneck -> "Water bottleneck · Upgrade or bypass the pipe"
      NoSewer -> "No sewage collection capacity · Connect an operating outlet"
      SewerBottleneck -> "Sewage bottleneck · Upgrade or bypass the pipe"
      NoFood -> "Food supply cannot support more homes"
      NoWater -> "Add freshwater capacity before building homes"
      HighTax -> "Taxes make development unprofitable"
      HighEnergy -> "Energy is too expensive"
      Remote -> "Transport costs are too high"
      PoorJobAccess -> "Too few jobs within a 36-minute commute"
      NoJobs -> "Waiting for more jobs"
      Unaffordable -> "Households cannot afford the rent and commute"
      Unprofitable -> "Expected sales do not cover business costs"
      NoWorkers -> "Waiting for workers and customers"
      Ready -> "Ready for private development"
    end
  end
  fn width() : Int do 60 end
  fn depth() : Int do 44 end
  fn count() : Int do width() * depth() end
  -- The islands are laid out on a 60 x 44 design grid (the original map); a larger map scales
  -- the same layout up, so each island grows with it. On a 60 x 44 map these are the identity.
  fn design_x(x : Int) : Int do x * 60 / width() end
  fn design_z(z : Int) : Int do z * 44 / depth() end
  -- How many times the original 60 x 44 map the larger side is (1.0 there), for camera ranges.
  fn map_scale() : Float do
    let sx = int_to_float(width()) /. 60.0
    let sz = int_to_float(depth()) /. 44.0
    if sx > sz do sx else sz end
  end
  -- The map's extent in metres (8 a lot), the overview camera's centre and zoom, and the
  -- furthest zoom out.
  fn map_metres_x() : Float do int_to_float(width() * 8) end
  fn map_metres_z() : Float do int_to_float(depth() * 8) end
  fn overview_x() : Float do map_metres_x() *. 0.4875 end
  fn overview_z() : Float do map_metres_z() *. 0.5 end
  fn overview_zoom() : Float do 345.0 *. map_scale() end
  fn max_zoom() : Float do 380.0 *. map_scale() end
  fn index(x : Int, z : Int) : Int do z * width() + x end
  fn valid(i : Int) : Bool do i >= 0 && i < count() end
  fn clamp(v : Int, lo : Int, hi : Int) : Int do if v < lo do lo else if v > hi do hi else v end end end
  fn get(a : NativeIntArr, i : Int) : Int do if valid(i) do NativeArray.get_int(a, i) else 0 end end
  fn neighbour(i : Int, d : Int) : Int do
    if d == 0 do (if i % width() > 0 do i - 1 else -1 end)
    else if d == 1 do (if i % width() < width() - 1 do i + 1 else -1 end)
    else if d == 2 do (if i >= width() do i - width() else -1 end)
    else if i < count() - width() do i + width() else -1 end end end end
  end
  fn terrain(x : Int, z : Int) : Int do
    let a = 100 - (x - 12) * (x - 12) - (z - 14) * (z - 14)
    let b = 30 - (x - 28) * (x - 28) - (z - 13) * (z - 13)
    -- a mountain about 42 m high, on the same footprint as the old 22 m hill
    let hill = clamp((70 - (x - 10) * (x - 10) * 3 - (z - 9) * (z - 9) * 2) * 23 / 10, 0, 161)
    if a > 0 do 4 + a / 10 + hill else if b > 0 do 4 + b / 3 else 0 end end
  end
  pfn farm_contour(x : Int, z : Int) : Int do
    66 - (x - 46) * (x - 46) - 2 * (z - 32) * (z - 32)
  end
  pfn shoal_contour(x : Int, z : Int) : Int do
    21 - (x - 55) * (x - 55) - (z - 23) * (z - 23)
  end
  pfn main_profile(x : Float, z : Float, mountains : Int, phase : Float) : (Int, Int, Int) do
    let dx = x -. 20.0
    let dz = z -. 22.0
    let main = float_to_int(900.0 -. 3.0 *. dx *. dx -. 4.0 *. dz *. dz)
    let hx = x -. 15.0
    let hz = z -. 13.0
    -- the island's mountain, about 43 m at its peak at the usual setting, steep enough to stay clear of the coast
    let hill = clamp(float_to_int(160.0 -. 4.0 *. hx *. hx -. 5.0 *. hz *. hz), 0, 160) * (if phase < 0.0 do 100 else 40 + clamp(mountains, 0, 4) * 30 end) / 100
    let hx2 = x -. (24.0 +. 2.0 *. Math.sin(phase))
    let hz2 = z -. (16.0 +. 2.0 *. Math.cos(phase))
    let ridge1 = clamp(float_to_int(66.0 -. 1.3 *. hx2 *. hx2 -. 2.2 *. hz2 *. hz2), 0, 66)
    let hx3 = x -. (16.0 +. 2.0 *. Math.cos(phase))
    let hz3 = z -. (27.0 +. 2.0 *. Math.sin(phase))
    let ridge2 = clamp(float_to_int(58.0 -. 2.0 *. hx3 *. hx3 -. 1.2 *. hz3 *. hz3), 0, 58)
    let hx4 = x -. (27.0 +. 1.5 *. Math.sin(phase *. 1.7))
    let hz4 = z -. (28.0 +. 1.5 *. Math.cos(phase *. 1.3))
    let ridge3 = clamp(float_to_int(48.0 -. 1.5 *. hx4 *. hx4 -. 1.8 *. hz4 *. hz4), 0, 48)
    let highland = hill + (if phase < 0.0 do 0 else (ridge1 + ridge2 + ridge3) * clamp(mountains, 0, 4) / 4 end)
    -- terrain draws up to 48 m: keep the peaks under it
    let highland = clamp(highland, 0, 168)
    if main > 0 do (4 + main / 100 + highland, main, 130) else (0, 0, 0) end
  end
  pfn outer_profile(x : Int, z : Int) : (Int, Int, Int) do
    let volcano = 49 - (x - 45) * (x - 45) - (z - 13) * (z - 13)
    let farms = farm_contour(x, z)
    let shoals = shoal_contour(x, z)
    if volcano > 0 do (4 + volcano * volcano / 28, volcano, 12)
    else if farms > 0 do (5 + farms / 13, farms, 14)
    else if shoals > 0 do (4 + shoals / 5, shoals, 8)
    else (0, 0, 0) end end end
  end
  -- The seed can create expansive satellite islands as well as smaller ones.
  pfn outer_scale(seed : Int, kind : Int) : Float do
    0.85 +. Strata.Seed.unit(Strata.Seed.mix(seed, 80 + kind)) *. 0.80
  end
  pfn outer_coordinates(seed : Int, x : Int, z : Int, kind : Int) : (Int, Int) do
    let cx = if kind == 1 do 45 else if kind == 2 do 46 else 53 end end
    let cz = if kind == 1 do 13 else if kind == 2 do 32 else 23 end end
    let template_x = if kind == 3 do 55 else cx end
    let scale = if kind == 3 do 0.80 +. Strata.Seed.unit(Strata.Seed.mix(seed, 83)) *. 0.32 else outer_scale(seed, kind) end
    (template_x + float_to_int(int_to_float(x - cx) /. scale), cz + float_to_int(int_to_float(z - cz) /. scale))
  end
  pfn seeded_outer(seed : Int, x : Int, z : Int) : (Int, Int, Int, Int) do
    let (vx, vz) = outer_coordinates(seed, x, z, 1)
    let (fx, fz) = outer_coordinates(seed, x, z, 2)
    let (sx, sz) = outer_coordinates(seed, x, z, 3)
    let volcanic = 49 - (vx - 45) * (vx - 45) - (vz - 13) * (vz - 13)
    let farms = farm_contour(fx, fz)
    let shoals = shoal_contour(sx, sz)
    let dv = (x - 45) * (x - 45) + (z - 13) * (z - 13)
    let df = (x - 46) * (x - 46) + (z - 32) * (z - 32)
    let ds = (x - 53) * (x - 53) + (z - 23) * (z - 23)
    let channel = (int_abs(dv - df) < 35 && dv < ds && df < ds) ||
      (int_abs(dv - ds) < 35 && dv < df && ds < df) ||
      (int_abs(df - ds) < 35 && df < dv && ds < dv)
    if x >= 59 || z >= 43 || channel do (0, 0, 0, 0)
    else if volcanic > 0 && dv < df && dv < ds do (4 + volcanic * volcanic / 28, volcanic, 12, 1)
    else if farms > 0 && df < dv && df < ds do (5 + farms / 13, farms, 14, 2)
    else if shoals > 0 && ds < dv && ds < df do (4 + shoals / 5, shoals, 8, 3)
    else (0, 0, 0, 0) end end end end
  end
  fn archipelago(x : Int, z : Int) : Int do
    let (main, _, _) = main_profile(int_to_float(x), int_to_float(z), 2, 0.0 -. 1.0)
    let (outer, _, _) = outer_profile(x, z)
    if main > 0 do main else outer end
  end
  pfn archipelago_fill(a : NativeIntArr, i : Int) : NativeIntArr do
    if i >= count() do a
    else archipelago_fill(NativeArray.set_int(a, i, archipelago(design_x(i % width()), design_z(i / width()))), i + 1) end
  end
  -- Size, island count, climate, founding group and resource abundance.
  fn default_setup() : NativeIntArr do
    -- 0 island size, 1 islands, 2 temperature, 3 founders, 4 mountains, 5 rainfall, 6 resources, 7 sea storms (0 calm .. 4 harsh)
    let a = NativeArray.make_int(8, 2)
    NativeArray.set_int(NativeArray.set_int(a, 1, 4), 3, 24)
  end
  type IslandShape = { breadth : Float, length : Float, bend : Float, inlet : Float, river : Bool, drift : Float }
  pfn island_shape(seed : Int) : IslandShape do
    { breadth: 0.83 +. 0.24 *. Strata.Seed.unit(Strata.Seed.mix(seed, 3)),
      length: 0.86 +. 0.29 *. Strata.Seed.unit(Strata.Seed.mix(seed, 4)),
      bend: (Strata.Seed.unit(Strata.Seed.mix(seed, 5)) -. 0.5) *. 5.0,
      inlet: Strata.Seed.unit(Strata.Seed.mix(seed, 6)) *. 6.2831853,
      river: seed % 3 == 0, drift: (Strata.Seed.unit(Strata.Seed.mix(seed, 7)) -. 0.5) *. 0.64 }
  end
  pfn river_column(shape : IslandShape, z : Int) : Int do
    let run = int_to_float(z - 18)
    let wave = Math.sin(run *. 0.22 +. shape.inlet) -. Math.sin(shape.inlet)
    float_to_int(20.5 -. 5.0 *. shape.breadth +. run *. shape.drift +. wave *. 2.8)
  end
  pfn varied_islands(seed : Int, shape : IslandShape, islands : Int, mountains : Int, shore : NativeF32Arr, relief : NativeF32Arr, heights : NativeIntArr, i : Int) : NativeIntArr do
    if i == count() do heights else
      let x = design_x(i % width())
      let z = design_z(i / width())
      let along = int_to_float(z - 22)
      let bend = shape.bend *. Math.sin(along *. 0.15)
      let dx = int_to_float(x - 20) -. bend
      let angle = Math.atan2(along, dx)
      let outline = 1.0 +. 0.18 *. Math.sin(3.0 *. angle +. shape.inlet) +.
        0.10 *. Math.sin(5.0 *. angle -. shape.inlet *. 1.7)
      let (outside, outer_margin, outer_band, outer_kind) = seeded_outer(seed, x, z)
      let (base, margin, band) = if x < 35 do
        main_profile(20.0 +. dx /. (shape.breadth *. outline),
          22.0 +. along /. (shape.length *. outline), mountains, shape.inlet)
      else if x < 38 || outer_kind == 0 || outer_kind >= islands do (0, 0, 0)
      else (outside, outer_margin, outer_band) end end
      let base = if x >= 38 && outer_kind == 1 && base > 4 do
        4 + (base - 4) * (40 + clamp(mountains, 0, 4) * 30) / 100
      else if x >= 38 && outer_kind >= 2 && base > 0 do
        let (hx, hz) = outer_coordinates(seed, x, z, outer_kind)
        let cx = if outer_kind == 2 do 48 else 56 end
        let cz = if outer_kind == 2 do 31 else 22 end
        let ridge = clamp(44 - 2 * (hx - cx) * (hx - cx) - (hz - cz) * (hz - cz), 0, 44)
        base + ridge * clamp(mountains, 0, 4) / 4
      else base end end
      let bite = (NativeArray.get_f32(shore, i) +. 0.3) *. int_to_float(band)
      let height = if base == 0 || int_to_float(margin) <= bite do 0 else
        let delta = clamp(float_to_int(NativeArray.get_f32(relief, i) *. 7.0), -4, 4)
        clamp(base + delta, 4, if base <= 18 do 18 else 176 end)
      end
      let height = if shape.river && x < 38 && z >= 18 do
        let bank = int_abs(x - river_column(shape, z))
        let previous = if z == 18 do bank else int_abs(x - river_column(shape, z - 1)) end
        if bank == 0 || previous == 0 do 0 else if bank == 1 || previous == 1 do clamp(height, 0, 9) else height end end
      else height end
      varied_islands(seed, shape, islands, mountains, shore, relief, NativeArray.set_int(heights, i, height), i + 1)
    end
  end
  fn unclaimed_seeded(seed : Int) : City do unclaimed_setup(seed, default_setup()) end
  fn unclaimed_setup(seed : Int, setup : NativeIntArr) : City do
    let recipe = Strata.Noise.settings(0, 3, 2.0, 0.5, 1, 0.0)
    let shore = NativeArray.make_f32(count(), 0.0)
    let relief = NativeArray.make_f32(count(), 0.0)
    let shore_count = Strata.Noise.field2(recipe, Strata.Seed.mix(seed, 1), 0.018, 4.0, 4.0, 8.0, width(), depth(), shore)
    let relief_count = Strata.Noise.field2(recipe, Strata.Seed.mix(seed, 2), 0.009, 4.0, 4.0, 8.0, width(), depth(), relief)
    let base_shape = island_shape(seed)
    let scale = 0.82 +. int_to_float(clamp(get(setup, 0), 0, 4)) *. 0.09
    let shape = { base_shape with breadth: base_shape.breadth *. scale, length: base_shape.length *. scale }
    let city = if shore_count != count() || relief_count != count() do unclaimed()
    else unclaimed_with_heights(varied_islands(seed, shape, clamp(get(setup, 1), 1, 4), get(setup, 6), shore, relief, NativeArray.make_int(count(), 0), 0)) end
    { city with world_seed: seed, setup: setup, climate_seed: Strata.Seed.mix(seed, 705) % 2147483646 + 1 }
  end
  pfn new_expansion() : Expansion do
    { island: 0, invested: 0, recovered: 0, exports: 0, net: 0 }
  end
  -- The two destination islands with a regional food specialty.
  fn food_island(c : City, i : Int) : Int do
    if !c.founding_map || !valid(i) || get(c.heights, i) == 0 do 0 else
      let x = design_x(i % width())
      let z = design_z(i / width())
      if c.world_seed >= 0 do
        let (_, _, _, kind) = seeded_outer(c.world_seed, x, z)
        if x < 38 do 0 else if kind == 2 do 1 else if kind == 3 do 2 else 0 end end end
      else if farm_contour(x, z) > 0 do 1
      else if shoal_contour(x, z) > 0 do 2 else 0 end end end
    end
  end
  pfn remote_food_island(c : City, i : Int) : Int do
    let island = food_island(c, i)
    if island == food_island(c, c.harbour) do 0 else island end
  end
  fn unclaimed() : City do
    unclaimed_with_heights(archipelago_fill(NativeArray.make_int(count(), 0), 0))
  end
