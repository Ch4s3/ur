      20 -> "Fire station"
      21 -> "Police station"
      22 -> "Hospital"
      23 -> "Bus depot"
      24 -> "Warehouse"
      25 -> "Upgraded fire station"
      37 -> "Shrine"
      38 -> "Temple"
      39 -> "Large Temple"
      40 -> "Grand Temple"
      41 -> "Seminary"
