  pfn layer_icon(layer : Int) : String do
    match layer do
      35 -> "road_tunnel"
      23 | 26 -> "jobs"
      24 -> "housing"
      25 | 27 -> "road"
      28 -> "school"
      29 -> "wind"
      32 -> "park"
      33 -> "outfall"
      34 -> "shrine"
      36 -> "housing"
      37 -> "jobs"
      38 -> "rain"
      39 | 41 -> "fish"
      40 -> "farm"
      30 -> "waste"
      31 -> "outfall"
      12 | 13 -> "park"
      14 -> "road"
      15 -> "school"
      16 | 19 -> "police"
      20 | 22 -> "fire"
      21 -> "clinic"
      17 -> "jobs"
      18 -> "survey"
