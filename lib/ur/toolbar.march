mod Ur.Toolbar do
  needs IO.Foreign
  needs Window
  alias Strata.Ui as U
  alias Strata.Text as T
  alias Ur.UiTheme as Theme
  import Ur.UiTheme.{label, fitted, centred}
  alias Ur.Sim as S

  type Layout = { x : Float, y : Float, width : Float, columns : Int, cell : Float, cards_y : Float,
    card_height : Float, tab_columns : Int, tab_step : Float }
  type Menu = { span : Int, pages : List(String), items : List(Int) }
  pfn menu(group : Int, page : Int) : Menu do
    match group do
      1 ->
        let items = if page == 4 do [127, 128, 129, 133, 130, 131, 132]
          else if page == 3 do [99, 100, 101] else if page == 2 do Cons(71, Cons(72, Cons(73, Cons(74, Cons(75, Nil)))))
          else if page == 1 do [124, 125, 126, 156, 50, 51, 52, 54]
          else Cons(1, Cons(48, Cons(49, Cons(33, Cons(40, Nil))))) end end end end
        { span: if page == 1 do 8 else 7 end, pages: ["Streets", "Crossings", "Car-free days", "Flood protection", "Canals"], items: items }
      2 ->
        let items = match page do
          2 -> Cons(64, Cons(65, Cons(66, Cons(63, Nil))))
          3 -> Cons(68, Cons(69, Cons(70, Cons(67, Nil))))
          1 -> Cons(29, Cons(30, Cons(31, Cons(32, Nil))))
          _ -> [2, 3, 28, 117, 5]
        end
        { span: 5, pages: Cons("Land use", Cons("Nuisance", Cons("Ground floors", Cons("Quiet hours", Nil)))), items: items }
      3 ->
        let items = match page do
          1 -> Cons(35, Cons(42, Nil))
          2 -> Cons(36, Cons(43, Nil))
          3 -> [37, 122, 123]
          4 -> Cons(39, Cons(38, Nil))
          5 -> [87, 88, 89, 90]
          6 -> [134, 135, 136]
          _ -> Cons(34, Cons(41, Cons(76, Nil)))
        end
        { span: 4, pages: ["Bus", "Tram", "Subway", "Ferry", "Manage", "Parking", "Water Bus"], items: items }
      4 ->
        let items = match page do
          1 -> [18, 19, 9, 10, 14, 15, 16, 17]
          2 -> [11, 154, 13, 77, 151, 152, 153]
          3 -> [91, 92, 24, 25, 93, 94, 95, 96, 61]
          4 -> [86, 26, 27]
          5 -> [97, 98, 111]
          _ -> [26, 27, 4, 8, 20, 21, 22, 23, 150]
        end
        { span: 9, pages: ["Power", "Water", "Food", "Waste", "Offshore", "Upgrades"], items: items }
      5 ->
        let items = match page do
          1 -> Cons(53, Cons(55, Nil))
          2 -> Cons(56, Cons(57, Cons(58, Cons(59, Cons(60, Cons(61, Nil))))))
          3 -> Cons(44, Cons(79, Cons(80, Cons(81, Nil))))
          4 -> [82, 83, 84, 85, 107]
          5 -> [103, 104, 105, 106]
          6 -> [108]
          7 -> [109, 110, 112, 113, 115]
          8 -> [114, 116]
          _ -> Cons(44, Cons(45, Cons(62, Cons(46, Cons(47, Cons(78, Nil))))))
        end
        { span: 6, pages: ["Services", "Parks", "Street planting", "Education", "Faculties", "Worship", "Disaster", "Expansions", "Community"], items: items }
      6 -> { span: 7, pages: Nil, items: [6, 7, 118, 119, 120, 121, 155] }
      7 ->
        let items = match page do
          1 -> [5, 6, 7, 8, 39, 40, 41]
          2 -> [4, 29, 30, 32, 33, 38]
          5 -> [25, 26, 34]
          7 -> [11, 35]
          6 -> Cons(27, Cons(23, Cons(24, Cons(28, Cons(36, Cons(37, Nil))))))
          4 -> Cons(19, Cons(20, Cons(21, Cons(22, Nil))))
          3 -> Cons(12, Cons(13, Cons(14, Cons(15, Cons(16, Cons(17, Cons(18, Cons(19, Nil))))))))
          _ -> [0, 1, 2, 3, 9, 10, 11, 31]
        end
        { span: 8, pages: ["Networks", "Resources", "Environment", "Livability", "Emergencies", "Neighborhoods", "Street policies", "Crossings"], items: items }
      _ -> { span: 1, pages: Nil, items: Nil }
    end
  end
  fn shortcut_group(tool : Int) : Int do
    match tool do
      1 -> 1
      2 | 3 | 5 -> 2
      4 -> 4
      6 | 7 -> 6
      _ -> 0
    end
  end
