mod Ur.Landscape do
  alias Ur.Sim as S
  alias Ur.Architecture as A
  alias Ur.Industry as Industry
  alias Ur.RoadSurface as RoadSurface
  alias Ur.QuayArt as QuayArt
  pfn road_axis(c : Ur.Sim.City, lot : Int) : Int do
    if !S.valid(lot) || S.get(c.heights, lot) == 0 || S.get(c.roads, lot) == 0 ||
      S.get(c.road_shapes, lot) != 0 || S.valid(S.grade_peer(c, lot)) do -1 else
      let east = S.street_link(c, lot, 0) || S.street_link(c, lot, 1)
      let north = S.street_link(c, lot, 2) || S.street_link(c, lot, 3)
      if east && !north do 0 else if north && !east do 2 else -1 end end
    end
  end
  pfn grade_neighbor(c : Ur.Sim.City, lot : Int, arm : Int, axis : Int, height : Int) : Int do
    let peer = S.neighbour(lot, arm)
    let target = S.get(c.heights, peer)
    if int_abs(target - height) <= 6 && road_axis(c, peer) == axis do target else height end
  end
  fn road_profile(c : Ur.Sim.City, lot : Int) : (Int, Int, Int) do
    let axis = road_axis(c, lot)
    let h = S.get(c.heights, lot)
    if axis < 0 || S.get(c.quays, lot) > 0 do (-1, h, h) else
      let before = grade_neighbor(c, lot, axis, axis, h)
      let after = grade_neighbor(c, lot, axis + 1, axis, h)
      (if before == h && after == h do -1 else axis end, before, after)
    end
  end
  pfn graded_height(h : Int, before : Int, after : Int, at : Int) : Int do
    let step = int_abs(at - 16)
    let peer = if at < 16 do before else after end
    (h * (32 - step) + peer * step + 16) / 32
  end

  fn sidewalk_height(c : Ur.Sim.City, lot : Int, x : Int, z : Int) : Int do
    let h = S.get(c.heights, lot)
    let (axis, before, after) = road_profile(c, lot)
    let along = if axis == 0 do x else z end
    (if axis < 0 || RoadSurface.uses_curve(c, lot) do h else graded_height(h, before, after, along / 4 * 4 + 2) end) + 2
  end

  pfn portal_crossed_by_street(c : Ur.Sim.City, lot : Int, peer : Int) : Bool do
    let inward = S.direction(lot, peer)
    let across = if inward < 2 do 2 else 0 end
    S.street_link(c, lot, inward) || (S.street_link(c, lot, across) && S.street_link(c, lot, across + 1))
  end
  pfn portal_strip(lot : Int, peer : Int, x : Int, z : Int) : (Int, Int) do
    let x = int_mod_euclid(x, 32)
    let z = int_mod_euclid(z, 32)
    match S.direction(lot, peer) do
      0 -> (16 - x, z)
      1 -> (x - 16, z)
      2 -> (16 - z, x)
      _ -> (z - 16, x)
    end
  end
  pfn portal_floor(c : Ur.Sim.City, lot : Int, peer : Int, inward : Int) : Int do
    let progress = int_to_float(inward) /. int_to_float(S.span_distance(lot, peer) * 32)
    float_to_int(Math.floor(S.grade_surface(c, lot, peer, progress)))
  end
  pfn near_bank(side : Int, x : Int, z : Int, reach : Int) : Bool do
    match side do
      0 -> x < reach
      1 -> x >= 32 - reach
      2 -> z < reach
      _ -> z >= 32 - reach
    end
  end
  pfn quay_water_edge(c : Ur.Sim.City, lot : Int, x : Int, z : Int) : Bool do
    (x < 12 && S.quay_bank(c, lot, 0)) || (x >= 20 && S.quay_bank(c, lot, 1)) ||
      (z < 12 && S.quay_bank(c, lot, 2)) || (z >= 20 && S.quay_bank(c, lot, 3))
  end
  fn ground_height(c : Ur.Sim.City, x : Int, z : Int) : Int do
    let px = int_div_euclid(x, 32)
    let pz = int_div_euclid(z, 32)
    if px < 0 || pz < 0 || px >= S.width() || pz >= S.depth() do 0 else
      let i = S.index(px, pz)
      let h = S.get(c.heights, i)
      let other = S.grade_peer(c, i)
      let portal = S.grade_kind(c, i) == 3 && S.valid(other) && i != other
      let (inward, across) = if portal do portal_strip(i, other, x, z) else (-1, -1) end
      let portal_cut = inward > 0 && across >= 4 && across < 28 &&
        !portal_crossed_by_street(c, i, other) && !S.mountain_tunnel(c, i, other)
      let grade = S.grade_source(c, i)
      let cross_axis = if S.valid(grade) && grade / S.width() == S.grade_peer(c, grade) / S.width() do int_mod_euclid(z, 32)
        else int_mod_euclid(x, 32) end
      let cut = S.valid(grade) && S.grade_kind(c, grade) == 2 && S.get(c.roads, i) == 0 &&
        S.get(c.buildings, i) == 0 && S.get(c.plants, i) == 0 && S.get(c.construction, i) == 0 && cross_axis >= 10 && cross_axis < 22
      let (axis, before, after) = road_profile(c, i)
      if S.canal_water(c, i) do
        if S.canal_wet(c, i, int_mod_euclid(x, 32), int_mod_euclid(z, 32)) do S.canal_level(c, i) - S.canal_depth()
        else S.canal_bank_height(c, i) end
      else if S.get(c.quays, i) > 0 do
        -- The retaining wall occupies the outer four voxels of the parcel.
        let side = S.quay_side(c, i)
        if side >= 0 && near_bank(side, int_mod_euclid(x, 32), int_mod_euclid(z, 32), 4) do 0 else h end
      else if portal_cut do S.clamp(portal_floor(c, i, other, S.clamp(inward + 2, 0, 16)) - 1, 0, h)
      else if axis >= 0 do
        let along = int_mod_euclid(if axis == 0 do x else z end, 32)
        graded_height(h, before, after, along / 4 * 4 + 2)
      else if cut do h - 8
      else if S.public_work_stage(c, i) > 0 || S.valid(S.campus_root(c, i)) || S.building_offline(c, i) || S.get(c.parks, i) > 0 || (S.get(c.roads, i) > 0 && h > 0) || S.get(c.buildings, i) > 0 || S.get(c.construction, i) > 0 || S.get(c.plants, i) > 0 ||
        (h > 0 && (S.get(c.transit, i) == 3 || S.get(c.stops, i) == 4)) do h
      else
        let ground = S.unbuilt_ground_height(c, x, z)
        if h == 0 && ground > 0 do
          let lx = int_mod_euclid(x, 32)
          let lz = int_mod_euclid(z, 32)
          if quay_water_edge(c, i, lx, lz) || S.canal_approach_cell(S.canal_approach_mask(c, i), lx, lz, 32) do 0 else ground end
        else ground end
      end end end end end end
    end
  end
  fn height(c : Ur.Sim.City, x : Int, z : Int) : Int do
    ground_height(c, int_div_euclid(x, 4) * 4 + 2, int_div_euclid(z, 4) * 4 + 2)
  end
  fn top_material(x : Int, z : Int, h : Int) : Int do
    let variation = int_mod_euclid(x * 29 + z * 47 + (x / 17) * (z / 11), 17)
    if h <= 6 do 16
    else if h >= 68 do (if variation < 5 do 24 else 23 end)
    else if h >= 40 do (if variation < 6 do 2 else 23 end)
    else if variation < 4 do 22
    else if variation < 8 do 25
    else 0 end end end end end
  end
  fn side_material(h : Int) : Int do if h > 28 do 2 else if h <= 5 do 16 else 1 end end end
  fn volcanic_ash_material() : Int do 54 end
  fn volcanic_scoria_material() : Int do 55 end
  fn volcanic_rock_material() : Int do 56 end

  fn slope(h : Int, west : Int, east : Int, north : Int, south : Int) : Int do
    let low = Math.min_int(Math.min_int(west, east), Math.min_int(north, south))
    let high = Math.max_int(Math.max_int(west, east), Math.max_int(north, south))
    Math.max_int(h - low, high - h)
  end

  fn volcanic_cover(x : Int, z : Int, h : Int, grade : Int) : Int do
    let u = int_to_float(x) *. 0.25
    let v = int_to_float(z) *. 0.25
    let patch = Math.sin(u *. 0.12 +. Math.sin(v *. 0.16) *. 1.7) +.
      Math.sin(v *. 0.19 -. u *. 0.09) *. 0.7
    let exposed = h + grade * 6 + float_to_int(patch *. 19.0)
    if h < 42 do top_material(x, z, h)
    else if exposed < 96 do (if patch < 0.15 do 21 else 25 end)
    else if patch > 0.55 do volcanic_scoria_material()
    else if exposed >= 140 || grade >= 8 do volcanic_rock_material()
    else volcanic_ash_material() end end end end
  end
  pfn crosswalk(n : Int, deck : Int, side : Int, width : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if n >= width / 2 do out else
      let offset = 17 - width + n * 4
      let edge = if side % 2 == 0 do 2 else 27 end
      let stripe = if side < 2 do A.piece(edge, deck, offset, 3, 1, 2, 8)
        else A.piece(offset, deck, edge, 2, 1, 3, 8) end
      crosswalk(n + 1, deck, side, width, Cons(stripe, cut_road_pieces(out, stripe)))
    end
  end
  -- Quarter-circle centre line at radius 16. Each scanline merges equal
  -- material into runs so the curve costs far fewer quads than solid voxels.
  pfn curve_material(kind : Int, x : Int, z : Int) : Int do
    let d = x * 2 + 1
    let e = z * 2 + 1
    let squared = d * d + e * e
    let width = S.road_half_width(kind) * 2
    let inner = 32 - width
    let outer = 32 + width
    let walk = S.sidewalk_width(kind) * 2
    if squared < (inner - walk) * (inner - walk) || squared >= (outer + walk) * (outer + walk) do -1
    else if squared < inner * inner || squared >= outer * outer do
      if squared >= (inner - 2) * (inner - 2) && squared < (outer + 2) * (outer + 2) do 23 else 24 end
    else if kind == 3 do (if squared >= 30 * 30 && squared < 34 * 34 do 17 else 16 end)
    else if kind == 2 && squared >= 30 * 30 && squared < 34 * 34 do 10
    else if kind == 2 && ((squared >= 17 * 17 && squared < 19 * 19) ||
      (squared >= 45 * 45 && squared < 47 * 47)) && int_mod_euclid(x - z + 3, 12) < 6 do 8
    else if kind == 1 && squared >= 31 * 31 && squared < 33 * 33 && int_mod_euclid(x - z + 3, 12) < 6 do 8
    else 4 end end end end end end
  end
  pfn curve_row(kind : Int, deck : Int, horizontal : Int, vertical : Int, x : Int, z : Int, start : Int, material : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let next = if x < 32 do curve_material(kind, x, z) else -2 end
    let changed = next != material
    let out = if !changed || material < 0 || start == x do out else
      let px = if horizontal == 0 do start else 32 - x end
      let pz = if vertical == 2 do z else 31 - z end
      Cons(A.piece(px, deck, pz, x - start, if material == 23 || material == 24 do 2 else 1 end, 1, material), out)
    end
    if x >= 32 do out else curve_row(kind, deck, horizontal, vertical, x + 1, z, if changed do x else start end, next, out) end
  end
  pfn curve(kind : Int, deck : Int, horizontal : Int, vertical : Int, z : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if z >= 32 do out else curve(kind, deck, horizontal, vertical, z + 1, curve_row(kind, deck, horizontal, vertical, 0, z, 0, -1, out)) end
  end
  type StreetArms = { west : Bool, east : Bool, north : Bool, south : Bool }
  pfn shaped_surface(c : Ur.Sim.City, i : Int) : Bool do
    S.get(c.heights, i) > 0 && i != c.harbour && !S.valid(S.grade_peer(c, i)) && S.get(c.transit, i) != 3
  end
  pfn street_area(arms : StreetArms, width : Int, radius : Int, x : Int, z : Int) : Bool do
    let horizontal = if x < 0 do arms.west else arms.east end
    let vertical = if z < 0 do arms.north else arms.south end
    let dx = int_abs(x)
    let dz = int_abs(z)
    let corner_x = width + 4 - dx
    let corner_z = width + 4 - dz
    (horizontal && dz < width) || (vertical && dx < width) || x * x + z * z < radius * radius ||
    (horizontal && vertical && corner_x > 0 && corner_z > 0 && corner_x * corner_x + corner_z * corner_z > 16)
  end
  pfn street_surface(kind : Int, arms : StreetArms, width : Int, radius : Int, bulb : Bool, x : Int, z : Int) : Int do
    if !street_area(arms, width, radius, x, z) do
      let walk = S.sidewalk_width(kind) * 2
      if street_area(arms, width + 2, radius + 2, x, z) do 23
      else if street_area(arms, width + walk, radius + (if bulb do 3 else walk end), x, z) do 24 else -1 end end
    else
      -- Stop the dividing line at the throat so the whole bulb is usable.
      let lead = (x < -22 && arms.west) || (x > 22 && arms.east)
      let across = (z < -22 && arms.north) || (z > 22 && arms.south)
      let divider = (lead && (z == -1 || (kind != 1 && z == 1))) ||
        (across && (x == -1 || (kind != 1 && x == 1)))
      if bulb && divider do
        if kind == 3 do 17 else if kind == 2 do 10 else 8 end end
      else if kind == 3 do 16 else 4 end end
    end
  end
  pfn street_surface_row(kind : Int, arms : StreetArms, width : Int, radius : Int, bulb : Bool, deck : Int,
    x : Int, z : Int, start : Int, material : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let next = if x < 32 do street_surface(kind, arms, width, radius, bulb, x * 2 - 31, z * 2 - 31) else -1 end
    let changed = next != material
    let out = if changed && material >= 0 do
      Cons(A.piece(start, deck, z, x - start, if material == 23 || material == 24 do 2 else 1 end, 1, material), out)
    else out end
    if x == 32 do out else
      street_surface_row(kind, arms, width, radius, bulb, deck, x + 1, z, if changed do x else start end, next, out)
    end
  end
  pfn shaped_street(kind : Int, arms : StreetArms, bulb : Bool, deck : Int) : List(Ur.Architecture.Piece) do
    let width = S.road_half_width(kind) * 2
    let radius = if bulb && kind < 3 do 28 else width end
    List.fold_left(List.range(0, 32), Nil, fn (out, z) ->
      street_surface_row(kind, arms, width, radius, bulb, deck, 0, z, 0, -1, out))
  end
  pfn straight_edge(east : Bool, side : Int, deck : Int, width : Int, thickness : Int, colour : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if east do Cons(A.piece(0, deck, side, width, 1, thickness, colour), out)
    else Cons(A.piece(side, deck, 0, thickness, 1, width, colour), out) end
  end
  pfn lane_dash(east : Bool, deck : Int, side : Int, start : Int, length : Int) : Ur.Architecture.Piece do
    if east do A.piece(start, deck, side, length, 1, 1, 8)
    else A.piece(side, deck, start, 1, 1, length, 8) end
  end
  pfn grade_piece(p : Ur.Architecture.Piece, axis : Int, h : Int, before : Int, after : Int, at : Int,
    out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let limit = if axis == 0 do p.x + p.w else p.z + p.d end
    if at >= limit do out else
      let boundary = at / 4 * 4 + 4
      let length = S.clamp(limit - at, 1, boundary - at)
      let y = p.y + graded_height(h, before, after, boundary - 2) - h
      let slice = if axis == 0 do { p with x: at, w: length, y: y } else { p with z: at, d: length, y: y } end
      grade_piece(p, axis, h, before, after, at + length, Cons(slice, out))
    end
  end
  pfn grade_road(parts : List(Ur.Architecture.Piece), axis : Int, h : Int, before : Int, after : Int) : List(Ur.Architecture.Piece) do
    List.fold_left(parts, Nil, fn (out, p) -> grade_piece(p, axis, h, before, after, if axis == 0 do p.x else p.z end, out))
  end
  pfn road(c : Ur.Sim.City, i : Int, h : Int) : List(Ur.Architecture.Piece) do
    let kind = S.get(c.roads, i)
    let (horizontal, vertical) = S.road_turn(c, i)
    if horizontal >= 0 do curve(kind, h, horizontal, vertical, 0, Nil) else
    let west_link = S.street_link(c, i, 0)
    let east_link = S.street_link(c, i, 1)
    let north_link = S.street_link(c, i, 2)
    let south_link = S.street_link(c, i, 3)
    let peer = S.grade_peer(c, i)
    let bridge = S.grade_kind(c, i) == 1 && S.valid(peer)
    let crossing = if bridge || S.mountain_tunnel(c, i, peer) do S.direction(i, peer) else -1 end
    let east = west_link || east_link || (crossing >= 0 && crossing < 2)
    let north = north_link || south_link || crossing >= 2
    let junction = east && north && h > 0
    let arms = List.length(List.filter([west_link, east_link, north_link, south_link], fn linked -> linked))
    let shaped = shaped_surface(c, i)
    let end_arm = S.street_end_arm(c, i)
    let source = S.grade_source(c, i)
    let target = S.grade_peer(c, source)
    let under_bridge = end_arm >= 0 && S.grade_link(c, source, target) && S.grade_kind(c, source) == 1 &&
      (end_arm < 2) == (source / S.width() == target / S.width())
    let bulb = shaped && arms <= 1 && !under_bridge
    let deck = if h == 0 do 2 else h end
    -- A curve meets the centre of the next parcel edge. Straight segments
    -- use the same width, including the raised walking edge.
    let colour = if kind == 3 do 16 else 4 end
    let width = S.road_half_width(kind)
    let a = if bulb || ((shaped || bridge) && junction) do
      shaped_street(kind, { west: west_link || crossing == 0, east: east_link || crossing == 1,
        north: north_link || crossing == 2, south: south_link || crossing == 3 }, bulb, deck)
      else if junction || h == 0 do Cons(A.piece(0, deck, 0, 32, 1, 32, colour), Nil)
      else straight_edge(east, 16 - width, deck, 32, width * 2, colour, Nil) end
    end
    let a = if bulb || junction || h == 0 do a else
      let walk = S.sidewalk_width(kind)
      let a = straight_edge(east, 16 - width - walk, deck + 1, 32, walk - 1, 24, a)
      let a = straight_edge(east, 15 - width, deck + 1, 32, 1, 23, a)
      let a = straight_edge(east, 16 + width, deck + 1, 32, 1, 23, a)
      straight_edge(east, 17 + width, deck + 1, 32, walk - 1, 24, a)
    end
    let marks = if bulb || junction do Nil
      else if kind == 1 do
        let m = if east do [lane_dash(true, deck, 15, 2, 7), lane_dash(true, deck, 15, 22, 7)] else Nil end
        if north || !east do Cons(lane_dash(false, deck, 15, 2, 7), Cons(lane_dash(false, deck, 15, 22, 7), m)) else m end
      else if kind == 2 do
        straight_edge(east, 15, deck, 32, 2, 10, [
          lane_dash(east, deck, 8, 4, 6), lane_dash(east, deck, 8, 20, 6),
          lane_dash(east, deck, 23, 4, 6), lane_dash(east, deck, 23, 20, 6)])
      else straight_edge(east, 15, deck, 32, 2, 17, Nil) end end end
    -- Replace the asphalt under the paint so the top faces share a height without overlapping.
    let a = List.fold_left(marks, a, fn (parts, mark) -> Cons(mark, cut_road_pieces(parts, mark)))
    let a = if junction && kind != 3 do
      let a = if west_link do crosswalk(0, deck, 0, width, a) else a end
      let a = if east_link do crosswalk(0, deck, 1, width, a) else a end
      let a = if north_link do crosswalk(0, deck, 2, width, a) else a end
      if south_link do crosswalk(0, deck, 3, width, a) else a end
    else a end
    let a = if S.get(c.tolls, i) == 0 do a else
      let (x, z) = if east do (20, 1) else (1, 20) end
      Cons(A.piece(x, deck + 1, z, 1, 8, 1, 13), Cons(A.piece(x, deck + 8, z, 3, 2, 3, 10), a))
    end
    if junction && kind != 3 do a
    else if h == 0 do
      let a = if east do Cons(A.piece(0, deck + 2, 1, 32, 2, 1, 8), Cons(A.piece(0, deck + 2, 30, 32, 2, 1, 8), a)) else a end
      let a = if north || !east do Cons(A.piece(1, deck + 2, 0, 1, 2, 32, 8), Cons(A.piece(30, deck + 2, 0, 1, 2, 32, 8), a)) else a end
      Cons(A.piece(7, 0, 7, 4, 2, 4, 17), Cons(A.piece(21, 0, 21, 4, 2, 4, 17), a))
    else
      let (axis, before, after) = road_profile(c, i)
      if axis >= 0 do grade_road(a, axis, h, before, after) else a end
    end end end
  end
  pfn shift(a : List(Ur.Architecture.Piece), h : Int) : List(Ur.Architecture.Piece) do
    match a do
      Nil -> Nil
      Cons(p, rest) -> Cons({ p with y: p.y + h }, shift(rest, h))
    end
  end
  type Clearing = { x : Int, z : Int, w : Int, d : Int }
  fn overlaps(piece : Ur.Architecture.Piece, clear : Clearing) : Bool do
    piece.x < clear.x + clear.w && clear.x < piece.x + piece.w &&
      piece.z < clear.z + clear.d && clear.z < piece.z + piece.d
  end
  pfn vegetation(c : Ur.Sim.City, i : Int, site : (Int, Int, Bool, Bool), clearings : List(Clearing), n : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if n >= 3 do out else
      let seed = Strata.Seed.mix(i, n + 1)
      let x = 7 + seed % 18
      let z = 7 + (seed / 13) % 18
      let wx = i % S.width() * 32 + x
      let wz = i / S.width() * 32 + z
      let h = height(c, wx, wz)
      let bare = S.subsea_owned(c, i) || (h >= 42 && S.volcanic_highland(c, i % S.width(), i / S.width()) &&
        volcanic_cover(wx, wz, h, slope(h, height(c, wx - 4, wz), height(c, wx + 4, wz),
          height(c, wx, wz - 4), height(c, wx, wz + 4))) >= volcanic_ash_material())
      -- what grows here follows the island (Ur.Flora): zone, wind side, coast
      let kind = Ur.Flora.pick_at(site, c, h, seed)
      let stand = Ur.Flora.mangrove_spot(c, i, h)
      let thick = if stand > 0 do S.mangrove_density(c, i) else 0 end
      let parts = if bare do Nil else if stand > 0 && seed % 11 < (if stand == 2 do thick * 4 / 7 else thick end) do
        Ur.Trees.mangrove_stand(stand, x, z, seed)
        else if kind >= 0 && seed % 11 < 7 && S.grade_kind(c, S.grade_source(c, i)) != 1 do
        Ur.Trees.shape(kind, x, z, h, seed)
        else if h > 1 && seed % 5 == 0 do [A.piece(x, h, z, 4, 2, 3, 2), A.piece(x + 1, h + 2, z, 2, 1, 2, 23)]
        else if h > 7 && h < 37 && seed % 3 == 0 do [A.piece(x, h, z, 2, 2, 2, 25), A.piece(x, h + 2, z, 1, 1, 1, 20)]
        else Nil end end end end end
      let blocked = List.any(clearings, fn clear -> List.any(parts, fn piece -> overlaps(piece, clear)))
      vegetation(c, i, site, clearings, n + 1, if blocked do out else List.append(parts, out) end)
    end
  end
  pfn zone_edge(c : Ur.Sim.City, i : Int, n : Int, tex : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if n >= 32 do out else
      let along = n % 8 * 4
      let edge = n / 8
      let x = if edge == 0 do 0 else if edge == 1 do 31 else along end end
      let z = if edge == 2 do 0 else if edge == 3 do 31 else along end end
      let h = height(c, i % S.width() * 32 + x, i / S.width() * 32 + z)
      let w = if edge < 2 do 1 else 4 end
      let d = if edge < 2 do 4 else 1 end
      zone_edge(c, i, n + 1, tex, Cons(A.piece(x, h, z, w, 1, d, tex), out))
    end
  end
  -- The starter harbour spans four parcels south of the gateway.
  -- Normal construction takes precedence so these meshes never reserve land.
  pfn harbour_piece(row : Int, h : Int) : List(Ur.Architecture.Piece) do
    match row do
      22 ->
        Cons(A.piece(11, h, 0, 10, 1, 32, 17), Nil)
      23 ->
        let y = h + 1
        Cons(A.piece(2, 0, 0, 28, y, 32, 17),
        Cons(A.piece(5, y, 8, 11, 9, 14, 8),
        Cons(A.piece(4, y + 9, 7, 13, 2, 16, 7),
        Cons(A.piece(6, y + 3, 22, 9, 4, 1, 9),
        Cons(A.piece(18, y, 21, 11, 1, 11, 13),
        Cons(A.piece(23, y, 25, 1, 11, 1, 13),
        Cons(A.piece(23, y + 10, 24, 5, 1, 3, 20), Nil)))))))
      24 ->
        Cons(A.piece(16, 5, 0, 12, 2, 27, 13),
        Cons(A.piece(17, 0, 5, 2, 5, 2, 17),
        Cons(A.piece(25, 0, 20, 2, 5, 2, 17),
        Cons(A.piece(16, 7, 22, 2, 2, 2, 20),
        Cons(A.piece(25, 7, 22, 2, 2, 2, 20), Nil)))))
      25 ->
        -- Moored electric launch, with a stepped bow and wheelhouse.
        Cons(A.piece(13, 0, 2, 10, 3, 18, 7),
        Cons(A.piece(14, 0, 20, 8, 3, 3, 7),
        Cons(A.piece(16, 0, 23, 4, 3, 2, 7),
        Cons(A.piece(13, 3, 2, 10, 1, 18, 8),
        Cons(A.piece(15, 4, 8, 6, 4, 8, 9),
        Cons(A.piece(14, 8, 7, 8, 1, 10, 8),
        Cons(A.piece(16, 9, 9, 4, 1, 6, 19), Nil)))))))
      _ -> Nil
    end
  end
  pfn crop_rows(crop : Ur.Sim.Crop, row : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if row >= 4 do out else
      let x = 4 + row * 7
      let soil = A.piece(x, 1, 3, 5, 1, 26, 1)
      let plants = List.fold_left([5, 11, 17, 23], Cons(soil, out), fn (parts, z) ->
        match crop do
          SweetPotato ->
            Cons(A.piece(x + 1, 2, z, 3, 1, 5, 14), Cons(A.piece(x, 3, z + 1, 5, 1, 2, 22), parts))
          _ ->
            Cons(A.piece(x + 2, 2, z + 2, 1, 3, 1, 14),
              Cons(A.piece(x, 5, z, 5, 1, 4, 21), Cons(A.piece(x + 1, 6, z, 2, 1, 2, 11), parts)))
        end)
      crop_rows(crop, row + 1, plants)
    end
  end
  pfn farm_model(crop : Ur.Sim.Crop) : List(Ur.Architecture.Piece) do
    let base = [A.piece(2, 0, 2, 28, 1, 28, 13)]
    match crop do
      Breadfruit -> List.fold_left([7, 16, 25], base, fn (parts, x) ->
        List.fold_left([7, 16, 25], parts, fn (parts, z) ->
          Cons(A.piece(x, 1, z, 1, 6, 1, 1), Cons(A.piece(x - 3, 5, z - 3, 7, 3, 7, 14),
            Cons(A.piece(x - 2, 8, z - 2, 5, 2, 5, 21), Cons(A.piece(x - 2, 5, z - 3, 1, 1, 1, 11), parts))))))
      _ -> crop_rows(crop, 0, base)
    end
  end
  pfn fishing_dock_model() : List(Ur.Architecture.Piece) do
    [A.piece(4, 0, 3, 24, 1, 18, 17), A.piece(6, 1, 5, 13, 7, 13, 8),
      A.piece(5, 8, 4, 15, 2, 15, 7), A.piece(10, 1, 18, 5, 5, 1, 19),
      A.piece(17, 1, 20, 11, 1, 12, 1), A.piece(17, 2, 24, 1, 4, 1, 13),
      A.piece(27, 2, 24, 1, 4, 1, 13), A.piece(17, 2, 30, 1, 4, 1, 13),
      A.piece(27, 2, 30, 1, 4, 1, 13), A.piece(21, 2, 21, 4, 2, 4, 10),
      A.piece(25, 2, 26, 2, 2, 2, 12), A.piece(25, 2, 12, 1, 10, 1, 19),
      A.piece(22, 11, 12, 4, 1, 1, 10), A.piece(22, 5, 12, 1, 6, 1, 17)]
  end
  pfn school_windows(x : Int, z : Int, y : Int, count : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if count <= 0 do parts else
      let parts = Cons(A.piece(x, y, z, 3, 4, 1, 9), Cons(A.piece(x - 1, y - 1, z, 5, 1, 1, 24), parts))
      school_windows(x + 5, z, y, count - 1, parts)
    end
  end
  pfn school_gable(step : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if step >= 9 do parts else
      school_gable(step + 1, Cons(A.piece(3, 10 + step, 3 + step, 26, 1, 19 - step * 2, 6), parts))
    end
  end
  pfn elementary(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(4, 1, 4, 24, 9, 17, A.brick(1)), base)
    let hall = school_gable(0, hall)
    let hall = school_windows(6, 21, 5, 2, school_windows(20, 21, 5, 2, school_windows(7, 3, 5, 4, hall)))
    let hall = List.append([A.piece(13, 1, 21, 6, 1, 11, 16), A.piece(13, 2, 21, 6, 6, 1, 24),
      A.piece(14, 2, 22, 4, 5, 1, A.plaster(1)), A.piece(12, 1, 24, 1, 7, 1, 7), A.piece(19, 1, 24, 1, 7, 1, 7),
      A.piece(11, 8, 26, 10, 1, 1, A.plaster(3))], hall)
    let hall = List.fold_left(List.range(0, 4), hall, fn (parts, step) ->
      Cons(A.piece(11 + step, 8 + step, 20, 10 - step * 2, 1, 6, 56), parts))
    let yard = Cons(A.piece(4, 1, 23, 8, 1, 7, 18), Cons(A.piece(21, 1, 23, 7, 1, 7, 22), hall))
    let yard = List.append([A.piece(5, 2, 24, 1, 4, 1, 7), A.piece(11, 2, 24, 1, 4, 1, 7),
      A.piece(5, 6, 24, 7, 1, 2, A.plaster(3)), A.piece(8, 2, 29, 1, 1, 1, 24),
      A.piece(7, 2, 27, 1, 1, 1, A.plaster(2)), A.piece(9, 2, 27, 1, 1, 1, A.plaster(4)),
      A.piece(8, 2, 26, 1, 1, 1, A.plaster(0))], yard)
    List.append([
      A.piece(25, 2, 26, 1, 4, 1, 13), A.piece(23, 6, 24, 5, 3, 5, 14),
      A.piece(24, 9, 25, 3, 2, 3, 21)], yard)
  end
  pfn secondary(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(4, 1, 5, 24, 15, 19, A.brick(0)), Cons(A.piece(3, 16, 4, 26, 2, 21, 19), base))
    let hall = Cons(A.piece(4, 15, 24, 24, 1, 1, 24), hall)
    let hall = school_windows(7, 24, 10, 4, school_windows(7, 4, 10, 4, school_windows(7, 4, 4, 4, hall)))
    let hall = Cons(A.piece(12, 1, 25, 8, 1, 7, 16), hall)
    let hall = Cons(A.piece(11, 1, 24, 10, 7, 1, 19), Cons(A.piece(9, 8, 24, 14, 1, 4, 8), hall))
    let hall = Cons(A.piece(6, 18, 8, 9, 1, 11, 19), Cons(A.piece(17, 18, 8, 9, 1, 11, 19), hall))
    Cons(A.piece(6, 19, 9, 9, 1, 9, 9), Cons(A.piece(17, 19, 9, 9, 1, 9, 9), hall))
  end
  pfn workshop_roof(z : Int, level : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if level >= 4 do parts else
      workshop_roof(z, level + 1, Cons(A.piece(2, 10 + level, z + level * 2, 28, 1, 9 - level * 2, 19), parts))
    end
  end
  pfn trade_workshop(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(3, 1, 4, 26, 9, 20, A.brick(2)), base)
    let hall = workshop_roof(4, 0, workshop_roof(15, 0, hall))
    let hall = Cons(A.piece(4, 10, 13, 24, 2, 1, 9), Cons(A.piece(4, 10, 24, 24, 2, 1, 9), hall))
    let hall = Cons(A.piece(6, 1, 24, 8, 7, 1, 19), Cons(A.piece(18, 1, 24, 8, 7, 1, 19), hall))
    let hall = Cons(A.piece(7, 3, 25, 6, 1, 1, 17), Cons(A.piece(19, 3, 25, 6, 1, 1, 17), hall))
    let hall = Cons(A.piece(7, 6, 25, 6, 1, 1, 17), Cons(A.piece(19, 6, 25, 6, 1, 1, 17), hall))
    let hall = Cons(A.piece(4, 8, 24, 24, 1, 3, 10), hall)
    Cons(A.piece(5, 1, 26, 1, 3, 1, 10), Cons(A.piece(26, 1, 26, 1, 3, 1, 10), hall))
  end
  pfn university(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(3, 1, 5, 26, 11, 21, A.brick(0)), Cons(A.piece(2, 12, 4, 28, 2, 23, 24), base))
    let hall = school_windows(6, 26, 7, 5, school_windows(6, 4, 7, 5, hall))
    let tower = Cons(A.piece(10, 14, 8, 12, 15, 13, A.brick(1)), Cons(A.piece(9, 29, 7, 14, 2, 15, 24), hall))
    let tower = Cons(A.piece(12, 17, 21, 8, 10, 1, 9), Cons(A.piece(12, 17, 7, 8, 10, 1, 9), tower))
    let tower = Cons(A.piece(15, 17, 22, 2, 10, 1, 8), Cons(A.piece(15, 17, 6, 2, 10, 1, 8), tower))
    let crown = Cons(A.piece(12, 31, 10, 8, 2, 9, 8), Cons(A.piece(14, 33, 12, 4, 2, 5, 7), tower))
    let crown = Cons(A.piece(11, 1, 27, 10, 1, 5, 16), crown)
    Cons(A.piece(11, 1, 26, 10, 7, 1, 19), Cons(A.piece(9, 8, 26, 14, 1, 5, 7), crown))
  end
  pfn faculty(kind : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let accent = match kind do
      29 -> 6
      30 -> 7
      31 -> 19
      _ -> 13
    end
    let hall = Cons(A.piece(4, 1, 4, 24, 12, 21, A.brick(kind)), Cons(A.piece(3, 13, 3, 26, 2, 23, accent), base))
    let hall = school_windows(7, 25, 7, 4, school_windows(7, 3, 7, 4, hall))
    let hall = Cons(A.piece(12, 1, 25, 8, 5, 1, 19), Cons(A.piece(10, 6, 25, 12, 1, 4, accent), hall))
    match kind do
      29 ->
        let roof = Cons(A.piece(7, 15, 7, 18, 1, 15, 17), hall)
        Cons(A.piece(14, 16, 9, 4, 1, 11, 6), Cons(A.piece(11, 16, 12, 3, 1, 4, 6),
          Cons(A.piece(18, 16, 12, 3, 1, 4, 6), roof)))
      30 ->
        let lab = Cons(A.piece(7, 15, 6, 18, 3, 16, 8), Cons(A.piece(9, 18, 8, 14, 3, 12, 9), hall))
        Cons(A.piece(12, 21, 11, 8, 2, 6, 19), Cons(A.piece(15, 23, 13, 2, 3, 2, 8), lab))
      31 ->
        let tower = Cons(A.piece(8, 15, 8, 16, 13, 13, 9), Cons(A.piece(7, 28, 7, 18, 2, 15, 19), hall))
        Cons(A.piece(8, 21, 21, 16, 1, 1, 8), Cons(A.piece(8, 26, 21, 16, 1, 1, 8), tower))
      _ ->
        let roof = Cons(A.piece(8, 15, 6, 16, 4, 14, 8), Cons(A.piece(7, 19, 5, 18, 2, 16, 13), hall))
        let portico = Cons(A.piece(8, 1, 27, 2, 7, 2, 8), Cons(A.piece(22, 1, 27, 2, 7, 2, 8), roof))
        Cons(A.piece(7, 8, 25, 18, 2, 5, 13), portico)
    end
  end
  fn faculty_frontage(c : Ur.Sim.City, i : Int, root : Int, d : Int) : Int do
    if d == 3 do 3
    else if S.campus_root(c, S.neighbour(i, d)) == root do d
    else faculty_frontage(c, i, root, d + 1) end end
  end
  pfn clinic(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let wall = A.brick(1)
    let mint = A.plaster(3)
    let coral = A.plaster(0)
    let left = A.window_wall(A.piece(6, 1, 19, 6, 11, 2, wall), 3, 5, 5,
      [{ start: 7, width: 4, glass: 9 }])
    let right = A.window_wall(A.piece(20, 1, 19, 6, 11, 2, wall), 3, 5, 5,
      [{ start: 21, width: 4, glass: 9 }])
    let sides = [{ start: 7, width: 3, glass: 9 }, { start: 13, width: 3, glass: 9 }]
    let west = A.window_wall(A.piece(6, 1, 5, 2, 11, 14, wall), 0, 5, 5, sides)
    let east = A.window_wall(A.piece(24, 1, 5, 2, 11, 14, wall), 1, 5, 5, sides)
    let hall = Cons(A.piece(8, 1, 5, 16, 11, 13, wall), List.append(left, List.append(right, List.append(west, List.append(east, base)))))
    let hall = List.append([A.piece(7, 4, 21, 4, 1, 1, mint), A.piece(21, 4, 21, 4, 1, 1, mint),
      A.piece(7, 10, 21, 4, 1, 1, 24), A.piece(21, 10, 21, 4, 1, 1, 24), A.piece(13, 2, 18, 6, 7, 1, 9),
      A.piece(12, 1, 18, 1, 8, 1, 7), A.piece(19, 1, 18, 1, 8, 1, 7),
      A.piece(16, 2, 19, 1, 7, 1, 7), A.piece(12, 9, 18, 8, 1, 1, 24)], hall)
    let roof = List.fold_left(List.range(0, 6), hall, fn (parts, row) ->
      Cons(A.piece(5, 12 + row, 4 + row, 22, 1, 18 - row * 2, 7), parts))
    let entry = [A.piece(11, 1, 21, 1, 9, 4, 24), A.piece(20, 1, 21, 1, 9, 4, 24),
      A.piece(11, 10, 20, 10, 1, 8, 24), A.piece(10, 11, 19, 12, 1, 9, 7), A.piece(10, 11, 28, 12, 1, 1, mint),
      A.piece(11, 12, 20, 10, 2, 6, wall), A.piece(12, 14, 20, 8, 1, 6, 7),
      A.piece(13, 12, 26, 6, 5, 1, 7), A.piece(13, 12, 27, 6, 5, 1, 8),
      A.piece(15, 13, 28, 2, 3, 1, 6), A.piece(14, 14, 28, 4, 1, 1, 6)]
    let forecourt = [A.piece(12, 1, 19, 8, 1, 13, 16),
      A.piece(5, 1, 25, 1, 2, 2, 13), A.piece(9, 1, 25, 1, 2, 2, 13), A.piece(5, 3, 25, 5, 1, 2, coral),
      A.piece(5, 4, 25, 5, 2, 1, coral), A.piece(23, 1, 25, 5, 2, 4, 55),
      A.piece(23, 3, 25, 5, 1, 4, 24), A.piece(24, 4, 26, 3, 2, 2, 21),
      A.piece(25, 6, 25, 1, 1, 4, 14), A.piece(24, 6, 26, 1, 1, 1, coral),
      A.piece(26, 6, 27, 1, 1, 1, A.plaster(2))]
    List.append(forecourt, List.append(entry, roof))
  end
  pfn facility(kind : Int) : List(Ur.Architecture.Piece) do
    let base = Cons(A.piece(2, 0, 2, 28, 1, 28, 17), Nil)
    match kind do
      1 | 2 | 3 | 4 | 7 | 8 | 9 | 10 | 11 | 12 | 14 | 15 | 16 | 17 | 45 -> Ur.Utilities.model(kind, base)
