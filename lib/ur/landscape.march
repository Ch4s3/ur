  pfn shore_frontage(c : Ur.Sim.City, lot : Int, d : Int) : Int do
    if d == 4 do frontage(c, lot, 0) else
      let peer = S.neighbour(lot, d)
      if S.valid(peer) && S.get(c.heights, peer) == 0 do d else shore_frontage(c, lot, d + 1) end
    end
  end
  fn frontage(c : Ur.Sim.City, i : Int, d : Int) : Int do
    let side = S.sidewalk_frontage(c, i, d)
    if side >= 0 do side else 3 end
  end
  pfn fire_ruins(h : Int, months : Int) : List(Ur.Architecture.Piece) do
    let site = Cons(A.piece(4, 0, 4, 24, 1, 24, 19), Nil)
    let site = Cons(A.piece(4, 1, 4, 4, 5, 17, 23), Cons(A.piece(8, 1, 4, 13, 3, 4, 23), site))
    let site = Cons(A.piece(11, 1, 18, 5, 2, 6, 13), Cons(A.piece(20, 1, 16, 5, 4, 4, 23), site))
    shift(if months == 4 do site else A.worksite(0, 4 - months, site) end, h)
  end
  fn lights_with_power(c : Ur.Sim.City, i : Int, hour : Int, powered : Bool) : Int do
    let night = hour >= 18 || hour < 6
    if !powered do 0
    else if S.get(c.roads, i) > 0 do
      let street = night && S.get(c.heights, i) > 0 && (i % S.width() + i / S.width()) % 2 == 0
      (if S.grade_kind(c, i) == 3 do 8 else 0 end) + (if street do 4 else 0 end)
    else if !night || S.get(c.buildings, i) == 0 || S.building_offline(c, i) do 0
    else
      let homes = S.residential_floors(c, i)
      let floors = S.get(c.buildings, i)
      let cutoff = (if floors == 1 do 21 else if floors == 2 do 23 else 25 end end) + i % 2
      let night_hour = if hour < 6 do hour + 24 else hour end
      let home = homes > 0 && night_hour < cutoff
      let shop = S.business_open(c, i, hour)
      (if home do 1 else 0 end) + (if shop do 2 else 0 end)
    end end end
  end
  fn lights(c : Ur.Sim.City, i : Int, hour : Int) : Int do
    lights_with_power(c, i, hour, S.distance(S.grid_access(c), i) >= 0 && S.supply(c, S.access(c)) > 0)
  end
  pfn school_court(ground : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let court = Cons(A.piece(5, 1, 5, 22, 1, 22, 6), ground)
    let court = Cons(A.piece(7, 2, 7, 18, 1, 1, 8), Cons(A.piece(7, 2, 24, 18, 1, 1, 8), court))
    let court = Cons(A.piece(7, 2, 8, 1, 1, 16, 8), Cons(A.piece(24, 2, 8, 1, 1, 16, 8), court))
    let court = Cons(A.piece(15, 2, 8, 1, 1, 16, 8), Cons(A.piece(13, 2, 14, 5, 1, 3, 8), court))
    let goals = Cons(A.piece(8, 3, 15, 1, 4, 1, 19), Cons(A.piece(23, 3, 15, 1, 4, 1, 19), court))
    let goals = Cons(A.piece(9, 6, 14, 1, 2, 3, 8), Cons(A.piece(22, 6, 14, 1, 2, 3, 8), goals))
    Cons(A.piece(9, 1, 28, 14, 1, 3, 17), Cons(A.piece(9, 2, 29, 14, 1, 2, 19), goals))
  end
  pfn campus_tree(x : Int, z : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let tree = Cons(A.piece(x, 1, z, 1, 5, 1, 1), Cons(A.piece(x - 2, 4, z - 2, 5, 4, 5, 14), parts))
    Cons(A.piece(x - 1, 8, z - 1, 3, 1, 3, 22), tree)
  end
  pfn campus_annex(kind : Int, along : Int, across : Int) : List(Ur.Architecture.Piece) do
    let ground = Cons(A.piece(0, 0, 0, 32, 1, 32, 21), Nil)
    if kind == 26 && along == 2 do school_court(ground)
    else if kind == 26 do
      let wing = Cons(A.piece(3, 1, 5, 26, 10, 20, 6), Cons(A.piece(2, 11, 4, 28, 2, 22, 19), ground))
      let wing = school_windows(6, 25, 5, 5, school_windows(6, 4, 5, 5, wing))
      Cons(A.piece(9, 13, 9, 14, 2, 11, 7), Cons(A.piece(11, 15, 10, 10, 1, 9, 9), wing))
    else if kind == 27 && along != 2 do trade_workshop(ground)
    else if kind == 27 do
      let yard = Cons(A.piece(2, 1, 3, 28, 1, 26, 17), ground)
      let yard = Cons(A.piece(5, 2, 7, 1, 1, 18, 10), Cons(A.piece(25, 2, 7, 1, 1, 18, 10), yard))
      let shed = Cons(A.piece(9, 2, 6, 2, 5, 2, 19), Cons(A.piece(22, 2, 6, 2, 5, 2, 19), yard))
      let shed = Cons(A.piece(9, 2, 13, 2, 5, 2, 19), Cons(A.piece(22, 2, 13, 2, 5, 2, 19), shed))
      let shed = Cons(A.piece(8, 7, 5, 17, 1, 11, 10), shed)
      Cons(A.piece(10, 2, 21, 4, 2, 3, 1), Cons(A.piece(18, 2, 19, 5, 3, 4, 7), shed))
    else if across == 1 do
      let quad = Cons(A.piece(0, 1, 14, 11, 1, 4, 16), Cons(A.piece(21, 1, 14, 11, 1, 4, 16), ground))
      let quad = Cons(A.piece(14, 1, 0, 4, 1, 11, 16), Cons(A.piece(14, 1, 21, 4, 1, 11, 16), quad))
      let quad = campus_tree(7, 7, campus_tree(24, 7, campus_tree(7, 24, campus_tree(24, 24, quad))))
      let plaza = Cons(A.piece(11, 1, 11, 10, 1, 10, 8), quad)
      if along % 2 == 0 do
        let basin = Cons(A.piece(18, 1, 18, 5, 1, 5, 8), plaza)
        Cons(A.piece(19, 2, 19, 3, 1, 3, 9), Cons(A.piece(20, 3, 20, 1, 3, 1, 8), basin))
      else
        Cons(A.piece(11, 2, 12, 2, 1, 2, 1), Cons(A.piece(19, 2, 18, 2, 1, 2, 1), plaza))
      end
    else
      let height = if along % 2 == 0 do 17 else 11 end
      let hall = Cons(A.piece(3, 1, 4, 26, height, 23, 8), Cons(A.piece(2, height + 1, 3, 28, 2, 25, 7), ground))
      let hall = school_windows(6, 27, 7, 5, school_windows(6, 3, 7, 5, hall))
      let lobby = Cons(A.piece(12, 1, 27, 8, 5, 1, 19), Cons(A.piece(10, 6, 27, 12, 1, 3, 7), hall))
      if height == 11 do
        Cons(A.piece(8, 14, 9, 16, 2, 12, 19), Cons(A.piece(10, 16, 10, 12, 1, 10, 9), lobby))
      else
        let garden = Cons(A.piece(6, 20, 7, 20, 1, 16, 11), lobby)
        Cons(A.piece(9, 21, 11, 5, 2, 8, 14), Cons(A.piece(18, 21, 11, 5, 2, 8, 14), garden))
      end
    end end end end end
  end
  pfn parking_pieces(c : Ur.Sim.City, i : Int) : List(Ur.Architecture.Piece) do
    let road = S.fleet_frontage(c, i, 0)
    let side = if S.valid(road) do S.direction(i, road) else frontage(c, i, 0) end
    shift(A.orient(A.public_parking(S.get(c.public_parking, i)), side), S.get(c.heights, i))
  end
  pfn cut_road_pieces(parts : List(Ur.Architecture.Piece), cut : Ur.Architecture.Piece) : List(Ur.Architecture.Piece) do
    List.flat_map(parts, fn p ->
      let left = S.clamp(cut.x, p.x, p.x + p.w)
      let right = S.clamp(cut.x + cut.w, p.x, p.x + p.w)
      let back = S.clamp(cut.z, p.z, p.z + p.d)
      let front = S.clamp(cut.z + cut.d, p.z, p.z + p.d)
      if right <= left || front <= back do [p] else
        List.filter([
          { p with w: left - p.x },
          { p with x: right, w: p.x + p.w - right },
          { p with x: left, w: right - left, d: back - p.z },
          { p with x: left, w: right - left, z: front, d: p.z + p.d - front }
        ], fn piece -> piece.w > 0 && piece.d > 0)
      end)
  end
  pfn trim_closed_arms(c : Ur.Sim.City, lot : Int, bore : Int, side : Int, inset : Int,
    parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if side == 4 do parts
    else if side == bore || S.street_link(c, lot, side) do trim_closed_arms(c, lot, bore, side + 1, inset, parts)
    else
      let guide = A.orient([A.piece(0, 0, 32 - inset, 32, 1, inset, 0)], side)
      let parts = match guide do Nil -> parts | Cons(cut, _) -> cut_road_pieces(parts, cut) end
      trim_closed_arms(c, lot, bore, side + 1, inset, parts)
    end end
  end
  fn street_edge(c : Ur.Sim.City, lot : Int, direction : Int) : (Int, Int) do
    RoadSurface.edge(c, lot, direction)
  end
  fn portal_street(c : Ur.Sim.City, lot : Int, h : Int) : List(Ur.Architecture.Piece) do
    if RoadSurface.uses_curve(c, lot) do RoadSurface.pieces(c, lot, true) else
    let parts = road(c, lot, h)
    let peer = S.grade_peer(c, lot)
    if S.mountain_tunnel(c, lot, peer) do
      let (horizontal, _) = S.road_turn(c, lot)
      if horizontal >= 0 do parts else
        trim_closed_arms(c, lot, S.direction(lot, peer), 0, 16 - S.road_half_width(S.get(c.roads, lot)) - S.sidewalk_width(S.get(c.roads, lot)), parts)
      end
    else if S.grade_kind(c, lot) == 1 && S.valid(peer) do
      let inward = S.direction(lot, peer)
      let parts = trim_closed_arms(c, lot, inward, 0, 16 - S.road_half_width(S.get(c.roads, lot)) - S.sidewalk_width(S.get(c.roads, lot)), parts)
      let across = if inward < 2 do 2 else 0 end
      let junction = S.street_link(c, lot, across) || S.street_link(c, lot, across + 1)
      let reach = if junction do 16 - S.road_half_width(S.get(c.roads, lot)) - S.sidewalk_width(S.get(c.roads, lot)) else 16 end
      if S.street_link(c, lot, inward) || reach == 0 do parts else
        match A.orient([A.piece(0, 0, 0, 32, 1, reach, 0)], S.opposite(inward)) do
          Nil -> parts
          Cons(cut, _) -> cut_road_pieces(parts, cut)
        end
      end
    else if S.grade_kind(c, lot) == 3 && S.valid(peer) && !portal_crossed_by_street(c, lot, peer) do
      let side = S.opposite(S.direction(lot, peer))
      let guide = A.orient([A.piece(4, 0, 0, 24, 1, 16, 0)], side)
      match guide do Nil -> parts | Cons(cut, _) -> cut_road_pieces(parts, cut) end
    else parts end end end end
  end
  -- Three clear street-facing vehicle openings; the back wall is recessed so
  -- the bays remain legible instead of reading as a narrow side attachment.
  pfn expanded_emergency_station(kind : Int) : List(Ur.Architecture.Piece) do
    let wall = if kind == 21 do A.brick(2) else A.brick(0) end
    let body = [A.piece(2, 0, 2, 28, 1, 28, 17), A.piece(3, 1, 4, 26, 9, 12, wall),
      A.piece(2, 10, 3, 28, 2, 20, 8), A.piece(3, 1, 16, 2, 9, 6, wall),
      A.piece(11, 1, 16, 2, 9, 6, wall), A.piece(19, 1, 16, 2, 9, 6, wall),
      A.piece(27, 1, 16, 2, 9, 6, wall), A.piece(5, 1, 16, 6, 7, 1, 19),
      A.piece(13, 1, 16, 6, 7, 1, 19), A.piece(21, 1, 16, 6, 7, 1, 19),
      A.piece(3, 1, 22, 26, 1, 8, 4), A.piece(3, 8, 21, 26, 1, 3, 7),
      A.piece(3, 9, 21, 26, 1, 3, 8), A.piece(3, 1, 27, 1, 3, 1, 10),
      A.piece(28, 1, 27, 1, 3, 1, 10)]
    if kind == 21 do List.append([A.piece(7, 12, 7, 5, 5, 5, 8),
      A.piece(6, 17, 6, 7, 1, 7, 7), A.piece(8, 18, 8, 3, 1, 3, 20)], body)
    else if kind == 25 do List.append([A.piece(19, 12, 6, 8, 8, 9, 6),
      A.piece(18, 20, 5, 10, 1, 11, 8)], body)
    else List.append([A.piece(5, 12, 6, 6, 5, 6, 6), A.piece(4, 17, 5, 8, 1, 8, 8)], body) end end
  end
  pfn industrial_bay(x : Int, z : Int, w : Int, operating : Bool, dark : Bool) : List(Ur.Architecture.Piece) do
    [A.piece(x - 1, 1, z, w + 2, 8, 1, A.plaster(4)),
      A.piece(x, 2, z + 1, w, 6, 1, if operating do 19 else 8 end),
      A.piece(x, 8, z + 1, w, 1, 2, if operating && dark do 20 else 7 end),
      A.piece(x, 1, z + 2, w, 1, 2, 4)]
  end
  pfn industrial_building(floors : Int, seed : Int, kind : Ur.Industry.IndustrialKind, operating : Bool, dark : Bool) : List(Ur.Architecture.Piece) do
    let rise = 4 * (floors - 1)
    let apron = [A.piece(1, 0, 2, 30, 1, 30, 17),
      A.piece(3, 1, 25, 1, 1, 6, 7), A.piece(28, 1, 25, 1, 1, 6, 7)]
    let wall = A.brick(seed)
    let structure = match Industry.code(kind) do
      0 ->
        let hall = [A.piece(5, 1, 8, 22, 8 + rise, 14, wall),
          A.piece(4, 9 + rise, 7, 24, 1, 16, 56), A.piece(5, 10 + rise, 7, 22, 1, 8, 19),
          A.piece(7, 11 + rise, 8, 18, 3, 6, wall), A.piece(8, 12 + rise, 14, 16, 2, 1, 9),
          A.piece(6, 14 + rise, 7, 20, 1, 9, 56), A.piece(5, 10 + rise, 16, 22, 1, 6, 19),
          A.piece(5, 9 + rise, 23, 22, 1, 1, A.plaster(1)), A.piece(9, 10 + rise, 22, 14, 1, 1, wall),
          A.piece(20, 5, 22, 4, 3, 1, 9), A.piece(19, 4, 22, 6, 1, 1, 24),
          A.piece(19, 5, 22, 1, 3, 1, 7), A.piece(24, 5, 22, 1, 3, 1, 7),
          A.piece(22, 1, 24, 4, 3, 4, 6)]
        List.append(industrial_bay(8, 22, 9, operating, dark), hall)
      1 ->
        let hall = [A.piece(3, 1, 4, 26, 10 + rise, 16, wall),
          A.piece(2, 11 + rise, 3, 28, 2, 18, 19),
          A.piece(3, 10, 19, 26, 1, 7, 7),
          A.piece(23, 1, 26, 4, 2, 4, 6), A.piece(17, 1, 27, 4, 3, 3, 6)]
        List.append(industrial_bay(7, 20, 10, operating, dark), hall)
      3 ->
        let hall = [A.piece(3, 1, 5, 15, 11 + rise, 17, wall),
          A.piece(19, 1, 8, 10, 9 + rise, 12, 9),
          A.piece(2, 12 + rise, 4, 17, 2, 19, 17), A.piece(18, 10 + rise, 7, 12, 2, 14, 17),
          A.piece(5, 14 + rise, 7, 5, 3, 6, 9), A.piece(11, 14 + rise, 7, 5, 3, 6, 9),
          A.piece(6, 17 + rise, 8, 3, 1, 4, 19), A.piece(12, 17 + rise, 8, 3, 1, 4, 19)]
        List.append(industrial_bay(6, 22, 8, operating, dark), hall)
      4 ->
        let hall = [A.piece(3, 1, 4, 20, 12 + rise, 18, wall),
          A.piece(2, 13 + rise, 3, 22, 2, 20, 19),
          A.piece(3, 15 + rise, 5, 19, 3, 4, 17), A.piece(3, 17 + rise, 8, 19, 2, 1, 9),
          A.piece(3, 15 + rise, 13, 19, 3, 4, 17), A.piece(3, 17 + rise, 16, 19, 2, 1, 9),
          A.piece(25, 1, 8, 2, 15, 2, 17), A.piece(25, 1, 21, 2, 15, 2, 17),
          A.piece(24, 15, 7, 5, 2, 17, 7), A.piece(25, 1, 11, 5, 3, 7, 19)]
        List.append(industrial_bay(7, 22, 11, operating, dark), hall)
      _ ->
        let hall = [A.piece(2, 1, 3, 28, 14 + rise, 19, wall),
          A.piece(1, 15 + rise, 2, 30, 2, 21, 19),
          A.piece(5, 17 + rise, 6, 22, 3, 5, 8), A.piece(4, 20 + rise, 5, 24, 1, 7, 19),
          A.piece(5, 17 + rise, 14, 22, 3, 5, 8), A.piece(4, 20 + rise, 13, 24, 1, 7, 19)]
        List.append(industrial_bay(5, 22, 9, operating, dark),
          List.append(industrial_bay(18, 22, 9, operating, dark), hall))
    end
    List.append(structure, apron)
  end
  pfn harbour_terminal(c : Ur.Sim.City, i : Int) : List(Ur.Architecture.Piece) do
    let h = S.get(c.heights, i)
    let hall = [
      A.piece(0, h, 0, 32, 1, 32, 24),
      A.piece(3, h + 1, 7, 15, 9, 12, A.brick(0)),
      A.piece(2, h + 10, 6, 17, 2, 14, 24),
      A.piece(5, h + 12, 9, 10, 1, 7, 19),
      A.piece(6, h + 3, 19, 9, 4, 1, 19),
      A.piece(3, h + 1, 22, 26, 1, 10, 17),
      A.piece(5, h + 2, 25, 6, 3, 4, 7),
      A.piece(12, h + 2, 25, 5, 3, 4, 10),
      A.piece(25, h + 2, 24, 2, 11, 2, 13),
      A.piece(18, h + 12, 24, 9, 2, 2, 10),
      A.piece(18, h + 8, 24, 1, 4, 1, 13)
    ]
    A.orient(hall, S.direction(i, c.harbour_basin))
  end
  pfn buildings_and_land(c : Ur.Sim.City, i : Int, lighting : Int, clearings : List(Clearing)) : List(Ur.Architecture.Piece) do
    let h = S.get(c.heights, i)
    let b = S.get(c.buildings, i)
    let stage = S.get(c.construction, i)
    let zone = S.get(c.zones, i)
    let root = S.campus_root(c, i)
    let kind = S.get(c.plants, i)
    let work = S.public_work_stage(c, i)
    if work > 0 && b == 0 && kind == 0 do shift(A.worksite(0, work, Nil), h)
    else if S.faculty_rank(kind) >= 4 do
      let base = Cons(A.piece(0, 0, 0, 32, 1, 32, 21), Cons(A.piece(11, 1, 26, 10, 1, 6, 16), Nil))
      let parts = if kind == 41 do facility(kind) else faculty(kind, base) end
      shift(A.orient(parts, faculty_frontage(c, i, root, 0)), h)
    else if S.valid(root) && root != i do
      let kind = S.get(c.plants, root)
      let dx = int_abs(i % S.width() - root % S.width())
      let dz = int_abs(i / S.width() - root / S.width())
      let along_x = S.campus_along_x(c, root, if kind == 28 do 3 else 2 end)
      let parts = if along_x do campus_annex(kind, dx, dz) else A.orient(campus_annex(kind, dz, dx), 0) end
      shift(parts, h)
    else if i == c.harbour && S.valid(c.harbour_basin) do harbour_terminal(c, i)
    else if c.founding_map && i == c.harbour do harbour_piece(23, h)
    else if S.get(c.roads, i) > 0 do portal_street(c, i, h)
    else if S.surface_parking(c, i) do parking_pieces(c, i)
    else if kind > 0 do
      let extra_bays = S.get(c.facility_expansion, i) == 4 || S.get(c.facility_expansion, i) == 5
      let parts = if kind == 5 do farm_model(S.crop_at(c, i))
        else if S.private_fishing_dock(c, i) do fishing_dock_model()
        else if extra_bays do expanded_emergency_station(kind) else facility(kind) end end end
      let parts = if S.get(c.facility_expansion, i) == 1 do List.append([
        A.piece(0, 1, 5, 4, 8, 15, 5), A.piece(0, 9, 4, 5, 1, 17, 7),
        A.piece(0, 4, 20, 3, 3, 1, 9)], parts)
        else if S.get(c.facility_expansion, i) == 2 do List.append([
        A.piece(26, 1, 5, 6, 8, 15, A.brick(1)), A.piece(26, 9, 4, 6, 1, 17, 7),
        A.piece(27, 4, 20, 4, 3, 1, 9), A.piece(27, 3, 20, 4, 1, 1, 24)], parts)
        else if S.get(c.facility_expansion, i) == 6 do List.append([
          A.piece(24, 13, 5, 7, 10, 15, 8), A.piece(23, 23, 4, 9, 2, 17, 7),
          A.piece(25, 16, 20, 5, 2, 1, 9), A.piece(25, 20, 20, 5, 2, 1, 9)], parts)
        else if S.get(c.facility_expansion, i) == 3 do List.append([
          A.piece(8, 30, 6, 6, 3, 6, 17), A.piece(7, 33, 5, 8, 1, 8, 19),
          A.piece(9, 34, 7, 4, 1, 4, 7)], parts)
        else parts end end end end
      let parts = if S.private_fishing_dock(c, i) do
          let side = match S.fishing_water(c, i) do
            Cons(water, _) -> S.direction(i, water)
            Nil -> shore_frontage(c, i, 0)
          end
          A.orient(parts, side)
        else if kind == 4 || kind == 9 || kind == 11 || kind == 34 || kind == 35 do A.orient(parts, shore_frontage(c, i, 0))
        else if (kind == 16 || kind == 23) && S.valid(S.fleet_frontage(c, i, 0)) do A.orient(parts, S.direction(i, S.fleet_frontage(c, i, 0)))
        else if kind >= 18 || kind == 1 || kind == 7 do A.orient(parts, frontage(c, i, 0)) else parts end end end end
      shift(parts, h)
    else if S.fire_rebuilding(c, i) do fire_ruins(h, S.fire_months_left(c, i))
    else if b > 0 || stage > 0 do
      let x = i % S.width()
      let z = i / S.width()
      let seed = (x * 19 + z * 37 + x * z * 11) % 257
      let trade = S.trade_kind(c, i)
      let street = S.sidewalk_frontage(c, i, 0)
      let shade = (x * 5 + z * 3) % A.plaster_count()
      let cafe = match trade do Some(kind) -> (Ur.Commerce.profile(kind)).storefront == :cafe | None -> false end
      let townhouse = street >= 0 && b <= 5 && !S.live_work(c, i) &&
        ((zone == 1 && b >= 2) || (zone == 3 && b >= 2) || (zone == 2 && cafe && seed % 3 != 0))
      let vacant = S.storefront(c, i) == 3
      let closed = S.building_offline(c, i) || S.business_closed(c, i)
      let frontage_shop = Option.is_some(trade) || vacant
      let parts = if b > 0 do
        let roofed = stage == 0 && !S.building_offline(c, i)
        if zone == 4 do industrial_building(b, seed, Industry.kind(S.get(c.business_sector, i)), !closed && S.production_running(c, i), lighting % 2 == 1)
        else if townhouse do A.townhouse(b, seed, shade, roofed, frontage_shop, lighting % 2 == 1)
        else match trade do
          Some(kind) -> if zone == 2 do A.commercial_building(b, seed, roofed, kind)
            else A.building(b, true, seed, roofed, true, lighting % 2 == 1) end
          None -> A.building(b, zone != 2, seed, roofed, frontage_shop, lighting % 2 == 1)
        end end end
      else Nil end
      let parts = if stage > 0 do A.worksite(b, stage, parts) else parts end
      let parts = if S.live_work(c, i) && b > 0 do
        List.append(industrial_bay(10, 28, 11, !closed && S.production_running(c, i), lighting % 2 == 1), parts)
      else if vacant do A.storefront(false, true, false, parts)
      else match trade do
        Some(kind) -> A.trade_storefront(kind, closed, lighting / 2 % 2 == 1,
          if street >= 0 do Some(shade + 3 + seed / 4) else None end, parts)
        None -> if closed do Cons(A.piece(12, 3, 29, 8, 5, 1, 19), parts) else parts end
      end end end
      let parts = if S.flood_repair_days(c, i) > 0 do
        Cons(A.piece(4, h + 1, 3, 24, 2, 2, 17), Cons(A.piece(8, h + 3, 3, 16, 2, 1, 10), parts))
      else if S.fire_offline(c, i) do
        Cons(A.piece(9, 4, 29, 13, 5, 1, 23), Cons(A.piece(5, 0, 29, 21, 2, 2, 17), parts))
      else parts end end
      let parking = Ur.Citizens.home_parking(c, i)
      let parts = if parking > 0 do A.parking_pad(parking, parts) else parts end
      let loading = if zone == 4 || S.live_work(c, i) do S.production_frontage(c, i, 0) else -1 end
      let side = if S.valid(loading) do S.direction(i, loading)
        else if parking > 0 do S.direction(i, S.fleet_frontage(c, i, 0)) else if street >= 0 do street else 3 end end end
      shift(A.orient(parts, side), h)
    else if zone > 0 do zone_edge(c, i, 0, if zone == 1 do 11 else if zone == 4 do 10 else 12 end end, Nil)
    else if !c.founding_map && !S.valid(c.harbour_basin) && i % S.width() == 9 && i / S.width() >= 22 && i / S.width() <= 25 do harbour_piece(i / S.width(), h)
    else if S.get(c.transit, i) == 3 || S.get(c.stops, i) == 4 do Nil
    else vegetation(c, i, Ur.Flora.site(c, i), clearings, 0, Nil) end end end end end end end end end end end end end
  end
  pfn tunnel_approach(c : Ur.Sim.City, lot : Int, peer : Int, z : Int, ground : Int) : List(Ur.Architecture.Piece) do
    if z >= 16 do Nil else
      let floor = S.clamp(portal_floor(c, lot, peer, 15 - z), 0, ground)
      let walls = ground - floor + 2
      List.append([
        A.piece(4, floor, z, 24, 1, 2, 4),
        A.piece(4, floor + 1, z, 2, walls, 2, 23),
        A.piece(26, floor + 1, z, 2, walls, 2, 23),
        A.piece(6, floor + 1, z, 1, 1, 2, 10),
        A.piece(25, floor + 1, z, 1, 1, 2, 10),
        A.piece(15, floor + 1, z, 1, 1, 1, 8)
      ], tunnel_approach(c, lot, peer, z + 2, ground))
    end
  end
  -- The opening sits at the bottom of the approach. Stepped shoulders
  -- frame the opening and the darker blocks sit behind its face.
  fn tunnel_portal(c : Ur.Sim.City, lot : Int, peer : Int, powered : Bool) : List(Ur.Architecture.Piece) do
    let ground = S.get(c.heights, lot)
    let lip = S.tunnel_lip(c, lot, peer)
    let floor = S.clamp(portal_floor(c, lot, peer, lip), 0, ground)
    let side = S.opposite(S.direction(lot, peer))
    let lamp = if powered do 28 else 8 end
    let arch = [
      A.piece(4, floor + 1, 0, 3, 11, 6, 24),
      A.piece(25, floor + 1, 0, 3, 11, 6, 24),
      A.piece(7, floor + 1, 0, 2, 9, 5, 19),
      A.piece(23, floor + 1, 0, 2, 9, 5, 19),
      A.piece(7, floor + 9, 0, 3, 3, 6, 24),
      A.piece(22, floor + 9, 0, 3, 3, 6, 24),
      A.piece(10, floor + 11, 0, 3, 3, 6, 24),
      A.piece(19, floor + 11, 0, 3, 3, 6, 24),
      A.piece(10, floor + 13, 0, 12, 2, 6, 23),
      A.piece(8, floor + 14, 0, 16, 2, 7, 24),
      A.piece(9, floor + 1, 0, 14, 10, 2, 13),
      A.piece(8, floor + 6, 4, 1, 2, 2, lamp),
      A.piece(23, floor + 6, 4, 1, 2, 2, lamp),
      A.piece(13, floor + 15, 6, 6, 1, 1, if powered do 20 else 7 end)
    ]
    if portal_crossed_by_street(c, lot, peer) do
      -- Keep both lanes of the existing surface street open.
      A.orient([A.piece(3, ground + 1, 1, 1, 5, 1, 19),
        A.piece(2, ground + 5, 1, 3, 1, 1, if powered do 20 else 7 end)], side)
    else if lip == 16 do A.orient(arch, side)
    else
      let inset = S.tunnel_mouth_run() - lip
      let arch = List.map(arch, fn piece -> { piece with z: piece.z + inset })
      A.orient(List.append(arch, tunnel_approach(c, lot, peer, 0, ground)), side)
    end end
  end
  pfn bridge_axis_piece(east : Bool, u : Int, y : Int, v : Int, run : Int, h : Int, breadth : Int, material : Int) : Ur.Architecture.Piece do
    if east do A.piece(u, y, v, run, h, breadth, material)
    else A.piece(v, y, u, breadth, h, run, material) end
  end
  pfn drawbridge_hinge(c : Ur.Sim.City, i : Int, first : Int, last : Int, side : Int, east : Bool,
    base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let outside = if side > 0 do 0 else 28 end
    let edge = if side > 0 do 0 else 32 end
    let station = S.span_distance(first, i) * 32 - 16 + edge
    let span = S.span_distance(first, last) * 32
    let hinge = float_to_int(Math.floor(S.grade_surface(c, first, last, int_to_float(station) /. int_to_float(span)))) + 1
    let ground = if S.canal_water(c, i) do S.canal_level(c, i) else S.get(c.heights, i) end
    let footing = bridge_axis_piece(east, outside, ground, 8, 4, Math.max_int(1, hinge - 2 - ground), 16, 17)
    let cap = bridge_axis_piece(east, outside, hinge - 2, 6, 4, 2, 20, 24)
    let left = bridge_axis_piece(east, outside, hinge - 2, 5, 4, 5, 3, 19)
    let right = bridge_axis_piece(east, outside, hinge - 2, 24, 4, 5, 3, 19)
    let pin = if side > 0 do outside else outside + 2 end
    let left_pin = bridge_axis_piece(east, pin, hinge, 4, 2, 2, 1, 10)
    let right_pin = bridge_axis_piece(east, pin, hinge, 27, 2, 2, 1, 10)
    List.append([footing, cap, left, right, left_pin, right_pin], base)
  end
  pfn arch_abutment(c : Ur.Sim.City, i : Int, first : Int, last : Int, east : Bool,
    at : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let span = S.span_distance(first, last) * 32
    let start = S.span_distance(first, i) * 32 - 16 + at
    if at >= 32 do parts
    else if start < 0 || start + 4 > span do arch_abutment(c, i, first, last, east, at + 4, parts)
    else
      let is_canal = S.canal_water(c, i)
      let dry = if !is_canal do S.get(c.heights, i) > 0 else
        !List.any([6, 16, 25], fn across ->
          if east do S.canal_wet(c, i, at + 2, across) else S.canal_wet(c, i, across, at + 2) end)
      end
      let ground = if is_canal do S.canal_bank_height(c, i) else S.get(c.heights, i) end
      let left = S.grade_surface(c, first, last, int_to_float(start) /. int_to_float(span))
      let right = S.grade_surface(c, first, last, int_to_float(start + 4) /. int_to_float(span))
      let top = float_to_int(Math.floor(Math.min_float(left, right)))
      let parts = if dry && top > ground do
        Cons(bridge_axis_piece(east, at, ground, 7, 4, top - ground, 18, 17), parts)
      else parts end
      arch_abutment(c, i, first, last, east, at + 4, parts)
    end end
  end
  pfn grade_parts(c : Ur.Sim.City, i : Int, lighting : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let a = S.grade_source(c, i)
    let b = S.grade_peer(c, a)
    if !S.grade_link(c, a, b) || !S.grade_link(c, b, a) || a == b do base else
      let east = a / S.width() == b / S.width()
      let h = S.get(c.heights, i)
      let kind = S.grade_kind(c, a)
      if kind == 1 do
        let style = S.bridge_style(c, a)
        let offset = S.span_distance(a, i)
        let span = S.span_distance(a, b)
        let pillar_height = float_to_int(S.grade_surface(c, a, b, int_to_float(offset) /. int_to_float(span))) - h
        let side = S.drawbridge_leaf_side(c, i)
        if side != 0 do drawbridge_hinge(c, i, Math.min_int(a, b), Math.max_int(a, b), side, east, base)
        else if S.canal_arch(c, a, b) && (i == a || i == b || S.get(c.roads, i) == 0) do
          arch_abutment(c, i, Math.min_int(a, b), Math.max_int(a, b), east, 0, base)
        else if !S.bridge_pier(c, i) || pillar_height <= 2 do base
        else if style == 0 do Cons(A.piece(13, h, 13, 6, pillar_height, 6, 17), base)
        else
          let cap = if east do A.piece(12, h + pillar_height - 2, 10, 8, 2, 12, 24)
            else A.piece(10, h + pillar_height - 2, 12, 12, 2, 8, 24) end
          let pier = Cons(cap, Cons(A.piece(13, h, 13, 6, pillar_height - 2, 6, 17), base))
          if style != 2 do pier else
            let tower = pillar_height + 30
            let front = if east do A.piece(14, h, 5, 4, tower, 3, 17)
              else A.piece(5, h, 14, 3, tower, 4, 17) end
            let back = if east do A.piece(14, h, 24, 4, tower, 3, 17)
              else A.piece(24, h, 14, 3, tower, 4, 17) end
            let beam = if east do A.piece(14, h + tower - 3, 5, 4, 3, 22, 24)
              else A.piece(5, h + tower - 3, 14, 22, 3, 4, 24) end
            Cons(front, Cons(back, Cons(beam, pier)))
          end
        end end end end
      else if kind == 3 && (i == a || i == b) do
        List.append(tunnel_portal(c, i, if i == a do b else a end, lighting >= 8), base)
      else if i == a || i == b do
        let end_plot = if i == a do b else a end
        let inward = S.direction(i, end_plot)
        let p = if inward == 0 do 25 else 2 end
        let q = if inward == 2 do 25 else 2 end
        let face = if east do A.piece(p, h + 1, 9, 5, 4, 14, 19) else A.piece(9, h + 1, q, 14, 4, 5, 19) end
        let frame = if east do A.piece(p, h + 5, 8, 5, 1, 16, if kind == 2 do 10 else 20 end)
          else A.piece(8, h + 5, q, 16, 1, 5, if kind == 2 do 10 else 20 end) end
        Cons(face, Cons(frame, base))
      else if kind == 2 && S.get(c.roads, i) == 0 && S.get(c.buildings, i) == 0 && S.get(c.plants, i) == 0 && S.get(c.construction, i) == 0 do
        let trench = if east do A.piece(0, h - 8, 10, 32, 1, 12, 4) else A.piece(10, h - 8, 0, 12, 1, 32, 4) end
        Cons(trench, base)
      else base end end end end
    end
  end
  pfn park_paths(c : Ur.Sim.City, i : Int, y : Int, d : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if d == 4 do base else
      let j = S.neighbour(i, d)
      let next = if S.pedestrian_edge(c, i, j) && (S.get(c.parks, j) > 0 || S.pedestrian_tile(c, j)) do
        let piece = match d do
          0 -> A.piece(0, y, 14, 13, 1, 4, 16)
          1 -> A.piece(19, y, 14, 13, 1, 4, 16)
          2 -> A.piece(14, y, 0, 4, 1, 13, 16)
          _ -> A.piece(14, y, 19, 4, 1, 13, 16)
        end
        Cons(piece, base)
      else base end
      park_paths(c, i, y, d + 1, next)
    end
  end
  pfn flower_bed(x : Int, y : Int, z : Int, tint : Int) : List(Ur.Architecture.Piece) do
    [A.piece(x, y, z, 7, 1, 5, 23),
     A.piece(x + 1, y + 1, z + 1, 5, 1, 3, 21),
     A.piece(x + 1, y + 2, z + 1, 2, 1, 1, tint),
     A.piece(x + 3, y + 2, z + 3, 1, 1, 1, 8),
     A.piece(x + 4, y + 2, z + 2, 2, 1, 1, tint)]
  end
  pfn park_bench(x : Int, y : Int, z : Int) : List(Ur.Architecture.Piece) do
    [A.piece(x, y, z + 1, 1, 2, 2, 19),
     A.piece(x + 5, y, z + 1, 1, 2, 2, 19),
     A.piece(x, y + 2, z, 6, 1, 3, 13),
     A.piece(x, y + 3, z, 6, 2, 1, 7)]
  end
  pfn park_fountain(y : Int, landmark : Bool) : List(Ur.Architecture.Piece) do
    let basin = [A.piece(20, y, 20, 10, 1, 10, 17),
      A.piece(21, y + 1, 21, 8, 1, 8, 9),
      A.piece(20, y + 1, 20, 10, 2, 1, 8), A.piece(20, y + 1, 29, 10, 2, 1, 8),
      A.piece(20, y + 1, 21, 1, 2, 8, 8), A.piece(29, y + 1, 21, 1, 2, 8, 8),
      A.piece(24, y + 2, 24, 2, 2, 2, 7)]
    let spray = if landmark do
      [A.piece(24, y + 4, 24, 2, 3, 2, 8), A.piece(23, y + 7, 23, 4, 1, 4, 7),
       A.piece(24, y + 8, 24, 2, 2, 2, 12), A.piece(24, y + 5, 22, 1, 2, 1, 12),
       A.piece(26, y + 5, 25, 1, 2, 1, 12)]
    else [A.piece(24, y + 4, 24, 1, 2, 1, 12)] end
    List.append(spray, basin)
  end
  pfn park_shelter(y : Int) : List(Ur.Architecture.Piece) do
    [A.piece(20, y, 20, 10, 1, 10, 16),
     A.piece(21, y + 1, 21, 1, 7, 1, 7), A.piece(28, y + 1, 21, 1, 7, 1, 7),
     A.piece(21, y + 1, 28, 1, 7, 1, 7), A.piece(28, y + 1, 28, 1, 7, 1, 7),
     A.piece(20, y + 8, 20, 10, 1, 10, 8), A.piece(21, y + 9, 22, 8, 1, 6, 7),
     A.piece(22, y + 1, 26, 6, 2, 2, 13)]
  end
  pfn park(c : Ur.Sim.City, i : Int) : List(Ur.Architecture.Piece) do
    let ground = S.get(c.heights, i)
    let y = ground + 1
    let size = S.get(c.parks, i)
    let tier = S.get(c.park_tiers, i)
    let seed = (i * 37 + i / S.width() * 17) % 101
    let lawn = [A.piece(0, ground, 0, 32, 1, 32, 22)]
    let paving = [A.piece(13, y, 13, 6, 1, 6, 16),
      A.piece(12, y, 12, 2, 1, 1, 23), A.piece(18, y, 19, 2, 1, 1, 23)]
    let paths = park_paths(c, i, y, 0, List.append(paving, lawn))
    let grove = Ur.Trees.shape(match (seed / 3) % 4 do 0 -> 3 | 1 -> 0 | 2 -> 4 | _ -> 5 end, 7 + seed % 3, 23 + seed % 3, y, Strata.Seed.mix(i, 17))
    let flowers = flower_bed(3, y, 4, if seed % 2 == 0 do 15 else 18 end)
    let seating = List.append(park_bench(22, y, 8), List.append(flowers, grove))
    let feature = if tier == 2 && (size == 1 || seed % 3 == 0) do park_fountain(y, true)
      else if tier == 2 do park_shelter(y)
      else if tier == 1 && seed % 2 == 0 do park_fountain(y, false)
      else if tier == 1 do park_shelter(y)
      else if size >= 5 && seed % 4 == 0 do park_fountain(y, false)
      else flower_bed(22, y, 23, 10) end end end end end
    -- Turn the landscaping independently so adjoining tiles keep their paths aligned.
    List.append(A.orient(List.append(feature, seating), seed / 4 % 4), paths)
  end
  pfn street_planting(c : Ur.Sim.City, i : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let kind = S.get(c.streetscape, i)
    if kind == 0 || S.get(c.roads, i) == 0 do base else
      let y = S.get(c.heights, i) + 1
      let curb = Cons(A.piece(0, y, 25, 2, 2, 6, 23), Cons(A.piece(0, y + 2, 26, 2, 1, 4, 13), Nil))
      let planting = match kind do
        1 -> Cons(A.piece(0, y + 3, 27, 2, 9, 2, 13), Cons(A.piece(0, y + 10, 24, 8, 4, 8, 14),
             Cons(A.piece(1, y + 14, 25, 6, 3, 6, 21), curb)))
        2 -> Cons(A.piece(0, y + 3, 27, 2, 8, 2, 13), Cons(A.piece(0, y + 9, 24, 8, 4, 8, 18),
             Cons(A.piece(1, y + 13, 25, 6, 3, 6, 15), curb)))
        3 -> Cons(A.piece(0, y + 3, 27, 2, 15, 2, 13), Cons(A.piece(0, y + 8, 25, 5, 9, 6, 14),
             Cons(A.piece(1, y + 17, 26, 3, 5, 4, 21), curb)))
        4 -> Cons(A.piece(0, y + 3, 26, 2, 1, 4, 21), Cons(A.piece(0, y + 4, 26, 2, 1, 1, 15),
             Cons(A.piece(0, y + 4, 28, 2, 1, 1, 10), curb)))
        _ -> Cons(A.piece(0, y + 3, 26, 2, 3, 4, 14), Cons(A.piece(0, y + 6, 27, 2, 1, 2, 11), curb))
      end
      let north_south = S.street_link(c, i, 2) || S.street_link(c, i, 3)
      let across = S.street_link(c, i, 0) || S.street_link(c, i, 1)
      let curb_side = if north_south && !across do 3 else 1 end
      List.append(A.orient(planting, curb_side), base)
    end
  end
  pfn sidewalk_objects(c : Ur.Sim.City, lot : Int, spot : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if spot == 4 do base else
      let kind = S.sidewalk_item(c, lot, spot)
      let (x, z) = S.sidewalk_point(c, lot, spot)
      let y = if kind == 0 || x < 0 do 0 else sidewalk_height(c, lot, x, z) end
      let parts = if y == 0 do Nil
        else if kind == 6 do [
          A.piece(x - 1, y, z - 1, 3, 1, 3, 19), A.piece(x - 1, y + 1, z - 1, 3, 3, 3, 7),
          A.piece(x - 1, y + 4, z - 1, 3, 1, 3, 19), A.piece(x, y + 5, z, 1, 1, 1, 17),
          A.piece(x, y + 2, z - 1, 1, 1, 1, 8)]
        else if kind >= 4 do [
          A.piece(x - 1, y, z - 1, 3, 1, 3, 23),
          A.piece(x - 1, y + 1, z - 1, 3, 1, 3, 17),
          A.piece(x - 1, y + 2, z - 1, 3, if kind == 5 do 3 else 1 end, 3, 21),
          A.piece(x, y + (if kind == 4 do 3 else 5 end), z, 1, 1, 1, if kind == 4 do 15 else 14 end)]
        else
          let width = if kind == 3 do 5 else 9 end
          let height = if kind == 3 do 10 else 6 end
          let crown_x = S.clamp(x - width / 2, 0, 32 - width)
          let crown_z = S.clamp(z - width / 2, 0, 32 - width)
          [A.piece(x - 1, y, z - 1, 3, 1, 3, 17), A.piece(x, y + 1, z, 1, 10, 1, 13),
           A.piece(crown_x + 1, y + 8, crown_z + 1, width - 2, 2, width - 2, if kind == 2 do 18 else 14 end),
           A.piece(crown_x, y + 10, crown_z + 1, width, height - 2, width - 2, if kind == 2 do 18 else 14 end),
           A.piece(crown_x + 1, y + 10, crown_z, width - 2, height - 2, 1, if kind == 2 do 18 else 14 end),
           A.piece(crown_x + 1, y + 10, crown_z + width - 1, width - 2, height - 2, 1, if kind == 2 do 18 else 14 end),
           A.piece(crown_x + 1, y + 8 + height, crown_z + 1, width - 2, 2, width - 2, if kind == 2 do 15 else 21 end)]
        end end end
      sidewalk_objects(c, lot, spot + 1, List.append(parts, base))
    end
  end
  pfn seawall_parts(c : Ur.Sim.City, lot : Int) : List(Ur.Architecture.Piece) do
    let west = S.get(c.seawalls, S.neighbour(lot, 0)) > 0
    let east = S.get(c.seawalls, S.neighbour(lot, 1)) > 0
    let north = S.get(c.seawalls, S.neighbour(lot, 2)) > 0
    let south = S.get(c.seawalls, S.neighbour(lot, 3)) > 0
    let horizontal = west || east || (!north && !south)
    let x = if west || (!west && !east) do 0 else 12 end
    let end_x = if east || (!west && !east) do 32 else 20 end
    let z = if north do 0 else 12 end
    let end_z = if south do 32 else 20 end
    let base = if horizontal do [A.piece(x, 0, 12, end_x - x, 16, 8, 2), A.piece(x, 16, 11, end_x - x, 2, 10, 24)] else Nil end
    if north || south do
      Cons(A.piece(11, 16, z, 10, 2, end_z - z, 24), Cons(A.piece(12, 0, z, 8, 16, end_z - z, 2), base))
    else base end
  end
  pfn canal_bank(c : Ur.Sim.City, i : Int, at : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if at >= 16 do parts else
      let x = at % 4 * 8
      let z = at / 4 * 8
      let parts = if S.canal_wet(c, i, x + 4, z + 4) do parts
        else Cons(A.piece(x, S.canal_bank_height(c, i), z, 8, 1, 8, 24), parts) end
      canal_bank(c, i, at + 1, parts)
    end
  end
  pfn canal_piece(east : Bool, u : Int, y : Int, v : Int, length : Int, h : Int, breadth : Int, material : Int) : Ur.Architecture.Piece do
    if east do A.piece(u, y, v, length, h, breadth, material)
    else A.piece(v, y, u, breadth, h, length, material) end
  end
  pfn coast_lock_gate(c : Ur.Sim.City, lot : Int, side : Int) : List(Ur.Architecture.Piece) do
    if side >= 4 do Nil else if !(S.canal_outlet(c, lot, side) || S.canal_port_side(c, lot, side)) do coast_lock_gate(c, lot, side + 1) else
      let inland = S.neighbour(lot, S.opposite(side))
      let upper = S.canal_level(c, inland)
      if upper <= 0 do Nil else
        let at = if side % 2 == 0 do 30 else 0 end
        let east = side < 2
        [canal_piece(east, at, 0, 8, 2, upper + 1, 16, 13),
          canal_piece(east, at, upper + 1, 8, 2, 1, 16, 7)]
      end
    end end
  end
  pfn dry_quay(c : Ur.Sim.City, lot : Int, bank : Int, colour : Int) : List(Ur.Architecture.Piece) do
    let banks = List.filter([0, 1, 2, 3], fn side -> !S.canal_arm(c, lot, side))
    let preferred = List.find(banks, fn side -> S.motor_street(c, S.neighbour(lot, side)))
    let side = match preferred do
      Some(d) -> d
      None -> match banks do Cons(d, _) -> d | Nil -> -1 end
    end
    if side < 0 do
      [A.piece(1, bank + 1, 25, 6, 1, 6, 17), A.piece(2, bank + 2, 26, 4, 3, 4, 8),
        A.piece(1, bank + 5, 25, 6, 1, 6, colour)]
    else
      A.orient([A.piece(3, bank + 1, 24, 26, 1, 7, 17),
        A.piece(4, bank + 2, 25, 6, 4, 5, 8), A.piece(3, bank + 6, 24, 8, 1, 7, colour),
        A.piece(14, bank + 2, 27, 6, 1, 3, 5),
        A.piece(25, bank + 2, 24, 1, 2, 1, 13)], side)
    end
  end
  pfn automatic_gate_works(c : Ur.Sim.City, lot : Int, bank : Int, water : Int) : List(Ur.Architecture.Piece) do
    let closed = S.canal_gate_closed(c, lot)
    let top = Math.max_int(water + 17, bank + 3)
    let outlets = List.filter([0, 1, 2, 3], fn side -> S.canal_outlet(c, lot, side))
    List.flat_map(outlets, fn side -> A.orient([
      A.piece(5, 0, 28, 3, top, 4, 19),
      A.piece(24, 0, 28, 3, top, 4, 19),
      A.piece(5, top, 28, 3, 1, 4, 17),
      A.piece(24, top, 28, 3, 1, 4, 17),
      A.piece(6, top + 1, 30, 2, 1, 1, if closed do 30 else 20 end),
      A.piece(24, top + 1, 30, 2, 1, 1, if closed do 30 else 20 end)
    ], side))
  end
  fn crane_rail_height(c : Ur.Sim.City, lot : Int) : Int do
    S.canal_bank_height(c, lot) + 19
  end
  pfn canal_cranes(c : Ur.Sim.City, lot : Int, bank : Int) : List(Ur.Architecture.Piece) do
    let rail = crane_rail_height(c, lot)
    List.flat_map(List.filter([0, 1, 2, 3], fn side -> S.canal_crane_site(c, lot, side)), fn side ->
      let equipment = if S.get(c.canal_docks, lot) == 2 && S.canal_crane_bank(c, lot) == side do Nil else [
        A.piece(10, rail + 1, 25, 8, 2, 4, 19),
        A.piece(13, rail - 2, 26, 2, 4, 2, 19),
        A.piece(12, rail - 4, 25, 4, 2, 4, 10)
      ] end
      A.orient(List.append(equipment, [
        A.piece(7, bank + 1, 24, 16, 1, 8, 17),
        A.piece(9, bank + 2, 28, 2, 17, 3, 19),
        A.piece(17, bank + 2, 28, 2, 17, 3, 19),
        A.piece(9, bank + 8, 29, 10, 2, 1, 10),
        A.piece(9, rail - 3, 28, 10, 3, 3, 19),
        A.piece(10, rail, 14, 2, 2, 18, 10),
        A.piece(16, rail, 14, 2, 2, 18, 10),
        A.piece(10, rail + 2, 14, 8, 2, 2, 10),
        A.piece(10, rail + 2, 23, 8, 1, 2, 10),
        A.piece(9, rail + 2, 28, 10, 3, 4, 19),
        A.piece(8, rail - 4, 24, 4, 4, 4, 7),
        A.piece(8, rail - 2, 23, 4, 2, 1, 9),
        A.piece(8, bank + 2, 25, 3, 3, 3, 6),
        A.piece(19, bank + 2, 27, 3, 2, 4, 8)
      ]), side))
  end
  pfn water_bus_berth(c : Ur.Sim.City, lot : Int, bank : Int, water : Int) : List(Ur.Architecture.Piece) do
    let side = S.water_bus_bank(c, lot)
    if side < 0 do Nil else
      let yard = S.water_bus_yard(c, lot)
      let pier = if yard do [
        A.piece(5, bank + 1, 25, 21, 1, 7, 17),
        A.piece(5, bank + 2, 28, 2, 6, 4, 19),
        A.piece(24, bank + 2, 28, 2, 6, 4, 19),
        A.piece(5, bank + 7, 25, 21, 2, 7, 7),
        A.piece(7, bank + 2, 30, 17, 4, 2, 9),
        A.piece(8, bank + 2, 26, 4, 2, 2, 10),
        A.piece(19, bank + 2, 26, 4, 2, 2, 10)
      ] else [
        A.piece(7, bank + 1, 26, 18, 1, 6, 17),
        A.piece(8, bank + 2, 29, 1, 5, 2, 19),
        A.piece(22, bank + 2, 29, 1, 5, 2, 19),
        A.piece(9, bank + 3, 30, 13, 3, 1, 9),
        A.piece(7, bank + 7, 26, 17, 1, 5, 7),
        A.piece(25, bank + 2, 26, 1, 4, 1, 19),
        A.piece(24, bank + 6, 26, 3, 2, 1, 10)
      ] end
      A.orient(List.append(pier, [
        A.piece(5, water + 1, 22, 22, 2, 3, 13),
        A.piece(5, water + 1, 22, 2, bank - water + 3, 2, 19),
        A.piece(25, water + 1, 22, 2, bank - water + 3, 2, 19)
      ]), side)
    end
  end
  pfn canal_parts(c : Ur.Sim.City, i : Int) : List(Ur.Architecture.Piece) do
    let east = S.canal_outlet(c, i, 0) || S.canal_outlet(c, i, 1) ||
      (!(S.canal_outlet(c, i, 2) || S.canal_outlet(c, i, 3)) && (S.canal_arm(c, i, 0) || S.canal_arm(c, i, 1)))
    let bank = S.canal_bank_height(c, i)
    let water = S.canal_level(c, i)
    let kind = S.get(c.canals, i)
    let dock = S.get(c.canal_docks, i)
    let works = if S.automatic_canal_gate(c, i) do automatic_gate_works(c, i, bank, water)
      else if kind == 2 do List.append(coast_lock_gate(c, i, 0), [
      canal_piece(east, 4, water, 8, 24, bank - water + 2, 2, 13),
      canal_piece(east, 4, water, 22, 24, bank - water + 2, 2, 13),
      canal_piece(east, 4, bank, 9, 1, 3, 2, 7),
      canal_piece(east, 27, bank, 21, 1, 3, 2, 7)
    ]) else if kind >= 3 do [
      canal_piece(east, 15, bank, 7, 2, 9, 3, 13),
      canal_piece(east, 15, bank, 22, 2, 9, 3, 13),
      canal_piece(east, 15, if kind == 4 do water else bank + 5 end, 8, 2,
        if kind == 4 do bank - water + 3 else 3 end, 16, 7)
    ] else Nil end end end
    let quays = if dock > 0 || i == c.harbour_basin do
      List.append(dry_quay(c, i, bank, if dock == 1 do 7 else 10 end), works)
      else works end
    canal_bank(c, i, 0, List.append(if S.water_bus_site(c, i) do water_bus_berth(c, i, bank, water) else Nil end,
      List.append(canal_cranes(c, i, bank), quays)))
  end
  pfn harbour_quay(c : Ur.Sim.City, lot : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let side = S.harbour_quay_side(c)
    if side < 0 do base else
      let h = S.get(c.heights, lot)
      let quay = [A.piece(5, 0, 29, 22, h + 1, 3, 17),
        A.piece(6, h + 1, 26, 4, 3, 4, 7), A.piece(22, h + 1, 26, 4, 3, 4, 10),
        A.piece(8, h + 1, 30, 1, 2, 1, 13), A.piece(23, h + 1, 30, 1, 2, 1, 13)]
      List.append(A.orient(quay, side), base)
    end
  end

  pfn tram_arm(c : Ur.Sim.City, lot : Int, arm : Int) : Bool do
    let peer = S.neighbour(lot, arm)
    S.get(c.transit, peer) == 3 && int_abs(S.get(c.heights, lot) - S.get(c.heights, peer)) <= 12
  end
  fn tram_bend(c : Ur.Sim.City, lot : Int) : Bool do
    tram_arm(c, lot, 0) != tram_arm(c, lot, 1) && tram_arm(c, lot, 2) != tram_arm(c, lot, 3)
  end
  type TramGrade = { deck : Int, axis : Int, before : Int, after : Int, west : Int, east : Int, north : Int, south : Int }
  pfn tram_deck(c : Ur.Sim.City, lot : Int) : Int do
    let h = S.get(c.heights, lot)
    if h == 0 do 2 else h end
  end
  pfn tram_rise(c : Ur.Sim.City, lot : Int, arm : Int, deck : Int, axis : Int, street_peer : Int, linked : Bool) : Int do
    let target = tram_deck(c, S.neighbour(lot, arm))
    if !linked || (axis == arm / 2 * 2 && street_peer == target) do 0
    else Math.max_int(0, target - deck) end
  end
  pfn tram_grade(c : Ur.Sim.City, lot : Int, west : Bool, east : Bool, north : Bool, south : Bool) : TramGrade do
    let deck = tram_deck(c, lot)
    let (axis, before, after) = road_profile(c, lot)
    let axis = if axis >= 0 && RoadSurface.uses_curve(c, lot) do -1 else axis end
    { deck: deck, axis: axis, before: before, after: after,
      west: tram_rise(c, lot, 0, deck, axis, before, west),
      east: tram_rise(c, lot, 1, deck, axis, after, east),
      north: tram_rise(c, lot, 2, deck, axis, before, north),
      south: tram_rise(c, lot, 3, deck, axis, after, south) }
  end
  pfn tram_surface(g : TramGrade, x : Int, z : Int) : Int do
    let along = if g.axis == 0 do x else z end
    if g.axis < 0 do g.deck else graded_height(g.deck, g.before, g.after, along / 4 * 4 + 2) end
  end
  pfn tram_rail_base(g : TramGrade, x : Int, z : Int) : Int do
    -- Keep the curve and crossing flat so each approach meets its own neighbor.
    let horizontal = Math.max_int((11 - x) * g.west, (x - 20) * g.east)
    let vertical = Math.max_int((11 - z) * g.north, (z - 20) * g.south)
    let rise = Math.max_int(horizontal, vertical)
    let deck = if rise > 0 do Math.max_int(g.deck + (rise + 5) / 11, tram_surface(g, x, z))
      else tram_surface(g, x, z) end
    deck + 1
  end
  fn tram_track_height(c : Ur.Sim.City, lot : Int, x : Int, z : Int) : Int do
    let grade = tram_grade(c, lot, tram_arm(c, lot, 0), tram_arm(c, lot, 1), tram_arm(c, lot, 2), tram_arm(c, lot, 3))
    tram_rail_base(grade, x, z) + 1
  end
  pfn tram_gauge(at : Int) : Bool do at == 13 || at == 18 end
  -- In the north-west bend, the wheel paths are 2.5 voxels either side
  -- of a radius-four centre line. Reflect the same bend for the other corners.
  pfn tram_curve_cell(x : Int, z : Int) : Bool do
    if x < 12 do tram_gauge(z)
    else if z < 12 do tram_gauge(x)
    else
      let dx = (x - 12) * 2
      let dz = (z - 12) * 2
      -- Include every voxel the rail crosses so the stepped mesh has no gaps.
      let near = dx * dx + dz * dz
      let far = (dx + 2) * (dx + 2) + (dz + 2) * (dz + 2)
      (near < 9 && far > 9) || (near < 169 && far > 169)
    end end
  end
  pfn tram_curve_row(y : Int, west : Bool, north : Bool, x : Int, z : Int, start : Int,
    out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if x < 20 && tram_curve_cell(x, z) do
      tram_curve_row(y, west, north, x + 1, z, if start < 0 do x else start end, out)
    else
      let out = if start < 0 do out else
        Cons(A.piece(if west do start else 32 - x end, y, if north do z else 31 - z end,
          x - start, 1, 1, 17), out)
      end
      if x == 20 do out else tram_curve_row(y, west, north, x + 1, z, -1, out) end
    end
  end
  pfn tram_straight(y : Int, horizontal : Bool, first : Int, last : Int) : List(Ur.Architecture.Piece) do
    List.map([13, 18], fn at ->
      if horizontal do A.piece(first, y, at, last - first, 1, 1, 17)
      else A.piece(at, y, first, 1, 1, last - first, 17) end)
  end
  pfn tram_rail_span(p : Ur.Architecture.Piece, g : TramGrade, along_x : Bool, start : Int, finish : Int,
    out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if start >= finish do out else
      let x = if along_x do start else p.x end
      let z = if along_x do p.z else start end
      let y = tram_rail_base(g, x, z)
      let surface = tram_surface(g, x, z) + 1
      let out = if y > surface do Cons(A.piece(x, surface, z, 1, y - surface, 1, 19), out) else out end
      tram_rail_span(p, g, along_x, start + 1, finish, Cons(A.piece(x, y, z, 1, 1, 1, p.material), out))
    end
  end
  pfn tram_tracks(c : Ur.Sim.City, i : Int) : List(Ur.Architecture.Piece) do
    let y = tram_deck(c, i) + 1
    let west = tram_arm(c, i, 0)
    let east = tram_arm(c, i, 1)
    let north = tram_arm(c, i, 2)
    let south = tram_arm(c, i, 3)
    let horizontal = west || east
    let vertical = north || south
    let rails = if west != east && north != south do
      List.fold_left(List.range(0, 20), Nil, fn (out, z) -> tram_curve_row(y, west, north, 0, z, -1, out))
    else
      let isolated = !horizontal && !vertical
      -- At a route end the rear wheels still need track behind the parcel center.
      let (first, last) = if horizontal && vertical do (13, 19) else (9, 23) end
      let along = if horizontal do
        tram_straight(y, true, if west do 0 else first end, if east do 32 else last end)
        else Nil end
      let across = if vertical || isolated do
        tram_straight(y, false, if north do 0 else first end, if south do 32 else last end)
        else Nil end
      List.fold_left(across, along, fn (parts, rail) -> Cons(rail, cut_road_pieces(parts, rail)))
    end
    let grade = tram_grade(c, i, west, east, north, south)
    if grade.west + grade.east + grade.north + grade.south > 0 do
      List.fold_left(rails, Nil, fn (out, p) ->
        if p.d == 1 do tram_rail_span(p, grade, true, p.x, p.x + p.w, out)
        else tram_rail_span(p, grade, false, p.z, p.z + p.d, out) end)
    else if grade.axis >= 0 do grade_road(rails, grade.axis, grade.deck, grade.before, grade.after)
    else rails end end
  end
  pfn tram_stop(c : Ur.Sim.City, i : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let h = S.get(c.heights, i)
    let road = S.get(c.roads, i)
    let east = if road > 0 do S.street_link(c, i, 0) || S.street_link(c, i, 1)
      else tram_arm(c, i, 0) || tram_arm(c, i, 1) end
    let near = tram_arm(c, i, if east do 2 else 0 end)
    let far = tram_arm(c, i, if east do 3 else 1 end)
    let along = if near && far do 1 else 10 end
    let side = if east do (if far && !near do 2 else 3 end)
      else (if far && !near do 0 else 1 end) end
    let across = if road > 0 do 16 + S.road_half_width(road) + 1 else 21 end
    let edge = if side % 2 == 0 do 31 - across else across end
    let at = if side == 1 || side == 2 do 25 - along else along + 6 end
    let y = if road > 0 do sidewalk_height(c, i, if east do at else edge end, if east do edge else at end)
      else h end
    let platform = if road == 0 do [A.piece(along, y, across - 1, 12, 1, 5, 23),
      A.piece(along, y + 1, across, 12, 1, 4, 23), A.piece(along, y + 1, across - 1, 12, 1, 1, 10)]
      else Nil end
    let y = if road == 0 do y + 2 else y end
    let sign = [A.piece(along + 6, y, across, 1, 5, 1, 19), A.piece(along + 4, y + 5, across, 5, 2, 1, 7),
      A.piece(along + 5, y + 5, across - 1, 3, 1, 1, 20)]
    List.append(A.orient(List.append(sign, platform), side), base)
  end

  ptype SubwaySite = { side : Int, x : Int, z : Int, depth : Int, floor : Int }
  pfn subway_site(c : Ur.Sim.City, i : Int, base : List(Ur.Architecture.Piece), side : Int, x : Int,
    z : Int, depth : Int) : Option(SubwaySite) do
    match A.orient([A.piece(x, 0, z, 10, 1, depth, 0)], side) do
      Cons(p, _) ->
        let road = S.get(c.roads, i) > 0
        let floor = if road do sidewalk_height(c, i, p.x + p.w / 2, p.z + p.d / 2)
          else S.get(c.heights, i) + 1 end
        let footprint = { x: p.x, z: p.z, w: p.w, d: p.d }
        let blocked = List.any(base, fn q ->
          let sidewalk = road && q.h <= 2 && (q.material == 23 || q.material == 24)
          overlaps(q, footprint) && !sidewalk && (q.y + q.h > floor || (road && q.y >= floor - 3)))
        if blocked do None else Some({ side: side, x: x, z: z, depth: depth, floor: floor }) end
      Nil -> None
    end
  end
  pfn subway_entrance(site : SubwaySite) : List(Ur.Architecture.Piece) do
    let x = site.x
    let z = site.z
    let y = site.floor
    let d = site.depth
    let front = z + d - 1
    let roof = if d <= 4 do d else d - 3 end
    let stairs = if d >= 4 do
      [A.piece(x + 1, y, front - 2, 8, 1, 1, 23), A.piece(x + 1, y, front - 1, 8, 2, 1, 23),
        A.piece(x + 1, y, front, 8, 3, 1, 24)]
      else [A.piece(x + 1, y, front, 8, 1, 1, 24)] end
    A.orient(List.append(stairs, [
      A.piece(x, y, z, 1, 3, d, 23), A.piece(x + 9, y, z, 1, 3, d, 23),
      A.piece(x + 1, y, z, 8, 7, 1, 19),
      A.piece(x, y + 3, z, 1, 4, roof - 1, 3), A.piece(x + 9, y + 3, z, 1, 4, roof - 1, 3),
      A.piece(x, y + 7, z, 10, 1, roof, 7), A.piece(x, y + 8, z, 10, 1, roof, 24),
      A.piece(x + 2, y + 9, z + roof - 2, 6, 4, 1, 7),
      A.piece(x + 3, y + 10, z + roof - 1, 1, 2, 1, 20),
      A.piece(x + 4, y + 10, z + roof - 1, 2, 1, 1, 20),
      A.piece(x + 6, y + 10, z + roof - 1, 1, 2, 1, 20)
    ]), site.side)
  end
  pfn subway_station(c : Ur.Sim.City, i : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let road = S.get(c.roads, i)
    let front = frontage(c, i, 0)
    let sides = if road > 0 do [3, 2, 0, 1]
      else Cons(front, List.filter([3, 2, 0, 1], fn side -> side != front)) end
    let depth = if road > 0 do S.sidewalk_width(road) else 11 end
    let z = if road > 0 do 0 else 32 - depth end
    let sites = List.flat_map(sides, fn side -> List.map([11, 2, 20], fn x -> (side, x)))
    let site = List.fold_left(sites, None, fn (found, candidate) ->
      let (side, x) = candidate
      if Option.is_some(found) do found else subway_site(c, i, base, side, x, z, depth) end)
    match site do
      Some(site) ->
        let h = S.get(c.heights, i)
        let pad = A.orient([A.piece(site.x, h, site.z, 10, Math.max_int(0, site.floor - h), site.depth, 24)], site.side)
        let pad = List.fold_left(base, pad, fn (parts, piece) ->
          if piece.y < site.floor && piece.y + piece.h > h do cut_road_pieces(parts, piece) else parts end)
        List.append(subway_entrance(site), List.append(List.filter(pad, fn piece -> piece.h > 0), base))
      None ->
        -- Preserve a street-level marker where a crossing or another building
        -- occupies every shoulder wide enough for the stairwell.
        let y = S.get(c.heights, i) + 2
        let marker = [A.piece(15, y, 31, 1, 5, 1, 19), A.piece(14, y + 5, 31, 3, 2, 1, 20)]
        List.append(A.orient(marker, front), base)
    end
  end

  pfn ordinary_landscape(c : Ur.Sim.City, i : Int, lighting : Int, clearings : List(Clearing)) : List(Ur.Architecture.Piece) do
    let base = if S.canal_water(c, i) do canal_parts(c, i)
      else if S.get(c.seawalls, i) > 0 do seawall_parts(c, i)
      else if S.get(c.parks, i) > 0 do park(c, i) else buildings_and_land(c, i, lighting, clearings) end end end
    let base = if i == c.harbour && !S.valid(c.harbour_basin) do harbour_quay(c, i, base) else base end
    let spill = RoadSurface.pieces(c, i, false)
    if List.is_empty(spill) do base else
      -- Street shoulders displace natural decorations in their neighboring parcel.
      let clear = List.filter(base, fn piece -> !List.any(spill, fn paving ->
        piece.x < paving.x + paving.w && piece.x + piece.w > paving.x &&
        piece.z < paving.z + paving.d && piece.z + piece.d > paving.z))
      List.append(spill, clear)
    end
  end
  fn structures(c : Ur.Sim.City, i : Int, lighting : Int) : List(Ur.Architecture.Piece) do
    structures_cleared(c, i, lighting, Nil)
  end
  fn structures_cleared(c : Ur.Sim.City, i : Int, lighting : Int, clearings : List(Clearing)) : List(Ur.Architecture.Piece) do
    let quay = S.get(c.quays, i) - 1
    let base = if quay >= 0 do QuayArt.promenade(S.get(c.heights, i), i, lighting, quay, S.quay_side(c, i) >= 0)
      else ordinary_landscape(c, i, lighting, clearings) end
    let mooring = if S.get(c.heights, i) == 0 do S.quay_mooring(c, i) else -1 end
    let base = if mooring < 0 do base else
      let boat = QuayArt.moored_boat(S.get(c.heights, S.neighbour(i, mooring)), i, mooring)
      let clear = List.filter(base, fn p -> !List.any(boat, fn b -> overlaps(p, { x: b.x, z: b.z, w: b.w, d: b.d })))
      List.append(boat, clear)
    end
    let base = if S.get(c.public_parking, i) == 3 do List.append(base, parking_pieces(c, i)) else base end
    let base = if quay < 0 && S.get(c.roads, i) > 0 && S.get(c.heights, i) > 0 &&
      S.get(c.road_shapes, i) == 0 && (i % S.width() + i / S.width()) % 2 == 0 do
      let deck = S.get(c.heights, i)
      let east = S.street_link(c, i, 0) || S.street_link(c, i, 1)
      let north = S.street_link(c, i, 2) || S.street_link(c, i, 3)
      let bulb = S.street_end_arm(c, i)
      let x = if bulb >= 2 do 1 else if east && !north do 16 else 3 end end
      let z = if bulb >= 0 && bulb < 2 do 1 else if north && !east do 16 else 3 end end
      let lens = if lighting / 4 % 2 == 1 do 28 else 8 end
      Cons(A.piece(x, deck + 1, z, 1, 12, 1, 13), Cons(A.piece(x, deck + 12, z, 3, 1, 2, lens), base))
    else base end
    let bins = S.get(c.waste_bins, i)
    let base = if bins == 2 || (bins == 1 && S.sidewalk_cans(c, i) == 0) do
      let y = S.get(c.heights, i) + 1
      let edge = S.waste_bin_edge(c, i)
      if bins == 2 && edge >= 0 do
        -- The hatch and intake occupy the same curb bay used by parked cars.
        let curb = S.road_half_width(S.get(c.roads, i)) - 2
        let x = if edge == 0 do 16 - curb else if edge == 1 do 16 + curb else if edge == 2 do 22 else 10 end end end
        let z = if edge == 2 do 16 - curb else if edge == 3 do 16 + curb else if edge == 0 do 10 else 22 end end end
        let plate = [A.piece(x - 3, y, z - 3, 7, 1, 7, 19), A.piece(x - 2, y + 1, z - 2, 5, 1, 5, 17),
          A.piece(x - 2, y + 2, z, 4, 2, 3, 7), A.piece(x - 2, y + 4, z - 1, 5, 1, 4, 8),
          A.piece(x - 1, y + 3, z - 1, 3, 1, 1, 19), A.piece(x - 3, y + 1, z + 3, 2, 1, 1, 10),
          A.piece(x + 2, y + 1, z - 3, 2, 1, 1, 10), A.piece(x + 2, y + 1, z + 1, 1, 1, 2, 19)]
        List.append(plate, base)
      else
        let east = S.street_link(c, i, 0) || S.street_link(c, i, 1)
        let (x, z) = if east do (11, 28) else (28, 11) end
        let cans = [A.piece(x, y, z, 3, 1, 3, 19), A.piece(x, y + 1, z, 3, 3, 3, 7),
          A.piece(x, y + 4, z, 3, 1, 3, 19), A.piece(x + 1, y + 5, z + 1, 1, 1, 1, 17),
          A.piece(x + 1, y + 2, z, 1, 1, 1, 8)]
        List.append(cans, base)
      end
    else base end
    let base = if S.get(c.sidewalk_items, i) > 0 do sidewalk_objects(c, i, 0, base) else base end
    let base = grade_parts(c, i, lighting, street_planting(c, i, base))
    let base = if S.car_free_now(c, i) && S.motor_street(c, i) do
      let y = S.get(c.heights, i) + 1
      Cons(A.piece(2, y, 14, 2, 4, 2, 10), Cons(A.piece(28, y, 17, 2, 4, 2, 10), base))
    else base end
    let y = S.get(c.heights, i) + 1
    let mode = S.get(c.transit, i)
    let stop = S.get(c.stops, i) == mode
    let base = match mode do
      1 -> Cons(A.piece(12, y, 0, 8, 1, 32, 16), Cons(A.piece(0, y, 12, 32, 1, 8, 16), base))
      2 -> if stop do Cons(A.piece(1, y, 2, 3, 7, 1, 20), Cons(A.piece(1, y, 3, 4, 1, 7, 7), base)) else base end
      3 ->
        let base = if stop do tram_stop(c, i, base) else base end
        List.append(tram_tracks(c, i), base)
      4 -> if stop do subway_station(c, i, base) else base end
      _ -> base
    end
    if S.get(c.ferries, i) > 0 && S.get(c.canal_docks, i) == 0 &&
      (i != c.harbour || !S.valid(c.harbour_basin)) do
      let terminal = [A.piece(3, 0, 3, 26, y, 26, 17),
        A.piece(5, y, 5, 9, 7, 9, 8), A.piece(4, y + 7, 4, 11, 1, 11, 7),
        A.piece(6, y + 8, 6, 7, 1, 7, 19), A.piece(6, y + 3, 14, 6, 3, 1, 9),
        A.piece(14, y + 3, 7, 1, 3, 5, 9), A.piece(8, y, 15, 4, 1, 10, 16),
        A.piece(16, y, 19, 2, 5, 2, 19), A.piece(23, y, 19, 2, 5, 2, 19),
        A.piece(16, y + 5, 18, 9, 1, 4, 7), A.piece(20, y + 7, 20, 3, 1, 3, 8),
        A.piece(20, y, 20, 1, 7, 1, 19), A.piece(21, y + 5, 20, 2, 2, 1, 9)]
      List.append(terminal, base)
    else base end
  end

end
