mod Ur.Landscape do
  alias Ur.Sim as S
  alias Ur.Architecture as A
  pfn road_axis(c : Ur.Sim.City, lot : Int) : Int do
    if !S.valid(lot) || S.get(c.heights, lot) == 0 || S.get(c.roads, lot) == 0 || S.valid(S.grade_peer(c, lot)) do -1 else
      let east = S.street_link(c, lot, 0) || S.street_link(c, lot, 1)
      let north = S.street_link(c, lot, 2) || S.street_link(c, lot, 3)
      if east && !north do 0 else if north && !east do 2 else -1 end end
    end
  end
  pfn grade_neighbor(c : Ur.Sim.City, lot : Int, arm : Int, axis : Int, height : Int) : Int do
    let peer = S.neighbour(lot, arm)
    let target = S.get(c.heights, peer)
    if int_abs(target - height) <= 6 && road_axis(c, peer) == axis do target else height end
  end
  fn road_profile(c : Ur.Sim.City, lot : Int) : (Int, Int, Int) do
    let axis = road_axis(c, lot)
    let h = S.get(c.heights, lot)
    if axis < 0 do (-1, h, h) else
      let before = grade_neighbor(c, lot, axis, axis, h)
      let after = grade_neighbor(c, lot, axis + 1, axis, h)
      (if before == h && after == h do -1 else axis end, before, after)
    end
  end
  pfn graded_height(h : Int, before : Int, after : Int, at : Int) : Int do
    let step = int_abs(at - 16)
    let peer = if at < 16 do before else after end
    (h * (32 - step) + peer * step + 16) / 32
  end

  pfn portal_crossed_by_street(c : Ur.Sim.City, lot : Int, peer : Int) : Bool do
    let inward = S.direction(lot, peer)
    let across = if inward < 2 do 2 else 0 end
    S.street_link(c, lot, inward) || (S.street_link(c, lot, across) && S.street_link(c, lot, across + 1))
  end
  pfn portal_strip(lot : Int, peer : Int, x : Int, z : Int) : (Int, Int) do
    let x = int_mod_euclid(x, 32)
    let z = int_mod_euclid(z, 32)
    match S.direction(lot, peer) do
      0 -> (16 - x, z)
      1 -> (x - 16, z)
      2 -> (16 - z, x)
      _ -> (z - 16, x)
    end
  end
  pfn portal_floor(c : Ur.Sim.City, lot : Int, peer : Int, inward : Int) : Int do
    let progress = int_to_float(inward) /. int_to_float(S.span_distance(lot, peer) * 32)
    float_to_int(Math.floor(S.grade_surface(c, lot, peer, progress)))
  end
  fn ground_height(c : Ur.Sim.City, x : Int, z : Int) : Int do
    let px = int_div_euclid(x, 32)
    let pz = int_div_euclid(z, 32)
    if px < 0 || pz < 0 || px >= S.width() || pz >= S.depth() do 0 else
      let i = S.index(px, pz)
      let h = S.get(c.heights, i)
      let other = S.grade_peer(c, i)
      let portal = S.grade_kind(c, i) == 3 && S.valid(other) && i != other
      let (inward, across) = if portal do portal_strip(i, other, x, z) else (-1, -1) end
      let portal_cut = inward > 0 && across >= 4 && across < 28 &&
        !portal_crossed_by_street(c, i, other) && !S.mountain_tunnel(c, i, other)
      let grade = S.grade_source(c, i)
      let cross_axis = if S.valid(grade) && grade / S.width() == S.grade_peer(c, grade) / S.width() do int_mod_euclid(z, 32)
        else int_mod_euclid(x, 32) end
      let cut = S.valid(grade) && S.grade_kind(c, grade) == 2 && S.get(c.roads, i) == 0 &&
        S.get(c.buildings, i) == 0 && S.get(c.plants, i) == 0 && S.get(c.construction, i) == 0 && cross_axis >= 10 && cross_axis < 22
      let (axis, before, after) = road_profile(c, i)
      if portal_cut do S.clamp(portal_floor(c, i, other, S.clamp(inward + 2, 0, 16)) - 1, 0, h)
      else if axis >= 0 do
        let along = int_mod_euclid(if axis == 0 do x else z end, 32)
        graded_height(h, before, after, along / 4 * 4 + 2)
      else if cut do h - 8
      else if S.valid(S.campus_root(c, i)) || S.building_offline(c, i) || S.get(c.parks, i) > 0 || (S.get(c.roads, i) > 0 && h > 0) || S.get(c.buildings, i) > 0 || S.get(c.construction, i) > 0 || S.get(c.plants, i) > 0 do h
      else
        let gx = int_div_euclid(x - 16, 32)
        let gz = int_div_euclid(z - 16, 32)
        let u = int_mod_euclid(x - 16, 32)
        let v = int_mod_euclid(z - 16, 32)
        let lo = sample(c, gx, gz) * (32 - u) + sample(c, gx + 1, gz) * u
        let hi = sample(c, gx, gz + 1) * (32 - u) + sample(c, gx + 1, gz + 1) * u
        let hill = (lo * (32 - v) + hi * v) / 1024
        let detail = float_to_int(Math.sin(int_to_float(x) *. 0.077 +. Math.sin(int_to_float(z) *. 0.044)) *. 2.8 +. Math.sin(int_to_float(z) *. 0.156 +. int_to_float(x) *. 0.027) *. 1.8)
        S.clamp(hill + detail, 0, 96)
      end end end end
    end
  end
  pfn sample(c : Ur.Sim.City, x : Int, z : Int) : Int do
    if x < 0 || z < 0 || x >= S.width() || z >= S.depth() do -7 else
      let h = S.get(c.heights, S.index(x, z))
      if h == 0 do -7 else h end
    end
  end
  fn height(c : Ur.Sim.City, x : Int, z : Int) : Int do
    ground_height(c, int_div_euclid(x, 4) * 4 + 2, int_div_euclid(z, 4) * 4 + 2)
  end
  fn top_material(x : Int, z : Int, h : Int) : Int do
    let variation = int_mod_euclid(x * 29 + z * 47 + (x / 17) * (z / 11), 17)
    if h <= 6 do 16
    else if h >= 68 do (if variation < 5 do 24 else 23 end)
    else if h >= 40 do (if variation < 6 do 2 else 23 end)
    else if variation < 4 do 22
    else if variation < 8 do 25
    else 0 end end end end end
  end
  fn side_material(h : Int) : Int do if h > 28 do 2 else if h <= 5 do 16 else 1 end end end
  pfn crosswalk(n : Int, deck : Int, side : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if n >= 6 do out else
      let offset = 5 + n * 4
      let edge = if side % 2 == 0 do 3 else 28 end
      let stripe = if side < 2 do A.piece(edge, deck + 1, offset, 2, 1, 2, 8)
        else A.piece(offset, deck + 1, edge, 2, 1, 2, 8) end
      crosswalk(n + 1, deck, side, Cons(stripe, out))
    end
  end
  -- Quarter-circle centre line at radius 16. Each scanline merges equal
  -- material into runs so the curve costs far fewer quads than solid voxels.
  pfn curve_material(kind : Int, x : Int, z : Int) : Int do
    let d = x * 2 + 1
    let e = z * 2 + 1
    let squared = d * d + e * e
    let width = S.road_half_width(kind) * 2
    let inner = 32 - width
    let outer = 32 + width
    if squared < (inner - 4) * (inner - 4) || squared >= (outer + 4) * (outer + 4) do -1
    else if squared < inner * inner || squared >= outer * outer do 17
    else if kind == 3 do (if squared >= 30 * 30 && squared < 34 * 34 do 17 else 16 end)
    else if kind == 2 && squared >= 30 * 30 && squared < 34 * 34 do 10
    else if kind == 2 && ((squared >= 17 * 17 && squared < 19 * 19) ||
      (squared >= 45 * 45 && squared < 47 * 47)) && int_mod_euclid(x - z + 3, 12) < 6 do 8
    else if kind == 1 && squared >= 31 * 31 && squared < 33 * 33 && int_mod_euclid(x - z + 3, 12) < 6 do 8
    else 4 end end end end end end
  end
  pfn curve_row(kind : Int, deck : Int, horizontal : Int, vertical : Int, x : Int, z : Int, start : Int, material : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let next = if x < 32 do curve_material(kind, x, z) else -2 end
    let changed = next != material
    let out = if !changed || material < 0 || start == x do out else
      let px = if horizontal == 0 do start else 32 - x end
      let pz = if vertical == 2 do z else 31 - z end
      Cons(A.piece(px, deck, pz, x - start, if material == 17 do 2 else 1 end, 1, material), out)
    end
    if x >= 32 do out else curve_row(kind, deck, horizontal, vertical, x + 1, z, if changed do x else start end, next, out) end
  end
  pfn curve(kind : Int, deck : Int, horizontal : Int, vertical : Int, z : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if z >= 32 do out else curve(kind, deck, horizontal, vertical, z + 1, curve_row(kind, deck, horizontal, vertical, 0, z, 0, -1, out)) end
  end
  pfn straight_edge(east : Bool, side : Int, deck : Int, width : Int, thickness : Int, colour : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if east do Cons(A.piece(0, deck, side, width, 1, thickness, colour), out)
    else Cons(A.piece(side, deck, 0, thickness, 1, width, colour), out) end
  end
  pfn lane_dash(east : Bool, deck : Int, side : Int, start : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if east do Cons(A.piece(start, deck + 1, side, 6, 1, 1, 8), out)
    else Cons(A.piece(side, deck + 1, start, 1, 1, 6, 8), out) end
  end
  pfn grade_piece(p : Ur.Architecture.Piece, axis : Int, h : Int, before : Int, after : Int, at : Int,
    out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let limit = if axis == 0 do p.x + p.w else p.z + p.d end
    if at >= limit do out else
      let boundary = at / 4 * 4 + 4
      let length = S.clamp(limit - at, 1, boundary - at)
      let y = p.y + graded_height(h, before, after, boundary - 2) - h
      let slice = if axis == 0 do { p with x: at, w: length, y: y } else { p with z: at, d: length, y: y } end
      grade_piece(p, axis, h, before, after, at + length, Cons(slice, out))
    end
  end
  pfn grade_road(parts : List(Ur.Architecture.Piece), axis : Int, h : Int, before : Int, after : Int) : List(Ur.Architecture.Piece) do
    List.fold_left(parts, Nil, fn (out, p) -> grade_piece(p, axis, h, before, after, if axis == 0 do p.x else p.z end, out))
  end
  pfn road(c : Ur.Sim.City, i : Int, h : Int) : List(Ur.Architecture.Piece) do
    let kind = S.get(c.roads, i)
    let (horizontal, vertical) = S.road_turn(c, i)
    if horizontal >= 0 do curve(kind, h, horizontal, vertical, 0, Nil) else
    let west_link = S.street_link(c, i, 0)
    let east_link = S.street_link(c, i, 1)
    let north_link = S.street_link(c, i, 2)
    let south_link = S.street_link(c, i, 3)
    let peer = S.grade_peer(c, i)
    let bore = if S.mountain_tunnel(c, i, peer) do S.direction(i, peer) else -1 end
    let east = west_link || east_link || (bore >= 0 && bore < 2)
    let north = north_link || south_link || bore >= 2
    let junction = east && north && h > 0
    let deck = if h == 0 do 2 else h end
    -- A curve meets the centre of the next parcel edge. Straight segments
    -- use the same width, including the raised walking edge.
    let colour = if kind == 3 do 16 else 4 end
    let width = S.road_half_width(kind)
    let a = if junction || h == 0 do Cons(A.piece(0, deck, 0, 32, 1, 32, colour), Nil)
      else straight_edge(east, 16 - width, deck, 32, width * 2, colour, Nil) end
    let a = if junction || h == 0 do a else
      let a = straight_edge(east, 14 - width, deck + 1, 32, 2, 17, a)
      straight_edge(east, 16 + width, deck + 1, 32, 2, 17, a)
    end
    let a = if kind == 2 && !junction do straight_edge(east, 15, deck + 1, 32, 2, 10, a)
      else if kind == 3 && !junction do straight_edge(east, 15, deck + 1, 32, 2, 17, a)
      else a end end
    let a = if kind == 2 && !junction do
      let a = lane_dash(east, deck, 8, 4, a)
      let a = lane_dash(east, deck, 8, 20, a)
      let a = lane_dash(east, deck, 23, 4, a)
      lane_dash(east, deck, 23, 20, a)
    else a end
    let a = if S.get(c.tolls, i) == 0 do a else
      let (x, z) = if east do (20, 1) else (1, 20) end
      Cons(A.piece(x, deck + 1, z, 1, 8, 1, 13), Cons(A.piece(x, deck + 8, z, 3, 2, 3, 10), a))
    end
    let a = if kind == 1 && east && !junction do Cons(A.piece(2, deck + 1, 15, 7, 1, 1, 8), Cons(A.piece(22, deck + 1, 15, 7, 1, 1, 8), a)) else a end
    let a = if kind == 1 && !junction && (north || !east) do Cons(A.piece(15, deck + 1, 2, 1, 1, 7, 8), Cons(A.piece(15, deck + 1, 22, 1, 1, 7, 8), a)) else a end
    if junction && kind != 3 do
      let a = if west_link do crosswalk(0, deck, 0, a) else a end
      let a = if east_link do crosswalk(0, deck, 1, a) else a end
      let a = if north_link do crosswalk(0, deck, 2, a) else a end
      if south_link do crosswalk(0, deck, 3, a) else a end
    else if h == 0 do
      let a = if east do Cons(A.piece(0, deck + 2, 1, 32, 2, 1, 8), Cons(A.piece(0, deck + 2, 30, 32, 2, 1, 8), a)) else a end
      let a = if north || !east do Cons(A.piece(1, deck + 2, 0, 1, 2, 32, 8), Cons(A.piece(30, deck + 2, 0, 1, 2, 32, 8), a)) else a end
      Cons(A.piece(7, 0, 7, 4, 2, 4, 17), Cons(A.piece(21, 0, 21, 4, 2, 4, 17), a))
    else
      let (axis, before, after) = road_profile(c, i)
      if axis >= 0 do grade_road(a, axis, h, before, after) else a end
    end end end
  end
  pfn shift(a : List(Ur.Architecture.Piece), h : Int) : List(Ur.Architecture.Piece) do
    match a do
      Nil -> Nil
      Cons(p, rest) -> Cons({ p with y: p.y + h }, shift(rest, h))
    end
  end
  pfn vegetation(c : Ur.Sim.City, i : Int, n : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if n >= 3 do out else
      let seed = Strata.Seed.mix(i, n + 1)
      let x = 7 + seed % 18
      let z = 7 + (seed / 13) % 18
      let h = height(c, i % S.width() * 32 + x, i / S.width() * 32 + z)
      let variety = seed / 23 % 7
      let form = if h >= 32 && variety < 6 || variety == 0 do 1
        else if h <= 12 && variety < 5 || variety == 1 do 2 else 0 end end
      let next = if h > 6 && h < 57 && seed % 11 < 5 && S.grade_kind(c, S.grade_source(c, i)) != 1 do
        List.append(A.tree(x, z, h, seed, form), out)
        else if h > 1 && seed % 5 == 0 do Cons(A.piece(x, h, z, 4, 2, 3, 2), Cons(A.piece(x + 1, h + 2, z, 2, 1, 2, 23), out))
        else if h > 7 && h < 37 && seed % 3 == 0 do Cons(A.piece(x, h, z, 2, 2, 2, 25), Cons(A.piece(x, h + 2, z, 1, 1, 1, 20), out))
        else out end end end
      vegetation(c, i, n + 1, next)
    end
  end
  pfn zone_edge(c : Ur.Sim.City, i : Int, n : Int, tex : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if n >= 32 do out else
      let along = n % 8 * 4
      let edge = n / 8
      let x = if edge == 0 do 0 else if edge == 1 do 31 else along end end
      let z = if edge == 2 do 0 else if edge == 3 do 31 else along end end
      let h = height(c, i % S.width() * 32 + x, i / S.width() * 32 + z)
      let w = if edge < 2 do 1 else 4 end
      let d = if edge < 2 do 4 else 1 end
      zone_edge(c, i, n + 1, tex, Cons(A.piece(x, h, z, w, 1, d, tex), out))
    end
  end
  -- The starter harbour spans four parcels south of the gateway.
  -- Normal construction takes precedence so these meshes never reserve land.
  pfn harbour_piece(row : Int, h : Int) : List(Ur.Architecture.Piece) do
    match row do
      22 ->
        Cons(A.piece(11, h, 0, 10, 1, 32, 17), Nil)
      23 ->
        let y = h + 1
        Cons(A.piece(2, 0, 0, 28, y, 32, 17),
        Cons(A.piece(5, y, 8, 11, 9, 14, 8),
        Cons(A.piece(4, y + 9, 7, 13, 2, 16, 7),
        Cons(A.piece(6, y + 3, 22, 9, 4, 1, 9),
        Cons(A.piece(18, y, 21, 11, 1, 11, 13),
        Cons(A.piece(23, y, 25, 1, 11, 1, 13),
        Cons(A.piece(23, y + 10, 24, 5, 1, 3, 20), Nil)))))))
      24 ->
        Cons(A.piece(16, 5, 0, 12, 2, 27, 13),
        Cons(A.piece(17, 0, 5, 2, 5, 2, 17),
        Cons(A.piece(25, 0, 20, 2, 5, 2, 17),
        Cons(A.piece(16, 7, 22, 2, 2, 2, 20),
        Cons(A.piece(25, 7, 22, 2, 2, 2, 20), Nil)))))
      25 ->
        -- Moored electric launch, with a stepped bow and wheelhouse.
        Cons(A.piece(13, 0, 2, 10, 3, 18, 7),
        Cons(A.piece(14, 0, 20, 8, 3, 3, 7),
        Cons(A.piece(16, 0, 23, 4, 3, 2, 7),
        Cons(A.piece(13, 3, 2, 10, 1, 18, 8),
        Cons(A.piece(15, 4, 8, 6, 4, 8, 9),
        Cons(A.piece(14, 8, 7, 8, 1, 10, 8),
        Cons(A.piece(16, 9, 9, 4, 1, 6, 19), Nil)))))))
      _ -> Nil
    end
  end
  pfn crop_rows(row : Int, out : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if row >= 5 do out else
      let x = 8 + row * 4
      let soil = A.piece(x, 1, 4, 3, 1, 24, 1)
      let crops = A.piece(x + 1, 2, 5, 1, 2, 22, if row % 2 == 0 do 21 else 22 end)
      crop_rows(row + 1, Cons(crops, Cons(soil, out)))
    end
  end
  pfn school_windows(x : Int, z : Int, y : Int, count : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if count <= 0 do parts else
      let parts = Cons(A.piece(x, y, z, 3, 3, 1, 9), Cons(A.piece(x - 1, y - 1, z, 5, 1, 1, 8), parts))
      school_windows(x + 5, z, y, count - 1, parts)
    end
  end
  pfn school_gable(step : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if step >= 9 do parts else
      school_gable(step + 1, Cons(A.piece(3, 10 + step, 3 + step, 26, 1, 19 - step * 2, 6), parts))
    end
  end
  pfn elementary(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(4, 1, 4, 24, 9, 17, 5), base)
    let hall = school_gable(0, hall)
    let hall = school_windows(6, 21, 5, 2, school_windows(20, 21, 5, 2, school_windows(7, 3, 5, 4, hall)))
    let hall = Cons(A.piece(14, 1, 22, 4, 1, 10, 16), hall)
    let hall = Cons(A.piece(14, 1, 21, 4, 6, 1, 19), Cons(A.piece(12, 7, 21, 8, 1, 4, 7), hall))
    let yard = Cons(A.piece(4, 1, 23, 10, 1, 7, 11), Cons(A.piece(21, 1, 23, 7, 1, 7, 11), hall))
    let yard = Cons(A.piece(5, 2, 24, 1, 3, 1, 7), Cons(A.piece(12, 2, 24, 1, 3, 1, 7), yard))
    let yard = Cons(A.piece(5, 5, 24, 8, 1, 3, 10), Cons(A.piece(9, 2, 27, 4, 1, 2, 15), yard))
    List.append([A.piece(12, 8, 21, 8, 1, 3, 8),
      A.piece(25, 2, 26, 1, 4, 1, 13), A.piece(23, 6, 24, 5, 3, 5, 14),
      A.piece(24, 9, 25, 3, 2, 3, 21)], yard)
  end
  pfn secondary(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(4, 1, 5, 24, 15, 19, 6), Cons(A.piece(3, 16, 4, 26, 2, 21, 19), base))
    let hall = school_windows(7, 24, 10, 4, school_windows(7, 4, 10, 4, school_windows(7, 4, 4, 4, hall)))
    let hall = Cons(A.piece(12, 1, 25, 8, 1, 7, 16), hall)
    let hall = Cons(A.piece(11, 1, 24, 10, 7, 1, 19), Cons(A.piece(9, 8, 24, 14, 1, 4, 8), hall))
    let hall = Cons(A.piece(6, 18, 8, 9, 1, 11, 19), Cons(A.piece(17, 18, 8, 9, 1, 11, 19), hall))
    Cons(A.piece(6, 19, 9, 9, 1, 9, 9), Cons(A.piece(17, 19, 9, 9, 1, 9, 9), hall))
  end
  pfn workshop_roof(z : Int, level : Int, parts : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    if level >= 4 do parts else
      workshop_roof(z, level + 1, Cons(A.piece(2, 10 + level, z + level * 2, 28, 1, 9 - level * 2, 19), parts))
    end
  end
  pfn trade_workshop(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(3, 1, 4, 26, 9, 20, 17), base)
    let hall = workshop_roof(4, 0, workshop_roof(15, 0, hall))
    let hall = Cons(A.piece(4, 10, 13, 24, 2, 1, 9), Cons(A.piece(4, 10, 24, 24, 2, 1, 9), hall))
    let hall = Cons(A.piece(6, 1, 24, 8, 7, 1, 19), Cons(A.piece(18, 1, 24, 8, 7, 1, 19), hall))
    let hall = Cons(A.piece(7, 3, 25, 6, 1, 1, 17), Cons(A.piece(19, 3, 25, 6, 1, 1, 17), hall))
    let hall = Cons(A.piece(7, 6, 25, 6, 1, 1, 17), Cons(A.piece(19, 6, 25, 6, 1, 1, 17), hall))
    let hall = Cons(A.piece(4, 8, 24, 24, 1, 3, 10), hall)
    Cons(A.piece(5, 1, 26, 1, 3, 1, 10), Cons(A.piece(26, 1, 26, 1, 3, 1, 10), hall))
  end
  pfn university(base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let hall = Cons(A.piece(3, 1, 5, 26, 11, 21, 8), Cons(A.piece(2, 12, 4, 28, 2, 23, 7), base))
    let hall = school_windows(6, 26, 7, 5, school_windows(6, 4, 7, 5, hall))
    let tower = Cons(A.piece(10, 14, 8, 12, 15, 13, 8), Cons(A.piece(9, 29, 7, 14, 2, 15, 7), hall))
    let tower = Cons(A.piece(12, 17, 21, 8, 10, 1, 9), Cons(A.piece(12, 17, 7, 8, 10, 1, 9), tower))
    let tower = Cons(A.piece(15, 17, 22, 2, 10, 1, 8), Cons(A.piece(15, 17, 6, 2, 10, 1, 8), tower))
    let crown = Cons(A.piece(12, 31, 10, 8, 2, 9, 8), Cons(A.piece(14, 33, 12, 4, 2, 5, 7), tower))
    let crown = Cons(A.piece(11, 1, 27, 10, 1, 5, 16), crown)
    Cons(A.piece(11, 1, 26, 10, 7, 1, 19), Cons(A.piece(9, 8, 26, 14, 1, 5, 7), crown))
  end
  pfn faculty(kind : Int, base : List(Ur.Architecture.Piece)) : List(Ur.Architecture.Piece) do
    let accent = match kind do
      29 -> 6
      30 -> 7
      31 -> 19
      _ -> 13
    end
    let hall = Cons(A.piece(4, 1, 4, 24, 12, 21, 8), Cons(A.piece(3, 13, 3, 26, 2, 23, accent), base))
    let hall = school_windows(7, 25, 7, 4, school_windows(7, 3, 7, 4, hall))
    let hall = Cons(A.piece(12, 1, 25, 8, 5, 1, 19), Cons(A.piece(10, 6, 25, 12, 1, 4, accent), hall))
    match kind do
      29 ->
        let roof = Cons(A.piece(7, 15, 7, 18, 1, 15, 17), hall)
        Cons(A.piece(14, 16, 9, 4, 1, 11, 6), Cons(A.piece(11, 16, 12, 3, 1, 4, 6),
          Cons(A.piece(18, 16, 12, 3, 1, 4, 6), roof)))
      30 ->
        let lab = Cons(A.piece(7, 15, 6, 18, 3, 16, 8), Cons(A.piece(9, 18, 8, 14, 3, 12, 9), hall))
        Cons(A.piece(12, 21, 11, 8, 2, 6, 19), Cons(A.piece(15, 23, 13, 2, 3, 2, 8), lab))
      31 ->
        let tower = Cons(A.piece(8, 15, 8, 16, 13, 13, 9), Cons(A.piece(7, 28, 7, 18, 2, 15, 19), hall))
        Cons(A.piece(8, 21, 21, 16, 1, 1, 8), Cons(A.piece(8, 26, 21, 16, 1, 1, 8), tower))
      _ ->
        let roof = Cons(A.piece(8, 15, 6, 16, 4, 14, 8), Cons(A.piece(7, 19, 5, 18, 2, 16, 13), hall))
        let portico = Cons(A.piece(8, 1, 27, 2, 7, 2, 8), Cons(A.piece(22, 1, 27, 2, 7, 2, 8), roof))
        Cons(A.piece(7, 8, 25, 18, 2, 5, 13), portico)
    end
  end
  fn faculty_frontage(c : Ur.Sim.City, i : Int, root : Int, d : Int) : Int do
    if d == 3 do 3
    else if S.campus_root(c, S.neighbour(i, d)) == root do d
    else faculty_frontage(c, i, root, d + 1) end end
  end
