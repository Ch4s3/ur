        A.piece(11, 18, 7, 14, 2, 3, 10), A.piece(10, 11, 8, 1, 7, 1, 17),
        A.piece(4, 1, 6, 12, 7, 9, 8), A.piece(3, 8, 5, 14, 2, 11, 7),
        A.piece(2, 0, 2, 28, 1, 28, 17)]
