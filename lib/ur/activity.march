mod Ur.Activity do
  alias Ur.Sim as S
  type NeighborhoodEvent = { month : Int, lot : Int, title : String }

  pfn storefront_name(kind : Int) : String do
    if kind == 2 do "Bar" else "Shop" end
  end

  pfn change(before : Ur.Sim.City, after : Ur.Sim.City, i : Int) : String do
    let schedule = S.get(after.car_free_days, i)
    let old_shop = S.storefront(before, i)
    let new_shop = S.storefront(after, i)
    let old_floors = S.get(before.buildings, i)
    let new_floors = S.get(after.buildings, i)
    if S.get(before.car_free_days, i) != schedule do
      if schedule == 0 do "Car-free schedule removed" else "Car-free " ++ S.street_schedule_name(schedule) ++ " scheduled" end
    else if S.car_free_now(before, i) != S.car_free_now(after, i) do
      if S.car_free_now(after, i) do "Street closed to cars" else "Street reopened to cars" end
    else if S.get(before.ground_areas, i) != S.get(after.ground_areas, i) do "Ground floor: " ++ S.ground_name(S.ground_at(after, i))
    else if S.get(before.quiet_areas, i) != S.get(after.quiet_areas, i) do "Quiet hours: " ++ S.quiet_name(S.quiet_at(after, i))
    else if S.displaced_homes(after, i) > 0 && S.displaced_homes(before, i) == 0 do "Households displaced by disaster"
    else if S.displaced_homes(before, i) > 0 && S.occupied_homes(after, i) > 0 do "Households can return after repairs"
    else if S.flood_repair_days(after, i) > 0 && S.flood_repair_days(before, i) == 0 do "Building closed after flooding"
    else if S.flood_repair_days(before, i) > 0 && !S.building_offline(after, i) && new_floors > 0 do "Building reopened after flood repairs"
    else if S.fire_offline(after, i) && !S.fire_offline(before, i) do "Building closed after a fire"
    else if S.fire_offline(before, i) && !S.fire_offline(after, i) && new_floors > 0 do "Building reopened after repairs"
    else if after.month > before.month && S.get(after.home_arrivals, i) > 0 do "Priced-out households moved here"
    else if S.housing_vacant(after, i) && !S.housing_vacant(before, i) do "Households left after running a deficit"
    else if S.housing_vacant(before, i) && S.residential_floors(after, i) > 0 do "Households moved into vacant homes"
    else if S.business_closed(after, i) && !S.business_closed(before, i) do "Business closed after months of losses"
    else if old_shop != new_shop && (new_shop == 1 || new_shop == 2) do storefront_name(new_shop) ++ " opened"
    else if (old_shop == 1 || old_shop == 2) && old_shop != new_shop do storefront_name(old_shop) ++ " closed"
    else if S.get(after.construction, i) > 0 && S.get(before.construction, i) == 0 do "Private construction started"
    else if new_floors > old_floors do (if old_floors == 0 do "New building completed" else "Building gained a floor" end)
    else "" end end end end end end end end end end end end end end end end end end
  end

  pfn collect(before : Ur.Sim.City, after : Ur.Sim.City, i : Int, out : List(NeighborhoodEvent), remaining : Int) : List(NeighborhoodEvent) do
    if i >= S.count() || remaining == 0 do out else
      let title = change(before, after, i)
      if title == "" do collect(before, after, i + 1, out, remaining)
      else if List.any(out, fn event -> event.title == title && S.crime_district(event.lot) == S.crime_district(i)) do
        collect(before, after, i + 1, out, remaining)
      else collect(before, after, i + 1, Cons({ month: after.month, lot: i, title: title }, out), remaining - 1) end end
    end
  end

  pfn end_date(c : Ur.Sim.City, days : Int) : String do
    let day = c.month * S.days_per_month() + c.calendar_day + days
    "ends M" ++ int_to_string(day / S.days_per_month()) ++ "/D" ++ int_to_string(day % S.days_per_month() + 1)
  end

  pfn religion(before : Ur.Sim.City, after : Ur.Sim.City, events : List(NeighborhoodEvent)) : List(NeighborhoodEvent) do
    let patron = S.patron(after)
    let events = if patron > 0 && patron != S.patron(before) do
      Cons({ month: after.month, lot: -1, title: "City dedicated to " ++ S.god_name(patron) }, events)
    else events end
    let request = Ur.Council.rededication_target(after)
    let events = if request > 0 && request != Ur.Council.rededication_target(before) do
      Cons({ month: after.month, lot: -1, title: "Council requests rededication to " ++ S.god_name(request) }, events)
    else events end
    let events = if S.rededication_days(before) == 0 && S.rededication_days(after) > 0 do
      let title = "Temples closed for reconsecration · " ++ end_date(after, S.rededication_days(after))
      Cons({ month: after.month, lot: -1, title: title }, events)
    else events end
    let events = if S.last_festival(after) != S.last_festival(before) && S.last_festival_hosts(after) > 0 do
      let title = "Festival · " ++ int_to_string(S.last_festival_attendees(after)) ++ " attended across " ++ int_to_string(S.last_festival_hosts(after)) ++ " sites"
      let site = if S.last_festival_hosts(after) == 1 do S.last_festival_site(after) else -1 end
      Cons({ month: after.month, lot: site, title: title }, events)
    else events end
    let favor = S.favor_god(after)
    let events = if favor != S.favor_god(before) do
      if favor > 0 do
        let title = "Offering to " ++ S.god_name(favor) ++ " granted favor · " ++ end_date(after, S.favor_days(after))
        Cons({ month: after.month, lot: -1, title: title }, events)
      else Cons({ month: after.month, lot: -1, title: S.god_name(S.favor_god(before)) ++ "'s favor ended" }, events) end
    else events end
    let curse = S.curse_god(after)
    if curse != S.curse_god(before) || S.curse_stamp(after) != S.curse_stamp(before) do
      if curse > 0 do
        let cause = if S.valid(S.curse_site(after)) do "Offering" else "Rededication" end
        let title = cause ++ " · " ++ S.god_name(curse) ++ " sent " ++ S.curse_name(curse) ++ " · " ++ end_date(after, S.curse_days(after))
        Cons({ month: after.month, lot: S.curse_epicenter(after), title: title }, events)
      else Cons({ month: after.month, lot: S.curse_epicenter(before), title: S.curse_name(S.curse_god(before)) ++ " ended" }, events) end
    else events end
  end

  fn record(before : Ur.Sim.City, after : Ur.Sim.City, history : List(NeighborhoodEvent)) : List(NeighborhoodEvent) do
    let events = collect(before, after, 0, Nil, 7)
    let events = if before.ground_rule == after.ground_rule do events else
      Cons({ month: after.month, lot: -1, title: "Citywide ground floors: " ++ S.ground_name(after.ground_rule) }, events) end
    let events = if before.quiet_rule == after.quiet_rule do events else
      Cons({ month: after.month, lot: -1, title: "Citywide quiet hours: " ++ S.quiet_name(after.quiet_rule) }, events) end
    let agenda = Ur.Council.kind(after)
    let events = if agenda > 0 && (agenda != Ur.Council.kind(before) || Ur.Council.expires(after) != Ur.Council.expires(before)) do
      Cons({ month: after.month, lot: -1, title: "New council item · " ++ Ur.Council.ward_name(Ur.Council.sponsor(after)) }, events)
    else events end
    let events = if Ur.Council.last_election(after) > Ur.Council.last_election(before) do
      Cons({ month: after.month, lot: -1, title: "Council election results are in" }, events)
    else if !Ur.Council.campaign(before) && Ur.Council.campaign(after) && Ur.Council.established(after) do
      Cons({ month: after.month, lot: -1, title: "Council campaigns opened" }, events)
    else events end end
    let events = religion(before, after, events)
    List.take(List.append(events, history), 7)
  end
end
