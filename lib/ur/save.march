    let? property_arrears = optional_array(j, "property_arrears", 1000000)
    let? property_sales = match Json.get(j, "property_sales") do
      None -> Ok(0)
      Some(raw) -> integer(raw)
    end
    let? campus = optional_array(j, "campus", 2640)
