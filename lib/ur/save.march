    let? shop_sales = array(raw_shop_sales, 2640, 8)
    let? raw_shop_delivered = field(j, "shop_delivered")
    let? shop_delivered = array(raw_shop_delivered, 2640, 16)
    let? raw_heights = field(j, "heights")
