    let? home_arrivals = optional_array(j, "home_arrivals", 12)
    let? neighborhood_rents = match Json.get(j, "neighborhood_rents") do
      None -> Ok(NativeArray.make_int(80, 0))
      Some(raw) -> array(raw, 80, 180)
    end
    let? rent_pressure = match Json.get(j, "rent_pressure") do
      None -> Ok(S.neutral_rent_pressure())
      Some(raw) -> array(raw, 5, 500)
    end
