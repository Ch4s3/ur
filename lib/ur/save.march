  pfn encode_game(v : Game) : Json.JsonValue do
    Json.encode_object(
      Cons(("speed", Json.encode_int(v.speed)),
      Cons(("city", encode_city(v.city)),
      Cons(("cx", Json.encode_number(v.cx)),
      Cons(("cz", Json.encode_number(v.cz)),
      Cons(("zoom", Json.encode_number(v.zoom)),
      Cons(("yaw", Json.encode_number(v.yaw)),
      Cons(("paused", Json.encode_bool(v.paused)), Nil))))))))
  end
  pfn decode_game(j : Json.JsonValue) : Result(Game, String) do
    let? raw_speed = field(j, "speed")
    let? speed = integer(raw_speed)
    let? raw_city = field(j, "city")
    let? city = decode_city(raw_city)
    let? raw_cx = field(j, "cx")
    let? cx = number(raw_cx)
    let? raw_cz = field(j, "cz")
    let? cz = number(raw_cz)
    let? raw_zoom = field(j, "zoom")
    let? zoom = number(raw_zoom)
    let? raw_yaw = field(j, "yaw")
    let? yaw = number(raw_yaw)
    let? raw_paused = field(j, "paused")
    let? paused = boolean(raw_paused)
    if !(zoom >= 18.0 && zoom <= S.max_zoom() && speed >= 1 && speed <= 3) do Err("Invalid game values.") else
    Ok({ speed: speed, city: city, cx: cx, cz: cz,
      zoom: zoom, yaw: yaw, paused: paused })
    end
  end
  pfn encode_shelter_travel(v : Ur.Citizens.ShelterTravel) : Json.JsonValue do
    Json.encode_object([
      ("work", Json.encode_int(v.work)), ("study", Json.encode_int(v.study)),
      ("qualification", Json.encode_int(v.qualification)), ("position", Json.encode_int(v.position)),
      ("parking", Json.encode_int(v.parking)), ("arrival", Json.encode_int(v.arrival)),
      ("car", Json.encode_int(v.car_phase)), ("transit", Json.encode_int(v.transit_phase)),
      ("board", Json.encode_int(v.board)), ("alight", Json.encode_int(v.alight))])
  end
  pfn encode_evacuation(trip : Ur.Citizens.EvacuationTrip) : Json.JsonValue do
    Json.encode_object([
      ("id", Json.encode_int(trip.id)),
      ("home", Json.encode_int(trip.home)),
      ("shelter", Json.encode_int(trip.shelter)),
      ("activity", Json.encode_int(trip.activity)),
      ("location", Json.encode_int(trip.location)),
      ("target", Json.encode_int(trip.target)),
      ("route", Json.encode_array(List.map(trip.route, Json.encode_int))),
      ("previous", Json.encode_int(trip.previous)),
      ("progress", Json.encode_number(trip.progress)),
      ("wait", Json.encode_number(trip.wait)),
      ("travel", encode_shelter_travel(trip.travel))])
  end
  pfn evacuation_int(j : Json.JsonValue, name : String) : Result(Int, String) do
    let? raw = field(j, name)
    integer(raw)
  end
  pfn parking_value(j : Json.JsonValue, key : String) : Result(Int, String) do
    let? raw = field(j, key)
    match raw do
      Json.Number(n) ->
        if n >= 0.0 && n < int_to_float(S.count()) *. int_to_float(S.count()) *. int_to_float(S.count()) *. 2880.0 &&
          Math.floor(n) == n do Ok(float_to_int(n)) else Err("Invalid evacuation parking.") end
      _ -> Err("Missing evacuation parking.")
    end
  end
  pfn decode_shelter_travel(j : Json.JsonValue) : Result(Ur.Citizens.ShelterTravel, String) do
    let? work = evacuation_int(j, "work")
    let? study = evacuation_int(j, "study")
    let? qualification = evacuation_int(j, "qualification")
    let? position = evacuation_int(j, "position")
    let? parking = parking_value(j, "parking")
    let? arrival = parking_value(j, "arrival")
    let? car = evacuation_int(j, "car")
    let? transit = evacuation_int(j, "transit")
    let? board = evacuation_int(j, "board")
    let? alight = evacuation_int(j, "alight")
    if List.all([work, board, alight], fn lot -> lot == -1 || S.valid(lot)) &&
      study >= -1 && study <= 8 && qualification >= 0 && qualification <= 8 && position >= 0 &&
      car >= 0 && car <= 3 && (car == 0 || (parking > 0 && arrival > 0)) &&
      transit >= 0 && transit <= 4 && transit != 3 && (transit == 0 || (S.valid(board) && S.valid(alight))) &&
      (car == 0 || transit == 0) do
      Ok({ work: work, study: study, qualification: qualification, position: position,
        parking: parking, arrival: arrival, car_phase: car, transit_phase: transit, board: board, alight: alight })
    else Err("Invalid shelter commute.") end
  end
  pfn decode_evacuation(j : Json.JsonValue) : Result(Ur.Citizens.EvacuationTrip, String) do
    let? id = evacuation_int(j, "id")
    let? home = evacuation_int(j, "home")
    let? shelter = evacuation_int(j, "shelter")
    let? activity = evacuation_int(j, "activity")
    let? location = evacuation_int(j, "location")
    let? target = evacuation_int(j, "target")
    let? previous = evacuation_int(j, "previous")
    let? raw_route = field(j, "route")
    let? route = items(raw_route, parcel, S.count())
    let? raw_progress = field(j, "progress")
    let? progress = number(raw_progress)
    let? raw_wait = field(j, "wait")
    let? wait = number(raw_wait)
    let? raw_travel = field(j, "travel")
    let? travel = decode_shelter_travel(raw_travel)
    let commute = S.valid(shelter) && ((activity == 11 && S.valid(travel.work) && target == travel.work) ||
      (activity == 12 && target == shelter))
    let valid_phase = match route do
      Nil -> S.valid(location) && (commute || activity == 10 || (activity == 8 && location == shelter && target == shelter))
      Cons(_, Cons(_, _)) ->
        location == -1 && (commute || (activity == 7 && S.valid(shelter) && target == shelter) || (activity == 9 && target == home))
      _ -> false
    end
    if id >= 0 && S.valid(home) && List.all([shelter, target, previous], fn lot -> lot == -1 || S.valid(lot)) &&
      progress >= 0.0 && progress <= 1.0 && valid_phase do
      Ok({ id: id, home: home, shelter: shelter, activity: activity, location: location, target: target,
        previous: previous, route: route, progress: progress, wait: wait, travel: travel })
    else Err("Invalid evacuation trip.") end
  end
  fn encode_session(session : Session) : String do
    let extra = if List.is_empty(session.evacuation) do Nil
      else [("evacuation", Json.encode_array(List.map(session.evacuation, encode_evacuation)))] end
    let fields = [("version", Json.encode_int(2)), ("map", Json.encode_array([Json.encode_int(S.width()), Json.encode_int(S.depth())])),
      ("game", encode_game(session.game)), ("households", encode_households(session.game.city.households))]
    Json.to_string(Json.encode_object(List.append(fields, extra)))
  end
  fn encode(game : Game) : String do encode_session({ game: game, evacuation: Nil }) end
  fn decode_session(text : String) : Result(Session, String) do
    let? json = Json.parse(text)
    let? tag = field(json, "version")
    let? version = integer(tag)
    if version == 2 do
      -- The map size the save was made on: a save from before the field is 60 x 44.
      let (w, d) = match field(json, "map") do
        Ok(m) -> match m do
            Json.Array(Cons(a, Cons(b, Nil))) -> (match integer(a) do Ok(v) -> v | Err(_) -> -1 end, match integer(b) do Ok(v) -> v | Err(_) -> -1 end)
            _ -> (-1, -1)
          end
        Err(_) -> (60, 44)
      end
      let? _ = if w == S.width() && d == S.depth() do Ok(()) else Err("This city was saved on a " ++ int_to_string(w) ++ " x " ++ int_to_string(d) ++ " map; this build's map is " ++ int_to_string(S.width()) ++ " x " ++ int_to_string(S.depth()) ++ ".") end
      let? raw_game = field(json, "game")
      let? game = decode_game(raw_game)
      let? raw_households = field(json, "households")
      let? households = decode_households(raw_households)
      let game = { game with city: { game.city with households: households } }
      let? evacuation = match Json.get(json, "evacuation") do
        None -> Ok(Nil)
        Some(raw) -> items(raw, decode_evacuation, S.population(game.city))
      end
      Ok({ game: game, evacuation: evacuation })
    else Err("Unsupported save version.") end
  end
  fn decode(text : String) : Result(Game, String) do
    let? session = decode_session(text)
    Ok(session.game)
  end
  fn exists(path : String) : Bool do
    match File.exists(path) do
      Ok(present) -> present
      Err(_) -> false
    end
  end
  fn load_session(path : String) : Result(Session, String) do
    match File.read(path) do
      Ok(Ok(text)) -> decode_session(text)
      _ -> Err("Could not read the saved city.")
    end
  end
  fn load(path : String) : Result(Game, String) do
    let? session = load_session(path)
    Ok(session.game)
  end
  fn save_session(path : String, session : Session) : Result(Unit, String) do
    let staging = path ++ "." ++ int_to_string(Authority.must(Process.pid())) ++ ".tmp"
    match File.write(staging, encode_session(session)) do
      Ok(Ok(_)) -> match File.rename(staging, path) do
        Ok(Ok(_)) -> Ok(())
        _ -> Err("Could not replace the saved city.")
      end
      _ -> Err("Could not write the saved city.")
    end
  end
  -- The lighting settings live beside the saved city, a JSON array of each row's step.
  fn lighting_path() : String do path() ++ ".lighting" end
  pfn lighting_rows(l : NativeIntArr, xs : List(Int), row : Int) : NativeIntArr do
    match xs do
      Nil -> l
      Cons(v, rest) -> lighting_rows(Ur.Lighting.set(l, row, v), rest, row + 1)
    end
  end
  fn load_lighting() : NativeIntArr do
    let found = match File.read(lighting_path()) do
      Ok(Ok(text)) -> (match Json.parse(text) do
        Ok(j) -> items(j, integer, 8)
        Err(_) -> Err("unreadable")
      end)
      _ -> Err("missing")
    end
    match found do
      Ok(xs) -> lighting_rows(Ur.Lighting.defaults(), xs, 0)
      Err(_) -> Ur.Lighting.defaults()
    end
  end
  pfn lighting_list(l : NativeIntArr, row : Int) : List(Json.JsonValue) do
    if row >= Ur.Lighting.rows() do Nil else Cons(Json.encode_int(Ur.Lighting.get(l, row)), lighting_list(l, row + 1)) end
  end
  fn save_lighting(l : NativeIntArr) : Bool do
    match File.write(lighting_path(), Json.to_string(Json.encode_array(lighting_list(l, 0)))) do
      Ok(Ok(_)) -> true
      _ -> false
    end
  end
  fn save(path : String, game : Game) : Result(Unit, String) do
    save_session(path, { game: game, evacuation: Nil })
  end
end
