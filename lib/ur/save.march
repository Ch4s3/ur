  pfn decode_city(j : Json.JsonValue) : Result(Ur.Sim.City, String) do
    let? freight = match Json.get(j, "freight") do
      Some(value) -> Result.map(decode_freight(value), fn route -> Some(route))
      None -> Ok(None)
    end
    let? waste_live = match Json.get(j, "waste_live") do
      Some(value) -> boolean(value)
      None -> Ok(false)
    end
    let? waste_bins = optional_array(j, "waste_bins", 2)
    let? waste_stock = optional_array(j, "waste_stock", 2147483647)
    let? waste_sites = optional_array(j, "waste_sites", 2400)
    let? waste_last = optional_array(j, "waste_last", 2147483647)
    let? waste_log = optional_array(j, "waste_log", 2147483647)
    let? waste_runs = match Json.get(j, "waste_runs") do
      Some(value) -> items(value, decode_waste_run, 3)
      None -> Ok(Nil)
    end
    let? council = optional_array(j, "council", 2147483647)
    let? religion = match Json.get(j, "religion") do
      Some(value) -> decode_religion(value)
      None -> Ok(S.new_religion())
    end
    let? raw_construction_spend = field(j, "construction_spend")
    let? construction_spend = integer(raw_construction_spend)
    let? raw_island_exports = field(j, "island_exports")
    let? island_exports = integer(raw_island_exports)
    let? raw_island_crops = field(j, "island_crops")
    let? island_crops = integer(raw_island_crops)
