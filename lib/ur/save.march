    let fields = List.append([("public_works", Json.encode_array(List.map(v.public_works, encode_public_work))), ("facility_expansion", enc_array(v.facility_expansion, S.count() - 1, Nil)), ("milestones", enc_array(v.milestones, 63, Nil)), ("facility_staff", enc_array(v.facility_staff, S.count() - 1, Nil)), ("founders", Json.encode_int(v.founders)), ("world_seed", Json.encode_int(v.world_seed)), ("volcanic", Json.encode_bool(v.volcanic)), ("basalt", encode_basalt(v.basalt)), ("volcano_ms", Json.encode_int(v.volcano_ms)), ("world_setup", enc_array(v.setup, NativeArray.length_int(v.setup) - 1, Nil)), ("utility_service", enc_array(v.utility_service, S.count() - 1, Nil))], freight)
