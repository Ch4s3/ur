-- Versioned city snapshots. The staging file sits beside the save so the
-- final rename can replace the previous save atomically.
mod Ur.Save do
  needs IO.FileRead
  needs IO.FileWrite
  needs IO.Process
  alias Ur.Sim as S
  type Game = { city : Ur.Sim.City, cx : Float, cz : Float, zoom : Float, yaw : Float, paused : Bool, speed : Int }

  fn path() : String do
    let home = Authority.must(Env.get("HOME", "."))
    Authority.must(Env.get("UR_SAVE_PATH", home ++ "/.ur-save.json"))
  end

  pfn integer(j : Json.JsonValue) : Result(Int, String) do
    match j do
      Json.Number(n) ->
        if n >= -2147483648.0 && n <= 2147483647.0 && Math.floor(n) == n do Ok(float_to_int(n))
        else Err("Invalid integer.") end
      _ -> Err("Invalid integer.")
    end
  end
  pfn number(j : Json.JsonValue) : Result(Float, String) do
    match j do
      Json.Number(n) -> if n >= -100000.0 && n <= 100000.0 do Ok(n) else Err("Invalid camera.") end
      _ -> Err("Invalid camera.")
    end
  end
  pfn boolean(j : Json.JsonValue) : Result(Bool, String) do
    match j do
      Json.Bool(v) -> Ok(v)
      _ -> Err("Invalid flag.")
    end
  end
  pfn string(j : Json.JsonValue) : Result(String, String) do
    match j do
      Json.Str(v) -> Ok(v)
      _ -> Err("Invalid message.")
    end
  end
  pfn field(j : Json.JsonValue, key : String) : Result(Json.JsonValue, String) do
    match Json.get(j, key) do
      Some(value) -> Ok(value)
      None -> Err("Missing save field " ++ key ++ ".")
    end
  end
  pfn enc_array(a : NativeIntArr, i : Int, acc : List(Json.JsonValue)) : Json.JsonValue do
    if i < 0 do Json.encode_array(acc)
    else enc_array(a, i - 1, Cons(Json.encode_int(NativeArray.get_int(a, i)), acc)) end
  end
  pfn decode_array(xs : List(Json.JsonValue), a : NativeIntArr, i : Int, length : Int, limit : Int) : Result(NativeIntArr, String) do
    match xs do
      Nil -> if i == length do Ok(a) else Err("Incomplete parcel data.") end
      Cons(value, rest) ->
        let? n = integer(value)
        if i >= length || n < 0 || n > limit do Err("Invalid parcel data.")
        else decode_array(rest, NativeArray.set_int(a, i, n), i + 1, length, limit) end
    end
  end
  pfn array(j : Json.JsonValue, length : Int, limit : Int) : Result(NativeIntArr, String) do
    match j do
      Json.Array(xs) -> decode_array(xs, NativeArray.make_int(length, 0), 0, length, limit)
      _ -> Err("Missing parcel array.")
    end
  end
  pfn decode_items(xs : List(Json.JsonValue), decode : (Json.JsonValue) -> Result(a, String), out : List(a), limit : Int) : Result(List(a), String) do
    match xs do
      Nil -> Ok(List.reverse(out))
      Cons(value, rest) ->
        if limit <= 0 do Err("Too many save entries.") else
          let? item = decode(value)
          decode_items(rest, decode, Cons(item, out), limit - 1)
        end
    end
  end
  pfn items(j : Json.JsonValue, decode : (Json.JsonValue) -> Result(a, String), limit : Int) : Result(List(a), String) do
    match j do
      Json.Array(xs) -> decode_items(xs, decode, Nil, limit)
      _ -> Err("Missing save array.")
    end
  end
  pfn parcel(j : Json.JsonValue) : Result(Int, String) do
    let? i = integer(j)
    if S.valid(i) do Ok(i) else Err("Invalid shipment stop.") end
  end
  pfn encode_budget(v : Ur.Sim.Budget) : Json.JsonValue do
    Json.encode_object(
      Cons(("revenue", Json.encode_int(v.revenue)),
      Cons(("property_tax", Json.encode_int(v.property_tax)),
      Cons(("income_tax", Json.encode_int(v.income_tax)),
      Cons(("business_tax", Json.encode_int(v.business_tax)),
      Cons(("trade_income", Json.encode_int(v.trade_income)),
      Cons(("tariffs", Json.encode_int(v.tariffs)),
      Cons(("parking_income", Json.encode_int(v.parking_income)),
      Cons(("toll_income", Json.encode_int(v.toll_income)),
      Cons(("infrastructure", Json.encode_int(v.infrastructure)),
      Cons(("operations", Json.encode_int(v.operations)),
      Cons(("energy_income", Json.encode_int(v.energy_income)),
      Cons(("power_cost", Json.encode_int(v.power_cost)),
      Cons(("food_cost", Json.encode_int(v.food_cost)),
      Cons(("water_cost", Json.encode_int(v.water_cost)),
      Cons(("sanitation_cost", Json.encode_int(v.sanitation_cost)),
      Cons(("bus_fares", Json.encode_int(v.bus_fares)), Cons(("bus_operations", Json.encode_int(v.bus_operations)), Cons(("freight_operations", Json.encode_int(v.freight_operations)), Nil)))))))))))))))))))
  end
  pfn decode_budget(j : Json.JsonValue) : Result(Ur.Sim.Budget, String) do
    let? raw_revenue = field(j, "revenue")
    let? revenue = integer(raw_revenue)
    let? raw_property_tax = field(j, "property_tax")
    let? property_tax = integer(raw_property_tax)
    let? raw_income_tax = field(j, "income_tax")
    let? income_tax = integer(raw_income_tax)
    let? raw_business_tax = field(j, "business_tax")
    let? business_tax = integer(raw_business_tax)
    let? raw_trade_income = field(j, "trade_income")
    let? trade_income = integer(raw_trade_income)
    let? raw_tariffs = field(j, "tariffs")
    let? tariffs = integer(raw_tariffs)
    let? raw_toll_income = field(j, "toll_income")
    let? toll_income = integer(raw_toll_income)
    let? parking_income = match Json.get(j, "parking_income") do
      Some(value) -> integer(value)
      None -> Ok(0)
    end
    let? raw_infrastructure = field(j, "infrastructure")
    let? infrastructure = integer(raw_infrastructure)
    let? raw_operations = field(j, "operations")
    let? operations = integer(raw_operations)
    let? raw_energy_income = field(j, "energy_income")
    let? energy_income = integer(raw_energy_income)
    let? raw_power_cost = field(j, "power_cost")
    let? power_cost = integer(raw_power_cost)
    let? raw_food_cost = field(j, "food_cost")
    let? food_cost = integer(raw_food_cost)
    let? raw_water_cost = field(j, "water_cost")
    let? water_cost = integer(raw_water_cost)
    let? raw_sanitation_cost = field(j, "sanitation_cost")
    let? sanitation_cost = integer(raw_sanitation_cost)
    let? bus_fares = match Json.get(j, "bus_fares") do
      Some(value) -> integer(value)
      None -> Ok(0)
    end
    let? bus_operations = match Json.get(j, "bus_operations") do
      Some(value) -> integer(value)
      None -> Ok(0)
    end
    let? freight_operations = match Json.get(j, "freight_operations") do
      Some(value) -> integer(value)
      None -> Ok(0)
    end
    Ok({ revenue: revenue, property_tax: property_tax, income_tax: income_tax, business_tax: business_tax,
      bus_fares: bus_fares, bus_operations: bus_operations, freight_operations: freight_operations,
      trade_income: trade_income, tariffs: tariffs, toll_income: toll_income, parking_income: parking_income, infrastructure: infrastructure,
      operations: operations, energy_income: energy_income, power_cost: power_cost, food_cost: food_cost,
      water_cost: water_cost, sanitation_cost: sanitation_cost })
  end
  pfn encode_expansion(v : Ur.Sim.Expansion) : Json.JsonValue do
    Json.encode_object(
      Cons(("island", Json.encode_int(v.island)),
      Cons(("invested", Json.encode_int(v.invested)),
      Cons(("recovered", Json.encode_int(v.recovered)),
      Cons(("exports", Json.encode_int(v.exports)),
      Cons(("net", Json.encode_int(v.net)), Nil))))))
  end
  pfn decode_expansion(j : Json.JsonValue) : Result(Ur.Sim.Expansion, String) do
    let? raw_island = field(j, "island")
    let? island = integer(raw_island)
    let? raw_invested = field(j, "invested")
    let? invested = integer(raw_invested)
    let? raw_recovered = field(j, "recovered")
    let? recovered = integer(raw_recovered)
    let? raw_exports = field(j, "exports")
    let? exports = integer(raw_exports)
    let? raw_net = field(j, "net")
    let? net = integer(raw_net)
    if !(island >= 0 && island <= 2 && invested >= 0) do Err("Invalid expansion values.") else
    Ok({ island: island, invested: invested, recovered: recovered, exports: exports,
      net: net })
    end
  end
  pfn encode_month(v : Ur.Sim.FinanceMonth) : Json.JsonValue do
    Json.encode_object(
      Cons(("month", Json.encode_int(v.month)),
      Cons(("revenue", Json.encode_int(v.revenue)),
      Cons(("expenditures", Json.encode_int(v.expenditures)),
      Cons(("construction", Json.encode_int(v.construction)),
      Cons(("property_receipts", Json.encode_int(v.property_receipts)),
      Cons(("budget", encode_budget(v.budget)), Nil)))))))
  end
  pfn decode_month(j : Json.JsonValue) : Result(Ur.Sim.FinanceMonth, String) do
    let? raw_month = field(j, "month")
    let? month = integer(raw_month)
    let? raw_revenue = field(j, "revenue")
    let? revenue = integer(raw_revenue)
    let? raw_expenditures = field(j, "expenditures")
    let? expenditures = integer(raw_expenditures)
    let? raw_construction = field(j, "construction")
    let? construction = integer(raw_construction)
    let? raw_budget = field(j, "budget")
    let? budget = decode_budget(raw_budget)
    let? property_receipts = match Json.get(j, "property_receipts") do
      None -> Ok(0)
      Some(raw) -> integer(raw)
    end
    Ok({ month: month, revenue: revenue, expenditures: expenditures, construction: construction, property_receipts: property_receipts,
      budget: budget })
  end
  pfn encode_shipment(v : Ur.Sim.Shipment) : Json.JsonValue do
    Json.encode_object(
      Cons(("source", Json.encode_int(v.source)),
      Cons(("legs", Json.encode_int(v.legs)),
      Cons(("units", Json.encode_int(v.units)),
      Cons(("stops", Json.encode_array(List.map(v.stops, Json.encode_int))), Nil)))))
  end
  pfn decode_shipment(j : Json.JsonValue) : Result(Ur.Sim.Shipment, String) do
    let? raw_source = field(j, "source")
    let? source = integer(raw_source)
    let? raw_legs = field(j, "legs")
    let? legs = integer(raw_legs)
    let? raw_units = field(j, "units")
    let? units = integer(raw_units)
    let? raw_stops = field(j, "stops")
    let? stops = items(raw_stops, parcel, 2640)
    if !(S.valid(source) && legs >= 1 && legs + 1 == List.length(stops) && units > 0) do Err("Invalid shipment values.") else
    Ok({ source: source, legs: legs, units: units, stops: stops })
    end
  end
  pfn freight_number(j : Json.JsonValue, name : String) : Result(Int, String) do
    let? value = field(j, name)
    integer(value)
  end
  pfn encode_inventory(v : Ur.FreightNetwork.Inventory) : Json.JsonValue do
    Json.encode_object([("units", Json.encode_int(v.units)), ("value", Json.encode_int(v.value))])
  end
  pfn decode_inventory(j : Json.JsonValue) : Result(Ur.FreightNetwork.Inventory, String) do
    let? units = freight_number(j, "units")
    let? value = freight_number(j, "value")
    if units >= 0 && units <= 64 && value >= 0 && value <= units * 20 do Ok({ units: units, value: value })
    else Err("Invalid freight inventory.") end
  end
  pfn encode_voyage(v : Ur.FreightNetwork.Voyage) : Json.JsonValue do
    Json.encode_object([("id", Json.encode_int(v.id)), ("left", Json.encode_int(v.left)), ("age", Json.encode_int(v.age)),
      ("food", encode_inventory(v.food)), ("fuel", Json.encode_int(v.fuel)), ("waste", Json.encode_int(v.waste))])
  end
  pfn decode_voyage(j : Json.JsonValue) : Result(Ur.FreightNetwork.Voyage, String) do
    let? id = freight_number(j, "id")
    let? left = freight_number(j, "left")
    let? age = freight_number(j, "age")
    let? raw_food = field(j, "food")
    let? food = decode_inventory(raw_food)
    let? fuel = freight_number(j, "fuel")
    let? waste = freight_number(j, "waste")
    if id > 0 && left >= 0 && left <= 2 && age >= 0 && fuel >= 0 && fuel <= 24 && waste >= 0 && waste <= 64 do
      Ok({ id: id, left: left, age: age, food: food, fuel: fuel, waste: waste })
    else Err("Invalid freight voyage.") end
  end
  pfn encode_freight(v : Ur.FreightNetwork.Route) : Json.JsonValue do
    let voyage = match v.voyage do
      Some(boat) -> [("voyage", encode_voyage(boat))]
      None -> Nil
    end
    Json.encode_object(List.append(voyage, [
      ("port", Json.encode_int(v.port)), ("island", Json.encode_int(v.island)), ("producer", Json.encode_int(v.producer)),
      ("market", Json.encode_int(v.market)), ("plant", Json.encode_int(v.plant)), ("waste_site", Json.encode_int(v.waste_site)),
      ("priority", Json.encode_int(v.priority)), ("producer_stock", Json.encode_int(v.producer_stock)), ("dock_food", Json.encode_int(v.dock_food)),
      ("dock_waste", Json.encode_int(v.dock_waste)), ("fuel", Json.encode_int(v.fuel)), ("landed_fuel", Json.encode_int(v.landed_fuel)),
      ("next_id", Json.encode_int(v.next_id)), ("departure", Json.encode_int(v.departure)), ("price", Json.encode_int(v.price)),
      ("demand", Json.encode_int(v.demand)), ("sold", Json.encode_int(v.sold)), ("sales", Json.encode_int(v.sales)),
      ("cost_sold", Json.encode_int(v.cost_sold)), ("spoiled", Json.encode_int(v.spoiled)), ("wallet", Json.encode_int(v.wallet)),
      ("duty", Json.encode_int(v.duty)), ("expenses", Json.encode_int(v.expenses)), ("delivered", Json.encode_int(v.delivered)),
      ("exported", Json.encode_int(v.exported)), ("month_waste", Json.encode_int(v.month_waste)), ("month_sales", Json.encode_int(v.month_sales)),
      ("month_cost", Json.encode_int(v.month_cost)), ("month_days", Json.encode_int(v.month_days)), ("coverage", Json.encode_int(v.coverage)), ("backup", Json.encode_bool(v.backup)),
      ("reserve", Json.encode_bool(v.reserve)), ("suspended", Json.encode_bool(v.suspended)), ("shop", encode_inventory(v.shop))]))
  end
  pfn decode_freight(j : Json.JsonValue) : Result(Ur.FreightNetwork.Route, String) do
    let? port = freight_number(j, "port")
    let? island = freight_number(j, "island")
    let? producer = freight_number(j, "producer")
    let? market = freight_number(j, "market")
    let? plant = freight_number(j, "plant")
    let? waste_site = freight_number(j, "waste_site")
    let? priority = freight_number(j, "priority")
    let? producer_stock = freight_number(j, "producer_stock")
    let? dock_food = freight_number(j, "dock_food")
    let? dock_waste = freight_number(j, "dock_waste")
    let? fuel = freight_number(j, "fuel")
    let? landed_fuel = freight_number(j, "landed_fuel")
    let? next_id = freight_number(j, "next_id")
    let? departure = freight_number(j, "departure")
    let? price = freight_number(j, "price")
    let? demand = freight_number(j, "demand")
    let? sold = freight_number(j, "sold")
    let? sales = freight_number(j, "sales")
    let? cost_sold = freight_number(j, "cost_sold")
    let? spoiled = freight_number(j, "spoiled")
    let? wallet = freight_number(j, "wallet")
    let? duty = freight_number(j, "duty")
    let? expenses = freight_number(j, "expenses")
    let? delivered = freight_number(j, "delivered")
    let? exported = freight_number(j, "exported")
    let? month_waste = freight_number(j, "month_waste")
    let? month_sales = freight_number(j, "month_sales")
    let? month_cost = freight_number(j, "month_cost")
    let? month_days = freight_number(j, "month_days")
    let? coverage = freight_number(j, "coverage")
    let? raw_backup = field(j, "backup")
    let? backup = boolean(raw_backup)
    let? raw_reserve = field(j, "reserve")
    let? reserve = boolean(raw_reserve)
    let? raw_suspended = field(j, "suspended")
    let? suspended = boolean(raw_suspended)
    let? raw_shop = field(j, "shop")
    let? shop = decode_inventory(raw_shop)
    let? voyage = match Json.get(j, "voyage") do
      Some(value) -> Result.map(decode_voyage(value), fn boat -> Some(boat))
      None -> Ok(None)
    end
    if !S.valid(port) || !S.valid(island) || !S.valid(producer) || !S.valid(market) ||
      !(plant == -1 || S.valid(plant)) || !(waste_site == -1 || S.valid(waste_site)) ||
      priority < 0 || priority > 2 || producer_stock < 0 || producer_stock > 72 || dock_food < 0 || dock_food > 64 ||
      dock_waste < 0 || dock_waste > 64 || fuel < 0 || landed_fuel < 0 || fuel + landed_fuel > 32 ||
      coverage < 0 || coverage > 100 || next_id < 1 || departure < 0 || wallet < 0 || duty < 0 ||
      expenses < 0 || demand < 0 || sold < 0 || sold > demand || price <= 0 do Err("Invalid freight route.")
    else
      Ok({
        port: port, island: island, producer: producer, market: market, plant: plant,
        waste_site: waste_site, priority: priority, producer_stock: producer_stock, dock_food: dock_food, dock_waste: dock_waste,
        fuel: fuel, landed_fuel: landed_fuel, next_id: next_id, departure: departure, price: price,
        demand: demand, sold: sold, sales: sales, cost_sold: cost_sold, spoiled: spoiled,
        wallet: wallet, duty: duty, expenses: expenses, delivered: delivered, exported: exported,
        month_waste: month_waste, month_sales: month_sales, month_cost: month_cost, month_days: month_days, coverage: coverage, backup: backup,
        reserve: reserve, suspended: suspended, shop: shop, voyage: voyage })
    end
  end
  pfn optional_array(j : Json.JsonValue, name : String, limit : Int) : Result(NativeIntArr, String) do
    match Json.get(j, name) do
      None -> Ok(NativeArray.make_int(2640, 0))
      Some(value) -> array(value, 2640, limit)
    end
  end
  pfn encode_livability(sample : NativeIntArr) : Json.JsonValue do
    enc_array(sample, 7, Nil)
  end
  pfn decode_livability(j : Json.JsonValue) : Result(NativeIntArr, String) do
    array(j, 8, 2147483647)
  end
  pfn encode_transfer(v : Option(Ur.Sim.MedicalTransfer)) : Json.JsonValue do
    match v do
      None -> Json.encode_array(Nil)
      Some(t) -> Json.encode_object(
        Cons(("facility", Json.encode_int(t.facility)), Cons(("bed", Json.encode_int(t.bed)),
        Cons(("transport", Json.encode_int(t.transport)), Cons(("wait", Json.encode_int(t.wait)),
        Cons(("stay", Json.encode_int(t.stay)), Cons(("outcome", Json.encode_int(t.outcome)),
        Cons(("route", Json.encode_array(List.map(t.route, Json.encode_int))), Nil))))))))
    end
  end
  pfn decode_transfer(j : Json.JsonValue) : Result(Option(Ur.Sim.MedicalTransfer), String) do
    match j do
      Json.Array(Nil) -> Ok(None)
      _ ->
        let? a = field(j, "facility")
        let? facility = integer(a)
        let? b = field(j, "bed")
        let? bed = integer(b)
        let? t = field(j, "transport")
        let? transport = integer(t)
        let? w = field(j, "wait")
        let? wait = integer(w)
        let? s = field(j, "stay")
        let? stay = integer(s)
        let? o = field(j, "outcome")
        let? outcome = integer(o)
        let? r = field(j, "route")
        let? route = items(r, parcel, 2640)
        let admitted = S.valid(facility) && bed >= 0 && bed < 4 && transport >= 2 && transport <= 121 &&
          wait >= 0 && wait <= 120 && stay >= 1 && stay <= 133 && (outcome == 1 || outcome == 2) && !List.is_empty(route)
        let unadmitted = facility == -1 && bed == -1 && transport == 0 && wait == 0 && stay == 0 && outcome == 3 && List.is_empty(route)
        if admitted || unadmitted do Ok(Some({ facility: facility, bed: bed, transport: transport, wait: wait, stay: stay, outcome: outcome, route: route }))
        else Err("Invalid medical transfer.") end
    end
  end
  pfn encode_incident(v : Ur.Sim.Incident) : Json.JsonValue do
    Json.encode_object(
      Cons(("lot", Json.encode_int(v.lot)),
      Cons(("kind", Json.encode_int(v.kind)),
      Cons(("reported", Json.encode_int(v.reported)),
      Cons(("station", Json.encode_int(v.station)),
      Cons(("response", Json.encode_int(v.response)),
      Cons(("travel", Json.encode_int(v.travel)),
      Cons(("road", Json.encode_array(List.map(v.road, Json.encode_int))),
      Cons(("spread", Json.encode_array(List.map(v.spread, Json.encode_int))),
      Cons(("medical", encode_transfer(v.medical)), Nil))))))))))
  end
  pfn decode_incident(j : Json.JsonValue) : Result(Ur.Sim.Incident, String) do
    let? raw_lot = field(j, "lot")
    let? lot = parcel(raw_lot)
    let? raw_kind = field(j, "kind")
    let? kind = integer(raw_kind)
    let? raw_reported = field(j, "reported")
    let? reported = integer(raw_reported)
    let? raw_station = field(j, "station")
    let? station = integer(raw_station)
    let? raw_response = field(j, "response")
    let? response = integer(raw_response)
    let? raw_travel = field(j, "travel")
    let? travel = integer(raw_travel)
    let? raw_road = field(j, "road")
    let? road = items(raw_road, parcel, 2640)
    let? spread = match Json.get(j, "spread") do
      None -> Ok(Nil)
      Some(data) -> items(data, parcel, 24)
    end
    let? medical = match Json.get(j, "medical") do
      None -> Ok(None)
      Some(data) -> decode_transfer(data)
    end
    let answered = S.valid(station) && response >= 0 && response <= 45 && travel >= 2 && travel <= response && !List.is_empty(road)
    let unanswered = station == -1 && response == -1 && travel == 0 && List.is_empty(road)
    if kind < 1 || kind > 4 || reported < 0 || reported > 100 || !(answered || unanswered) do Err("Invalid incident data.")
    else Ok({ lot: lot, kind: kind, reported: reported, station: station, response: response, travel: travel, road: road, spread: spread, medical: medical }) end
  end
  pfn encode_crime(v : Ur.Sim.CrimeMonth) : Json.JsonValue do
    Json.encode_object(Cons(("month", Json.encode_int(v.month)), Cons(("calls", Json.encode_array(List.map(v.calls, encode_incident))), Nil)))
  end
  pfn decode_crime(j : Json.JsonValue) : Result(Ur.Sim.CrimeMonth, String) do
    let? raw_month = field(j, "month")
    let? month = integer(raw_month)
    let? raw_calls = field(j, "calls")
    let? calls = items(raw_calls, decode_incident, 2640)
    if month < 0 do Err("Invalid incident month.") else Ok({ month: month, calls: calls }) end
  end
  pfn rule_or(j : Json.JsonValue, key : String, default : Int) : Result(Int, String) do
    match Json.get(j, key) do
      None -> Ok(default)
      Some(raw) ->
        let? rule = integer(raw)
        if rule >= 1 && rule <= 3 do Ok(rule) else Err("Invalid neighborhood rule.") end
    end
  end
  pfn encode_waste_run(run : Ur.Sim.WasteRun) : Json.JsonValue do
    Json.encode_object([
      ("depot", Json.encode_int(run.depot)), ("pickup", Json.encode_int(run.pickup)),
      ("site", Json.encode_int(run.site)), ("kind", Json.encode_int(run.kind)),
      ("units", Json.encode_int(run.units)), ("pickup_leg", Json.encode_int(run.pickup_leg)),
      ("route", Json.encode_array(List.map(run.route, Json.encode_int)))])
  end
  pfn decode_waste_run(j : Json.JsonValue) : Result(Ur.Sim.WasteRun, String) do
    let? raw_depot = field(j, "depot")
    let? depot = parcel(raw_depot)
    let? raw_pickup = field(j, "pickup")
    let? pickup = parcel(raw_pickup)
    let? raw_site = field(j, "site")
    let? site = parcel(raw_site)
    let? raw_kind = field(j, "kind")
    let? kind = integer(raw_kind)
    let? raw_units = field(j, "units")
    let? units = integer(raw_units)
    let? raw_pickup_leg = field(j, "pickup_leg")
    let? pickup_leg = integer(raw_pickup_leg)
    let? raw = field(j, "route")
    let? route = items(raw, parcel, 2640)
    if (kind != 15 && kind != 17 && (kind < 34 || kind > 36)) || units <= 0 || units > 48 ||
       pickup_leg < 1 || pickup_leg >= List.length(route) - 1 do Err("Invalid trash route.")
    else Ok({ depot: depot, pickup: pickup, site: site, kind: kind, units: units, pickup_leg: pickup_leg, route: route }) end
  end
  pfn encode_religion(r : Ur.Sim.Religion) : Json.JsonValue do
    Json.encode_object([
      ("state", Json.encode_array([
        Json.encode_int(r.patron),
        Json.encode_int(r.chosen),
        Json.encode_int(r.unlocked),
        Json.encode_int(r.festival_policy),
        Json.encode_int(r.offering_policy),
        Json.encode_int(r.offering_year),
        Json.encode_int(r.offering_spend),
        Json.encode_int(r.petition_day),
        Json.encode_int(r.rolls),
        Json.encode_int(r.dedication_target),
        Json.encode_int(r.dedication_end),
        Json.encode_int(r.curse_stamp),
        Json.encode_int(r.epicenter + 1),
        Json.encode_int(r.festival_stamp),
        Json.encode_int(r.festival_hosts),
        Json.encode_int(r.festival_attendees),
        Json.encode_int(r.festival_site + 1),
        Json.encode_int(r.favor.god),
        Json.encode_int(r.favor.until_day),
        Json.encode_int(r.favor.site + 1),
        Json.encode_int(r.curse.god),
        Json.encode_int(r.curse.until_day),
        Json.encode_int(r.curse.site + 1),
        Json.encode_int(r.wrath_god)
      ])),
      ("festival_feedback", enc_array(r.festival_feedback, 2639, Nil)),
      ("festival_absence", enc_array(r.festival_absence, 2639, Nil)),
      ("festival_attending", enc_array(r.festival_attending, 2639, Nil))
    ])
  end
  pfn decode_religion(j : Json.JsonValue) : Result(Ur.Sim.Religion, String) do
    let? raw = field(j, "state")
    let? state = array(raw, 24, 2147483647)
    let? feedback = optional_array(j, "festival_feedback", 20300)
    let? absence = optional_array(j, "festival_absence", 2640)
    let? attending = optional_array(j, "festival_attending", 12)
    if S.get(state, 0) > 5 ||
        S.get(state, 1) > 5 ||
        S.get(state, 2) > 4 ||
        S.get(state, 3) > 2 ||
        S.get(state, 4) > 2 ||
        S.get(state, 6) > 4200 ||
        S.get(state, 9) > 5 ||
        S.get(state, 12) > 2640 ||
        S.get(state, 14) > 5 ||
        S.get(state, 15) > 1000000 ||
        S.get(state, 16) > 2640 ||
        S.get(state, 17) > 5 ||
        S.get(state, 19) > 2640 ||
        S.get(state, 20) > 5 ||
        S.get(state, 22) > 2640 || S.get(state, 23) > 5 do Err("Invalid public religion state.") else
      Ok({ patron: S.get(state, 0), chosen: S.get(state, 1), unlocked: S.get(state, 2),
        festival_policy: S.get(state, 3), offering_policy: S.get(state, 4), offering_year: S.get(state, 5),
        offering_spend: S.get(state, 6), petition_day: S.get(state, 7), rolls: S.get(state, 8),
        dedication_target: S.get(state, 9), dedication_end: S.get(state, 10), curse_stamp: S.get(state, 11),
        epicenter: S.get(state, 12) - 1, festival_stamp: S.get(state, 13), festival_hosts: S.get(state, 14),
        festival_attendees: S.get(state, 15), festival_site: S.get(state, 16) - 1,
        favor: { god: S.get(state, 17), until_day: S.get(state, 18), site: S.get(state, 19) - 1 },
        curse: { god: S.get(state, 20), until_day: S.get(state, 21), site: S.get(state, 22) - 1 },
        wrath_god: S.get(state, 23), festival_feedback: feedback, festival_absence: absence, festival_attending: attending })
    end
  end
