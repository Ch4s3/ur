  pfn encode_cell(c : Ur.Rain.Cell) : Json.JsonValue do
    Json.encode_array([Json.encode_number(c.x), Json.encode_number(c.z), Json.encode_number(c.vx), Json.encode_number(c.vz),
      Json.encode_number(c.radius), Json.encode_int(c.level), Json.encode_number(c.start), Json.encode_number(c.stop)])
  end
  pfn coordinate(j : Json.JsonValue) : Result(Float, String) do
    match j do
      Json.Number(n) -> if n >= -100000.0 && n <= 100000.0 do Ok(n) else Err("Invalid storm.") end
      _ -> Err("Invalid storm.")
    end
  end
  pfn decode_cell(j : Json.JsonValue) : Result(Ur.Rain.Cell, String) do
    match j do
      Json.Array(Cons(x, Cons(z, Cons(vx, Cons(vz, Cons(r, Cons(level, Cons(start, Cons(stop, Nil))))))))) ->
        let? x = coordinate(x)
        let? z = coordinate(z)
        let? vx = coordinate(vx)
        let? vz = coordinate(vz)
        let? r = coordinate(r)
        let? level = integer(level)
        let? start = coordinate(start)
        let? stop = coordinate(stop)
        Ok({ x: x, z: z, vx: vx, vz: vz, radius: r, level: S.clamp(level, 0, 4), start: start, stop: stop })
      _ -> Err("Invalid storm.")
    end
  end
  pfn enc_signed(a : NativeIntArr) : Json.JsonValue do enc_array(a, NativeArray.length_int(a) - 1, Nil) end
  pfn decode_signed(xs : List(Json.JsonValue), a : NativeIntArr, i : Int, length : Int) : Result(NativeIntArr, String) do
    match xs do
      Nil -> if i == length do Ok(a) else Err("Incomplete air data.") end
      Cons(value, rest) ->
        let? n = integer(value)
        if i >= length do Err("Invalid air data.") else decode_signed(rest, NativeArray.set_int(a, i, n), i + 1, length) end
    end
  end
  pfn signed_array(j : Json.JsonValue, length : Int) : Result(NativeIntArr, String) do
    match j do
      Json.Array(xs) -> decode_signed(xs, NativeArray.make_int(length, 0), 0, length)
      _ -> Err("Missing air data.")
    end
  end
  -- the day's air as the simulation reads it; its coast field is rebuilt from the heights on load
  pfn encode_air(a : Ur.Air.Air) : Json.JsonValue do
    Json.encode_object([("day", Json.encode_int(a.day)), ("shadow", enc_signed(a.shadow)), ("lift", enc_signed(a.lift)),
      ("sea", Json.encode_int(a.sea)), ("daily", Json.encode_int(a.daily)), ("kind", Json.encode_int(a.kind)), ("soil", Json.encode_int(a.soil))])
  end
  pfn decode_air(j : Json.JsonValue, heights : NativeIntArr) : Result(Ur.Air.Air, String) do
    let? raw_day = field(j, "day")
    let? day = integer(raw_day)
    let? raw_shadow = field(j, "shadow")
    let? shadow = array(raw_shadow, S.count(), 1)
    let? raw_lift = field(j, "lift")
    let? lift = signed_array(raw_lift, Ur.Air.snapshots() * Ur.Air.areas())
    let? raw_sea = field(j, "sea")
    let? sea = integer(raw_sea)
    let? raw_daily = field(j, "daily")
    let? daily = integer(raw_daily)
    let? raw_kind = field(j, "kind")
    let? kind = integer(raw_kind)
    let? raw_soil = field(j, "soil")
    let? soil = integer(raw_soil)
    Ok(Ur.Air.restore(day, heights, shadow, lift, sea, daily, kind, soil))
  end
  pfn decode_city(j : Json.JsonValue) : Result(Ur.Sim.City, String) do
    let? freight = match Json.get(j, "freight") do
      Some(value) -> Result.map(decode_freight(value), fn route -> Some(route))
      None -> Ok(None)
    end
    let? waste_live = match Json.get(j, "waste_live") do
      Some(value) -> boolean(value)
      None -> Ok(false)
    end
    let? waste_bins = optional_array(j, "waste_bins", 2)
    let? waste_stock = optional_array(j, "waste_stock", 2147483647)
    let? waste_sites = optional_array(j, "waste_sites", 2400)
    let? waste_last = optional_array(j, "waste_last", 2147483647)
    let? waste_log = optional_array(j, "waste_log", 2147483647)
    let? waste_runs = match Json.get(j, "waste_runs") do
      Some(value) -> items(value, decode_waste_run, 3)
      None -> Ok(Nil)
    end
    let? council = optional_array(j, "council", 2147483647)
    let? religion = match Json.get(j, "religion") do
      Some(value) -> decode_religion(value)
      None -> Ok(S.new_religion())
    end
    let? raw_construction_spend = field(j, "construction_spend")
    let? construction_spend = integer(raw_construction_spend)
    let? raw_island_exports = field(j, "island_exports")
    let? island_exports = integer(raw_island_exports)
    let? raw_island_crops = field(j, "island_crops")
    let? island_crops = integer(raw_island_crops)
    let? raw_island_catch = field(j, "island_catch")
    let? island_catch = integer(raw_island_catch)
    let? raw_shop_imports = field(j, "shop_imports")
    let? shop_imports = integer(raw_shop_imports)
    let? raw_harbour = field(j, "harbour")
    let? harbour = integer(raw_harbour)
    let? raw_basin = opt_int(j, "harbour_basin", -1)
    let? raw_ferry_start = field(j, "ferry_start")
    let? ferry_start = integer(raw_ferry_start)
    let? raw_trash = field(j, "trash")
    let? trash = integer(raw_trash)
    let? raw_cash = field(j, "cash")
    let? cash = integer(raw_cash)
    let? raw_month = field(j, "month")
    let? month = integer(raw_month)
    let? raw_tax = field(j, "tax")
    let? tax = integer(raw_tax)
    let? raw_business_rate = field(j, "business_rate")
    let? business_rate = integer(raw_business_rate)
    let? raw_import_rate = field(j, "import_rate")
    let? import_rate = integer(raw_import_rate)
    let? raw_export_rate = field(j, "export_rate")
    let? export_rate = integer(raw_export_rate)
    let? raw_energy = field(j, "energy")
    let? energy = integer(raw_energy)
    let? raw_income = field(j, "income")
    let? income = integer(raw_income)
    let? raw_island_spend = field(j, "island_spend")
    let? island_spend = array(raw_island_spend, 3, 2147483647)
    let? raw_shop_stock = field(j, "shop_stock")
    let? shop_stock = array(raw_shop_stock, S.count(), 16)
    let? raw_shop_sales = field(j, "shop_sales")
    let? shop_sales = array(raw_shop_sales, S.count(), 8)
    let? raw_shop_delivered = field(j, "shop_delivered")
    let? shop_delivered = array(raw_shop_delivered, S.count(), 16)
    let? raw_heights = field(j, "heights")
    let? heights = array(raw_heights, S.count(), 200)
    let? public_parking = optional_array(j, "public_parking", 3)
    let? road_shapes = optional_array(j, "road_shapes", Ur.RoadShape.save_limit())
    let? canals = optional_array(j, "canals", 6)
    let? water_bus = optional_array(j, "water_bus", S.water_bus_limit())
    let? canal_docks = optional_array(j, "canal_docks", 2)
    let? grades = optional_array(j, "grades", S.grade_save_limit())
    let? grade_cover = optional_array(j, "grade_cover", S.count())
    let? park_tiers = optional_array(j, "park_tiers", 2)
    let? sidewalk_items = optional_array(j, "sidewalk_items", 4095)
    let? streetscape = optional_array(j, "streetscape", 5)
    let? fire_recovery = optional_array(j, "fire_recovery", 15)
    let? calendar_day = match Json.get(j, "calendar_day") do
      None -> Ok(0)
      Some(value) -> integer(value)
    end
    let? clock_ms = match Json.get(j, "clock_ms") do
      None -> Ok(0)
      Some(value) -> integer(value)
    end
    let? street_day = match Json.get(j, "street_day") do
      None -> Ok(0)
      Some(value) -> integer(value)
    end
    let? car_free_days = optional_array(j, "car_free_days", 4)
    let? ground_rule = rule_or(j, "ground_rule", 2)
    let? quiet_rule = rule_or(j, "quiet_rule", 1)
    let? ground_areas = optional_array(j, "ground_areas", 3)
    let? quiet_areas = optional_array(j, "quiet_areas", 3)
    let? storefronts = optional_array(j, "storefronts", 3)
    let? footfall = optional_array(j, "footfall", 48)
    let? parks = optional_array(j, "parks", S.count())
    let? raw_roads = field(j, "roads")
    let? roads = array(raw_roads, S.count(), 3)
    let? raw_tolls = field(j, "tolls")
    let? tolls = array(raw_tolls, S.count(), 1)
    let? raw_transit = field(j, "transit")
    let? transit = array(raw_transit, S.count(), 4)
    let? raw_stops = field(j, "stops")
    let? stops = array(raw_stops, S.count(), 4)
    let? raw_ferries = field(j, "ferries")
    let? ferries = array(raw_ferries, S.count(), S.count())
    let? bus_fare = match Json.get(j, "bus_fare") do
      Some(amount) -> integer(amount)
      None -> Ok(1)
    end
    let? raw_service = field(j, "service")
    let? service = array(raw_service, S.count(), 3)
    let? raw_zones = field(j, "zones")
    let? zones = array(raw_zones, S.count(), 4)
    let? raw_density = field(j, "density")
    let? density = array(raw_density, S.count(), 3)
    let? raw_nuisance = field(j, "nuisance")
    let? nuisance = array(raw_nuisance, S.count(), 3)
    let? raw_buildings = field(j, "buildings")
