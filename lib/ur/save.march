      None -> Ok(Ur.Demography.empty())
      Some(raw) -> array(raw, 17, 1000000)
    end
    let? population_history = match Json.get(j, "population_history") do
      None -> Ok(Nil)
      Some(raw) -> items(raw, fn row -> array(row, 6, 2147483647), 24)
    end
    let? immigration = match Json.get(j, "immigration") do
      None -> Ok(1)
      Some(raw) -> integer(raw)
    end
    let? education = match Json.get(j, "education") do
      None -> Ok(S.new_education())
      Some(raw) -> array(raw, 228, 1000000)
    end
    let? specializations = match Json.get(j, "specializations") do
      None -> Ok(S.new_specializations())
      Some(raw) -> match raw do
        Json.Array(xs) ->
          let length = List.length(xs)
          if length == 57 || length == 71 do decode_array(xs, S.new_specializations(), 0, length, 1000000)
          else Err("Invalid specialization data.") end
        _ -> Err("Missing specialization data.")
      end
    end
    let? business_sector = optional_array(j, "business_sector", 7)
