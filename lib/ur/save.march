    let? crime_history = match Json.get(j, "crime_history") do
      None -> Ok(Nil)
      Some(samples) -> items(samples, decode_crime, 24)
    end
    let? livability_history = match Json.get(j, "livability_history") do
      None -> Ok(Nil)
      Some(samples) -> items(samples, decode_livability, 24)
    end
    let? raw_message = field(j, "message")
    let? message = string(raw_message)
    if !((harbour == -1 || S.valid(harbour)) && (ferry_start == -1 || S.valid(ferry_start)) && month >= 0 && construction_spend >= 0 && tax >= 0 && tax <= 25 && energy >= 1 && energy <= 12) do Err("Invalid city values.") else
    Ok({ climate_seed: S.clamp(climate_seed, 0, 2147483646), storm_drains: storm_drains, seawalls: seawalls, surface_water: surface_water, flood_damage: flood_damage, flood_active: flood_active, rain_tanks: rain_tanks, subway_water: subway_water, soil_moisture: S.clamp(soil, 0, 100), pumping_cost: S.clamp(pumping, 0, 200000),
      waste_live: waste_live, waste_bins: waste_bins, waste_stock: waste_stock, waste_sites: waste_sites,
      waste_last: waste_last, waste_log: waste_log, waste_runs: waste_runs, council: council, religion: religion, construction_spend: construction_spend, island_exports: island_exports, island_crops: island_crops, island_catch: island_catch,
      shop_imports: shop_imports, harbour: harbour, ferry_start: ferry_start, trash: trash,
      cash: cash, month: month, tax: tax, business_rate: business_rate,
      import_rate: import_rate, export_rate: export_rate, energy: energy, income: income,
      island_spend: island_spend, freight: freight, shop_stock: shop_stock, shop_sales: shop_sales, shop_delivered: shop_delivered,
      heights: heights, roads: roads, grades: grades, grade_cover: grade_cover, parks: parks, calendar_day: S.clamp(calendar_day, 0, S.days_per_month() - 1), clock_ms: S.clamp(clock_ms, 0, float_to_int(S.day_seconds() *. 1000.0) - 1), street_day: S.clamp(street_day, 0, 6), car_free_days: car_free_days, ground_rule: ground_rule, quiet_rule: quiet_rule, ground_areas: ground_areas, quiet_areas: quiet_areas, storefronts: storefronts, footfall: footfall, fire_recovery: fire_recovery, park_tiers: park_tiers, streetscape: streetscape, sidewalk_items: sidewalk_items, tolls: tolls, public_parking: public_parking, transit: transit,
      stops: stops, ferries: ferries, service: service, bus_fare: S.clamp(bus_fare, 0, 6), bus_headways: NativeArray.make_int(2640, 0), zones: zones,
      density: density, nuisance: nuisance, buildings: buildings, housing_losses: housing_losses,
      business_losses: business_losses, construction: construction, plants: plants, paused_facilities: paused_facilities, pipes: pipes,
      grid: grid, pollution: pollution, land_pollution: land_pollution, air_pollution: air_pollution, founding_map: founding_map,
      expansion: expansion, shipments: shipments, finance_history: finance_history, market_history: market_history, campus: campus, census: census, population_history: population_history, immigration: S.clamp(immigration, 0, 2), education: education, specializations: specializations, business_sector: business_sector, empty_homes: empty_homes, home_arrivals: home_arrivals, neighborhood_rents: neighborhood_rents, rent_pressure: rent_pressure, business_age: business_age, property_status: property_status, property_arrears: property_arrears, property_sales: property_sales, crime_history: crime_history, livability_history: livability_history, message: message })
    end
  end
  pfn encode_game(v : Game) : Json.JsonValue do
    Json.encode_object(
      Cons(("speed", Json.encode_int(v.speed)),
      Cons(("city", encode_city(v.city)),
      Cons(("cx", Json.encode_number(v.cx)),
      Cons(("cz", Json.encode_number(v.cz)),
      Cons(("zoom", Json.encode_number(v.zoom)),
      Cons(("yaw", Json.encode_number(v.yaw)),
      Cons(("paused", Json.encode_bool(v.paused)), Nil))))))))
  end
  pfn decode_game(j : Json.JsonValue) : Result(Game, String) do
    let? raw_speed = field(j, "speed")
    let? speed = integer(raw_speed)
    let? raw_city = field(j, "city")
    let? city = decode_city(raw_city)
    let? raw_cx = field(j, "cx")
    let? cx = number(raw_cx)
    let? raw_cz = field(j, "cz")
    let? cz = number(raw_cz)
    let? raw_zoom = field(j, "zoom")
    let? zoom = number(raw_zoom)
    let? raw_yaw = field(j, "yaw")
    let? yaw = number(raw_yaw)
    let? raw_paused = field(j, "paused")
    let? paused = boolean(raw_paused)
    if !(zoom >= 18.0 && zoom <= 380.0 && speed >= 1 && speed <= 3) do Err("Invalid game values.") else
    Ok({ speed: speed, city: city, cx: cx, cz: cz,
      zoom: zoom, yaw: yaw, paused: paused })
    end
  end
  fn encode(game : Game) : String do
    Json.to_string(Json.encode_object(Cons(("version", Json.encode_int(1)), Cons(("game", encode_game(game)), Nil))))
  end
  fn decode(text : String) : Result(Game, String) do
    let? json = Json.parse(text)
    let? tag = field(json, "version")
    let? version = integer(tag)
    if version == 1 do
      let? game = field(json, "game")
      decode_game(game)
    else Err("Unsupported save version.") end
  end
  fn exists(path : String) : Bool do
    match File.exists(path) do
      Ok(present) -> present
      Err(_) -> false
    end
  end
  fn load(path : String) : Result(Game, String) do
    match File.read(path) do
      Ok(Ok(text)) -> decode(text)
      _ -> Err("Could not read the saved city.")
    end
  end
  fn save(path : String, game : Game) : Result(Unit, String) do
    let staging = path ++ "." ++ int_to_string(Authority.must(Process.pid())) ++ ".tmp"
    match File.write(staging, encode(game)) do
      Ok(Ok(_)) -> match File.rename(staging, path) do
        Ok(Ok(_)) -> Ok(())
        _ -> Err("Could not replace the saved city.")
      end
      _ -> Err("Could not write the saved city.")
    end
  end
end
