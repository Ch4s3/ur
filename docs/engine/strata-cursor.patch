diff --git a/lib/strata/ffi/vk.march b/lib/strata/ffi/vk.march
index e012de4..13945fc 100644
--- a/lib/strata/ffi/vk.march
+++ b/lib/strata/ffi/vk.march
@@ -20,6 +20,8 @@ mod Strata.Ffi.Vk do
     fn x_poll(): Unit = "sv_poll"
     fn x_key(k: Int): Int = "sv_key"
     fn x_mouse_button(b: Int): Int = "sv_mouse_button"
+    fn x_mouse_x(): Float = "sv_mouse_x"
+    fn x_mouse_y(): Float = "sv_mouse_y"
     fn x_mouse_dx(): Float = "sv_mouse_dx"
     fn x_mouse_dy(): Float = "sv_mouse_dy"
     fn x_time(): Float = "sv_time"
@@ -85,6 +87,10 @@ mod Strata.Ffi.Vk do
   fn key(k : Int) : Bool do x_key(k) == 1 end
   doc "Is mouse button [b] held? 0 left, 1 right, 2 middle."
   fn mouse_button(b : Int) : Bool do x_mouse_button(b) == 1 end
+  doc "Cursor x in window points, from the left edge; 0 without a window."
+  fn mouse_x() : Float do x_mouse_x() end
+  doc "Cursor y in window points, from the top edge; 0 without a window."
+  fn mouse_y() : Float do x_mouse_y() end
   fn mouse_dx() : Float do x_mouse_dx() end
   fn mouse_dy() : Float do x_mouse_dy() end
   doc "Seconds since the window system started."
diff --git a/native/strata_vk.c b/native/strata_vk.c
index 4cd25b7..177670f 100644
--- a/native/strata_vk.c
+++ b/native/strata_vk.c
@@ -2349,6 +2349,8 @@ void sv_poll(void) { g.mdx = 0; g.mdy = 0; if (g.win) glfwPollEvents(); }
 int64_t sv_key(int64_t k) { return (k >= 0 && k < SV_MAX_KEYS) ? g.keys[k] : 0; }
 /* Is mouse button b (0 left, 1 right, 2 middle) held? */
 int64_t sv_mouse_button(int64_t b) { return (g.win && b >= 0 && b <= 7 && glfwGetMouseButton(g.win, (int)b) == GLFW_PRESS) ? 1 : 0; }
+double sv_mouse_x(void) { if (g.win && g.have_mouse) return g.mx; double x = 0, y = 0; if (g.win) glfwGetCursorPos(g.win, &x, &y); return x; }
+double sv_mouse_y(void) { if (g.win && g.have_mouse) return g.my; double x = 0, y = 0; if (g.win) glfwGetCursorPos(g.win, &x, &y); return y; }
 double sv_mouse_dx(void) { return g.mdx; }
 double sv_mouse_dy(void) { return g.mdy; }
 double sv_time(void) { return glfwGetTime(); }
