mod RoadPlanningTest do
  needs IO
  needs IO.Console
  needs IO.Clock
  needs IO.Process
  needs IO.FileRead
  needs IO.FileWrite
  alias Ur.Sim as S
  alias Ur.Build as RoadBuild

  pfn fixture() : Ur.Sim.City do
    let c = S.new()
    let zero = NativeArray.make_int(S.count(), 0)
    { c with heights: NativeArray.make_int(S.count(), 10), harbour: S.index(2, 10),
      roads: NativeArray.set_int(zero, S.index(2, 10), 1), zones: zero, buildings: zero, plants: zero,
      cash: 20000 }
  end
  pfn surface() : Unit do
    let c = fixture()
    let a = S.index(3, 10)
    let m = S.index(4, 10)
    let b = S.index(5, 10)
    let p = RoadBuild.preview(c, 1, a, b)
    Test.assert_true(p.valid && p.cost == 180 && p.upkeep == 9 && p.length == 24, "Quick street and its quote agree")
    Test.assert_eq_int(p.city.cash, c.cash - 180, "Confirmation deducts the quoted amount")
    let low = { c with cash: 179 }
    let requoted = RoadBuild.preview(low, 1, a, b)
    Test.assert_true(!requoted.valid && requoted.city.cash == 179 && S.get(requoted.city.roads, a) == 0,
      "A quote can be revalidated after the treasury changes")
    let grade = { c with heights: NativeArray.set_int(c.heights, b, 22) }
    Test.assert_true((RoadBuild.preview(grade, 1, a, b)).valid, "Exactly 3 metres of rise is allowed")
    let steep = { c with heights: NativeArray.set_int(c.heights, b, 23) }
    let p = RoadBuild.preview(steep, 1, a, b)
    Test.assert_true(!p.valid && p.blocked == b && p.edge == m && p.city.cash == c.cash, "Steep edge identifies both parcels and charges nothing")
    let water = { c with heights: NativeArray.set_int(c.heights, b, 0) }
    let p = RoadBuild.preview(water, 1, a, b)
    Test.assert_true(!p.valid && !p.changed && p.blocked == b && p.city.cash == c.cash && S.get(p.city.roads, a) == 0, "Blocked final parcel rolls back the whole street")
    let end_lot = S.index(5, 12)
    let d = { RoadBuild.new_draft() with mode: 1, points: [RoadBuild.point(a, false), RoadBuild.point(end_lot, false)] }
    Test.assert_true(!(RoadBuild.planned(water, 1, d, true)).valid, "Horizontal first runs into water")
    let alternate = { d with points: [RoadBuild.point(a, false), RoadBuild.point(end_lot, true)] }
    Test.assert_true((RoadBuild.planned(water, 1, alternate, true)).valid, "Vertical first bypasses the same water")
    let added = RoadBuild.draft_input(d, 1, S.index(6, 12), S.index(6, 12), true, true, false, false)
    let dragged = RoadBuild.draft_input(added, 1, S.index(7, 12), S.index(7, 12), false, true, false, false)
    Test.assert_eq_int(RoadBuild.end_point(dragged), S.index(7, 12), "A placed waypoint can be dragged")
    Test.assert_eq_int(List.length((RoadBuild.reset(dragged)).points), 0, "Cancellation discards all waypoints")
  end
  pfn layouts() : Unit do
    let c = fixture()
    let a = S.index(3, 10)
    let b = S.index(11, 18)
    let middle = S.index(7, 14)
    let block = RoadBuild.grid(a, b, S.width())
    let grid = RoadBuild.grid(a, b, 4)
    Test.assert_eq_int(List.length(block), 32, "One block places only its perimeter")
    Test.assert_eq_int(List.length(grid), 45, "A two by two grid counts shared junctions once")
    let remainder = RoadBuild.grid(a, S.index(8, 15), 4)
    Test.assert_eq_int(List.length(remainder), 20, "A short remainder leaves frontage by the perimeter")
    let p = RoadBuild.road_preview(c, 1, grid, true)
    Test.assert_true(p.valid && p.cost == 45 * 60 && !List.is_empty(p.frontage), "Grids quote unique street parcels and show frontage")
    let shared = RoadBuild.road_preview((RoadBuild.preview(c, 1, a, S.index(11, 10))).city, 1, grid, true)
    Test.assert_eq_int(shared.cost, 36 * 60, "An existing edge is free")
    let lake = { c with heights: NativeArray.set_int(c.heights, middle, 0) }
    let blocked = RoadBuild.road_preview(lake, 1, grid, true)
    Test.assert_true(!blocked.valid && blocked.blocked == middle && blocked.city.cash == c.cash, "Water on an interior road blocks the whole grid")
    let fitted = RoadBuild.road_preview(lake, 1, RoadBuild.grid(a, S.index(6, 18), 4), true)
    Test.assert_true(fitted.valid && fitted.changed, "Resizing the grid avoids an interior obstruction")
  end
  pfn replace() : Unit do
    let c = fixture()
    let a = S.index(3, 14)
    let m = S.index(4, 14)
    let b = S.index(5, 14)
    let c = (RoadBuild.preview(c, 1, a, b)).city
    let c = { c with transit: NativeArray.set_int(c.transit, m, 2), stops: NativeArray.set_int(c.stops, m, 1),
      storm_drains: NativeArray.set_int(c.storm_drains, m, 1) }
    let d = { RoadBuild.new_draft() with mode: 4, points: [RoadBuild.point(m, false)] }
    let p = RoadBuild.planned(c, 48, d, true)
    Test.assert_true(p.valid && p.cost == 195 && p.upkeep == 9, "Replace selects and prices the whole corridor")
    Test.assert_true(S.get(p.city.transit, m) == 2 && S.get(p.city.stops, m) == 1 && S.get(p.city.storm_drains, m) == 1, "Widening preserves compatible infrastructure")
    let p = RoadBuild.planned(c, 49, d, true)
    Test.assert_true(!p.valid && p.blocked == m && p.city.cash == c.cash, "Bus route blocks pedestrian conversion at its exact parcel")
    let cleared = { c with transit: NativeArray.set_int(c.transit, m, 0), stops: NativeArray.set_int(c.stops, m, 0) }
    let p = RoadBuild.planned(cleared, 49, d, true)
    Test.assert_true(p.valid && S.get(p.city.roads, b) == 3 && S.get(p.city.storm_drains, m) == 1, "Cleared corridor can become pedestrian while keeping drainage")
  end
  pfn solid_at(parts : List(Ur.Architecture.Piece), x : Int, y : Int, z : Int) : Bool do
    List.any(parts, fn p -> x >= p.x && x < p.x + p.w && y >= p.y && y < p.y + p.h && z >= p.z && z < p.z + p.d)
  end
  pfn flush_markings() : Unit do
    let c = fixture()
    let lot = S.index(8, 10)
    let west = S.index(7, 10)
    let east = S.index(9, 10)
    List.each([(1, 8, 2), (2, 10, 4), (3, 17, 4)], fn spec ->
      let (kind, ink, x) = spec
      let roads = List.fold_left([west, lot, east], c.roads, fn (roads, i) -> NativeArray.set_int(roads, i, kind))
      let parts = Ur.Landscape.portal_street({ c with roads: roads }, lot, 10)
      let line = List.filter(parts, fn p -> p.material == ink)
      let surface = List.filter(parts, fn p -> p.material == 4 || p.material == 16)
      Test.assert_true(solid_at(line, x, 10, 15) && !solid_at(parts, x, 11, 15) &&
        !solid_at(surface, x, 10, 15) && solid_at(surface, x, 10, 13),
        "The centre marking replaces a strip of pavement at the same height")
      let width = S.road_half_width(kind)
      let walk = S.sidewalk_width(kind)
      let sidewalk = List.filter(parts, fn p -> p.material == 24)
      let curb = List.filter(parts, fn p -> p.material == 23)
      Test.assert_true(solid_at(sidewalk, 15, 11, 16 - width - walk) && solid_at(curb, 15, 11, 15 - width) &&
        solid_at(curb, 15, 11, 16 + width) && solid_at(sidewalk, 15, 11, 15 + width + walk),
        "Both sidewalks have raised paving and a defined curb within the parcel")
      List.each([0, 1, 2, 3], fn spot ->
        let (sx, sz) = S.sidewalk_point({ c with roads: roads }, lot, spot)
        Test.assert_true(sx > 0 && sx < 31 && sz > 0 && sz < 31 &&
          (solid_at(sidewalk, sx, 11, sz) || solid_at(curb, sx, 11, sz)), "A fixture stays on its sidewalk")))
  end
  pfn isolated_sidewalks() : Unit do
    let c = fixture()
    let lot = S.index(8, 10)
    List.each([1, 2, 3], fn kind ->
      let isolated = { c with roads: NativeArray.set_int(c.roads, lot, kind) }
      let parts = Ur.Landscape.portal_street(isolated, lot, 10)
      let sidewalk = List.filter(parts, fn p -> p.material == 23 || p.material == 24)
      List.each([0, 1, 2, 3], fn spot ->
        let (x, z) = S.sidewalk_point(isolated, lot, spot)
        let y = Ur.Landscape.sidewalk_height(isolated, lot, x, z)
        Test.assert_true(solid_at(sidewalk, x, y - 1, z) && !solid_at(parts, x, y, z),
          "An isolated street seats its fixtures on the rounded sidewalk")))
  end
  pfn turnaround() : Unit do
    let c = fixture()
    let end_lot = S.index(8, 10)
    let c = (RoadBuild.preview(c, 1, S.index(3, 10), end_lot)).city
    let end_parts = Ur.Landscape.portal_street(c, end_lot, 10)
    Test.assert_true(solid_at(end_parts, 0, 10, 16) && solid_at(end_parts, 18, 10, 3) &&
      solid_at(end_parts, 28, 10, 16) && !solid_at(end_parts, 31, 10, 16) &&
      !solid_at(end_parts, 29, 10, 3), "A local dead end widens into a round bulb inside its parcel")
    let from = S.index(7, 10)
    let curb = List.filter(end_parts, fn p -> p.material == 23 || p.material == 24)
    List.each([0, 1, 2, 3], fn spot ->
      let (x, z) = S.sidewalk_point(c, end_lot, spot)
      Test.assert_true(solid_at(curb, x, 11, z), "Sidewalk fixtures stay on the curb around the bulb"))
    List.each([0.0, Math.pi() *. 0.5, Math.pi()], fn angle ->
      let (x, z, dx, dz) = Ur.Scene.turnaround_pose(from, end_lot, angle)
      let lx = x -. 256.0
      let lz = z -. 320.0
      Test.assert_true(solid_at(end_parts, float_to_int(lx +. dx *. 5.0), 10, float_to_int(lz +. dz *. 5.0)) &&
        solid_at(end_parts, float_to_int(lx -. dx *. 5.0), 10, float_to_int(lz -. dz *. 5.0)),
        "A vehicle follows the turnaround inside the paved bulb"))
    let next = S.index(9, 10)
    let continued = (RoadBuild.preview(c, 1, end_lot, next)).city
    let through = Ur.Landscape.portal_street(continued, end_lot, 10)
    Test.assert_true(solid_at(through, 31, 10, 16) && !solid_at(through, 18, 10, 3),
      "Extending a street restores its through lanes")
    let junction = (RoadBuild.preview(continued, 1, end_lot, S.index(8, 11))).city
    let parts = Ur.Landscape.portal_street(junction, end_lot, 10)
    Test.assert_true(solid_at(parts, 0, 10, 16) && solid_at(parts, 31, 10, 16) &&
      solid_at(parts, 16, 10, 31) && !solid_at(parts, 16, 10, 0) &&
      !solid_at(parts, 0, 10, 0), "A T-junction leaves its closed frontage and corners unpaved")
    let zebra = List.filter(parts, fn p -> p.material == 8)
    let asphalt = List.filter(parts, fn p -> p.material == 4)
    Test.assert_true(solid_at(zebra, 3, 10, 7) && !solid_at(parts, 3, 11, 7) &&
      !solid_at(asphalt, 3, 10, 7) && solid_at(asphalt, 3, 10, 9),
      "Crosswalk stripes replace the asphalt flush with the street")
  end
  pfn straight_street() : Unit do
    let c = fixture()
    let a = S.index(3, 10)
    let wanted = S.index(7, 12)
    let b = S.index(7, 10)
    let d = { RoadBuild.new_draft() with mode: 5, points: [RoadBuild.point(a, false)], target: wanted }
    Test.assert_eq_int(RoadBuild.confirm_points(1, d.mode), 2, "Straight street requires a pinned start and end")
    let p = RoadBuild.planned(c, 1, d, false)
    Test.assert_true(p.valid && p.length == 40 && p.cost == 300 && S.get(p.city.roads, b) == 1 &&
      S.get(p.city.roads, wanted) == 0, "Straight street constrains the quote and build to one axis")
    let view = { w: 1000.0, h: 640.0, cx: 44.0, cz: 84.0, zoom: 50.0, yaw: 0.0 }
    let interior = S.index(5, 10)
    let (x, y) = Ur.Scene.world_point(view, 176.0, 10.0, 336.0)
    Test.assert_eq_int(Ur.Scene.road_snap(p.city, view, interior, -1, x, y, false), interior,
      "Snapping finds an interior road parcel for a T-junction")
  end
  pfn drawn_streets() : Unit do
    let c = fixture()
    let a = S.index(4, 10)
    let b = S.index(10, 16)
    let middle = S.index(7, 13)
    let bend = S.index(10, 10)
    let start = RoadBuild.point(a, false)
    let finish = RoadBuild.point(b, false)
    let d = { RoadBuild.new_draft() with mode: RoadBuild.diagonal_mode(), points: [start, finish] }
    let diagonal = RoadBuild.planned(c, 1, d, true)
    Test.assert_true(diagonal.valid && S.get(diagonal.city.roads, middle) == 1 &&
      S.get(diagonal.city.roads, bend) == 0 && List.length(diagonal.tiles) == 13,
      "A diagonal crosses the middle without taking an L-shaped detour")
    let d = { d with mode: RoadBuild.curve_mode(), points: [start, RoadBuild.point(bend, false), finish] }
    let curve = RoadBuild.planned(c, 1, d, true)
    Test.assert_true(curve.valid && S.get(curve.city.roads, S.index(9, 12)) == 1 &&
      S.get(curve.city.roads, bend) == 0, "The curve follows the handle without paving its parcel")
    let d = { RoadBuild.new_draft() with mode: RoadBuild.freeform_mode() }
    let d = RoadBuild.draft_input(d, 1, a, a, true, true, false, false)
    let d = RoadBuild.draft_input(d, 1, middle, middle, false, true, false, false)
    let d = RoadBuild.draft_input(d, 1, b, b, false, false, false, false)
    let sketch = RoadBuild.planned(c, 1, d, true)
    Test.assert_true(sketch.valid && S.get(sketch.city.roads, middle) == 1 &&
      RoadBuild.end_point(d) == b && d.drag < 0, "A freeform stroke fills gaps between pointer samples and retains the released end")
  end
  pfn off_grid_streets() : Unit do
    let c = fixture()
    let a = S.index(3, 10)
    let b = S.index(8, 14)
    let start = { RoadBuild.point(a, false) with site: Some({ x: 105, z: 339 }) }
    let finish = { RoadBuild.point(b, false) with site: Some({ x: 281, z: 460 }) }
    let d = { RoadBuild.new_draft() with mode: RoadBuild.diagonal_mode(), points: [start, finish] }
    let p = RoadBuild.planned(c, 1, d, true)
    let s = Ur.RoadShape.decode(S.get(p.city.road_shapes, a))
    let last = Ur.RoadShape.decode(S.get(p.city.road_shapes, b))
    Test.assert_true(p.valid && s.a.x == 9 && s.a.z == 19 && last.b.x == 25 && last.b.z == 12,
      "The constructed road keeps both off-grid endpoints")
    let plot = S.index(8, 15)
    let zoned = S.act(p.city, plot, 2)
    Test.assert_true(S.get(S.access(p.city), b) >= 0 && S.fleet_frontage(p.city, plot, 0) == b &&
      S.get(zoned.zones, plot) > 0,
      "An off-grid street is reachable from the harbour and supplies frontage")
    match p.tiles do
      Cons(first, Cons(second, _)) ->
        let (x0, z0, dx0, dz0) = Ur.Scene.street_pose(p.city, first, second, 0.49999, 5.0)
        let (x1, z1, dx1, dz1) = Ur.Scene.street_pose(p.city, first, second, 0.5, 5.0)
        Test.assert_true(Math.abs(x0 -. x1) < 0.01 && Math.abs(z0 -. z1) < 0.01 &&
          Math.abs(dx0 -. dx1) < 0.01 && Math.abs(dz0 -. dz1) < 0.01 &&
          Math.abs(dx1) > 0.2 && Math.abs(dz1) > 0.2, "Lanes meet continuously at an off-grid seam")
      _ -> Test.assert_true(false, "The road crosses multiple parcels")
    end
    let game = { city: p.city, cx: 60.0, cz: 80.0, zoom: 30.0, yaw: 0.55, paused: true, speed: 1 }
    match Ur.Save.decode(Ur.Save.encode(game)) do
      Err(message) -> Test.assert_true(false, message)
      Ok(loaded) -> Test.assert_eq_int(S.get(loaded.city.road_shapes, a), S.get(p.city.road_shapes, a),
        "An off-grid centreline survives save and load")
    end
  end
  pfn long_bridge() : Unit do
    let c = fixture()
    let a = S.index(5, 10)
    let b = S.index(22, 10)
    let mid = S.index(13, 10)
    let roads = NativeArray.set_int(NativeArray.set_int(c.roads, a, 1), b, 1)
    let c = { c with roads: roads, heights: NativeArray.set_int(c.heights, mid, 0), cash: 20000 }
    let overpass = RoadBuild.crossing(c, 50, a, b)
    let low = RoadBuild.crossing_with_rise(c, 124, a, b, 4)
    let high = RoadBuild.crossing_with_rise(c, 124, a, b, 8)
    Test.assert_true(!overpass.valid && low.valid && high.valid && high.length == 136,
      "The bridge spans farther than the Overpass tool")
    Test.assert_true(S.grade_link(high.city, a, b) && S.grade_surface(high.city, a, b, 0.5) == 42.0 &&
      S.grade_surface(low.city, a, b, 0.5) == 26.0 && S.grade_surface(high.city, a, b, 0.0) == 10.0,
      "Changing bridge rise adjusts the level deck while meeting both approach streets")
    let hills = { c with heights: NativeArray.set_int(c.heights, S.index(13, 9), 112) }
    let blocked = RoadBuild.crossing_with_rise(hills, 124, a, b, 4)
    Test.assert_true(!blocked.valid && !S.grade_link(blocked.city, a, b),
      "A hillside reaching under the edge of the deck blocks the bridge")
    let game = { city: high.city, cx: 60.0, cz: 80.0, zoom: 30.0, yaw: 0.55, paused: true, speed: 1 }
    match Ur.Save.decode(Ur.Save.encode(game)) do
      Err(message) -> Test.assert_true(false, message)
      Ok(loaded) -> Test.assert_eq_int(S.bridge_rise(loaded.city, a), 8, "The selected bridge height survives saving")
    end
  end
  pfn tunnels() : Unit do
    let c = fixture()
    let a = S.index(3, 10)
    let mid = S.index(6, 10)
    let b = S.index(10, 10)
    let approach = S.index(10, 11)
    let roads = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(c.roads, a, 1), b, 2), approach, 2)
    let mountain = { c with roads: roads, heights: NativeArray.set_int(c.heights, mid, 68), buildings: NativeArray.set_int(c.buildings, mid, 1) }
    let tunnel = RoadBuild.crossing(mountain, 52, a, b)
    Test.assert_true(tunnel.valid && tunnel.cost == 8 * 310 && tunnel.length == 56 && tunnel.upkeep == 8 * 4, "Mountain tunnel has a buildable quote")
    Test.assert_true(S.grade_link(tunnel.city, a, b) && !S.grade_link(tunnel.city, a, mid) &&
      S.get(tunnel.city.buildings, mid) == 1 && S.get(tunnel.city.roads, mid) == 0 && S.get(S.access(tunnel.city), b) >= 0, "Tunnel links only portals and preserves the surface above")
    let west = Ur.Landscape.tunnel_portal(tunnel.city, a, b, true)
    let east = Ur.Landscape.tunnel_portal(tunnel.city, b, a, false)
    Test.assert_true(!solid_at(west, 28, 15, 13) && !solid_at(west, 28, 15, 19) &&
      solid_at(west, 31, 23, 16) && !solid_at(east, 3, 15, 16) && solid_at(east, 0, 23, 16),
      "Mountain portal roofs frame openings at the inward parcel edges")
    Test.assert_true(S.grade_surface(tunnel.city, a, b, 0.05) == 10.0 &&
      S.grade_surface(tunnel.city, a, b, 0.5) == 10.0 && S.grade_surface(tunnel.city, b, a, 0.05) == 10.0 &&
      Ur.Landscape.ground_height(tunnel.city, a % S.width() * 32 + 27, a / S.width() * 32 + 16) == 10,
      "Mountain tunnel follows street level without a dip")
    let higher = { tunnel.city with heights: NativeArray.set_int(tunnel.city.heights, b, 18) }
    Test.assert_true(S.grade_surface(higher, a, b, 0.5 /. 7.0) == 10.0 &&
      Math.abs(S.grade_surface(higher, a, b, 0.5) -. 14.0) < 0.001 &&
      S.grade_surface(higher, b, a, 0.5 /. 7.0) == 18.0, "Dry bore climbs directly between different mouth elevations")
    let (horizontal, vertical) = S.road_turn(tunnel.city, b)
    let curve = Ur.Landscape.portal_street(tunnel.city, b, 10)
    Test.assert_true(horizontal == 0 && vertical == 3 && solid_at(curve, 0, 10, 16) &&
      solid_at(curve, 16, 10, 31) && !solid_at(curve, 31, 10, 16) && !solid_at(curve, 16, 10, 0),
      "Cutaway approach connects the bore to the south street without paving past either end")
    let (x, z, dx, dz) = Ur.Scene.street_pose(tunnel.city, a, b, 1.0, 5.0)
    let (next_x, next_z, next_dx, next_dz) = Ur.Scene.street_pose(tunnel.city, b, approach, 0.0, 5.0)
    Test.assert_true(Math.abs(x -. next_x) < 0.001 && Math.abs(z -. next_z) < 0.001 &&
      Math.abs(dx -. next_dx) < 0.001 && Math.abs(dz -. next_dz) < 0.001 && dx > 0.5 && dz > 0.5,
      "Vehicles join the surface street with a continuous turn")
    Test.assert_true(List.any(west, fn p -> p.material == 28) && !List.any(east, fn p -> p.material == 28),
      "Tunnel lamps need local power")
    let surface = { tunnel.city with roads: NativeArray.set_int(tunnel.city.roads, a + 1, 1) }
    Test.assert_true(solid_at(Ur.Landscape.structures(surface, a, 0), 27, 10, 16),
      "A surface street crossing a portal retains both lanes")
    let channel = { c with roads: roads, heights: NativeArray.set_int(c.heights, mid, 0) }
    let sea = RoadBuild.crossing(channel, 52, a, b)
    Test.assert_true(S.grade_surface(sea.city, a, b, 12.0 /. (7.0 *. 32.0)) <= 2.0 &&
      Ur.Landscape.ground_height(sea.city, a % S.width() * 32 + 27, a / S.width() * 32 + 16) < 5,
      "Channel approach still descends into an excavated trench")
    List.each([tunnel.city, sea.city], fn city ->
      let there = Ur.Food.driving_destinations(city, b)
      let back = Ur.Food.driving_destinations(city, a)
      Test.assert_true(S.get(there, a) == b && S.get(back, b) == a && S.get(there, mid) < 0 &&
        Ur.Citizens.connected(city, a, b) && !Ur.Citizens.connected(city, a, mid),
        "Vehicle routes use the tunnel in both directions and only enter at its portals"))
    Test.assert_true(sea.valid && S.grade_surface(sea.city, a, b, 0.5) < 0.0 &&
      S.grade_surface(sea.city, a, b, 0.0) == 10.0 && S.grade_surface(sea.city, a, b, 1.0) == 10.0, "Channel tunnel stays below sea level and meets both approach roads")
    let coast = { channel with heights: NativeArray.set_int(NativeArray.set_int(channel.heights, a, 28), a + 1, 0) }
    let coast_tunnel = RoadBuild.crossing(coast, 52, a, b)
    Test.assert_true(coast_tunnel.valid && S.grade_surface(coast_tunnel.city, a, b, 0.5 / 7.0) < 0.0, "Tunnel descends below water before entering the channel")
    let overlap = RoadBuild.crossing(sea.city, 52, a, b)
    Test.assert_true(!overlap.valid && overlap.blocked == a && overlap.city.cash == sea.city.cash, "Crossings cannot overlap")
    let terminal = { channel with ferries: NativeArray.set_int(channel.ferries, b, a + 1) }
    Test.assert_eq_int((RoadBuild.crossing(terminal, 52, a, b)).blocked, b, "Ferry terminal rejects a tunnel portal")
    let far = S.index(18, 10)
    let long = { channel with roads: NativeArray.set_int(channel.roads, far, 1) }
    Test.assert_true(!(RoadBuild.crossing(long, 50, a, far)).valid && (RoadBuild.crossing(long, 52, a, far)).valid, "Long span requires a tunnel")
    let game = { city: sea.city, cx: 60.0, cz: 80.0, zoom: 30.0, yaw: 0.55, paused: true, speed: 1 }
    match Ur.Save.decode(Ur.Save.encode(game)) do
      Err(message) -> Test.assert_true(false, message)
      Ok(loaded) ->
        Test.assert_true(S.grade_link(loaded.city, b, a) && S.grade_source(loaded.city, mid) == a &&
          loaded.city.cash == channel.cash - sea.cost, "Tunnel and treasury survive save/load")
        let removed = S.act(loaded.city, mid, 54)
        Test.assert_true(!S.grade_link(removed, a, b) && S.get(removed.roads, a) == 1 && S.get(removed.roads, b) == 2, "Removal preserves both surface approaches")
    end
  end
  fn main(_cap : Cap(IO)) : Unit do
    List.each([1, 2, 3, 4], fn kind ->
      let demo = Ur.Scenario.road_planning(kind, false)
      let quote = RoadBuild.planned(demo.city, demo.tool, demo.draft, true)
      Test.assert_true(quote.valid && quote.changed, "Demo project can be built " ++ int_to_string(kind) ++ " " ++ quote.reason))
    surface()
    layouts()
    replace()
    flush_markings()
    turnaround()
    isolated_sidewalks()
    straight_street()
    drawn_streets()
    off_grid_streets()
    long_bridge()
    tunnels()
    Authority.must(println("Road planning checks passed"))
  end
end
