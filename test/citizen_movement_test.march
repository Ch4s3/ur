mod CitizenMovementTest do
  needs IO
  needs IO.Console
  alias Ur.Sim as S

  pfn first(people : List(Ur.Citizens.Citizen)) : Ur.Citizens.Citizen do
    match people do
      Cons(person, _) -> person
      Nil -> panic("Expected a citizen in the test town")
    end
  end
  pfn working_hours(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr) : Unit do
    let person = { base with work: -1, study: -1, shop: -1, park: -1, location: base.home,
      route: Nil, activity: 0, wait: 0.0 }
    let start = Ur.Citizens.index(c, [person], 0.26)
    let later = Ur.Citizens.step_indexed(c, empty, None, start, 1.83, 0.02, empty, 0.0)
    Test.assert_true(List.is_empty(later.active), "a resident without a destination stays indoor across midnight")
    Test.assert_true(Option.is_some(Ur.Citizens.find(later, person.id)), "a sleeping resident stays inspectable")
    Test.assert_true(List.map(Ur.Citizens.at_parcel(later, person.home), fn resident -> resident.id) == [person.id],
      "the parcel inspector can find residents who are asleep")
    let wet = { c with surface_water: NativeArray.set_int(c.surface_water, person.home, 8),
      flood_damage: NativeArray.set_int(c.flood_damage, person.home, 2), flood_active: true }
    let evacuated = Ur.Citizens.refresh(wet, Ur.Citizens.snapshot(later))
    Test.assert_true(List.any(evacuated, fn evacuee ->
      evacuee.id == person.id && Ur.Citizens.emergency_move(evacuee) && evacuee.rest_until < 0),
      "someone waiting indoors is eligible for immediate evacuation")
  end

  pfn transit_mode(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr, mode : Int) : Unit do
    let board = S.index(10, 17)
    let middle = S.index(11, 17)
    let exit = S.index(12, 17)
    let target = S.index(12, 18)
    let transit = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(empty, board, mode), middle, mode), exit, mode)
    let stops = NativeArray.set_int(NativeArray.set_int(empty, board, mode), exit, mode)
    let roads = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(c.roads, board, 1), middle, 1), exit, 1)
    let c = { c with transit: transit, stops: stops, roads: roads, heights: NativeArray.make_int(S.count(), 16) }
    let running = NativeArray.set_int(NativeArray.set_int(NativeArray.set_int(empty, board, 2), middle, 1), exit, 2)
    let trip = { mode: mode, stops: [board, middle, exit], legs: 2, source: board }
    let run = { slot: 1, trip: trip, progress: 0.35, stop_wait: 0.0 }
    let capacity = S.transit_seats(mode)
    let waiting = List.map(List.range(0, capacity + 1), fn id -> { base with
      id: id, board: board, alight: exit, target: target, location: -1, route: [board, middle, exit, target],
      wait: 0.0, progress: 0.0, transit_phase: 2, bus_slot: -1, car_phase: 0, rest_until: -1 })
    let sleeping = { base with id: capacity + 1, location: target, route: Nil, rest_until: 24,
      transit_phase: 0, bus_slot: -1 }
    let waiting = List.append(waiting, [sleeping])
    let step = fn (people, active) -> Ur.Citizens.step_with_bus(c, running, Some({ routes: [trip], active: active }), people, 0.6, 0.02, empty, 0.0)
    let boarded = step(waiting, [run])
    Test.assert_true(List.map(boarded, fn person -> person.id) == List.map(waiting, fn person -> person.id),
      "advancing part of the roster preserves its order and sleeping residents")
    Test.assert_eq_int(List.length(List.filter(boarded, fn person -> person.bus_slot == run.slot)), capacity,
      "each vehicle boards a group up to its capacity")
    let passing = step(boarded, [{ run with progress: 1.35 }])
    Test.assert_eq_int(List.length(List.filter(passing, fn person -> person.bus_slot == run.slot && person.progress == 1.35)), capacity,
      "all passengers use the same vehicle progress")
    let arrived = step(passing, [{ run with progress: 2.35 }])
    Test.assert_eq_int(List.length(List.filter(arrived, fn person -> person.bus_slot < 0 && person.transit_phase == 4 && person.route == [exit, target])), capacity,
      "passengers alight together and retain their specific walking leg")
    let cancelled = step(boarded, Nil)
    Test.assert_eq_int(List.length(List.filter(cancelled, fn person -> person.bus_slot < 0 && person.location == board)), capacity,
      "a cancelled vehicle returns its passengers to the boarding stop")
    if mode >= 3 do
      let planned = Ur.Fleet.routes(c, running)
      Test.assert_true(List.any(planned, fn route -> route.mode == mode && route.legs == 2),
        "powered stations dispatch an actual shared rail vehicle")
      let active = Ur.Fleet.step(c, NativeArray.make_int(S.count() * 4, 0), Nil, planned, 0.0, true)
      Test.assert_true(List.any(active, fn vehicle -> vehicle.trip.mode == mode), "the rail fleet actually dispatches")
      let closed = Ur.Fleet.routes(c, empty)
      let active = Ur.Fleet.step(c, NativeArray.make_int(S.count() * 4, 0), active, closed, 0.02, true)
      Test.assert_false(List.any(active, fn vehicle -> vehicle.trip.mode == mode), "loss of service cancels an active rail run")
    else () end
  end

  pfn indexed_movement(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr) : Unit do
    let sleeper = { base with work: -1, study: -1, shop: -1, park: -1, location: base.home,
      parking: 0, activity: 0, route: Nil, wait: 0.0, rest_until: -1 }
    let due = { sleeper with id: 2, work: base.home, rest_until: 4 }
    let active = { sleeper with id: 3, wait: 1.0 }
    let people = [{ sleeper with id: 1 }, due, active]
    let roster = Ur.Citizens.index(c, people, 0.26)
    Test.assert_eq_int(List.length(roster.active), 1, "indoor residents stay out of the active index")
    let roster = Ur.Citizens.step_indexed(c, empty, None, roster, 0.27, 0.02, empty, 0.0)
    let people = Ur.Citizens.snapshot(roster)
    Test.assert_true(List.map(people, fn person -> person.id) == [1, 2, 3],
      "a frame advances only active travelers and preserves roster order")
    Test.assert_true(List.any(people, fn person -> person.id == 3 && person.wait < 1.0),
      "an active citizen continues to advance before the next scheduled wakeup")
    let roster = Ur.Citizens.step_indexed(c, empty, None, roster, 0.31, 0.02, empty, 0.0)
    let people = Ur.Citizens.snapshot(roster)
    Test.assert_true(List.any(people, fn person -> person.id == 2 && person.rest_until == 5),
      "the scheduled citizen wakes and sets the next check")
    let cached = Ur.Citizens.indexed_counts(c, roster)
    let total = Ur.Citizens.tally(c, people)
    Test.assert_eq_int(cached.tracked, total.tracked, "waking does not double-count a resident")
    Test.assert_eq_int(cached.home, total.home, "cached indoor counts match the complete roster")
  end

  -- An hour's batch larger than the per-step budget wakes over several steps, earliest first,
  -- and the roster's order and counts stay whole meanwhile.
  pfn spread_wake_burst(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr) : Unit do
    let sleeper = { base with work: base.home, study: -1, shop: -1, park: -1, location: base.home,
      parking: 0, activity: 0, route: Nil, wait: 0.0, rest_until: 4 }
    let budget = Ur.Citizens.wake_budget(0.02)
    let size = budget * 2 + budget / 2
    let people = List.map(List.range(0, size), fn i -> { sleeper with id: i + 1, parking: i % 2 })
    let pending = fn roster -> List.length(Map.get_or(roster.wakeups, 4, Nil, Map.int_cmp))
    let parked = List.filter(List.range(0, size), fn slot -> slot % 2 == 1)
    let roster = Ur.Citizens.sort_parked(Ur.Citizens.index(c, people, 0.26))
    Test.assert_eq_int(pending(roster), size, "the whole batch sleeps until hour 4")
    let first_step = Ur.Citizens.step_indexed(c, empty, None, roster, 0.31, 0.02, empty, 0.0)
    Test.assert_eq_int(pending(first_step), size - budget, "one step wakes at most the budget")
    Test.assert_eq_int(first_step.clock, 4, "the clock still reaches the current hour")
    let second = Ur.Citizens.step_indexed(c, empty, None, first_step, 0.31, 0.02, empty, 0.0)
    Test.assert_eq_int(pending(second), size - budget * 2, "the rest carries to the next step")
    let third = Ur.Citizens.step_indexed(c, empty, None, second, 0.31, 0.02, empty, 0.0)
    Test.assert_eq_int(pending(third), 0, "the batch finishes waking")
    let snapshot = Ur.Citizens.snapshot(third)
    Test.assert_true(List.map(snapshot, fn person -> person.id) == List.map(people, fn person -> person.id),
      "spreading the wake keeps every citizen in roster order")
    Test.assert_true(List.all(snapshot, fn person -> person.rest_until == 5), "every sleeper woke and set its next check")
    List.each([first_step, second, third], fn r ->
      Test.assert_true(List.map(Ur.Citizens.visible_actors(r), fn entry -> entry.slot) == parked,
        "parked sleepers stay visible once each while the batch wakes and sleeps again")
      Test.assert_true(List.map(Ur.Citizens.visible_actors(Ur.Citizens.sort_parked(r)), fn entry -> entry.slot) == parked,
        "sorting the parked list keeps the same cars")
      let cached = Ur.Citizens.indexed_counts(c, r)
      let total = Ur.Citizens.tally(c, Ur.Citizens.snapshot(r))
      Test.assert_eq_int(cached.tracked, total.tracked, "a partial wake does not double-count")
      Test.assert_eq_int(cached.home, total.home, "indoor counts stay whole during a partial wake"))
  end

  -- Sleepers that stay up after a partial wake leave the sorted parked list without it being
  -- rebuilt, and the visible list still holds every active citizen and parked car once, in order.
  pfn spread_wake_parked(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr) : Unit do
    let sleeper = { base with work: base.home, study: -1, shop: -1, park: -1, location: base.home,
      parking: 0, activity: 0, route: Nil, wait: 1.0, rest_until: 4 }
    let budget = Ur.Citizens.wake_budget(0.02)
    let people = List.map(List.range(0, budget * 2), fn i -> { sleeper with id: i + 1, parking: i % 2 })
    let expected = fn roster ->
      let up = List.map(roster.active, fn entry -> entry.slot)
      List.filter(List.range(0, budget * 2), fn slot -> slot % 2 == 1 || List.any(up, fn s -> s == slot))
    let roster = Ur.Citizens.sort_parked(Ur.Citizens.index(c, people, 0.26))
    Test.assert_true(List.map(Ur.Citizens.visible_actors(roster), fn entry -> entry.slot) == expected(roster),
      "every parked sleeper is visible before the wake")
    let woke = Ur.Citizens.step_indexed(c, empty, None, roster, 0.31, 0.02, empty, 0.0)
    Test.assert_eq_int(List.length(woke.active), budget, "the woken stay up")
    Test.assert_true(woke.parked_fresh, "a partial wake keeps the sorted parked list")
    Test.assert_true(List.map(Ur.Citizens.visible_actors(woke), fn entry -> entry.slot) == expected(woke),
      "woken parked citizens are visible once, as active citizens")
  end

  pfn cached_walk_geometry(c : Ur.Sim.City) : Unit do
    let a = S.index(12, 22)
    let b = S.neighbour(a, 1)
    let cross = List.fold_left([a, b, S.neighbour(a, 0), S.neighbour(a, 2)], NativeArray.make_int(S.count(), 0),
      fn (roads, lot) -> NativeArray.set_int(roads, lot, 2))
    let c = { c with roads: cross, heights: NativeArray.make_int(S.count(), 22) }
    let map = Ur.Citizens.walk_map(c)
    Test.assert_true(Ur.Citizens.walk_junction(map, a) && Ur.Citizens.walk_arm(map, a, 1),
      "cached junctions and arms work on parcels beyond the first row of packed records")
    Test.assert_eq_int(Ur.Citizens.walk_width(map, a), S.road_half_width(2) + 1, "avenue sidewalks use the road width")
    Test.assert_true(Ur.Citizens.walk_turn(map, a) == S.road_turn(c, a), "cached road geometry matches the road")
    Test.assert_true(Ur.Citizens.walk_segment_pace(map, a, b) == S.walk_pace(c, a), "cached walking pace matches the city")
    let wet = { c with surface_water: NativeArray.set_int(c.surface_water, b, 6), flood_active: true }
    let wet_map = Ur.Citizens.walk_map(wet)
    Test.assert_true(Ur.Citizens.walk_segment_pace(wet_map, a, b) == 0.0, "a flooded destination closes the walking segment")
  end

  pfn scheduled_crossing(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr) : Unit do
    let a = S.index(12, 22)
    let from = S.neighbour(a, 0)
    let b = S.neighbour(a, 1)
    let road = List.fold_left([a, b, from, S.neighbour(a, 2), S.neighbour(a, 3)], empty,
      fn (roads, lot) -> NativeArray.set_int(roads, lot, 2))
    let c = { c with roads: road, heights: NativeArray.make_int(S.count(), 22) }
    let map = Ur.Citizens.walk_map(c)
    let junctions = NativeArray.set_int(empty, a, 2)
    let person = { base with id: 2, location: -1, route: [a, b], previous: from, target: b,
      work: b, study: -1, car_phase: 0, parking: 0, arrival: 0, by_car: false,
      activity: 1, progress: 0.0, transit_phase: 0, bus_slot: -1, rest_until: -1, park_trip: false }
    let roster = Ur.Citizens.index(c, [person], 0.25)
    let red = int_to_float(7 - (a % 3) * 2) *. 0.5
    let step = fn (roster, dt, traffic) ->
      Ur.Citizens.step_guarded(c, map, empty, None, roster, 0.25, dt, junctions, traffic, fn (_, _, next) -> Ur.Citizens.unguarded(next))
    let waiting = step(roster, 0.1, red)
    let waiting = step(waiting, 0.5, red +. 0.5)
    Test.assert_eq_int(waiting.walk_count, 1, "a walker waiting at a signal stays scheduled")
    Test.assert_true(List.is_empty(waiting.active), "the regular tick has no walker to update")
    let person = first(Ur.Citizens.snapshot(waiting))
    Test.assert_true(person.progress == 0.0, "the walker waits at the curb until the signal opens")
    let crossing = step(waiting, 3.54, red +. 4.04)
    Test.assert_eq_int(Map.get_or(crossing.walk_crossings, a * 4 + 3, 0, Map.int_cmp), 1,
      "a scheduled crossing reserves its lane for drivers")
    let moving = step(crossing, 0.25, red +. 4.29)
    let person = first(Ur.Citizens.snapshot(moving))
    Test.assert_true(person.progress > 0.0 && person.progress < 0.24, "walkers interpolate before their next event")
    let counts = Ur.Citizens.indexed_counts(c, moving)
    Test.assert_eq_int(counts.walking, 1, "scheduled walkers count on the HUD")
    let done = step(moving, 0.6, red +. 4.89)
    Test.assert_eq_int(Map.get_or(done.walk_crossings, a * 4 + 3, 0, Map.int_cmp), 0, "crossing reservation clears")
    let done = step(done, 0.8, red +. 5.69)
    let done = step(done, 1.7, red +. 7.39)
    Test.assert_eq_int(done.walk_count, 0, "arrival removes the walking event")
    let person = first(Ur.Citizens.snapshot(done))
    Test.assert_eq_int(person.location, b, "the arrival reaches the original destination")
  end

  -- The sanitation shift change swaps the crew in place; the roster must then hold exactly
  -- the citizens the old path (snapshot, sanitation_crew, index) produced, with its counts,
  -- crew list and parked list whole, wherever the new driver was (asleep, active or walking).
  pfn crew_swap(c : Ur.Sim.City, base : Ur.Citizens.Citizen, empty : NativeIntArr) : Unit do
    let a = S.index(12, 22)
    let from = S.neighbour(a, 0)
    let b = S.neighbour(a, 1)
    let road = List.fold_left([a, b, from, S.neighbour(a, 2), S.neighbour(a, 3)], empty,
      fn (roads, lot) -> NativeArray.set_int(roads, lot, 2))
    let c = { c with roads: road, heights: NativeArray.make_int(S.count(), 22) }
    let map = Ur.Citizens.walk_map(c)
    let people = List.map(List.range(0, 24), fn i ->
      let person = { base with id: i + 1 }
      if i % 3 == 0 do { person with work: base.home, study: -1, shop: -1, park: -1, location: base.home,
        activity: 0, route: Nil, wait: 1.0, rest_until: 4, parking: i % 2 }
      else if i == 2 do { person with activity: 6, rest_until: -1 }
      else if i % 3 == 1 do { person with location: -1, route: [a, b], previous: from, target: b,
        work: b, study: -1, car_phase: 0, parking: 0, arrival: 0, by_car: false,
        activity: 1, progress: 0.0, transit_phase: 0, bus_slot: -1, rest_until: -1, park_trip: false }
      else { person with work: -1, study: -1, shop: -1, park: -1, location: base.home, parking: 0,
        activity: 0, route: Nil, wait: 1.0, rest_until: -1 } end end end)
    let step = fn (roster, dt) ->
      Ur.Citizens.step_guarded(c, map, empty, None, roster, 0.25, dt, empty, 0.0, fn (_, _, next) -> Ur.Citizens.unguarded(next))
    let roster = Ur.Citizens.sort_parked(step(step(Ur.Citizens.index(c, people, 0.25), 0.1), 0.25))
    Test.assert_true(roster.walk_count > 0, "the test town has citizens mid-walk")
    Test.assert_true(List.length(roster.active) > 0, "and citizens active")
    let walker = match List.find(Ur.Citizens.visible_people(roster), fn person ->
        !List.any(roster.active, fn entry -> entry.person.id == person.id)) do
      Some(person) -> person.id
      None -> panic("no walker in the test town")
    end
    let active = (first(List.map(roster.active, fn entry -> entry.person))).id
    let asleep = 1
    List.each([asleep, active, walker, -1], fn driver ->
      let before = Ur.Citizens.snapshot(roster)
      let swapped = Ur.Citizens.sort_parked(Ur.Citizens.swap_crew(c, roster, 3, driver))
      let after = Ur.Citizens.snapshot(swapped)
      let expected = Ur.Citizens.sanitation_crew(before, 3, driver)
      Test.assert_true(List.map(after, fn person -> person.id) == List.map(expected, fn person -> person.id),
        "the swap keeps every citizen in roster order")
      Test.assert_true(List.map(after, fn person -> person.activity) == List.map(expected, fn person -> person.activity),
        "the swap sets the same shifts as sanitation_crew")
      Test.assert_true(List.map(after, fn person -> person.rest_until) == List.map(expected, fn person -> person.rest_until),
        "and the same rest times")
      Test.assert_true(List.map(after, fn person -> person.progress) == List.map(expected, fn person -> person.progress),
        "and leaves everyone where they stood")
      Test.assert_true(List.map(swapped.crew, fn person -> person.id) == (if driver < 0 do Nil else [driver] end),
        "only the new driver is on the crew")
      let cached = Ur.Citizens.indexed_counts(c, swapped)
      let total = Ur.Citizens.tally(c, after)
      Test.assert_eq_int(cached.tracked, total.tracked, "the swap keeps the tracked count whole")
      Test.assert_eq_int(cached.home, total.home, "and the indoor counts")
      Test.assert_true(List.map(Ur.Citizens.visible_actors(swapped), fn entry -> entry.slot) ==
        List.map(Ur.Citizens.visible_actors(Ur.Citizens.sort_parked({ swapped with parked_fresh: false })), fn entry -> entry.slot),
        "the parked list matches a fresh sort"))
  end

  -- The rebuild's id index answers what a Map built by inserting the citizens in order would:
  -- the last of a repeated id, and nothing for an id it never saw.
  pfn citizen_index_matches_map(base : Ur.Citizens.Citizen) : Unit do
    let ids = List.flat_map(List.range(0, 1500), fn h -> List.map(List.range(0, 1 + h % 4), fn m -> S.member_id(h * 37, m)))
    let people = List.append(List.map(ids, fn id -> { base with id: id, home: 1 }),
      List.map(List.take(ids, 200), fn id -> { base with id: id, home: 2 }))
    let ix = Ur.Citizens.citizen_index(people)
    let map = List.fold_left(people, Map.empty(), fn (m, person) -> Map.insert(m, person.id, person, Map.int_cmp))
    let probes = List.append(ids, List.map(List.range(0, 500), fn i -> S.member_id(i * 37 + 1, 0)))
    Test.assert_true(List.all(probes, fn id ->
      match (Ur.Citizens.lookup(ix, id), Map.get(map, id, Map.int_cmp)) do
        (Some(a), Some(b)) -> a.id == b.id && a.home == b.home
        (None, None) -> true
        _ -> false
      end), "the id index agrees with a Map for every id, present, repeated or missing")
    Test.assert_true(Option.is_none(Ur.Citizens.lookup(Ur.Citizens.citizen_index(Nil), 7)), "an empty index finds nobody")
  end

  -- A rebuild without evacuees takes the roster in any order (rebuild_input skips the sort).
  pfn rebuild_ignores_order(c : Ur.Sim.City) : Unit do
    let people = Ur.Citizens.refresh(c, Nil)
    let moved = List.map(people, fn person -> { person with wait: person.wait +. 0.5 })
    let ordered = Ur.Citizens.refresh(c, moved)
    let reversed = Ur.Citizens.refresh(c, List.reverse(moved))
    Test.assert_true(List.length(people) > 1, "the test town has several citizens")
    Test.assert_true(List.map(ordered, fn person -> (person.id, person.home, person.work, person.wait, person.parking)) ==
      List.map(reversed, fn person -> (person.id, person.home, person.work, person.wait, person.parking)),
      "a rebuild gives the same citizens whatever order the old roster comes in")
  end

  fn main(_cap : Cap(IO)) : Unit do
    let city = Ur.Scenario.evacuation_site()
    let resident = first(Ur.Citizens.refresh(city, Nil))
    let empty = NativeArray.make_int(S.count(), 0)
    working_hours(city, resident, empty)
    indexed_movement(city, resident, empty)
    spread_wake_burst(city, resident, empty)
    spread_wake_parked(city, resident, empty)
    crew_swap(city, resident, empty)
    citizen_index_matches_map(resident)
    rebuild_ignores_order(city)
    cached_walk_geometry(city)
    scheduled_crossing(city, resident, empty)
    List.each([2, 3, 4], fn mode -> transit_mode(city, resident, empty, mode))
    Authority.must(println("Citizen movement checks passed"))
  end
end
