mod StockMarketTest do
  needs IO
  needs IO.Console
  needs IO.Clock
  needs IO.Process
  needs IO.FileRead
  needs IO.FileWrite
  alias Ur.Sim as S

  pfn listed_stock(c : Ur.Sim.City, lot : Int, price : Int) : Ur.Sim.City do
    let s = { id: c.economy.market.next_id, lot: lot, sector: Ur.Market.sector_of(c, lot), shares: Ur.Market.shares(), price: price, earnings: 0,
      dividend: 0, history: Cons(price, Nil), listed: c.month, delisted: -1 }
    let market = c.economy.market
    { c with economy: { c.economy with stocks: Cons(s, c.economy.stocks), market: { market with next_id: market.next_id + 1, base: c.month } } }
  end
  fn main(_cap : Cap(IO)) : Unit do
    let c = S.new()
    let shop = S.index(8, 20)
    Test.assert_true(Ur.Market.trading(c, shop), "The seed town has a trading business")

    let a = Ur.Clock.advance(listed_stock(c, shop, 500), 6)
    let b = Ur.Clock.advance(listed_stock(c, shop, 500), 6)
    Test.assert_eq_int(a.economy.market.index, b.economy.market.index, "The same city replays the same market")
    Test.assert_true(List.length(a.economy.market.history) >= 6, "The index keeps a monthly history")
    let stock = match Ur.Market.stock_at(a, 1) do
      Some(s) -> s
      None -> panic("listed stock lost")
    end
    Test.assert_eq_int(List.length(stock.history), 7, "A stock records one price a month")
    Test.assert_true(Ur.Market.cycle(c, 0) != Ur.Market.cycle(c, 30) || Ur.Market.cycle(c, 30) != Ur.Market.cycle(c, 60), "The business cycle moves")
    Test.assert_true(Ur.Market.noise(c, 5, 1) == Ur.Market.noise(c, 5, 1), "Shocks are seeded")
    Test.assert_true(Ur.Market.noise(c, 5, 1) >= -1000 && Ur.Market.noise(c, 5, 1) <= 1000, "Shocks stay in range")

    let settled = Ur.Clock.advance(c, 1)
    let indebted = { settled with economy: { settled.economy with debts: [{ id: 1, kind: 0, principal: 500000, rate: 100, months: 36, resident: 0 }] } }
    Test.assert_true(Ur.Market.multiple(indebted) < Ur.Market.multiple(settled), "Heavy city debt lowers valuations")
    Test.assert_true(Ur.Market.debt_ratio(indebted) > Ur.Market.debt_ratio(settled), "Debt is measured against revenue")

    let listed = listed_stock(c, shop, 500)
    Test.assert_true(S.listed(listed, shop), "A listed parcel is known to the simulation")
    let broken = { listed with economy: { listed.economy with listed_tax_break: 50 } }
    let st = S.stats(listed)
    let full = S.business_accounts(listed, st.routes, st.labor, st.people, st.work, shop)
    let relieved = S.business_accounts(broken, st.routes, st.labor, st.people, st.work, shop)
    Test.assert_true(relieved.tax <= full.tax, "A tax break lowers a listed firm's business tax")
    Test.assert_true((S.stats(broken)).budget.business_tax <= st.budget.business_tax, "A tax break costs business tax revenue")
    Test.assert_eq_int((Ur.Treasury.adjust(c, 21, 1)).economy.listed_tax_break, 5, "The tax break moves in steps of five")
    Test.assert_true((Ur.Treasury.adjust(c, 20, 1)).economy.listing_incentive, "The listing incentive can be switched on")
    Test.assert_true(Ur.Market.listing_months(Ur.Treasury.adjust(c, 20, 1)) < Ur.Market.listing_months(c), "The incentive lets firms list sooner")

    let demolished = Ur.Clock.month(S.act({ listed with cash: 50000 }, shop, 7))
    let gone = match Ur.Market.stock_at(demolished, 1) do
      Some(s) -> s
      None -> panic("delisted stock dropped too soon")
    end
    Test.assert_true(gone.delisted >= 0, "A demolished firm is delisted")
    Test.assert_true(gone.price <= 500 / 10, "Its shares are left near worthless")
    Test.assert_true(demolished.economy.market.index < 10000, "A failure pulls the index down")

    let renamed = { listed with economy: { listed.economy with stocks: List.map(listed.economy.stocks, fn s -> { s with sector: 5 }) } }
    let still = match Ur.Market.stock_at(Ur.Market.settle(renamed), 1) do
      Some(s) -> s
      None -> panic("stock missing")
    end
    Test.assert_true(still.delisted < 0 && still.sector == Ur.Market.sector_of(c, shop), "A firm that changes line of business keeps trading under its new sector")
    let feeing = { c with cash: 50, economy: { c.economy with listing_incentive: true } }
    Test.assert_true((Ur.Treasury.close_month(feeing)).cash >= 0, "The listing fee never leaves cash below zero")
    let home = S.index(10, 20)
    let modest = { c with economy: { c.economy with savings: NativeArray.set_int(c.economy.savings, home, 100 * S.occupied_homes(c, home)) } }
    Test.assert_eq_int(S.get((Ur.Market.pay_dividends(modest, 1000)).economy.savings, home), S.get(modest.economy.savings, home), "Households with nothing in the index get no dividends")
    let streaky = { c with economy: { c.economy with profit_streak: NativeArray.set_int(c.economy.profit_streak, shop, 30) } }
    let listing = Ur.Market.settle(streaky)
    Test.assert_true(S.job_slots(c, shop) < Ur.Market.listing_jobs(c) || S.listed(listing, shop), "A long-profitable firm with enough jobs lists")

    let boom = { c with economy: { c.economy with market: { c.economy.market with index: 13000, history: [12000, 11500, 11000, 10800, 10600, 10500, 10400, 10300, 10200, 10100, 10050, 10000, 10000] } } }
    let bust = { c with economy: { c.economy with market: { c.economy.market with index: 7000, history: [8000, 8500, 9000, 9200, 9400, 9500, 9600, 9700, 9800, 9900, 9950, 10000, 10000] } } }
    Test.assert_true(Ur.Council.market_vote(boom) >= Ur.Council.market_vote(bust), "Voters reward a rising market")
    Test.assert_true(S.market_boost(boom) > S.market_boost(bust), "A rising market draws better firms")

    let game = { city: a, cx: 78.0, cz: 151.0, zoom: 52.0, yaw: 0.55, paused: true, speed: 1 }
    match Ur.Save.decode(Ur.Save.encode(game)) do
      Ok(loaded) ->
        Test.assert_eq_int(loaded.city.economy.market.index, a.economy.market.index, "The index survives save and load")
        Test.assert_eq_int(List.length(loaded.city.economy.stocks), List.length(a.economy.stocks), "Listed companies survive save and load")
      Err(error) -> panic(error)
    end
  end
end
