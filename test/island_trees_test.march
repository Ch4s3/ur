mod IslandTreesTest do
  needs IO
  needs IO.Console
  alias Ur.Sim as S

  pfn seeded(c : Ur.Sim.City, seed : Int) : Ur.Sim.City do { c with world_seed: seed } end
  pfn count_seeds(c : Ur.Sim.City, test : Ur.Sim.City -> Bool, seed : Int, n : Int) : Int do
    if seed > 300 do n else count_seeds(c, test, seed + 1, if test(seeded(c, seed)) do n + 1 else n end) end
  end

  -- map traits
  pfn traits(c : Ur.Sim.City) : Unit do
    let mangroves = count_seeds(c, fn m -> Ur.Flora.mangrove_map(m), 1, 0)
    let pines = count_seeds(c, fn m -> Ur.Flora.pine_map(m), 1, 0)
    let both = count_seeds(c, fn m -> Ur.Flora.mangrove_map(m) == Ur.Flora.pine_map(m), 1, 0)
    Test.assert_true(mangroves >= 70 && mangroves <= 130, "mangroves on about a third of seeds: " ++ int_to_string(mangroves))
    Test.assert_true(pines >= 70 && pines <= 130, "a pine stand on about a third of seeds: " ++ int_to_string(pines))
    Test.assert_true(both <= 180, "the two are drawn apart: they agree on " ++ int_to_string(both) ++ " of 300")
    let founding = seeded(c, -1)
    Test.assert_true(!Ur.Flora.mangrove_map(founding), "the founding map has no mangroves (its storms are tuned without them)")
    Test.assert_true(!Ur.Flora.pine_map(founding), "and no pine stand")
    Test.assert_true(Math.abs(Ur.Flora.prevailing(founding) -. 0.42) < 0.001, "and the daily wind's base as its trade wind")
    let one = seeded(c, 77)
    let later = { one with calendar_day: one.calendar_day + 9, month: one.month + 3 }
    Test.assert_true(Ur.Flora.prevailing(one) == Ur.Flora.prevailing(later), "a map's trade wind does not turn with the days")
  end

  -- land of height h over the parcels x0..x1, z0..z1
  pfn block(a : NativeIntArr, x0 : Int, x1 : Int, z0 : Int, z1 : Int, h : Int) : NativeIntArr do
    List.fold_left(List.range(z0, z1 + 1), a, fn (a, z) ->
      List.fold_left(List.range(x0, x1 + 1), a, fn (a, x) -> NativeArray.set_int(a, S.index(x, z), h)))
  end
  pfn at(a : NativeIntArr, x : Int, z : Int, h : Int) : NativeIntArr do NativeArray.set_int(a, S.index(x, z), h) end

  -- the spot: zone, wind side, shelter
  pfn spot(c : Ur.Sim.City) : Unit do
    let sea = NativeArray.make_int(S.count(), 0)
    -- two islands: a small one (peak 20) and a big one (peak 60)
    let a = at(block(sea, 2, 4, 2, 4, 10), 3, 3, 20)
    let a = at(block(a, 10, 14, 2, 6, 30), 12, 4, 60)
    -- a ridge 16 parcels long rising to 70 at its far end
    let a = at(block(a, 5, 20, 20, 20, 15), 20, 20, 70)
    -- a slope rising east, and one rising west
    let a = at(at(at(at(at(a, 30, 30, 10), 31, 30, 20), 32, 30, 30), 33, 30, 40), 34, 30, 50)
    let a = at(at(at(at(at(a, 30, 34, 50), 31, 34, 40), 32, 34, 30), 33, 34, 20), 34, 34, 10)
    let a = block(a, 30, 34, 37, 37, 30)
    -- a bay: land two parcels round (45, 10) but for the south side; an open coast at (45, 28)
    let a = block(block(block(a, 43, 47, 8, 8, 12), 43, 43, 8, 12, 12), 47, 47, 8, 12, 12)
    let a = block(a, 35, 55, 29, 31, 12)
    let m = { c with heights: a, world_seed: -1 }
    Test.assert_eq_int(Ur.Flora.massif_peak(m, S.index(2, 2)), 20, "the small island's peak is its own, not the big island's")
    Test.assert_eq_int(Ur.Flora.massif_peak(m, S.index(14, 6)), 60, "the big island's")
    Test.assert_eq_int(Ur.Flora.massif_peak(m, S.index(8, 8)), 0, "water has none")
    Test.assert_eq_int(Ur.Flora.massif_peak(m, S.index(5, 20)), 15, "a ridge's far summit is out of reach")
    Test.assert_eq_int(Ur.Flora.massif_peak(m, S.index(15, 20)), 70, "and in reach from nearer")
    Test.assert_eq_int(Ur.Flora.zone(10, 12, 0, 0), 1, "a low island's hill is lowland")
    Test.assert_true(List.all(List.range(7, 13), fn h -> Ur.Flora.zone(h, 12, 1, 6) < 4), "a low island has no top scrub")
    Test.assert_eq_int(Ur.Flora.zone(5, 60, 1, 6), 0, "below the sand line is coast")
    Test.assert_true(List.all(List.range(7, 61), fn h -> Ur.Flora.zone(h, 60, 1, 0) >= Ur.Flora.zone(h, 60, -1, 0)), "windward zones reach no higher than lee")
    Test.assert_true(List.any(List.range(7, 61), fn h -> Ur.Flora.zone(h, 60, 1, 0) > Ur.Flora.zone(h, 60, -1, 0)), "and lower somewhere")
    Test.assert_eq_int(Ur.Flora.zone(58, 60, 0, 0), 4, "near the summit is the top")
    -- the founding map's trade wind blows east-south-east: a slope rising east faces it
    Test.assert_eq_int(Ur.Flora.wind_side(m, S.index(32, 30)), 1, "a slope rising toward the wind's source is windward")
    Test.assert_eq_int(Ur.Flora.wind_side(m, S.index(32, 34)), -1, "the far side is lee")
    Test.assert_eq_int(Ur.Flora.wind_side(m, S.index(32, 37)), 0, "flat ground is neither")
    Test.assert_true(Ur.Flora.sheltered(m, S.index(45, 10)), "a bay is sheltered")
    Test.assert_true(!Ur.Flora.sheltered(m, S.index(45, 27)), "an open coast is not")
    let corners = [S.index(0, 0), S.index(S.width() - 1, 0), S.index(0, S.depth() - 1), S.index(S.width() - 1, S.depth() - 1)]
    let edge = { m with heights: List.fold_left(corners, m.heights, fn (a, i) -> NativeArray.set_int(a, i, 30)) }
    Test.assert_true(List.all(corners, fn i -> Ur.Flora.massif_peak(edge, i) == 30 && Ur.Flora.wind_side(edge, i) != 2 && (Ur.Flora.sheltered(edge, i) || true)),
      "the map's corners are read without a fault")
  end

  -- tree shapes
  pfn shape_sig(ps : List(Ur.Architecture.Piece)) : Int do
    List.fold_left(ps, 7, fn (h, p) -> Strata.Seed.mix(h, ((((p.x * 37 + p.y) * 41 + p.z) * 43 + p.w) * 47 + p.h) * 53 + p.d * 59 + p.material))
  end
  pfn top(ps : List(Ur.Architecture.Piece)) : Int do List.fold_left(ps, 0, fn (t, p) -> if p.y + p.h > t do p.y + p.h else t end) end
  pfn mean_top(kind : Int) : Int do List.fold_left(List.range(0, 200), 0, fn (t, s) -> t + top(Ur.Trees.shape(kind, 16, 16, 20, s))) / 200 end
  pfn shapes() : Unit do
    Test.assert_eq_int(Ur.Trees.kinds(), 12, "twelve kinds")
    List.each(List.range(0, Ur.Trees.kinds()), fn kind ->
      let name = "kind " ++ int_to_string(kind)
      let lists = List.map(List.range(0, 200), fn s -> Ur.Trees.shape(kind, 16, 16, 20, s))
      Test.assert_true(List.all(lists, fn ps -> List.length(ps) >= 1 && List.length(ps) <= 12), name ++ ": one to twelve pieces")
      Test.assert_true(List.all(lists, fn ps -> List.all(ps, fn p -> p.x >= 0 && p.z >= 0 && p.x + p.w <= 32 && p.z + p.d <= 32 && p.y >= 20 && p.w > 0 && p.h > 0 && p.d > 0)),
        name ++ ": inside the parcel, on the ground or above")
      Test.assert_true(shape_sig(Ur.Trees.shape(kind, 16, 16, 20, 99)) == shape_sig(Ur.Trees.shape(kind, 16, 16, 20, 99)), name ++ ": the same seed, the same tree")
      let distinct = List.fold_left(List.map(lists, fn ps -> shape_sig(ps)), Nil, fn (seen, k) ->
        if List.any(seen, fn s -> s == k) do seen else Cons(k, seen) end)
      Test.assert_true(List.length(distinct) >= 8, name ++ ": varies by seed (" ++ int_to_string(List.length(distinct)) ++ " shapes)")
      -- a tree on a parcel's edge is kept inside it
      Test.assert_true(List.all(List.range(0, 50), fn s -> List.all(Ur.Trees.shape(kind, 1, 30, 20, s), fn p -> p.x >= 0 && p.z >= 0 && p.x + p.w <= 32 && p.z + p.d <= 32)),
        name ++ ": kept inside the parcel at its edge"))
    Test.assert_true(mean_top(0) > mean_top(4) && mean_top(1) > mean_top(4), "palms and araucarias stand taller than banana clumps")
    Test.assert_true(List.all(List.range(0, 200), fn s -> top(Ur.Trees.shape(8, 16, 16, 20, s)) <= 28), "elfin trees stay low")
  end

  -- choosing a kind
  pfn kinds_at(c : Ur.Sim.City, site : (Int, Int, Bool, Bool), h : Int) : List(Int) do
    List.fold_left(List.range(0, 400), Nil, fn (seen, s) ->
      let k = Ur.Flora.pick_at(site, c, h, Strata.Seed.mix(s, 5))
      if List.any(seen, fn x -> x == k) do seen else Cons(k, seen) end)
  end
  pfn all_in(ks : List(Int), allowed : List(Int)) : Bool do List.all(ks, fn k -> List.any(allowed, fn a -> a == k)) end
  pfn has(ks : List(Int), k : Int) : Bool do List.any(ks, fn x -> x == k) end
  pfn first_seed(c : Ur.Sim.City, want : Bool, s : Int) : Int do
    if Ur.Flora.pine_map(seeded(c, s)) == want do s else first_seed(c, want, s + 1) end
  end
  pfn wild_lot(c : Ur.Sim.City, i : Int) : Int do
    if i >= S.count() do panic("no wild hillside on the founding map") else
      let h = S.get(c.heights, i)
      if h >= 12 && h <= 40 && S.get(c.roads, i) == 0 && S.get(c.buildings, i) == 0 && S.get(c.zones, i) == 0 && S.get(c.parks, i) == 0 && S.get(c.plants, i) == 0 do i
      else wild_lot(c, i + 1) end
    end
  end
  pfn choosing(c : Ur.Sim.City) : Unit do
    let plain = seeded(c, first_seed(c, false, 1))
    let pines = seeded(c, first_seed(c, true, 1))
    let coast = kinds_at(plain, (60, 0, false, true), 5)
    Test.assert_true(all_in(coast, [0, 1, 3]) && has(coast, 0), "the coast grows palms, araucarias and rainforest trees")
    let low = kinds_at(plain, (60, 0, false, false), 12)
    Test.assert_true(all_in(low, [0, 3, 4, 5]) && has(low, 4), "the lowland grows rainforest, palms, bananas and some ʻōhiʻa")
    let summit = kinds_at(plain, (60, 0, false, false), 60)
    Test.assert_true(all_in(summit, [8, 9]), "the top carries elfin scrub")
    Test.assert_true(has(kinds_at(plain, (60, 1, false, false), 42), 6), "windward upper slopes have tree ferns")
    Test.assert_true(!has(kinds_at(plain, (60, -1, false, false), 50), 6), "lee upper slopes none")
    Test.assert_true(has(kinds_at(pines, (60, -1, false, false), 30), 10), "a pine map's lee slopes carry pines")
    Test.assert_true(!has(kinds_at(pines, (60, 1, false, false), 30), 10), "not its windward slopes")
    Test.assert_true(!has(kinds_at(plain, (60, -1, false, false), 30), 10), "and other maps none")
    Test.assert_true(List.all(List.range(0, 70), fn h -> all_in(kinds_at(pines, (60, -1, false, false), h), List.range(-1, 12))), "every pick is a kind or none")
    -- planted: at most three trees and their companions, all inside the parcel
    let lot = wild_lot(c, 0)
    let parts = Ur.Landscape.structures(c, lot, 0)
    Test.assert_true(List.length(parts) <= 3 * 12, "a wild parcel holds at most three trees: " ++ int_to_string(List.length(parts)) ++ " pieces")
    Test.assert_true(List.all(parts, fn p -> p.x >= 0 && p.z >= 0 && p.x + p.w <= 32 && p.z + p.d <= 32), "inside the parcel")
  end

  -- mangroves
  pfn rooted(parts : List(Ur.Architecture.Piece)) : Bool do List.any(parts, fn p -> p.y == 0 && p.material == 13 && p.w == 1 && p.d == 1) end
  pfn mangroves(c : Ur.Sim.City) : Unit do
    let zero = NativeArray.make_int(S.count(), 0)
    -- a bay: land two parcels round (45, 10) but for the south side; an open coast along z 29..31
    let a = block(block(block(zero, 43, 47, 8, 8, 12), 43, 43, 8, 12, 12), 47, 47, 8, 12, 12)
    let a = block(a, 35, 55, 29, 31, 12)
    let bare = { c with heights: a, roads: zero, buildings: NativeArray.make_int(S.count(), 0), zones: NativeArray.make_int(S.count(), 0),
      parks: NativeArray.make_int(S.count(), 0), plants: NativeArray.make_int(S.count(), 0), seawalls: NativeArray.make_int(S.count(), 0), harbour: -1 }
    let on = seeded(bare, first_mangrove_seed(bare, true, 1))
    let off = seeded(bare, first_mangrove_seed(bare, false, 1))
    let shore = S.index(44, 10)
    Test.assert_true(rooted(Ur.Landscape.structures(on, shore, 0)), "a sheltered shore on a mangrove map grows mangroves")
    Test.assert_eq_int(List.length(Ur.Landscape.structures(off, shore, 0)), 0, "on other maps the water there stays bare")
    Test.assert_true(!rooted(Ur.Landscape.structures(on, S.index(45, 28), 0)), "an exposed coast grows none")
    Test.assert_eq_int(List.length(Ur.Landscape.structures(on, S.index(45, 10), 0)), 0, "nor water with no land beside it")
    Test.assert_eq_int(List.length(Ur.Landscape.structures(on, S.index(20, 20), 0)), 0, "nor open sea")
  end
  -- mangroves as a sea defence, and pollution
  pfn defence(c : Ur.Sim.City) : Unit do
    let zero = NativeArray.make_int(S.count(), 0)
    let a = block(block(block(zero, 43, 47, 8, 8, 12), 43, 43, 8, 12, 12), 47, 47, 8, 12, 12)
    -- a low shore parcel behind the stand at (44, 10)
    let a = at(a, 43, 10, 4)
    let stand = S.index(44, 10)
    let shore = S.index(43, 10)
    let bare = { c with heights: a, roads: zero, buildings: NativeArray.make_int(S.count(), 0), zones: NativeArray.make_int(S.count(), 0),
      parks: NativeArray.make_int(S.count(), 0), plants: NativeArray.make_int(S.count(), 0), seawalls: NativeArray.make_int(S.count(), 0),
      ferries: NativeArray.make_int(S.count(), 0), transit: NativeArray.make_int(S.count(), 0), grade_cover: NativeArray.make_int(S.count(), 0),
      seabed: NativeArray.make_int(S.count(), 0), pollution: NativeArray.make_int(S.count(), 0), land_pollution: NativeArray.make_int(S.count(), 0),
      mangrove_harm: NativeArray.make_int(S.count(), 0), harbour: -1, sea_counted: 2,
      sea_heights: NativeArray.set_int(NativeArray.make_int(S.count(), 0), stand, 350) }
    let on = seeded(bare, first_mangrove_seed(bare, true, 1))
    let off = seeded(bare, first_mangrove_seed(bare, false, 1))
    Test.assert_true(S.mangrove_water(on, stand), "a sheltered water parcel beside land holds a stand on a mangrove map")
    Test.assert_true(!S.mangrove_water(off, stand), "not on other maps")
    let one = NativeArray.set_int(NativeArray.make_int(S.count(), 0), stand, 1)
    Test.assert_true(!S.mangrove_water({ on with seawalls: one }, stand), "not under a seawall")
    Test.assert_true(!S.mangrove_water({ on with ferries: one }, stand), "nor on a ferry route")
    Test.assert_true(!S.mangrove_water({ on with transit: one }, stand), "nor under transit")
    Test.assert_true(!S.mangrove_water({ on with grade_cover: one }, stand), "nor under a crossing")
    Test.assert_true(!S.mangrove_water({ on with seabed: NativeArray.set_int(zero, stand, 5) }, stand), "nor where the seabed was worked")
    Test.assert_true(!S.mangrove_water(on, shore), "land holds none")
    -- surge: 16 quarter metres arrive at the stand; the shore stands 4 high
    Test.assert_eq_int(S.sea_surge(off, shore), 12, "without mangroves the surge floods the shore 3 m")
    Test.assert_eq_int(S.sea_surge(on, shore), 4, "a living stand halves it")
    let harmed = fn (h : Int) -> { on with mangrove_harm: NativeArray.set_int(NativeArray.make_int(S.count(), 0), stand, h) }
    Test.assert_eq_int(S.sea_surge(harmed(60), shore), 8, "a thinned stand takes a quarter off")
    Test.assert_eq_int(S.sea_surge(harmed(100), shore), 12, "a dead one nothing")
    Test.assert_eq_int(S.mangrove_state(on, stand), 1, "living")
    Test.assert_eq_int(S.mangrove_state(harmed(60), stand), 2, "thinned")
    Test.assert_eq_int(S.mangrove_state(harmed(100), stand), 3, "dead")
    Test.assert_eq_int(S.mangrove_state(on, shore), 0, "no stand on land")
    -- pollution: foul water kills a stand in three months, and it says so; clean water regrows it slowly
    let foul = { on with pollution: NativeArray.set_int(NativeArray.make_int(S.count(), 0), stand, 100) }
    let m1 = S.mangrove_month(foul)
    Test.assert_eq_int(S.get(m1.mangrove_harm, stand), 35, "foul water harms a stand")
    let m3 = S.mangrove_month(S.mangrove_month(m1))
    Test.assert_eq_int(S.mangrove_state(m3, stand), 3, "and kills it")
    Test.assert_true(String.contains(m3.message, "Mangroves died"), "the death is announced: " ++ m3.message)
    let clean = S.mangrove_month({ m3 with pollution: NativeArray.make_int(S.count(), 0) })
    Test.assert_eq_int(S.get(clean.mangrove_harm, stand), 98, "clean water lets it regrow, slowly")
    let calm = S.mangrove_month(on)
    Test.assert_eq_int(S.get(calm.mangrove_harm, stand), 0, "a healthy stand in clean water stays healthy")
    -- the harm is saved
    match Ur.Save.decode_session(Ur.Save.encode_session({ game: { city: m1, cx: 0.0, cz: 0.0, zoom: 60.0, yaw: 0.55, paused: true, speed: 1 }, evacuation: Nil })) do
      Ok(back) -> Test.assert_eq_int(S.get(back.game.city.mangrove_harm, stand), 35, "a stand's harm survives a save")
      Err(e) -> Test.assert_true(false, "the save loads: " ++ e)
    end
    -- drawn as it is
    let dead = Ur.Landscape.structures(harmed(100), stand, 0)
    Test.assert_true(List.length(dead) > 0 && List.all(dead, fn p -> p.material == 23), "a dead stand is grey snags, no leaves")
    Test.assert_true(List.any(Ur.Landscape.structures(harmed(60), stand, 0), fn p -> p.material == 22), "a thinned stand is paler")
  end
  -- reefs shelter a small island; rivers carry mangroves only up their salty reach
  pfn reefs_and_rivers(c : Ur.Sim.City) : Unit do
    let zero = NativeArray.make_int(S.count(), 0)
    -- a 2 x 2 islet out at sea, (30, 30)..(31, 31); the water beside it at (32, 30)
    let a = block(zero, 30, 31, 30, 31, 10)
    let islet = seeded({ c with heights: a, seawalls: zero, ferries: zero, transit: zero, grade_cover: zero, seabed: zero, harbour: -1,
      sea_shoals: NativeArray.make_int(S.count(), 63), sea_reefs: NativeArray.make_int(S.count(), 0) }, first_mangrove_seed(c, true, 1))
    let water = S.index(32, 30)
    Test.assert_true(!S.sheltered(islet, water), "a bare islet in open sea is exposed")
    Test.assert_true(!S.mangrove_water(islet, water), "and grows no mangroves")
    -- a reef ring three parcels out round the islet, its top 1 m down
    let ring = List.filter(List.range(0, S.count()), fn i ->
      let dx = i % S.width() - 30
      let dz = i / S.width() - 30
      (dx == -3 || dx == 4 || dz == -3 || dz == 4) && dx >= -3 && dx <= 4 && dz >= -3 && dz <= 4)
    let reefed = { islet with sea_reefs: List.fold_left(ring, NativeArray.make_int(S.count(), 0), fn (r, i) -> NativeArray.set_int(r, i, 1)),
      sea_shoals: List.fold_left(ring, NativeArray.make_int(S.count(), 63), fn (r, i) -> NativeArray.set_int(r, i, 4)) }
    Test.assert_true(S.sheltered(reefed, water), "a reef near the surface shelters the water inside it")
    Test.assert_true(S.mangrove_water(reefed, water), "so the islet grows a mangrove ring, as a cay does")
    let deep = { reefed with sea_shoals: List.fold_left(ring, NativeArray.make_int(S.count(), 63), fn (r, i) -> NativeArray.set_int(r, i, 30)) }
    Test.assert_true(!S.sheltered(deep, water), "a reef 7 m down breaks no swell")
    -- a generated map with a river and mangroves
    let river = S.unclaimed_setup(river_seed(c, 3), S.default_setup())
    let reaches = List.filter(List.range(0, S.count()), fn i -> S.river_reach(river, i) >= 0)
    Test.assert_true(List.any(reaches, fn i -> S.river_reach(river, i) == 0), "the river has a mouth")
    Test.assert_true(List.any(reaches, fn i -> S.river_reach(river, i) > 8), "and runs more than 8 parcels inland")
    Test.assert_true(List.all(reaches, fn i -> S.river_reach(river, i) <= 8 || !S.mangrove_water(river, i)), "no mangroves where the river runs fresh")
    Test.assert_true(List.any(reaches, fn i -> S.river_reach(river, i) <= 2 && S.mangrove_water(river, i)), "mangroves at the mouth")
    Test.assert_eq_int(S.mangrove_density(river, S.index(0, 0)), 7, "a coastal stand is full")
    Test.assert_true(List.all(reaches, fn i -> List.all(reaches, fn j ->
      S.river_reach(river, i) >= S.river_reach(river, j) || S.mangrove_density(river, i) >= S.mangrove_density(river, j))), "stands thin upstream")
    Test.assert_true(List.any(reaches, fn i -> S.river_reach(river, i) == 8 && S.mangrove_density(river, i) < 7), "sparse at the limit")
  end
  -- a seed whose map has a river and mangroves
  pfn river_seed(c : Ur.Sim.City, s : Int) : Int do
    if s % 3 == 0 && Ur.Flora.mangrove_map(seeded(c, s)) do s else river_seed(c, s + 1) end
  end
  pfn first_mangrove_seed(c : Ur.Sim.City, want : Bool, s : Int) : Int do
    if Ur.Flora.mangrove_map(seeded(c, s)) == want do s else first_mangrove_seed(c, want, s + 1) end
  end

  fn main(_cap : Cap(IO)) : Unit do
    let c = S.new()
    traits(c)
    spot(c)
    shapes()
    choosing(c)
    mangroves(c)
    defence(c)
    reefs_and_rivers(c)
    Authority.must(println("Island trees: all assertions passed"))
  end
end
